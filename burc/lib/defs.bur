// defs.bur — 编译器共享定义：Token/诊断/常量值与字节码 opcode 编号表。
// Shared compiler definitions: tokens, diagnostics, constants, and the opcode table.
pub enum Token {
    Tok(int, str, int, int),
}

// 诊断标签（多 span 标注） / Diagnostic label (multi-span annotation)
pub enum LabelT {
    Lab(int, int, str),
}

// 修复建议
// Fix suggestion
pub enum FixT {
    Fix(int, int, str, str),
}

// 诊断（错误/警告 + 修复） / Diagnostic (error/warning + fix)
pub enum DiagT {
    Diag(bool, str, str, str, int, int),
    DiagX(bool, str, str, str, int, int, [LabelT], [FixT]),
}

// 词法输出
// Lexer output
pub enum LexOut {
    Lexed([Token], [DiagT], [Token]),
}

// 检查输出
// Checker output
pub enum CheckOut {
    Checked([DiagT], [str], [str], [str], [str]),
}

pub let toolchain_version = "0.4.0"

// 编译期常量值
// Compile-time constant value
pub enum CVal {
    CInt(int),
    CFloat(float),
    CStr(str),
    CFn(int),
    CEnumType(int),
    CSingleton(int, int),
    CCtor(int, int),
}

