*~

# bur build scratch: the C backend writes unit .c/.o plus bur_units.h to CWD
# (no temp-dir native). Root-anchored so runtime/*.c stays tracked.
/*.c
/*.o
/bur_units.h

# interface cache written when the committed fixture modcache is used as
# $BURCACHE directly; regenerable, never committed
testdata/modcache/.interfaces/

