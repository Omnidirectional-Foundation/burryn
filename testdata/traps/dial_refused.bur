// dial 到必然拒绝的端口，Err 文本须与 C 的 bur_net_err("tcp_dial", strerror) 逐字一致
// dialing a always-refused port; the Err text must match C's bur_net_err verbatim
match tcp_dial("127.0.0.1", 1) {
    Err(e) => {
        assert(e == "tcp_dial: Connection refused", "refused text mismatch")
        println("refused text ok")
    },
    Ok(h) => {
        net_close(h)
        println("unexpected: dial to port 1 succeeded")
    },
}
