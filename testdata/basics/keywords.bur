// 23 关键字全覆盖（脚本模式可用的 20 个；pub/import/type 在 modules/ 样例）
let x = 1                     // let
let mut n = 0                 // mut
const LIMIT: int = 5          // const
fn add(a, b) {                // fn
    if a > 0 {
        return a + b          // return
    }
    a + b
}
let y = add(2, 3)
if y > LIMIT {                // if
    n = n + 1
} else {                      // else
    n = n - 1
}
let mut i = 0
while i < 3 {                 // while
    i = i + 1
    if i == 2 { continue }    // continue
    if i > 2 { break }        // break
}
for j in range(0, 3) {        // for / in
    n = n + j
}
let ok = true                 // true
let bad = false               // false
enum Shape { Circle(float), Rect(int, int), Point }   // enum
match Shape::Point {          // match
    Shape::Point => { n = n + 1 },
    _ => { n = n - 1 },
}
let r = record { a: 1 }       // record
match r {
    record { a } => { n = n + a },
    _ => {},
}
defer { n = n + 100 }         // defer（函数退出时执行）
let ch = chan(1)              // chan 构造（非关键字，native）
spawn fn() { ch <- 7 }()      // spawn（起纤程发值）
let got = <-ch                // channel 接收
select {                      // select
    v = <-ch => { n = n + v },
    default => { n = n + got },
}
println(n, x, y, LIMIT, ok, bad, got)
