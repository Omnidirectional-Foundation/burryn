// 管道 / ? / 闭包 / match guard / 插值
fn double(x) { x * 2 }
fn safe_div(a, b) {
    if b == 0 { return Err("div by zero") }
    Ok(a / b)
}
let v = 5 |> double          // 管道
fn try_div() {
    let r = safe_div(10, 2)?     // ? 解包（函数内）
    Ok(r)
}
let r = match try_div() {
    Ok(x) => x,
    Err(_) => -1,
}
let e = match safe_div(1, 0) {
    Ok(x) => x,
    Err(msg) => -1,
}
let make = fn(k) {           // lambda / 闭包
    fn(x) { x + k }
}
let add5 = make(5)
let guard_ok = match 7 {
    n if n > 5 => "big",     // match guard
    _ => "small",
}
let s = "value is { str(r) }"   // 字符串插值
println(v, r, e, add5(1), guard_ok, s)
