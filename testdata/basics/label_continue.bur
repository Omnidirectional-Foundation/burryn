// label_continue.bur — 带标签 continue（语法 4.5 label_stmt）
// label_continue.bur — labeled continue (grammar 4.5 label_stmt)
let mut total = 0

outer: for i in range(0, 4) {
    for j in range(0, 4) {
        if j == 2 {
            continue outer
        }
        total = total + i * 10 + j
    }
}

println("labeled continue sum:", total)
