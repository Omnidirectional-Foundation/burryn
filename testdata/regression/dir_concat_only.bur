// Regression probe: concat captured dir only, match present.
fn loadem(dir0) {
    let dir = dir0
    let mut out = []
    fn work() {
        let entries = match fetch(true) {
            Ok(es) => es,
            Err(_e) => ["fallback"],
        }
        push(out, dir + "/lit")
        push(out, entries[0])
    }
    work()
    out
}

fn fetch(ok) {
    if ok {
        Ok(split("b,a,c", ","))
    } else {
        Err("nope")
    }
}

let got = loadem("root")
println(join(got, ";"))
