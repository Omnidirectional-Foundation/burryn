// Regression: tuple destructuring keeps element types at top level and in functions.
// x86 psim used to bind top-level closure handles to phantom local slots,
// poisoning later reads of unrelated slots (e.g. the destructure temp).
fn inner() {
    let (a, b) = (1, "in-fn")
    println(a, b)
}
inner()
let t = (10, "hello", 3.5)
println(t[0], t[1], t[2])
let (c, d, e) = t
println(c, d, e)
println(e + 1.0)
