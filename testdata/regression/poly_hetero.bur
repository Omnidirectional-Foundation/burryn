// Regression: heterogeneous polymorphic calls on the x86 backend.
// The backend previously merged a polymorphic function's param types into one
// slot, so one call site of wrap(1)/wrap("s") (or eql(1,1)/eql("a","a")) got
// the wrong return type OR the wrong type-sensitive body opcode. Per-signature
// return types + per-signature body emission fix both; nested signatures
// (inner called only through mid) are discovered during the signature solve.
fn id(x){x}
fn wrap(x){[x,x]}
fn mk(x){[x]}
fn pair(x){(x, x)}
fn outer(x){ wrap(x) }
fn eql(x, y){ x == y }
fn neq(x, y){ x != y }
fn lt(x, y){ x < y }
fn largest(a, b){ if a > b { a } else { b } }
fn inner(x){[x,x]}
fn mid(x){ inner(x) }

println(id(42))
println(id("hello"))
println(wrap(1))
println(wrap("s"))
println(wrap(1.5))
println(mk(7))
println(mk("z"))
println(pair(1))
println(pair("a"))
let xs = wrap(99)
let ys = wrap("kk")
println(xs)
println(ys)
println(outer(5))
println(outer("ab"))
println(eql(1, 1))
println(eql("a", "a"))
println(neq(1, 2))
println(neq("a", "b"))
println(lt(1, 5))
println(lt("a", "z"))
println(largest(3, 9))
println(largest("a", "z"))
println(mid("a"))
println(mid(2.5))
