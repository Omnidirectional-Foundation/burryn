// 值格式化对齐 C 的 bur_format：容器内字符串转义、嵌套 payload、unit/bool
// value formatting matches C's bur_format: escaped strings in containers, nested payloads, unit/bool
println(["a\"b", "é\n", "t\tx\\"])
println(("q\"", 1, true, 2.5))
println([true, false])
println([[1, 2], [3]])
println([(1, "a"), (2, "b")])
println(Some(true))
let u = println("")
println(Some(u))
println(Some(Some(3)))
println(Ok(["x"]))
println(Some((1, "a")))
println(Some([1.5, 2.0]))
let mut m = map()
put(m, "k\"", "v\n")
println(m)
println([Some(1), None])
println((Some("s"), [None]))
println(record { x: 1, s: "q\"" })
println(Some(record { x: 2, s: "z" }))
println([record { x: 3, s: "y" }])
enum Sh {
    Circle(float),
    Rect(int, int),
    Named(str, [int]),
}
println(Circle(1.0))
println(Named("n\"", [1, 2]))
println([Rect(1, 2)])
println(str([1, 2]))
println(str(Some("x")))
