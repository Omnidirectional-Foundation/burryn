// defer_x86.bur — x86 defer: LIFO ordering, return-value preservation,
// ? early-exit, nested-function isolation, script-level defer
// defer_x86.bur — x86 defer：LIFO 顺序、返回值保留、? 提前退出、嵌套函数隔离、脚本级 defer
fn ordered() {
    defer {
        print("1")
    }
    defer {
        print("2")
    }
    print("body")
}

fn ret(x) {
    defer {
        print("d")
    }
    x * 2
}

fn parser(s) {
    defer {
        print("p")
    }
    let v = parse_int(s)?
    print("v" + str(v))
    Some(v)
}

fn inner() {
    defer {
        print("I")
    }
}

fn outer() {
    defer {
        print("O")
    }
    inner()
}

fn nested() {
    defer {
        print("a")
    }
    defer {
        print("b")
    }
}

ordered()
println("|" + str(ret(21)))
let _ = parser("42")
let _ = parser("nope")
outer()
nested()
print("start")
defer {
    print("script")
}
print("end")
