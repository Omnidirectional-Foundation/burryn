// Regression probe: nested module-loader shape (match-extracted list,
// for-loop path building, string compares) under many live locals.
// Mimics load_pkg's `pdir + "/" + name` construction; the x86 backend must
// preserve string types through match payloads and keep live locals intact
// across inline natives.
fn load_module_opts(dir0) {
    let dir = strip(dir0)
    let mod_path = "example.com/mod"
    let mut out = []
    fn load_pkg(path) {
        let a0 = 1001
        let a1 = 1002
        let a2 = 1003
        let a3 = 1004
        let a4 = 1005
        let a5 = 1006
        let a6 = 1007
        let a7 = 1008
        let a8 = 1009
        let a9 = 1010
        let b0 = "k0"
        let b1 = "k1"
        let pdir = if path == mod_path {
            dir
        } else {
            dir + "/" + sub(path, 4, 3)
        }
        let entries = match fetch(true) {
            Ok(es) => es,
            Err(_e) => ["fallback"],
        }
        for name in entries {
            let disp = pdir + "/" + name
            push(out, disp)
        }
        let tag = if pdir == dir {
            "local"
        } else {
            "remote"
        }
        let nempty = if pdir != "" {
            "ne-ok"
        } else {
            "ne-bad"
        }
        push(out, tag + ":" + nempty)
        push(out, str(a0) + ":" + str(a1) + ":" + str(a2) + ":" + str(a3) + ":" + str(a4) + ":" + str(a5) + ":" + str(a6) + ":" + str(a7) + ":" + str(a8) + ":" + str(a9) + ":" + b0 + ":" + b1)
    }
    load_pkg(mod_path)
    load_pkg("example.com/other")
    out
}

fn strip(p) {
    p
}

fn sub(s, a, n) {
    substr(s, a, n)
}

fn fetch(ok) {
    if ok {
        Ok(split("b,a,c", ","))
    } else {
        Err("nope")
    }
}

let got = load_module_opts("root")
println(join(got, ";"))
