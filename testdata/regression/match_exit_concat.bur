// Regression probe: a two-arm match whose last arm ends in exit(), its result
// then concatenated. The linear scan keeps only that arm's conclusion, whose
// value type is empty, so the result slot stayed typed with the scrutinee's
// enum and `+` took the integer path, storing the sum of two string pointers.
// Mimics compile_file_to_x86's `injected + dns_src` and the formatting after it.
fn readf(p) {
    if p == "a" {
        Ok("aaa")
    } else if p == "b" {
        Ok("bbb")
    } else if p == "c" {
        Ok("ccc")
    } else {
        Err("missing: " + p)
    }
}

fn target_os() {
    "linux"
}

fn merge_sources(path) {
    let mut src = match readf(path) {
        Ok(s) => s,
        Err(msg) => {
            eprintln("error: " + msg)
            exit(3)
        },
    }
    let mut injected = match readf("a") {
        Ok(s) => s,
        Err(msg) => {
            eprintln("error: " + msg)
            exit(3)
        },
    }
    if target_os() != "windows" {
        let dns_src = match readf("b") {
            Ok(s) => s,
            Err(msg) => {
                eprintln("error: " + msg)
                exit(3)
            },
        }
        injected = injected + dns_src
    }
    let src2 = if src == "" {
        "//empty"
    } else {
        src
    }
    str(injected) + "|" + str(src2) + "|" + str(src)
}

println(merge_sources("a"))
