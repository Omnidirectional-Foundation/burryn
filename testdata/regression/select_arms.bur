// select_arms.bur — 多臂 select：recv 收变量臂 / send 臂 / default 臂（语法 4.14）
// select_arms.bur — multi-arm select: recv-to-var, send, and default arms (grammar 4.14)
let a = chan(1)
let b = chan(1)
a <- "A"

select {
    x = <-a => println("got a:", x),
    <-b => println("got b"),
}

let out = chan(1)

select {
    out <- "sent" => println("send ok"),
    <-b => println("got b2"),
}

let mut ran = false

select {
    <-a => println("unreachable"),
    <-b => println("unreachable2"),
    default => {
        println("default ran")
        ran = true
    },
}

assert(ran, "default must run")
