// Regression: exec collects child output beyond the 8KB buffer boundary.
// The x86 backend used to cap stdout/stderr at 8KB; the buffer now doubles as needed.
fn main_loop() {
    match exec("sh", ["-c", "yes a 2>/dev/null | head -c 20000"]) {
        Ok(out) => {
            match out {
                Output(code, stdout, stderr) => {
                    println("stdout: code:", code, "out_len:", str_len(stdout), "err_len:", str_len(stderr))
                    println("head:", substr(stdout, 0, 10))
                    println("tail:", substr(stdout, 19990, 10))
                },
            }
        },
        Err(e) => println("stdout: err:", e),
    }

    match exec("sh", ["-c", "yes b 2>/dev/null | head -c 20000 1>&2"]) {
        Ok(out) => {
            match out {
                Output(code, stdout, stderr) => {
                    println("stderr: code:", code, "out_len:", str_len(stdout), "err_len:", str_len(stderr))
                    println("head:", substr(stderr, 0, 10))
                    println("tail:", substr(stderr, 19990, 10))
                },
            }
        },
        Err(e) => println("stderr: err:", e),
    }
}

main_loop()
