// Regression: match-extracted list payload passed across a function boundary.
fn fetch(ok) {
    if ok {
        Ok(split("b,a,c", ","))
    } else {
        Err("nope")
    }
}

let a0 = 1001
let a1 = 1002
let a2 = 1003
let a3 = 1004
let a4 = 1005
let entries = match fetch(true) {
    Ok(es) => es,
    Err(_e) => ["fallback"],
}
println(join(entries, ","))
println(str(a0) + ":" + str(a1) + ":" + str(a2) + ":" + str(a3) + ":" + str(a4))
