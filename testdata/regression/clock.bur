// Regression: clock returns seconds since start (CLOCK_MONOTONIC minus the startup instant).
// The x86 backend inlines clock_gettime; both backends report a monotonic value.
let t1 = clock()
println("t1_positive:", t1 > 0.0)
sleep(50)
let t2 = clock()
println("monotonic:", t2 > t1)
println("delta_positive:", t2 - t1 > 0.0)
let t3 = clock()
println("t3_ge_t2:", t3 >= t2)
