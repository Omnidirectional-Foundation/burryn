// Regression: guarded matches — fn bodies and inline matches in call args.
// The x86 backend used to leave a phantom stack entry at NO_MATCH,
// so an inline `println(match ...)` called a data pointer as code (SIGSEGV).
enum Number {
    N(int),
}

fn classify(value) {
    match value {
        N(n) if n < 0 => "negative",
        N(n) if n == 0 => "zero",
        N(_) => "positive",
    }
}

println(classify(N(-3)))
println(classify(N(0)))
println(classify(N(7)))

let value = 4

println(match value {
    n if n % 2 == 0 => "even",
    _ => "odd",
})
