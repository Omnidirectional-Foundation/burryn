// Regression: nested string building through helper calls.
fn loadem(dir0) {
    let dir = strip(dir0)
    let mut out = []
    fn work(path) {
        let a0 = 1001
        let a1 = 1002
        let a2 = 1003
        let a3 = 1004
        let a4 = 1005
        let a5 = 1006
        let a6 = 1007
        let a7 = 1008
        let a8 = 1009
        let a9 = 1010
        let pdir = dir + "/" + sub(path, 4, 3)
        push(out, pdir + "/x")
        push(out, str(a0) + ":" + str(a1) + ":" + str(a2) + ":" + str(a3) + ":" + str(a4) + ":" + str(a5) + ":" + str(a6) + ":" + str(a7) + ":" + str(a8) + ":" + str(a9))
    }
    work("example.com/other")
    out
}

fn strip(p) {
    p
}

fn sub(s, a, n) {
    substr(s, a, n)
}

let got = loadem("root")
println(join(got, ";"))
