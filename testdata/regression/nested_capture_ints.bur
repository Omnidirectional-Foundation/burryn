// Regression: nested function capturing a mut list, integer pushes.
fn outer() {
    let mut out = []
    fn work(n) {
        let a0 = 1001
        let a1 = 1002
        let a2 = 1003
        let a3 = 1004
        let a4 = 1005
        push(out, n + a0)
        push(out, n + a1 + a2 + a3 + a4)
    }
    work(10)
    work(20)
    out
}

let got = outer()
println(str(got[0]) + "," + str(got[1]) + "," + str(got[2]) + "," + str(got[3]))
