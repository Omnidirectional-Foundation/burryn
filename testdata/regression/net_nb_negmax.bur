// net_nb 负 max：C 在查句柄之前先查 max，无效句柄也报同一条文本
//（§16 残项收口：x86 旧路径把 op 当 errno 报 "Operation not permitted"）
// net_nb negative max: C checks max before the handle, so an invalid handle
// reports the same text (section-16 residual: the x86 path treated the op
// value as an errno and reported "Operation not permitted")
fn check() {
    match net_nb(1, 12345, "", -1) {
        Ok(s) => println("ok:", s),
        Err(e) => println("err:", e),
    }
}

check()
