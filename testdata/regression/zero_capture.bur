// Regression probe: zero captures, out local to nested fn.
fn loadem(dir0) {
    fn work(q) {
        let a0 = 1001
        let a1 = 1002
        let a2 = 1003
        let a3 = 1004
        let a4 = 1005
        let a5 = 1006
        let a6 = 1007
        let a7 = 1008
        let a8 = 1009
        let a9 = 1010
        let entries = match fetch(true) {
            Ok(es) => es,
            Err(_e) => ["fallback"],
        }
        let mut out = []
        for name in entries {
            let disp = q + "/" + name
            push(out, disp)
        }
        push(out, str(a0) + ":" + str(a1) + ":" + str(a2) + ":" + str(a3) + ":" + str(a4) + ":" + str(a5) + ":" + str(a6) + ":" + str(a7) + ":" + str(a8) + ":" + str(a9))
        out
    }
    work(dir0)
}

fn fetch(ok) {
    if ok {
        Ok(split("b,a,c", ","))
    } else {
        Err("nope")
    }
}

let got = loadem("root")
println(join(got, ";"))
