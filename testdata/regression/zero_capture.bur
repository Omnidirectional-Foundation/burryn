// Regression probe: zero captures, out local to nested fn.
fn loadem(dir0) {
    fn work(q) {
        let mut out = []
        let entries = match fetch(true) {
            Ok(es) => es,
            Err(_e) => ["fallback"],
        }
        for name in entries {
            let disp = q + "/" + name
            push(out, disp)
        }
        out
    }
    work(dir0)
}

fn fetch(ok) {
    if ok {
        Ok(split("b,a,c", ","))
    } else {
        Err("nope")
    }
}

let got = loadem("root")
println(join(got, ";"))
