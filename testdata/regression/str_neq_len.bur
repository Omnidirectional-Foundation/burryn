// Regression: string `!=` with differing lengths must be true. The x86 backend
// copied the `==` shape but only swapped sete/setne, so the differing-length
// path skipped the byte compare and kept 0 — `a != b` returned false whenever
// the two strings had different lengths (e.g. the loader's `pdir != ""`).
fn ne(a, b) {
    a != b
}
let pdir = "root"
println(ne("abc", "de"))
println(ne("abc", "abc"))
println(ne("", "x"))
println(ne(pdir, ""))
println(ne("", ""))
println(ne("root/ple", "root"))
