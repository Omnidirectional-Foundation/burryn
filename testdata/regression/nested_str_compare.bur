// Regression: string equality on params and captures only.
fn checkem(dir0, mod_path) {
    let dir = dir0
    fn work(path) {
        let a0 = 1001
        let a1 = 1002
        let a2 = 1003
        let a3 = 1004
        let a4 = 1005
        let tag = if path == mod_path {
            "local"
        } else {
            "remote"
        }
        let nempty = if path != "" {
            "ne-ok"
        } else {
            "ne-bad"
        }
        tag + ":" + nempty + ":" + str(a0) + ":" + str(a1) + ":" + str(a2) + ":" + str(a3) + ":" + str(a4) + ":" + dir
    }
    work(mod_path) + ";" + work("example.com/other")
}

let got = checkem("root", "example.com/mod")
println(got)
