// Regression: a list local declared before a match whose payload is a list.
// The payload list is indexed in a loop and concatenated; the x86 type shadow
// once misread the payload list as a str, so indexing ran the (dead) string
// path and emitted split()'s capacity byte (6,7,8) instead of "b","a","c".
fn loadem(dir0) {
    fn work(q) {
        let mut out = []
        let entries = match fetch(true) {
            Ok(es) => es,
            Err(_e) => ["fallback"],
        }
        for name in entries {
            let disp = q + "/" + name
            push(out, disp)
        }
        out
    }
    work(dir0)
}

fn fetch(ok) {
    if ok {
        Ok(split("b,a,c", ","))
    } else {
        Err("nope")
    }
}

let got = loadem("root")
println(join(got, ";"))
