// Regression probe: match plus capture with integers only.
fn loadem(base) {
    let mut out = []
    fn work() {
        let entries = match fetch(true) {
            Ok(es) => es,
            Err(_e) => [70, 80],
        }
        for x in entries {
            push(out, base + x)
        }
    }
    work()
    out
}

fn fetch(ok) {
    if ok {
        Ok([1, 2, 3])
    } else {
        Err(0 - 1)
    }
}

let got = loadem(1000)
println(str(got[0]) + "," + str(got[1]) + "," + str(got[2]))
