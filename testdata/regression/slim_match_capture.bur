// Regression probe: nested capture plus match, minimal locals.
fn loadem(dir0) {
    let dir = dir0
    let mut out = []
    fn work() {
        let entries = match fetch(true) {
            Ok(es) => es,
            Err(_e) => ["fallback"],
        }
        for name in entries {
            let disp = dir + "/" + name
            push(out, disp)
        }
    }
    work()
    out
}

fn fetch(ok) {
    if ok {
        Ok(split("b,a,c", ","))
    } else {
        Err("nope")
    }
}

let got = loadem("root")
println(join(got, ";"))
