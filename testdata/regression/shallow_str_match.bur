// Regression: string `match` on a parameter three levels deep. Every arm
// lowers to `EQ` against a literal, and the x86 backend uses the string
// content compare only when both operands' static shadows are exactly "str";
// otherwise it falls through to a raw word compare — a pointer compare for
// strings — so every arm fails and the match takes its `_` arm. The operand
// shadows come from the param/return-type aggregation, which propagates one
// call-graph level per round, so this depth must stay inside the round budget.
fn l3(s: str) -> int {
    match s {
        "a" => 3,
        _ => 0 - 3,
    }
}

fn l2(s: str) -> int {
    match s {
        "a" => l3(s),
        _ => 0 - 2,
    }
}

fn l1(s: str) -> int {
    match s {
        "a" => l2(s),
        _ => 0 - 1,
    }
}

println(str(l1("a")))
