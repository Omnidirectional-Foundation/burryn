// 类型标注：fn 签名/list/record/chan/tuple/约束变量/行变量语法
type Point = record { x: float, y: float }          // type 别名声明（S8.7 语义未实现，语法已支持）

fn dist(p: record { x: float, y: float }) -> float { // fn 签名显式标注
    match p {
        record { x, y } => x * x + y * y,
        _ => 0.0,
    }
}
fn largest(a: addord, b: addord) -> addord {          // 约束变量（S7.8）
    if a > b { a } else { b }
}

let xs: [int] = [1, 2, 3]                             // list 类型标注
let rt: record { name: str } = record { name: "bur" } // record 类型标注
let ch: chan(int) = chan(1)                           // chan 类型标注
let t: (int, str) = (7, "x")                          // tuple 类型标注
let p: record { x: float, y: float } = record { x: 3.0, y: 4.0 }

println(len(xs), rt.name, dist(p), largest(3, 9), ch)
