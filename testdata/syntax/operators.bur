/* 块注释也支持 */
// 逻辑 / 比较 / 一元 / 转义 / 负字面量模式
let a = 5 > 3            // >
let b = 5 == 5           // ==
let c = 5 != 3           // !=
let d = 5 <= 5           // <=
let e = 5 >= 4           // >=
let f = a && b           // &&
let g = a || c           // ||
let h = !c               // !
let neg = -7             // 一元负号
let tab = "a\tb"         // \t 转义
let quote = "say \"hi\"" // \" 转义
let back = "c:\\dir"     // \\ 转义
let braces = "x {{ y }}" // {{ 转义为字面 {
let n = 4
match n {
    -1 => println("neg one"),
    4 => println("four"),
    _ => println("other"),
}
println(a, b, c, d, e, f, g, h, neg, tab, quote, back, braces)
