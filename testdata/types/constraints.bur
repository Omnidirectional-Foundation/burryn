// constraints.bur — SML 式约束类型变量标注（语法 7.2 constraint）
// constraints.bur — SML-style constrained type variables (grammar 7.2 constraint)
fn min_num(a: num, b: num) -> num {
    if a < b {
        a
    } else {
        b
    }
}

fn pick_key(k: key) -> str {
    "key:" + k
}

fn add_int(a: int, b: int) -> int {
    a + b
}

fn add_float(a: float, b: float) -> float {
    a + b
}

println(min_num(3, 7), min_num(2.5, 1.5))
println(pick_key("abc"))
println(add_int(2, 3), add_float(1.5, 2.5))
