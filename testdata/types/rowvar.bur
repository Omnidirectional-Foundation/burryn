// row poly (S8.3): open records `record { a: int | r }` match any record carrying those fields
fn field_a(p: record { a: int, | r }) -> int {
    p.a
}

fn combine(p: record { a: int, | r }, q: record { a: int, | s }) -> int {
    p.a + q.a
}

let row: record { a: int, | r } = record { a: 1, b: 2 }
let with_extra: record { a: int, | r } = record { a: 9, b: 3, c: 4 }
let exact: record { a: int, | r } = record { a: 7 }
println("field:", field_a(row))
println("extra:", field_a(with_extra))
println("exact:", field_a(exact))
println("combine:", combine(record { a: 5, x: 1 }, record { a: 6, y: "z" }))
