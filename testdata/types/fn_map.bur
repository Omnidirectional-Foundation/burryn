// fn_map.bur — map 值为函数：三后端一致打印 <fn 名字>
// map with fn values: every backend prints <fn name> alike
fn double(x) {
    x * 2
}

fn inc(x) {
    x + 1
}

fn main_loop() {
    println(str(double))
    let mut ops = map()
    put(ops, "double", double)
    put(ops, "inc", inc)
    println(ops)
}

main_loop()
