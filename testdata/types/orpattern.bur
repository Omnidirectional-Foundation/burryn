// or-pattern
enum Shape { Circle(float), Rect(int, int), Point }
fn kind(s) {
    match s {
        Circle(_) | Point => "round",
        Rect(_, _) => "rect",
    }
}
let n = 7
match n {
    1 | 2 => println("low"),
    3 | 4 | 5 | 6 | 7 => println("mid"),
    _ => println("high"),
}
println(kind(Shape::Circle(1.0)), kind(Shape::Rect(1, 2)))
