// 类型标注：fn 签名/list/record/chan/tuple/约束变量/行变量语法
type Point = record { x: float, y: float }          // type 别名声明（S8.7 透明别名：type X = T 完全展开为 T）

fn dist(p: Point) -> float {                      // fn 签名用别名（S8.7 透明展开）
    match p {
        record { x, y } => x * x + y * y,
        _ => 0.0,
    }
}
fn largest(a: addord, b: addord) -> addord {          // 约束变量（S7.8）
    if a > b { a } else { b }
}

let xs: [int] = [1, 2, 3]                             // list 类型标注
let rt: record { name: str } = record { name: "bur" } // record 类型标注
let ch: chan(int) = chan(1)                           // chan 类型标注
let t: (int, str) = (7, "x")                          // tuple 类型标注
let p: Point = record { x: 3.0, y: 4.0 }              // 注解用别名（S8.7）
let p3: Point = record { x: 5.0, y: 12.0 }

println(len(xs), rt.name, dist(p), dist(p3), largest(3, 9), ch)
