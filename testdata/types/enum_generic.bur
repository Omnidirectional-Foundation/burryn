// enum_generic.bur — 泛型枚举声明与实例化（语法 3.3 type_param）
// enum_generic.bur — generic enum declaration and instantiation (grammar 3.3 type_param)
enum Box(a) {
    Empty,
    Full(a),
}

fn unbox(b: Box(int)) -> str {
    match b {
        Empty => "empty",
        Full(x) => "full:" + str(x),
    }
}

let bi: Box(int) = Full(42)
let be: Box(int) = Empty
println(unbox(bi), unbox(be))
