// ty_record.bur — record 字段表与名字辅助（行/封闭 record 配套）。
// ty_record.bur — record field table and name helpers (row/closed-record support).

// rec_type_name 取 record 类型名字 / rec_type_name extracts the record type name
fn rec_type_name(names) {
    let mut s = "@rec"
    for n in names {
        s = s + "|" + n
    }
    s
}

// rec_parse_names 解析 record 字段名列表 / rec_parse_names parses record field names
fn rec_parse_names(tname) {
    let mut out = []
    let mut i = 5
    let mut cur = ""
    while i < str_len(tname) {
        let c = substr(tname, i, 1)
        if c == "|" {
            push(out, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    if cur != "" {
        push(out, cur)
    }
    out
}
