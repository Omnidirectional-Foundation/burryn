// lex_peek.bur — peek/advance/match。
// lex_peek.bur — peek/advance/match.


// lex_peek 前瞻一个字符，越界返回空串 / lex_peek peeks one char, "" past end
fn lex_peek(src, st) {
    if st[1] >= str_len(src) {
        ""
    } else {
        char_at(src, st[1])
    }
}

// lex_peek2 前瞻两个字符 / lex_peek2 peeks two chars
fn lex_peek2(src, st) {
    if st[1] + 1 >= str_len(src) {
        ""
    } else {
        char_at(src, st[1] + 1)
    }
}

// lex_advance 取当前字符并前进 / lex_advance consumes one char
fn lex_advance(src, mut st) {
    let c = char_at(src, st[1])
    st[1] = st[1] + 1
    c
}

// lex_bump 前进一个字符 / lex_bump advances one char
fn lex_bump(mut st) {
    st[1] = st[1] + 1
}

