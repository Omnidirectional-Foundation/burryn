// parse_label_stmt.bur — 标签循环语句。
// parse_label_stmt.bur — labeled loop statement.

fn p_label_stmt(toks, mut pos) {
    let ltok = p_advance(toks, pos)
    let _ = p_advance(toks, pos)
    let inner = match p_statement(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    Ok(LabelStmt(tok_lex(ltok), inner, sp_union(sp_of_tok(ltok), span_of(inner))))
}
