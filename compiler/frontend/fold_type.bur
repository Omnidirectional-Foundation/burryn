// fold_type.bur — 常量折叠类型运算。
// fold_type.bur — const-fold type ops.

// fc_type_val 把折叠值映射为折叠类型 / fc_type_val maps a folded value to a folded type
fn fc_type_val(v, label, sp, mut adiags) {
    match v {
        FVInt(_) => FTType(0),
        FVFloat(_) => FTType(1),
        FVStr(_) => FTType(2),
        FVBool(_) => FTType(3),
        FVMasked => {
            let _ = fc_not_const(label, sp, adiags)
            FTErr
        },
        FVPoison => FTSoft,
    }
}
