// ty_con.bur — 约束集合运算。
// ty_con.bur — constraint set ops.



// con_set 输出约束集合文本 / con_set renders a constraint set as text
fn con_set(con) {
    match con {
        "num" => ["int", "float"],
        "addord" => ["int", "float", "str"],
        "key" => ["int", "str"],
        "int" => ["int"],
        "float" => ["float"],
        "str" => ["str"],
        _ => [],
    }
}

// con_allows 判断约束是否允许该名字 / con_allows tells whether the constraint allows the name
fn con_allows(con, name) {
    if con == "" {
        true
    } else {
        contains(con_set(con), name)
    }
}

