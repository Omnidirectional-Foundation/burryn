// parse_type_list.bur — list 类型表达式。
// parse_type_list.bur — list type expression.

import "burryn.dev/compiler/lib"

fn p_type_list(toks, mut pos, tok) {
    p_advance(toks, pos)
    let el = match p_type_expr(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    let rb = match p_expect(toks, pos, t_rbracket, "']' in list type") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    Ok(TEList(el, sp_union(sp_of_tok(tok), sp_of_tok(rb))))
}
