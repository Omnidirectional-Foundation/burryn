// parse_semi.bur — 分号。
// parse_semi.bur — semicolons.

// p_skip_semis 跳过连续分号（含自动插入的换行分号）
// p_skip_semis skips consecutive semicolons (including inserted newline semicolons)
fn p_skip_semis(toks, mut pos) {
    while p_check(toks, pos, t_semi) {
        p_advance(toks, pos)
    }
}

// p_end_stmt 消费语句结束（分号，块尾/EOF 视为合法结束）
// p_end_stmt consumes a statement end (semicolon; block end and EOF also count)
fn p_end_stmt(toks, mut pos) {
    if p_check(toks, pos, t_semi) {
        p_advance(toks, pos)
        Ok(true)
    } else if p_check(toks, pos, t_rbrace) || p_check(toks, pos, t_eof) {
        Ok(true)
    } else {
        let tok = p_peek(toks, pos)
        perr("E1102", "separate statements with a newline or ';'", "expected end of statement, got \"" + tok_lex(tok) + "\"", sp_of_tok(tok))
    }
}
