// parse_primary.bur — primary/if/match/pattern 解析。
// parse_primary.bur — primary/if/match/pattern parsing.



// p_primary 解析原子表达式：字面量/标识符/分组/列表/函数字面量/record/枚举变体
// p_primary parses primaries: literals, identifiers, grouping, lists, fn literals,
// records, enum variants
fn p_primary(toks, mut pos) {
    // 原子表达式分派：字面量/标识符/分组/列表/函数/if/match/块
    // Primary dispatch: literals, identifiers, grouping, lists, functions, if, match, blocks
    let tok = p_peek(toks, pos)
    let t = tok_type(tok)
    if t == t_int {
        p_advance(toks, pos)
        match lit_to_int(tok_lex(tok)) {
            Some(n) => Ok(IntLit(n, sp_of_tok(tok))),
            None => perr("E1108", "i64 holds -9223372036854775808..9223372036854775807", "bad integer literal \"" + tok_lex(tok) + "\"", sp_of_tok(tok)),
        }
    } else if t == t_float {
        p_advance(toks, pos)
        match parse_float(tok_lex(tok)) {
            Some(f) => Ok(FloatLit(f, sp_of_tok(tok))),
            None => perr("E1108", "", "bad float literal \"" + tok_lex(tok) + "\"", sp_of_tok(tok)),
        }
    } else if t == t_string {
        p_advance(toks, pos)
        Ok(StrLit(tok_lex(tok), sp_of_tok(tok)))
    } else if t == t_interp_start {
        p_interpolated(toks, pos)
    } else if t == t_true {
        p_advance(toks, pos)
        Ok(BoolLit(true, sp_of_tok(tok)))
    } else if t == t_false {
        p_advance(toks, pos)
        Ok(BoolLit(false, sp_of_tok(tok)))
    } else if t == t_record {
        p_primary_record(toks, pos, tok)
    } else if t == t_ident {
        p_primary_ident(toks, pos, tok)
    } else if t == t_lparen {
        p_primary_paren(toks, pos, tok)
    } else if t == t_lbracket {
        p_primary_list(toks, pos, tok)
    } else if t == t_fn {
        p_advance(toks, pos)
        p_fn_rest(toks, pos, "", sp_of_tok(tok), false)
    } else if t == t_if {
        p_if_expr(toks, pos)
    } else if t == t_match {
        p_match_expr(toks, pos)
    } else if t == t_lbrace {
        p_block(toks, pos)
    } else {
        perr("E1109", "", "unexpected token \"" + tok_lex(tok) + "\"", sp_of_tok(tok))
    }
}

