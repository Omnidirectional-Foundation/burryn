// ast.bur — AST 定义与辅助：Span 区间、Node 语法树、模式、类型表达式。
// AST definitions and helpers: source spans, the Node tree, patterns, and type expressions.
// 除 NoNode 哨兵外，每个变体都携带 SpanT 源码区间，供诊断与格式化器使用。
// Every variant except the NoNode sentinel carries a SpanT for diagnostics and the formatter.
import "burryn.dev/compiler/lib"

// 源码区间 [start, end)（字节偏移）/ Source span [start, end) in byte offsets
pub enum SpanT {
    Sp(int, int),
}

// 语法树节点：表达式、模式、语句、类型表达式 / AST nodes: expressions, patterns, statements, type expressions
pub enum Node {
    IntLit(int, SpanT),
    FloatLit(float, SpanT),
    StrLit(str, SpanT),
    BoolLit(bool, SpanT),
    Ident(str, SpanT),
    Unary(int, Node, SpanT),
    Binary(int, Node, Node, SpanT),
    Logical(int, Node, Node, SpanT),
    Call(Node, [Node], SpanT),
    Pipe(Node, Node, [Node], SpanT),
    Index(Node, Node, SpanT),
    ListLit([Node], SpanT),
    FnLit([str], [bool], [SpanT], [Node], Node, Node, str, [str], SpanT),
    Block([Node], SpanT),
    IfExpr(Node, Node, Node, SpanT),
    MatchExpr(Node, [Node], SpanT),
    MatchArm(Node, Node, Node, SpanT),
    VariantAccess(str, str, SpanT),
    PkgAccess(str, str, SpanT),
    QualVariantAccess(str, str, str, SpanT),
    TryExpr(Node, SpanT),
    RecvExpr(Node, SpanT),
    RecordLit([str], [Node], SpanT),
    RecordUpdate(Node, [str], [Node], SpanT),
    FieldAccess(Node, str, SpanT),

    PatWildcard(SpanT),
    PatLiteral(Node, SpanT),
    PatBinding(str, SpanT),
    PatVariant(str, str, str, [Node], SpanT),
    PatRecord([str], SpanT),

    LetStmt(str, SpanT, bool, bool, Node, Node, SpanT),
    DestructLet([str], [SpanT], bool, Node, SpanT),
    TupleLit([Node], SpanT),
    ConstDecl(str, SpanT, bool, Node, Node, SpanT),
    AssignStmt(Node, Node, SpanT),
    ExprStmt(Node, SpanT),
    WhileStmt(Node, Node, SpanT),
    ForStmt(str, SpanT, str, SpanT, Node, bool, Node, SpanT),
    LabelStmt(str, Node, SpanT),
    ReturnStmt(Node, SpanT),
    FnDecl(str, SpanT, bool, Node, SpanT),
    MethodDecl(str, str, SpanT, Node, SpanT),
    EnumDecl(str, [str], [Node], bool, SpanT),
    EnumVariantDecl(str, int, [Node], SpanT),
    ImportDecl(str, SpanT, str, SpanT, SpanT),
    SpawnStmt(Node, SpanT),
    SelectStmt([Node], bool, Node, SpanT, SpanT),
    SelectArm(bool, str, SpanT, Node, Node, Node, SpanT),
    SendStmt(Node, Node, SpanT),
    BreakStmt(str, SpanT),
    ContinueStmt(str, SpanT),
    DeferStmt(Node, [str], SpanT),
    TypeAliasDecl(str, Node, bool, SpanT),

    TEName(str, str, str, [Node], SpanT),
    TEList(Node, SpanT),
    TEFn([Node], Node, SpanT),
    TERecord([str], [Node], Node, SpanT),
    TETuple([Node], SpanT),

    NoNode,
}

// 解析输出：语句列表 + 诊断 / Parse output: statement list plus diagnostics
pub enum ParseOut {
    Parsed([Node], [lib::DiagT]),
}

// import_alias 求 import 的别名：显式别名优先，否则取路径末段
// import_alias resolves an import alias: explicit alias wins, else the last path segment
pub fn import_alias(alias, path) {
    if alias != "" {
        alias
    } else {
        let mut cut = 0
        let mut i = 0
        while i < str_len(path) {
            if char_at(path, i) == "/" {
                cut = i + 1
            }
            i = i + 1
        }
        substr(path, cut, str_len(path) - cut)
    }
}

// aliases_of 构建导入路径到别名的映射表 / aliases_of builds the map of import path to effective alias
pub fn aliases_of(imports) {
    let mut am = map()
    for imp in imports {
        match imp {
            Node::ImportDecl(alias, _, path, _, _) => put(am, import_alias(alias, path), path),
            _ => {},
        }
    }
    am
}
