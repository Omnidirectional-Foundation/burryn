// ast.bur — AST 定义与辅助：Span 区间、Node 语法树、模式、类型表达式。
// AST definitions and helpers: source spans, the Node tree, patterns, and type expressions.
// 除 NoNode 哨兵外，每个变体都携带 SpanT 源码区间，供诊断与格式化器使用。
// Every variant except the NoNode sentinel carries a SpanT for diagnostics and the formatter.
import "burryn.dev/compiler/lib"

// 源码区间 [start, end)（字节偏移）/ Source span [start, end) in byte offsets
pub enum SpanT {
    Sp(int, int),
}

// 语法树节点：表达式、模式、语句、类型表达式 / AST nodes: expressions, patterns, statements, type expressions
pub enum Node {
    IntLit(int, SpanT),
    FloatLit(float, SpanT),
    StrLit(str, SpanT),
    BoolLit(bool, SpanT),
    Ident(str, SpanT),
    Unary(int, Node, SpanT),
    Binary(int, Node, Node, SpanT),
    Logical(int, Node, Node, SpanT),
    Call(Node, [Node], SpanT),
    Pipe(Node, Node, [Node], SpanT),
    Index(Node, Node, SpanT),
    ListLit([Node], SpanT),
    FnLit([str], [bool], [SpanT], [Node], Node, Node, str, [str], SpanT),
    Block([Node], SpanT),
    IfExpr(Node, Node, Node, SpanT),
    MatchExpr(Node, [Node], SpanT),
    MatchArm(Node, Node, Node, SpanT),
    VariantAccess(str, str, SpanT),
    PkgAccess(str, str, SpanT),
    QualVariantAccess(str, str, str, SpanT),
    TryExpr(Node, SpanT),
    RecvExpr(Node, SpanT),
    RecordLit([str], [Node], SpanT),
    RecordUpdate(Node, [str], [Node], SpanT),
    FieldAccess(Node, str, SpanT),

    PatWildcard(SpanT),
    PatLiteral(Node, SpanT),
    PatBinding(str, SpanT),
    PatVariant(str, str, str, [Node], SpanT),
    PatRecord([str], SpanT),

    LetStmt(str, SpanT, bool, bool, Node, Node, SpanT),
    DestructLet([str], [SpanT], bool, Node, SpanT),
    TupleLit([Node], SpanT),
    ConstDecl(str, SpanT, bool, Node, Node, SpanT),
    AssignStmt(Node, Node, SpanT),
    ExprStmt(Node, SpanT),
    WhileStmt(Node, Node, SpanT),
    ForStmt(str, SpanT, str, SpanT, Node, bool, Node, SpanT),
    LabelStmt(str, Node, SpanT),
    ReturnStmt(Node, SpanT),
    FnDecl(str, SpanT, bool, Node, SpanT),
    MethodDecl(str, str, SpanT, Node, SpanT),
    EnumDecl(str, [str], [Node], bool, SpanT),
    EnumVariantDecl(str, int, [Node], SpanT),
    ImportDecl(str, SpanT, str, SpanT, SpanT),
    SpawnStmt(Node, SpanT),
    SelectStmt([Node], bool, Node, SpanT, SpanT),
    SelectArm(bool, str, SpanT, Node, Node, Node, SpanT),
    SendStmt(Node, Node, SpanT),
    BreakStmt(str, SpanT),
    ContinueStmt(str, SpanT),
    DeferStmt(Node, [str], SpanT),
    TypeAliasDecl(str, Node, bool, SpanT),

    TEName(str, str, str, [Node], SpanT),
    TEList(Node, SpanT),
    TEFn([Node], Node, SpanT),
    TERecord([str], [Node], Node, SpanT),
    TETuple([Node], SpanT),

    NoNode,
}

// 解析输出：语句列表 + 诊断 / Parse output: statement list plus diagnostics
pub enum ParseOut {
    Parsed([Node], [lib::DiagT]),
}

// perr 构造解析错误诊断 / perr builds a parse-error diagnostic
pub fn perr(code, help, msg, sp) {
    match sp {
        Sp(s, e) => Err(lib::DiagT::Diag(true, code, msg, help, s, e)),
    }
}

// sp_union 取两个区间的并集 / sp_union computes the union of two spans
fn sp_union(a, b) {
    match a {
        Sp(s1, e1) => match b {
            Sp(s2, e2) => Sp(if s2 < s1 {
                s2
            } else {
                s1
            }, if e2 > e1 {
                e2
            } else {
                e1
            }),
        },
    }
}

// ast_eq 比较两个 AST 节点结构相等（常量折叠与格式化器判重用）
// ast_eq compares two AST nodes structurally (used by const folding and the formatter)
fn ast_eq(a, b) {
    // 结构相等：逐变体配对比较，字段递归
    // Structural equality: pair variants and compare fields recursively
    match a {
        IntLit(x, _) => match b {
            IntLit(y, _) => x == y,
            _ => false,
        },
        FloatLit(x, _) => match b {
            FloatLit(y, _) => x == y,
            _ => false,
        },
        StrLit(x, _) => match b {
            StrLit(y, _) => x == y,
            _ => false,
        },
        BoolLit(x, _) => match b {
            BoolLit(y, _) => x == y,
            _ => false,
        },
        Ident(x, _) => match b {
            Ident(y, _) => x == y,
            _ => false,
        },
        Unary(op1, r1, _) => match b {
            Unary(op2, r2, _) => op1 == op2 && ast_eq(r1, r2),
            _ => false,
        },
        Binary(op1, l1, r1, _) => match b {
            Binary(op2, l2, r2, _) => op1 == op2 && ast_eq(l1, l2) && ast_eq(r1, r2),
            _ => false,
        },
        Logical(op1, l1, r1, _) => match b {
            Logical(op2, l2, r2, _) => op1 == op2 && ast_eq(l1, l2) && ast_eq(r1, r2),
            _ => false,
        },
        Call(c1, a1, _) => match b {
            Call(c2, a2, _) => ast_eq(c1, c2) && ast_eq_list(a1, a2),
            _ => false,
        },
        Pipe(l1, t1, a1, _) => match b {
            Pipe(l2, t2, a2, _) => ast_eq(l1, l2) && ast_eq(t1, t2) && ast_eq_list(a1, a2),
            _ => false,
        },
        Index(t1, i1, _) => match b {
            Index(t2, i2, _) => ast_eq(t1, t2) && ast_eq(i1, i2),
            _ => false,
        },
        ListLit(e1, _) => match b {
            ListLit(e2, _) => ast_eq_list(e1, e2),
            _ => false,
        },
        FnLit(p1, m1, _, t1, r1, b1, n1, c1, _) => match b {
            FnLit(p2, m2, _, t2, r2, b2, n2, c2, _) => ast_eq_strs(p1, p2) && ast_eq_bools(m1, m2) && ast_eq_list(t1, t2) && ast_eq(r1, r2) && ast_eq(b1, b2) && n1 == n2 && ast_eq_strs(c1, c2),
            _ => false,
        },
        Block(s1, _) => match b {
            Block(s2, _) => ast_eq_list(s1, s2),
            _ => false,
        },
        IfExpr(c1, t1, e1, _) => match b {
            IfExpr(c2, t2, e2, _) => ast_eq(c1, c2) && ast_eq(t1, t2) && ast_eq(e1, e2),
            _ => false,
        },
        MatchExpr(s1, a1, _) => match b {
            MatchExpr(s2, a2, _) => ast_eq(s1, s2) && ast_eq_list(a1, a2),
            _ => false,
        },
        MatchArm(p1, g1, b1, _) => match b {
            MatchArm(p2, g2, b2, _) => ast_eq(p1, p2) && ast_eq(g1, g2) && ast_eq(b1, b2),
            _ => false,
        },
        VariantAccess(e1, v1, _) => match b {
            VariantAccess(e2, v2, _) => e1 == e2 && v1 == v2,
            _ => false,
        },
        PkgAccess(p1, n1, _) => match b {
            PkgAccess(p2, n2, _) => p1 == p2 && n1 == n2,
            _ => false,
        },
        QualVariantAccess(p1, e1, v1, _) => match b {
            QualVariantAccess(p2, e2, v2, _) => p1 == p2 && e1 == e2 && v1 == v2,
            _ => false,
        },
        TryExpr(e1, _) => match b {
            TryExpr(e2, _) => ast_eq(e1, e2),
            _ => false,
        },
        RecvExpr(e1, _) => match b {
            RecvExpr(e2, _) => ast_eq(e1, e2),
            _ => false,
        },
        RecordLit(n1, v1, _) => match b {
            RecordLit(n2, v2, _) => ast_eq_strs(n1, n2) && ast_eq_list(v1, v2),
            _ => false,
        },
        RecordUpdate(ba1, n1, v1, _) => match b {
            RecordUpdate(ba2, n2, v2, _) => ast_eq(ba1, ba2) && ast_eq_strs(n1, n2) && ast_eq_list(v1, v2),
            _ => false,
        },
        FieldAccess(e1, f1, _) => match b {
            FieldAccess(e2, f2, _) => ast_eq(e1, e2) && f1 == f2,
            _ => false,
        },
        PatWildcard(_) => match b {
            PatWildcard(_) => true,
            _ => false,
        },
        PatLiteral(l1, _) => match b {
            PatLiteral(l2, _) => ast_eq(l1, l2),
            _ => false,
        },
        PatBinding(n1, _) => match b {
            PatBinding(n2, _) => n1 == n2,
            _ => false,
        },
        PatVariant(p1, e1, v1, b1, _) => match b {
            PatVariant(p2, e2, v2, b2, _) => p1 == p2 && e1 == e2 && v1 == v2 && ast_eq_list(b1, b2),
            _ => false,
        },
        PatRecord(n1, _) => match b {
            PatRecord(n2, _) => ast_eq_strs(n1, n2),
            _ => false,
        },
        LetStmt(n1, _, m1, pb1, _, i1, _) => match b {
            LetStmt(n2, _, m2, pb2, _, i2, _) => n1 == n2 && m1 == m2 && pb1 == pb2 && ast_eq(i1, i2),
            _ => false,
        },
        ConstDecl(n1, _, pb1, _, i1, _) => match b {
            ConstDecl(n2, _, pb2, _, i2, _) => n1 == n2 && pb1 == pb2 && ast_eq(i1, i2),
            _ => false,
        },
        AssignStmt(t1, v1, _) => match b {
            AssignStmt(t2, v2, _) => ast_eq(t1, t2) && ast_eq(v1, v2),
            _ => false,
        },
        ExprStmt(e1, _) => match b {
            ExprStmt(e2, _) => ast_eq(e1, e2),
            _ => false,
        },
        WhileStmt(c1, b1, _) => match b {
            WhileStmt(c2, b2, _) => ast_eq(c1, c2) && ast_eq(b1, b2),
            _ => false,
        },
        ForStmt(v1, _, _, _, i1, ch1, b1, _) => match b {
            ForStmt(v2, _, _, _, i2, ch2, b2, _) => v1 == v2 && ast_eq(i1, i2) && ch1 == ch2 && ast_eq(b1, b2),
            _ => false,
        },
        LabelStmt(l1, inner1, _) => match b {
            LabelStmt(l2, inner2, _) => l1 == l2 && ast_eq(inner1, inner2),
            _ => false,
        },
        ReturnStmt(v1, _) => match b {
            ReturnStmt(v2, _) => ast_eq(v1, v2),
            _ => false,
        },
        FnDecl(n1, _, p1, f1, _) => match b {
            FnDecl(n2, _, p2, f2, _) => n1 == n2 && p1 == p2 && ast_eq(f1, f2),
            _ => false,
        },
        MethodDecl(t1, n1, _, f1, _) => match b {
            MethodDecl(t2, n2, _, f2, _) => t1 == t2 && n1 == n2 && ast_eq(f1, f2),
            _ => false,
        },
        DestructLet(n1, _, m1, i1, _) => match b {
            DestructLet(n2, _, m2, i2, _) => ast_eq_strs(n1, n2) && m1 == m2 && ast_eq(i1, i2),
            _ => false,
        },
        TupleLit(e1, _) => match b {
            TupleLit(e2, _) => ast_eq_list(e1, e2),
            _ => false,
        },
        EnumDecl(n1, tp1, v1, p1, _) => match b {
            EnumDecl(n2, tp2, v2, p2, _) => n1 == n2 && ast_eq_strs(tp1, tp2) && ast_eq_list(v1, v2) && p1 == p2,
            _ => false,
        },
        EnumVariantDecl(n1, a1, f1, _) => match b {
            EnumVariantDecl(n2, a2, f2, _) => n1 == n2 && a1 == a2 && ast_eq_list(f1, f2),
            _ => false,
        },
        ImportDecl(a1, _, p1, _, _) => match b {
            ImportDecl(a2, _, p2, _, _) => a1 == a2 && p1 == p2,
            _ => false,
        },
        SpawnStmt(c1, _) => match b {
            SpawnStmt(c2, _) => ast_eq(c1, c2),
            _ => false,
        },
        SelectStmt(a1, h1, d1, _, _) => match b {
            SelectStmt(a2, h2, d2, _, _) => ast_eq_list(a1, a2) && h1 == h2 && ast_eq(d1, d2),
            _ => false,
        },
        SelectArm(s1, bn1, _, c1, v1, b1, _) => match b {
            SelectArm(s2, bn2, _, c2, v2, b2, _) => s1 == s2 && bn1 == bn2 && ast_eq(c1, c2) && ast_eq(v1, v2) && ast_eq(b1, b2),
            _ => false,
        },
        SendStmt(c1, v1, _) => match b {
            SendStmt(c2, v2, _) => ast_eq(c1, c2) && ast_eq(v1, v2),
            _ => false,
        },
        BreakStmt(l1, _) => match b {
            BreakStmt(l2, _) => l1 == l2,
            _ => false,
        },
        ContinueStmt(l1, _) => match b {
            ContinueStmt(l2, _) => l1 == l2,
            _ => false,
        },
        DeferStmt(b1, c1, _) => match b {
            DeferStmt(b2, c2, _) => ast_eq(b1, b2) && ast_eq_strs(c1, c2),
            _ => false,
        },
        TypeAliasDecl(n1, t1, p1, _) => match b {
            TypeAliasDecl(n2, t2, p2, _) => n1 == n2 && ast_eq(t1, t2) && p1 == p2,
            _ => false,
        },
        TEName(p1, n1, c1, a1, _) => match b {
            TEName(p2, n2, c2, a2, _) => p1 == p2 && n1 == n2 && c1 == c2 && ast_eq_list(a1, a2),
            _ => false,
        },
        TEList(e1, _) => match b {
            TEList(e2, _) => ast_eq(e1, e2),
            _ => false,
        },
        TEFn(p1, r1, _) => match b {
            TEFn(p2, r2, _) => ast_eq_list(p1, p2) && ast_eq(r1, r2),
            _ => false,
        },
        TERecord(n1, t1, r1, _) => match b {
            TERecord(n2, t2, r2, _) => ast_eq_strs(n1, n2) && ast_eq_list(t1, t2) && ast_eq(r1, r2),
            _ => false,
        },
        TETuple(t1, _) => match b {
            TETuple(t2, _) => ast_eq_list(t1, t2),
            _ => false,
        },
        NoNode => match b {
            NoNode => true,
            _ => false,
        },
    }
}

// ast_eq_list 比较两个节点列表结构相等 / ast_eq_list compares node lists structurally
pub fn ast_eq_list(xs, ys) {
    if len(xs) != len(ys) {
        return false
    }
    let mut i = 0
    while i < len(xs) {
        if !ast_eq(xs[i], ys[i]) {
            return false
        }
        i = i + 1
    }
    true
}

// ast_eq_strs 比较两个字符串列表相等 / ast_eq_strs compares string lists
fn ast_eq_strs(xs, ys) {
    if len(xs) != len(ys) {
        return false
    }
    let mut i = 0
    while i < len(xs) {
        if xs[i] != ys[i] {
            return false
        }
        i = i + 1
    }
    true
}

// ast_eq_bools 比较两个 bool 列表相等 / ast_eq_bools compares bool lists
fn ast_eq_bools(xs, ys) {
    if len(xs) != len(ys) {
        return false
    }
    let mut i = 0
    while i < len(xs) {
        if xs[i] != ys[i] {
            return false
        }
        i = i + 1
    }
    true
}

// span_of 取节点的源码区间 / span_of returns a node's source span
pub fn span_of(n) {
    match n {
        IntLit(_, sp) => sp,
        FloatLit(_, sp) => sp,
        StrLit(_, sp) => sp,
        BoolLit(_, sp) => sp,
        Ident(_, sp) => sp,
        Unary(_, _, sp) => sp,
        Binary(_, _, _, sp) => sp,
        Logical(_, _, _, sp) => sp,
        Call(_, _, sp) => sp,
        Pipe(_, _, _, sp) => sp,
        Index(_, _, sp) => sp,
        ListLit(_, sp) => sp,
        FnLit(_, _, _, _, _, _, _, _, sp) => sp,
        Block(_, sp) => sp,
        IfExpr(_, _, _, sp) => sp,
        MatchExpr(_, _, sp) => sp,
        MatchArm(_, _, _, sp) => sp,
        VariantAccess(_, _, sp) => sp,
        PkgAccess(_, _, sp) => sp,
        QualVariantAccess(_, _, _, sp) => sp,
        TryExpr(_, sp) => sp,
        RecvExpr(_, sp) => sp,
        RecordLit(_, _, sp) => sp,
        RecordUpdate(_, _, _, sp) => sp,
        FieldAccess(_, _, sp) => sp,
        PatWildcard(sp) => sp,
        PatLiteral(_, sp) => sp,
        PatBinding(_, sp) => sp,
        PatVariant(_, _, _, _, sp) => sp,
        PatRecord(_, sp) => sp,
        LetStmt(_, _, _, _, _, _, sp) => sp,
        ConstDecl(_, _, _, _, _, sp) => sp,
        AssignStmt(_, _, sp) => sp,
        ExprStmt(_, sp) => sp,
        WhileStmt(_, _, sp) => sp,
        ForStmt(_, _, _, _, _, _, _, sp) => sp,
        LabelStmt(_, _, sp) => sp,
        ReturnStmt(_, sp) => sp,
        FnDecl(_, _, _, _, sp) => sp,
        MethodDecl(_, _, _, _, sp) => sp,
        DestructLet(_, _, _, _, sp) => sp,
        TupleLit(_, sp) => sp,
        EnumDecl(_, _, _, _, sp) => sp,
        EnumVariantDecl(_, _, _, sp) => sp,
        ImportDecl(_, _, _, _, sp) => sp,
        SpawnStmt(_, sp) => sp,
        SelectStmt(_, _, _, _, sp) => sp,
        SelectArm(_, _, _, _, _, _, sp) => sp,
        SendStmt(_, _, sp) => sp,
        BreakStmt(_, sp) => sp,
        ContinueStmt(_, sp) => sp,
        DeferStmt(_, _, sp) => sp,
        TypeAliasDecl(_, _, _, sp) => sp,
        TEName(_, _, _, _, sp) => sp,
        TEList(_, sp) => sp,
        TEFn(_, _, sp) => sp,
        TERecord(_, _, _, sp) => sp,
        TETuple(_, sp) => sp,
        NoNode => Sp(0, 0),
    }
}

// lower_pipes 做管道脱糖：x |> f(a) 展开为 f(x, a)，递归下推整个语法树
// lower_pipes desugars pipes: x |> f(a) becomes f(x, a), pushed recursively through the tree
pub fn lower_pipes(stmts) {
    lower_pipe_nodes(stmts)
}

// lower_pipe_packages 做包级管道脱糖（多文件）/ lower_pipe_packages desugars pipes across a package's files
pub fn lower_pipe_packages(pkgs_stmts) {
    let mut out = []
    for pkg in pkgs_stmts {
        let mut files = []
        for stmts in pkg {
            push(files, lower_pipe_nodes(stmts))
        }
        push(out, files)
    }
    out
}

// lower_pipe_nodes 对节点列表脱糖 / lower_pipe_nodes desugars a node list
fn lower_pipe_nodes(nodes) {
    let mut out = []
    for n in nodes {
        push(out, lower_pipe_node(n))
    }
    out
}

// lower_pipe_node 对单个节点脱糖 / lower_pipe_node desugars one node
fn lower_pipe_node(n) {
    match n {
        Unary(op, rhs, sp) => Unary(op, lower_pipe_node(rhs), sp),
        Binary(op, lhs, rhs, sp) => Binary(op, lower_pipe_node(lhs), lower_pipe_node(rhs), sp),
        Logical(op, lhs, rhs, sp) => Logical(op, lower_pipe_node(lhs), lower_pipe_node(rhs), sp),
        Call(callee, args, sp) => Call(lower_pipe_node(callee), lower_pipe_nodes(args), sp),
        Pipe(lhs, target, args, sp) => {
            let mut call_args = [lower_pipe_node(lhs)]
            for a in args {
                push(call_args, lower_pipe_node(a))
            }
            Call(lower_pipe_node(target), call_args, sp)
        },
        Index(target, idx, sp) => Index(lower_pipe_node(target), lower_pipe_node(idx), sp),
        ListLit(elems, sp) => ListLit(lower_pipe_nodes(elems), sp),
        FnLit(params, muts, pspans, param_tys, ret_ty, body, name, crefs, sp) => FnLit(params, muts, pspans, param_tys, ret_ty, lower_pipe_node(body), name, crefs, sp),
        Block(stmts, sp) => Block(lower_pipe_nodes(stmts), sp),
        IfExpr(cond, then, els, sp) => IfExpr(lower_pipe_node(cond), lower_pipe_node(then), lower_pipe_node(els), sp),
        MatchExpr(scrut, arms, sp) => MatchExpr(lower_pipe_node(scrut), lower_pipe_nodes(arms), sp),
        MatchArm(pat, guard, body, sp) => MatchArm(pat, lower_pipe_node(guard), lower_pipe_node(body), sp),
        TryExpr(inner, sp) => TryExpr(lower_pipe_node(inner), sp),
        RecvExpr(ch, sp) => RecvExpr(lower_pipe_node(ch), sp),
        LetStmt(name, nsp, is_mut, is_pub, ty, init, sp) => LetStmt(name, nsp, is_mut, is_pub, ty, lower_pipe_node(init), sp),
        ConstDecl(name, nsp, is_pub, ty, init, sp) => ConstDecl(name, nsp, is_pub, ty, lower_pipe_node(init), sp),
        AssignStmt(target, val, sp) => AssignStmt(lower_pipe_node(target), lower_pipe_node(val), sp),
        ExprStmt(e, sp) => ExprStmt(lower_pipe_node(e), sp),
        WhileStmt(cond, body, sp) => WhileStmt(lower_pipe_node(cond), lower_pipe_node(body), sp),
        ForStmt(name, nsp, idx, isp, iter, is_chan, body, sp) => ForStmt(name, nsp, idx, isp, lower_pipe_node(iter), is_chan, lower_pipe_node(body), sp),
        ReturnStmt(val, sp) => ReturnStmt(lower_pipe_node(val), sp),
        FnDecl(name, nsp, is_pub, lit, sp) => FnDecl(name, nsp, is_pub, lower_pipe_node(lit), sp),
        SpawnStmt(call, sp) => SpawnStmt(lower_pipe_node(call), sp),
        SelectStmt(arms, has_default, dflt, dsp, sp) => SelectStmt(lower_pipe_nodes(arms), has_default, lower_pipe_node(dflt), dsp, sp),
        SelectArm(is_send, bind, bsp, ch, val, body, sp) => SelectArm(is_send, bind, bsp, lower_pipe_node(ch), lower_pipe_node(val), lower_pipe_node(body), sp),
        SendStmt(ch, val, sp) => SendStmt(lower_pipe_node(ch), lower_pipe_node(val), sp),
        DeferStmt(body, crefs, sp) => DeferStmt(lower_pipe_node(body), crefs, sp),
        RecordLit(names, vals, sp) => RecordLit(names, lower_pipe_nodes(vals), sp),
        RecordUpdate(base, names, vals, sp) => RecordUpdate(lower_pipe_node(base), names, lower_pipe_nodes(vals), sp),
        FieldAccess(base, field, sp) => FieldAccess(lower_pipe_node(base), field, sp),
        TypeAliasDecl(name, te, is_pub, sp) => TypeAliasDecl(name, te, is_pub, sp),
        _ => n,
    }
}

// import_alias 求 import 的别名：显式别名优先，否则取路径末段
// import_alias resolves an import alias: explicit alias wins, else the last path segment
pub fn import_alias(alias, path) {
    if alias != "" {
        alias
    } else {
        let mut cut = 0
        let mut i = 0
        while i < str_len(path) {
            if char_at(path, i) == "/" {
                cut = i + 1
            }
            i = i + 1
        }
        substr(path, cut, str_len(path) - cut)
    }
}

// aliases_of 构建导入路径到别名的映射表 / aliases_of builds the map of import path to effective alias
pub fn aliases_of(imports) {
    let mut am = map()
    for imp in imports {
        match imp {
            Node::ImportDecl(alias, _, path, _, _) => put(am, import_alias(alias, path), path),
            _ => {},
        }
    }
    am
}
