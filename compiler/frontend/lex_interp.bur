// lex_interp.bur — 多行内联与插值。
// lex_interp.bur — ml-inline and interpolation.

// lex_ml_inline 扫描多行字符串的单个内容行：收集字面量到行尾（\n）或嵌套插值；插值恢复时继续本函数。
// lex_ml_inline scans one multiline row: collects literal bytes to end-of-line
// or a nested interpolation; resumes here after interpolation.
fn lex_ml_inline(src, mut st, mut toks, mut diags, mut comments, mut seg, mut first, mut any_interp) {
    while st[1] < str_len(src) {
        let c = lex_peek(src, st)
        if c == "\n" {
            seg[0] = seg[0] + "\n"
            lex_bump(st)
            return
        }
        if c == "" + chr(123) + "" && substr(src, st[1] + 1, 1) != "" + chr(123) + "" {
            any_interp[0] = true
            lex_bump(st)
            lex_emit(st, toks, if first[0] {
                t_interp_start
            } else {
                t_interp_mid
            }, seg[0])
            first[0] = false
            seg[0] = ""
            lex_interpolation(src, st, toks, diags, comments, st[1], fn(mut s, mut st, mut toks, mut d, mut c) {
                lex_ml_inline(s, st, toks, d, c, seg, first, any_interp)
            })
            return
        }
        if c == "" + chr(123) + "" && substr(src, st[1] + 1, 1) == "" + chr(123) + "" {
            seg[0] = seg[0] + chr(123)
            st[1] = st[1] + 2
            continue
        }
        if c == "\\" && st[1] + 1 < str_len(src) {
            let e = substr(src, st[1] + 1, 1)
            if e == "n" {
                seg[0] = seg[0] + "\n"
                st[1] = st[1] + 2
                continue
            }
            if e == "t" {
                seg[0] = seg[0] + "\t"
                st[1] = st[1] + 2
                continue
            }
            if e == "\"" {
                seg[0] = seg[0] + "\""
                st[1] = st[1] + 2
                continue
            }
            if e == "\\" {
                seg[0] = seg[0] + "\\"
                st[1] = st[1] + 2
                continue
            }
            if e == "r" {
                seg[0] = seg[0] + chr(13)
                st[1] = st[1] + 2
                continue
            }
            lex_fail(diags, st[1], st[1] + 2, "E1003", "supported escapes: \\n \\t \\\" \\\\ \\r", "bad escape \\" + e)
            st[1] = st[1] + 2
            continue
        }
        seg[0] = seg[0] + c
        lex_bump(st)
    }
}

// lex_interpolation 扫描插值表达式直到匹配的 `}`；block、match 与嵌套插值里的花括号先各自配平，再恢复外层字符串模式。
// resume 是恢复扫描的回调（普通串或三引号多行串各自的行内扫描）。
// lex_interpolation scans the interpolation expression up to the matching `}`;
// braces inside blocks, match arms,
// and nested interpolations balance before the outer string resumes.
// resume continues the outer scan.
fn lex_interpolation(src, mut st, mut toks, mut diags, mut comments, open, resume) {
    let mut depth = 0
    while st[1] < str_len(src) {
        if lex_peek(src, st) == "}" && depth == 0 {
            st[0] = st[1]
            lex_bump(st)
            resume(src, st, toks, diags, comments)
            return
        }
        st[0] = st[1]
        let before = len(toks)
        lex_scan(src, st, toks, diags, comments)
        let mut i = before
        while i < len(toks) {
            let t = tok_type(toks[i])
            if t == t_lbrace {
                depth = depth + 1
            } else if t == t_rbrace {
                depth = depth - 1
            }
            i = i + 1
        }
        if depth < 0 {
            resume(src, st, toks, diags, comments)
            return
        }
    }
    lex_fail(diags, open, open + 1, "E1004", "add a closing '}' before the end of the string", "unterminated string interpolation")
}
