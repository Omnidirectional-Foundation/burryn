// fold.bur — 编译期常量折叠：const 初始化表达式在编译期求值，
// 溢出/除零等在编译期即报错（运行时 trap 提前到编译期）。
// Compile-time constant folding: const initializers evaluate at compile time,
// so runtime traps (overflow, division by zero) surface as compile errors.
// 求值器分两档：纯表达式求值 fc_* 与语句级重写 fr_*（把 const 声明替换为折叠值）。
// Evaluation splits into pure expression folding (fc_*) and statement rewriting (fr_*),
// which replaces const declarations with their folded values.
import "burryn.dev/compiler/lib"

// fold_consts 是脚本级折叠入口 / fold_consts is the script-level fold entry
pub fn fold_consts(stmts) {
    let mut diags = []
    let mut dfiles = []
    let mut e_n = []
    let mut e_v = []
    let out = fr_stmts(lower_pipes(stmts), map(), map(), map(), e_n, e_v, diags, dfiles, "")
    FoldOut::FoldedScript(out, diags)
}

// fold_const_packages 是包级折叠入口：逐包折叠，pub const 提升为限定名（<包路径>.<名>）供跨包引用
// fold_const_packages is the package-level entry: folds per package and lifts
// pub consts to qualified names for cross-package references
pub fn fold_const_packages(pkgs_stmts, pkgs_fpaths, pkg_paths, pkgs_imports) {
    let mut diags = []
    let mut dfiles = []
    let mut qenv = map()
    let mut out_pkgs = []
    let lowered_pkgs = lower_pipe_packages(pkgs_stmts)
    let mut pi = 0
    while pi < len(pkgs_stmts) {
        let files = lowered_pkgs[pi]
        let fpaths = pkgs_fpaths[pi]
        let imps = pkgs_imports[pi]
        let mut amaps = []
        let mut fi = 0
        while fi < len(files) {
            push(amaps, aliases_of(imps[fi]))
            fi = fi + 1
        }
        let mut c_file = []
        let mut c_name = []
        let mut c_init = []
        let mut c_nsp = []
        let mut c_state = []
        fi = 0
        while fi < len(files) {
            for s in files[fi] {
                match s {
                    ConstDecl(n, nsp, _, _, init, _) => {
                        push(c_file, fi)
                        push(c_name, n)
                        push(c_init, init)
                        push(c_nsp, nsp)
                        push(c_state, 0)
                    },
                    _ => {},
                }
            }
            fi = fi + 1
        }
        let mut penv = map()
        let mut pending = map()
        let mut ci = 0
        while ci < len(c_name) {
            put(pending, c_name[ci], true)
            ci = ci + 1
        }
        let mut e_n0 = []
        let mut e_v0 = []
        // 不动点迭代：每轮解析一个依赖就绪的 const，直到不再有进展
        // Fixed-point iteration: each round resolves one dependency-ready const, until no progress
        let mut progress = true
        while progress {
            progress = false
            ci = 0
            while ci < len(c_name) {
                if c_state[ci] == 0 {
                    let mut adiags = []
                    let r = fc_eval(c_init[ci], amaps[c_file[ci]], penv, qenv, pending, e_n0, e_v0, adiags)
                    match r {
                        FRVal(v) => {
                            c_state[ci] = 1
                            put(penv, c_name[ci], v)
                            put(pending, c_name[ci], false)
                            progress = true
                        },
                        FRBlocked(_) => {},
                        _ => {
                            c_state[ci] = 2
                            put(penv, c_name[ci], FVPoison)
                            put(pending, c_name[ci], false)
                            progress = true
                        },
                    }
                }
                ci = ci + 1
            }
        }
        // 收敛后仍未解析 = 循环依赖，报 E0391 并置毒值
        // Still unresolved after convergence = a cycle: report E0391 and poison the value
        let mut cycled = map()
        ci = 0
        while ci < len(c_name) {
            if c_state[ci] == 0 {
                match c_nsp[ci] {
                    Sp(s0, e0) => {
                        push(diags, lib::DiagT::Diag(true, "E0391", "cycle detected while evaluating constant `" + c_name[ci] + "`", "constant initializers cannot depend on themselves", s0, e0))
                        push(dfiles, fpaths[c_file[ci]])
                    },
                }
                put(penv, c_name[ci], FVPoison)
                put(pending, c_name[ci], false)
                put(cycled, c_name[ci], true)
            }
            ci = ci + 1
        }
        let mut new_files = []
        fi = 0
        while fi < len(files) {
            let mut e_n = []
            let mut e_v = []
            push(new_files, fr_top_stmts(files[fi], amaps[fi], penv, qenv, cycled, e_n, e_v, diags, dfiles, fpaths[fi]))
            fi = fi + 1
        }
        push(out_pkgs, new_files)
        fi = 0
        while fi < len(files) {
            for s in files[fi] {
                match s {
                    ConstDecl(n, _, is_pub, _, _, _) => {
                        if is_pub {
                            match get(penv, n) {
                                Some(v) => put(qenv, pkg_paths[pi] + "." + n, v),
                                None => {},
                            }
                        }
                    },
                    _ => {},
                }
            }
            fi = fi + 1
        }
        pi = pi + 1
    }
    FoldOut::FoldedPkgs(out_pkgs, diags, dfiles)
}


