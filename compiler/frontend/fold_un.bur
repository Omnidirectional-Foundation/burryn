// fold_un.bur — 一元/字面量折叠。
// fold_un.bur — unary/literal fold.


// fc_un 折叠一元运算（负号/取反，含负边界溢出检查）/ fc_un folds unary ops (negate, not; min-int negation traps)
fn fc_un(op, v, sp, mut adiags) {
    if op == t_minus {
        match v {
            FVInt(x) => if x == fold_min_int {
                fc_trap("integer overflow: -(" + str(x) + ")", sp, adiags)
            } else {
                FRVal(FVInt(0 - x))
            },
            FVFloat(x) => FRVal(FVFloat(0.0 - x)),
            _ => FRSoft,
        }
    } else if op == t_bang {
        match v {
            FVBool(x) => FRVal(FVBool(!x)),
            _ => FRSoft,
        }
    } else {
        FRSoft
    }
}

// fc_lit 把折叠值转回字面量 AST 节点 / fc_lit turns a folded value back into a literal AST node
fn fc_lit(v, sp) {
    match v {
        FVInt(x) => IntLit(x, sp),
        FVFloat(x) => FloatLit(x, sp),
        FVStr(x) => StrLit(x, sp),
        FVBool(x) => BoolLit(x, sp),
        _ => NoNode,
    }
}
