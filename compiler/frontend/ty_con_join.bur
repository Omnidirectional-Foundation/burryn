// ty_con_join.bur — 约束合并。
// ty_con_join.bur — constraint join.



// con_join 拼接约束文本 / con_join joins constraint text
fn con_join(con, sep) {
    join(con_set(con), sep)
}

// con_merge 合并约束（名字交集）/ con_merge merges constraints (name intersection)
fn con_merge(a, b) {
    if a == "" {
        b
    } else if b == "" || a == b {
        a
    } else {
        let mut inter = []
        for x in con_set(a) {
            if contains(con_set(b), x) {
                push(inter, x)
            }
        }
        if len(inter) == 0 {
            "!"
        } else {
            let mut best = "!"
            for name in ["num", "addord", "key", "int", "float", "str"] {
                let set = con_set(name)
                if len(set) == len(inter) {
                    let mut same = true
                    for x in inter {
                        if !contains(set, x) {
                            same = false
                        }
                    }
                    if same && best == "!" {
                        best = name
                    }
                }
            }
            best
        }
    }
}
