// ast_eq.bur — AST 结构相等。
// ast_eq.bur — AST structural equality.

// ast_eq 比较两个 AST 节点结构相等（常量折叠与格式化器判重用）
// ast_eq compares two AST nodes structurally (used by const folding and the formatter)
fn ast_eq(a, b) {
    // 结构相等：逐变体配对比较，字段递归
    // Structural equality: pair variants and compare fields recursively
    match a {
        IntLit(x, _) => ast_eq_int(x, b),
        FloatLit(x, _) => ast_eq_float(x, b),
        StrLit(x, _) => ast_eq_str(x, b),
        BoolLit(x, _) => ast_eq_bool(x, b),
        Ident(x, _) => ast_eq_ident(x, b),
        Unary(op1, r1, _) => ast_eq_unary(op1, r1, b),
        Binary(op1, l1, r1, _) => ast_eq_binary(op1, l1, r1, b),
        Logical(op1, l1, r1, _) => ast_eq_logical(op1, l1, r1, b),
        Call(c1, a1, _) => ast_eq_call(c1, a1, b),
        Pipe(l1, t1, a1, _) => ast_eq_pipe(l1, t1, a1, b),
        Index(t1, i1, _) => ast_eq_index(t1, i1, b),
        ListLit(e1, _) => ast_eq_list_lit(e1, b),
        FnLit(p1, m1, _, t1, r1, b1, n1, c1, _) => ast_eq_fn_lit(p1, m1, t1, r1, b1, n1, c1, b),
        Block(s1, _) => ast_eq_block(s1, b),
        IfExpr(c1, t1, e1, _) => ast_eq_if(c1, t1, e1, b),
        MatchExpr(s1, a1, _) => ast_eq_match(s1, a1, b),
        MatchArm(p1, g1, b1, _) => ast_eq_match_arm(p1, g1, b1, b),
        VariantAccess(e1, v1, _) => ast_eq_variant_access(e1, v1, b),
        PkgAccess(p1, n1, _) => ast_eq_pkg_access(p1, n1, b),
        QualVariantAccess(p1, e1, v1, _) => ast_eq_qual_variant(p1, e1, v1, b),
        TryExpr(e1, _) => ast_eq_try(e1, b),
        RecvExpr(e1, _) => ast_eq_recv(e1, b),
        RecordLit(n1, v1, _) => ast_eq_record_lit(n1, v1, b),
        RecordUpdate(ba1, n1, v1, _) => ast_eq_record_update(ba1, n1, v1, b),
        FieldAccess(e1, f1, _) => ast_eq_field_access(e1, f1, b),
        PatWildcard(_) => ast_eq_pat_wild(b),
        PatLiteral(l1, _) => ast_eq_pat_lit(l1, b),
        PatBinding(n1, _) => ast_eq_pat_bind(n1, b),
        PatVariant(p1, e1, v1, b1, _) => ast_eq_pat_variant(p1, e1, v1, b1, b),
        PatRecord(n1, _) => ast_eq_pat_rec(n1, b),
        LetStmt(n1, _, m1, pb1, _, i1, _) => ast_eq_let(n1, m1, pb1, i1, b),
        ConstDecl(n1, _, pb1, _, i1, _) => ast_eq_const(n1, pb1, i1, b),
        AssignStmt(t1, v1, _) => ast_eq_assign(t1, v1, b),
        ExprStmt(e1, _) => ast_eq_expr_stmt(e1, b),
        WhileStmt(c1, b1, _) => ast_eq_while(c1, b1, b),
        ForStmt(v1, _, _, _, i1, ch1, b1, _) => ast_eq_for(v1, i1, ch1, b1, b),
        LabelStmt(l1, inner1, _) => ast_eq_label(l1, inner1, b),
        ReturnStmt(v1, _) => ast_eq_return(v1, b),
        FnDecl(n1, _, p1, f1, _) => ast_eq_fn_decl(n1, p1, f1, b),
        MethodDecl(t1, n1, _, f1, _) => ast_eq_method_decl(t1, n1, f1, b),
        DestructLet(n1, _, m1, i1, _) => ast_eq_destruct_let(n1, m1, i1, b),
        TupleLit(e1, _) => ast_eq_tuple_lit(e1, b),
        EnumDecl(n1, tp1, v1, p1, _) => ast_eq_enum_decl(n1, tp1, v1, p1, b),
        EnumVariantDecl(n1, a1, f1, _) => ast_eq_enum_variant(n1, a1, f1, b),
        ImportDecl(a1, _, p1, _, _) => ast_eq_import(a1, p1, b),
        SpawnStmt(c1, _) => ast_eq_spawn(c1, b),
        SelectStmt(a1, h1, d1, _, _) => ast_eq_select(a1, h1, d1, b),
        SelectArm(s1, bn1, _, c1, v1, b1, _) => ast_eq_select_arm(s1, bn1, c1, v1, b1, b),
        SendStmt(c1, v1, _) => ast_eq_send(c1, v1, b),
        BreakStmt(l1, _) => ast_eq_break(l1, b),
        ContinueStmt(l1, _) => ast_eq_continue(l1, b),
        DeferStmt(b1, c1, _) => ast_eq_defer(b1, c1, b),
        TypeAliasDecl(n1, t1, p1, _) => ast_eq_type_alias(n1, t1, p1, b),
        TEName(p1, n1, c1, a1, _) => ast_eq_te_name(p1, n1, c1, a1, b),
        TEList(e1, _) => ast_eq_te_list(e1, b),
        TEFn(p1, r1, _) => ast_eq_te_fn(p1, r1, b),
        TERecord(n1, t1, r1, _) => ast_eq_te_record(n1, t1, r1, b),
        TETuple(t1, _) => ast_eq_te_tuple(t1, b),
        NoNode => ast_eq_nonode(b),
    }
}

// ast_eq_list 比较两个节点列表结构相等 / ast_eq_list compares node lists structurally
pub fn ast_eq_list(xs, ys) {
    if len(xs) != len(ys) {
        return false
    }
    let mut i = 0
    while i < len(xs) {
        if !ast_eq(xs[i], ys[i]) {
            return false
        }
        i = i + 1
    }
    true
}
