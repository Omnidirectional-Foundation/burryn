// ast_span.bur — span / perr。
// ast_span.bur — span / perr.

import "burryn.dev/compiler/lib"

// perr 构造解析错误诊断 / perr builds a parse-error diagnostic
pub fn perr(code, help, msg, sp) {
    match sp {
        Sp(s, e) => Err(lib::DiagT::Diag(true, code, msg, help, s, e)),
    }
}

// sp_union 取两个区间的并集 / sp_union computes the union of two spans
fn sp_union(a, b) {
    match a {
        Sp(s1, e1) => match b {
            Sp(s2, e2) => Sp(if s2 < s1 {
                s2
            } else {
                s1
            }, if e2 > e1 {
                e2
            } else {
                e1
            }),
        },
    }
}


