// fold_trap.bur — trap/of_val。
// fold_trap.bur — trap/of_val.

import "burryn.dev/compiler/lib"

// fc_trap 报常量求值 trap 错误（运行时 trap 提前到编译期）/ fc_trap reports a constant-evaluation trap error
fn fc_trap(text, sp, mut adiags) {
    match sp {
        Sp(s0, e0) => push(adiags, lib::DiagT::Diag(true, "E0080", "evaluating this constant traps: " + text, trap_help, s0, e0)),
    }
    FRErr
}

// fc_of_val 把折叠值映射为结果（遮蔽与毒值分派）
// fc_of_val maps a folded value to a result (masked and poison dispatch)
fn fc_of_val(v, label, sp, mut adiags) {
    match v {
        FVMasked => fc_not_const(label, sp, adiags),
        FVPoison => FRSoft,
        val => FRVal(val),
    }
}
