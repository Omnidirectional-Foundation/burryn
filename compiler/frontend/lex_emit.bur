// lex_emit.bur — 发 token / 可选分号。
// lex_emit.bur — emit token / optional semi.

import "burryn.dev/compiler/lib"

// lex_emit 发射一个 token 并更新状态 / lex_emit emits a token and updates state
fn lex_emit(mut st, mut toks, t, lexeme) {
    push(toks, lib::Token::Tok(t, lexeme, st[0], st[1]))
    st[2] = t
    st[3] = 1
}

// lex_maybe_semi 做自动分号插入：前一个 token 可结束语句且已发射过时补换行分号
// lex_maybe_semi appends a newline semicolon when the last token can end a statement
fn lex_maybe_semi(mut st, mut toks) {
    if st[3] == 1 && lex_can_end_stmt(st[2]) {
        lex_emit(st, toks, t_semi, "\n")
    }
}
