// parse_util.bur — token 游标与同步辅助。
// parse_util.bur — token cursor and sync helpers.

// p_synchronize 做错误同步：跳到下一个语句边界（配平花括号，遇分号或语句起始 token 停）
// p_synchronize does error recovery: skip to the next statement boundary
// (balanced braces, stop at semicolon or a statement starter)
fn p_synchronize(toks, mut pos) {
    let mut depth = 0
    let mut going = true
    while going && !p_check(toks, pos, t_eof) {
        let t = tok_type(p_advance(toks, pos))
        if t == t_lbrace {
            depth = depth + 1
        } else if t == t_rbrace {
            if depth > 0 {
                depth = depth - 1
            }
        } else if t == t_semi {
            if depth == 0 && !p_check(toks, pos, t_rbrace) {
                going = false
            }
        }
        if going && depth == 0 && p_starts_stmt(tok_type(p_peek(toks, pos))) {
            going = false
        }
    }
}

// p_starts_stmt 判断是否语句起始 token / p_starts_stmt tells whether t starts a statement
fn p_starts_stmt(t) {
    t == t_let || t == t_const || t == t_fn || t == t_enum || t == t_type || t == t_while || t == t_for || t == t_return || t == t_spawn || t == t_select || t == t_defer || t == t_break || t == t_continue || t == t_pub || t == t_import
}
