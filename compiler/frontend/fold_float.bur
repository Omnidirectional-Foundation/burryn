// fold_float.bur — 浮点/字符串/布尔折叠。
// fold_float.bur — float/str/bool fold.


// fc_bin_float 折叠浮点二元运算 / fc_bin_float folds float binary ops
fn fc_bin_float(op, x, y) {
    if op == t_plus || op == t_minus || op == t_star || op == t_slash {
        let r = if op == t_plus {
            x + y
        } else if op == t_minus {
            x - y
        } else if op == t_star {
            x * y
        } else {
            x / y
        }
        FRVal(FVFloat(r))
    } else if op == t_eq_eq {
        FRVal(FVBool(x == y))
    } else if op == t_bang_eq {
        FRVal(FVBool(x != y))
    } else if op == t_lt {
        FRVal(FVBool(x < y))
    } else if op == t_lt_eq {
        FRVal(FVBool(x <= y))
    } else if op == t_gt {
        FRVal(FVBool(x > y))
    } else if op == t_gt_eq {
        FRVal(FVBool(x >= y))
    } else {
        FRSoft
    }
}

