// tok_kw.bur — 关键字与语句终结。
// tok_kw.bur — keywords and stmt-end.

// lex_keyword 映射标识符到关键字编号，非关键字返回 t_ident
// lex_keyword maps words to keyword ids; unknown words stay identifiers
fn lex_keyword(word) {
    match word {
        "let" => t_let,
        "mut" => t_mut,
        "const" => t_const,
        "defer" => t_defer,
        "fn" => t_fn,
        "if" => t_if,
        "else" => t_else,
        "while" => t_while,
        "for" => t_for,
        "in" => t_in,
        "return" => t_return,
        "true" => t_true,
        "false" => t_false,
        "enum" => t_enum,
        "match" => t_match,
        "spawn" => t_spawn,
        "break" => t_break,
        "continue" => t_continue,
        "pub" => t_pub,
        "import" => t_import,
        "select" => t_select,
        "record" => t_record,
        "type" => t_type,
        "capture" => t_capture,
        _ => t_ident,
    }
}

// lex_can_end_stmt 判断 token 能否合法结束一条语句（决定自动分号插入）
// lex_can_end_stmt tells whether a token can end a statement (ASI decision)
fn lex_can_end_stmt(t) {
    t == t_ident || t == t_string || t == t_interp_end || t == t_int || t == t_float || t == t_true || t == t_false || t == t_rparen || t == t_rbracket || t == t_rbrace || t == t_question || t == t_return || t == t_break || t == t_continue
}
