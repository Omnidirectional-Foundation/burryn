// parse_type_tuple.bur — tuple 类型表达式。
// parse_type_tuple.bur — tuple type expression.

import "burryn.dev/compiler/lib"

fn p_type_tuple(toks, mut pos, _tok) {
let lp = p_advance(toks, pos)
let mut ets = []
while !p_check(toks, pos, t_rparen) {
    let et = match p_type_expr(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    push(ets, et)
    if !p_match(toks, pos, t_comma) {
        break
    }
}
let rp = match p_expect(toks, pos, t_rparen, "')' in tuple type") {
    Ok(v) => v,
    Err(d) => {
        return Err(d)
        lib::Token::Tok(0, "", 0, 0)
    },
}
Ok(TETuple(ets, sp_union(sp_of_tok(lp), sp_of_tok(rp))))
    
}
