// lex_ml.bur — 多行字符串。
// lex_ml.bur — multiline string.

// lex_ml_string 扫描三引号多行字符串：""" 后必须换行；每行行首空白忽略后必须是 \ 内容标记，
// \ 后到行尾为该行内容；全空白行 = 空行；内容行行尾换行进入字面量，结束标记前去掉段尾一个换行；转义与插值照常。
// lex_ml_string scans triple-quoted multiline strings: newline after """ ;
// leading whitespace ignored, then a \ content marker;
// content runs to end of line; blank lines are empty rows; row-ending newlines
// are part of the literal,
// the final one before """ is stripped; escapes and interpolation behave as usual.
fn lex_ml_string(src, mut st, mut toks, mut diags, mut comments) {
    lex_bump(st)
    lex_bump(st)
    if lex_peek(src, st) != "\n" {
        lex_fail(diags, st[1], st[1] + 1, "E1006", "put the content on the lines below", "expected a newline after \"\"\"")
    }
    lex_bump(st)
    let mut seg = [""]
    let mut first = [true]
    let mut any_interp = [false]
    while st[1] < str_len(src) {
        while lex_peek(src, st) == " " || lex_peek(src, st) == "\t" {
            lex_bump(st)
        }
        if lex_peek(src, st) == "\"" && lex_peek2(src, st) == "\"" && substr(src, st[1] + 2, 1) == "\"" {
            st[1] = st[1] + 3
            if str_len(seg[0]) > 0 && substr(seg[0], str_len(seg[0]) - 1, 1) == "\n" {
                seg[0] = substr(seg[0], 0, str_len(seg[0]) - 1)
            }
            if any_interp[0] {
                lex_emit(st, toks, t_interp_end, seg[0])
            } else {
                lex_emit(st, toks, t_string, seg[0])
            }
            return
        }
        if lex_peek(src, st) == "\n" {
            seg[0] = seg[0] + "\n"
            lex_bump(st)
            continue
        }
        if lex_peek(src, st) != "\\" {
            lex_fail(diags, st[1], st[1] + 1, "E1007", "mark content lines with a leading `\\`", "expected `\\` to start a content line in a \"\"\" string")
            lex_bump(st)
            continue
        }
        lex_bump(st)
        lex_ml_inline(src, st, toks, diags, comments, seg, first, any_interp)
    }
    lex_fail(diags, st[0], st[0] + 1, "E1002", "add a closing '\"'", "unterminated string")
}
