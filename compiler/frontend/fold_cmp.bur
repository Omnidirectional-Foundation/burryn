// fold_cmp.bur — 比较/浮点/字符串折叠。
// fold_cmp.bur — cmp/float/str fold.

// fc_cmp_int 折叠整数比较 / fc_cmp_int folds integer comparisons
fn fc_cmp_int(op, x, y) {
    if op == t_eq_eq {
        FRVal(FVBool(x == y))
    } else if op == t_bang_eq {
        FRVal(FVBool(x != y))
    } else if op == t_lt {
        FRVal(FVBool(x < y))
    } else if op == t_lt_eq {
        FRVal(FVBool(x <= y))
    } else if op == t_gt {
        FRVal(FVBool(x > y))
    } else if op == t_gt_eq {
        FRVal(FVBool(x >= y))
    } else {
        FRSoft
    }
}
