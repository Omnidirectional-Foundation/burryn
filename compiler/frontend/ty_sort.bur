// ty_sort.bur — 排序辅助。
// ty_sort.bur — sort helpers.


// sort_order2 按双键排序 / sort_order2 sorts by two keys
fn sort_order2(ranks, starts) {
    let n = len(ranks)
    let mut taken = []
    for _r in ranks {
        push(taken, false)
    }
    let mut out = []
    let mut c = 0
    while c < n {
        let mut best = -1
        let mut i = 0
        while i < n {
            if !taken[i] {
                if best < 0 {
                    best = i
                } else if ranks[i] < ranks[best] || ranks[i] == ranks[best] && starts[i] < starts[best] {
                    best = i
                }
            }
            i = i + 1
        }
        taken[best] = true
        push(out, best)
        c = c + 1
    }
    out
}

// sort_strs 对字符串排序 / sort_strs sorts strings
fn sort_strs(xs) {
    let n = len(xs)
    let mut taken = []
    for _x in xs {
        push(taken, false)
    }
    let mut out = []
    let mut c = 0
    while c < n {
        let mut best = -1
        let mut i = 0
        while i < n {
            if !taken[i] {
                if best < 0 {
                    best = i
                } else if xs[i] < xs[best] {
                    best = i
                }
            }
            i = i + 1
        }
        taken[best] = true
        push(out, xs[best])
        c = c + 1
    }
    out
}
