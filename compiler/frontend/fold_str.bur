// fold_str.bur — 字符串/布尔折叠。
// fold_str.bur — str/bool fold.


// fc_bin_str 折叠字符串二元运算（拼接/比较）/ fc_bin_str folds string binary ops (concat/compare)
fn fc_bin_str(op, x, y) {
    if op == t_plus {
        FRVal(FVStr(x + y))
    } else if op == t_eq_eq {
        FRVal(FVBool(x == y))
    } else if op == t_bang_eq {
        FRVal(FVBool(x != y))
    } else if op == t_lt {
        FRVal(FVBool(x < y))
    } else if op == t_lt_eq {
        FRVal(FVBool(x <= y))
    } else if op == t_gt {
        FRVal(FVBool(x > y))
    } else if op == t_gt_eq {
        FRVal(FVBool(x >= y))
    } else {
        FRSoft
    }
}

// fc_bin_bool 折叠布尔二元运算 / fc_bin_bool folds bool binary ops
fn fc_bin_bool(op, x, y) {
    if op == t_eq_eq {
        FRVal(FVBool(x == y))
    } else if op == t_bang_eq {
        FRVal(FVBool(x != y))
    } else {
        FRSoft
    }
}
