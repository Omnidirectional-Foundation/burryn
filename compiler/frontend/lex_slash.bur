// lex_slash.bur — `/`：注释 trivia 与除法。
// lex_slash.bur — `/`: comment trivia and division.

import "burryn.dev/compiler/lib"

fn lex_slash(src, mut st, mut toks, mut comments) {
    if lex_match(src, st, "/") {
        while st[1] < str_len(src) && lex_peek(src, st) != "\n" {
            lex_bump(st)
        }
        push(comments, lib::Token::Tok(t_comment, substr(src, st[0], st[1] - st[0]), st[0], st[1]))
    } else if lex_match(src, st, "*") {
        let start = st[0]
        while st[1] < str_len(src) {
            if lex_peek(src, st) == "*" && substr(src, st[1] + 1, 1) == "/" {
                st[1] = st[1] + 2
                break
            }
            lex_bump(st)
        }
        push(comments, lib::Token::Tok(t_comment, substr(src, start, st[1] - start), start, st[1]))
    } else if lex_match(src, st, "=") {
        lex_emit(st, toks, t_slash_eq, "/=")
    } else {
        lex_emit(st, toks, t_slash, "/")
    }
}
