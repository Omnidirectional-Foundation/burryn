// parser.bur — 递归下降解析器（Pratt 表达式 + 语句分派）。
// Recursive-descent parser: Pratt expressions plus statement dispatch.
// 出错时同步到下一个语句边界（花括号配平 + 分号/语句起始 token），一次报告最多 20 条诊断。
// On error it synchronizes to the next statement boundary
// (brace balancing + semicolon or a statement starter), capping diagnostics at 20.
import "burryn.dev/compiler/lib"

// parse 是脚本解析入口：逐语句解析，出错同步并累积诊断（上限 20 条）
// parse is the script entry: parses statements, recovers and accumulates diagnostics (cap 20)
pub fn parse(toks) {
    let mut pos = [0]
    let mut stmts = []
    let mut diags = []
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_eof) && len(diags) < 20 {
        match p_statement(toks, pos) {
            Ok(s) => push(stmts, s),
            Err(d) => {
                push(diags, d)
                p_synchronize(toks, pos)
            },
        }
        p_skip_semis(toks, pos)
    }
    Parsed(stmts, diags)
}

// parse_interface 解析 interface 文件（模块导出签名，语法子集）
// parse_interface parses an interface file (exported signatures, a syntax subset)
pub fn parse_interface(toks) {
    let mut pos = [0]
    let mut stmts = []
    let mut diags = []
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_eof) && len(diags) < 20 {
        match p_interface_statement(toks, pos) {
            Ok(s) => push(stmts, s),
            Err(d) => {
                push(diags, d)
                p_synchronize(toks, pos)
            },
        }
        p_skip_semis(toks, pos)
    }
    Parsed(stmts, diags)
}

// p_synchronize 做错误同步：跳到下一个语句边界（配平花括号，遇分号或语句起始 token 停）
// p_synchronize does error recovery: skip to the next statement boundary
// (balanced braces, stop at semicolon or a statement starter)
fn p_synchronize(toks, mut pos) {
    let mut depth = 0
    let mut going = true
    while going && !p_check(toks, pos, t_eof) {
        let t = tok_type(p_advance(toks, pos))
        if t == t_lbrace {
            depth = depth + 1
        } else if t == t_rbrace {
            if depth > 0 {
                depth = depth - 1
            }
        } else if t == t_semi {
            if depth == 0 && !p_check(toks, pos, t_rbrace) {
                going = false
            }
        }
        if going && depth == 0 && p_starts_stmt(tok_type(p_peek(toks, pos))) {
            going = false
        }
    }
}

// p_starts_stmt 判断是否语句起始 token / p_starts_stmt tells whether t starts a statement
fn p_starts_stmt(t) {
    t == t_let || t == t_const || t == t_fn || t == t_enum || t == t_type || t == t_while || t == t_for || t == t_return || t == t_spawn || t == t_select || t == t_defer || t == t_break || t == t_continue || t == t_pub || t == t_import
}

// p_peek 返回当前 token / p_peek returns the current token
fn p_peek(toks, pos) {
    toks[pos[0]]
}

// p_check 判断当前 token 是否 t / p_check tells whether the current token is t
fn p_check(toks, pos, t) {
    tok_type(p_peek(toks, pos)) == t
}

// p_advance 前进并返回 token / p_advance consumes and returns the token
fn p_advance(toks, mut pos) {
    let t = toks[pos[0]]
    if tok_type(t) != t_eof {
        pos[0] = pos[0] + 1
    }
    t
}

// p_match 若当前 token 匹配则消费并返回 true / p_match consumes the token if it matches
fn p_match(toks, mut pos, t) {
    if p_check(toks, pos, t) {
        p_advance(toks, pos)
        true
    } else {
        false
    }
}

// p_expect 期待 token 并消费，否则报错 / p_expect requires a token and consumes it, or errors
fn p_expect(toks, mut pos, t, what) {
    if p_check(toks, pos, t) {
        Ok(p_advance(toks, pos))
    } else {
        let tok = p_peek(toks, pos)
        perr("E1101", "", "expected " + what + ", got \"" + tok_lex(tok) + "\"", sp_of_tok(tok))
    }
}

// p_skip_semis 跳过连续分号（含自动插入的换行分号）
// p_skip_semis skips consecutive semicolons (including inserted newline semicolons)
fn p_skip_semis(toks, mut pos) {
    while p_check(toks, pos, t_semi) {
        p_advance(toks, pos)
    }
}

// p_end_stmt 消费语句结束（分号，块尾/EOF 视为合法结束）
// p_end_stmt consumes a statement end (semicolon; block end and EOF also count)
fn p_end_stmt(toks, mut pos) {
    if p_check(toks, pos, t_semi) {
        p_advance(toks, pos)
        Ok(true)
    } else if p_check(toks, pos, t_rbrace) || p_check(toks, pos, t_eof) {
        Ok(true)
    } else {
        let tok = p_peek(toks, pos)
        perr("E1102", "separate statements with a newline or ';'", "expected end of statement, got \"" + tok_lex(tok) + "\"", sp_of_tok(tok))
    }
}

// p_statement 做语句分派：先探标签循环（ident : while/for），再按起始 token 分派
// p_statement dispatches statements: labeled loops (ident : while/for) first, then by starter token
fn p_statement(toks, mut pos) {
    // 先探标签循环（ident : while/for），再按起始 token 分派
    // Labeled loops first (ident : while/for), then dispatch by starter token
    if p_check(toks, pos, t_ident) && p_check(toks, [pos[0] + 1], t_colon) && (p_check(toks, [pos[0] + 2], t_while) || p_check(toks, [pos[0] + 2], t_for)) {
        let ltok = p_advance(toks, pos)
        let _ = p_advance(toks, pos)
        let inner = match p_statement(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        return Ok(LabelStmt(tok_lex(ltok), inner, sp_union(sp_of_tok(ltok), span_of(inner))))
    }
    // 语句形态分派：声明/定义/控制流/表达式语句
    // Statement dispatch: declarations, definitions, control flow, expression statements
    if p_check(toks, pos, t_let) {
        p_let_stmt(toks, pos)
    } else if p_check(toks, pos, t_const) {
        p_const_stmt(toks, pos)
    } else if p_check(toks, pos, t_fn) && tok_type(toks[pos[0] + 1]) == t_ident {
        p_fn_decl(toks, pos)
    } else if p_check(toks, pos, t_fn) && tok_type(toks[pos[0] + 1]) == t_lparen && tok_type(toks[pos[0] + 2]) == t_ident && tok_type(toks[pos[0] + 3]) == t_colon {
        p_method_decl(toks, pos)
    } else if p_check(toks, pos, t_enum) {
        p_enum_decl(toks, pos)
    } else if p_check(toks, pos, t_type) {
        p_type_alias_decl(toks, pos, false)
    } else if p_check(toks, pos, t_pub) {
        p_pub_decl(toks, pos)
    } else if p_check(toks, pos, t_import) {
        p_import_decl(toks, pos)
    } else if p_check(toks, pos, t_while) {
        p_while_stmt(toks, pos)
    } else if p_check(toks, pos, t_return) {
        let tok = p_advance(toks, pos)
        let mut sp = sp_of_tok(tok)
        let mut val = NoNode
        if !p_check(toks, pos, t_semi) && !p_check(toks, pos, t_rbrace) && !p_check(toks, pos, t_eof) {
            val = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            sp = sp_union(sp, span_of(val))
        }
        match p_end_stmt(toks, pos) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        Ok(ReturnStmt(val, sp))
    } else if p_check(toks, pos, t_for) {
        p_for_stmt(toks, pos)
    } else if p_check(toks, pos, t_spawn) {
        p_spawn_stmt(toks, pos)
    } else if p_check(toks, pos, t_select) {
        p_select_stmt(toks, pos)
    } else if p_check(toks, pos, t_defer) {
        p_defer_stmt(toks, pos)
    } else if p_check(toks, pos, t_break) {
        let tok = p_advance(toks, pos)
        let mut lb = ""
        if p_check(toks, pos, t_ident) {
            lb = tok_lex(p_advance(toks, pos))
        }
        match p_end_stmt(toks, pos) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        Ok(BreakStmt(lb, sp_of_tok(tok)))
    } else if p_check(toks, pos, t_continue) {
        let tok = p_advance(toks, pos)
        let mut lb = ""
        if p_check(toks, pos, t_ident) {
            lb = tok_lex(p_advance(toks, pos))
        }
        match p_end_stmt(toks, pos) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        Ok(ContinueStmt(lb, sp_of_tok(tok)))
    } else {
        let e = match p_expression(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        if p_match(toks, pos, t_eq) {
            let val = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            let ok_target = match e {
                Ident(_, _) => true,
                Index(_, _, _) => true,
                _ => false,
            }
            if !ok_target {
                return perr("E1103", "only a variable or an index expression can be assigned to", "invalid assignment target", span_of(e))
            }
            match p_end_stmt(toks, pos) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            Ok(AssignStmt(e, val, sp_union(span_of(e), span_of(val))))
        } else if p_check(toks, pos, t_plus_eq) || p_check(toks, pos, t_minus_eq) || p_check(toks, pos, t_star_eq) || p_check(toks, pos, t_slash_eq) || p_check(toks, pos, t_percent_eq) {
            let op = p_advance(toks, pos)
            let op_t = tok_type(op)
            let binop = if op_t == t_plus_eq {
                t_plus
            } else if op_t == t_minus_eq {
                t_minus
            } else if op_t == t_star_eq {
                t_star
            } else if op_t == t_slash_eq {
                t_slash
            } else {
                t_percent
            }
            let val = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            let ok_target = match e {
                Ident(_, _) => true,
                Index(_, _, _) => true,
                _ => false,
            }
            if !ok_target {
                return perr("E1103", "only a variable or an index expression can be assigned to", "invalid assignment target", span_of(e))
            }
            match p_end_stmt(toks, pos) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            Ok(AssignStmt(e, Binary(binop, e, val, sp_union(span_of(e), span_of(val))), sp_union(span_of(e), span_of(val))))
        } else if p_match(toks, pos, t_larrow) {
            let val = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            match p_end_stmt(toks, pos) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            Ok(SendStmt(e, val, sp_union(span_of(e), span_of(val))))
        } else {
            match p_end_stmt(toks, pos) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            Ok(ExprStmt(e, span_of(e)))
        }
    }
}

// p_interface_statement 解析 interface 文件语句子集：import/enum/pub 声明
// p_interface_statement parses the interface subset: import, enum, pub declarations
fn p_interface_statement(toks, mut pos) {
    if p_check(toks, pos, t_import) {
        p_import_decl(toks, pos)
    } else if p_check(toks, pos, t_enum) {
        p_enum_decl(toks, pos)
    } else if p_check(toks, pos, t_pub) {
        let pub_tok = p_advance(toks, pos)
        if p_check(toks, pos, t_fn) {
            let fn_tok = p_advance(toks, pos)
            let name = match p_expect(toks, pos, t_ident, "function name") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            let lit = match p_fn_rest(toks, pos, tok_lex(name), sp_of_tok(fn_tok), true) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            Ok(FnDecl(tok_lex(name), sp_of_tok(name), true, lit, sp_union(sp_of_tok(pub_tok), span_of(lit))))
        } else if p_check(toks, pos, t_let) {
            let let_tok = p_advance(toks, pos)
            let name = match p_expect(toks, pos, t_ident, "variable name") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            match p_expect(toks, pos, t_colon, "':' before the exported value type") {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            let te = match p_type_expr(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            match p_end_stmt(toks, pos) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            Ok(LetStmt(tok_lex(name), sp_of_tok(name), false, true, NoNode, te, sp_union(sp_of_tok(pub_tok), sp_union(sp_of_tok(let_tok), span_of(te)))))
        } else if p_check(toks, pos, t_enum) {
            let decl = match p_enum_decl(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            match decl {
                EnumDecl(name, params, variants, _, sp) => Ok(EnumDecl(name, params, variants, true, sp_union(sp_of_tok(pub_tok), sp))),
                other => Ok(other),
            }
        } else {
            perr("E1114", "interface files contain imports, enums, and exported signatures", "expected `fn`, `enum`, or `let` after `pub`", sp_of_tok(pub_tok))
        }
    } else {
        perr("E1114", "interface files contain imports, enums, and exported signatures", "expected an interface declaration", sp_of_tok(p_peek(toks, pos)))
    }
}

// p_let_stmt 解析 let 语句：类型标注、mut/pub、元组解构
// p_let_stmt parses let: type annotations, mut/pub, tuple destructuring
fn p_let_stmt(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let is_mut = p_match(toks, pos, t_mut)
    // 元组解构 let 与普通 let 两条路径
    // Two paths: tuple-destructuring let and plain let
    if p_check(toks, pos, t_lparen) {
        p_advance(toks, pos)
        let mut names = []
        let mut nspans = []
        p_skip_semis(toks, pos)
        while !p_check(toks, pos, t_rparen) {
            let nm = match p_expect(toks, pos, t_ident, "name in destructuring let") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            push(names, tok_lex(nm))
            push(nspans, sp_of_tok(nm))
            if !p_match(toks, pos, t_comma) {
                break
            }
            p_skip_semis(toks, pos)
        }
        let rp = match p_expect(toks, pos, t_rparen, "')' in destructuring let") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        match p_expect(toks, pos, t_eq, "'=' in let binding") {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        let init = match p_expression(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        match p_end_stmt(toks, pos) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        return Ok(DestructLet(names, nspans, is_mut, init, sp_union(sp_of_tok(tok), span_of(init))))
    }
    let name = match p_expect(toks, pos, t_ident, "variable name") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    // 可选类型标注 + = 初始化 + 语句结束
    // Optional type annotation, = initializer, statement end
    let ty = if p_match(toks, pos, t_colon) {
        match p_type_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
    } else {
        NoNode
    }
    match p_expect(toks, pos, t_eq, "'=' in let binding") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let init = match p_expression(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    match p_end_stmt(toks, pos) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    Ok(LetStmt(tok_lex(name), sp_of_tok(name), is_mut, false, ty, init, sp_union(sp_of_tok(tok), span_of(init))))
}

// p_const_stmt 解析 const 声明 / p_const_stmt parses a const declaration
fn p_const_stmt(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let name = match p_expect(toks, pos, t_ident, "constant name") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let ty = if p_match(toks, pos, t_colon) {
        match p_type_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
    } else {
        NoNode
    }
    match p_expect(toks, pos, t_eq, "'=' in const declaration") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let init = match p_expression(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    match p_end_stmt(toks, pos) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    Ok(ConstDecl(tok_lex(name), sp_of_tok(name), false, ty, init, sp_union(sp_of_tok(tok), span_of(init))))
}

// p_pub_decl 解析 pub 声明（导出修饰下推给具体声明）
// p_pub_decl parses pub declarations (the export flag is pushed down)
fn p_pub_decl(toks, mut pos) {
    let tok = p_advance(toks, pos)
    if p_check(toks, pos, t_let) {
        let s = match p_let_stmt(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        match s {
            LetStmt(name, nsp, is_mut, _, ty, init, sp) => Ok(LetStmt(name, nsp, is_mut, true, ty, init, sp_union(sp_of_tok(tok), sp))),
            other => Ok(other),
        }
    } else if p_check(toks, pos, t_const) {
        let s = match p_const_stmt(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        match s {
            ConstDecl(name, nsp, _, ty, init, sp) => Ok(ConstDecl(name, nsp, true, ty, init, sp_union(sp_of_tok(tok), sp))),
            other => Ok(other),
        }
    } else if p_check(toks, pos, t_fn) && tok_type(toks[pos[0] + 1]) == t_ident {
        let s = match p_fn_decl(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        match s {
            FnDecl(name, nsp, _, lit, sp) => Ok(FnDecl(name, nsp, true, lit, sp_union(sp_of_tok(tok), sp))),
            other => Ok(other),
        }
    } else if p_check(toks, pos, t_enum) {
        let s = match p_enum_decl(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        match s {
            EnumDecl(name, params, variants, _, sp) => Ok(EnumDecl(name, params, variants, true, sp_union(sp_of_tok(tok), sp))),
            other => Ok(other),
        }
    } else if p_check(toks, pos, t_type) {
        p_type_alias_decl(toks, pos, true)
    } else {
        perr("E1114", "`pub` exports a top-level declaration: `pub fn`, `pub enum`, `pub let`, `pub const`, or `pub type`", "expected `fn`, `enum`, `let`, `const`, or `type` after `pub`, got \"" + tok_lex(p_peek(toks, pos)) + "\"", sp_of_tok(tok))
    }
}

// p_import_decl 解析 import 声明（可选别名 + 路径字符串）
// p_import_decl parses an import (optional alias + path string)
fn p_import_decl(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let mut alias = ""
    let mut asp = Sp(0, 0)
    if p_check(toks, pos, t_ident) {
        let a = p_advance(toks, pos)
        alias = tok_lex(a)
        asp = sp_of_tok(a)
    }
    let path_tok = match p_expect(toks, pos, t_string, "an import path string") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    match p_end_stmt(toks, pos) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    Ok(ImportDecl(alias, asp, tok_lex(path_tok), sp_of_tok(path_tok), sp_union(sp_of_tok(tok), sp_of_tok(path_tok))))
}

// p_fn_decl 解析函数声明 / p_fn_decl parses a function declaration
fn p_fn_decl(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let name = match p_expect(toks, pos, t_ident, "function name") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let lit = match p_fn_rest(toks, pos, tok_lex(name), sp_of_tok(tok), false) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    Ok(FnDecl(tok_lex(name), sp_of_tok(name), false, lit, span_of(lit)))
}

// p_method_decl 解析 receiver 方法声明，receiver 作为第一个参数并入签名
// p_method_decl parses a receiver method; the receiver becomes the first parameter
fn p_method_decl(toks, mut pos) {
    let tok = p_advance(toks, pos)
    // receiver 方法：recv: Type 并入参数表首位
    // Receiver methods: recv: Type joins the parameter list first
    match p_expect(toks, pos, t_lparen, "'(' after fn in method") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let recv = match p_expect(toks, pos, t_ident, "receiver name") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    match p_expect(toks, pos, t_colon, "':' after receiver name") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let rty = match p_type_expr(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    match p_expect(toks, pos, t_rparen, "')' after receiver") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let name = match p_expect(toks, pos, t_ident, "method name") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    match p_expect(toks, pos, t_lparen, "'(' after method name") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let mut params = [tok_lex(recv)]
    let mut muts = [false]
    let mut pspans = [sp_of_tok(recv)]
    let mut param_tys = [rty]
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_rparen) {
        let is_mut = p_match(toks, pos, t_mut)
        let ptok = match p_expect(toks, pos, t_ident, "parameter name") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        push(params, tok_lex(ptok))
        push(muts, is_mut)
        push(pspans, sp_of_tok(ptok))
        let pty = if p_match(toks, pos, t_colon) {
            match p_type_expr(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
        } else {
            NoNode
        }
        push(param_tys, pty)
        if !p_match(toks, pos, t_comma) {
            break
        }
        p_skip_semis(toks, pos)
    }
    p_skip_semis(toks, pos)
    let rp = match p_expect(toks, pos, t_rparen, "')' after parameters") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let ret_ty = if p_match(toks, pos, t_thin_arrow) {
        match p_type_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
    } else {
        NoNode
    }
    let body = match p_block(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    let lit = FnLit(params, muts, pspans, param_tys, ret_ty, body, tok_lex(name), sp_union(sp_of_tok(tok), span_of(body)))
    Ok(MethodDecl(rty_name(rty), tok_lex(name), sp_of_tok(name), lit, span_of(lit)))
}

// rty_name 取函数返回类型的名字（方法分派依据，非名字类型返回空串）
// rty_name extracts the return type name (method dispatch key; "" for non-name types)
fn rty_name(ty) {
    match ty {
        TEName(_, n, _, _, _) => n,
        TERecord(_, _, _, _) => "",
        _ => "",
    }
}

// p_fn_rest 解析函数体（参数/返回类型/体；interface 模式只取签名）
// p_fn_rest parses the function body (params/return/body; interface mode takes the signature only)
fn p_fn_rest(toks, mut pos, name, fn_sp, interface_only) {
    // 参数列表：可选 mut 与类型标注；interface 模式强制标注
    // Parameters: optional mut and annotations; interface mode requires annotations
    match p_expect(toks, pos, t_lparen, "'(' after fn") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let mut params = []
    let mut muts = []
    let mut pspans = []
    let mut param_tys = []
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_rparen) {
        let is_mut = p_match(toks, pos, t_mut)
        let ptok = match p_expect(toks, pos, t_ident, "parameter name") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        push(params, tok_lex(ptok))
        push(muts, is_mut)
        push(pspans, sp_of_tok(ptok))
        let pty = if p_match(toks, pos, t_colon) {
            match p_type_expr(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
        } else if interface_only {
            return perr("E1101", "interface parameters require explicit types", "expected ':' after interface parameter `" + tok_lex(ptok) + "`", sp_of_tok(ptok))
            NoNode
        } else {
            NoNode
        }
        push(param_tys, pty)
        if !p_match(toks, pos, t_comma) {
            break
        }
        p_skip_semis(toks, pos)
    }
    p_skip_semis(toks, pos)
    let rp = match p_expect(toks, pos, t_rparen, "')' after parameters") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let ret_ty = if p_match(toks, pos, t_thin_arrow) {
        match p_type_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
    } else if interface_only {
        return perr("E1101", "interface functions require an explicit return type", "expected '->' after interface parameters", sp_of_tok(rp))
        NoNode
    } else {
        NoNode
    }
    if interface_only {
        match p_end_stmt(toks, pos) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        Ok(FnLit(params, muts, pspans, param_tys, ret_ty, NoNode, name, sp_union(fn_sp, span_of(ret_ty))))
    } else {
        let body = match p_block(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        Ok(FnLit(params, muts, pspans, param_tys, ret_ty, body, name, sp_union(fn_sp, span_of(body))))
    }
}

// p_enum_decl 解析枚举声明：变体可带类型字段，支持泛型参数表
// p_enum_decl parses an enum: typed variant fields, optional type parameters
fn p_enum_decl(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let name = match p_expect(toks, pos, t_ident, "enum name") {
        // 枚举：可选泛型参数表 + 变体列表（变体可带类型字段）
        // Enums: optional type parameters plus variants (variants may carry typed fields)
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let mut params = []
    if p_match(toks, pos, t_lparen) {
        while !p_check(toks, pos, t_rparen) {
            let ptok = match p_expect(toks, pos, t_ident, "type parameter") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            push(params, tok_lex(ptok))
            if !p_match(toks, pos, t_comma) {
                break
            }
        }
        match p_expect(toks, pos, t_rparen, "')' after type parameters") {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    match p_expect(toks, pos, t_lbrace, "'" + chr(123) + "' after enum name") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let mut variants = []
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_rbrace) {
        let vname = match p_expect(toks, pos, t_ident, "variant name") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        let mut vtypes = []
        let mut vsp = sp_of_tok(vname)
        if p_match(toks, pos, t_lparen) {
            while !p_check(toks, pos, t_rparen) {
                let vt = match p_type_expr(toks, pos) {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        NoNode
                    },
                }
                push(vtypes, vt)
                if !p_match(toks, pos, t_comma) {
                    break
                }
            }
            let vrp = match p_expect(toks, pos, t_rparen, "')' after variant field types") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            vsp = sp_union(vsp, sp_of_tok(vrp))
        }
        push(variants, EnumVariantDecl(tok_lex(vname), len(vtypes), vtypes, vsp))
        if !p_match(toks, pos, t_comma) && !p_check(toks, pos, t_semi) && !p_check(toks, pos, t_rbrace) {
            return perr("E1104", "", "expected ',' or newline between enum variants", sp_of_tok(p_peek(toks, pos)))
        }
        p_skip_semis(toks, pos)
    }
    let rb = match p_expect(toks, pos, t_rbrace, "'}' after enum variants") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    Ok(EnumDecl(tok_lex(name), params, variants, false, sp_union(sp_of_tok(tok), sp_of_tok(rb))))
}

// p_type_alias_decl 解析类型别名声明 / p_type_alias_decl parses a type alias declaration
fn p_type_alias_decl(toks, mut pos, is_pub) {
    let tok = p_advance(toks, pos)
    let name = match p_expect(toks, pos, t_ident, "type alias name") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    match p_expect(toks, pos, t_eq, "'=' after type alias name") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let te = match p_type_expr(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    match p_end_stmt(toks, pos) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    Ok(TypeAliasDecl(tok_lex(name), te, is_pub, sp_union(sp_of_tok(tok), span_of(te))))
}

// p_type_expr 解析类型表达式：名字/泛型应用/list/fn 签名/record 行变量/tuple
// p_type_expr parses type expressions: names, generic application, lists, fn signatures,
// record rows, tuples
fn p_type_expr(toks, mut pos) {
    // 类型表达式分派：list/record 行/tuple/fn 签名/具名类型
    // Type-expression dispatch: list, record rows, tuples, fn signatures, named types
    let tok = p_peek(toks, pos)
    let t = tok_type(tok)
    if t == t_lbracket {
        p_advance(toks, pos)
        let el = match p_type_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        let rb = match p_expect(toks, pos, t_rbracket, "']' in list type") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        Ok(TEList(el, sp_union(sp_of_tok(tok), sp_of_tok(rb))))
    } else if t == t_record {
        // record 类型：字段名: 类型列表 + 可选行变量（| r）
        // Record types: field-name: type pairs plus an optional row variable (| r)
        p_advance(toks, pos)
        match p_expect(toks, pos, t_lbrace, "'" + chr(123) + "' after `record` in type") {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        let mut names = []
        let mut types = []
        let mut row_var = NoNode
        p_skip_semis(toks, pos)
        while !p_check(toks, pos, t_rbrace) {
            if p_match(toks, pos, t_bar) {
                let rv = match p_expect(toks, pos, t_ident, "row variable after '|'") {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        lib::Token::Tok(0, "", 0, 0)
                    },
                }
                row_var = TEName("", tok_lex(rv), "", [], sp_of_tok(rv))
                break
            }
            let fname = match p_expect(toks, pos, t_ident, "field name in record type") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            match p_expect(toks, pos, t_colon, "':' after field name") {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            let ft = match p_type_expr(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            push(names, tok_lex(fname))
            push(types, ft)
            if !p_match(toks, pos, t_comma) {
                if p_match(toks, pos, t_bar) {
                    let rv = match p_expect(toks, pos, t_ident, "row variable after '|'") {
                        Ok(v) => v,
                        Err(d) => {
                            return Err(d)
                            lib::Token::Tok(0, "", 0, 0)
                        },
                    }
                    row_var = TEName("", tok_lex(rv), "", [], sp_of_tok(rv))
                }
                break
            }
            p_skip_semis(toks, pos)
        }
        let rb = match p_expect(toks, pos, t_rbrace, "'}' after record type fields") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        Ok(TERecord(names, types, row_var, sp_union(sp_of_tok(tok), sp_of_tok(rb))))
    } else if t == t_lparen {
        let lp = p_advance(toks, pos)
        let mut ets = []
        while !p_check(toks, pos, t_rparen) {
            let et = match p_type_expr(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            push(ets, et)
            if !p_match(toks, pos, t_comma) {
                break
            }
        }
        let rp = match p_expect(toks, pos, t_rparen, "')' in tuple type") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        Ok(TETuple(ets, sp_union(sp_of_tok(lp), sp_of_tok(rp))))
    } else if t == t_fn {
        p_advance(toks, pos)
        match p_expect(toks, pos, t_lparen, "'(' in fn type") {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        let mut ps = []
        while !p_check(toks, pos, t_rparen) {
            let pt = match p_type_expr(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            push(ps, pt)
            if !p_match(toks, pos, t_comma) {
                break
            }
        }
        match p_expect(toks, pos, t_rparen, "')' in fn type") {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        match p_expect(toks, pos, t_thin_arrow, "'->' in fn type") {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        let ret = match p_type_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        Ok(TEFn(ps, ret, sp_union(sp_of_tok(tok), span_of(ret))))
    } else if t == t_ident {
        p_advance(toks, pos)
        let mut pkg = ""
        let mut name = tok_lex(tok)
        let mut sp = sp_of_tok(tok)
        if p_match(toks, pos, t_colon_colon) {
            let n = match p_expect(toks, pos, t_ident, "a type name after '::'") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            pkg = tok_lex(tok)
            name = tok_lex(n)
            sp = sp_union(sp, sp_of_tok(n))
        }
        let mut constraint = ""
        if p_match(toks, pos, t_colon) {
            let ctok = match p_expect(toks, pos, t_ident, "a type constraint after ':'") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            constraint = tok_lex(ctok)
            sp = sp_union(sp, sp_of_tok(ctok))
        }
        let mut targs = []
        if p_match(toks, pos, t_lparen) {
            while !p_check(toks, pos, t_rparen) {
                let ta = match p_type_expr(toks, pos) {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        NoNode
                    },
                }
                push(targs, ta)
                if !p_match(toks, pos, t_comma) {
                    break
                }
            }
            let rp = match p_expect(toks, pos, t_rparen, "')' in type arguments") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            sp = sp_union(sp, sp_of_tok(rp))
        }
        Ok(TEName(pkg, name, constraint, targs, sp))
    } else {
        perr("E1105", "", "expected a type, got \"" + tok_lex(tok) + "\"", sp_of_tok(tok))
    }
}

// p_while_stmt 解析 while 语句 / p_while_stmt parses a while statement
fn p_while_stmt(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let cond = match p_expression(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    let body = match p_block(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    Ok(WhileStmt(cond, body, sp_union(sp_of_tok(tok), span_of(body))))
}

// p_for_stmt 解析 for 语句：值遍历或带索引形式（channel 拒绝索引）
// p_for_stmt parses for: value iteration, optional index form (channels reject the index form)
fn p_for_stmt(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let first = match p_expect(toks, pos, t_ident, "loop variable") {
        Ok(x) => x,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let mut v = tok_lex(first)
    let mut vsp = sp_of_tok(first)
    let mut idx = ""
    let mut isp = Sp(0, 0)
    if p_match(toks, pos, t_comma) {
        idx = v
        isp = vsp
        let e = match p_expect(toks, pos, t_ident, "element variable after ','") {
            Ok(x) => x,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        v = tok_lex(e)
        vsp = sp_of_tok(e)
    }
    match p_expect(toks, pos, t_in, "'in' in for loop") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let iter = match p_expression(toks, pos) {
        Ok(x) => x,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    let body = match p_block(toks, pos) {
        Ok(x) => x,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    Ok(ForStmt(v, vsp, idx, isp, iter, false, body, sp_union(sp_of_tok(tok), span_of(body))))
}

// p_spawn_stmt 解析 spawn 语句（必须跟函数调用）/ p_spawn_stmt parses spawn (a function call is required)
fn p_spawn_stmt(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let e = match p_expression(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    let is_call = match e {
        Call(_, _, _) => true,
        _ => false,
    }
    if !is_call {
        return perr("E1106", "", "spawn expects a function call, e.g. `spawn worker(ch)`", sp_of_tok(tok))
    }
    match p_end_stmt(toks, pos) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    Ok(SpawnStmt(e, sp_union(sp_of_tok(tok), span_of(e))))
}

// p_defer_stmt 解析 defer 语句（必须跟块）/ p_defer_stmt parses defer (a block is required)
fn p_defer_stmt(toks, mut pos) {
    let tok = p_advance(toks, pos)
    if !p_check(toks, pos, t_lbrace) {
        return perr("E1119", "defer takes a block, e.g. `defer " + chr(123) + " close(ch) }`", "expected '" + chr(123) + "' after defer", sp_of_tok(p_peek(toks, pos)))
    }
    let body = match p_block(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    Ok(DeferStmt(body, sp_union(sp_of_tok(tok), span_of(body))))
}

// p_select_stmt 解析 select 语句（通信臂 + 至多一个 default）
// p_select_stmt parses select (communication arms plus at most one default)
fn p_select_stmt(toks, mut pos) {
    let tok = p_advance(toks, pos)
    match p_expect(toks, pos, t_lbrace, "'" + chr(123) + "' after select") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let mut arms = []
    let mut has_default = false
    let mut dflt = NoNode
    let mut dsp = Sp(0, 0)
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_rbrace) && !p_check(toks, pos, t_eof) {
        if p_check(toks, pos, t_ident) && tok_lex(p_peek(toks, pos)) == "default" {
            let d = p_advance(toks, pos)
            if has_default {
                return perr("E1115", "", "`select` may have at most one `default` arm", sp_of_tok(d))
            }
            match p_expect(toks, pos, t_arrow, "'=>' after default") {
                Ok(_) => {},
                Err(dg) => {
                    return Err(dg)
                },
            }
            p_skip_semis(toks, pos)
            has_default = true
            dsp = sp_of_tok(d)
            dflt = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(dg) => {
                    return Err(dg)
                    NoNode
                },
            }
        } else {
            let arm = match p_select_arm(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            push(arms, arm)
        }
        if !p_match(toks, pos, t_comma) && !p_check(toks, pos, t_semi) && !p_check(toks, pos, t_rbrace) {
            return perr("E1104", "", "expected ',' or newline between select arms", sp_of_tok(p_peek(toks, pos)))
        }
        p_skip_semis(toks, pos)
    }
    let rb = match p_expect(toks, pos, t_rbrace, "'}' after select arms") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let sp = sp_union(sp_of_tok(tok), sp_of_tok(rb))
    if len(arms) == 0 && !has_default {
        return perr("E1116", "", "`select` needs at least one communication arm", sp)
    }
    Ok(SelectStmt(arms, has_default, dflt, dsp, sp))
}

// p_select_arm 解析单个 select 臂（接收绑定/裸接收/发送三种形态）
// p_select_arm parses one select arm (bind-receive, bare receive, or send)
fn p_select_arm(toks, mut pos) {
    let mut is_send = false
    let mut bind = ""
    let mut bind_sp = Sp(0, 0)
    let mut ch = NoNode
    let mut val = NoNode
    let mut asp = Sp(0, 0)
    if p_check(toks, pos, t_larrow) {
        let start = p_advance(toks, pos)
        ch = match p_expression(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        asp = sp_of_tok(start)
    } else {
        let e = match p_expression(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        asp = span_of(e)
        if p_match(toks, pos, t_eq) {
            match e {
                Ident(n, isp) => {
                    bind = n
                    bind_sp = isp
                },
                _ => {
                    return perr("E1117", "", "only a name can bind a received value: `name = <-ch`", span_of(e))
                },
            }
            match p_expect(toks, pos, t_larrow, "'<-' after `=` in a select receive arm") {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            ch = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
        } else if p_match(toks, pos, t_larrow) {
            is_send = true
            ch = e
            val = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
        } else {
            return perr("E1118", "a select arm is a receive (`v = <-ch`), a send (`ch <- v`), or `default`", "expected `=`, `<-`, or `=>` in this select arm", sp_of_tok(p_peek(toks, pos)))
        }
    }
    match p_expect(toks, pos, t_arrow, "'=>' after a select arm") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    p_skip_semis(toks, pos)
    let body = match p_expression(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    Ok(SelectArm(is_send, bind, bind_sp, ch, val, body, sp_union(asp, span_of(body))))
}

// p_block 解析块 / p_block parses a block
fn p_block(toks, mut pos) {
    let lb = match p_expect(toks, pos, t_lbrace, "'" + chr(123) + "'") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let mut stmts = []
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_rbrace) && !p_check(toks, pos, t_eof) {
        let s = match p_statement(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        push(stmts, s)
        p_skip_semis(toks, pos)
    }
    let rb = match p_expect(toks, pos, t_rbrace, "'}'") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    Ok(Block(stmts, sp_union(sp_of_tok(lb), sp_of_tok(rb))))
}

// p_expression 是表达式入口 / p_expression is the expression entry
fn p_expression(toks, mut pos) {
    p_pipe_expr(toks, pos)
}

// p_pipe_expr 是表达式入口：最低优先级是管道（左结合，目标须为函数名/包名，可带实参）
// p_pipe_expr is the entry: the lowest-precedence operator is the pipe
// (left-assoc; the target must be a function or package name, optionally with arguments)
fn p_pipe_expr(toks, mut pos) {
    let mut e = match p_or_expr(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    while p_check(toks, pos, t_pipe) {
        p_advance(toks, pos)
        e = match p_pipe_target(toks, pos, e) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
    }
    Ok(e)
}

// p_pipe_target 解析管道目标：名字路径（可 :: 限定）+ 可选实参列表
// p_pipe_target parses the pipe target: a name path (::-qualified) plus optional arguments
fn p_pipe_target(toks, mut pos, lhs) {
    let first = match p_expect(toks, pos, t_ident, "a pipe target") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let mut path = Ident(tok_lex(first), sp_of_tok(first))
    while p_match(toks, pos, t_colon_colon) {
        let part = match p_expect(toks, pos, t_ident, "a name after '::' in pipe target") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        path = match path {
            Ident(name, sp) => VariantAccess(name, tok_lex(part), sp_union(sp, sp_of_tok(part))),
            VariantAccess(pkg, name, sp) => QualVariantAccess(pkg, name, tok_lex(part), sp_union(sp, sp_of_tok(part))),
            _ => {
                return perr("E1107", "", "a pipe target path has at most three names", sp_of_tok(part))
                NoNode
            },
        }
    }
    let mut args = []
    let mut end_sp = span_of(path)
    if p_match(toks, pos, t_lparen) {
        p_skip_semis(toks, pos)
        while !p_check(toks, pos, t_rparen) {
            let arg = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            push(args, arg)
            if !p_match(toks, pos, t_comma) {
                break
            }
            p_skip_semis(toks, pos)
        }
        p_skip_semis(toks, pos)
        let rp = match p_expect(toks, pos, t_rparen, "')' after pipe target arguments") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        end_sp = sp_union(end_sp, sp_of_tok(rp))
    }
    Ok(Pipe(lhs, path, args, sp_union(span_of(lhs), end_sp)))
}

// p_or_expr 解析逻辑或（Pratt 层级：||），兼收 `..` range 字面量
// p_or_expr parses logical or (Pratt level: ||) and the `..` range literal
fn p_or_expr(toks, mut pos) {
    let mut e = match p_and_expr(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    while p_check(toks, pos, t_or_or) {
        p_advance(toks, pos)
        let rhs = match p_and_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Logical(t_or_or, e, rhs, sp_union(span_of(e), span_of(rhs)))
    }
    if p_match(toks, pos, t_dot_dot) {
        let rhs = match p_and_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Call(Ident("range", span_of(e)), [e, rhs], sp_union(span_of(e), span_of(rhs)))
    }
    Ok(e)
}

// p_and_expr 解析逻辑与（Pratt 层级：&&）/ p_and_expr parses logical and (Pratt level: &&)
fn p_and_expr(toks, mut pos) {
    let mut e = match p_equality(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    while p_check(toks, pos, t_and_and) {
        p_advance(toks, pos)
        let rhs = match p_equality(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Logical(t_and_and, e, rhs, sp_union(span_of(e), span_of(rhs)))
    }
    Ok(e)
}

// p_equality 解析相等比较（Pratt 层级：== !=）/ p_equality parses equality (Pratt level: == !=)
fn p_equality(toks, mut pos) {
    let mut e = match p_comparison(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    while p_check(toks, pos, t_eq_eq) || p_check(toks, pos, t_bang_eq) {
        let op = p_advance(toks, pos)
        let rhs = match p_comparison(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Binary(tok_type(op), e, rhs, sp_union(span_of(e), span_of(rhs)))
    }
    Ok(e)
}

// p_comparison 解析比较（Pratt 层级：< <= > >=）/ p_comparison parses comparison (Pratt level: < <= > >=)
fn p_comparison(toks, mut pos) {
    let mut e = match p_term(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    while p_check(toks, pos, t_lt) || p_check(toks, pos, t_lt_eq) || p_check(toks, pos, t_gt) || p_check(toks, pos, t_gt_eq) {
        let op = p_advance(toks, pos)
        let rhs = match p_term(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Binary(tok_type(op), e, rhs, sp_union(span_of(e), span_of(rhs)))
    }
    Ok(e)
}

// p_term 解析加法项（Pratt 层级：+ -）/ p_term parses additive terms (Pratt level: + -)
fn p_term(toks, mut pos) {
    let mut e = match p_factor(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    while p_check(toks, pos, t_plus) || p_check(toks, pos, t_minus) {
        let op = p_advance(toks, pos)
        let rhs = match p_factor(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Binary(tok_type(op), e, rhs, sp_union(span_of(e), span_of(rhs)))
    }
    Ok(e)
}

// p_factor 解析乘法项（Pratt 层级：* / %）/ p_factor parses multiplicative terms (Pratt level: * / %)
fn p_factor(toks, mut pos) {
    let mut e = match p_unary(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    while p_check(toks, pos, t_star) || p_check(toks, pos, t_slash) || p_check(toks, pos, t_percent) {
        let op = p_advance(toks, pos)
        let rhs = match p_unary(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Binary(tok_type(op), e, rhs, sp_union(span_of(e), span_of(rhs)))
    }
    Ok(e)
}

// p_unary 解析一元运算：- ! 与 channel 接收 <- / p_unary parses unary ops: - ! and channel receive <-
fn p_unary(toks, mut pos) {
    if p_check(toks, pos, t_bang) || p_check(toks, pos, t_minus) {
        let op = p_advance(toks, pos)
        let rhs = match p_unary(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        Ok(Unary(tok_type(op), rhs, sp_union(sp_of_tok(op), span_of(rhs))))
    } else if p_check(toks, pos, t_larrow) {
        let op = p_advance(toks, pos)
        let rhs = match p_unary(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        Ok(RecvExpr(rhs, sp_union(sp_of_tok(op), span_of(rhs))))
    } else {
        p_postfix(toks, pos)
    }
}

// p_postfix 解析后缀：调用/索引/字段访问/成员选择，含 record 更新与 tuple 解构
// p_postfix parses postfix: calls, indexing, field and member access,
// record updates, tuple destructuring
fn p_postfix(toks, mut pos) {
    let mut e = match p_primary(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    // 后缀链：调用/索引/try/:: 限定/字段访问
    // Postfix chain: calls, indexing, try, :: qualification, field access
    let mut going = true
    while going {
        if p_check(toks, pos, t_lparen) {
            p_advance(toks, pos)
            let mut cargs = []
            p_skip_semis(toks, pos)
            while !p_check(toks, pos, t_rparen) {
                let a = match p_expression(toks, pos) {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        NoNode
                    },
                }
                push(cargs, a)
                if !p_match(toks, pos, t_comma) {
                    break
                }
                p_skip_semis(toks, pos)
            }
            p_skip_semis(toks, pos)
            let rp = match p_expect(toks, pos, t_rparen, "')' after arguments") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            e = Call(e, cargs, sp_union(span_of(e), sp_of_tok(rp)))
        } else if p_check(toks, pos, t_lbracket) {
            p_advance(toks, pos)
            let idx = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            let rb = match p_expect(toks, pos, t_rbracket, "']' after index") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            e = Index(e, idx, sp_union(span_of(e), sp_of_tok(rb)))
        } else if p_check(toks, pos, t_question) {
            let q = p_advance(toks, pos)
            e = TryExpr(e, sp_union(span_of(e), sp_of_tok(q)))
        } else if p_check(toks, pos, t_colon_colon) {
            let _ = p_advance(toks, pos)
            e = match e {
                Ident(name, hsp) => {
                    let v = match p_expect(toks, pos, t_ident, "a name after '::'") {
                        Ok(x) => x,
                        Err(dg) => {
                            return Err(dg)
                            lib::Token::Tok(0, "", 0, 0)
                        },
                    }
                    VariantAccess(name, tok_lex(v), sp_union(hsp, sp_of_tok(v)))
                },
                VariantAccess(en, vr, hsp) => {
                    let v = match p_expect(toks, pos, t_ident, "a name after '::'") {
                        Ok(x) => x,
                        Err(dg) => {
                            return Err(dg)
                            lib::Token::Tok(0, "", 0, 0)
                        },
                    }
                    QualVariantAccess(en, vr, tok_lex(v), sp_union(hsp, sp_of_tok(v)))
                },
                _ => {
                    return perr("E1120", "`::` qualifies a package or enum name; write `pkg::name` or `Shape::Variant`", "'::' cannot follow this expression", sp_of_tok(p_peek(toks, pos)))
                    NoNode
                },
            }
        } else if p_check(toks, pos, t_dot) {
            let _ = p_advance(toks, pos)
            let v = match p_expect(toks, pos, t_ident, "a field name after '.'") {
                Ok(x) => x,
                Err(dg) => {
                    return Err(dg)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            e = FieldAccess(e, tok_lex(v), sp_union(span_of(e), sp_of_tok(v)))
        } else {
            going = false
        }
    }
    Ok(e)
}

// lit_to_int 把数字字面量转 int（hex/二进制/十进制，带溢出检查）
// lit_to_int converts a literal lexeme to int (hex/binary/decimal, overflow-checked)
fn lit_to_int(lexeme) {
    let l = str_len(lexeme)
    if l > 2 && substr(lexeme, 0, 2) == "0x" {
        let mut v = 0
        let mut i = 2
        while i < l {
            let c = substr(lexeme, i, 1)
            if c == "_" {
                i = i + 1
                continue
            }
            let d = if c >= "0" && c <= "9" {
                ord(c) - ord("0")
            } else if c >= "a" && c <= "f" {
                ord(c) - ord("a") + 10
            } else if c >= "A" && c <= "F" {
                ord(c) - ord("A") + 10
            } else {
                -1
            }
            if d < 0 || v > (9223372036854775807 - d) / 16 {
                return None
            }
            v = v * 16 + d
            i = i + 1
        }
        Some(v)
    } else if l > 2 && substr(lexeme, 0, 2) == "0b" {
        let mut v = 0
        let mut i = 2
        while i < l {
            let c = substr(lexeme, i, 1)
            if c == "_" {
                i = i + 1
                continue
            }
            let d = if c == "0" || c == "1" {
                ord(c) - ord("0")
            } else {
                -1
            }
            if d < 0 || v > (9223372036854775807 - d) / 2 {
                return None
            }
            v = v * 2 + d
            i = i + 1
        }
        Some(v)
    } else {
        let mut clean = ""
        let mut i = 0
        while i < l {
            let c = substr(lexeme, i, 1)
            if c != "_" {
                clean = clean + c
            }
            i = i + 1
        }
        parse_int(clean)
    }
}

// p_primary 解析原子表达式：字面量/标识符/分组/列表/函数字面量/record/枚举变体
// p_primary parses primaries: literals, identifiers, grouping, lists, fn literals,
// records, enum variants
fn p_primary(toks, mut pos) {
    // 原子表达式分派：字面量/标识符/分组/列表/函数/if/match/块
    // Primary dispatch: literals, identifiers, grouping, lists, functions, if, match, blocks
    let tok = p_peek(toks, pos)
    let t = tok_type(tok)
    if t == t_int {
        p_advance(toks, pos)
        match lit_to_int(tok_lex(tok)) {
            Some(n) => Ok(IntLit(n, sp_of_tok(tok))),
            None => perr("E1108", "i64 holds -9223372036854775808..9223372036854775807", "bad integer literal \"" + tok_lex(tok) + "\"", sp_of_tok(tok)),
        }
    } else if t == t_float {
        p_advance(toks, pos)
        match parse_float(tok_lex(tok)) {
            Some(f) => Ok(FloatLit(f, sp_of_tok(tok))),
            None => perr("E1108", "", "bad float literal \"" + tok_lex(tok) + "\"", sp_of_tok(tok)),
        }
    } else if t == t_string {
        p_advance(toks, pos)
        Ok(StrLit(tok_lex(tok), sp_of_tok(tok)))
    } else if t == t_interp_start {
        p_interpolated(toks, pos)
    } else if t == t_true {
        p_advance(toks, pos)
        Ok(BoolLit(true, sp_of_tok(tok)))
    } else if t == t_false {
        p_advance(toks, pos)
        Ok(BoolLit(false, sp_of_tok(tok)))
    } else if t == t_record {
        p_advance(toks, pos)
        match p_expect(toks, pos, t_lbrace, "'" + chr(123) + "' after `record`") {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        p_skip_semis(toks, pos)
        if p_check(toks, pos, t_rbrace) {
            let rb = p_advance(toks, pos)
            return Ok(RecordLit([], [], sp_union(sp_of_tok(tok), sp_of_tok(rb))))
        }
        let first_name = match p_expect(toks, pos, t_ident, "field name in record literal") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        if p_match(toks, pos, t_bar) {
            let base = Ident(tok_lex(first_name), sp_of_tok(first_name))
            let mut names = []
            let mut vals = []
            p_skip_semis(toks, pos)
            while !p_check(toks, pos, t_rbrace) {
                let fname = match p_expect(toks, pos, t_ident, "field name in record update") {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        lib::Token::Tok(0, "", 0, 0)
                    },
                }
                match p_expect(toks, pos, t_colon, "':' after field name") {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                let fv = match p_expression(toks, pos) {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        NoNode
                    },
                }
                push(names, tok_lex(fname))
                push(vals, fv)
                if !p_match(toks, pos, t_comma) {
                    break
                }
                p_skip_semis(toks, pos)
            }
            let rb = match p_expect(toks, pos, t_rbrace, "'}' after record update fields") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            return Ok(RecordUpdate(base, names, vals, sp_union(sp_of_tok(tok), sp_of_tok(rb))))
        }
        match p_expect(toks, pos, t_colon, "':' after field name") {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        let first_val = match p_expression(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        let mut names = [tok_lex(first_name)]
        let mut vals = [first_val]
        if p_match(toks, pos, t_comma) {
            p_skip_semis(toks, pos)
            while !p_check(toks, pos, t_rbrace) {
                let fname = match p_expect(toks, pos, t_ident, "field name in record literal") {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        lib::Token::Tok(0, "", 0, 0)
                    },
                }
                match p_expect(toks, pos, t_colon, "':' after field name") {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                let fv = match p_expression(toks, pos) {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        NoNode
                    },
                }
                push(names, tok_lex(fname))
                push(vals, fv)
                if !p_match(toks, pos, t_comma) {
                    break
                }
                p_skip_semis(toks, pos)
            }
        }
        let rb = match p_expect(toks, pos, t_rbrace, "'}' after record fields") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        Ok(RecordLit(names, vals, sp_union(sp_of_tok(tok), sp_of_tok(rb))))
    } else if t == t_ident {
        p_advance(toks, pos)
        Ok(Ident(tok_lex(tok), sp_of_tok(tok)))
    } else if t == t_lparen {
        let lp = p_advance(toks, pos)
        let e = match p_expression(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        if p_match(toks, pos, t_comma) {
            let mut elems = [e]
            p_skip_semis(toks, pos)
            while !p_check(toks, pos, t_rparen) {
                let el = match p_expression(toks, pos) {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        NoNode
                    },
                }
                push(elems, el)
                if !p_match(toks, pos, t_comma) {
                    break
                }
                p_skip_semis(toks, pos)
            }
            let rp = match p_expect(toks, pos, t_rparen, "')' after tuple") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            Ok(TupleLit(elems, sp_union(sp_of_tok(lp), sp_of_tok(rp))))
        } else {
            match p_expect(toks, pos, t_rparen, "')'") {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            Ok(e)
        }
    } else if t == t_lbracket {
        p_advance(toks, pos)
        let mut elems = []
        p_skip_semis(toks, pos)
        while !p_check(toks, pos, t_rbracket) {
            let el = match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            push(elems, el)
            if !p_match(toks, pos, t_comma) {
                break
            }
            p_skip_semis(toks, pos)
        }
        p_skip_semis(toks, pos)
        let rb = match p_expect(toks, pos, t_rbracket, "']' after list elements") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        Ok(ListLit(elems, sp_union(sp_of_tok(tok), sp_of_tok(rb))))
    } else if t == t_fn {
        p_advance(toks, pos)
        p_fn_rest(toks, pos, "", sp_of_tok(tok), false)
    } else if t == t_if {
        p_if_expr(toks, pos)
    } else if t == t_match {
        p_match_expr(toks, pos)
    } else if t == t_lbrace {
        p_block(toks, pos)
    } else {
        perr("E1109", "", "unexpected token \"" + tok_lex(tok) + "\"", sp_of_tok(tok))
    }
}

// p_interpolated 解析插值字符串：把片段与表达式拼成 + 链
// p_interpolated parses interpolated strings: segments and expressions become a + chain
fn p_interpolated(toks, mut pos) {
    let start = p_advance(toks, pos)
    let mut out = StrLit(tok_lex(start), sp_of_tok(start))
    let mut done = false
    while !done {
        let inner = match p_expression(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        out = Binary(t_plus, out, inner, sp_union(span_of(out), span_of(inner)))
        p_skip_semis(toks, pos)
        let next = p_peek(toks, pos)
        let nt = tok_type(next)
        let part = if nt == t_interp_mid || nt == t_interp_end {
            p_advance(toks, pos)
        } else {
            return perr("E1101", "close the interpolation with '}'", "expected the end of a string interpolation, got \"" + tok_lex(next) + "\"", sp_of_tok(next))
            lib::Token::Tok(0, "", 0, 0)
        }
        out = Binary(t_plus, out, StrLit(tok_lex(part), sp_of_tok(part)), sp_union(sp_of_tok(start), sp_of_tok(part)))
        done = nt == t_interp_end
    }
    Ok(out)
}

// p_if_expr 解析 if 表达式：条件 + then/else 块（值位置 else 必须）
// p_if_expr parses if: condition with then/else blocks (else required when used as a value)
fn p_if_expr(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let cond = match p_expression(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    let then = match p_block(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    let mut sp = sp_union(sp_of_tok(tok), span_of(then))
    let mut els = NoNode
    if p_match(toks, pos, t_else) {
        els = if p_check(toks, pos, t_if) {
            match p_if_expr(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
        } else {
            match p_block(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
        }
        sp = sp_union(sp, span_of(els))
    }
    Ok(IfExpr(cond, then, els, sp))
}

// p_match_expr 解析 match 表达式：穷尽性由 checker 做，这里解析分支（模式 + 可选 guard + 体）
// p_match_expr parses match: exhaustiveness is the checker's job; here we parse arms
// (pattern + optional guard + body)
fn p_match_expr(toks, mut pos) {
    let tok = p_advance(toks, pos)
    // match：scrutinee 后解析模式臂（or-pattern 展开 + 可选 guard）
    // Match: scrutinee, then pattern arms (or-patterns expand, optional guards)
    let scrut = match p_expression(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    match p_expect(toks, pos, t_lbrace, "'" + chr(123) + "' after match scrutinee") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let mut arms = []
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_rbrace) && !p_check(toks, pos, t_eof) {
        let pat = match p_pattern(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        let mut pats = [pat]
        while p_match(toks, pos, t_bar) {
            let p2 = match p_pattern(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
            push(pats, p2)
        }
        let has_guard = p_match(toks, pos, t_if)
        let guard = if has_guard {
            match p_expression(toks, pos) {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    NoNode
                },
            }
        } else {
            NoNode
        }
        match p_expect(toks, pos, t_arrow, if has_guard {
            "'=>' after pattern"
        } else {
            "'=>' after match guard"
        }) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        p_skip_semis(toks, pos)
        let body = match p_expression(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        for p in pats {
            push(arms, MatchArm(p, guard, body, sp_union(span_of(p), span_of(body))))
        }
        if !p_match(toks, pos, t_comma) && !p_check(toks, pos, t_semi) && !p_check(toks, pos, t_rbrace) {
            return perr("E1104", "", "expected ',' or newline between match arms", sp_of_tok(p_peek(toks, pos)))
        }
        p_skip_semis(toks, pos)
    }
    let rb = match p_expect(toks, pos, t_rbrace, "'}' after match arms") {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            lib::Token::Tok(0, "", 0, 0)
        },
    }
    let sp = sp_union(sp_of_tok(tok), sp_of_tok(rb))
    if len(arms) == 0 {
        return perr("E1110", "", "match must have at least one arm", sp)
    }
    Ok(MatchExpr(scrut, arms, sp))
}

// p_pattern 解析模式：通配/字面量/绑定/变体/record 模式
// p_pattern parses patterns: wildcard, literal, binding, variant, record
fn p_pattern(toks, mut pos) {
    // 模式分派：record 模式/字面量/负数字面量/标识符（绑定、变体、通配）
    // Pattern dispatch: record, literals, negated literals, identifiers
    // (binding, variant, wildcard)
    let tok = p_peek(toks, pos)
    let t = tok_type(tok)
    if t == t_record {
        let rk = p_advance(toks, pos)
        match p_expect(toks, pos, t_lbrace, "'" + chr(123) + "' after record pattern") {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        let mut names = []
        p_skip_semis(toks, pos)
        while !p_check(toks, pos, t_rbrace) {
            let fname = match p_expect(toks, pos, t_ident, "field name in record pattern") {
                Ok(v) => v,
                Err(d) => {
                    return Err(d)
                    lib::Token::Tok(0, "", 0, 0)
                },
            }
            push(names, tok_lex(fname))
            if !p_match(toks, pos, t_comma) {
                break
            }
            p_skip_semis(toks, pos)
        }
        let rb = match p_expect(toks, pos, t_rbrace, "'}' after record pattern fields") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        Ok(PatRecord(names, sp_union(sp_of_tok(rk), sp_of_tok(rb))))
    } else if t == t_int || t == t_float || t == t_string || t == t_true || t == t_false {
        let lit = match p_primary(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        Ok(PatLiteral(lit, span_of(lit)))
    } else if t == t_minus {
        p_advance(toks, pos)
        let lit = match p_primary(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        match lit {
            IntLit(n, lsp) => Ok(PatLiteral(IntLit(-n, lsp), sp_union(sp_of_tok(tok), lsp))),
            FloatLit(f, lsp) => Ok(PatLiteral(FloatLit(-f, lsp), sp_union(sp_of_tok(tok), lsp))),
            _ => perr("E1111", "", "'-' in pattern must precede a number", sp_of_tok(tok)),
        }
    } else if t == t_ident {
        // 标识符模式：_ 通配；:: 限定变体；() 后接字段绑定
        // Identifier patterns: _ wildcard; :: qualified variants; () binds fields
        p_advance(toks, pos)
        if tok_lex(tok) == "_" {
            Ok(PatWildcard(sp_of_tok(tok)))
        } else {
            let mut pkg = ""
            let mut enum_name = ""
            let mut variant = tok_lex(tok)
            let mut sp = sp_of_tok(tok)
            if p_match(toks, pos, t_colon_colon) {
                enum_name = tok_lex(tok)
                let vtok = match p_expect(toks, pos, t_ident, "variant name after '::'") {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        lib::Token::Tok(0, "", 0, 0)
                    },
                }
                variant = tok_lex(vtok)
                sp = sp_union(sp, sp_of_tok(vtok))
                if p_match(toks, pos, t_colon_colon) {
                    pkg = enum_name
                    enum_name = variant
                    let vtok2 = match p_expect(toks, pos, t_ident, "variant name after '::'") {
                        Ok(v) => v,
                        Err(d) => {
                            return Err(d)
                            lib::Token::Tok(0, "", 0, 0)
                        },
                    }
                    variant = tok_lex(vtok2)
                    sp = sp_union(sp, sp_of_tok(vtok2))
                }
            }
            if p_match(toks, pos, t_lparen) {
                let mut binds = []
                while !p_check(toks, pos, t_rparen) {
                    let sub = match p_pattern(toks, pos) {
                        Ok(v) => v,
                        Err(d) => {
                            return Err(d)
                            NoNode
                        },
                    }
                    let ok_sub = match sub {
                        PatBinding(_, _) => true,
                        PatWildcard(_) => true,
                        _ => false,
                    }
                    if !ok_sub {
                        return perr("E1112", "", "variant fields may only bind names or use '_'", span_of(sub))
                    }
                    push(binds, sub)
                    if !p_match(toks, pos, t_comma) {
                        break
                    }
                }
                let rp = match p_expect(toks, pos, t_rparen, "')' after variant pattern") {
                    Ok(v) => v,
                    Err(d) => {
                        return Err(d)
                        lib::Token::Tok(0, "", 0, 0)
                    },
                }
                Ok(PatVariant(pkg, enum_name, variant, binds, sp_union(sp, sp_of_tok(rp))))
            } else if enum_name != "" {
                Ok(PatVariant(pkg, enum_name, variant, [], sp))
            } else {
                Ok(PatBinding(variant, sp))
            }
        }
    } else {
        perr("E1113", "", "invalid pattern \"" + tok_lex(tok) + "\"", sp_of_tok(tok))
    }
}
