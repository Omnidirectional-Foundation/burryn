// parser.bur — 递归下降解析器（Pratt 表达式 + 语句分派）。
// Recursive-descent parser: Pratt expressions plus statement dispatch.
// 出错时同步到下一个语句边界（花括号配平 + 分号/语句起始 token），一次报告最多 20 条诊断。
// On error it synchronizes to the next statement boundary
// (brace balancing + semicolon or a statement starter), capping diagnostics at 20.
// parse 是脚本解析入口：逐语句解析，出错同步并累积诊断（上限 20 条）
// parse is the script entry: parses statements, recovers and accumulates diagnostics (cap 20)
pub fn parse(toks) {
    let mut pos = [0]
    let mut stmts = []
    let mut diags = []
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_eof) && len(diags) < 20 {
        match p_statement(toks, pos) {
            Ok(s) => push(stmts, s),
            Err(d) => {
                push(diags, d)
                p_synchronize(toks, pos)
            },
        }
        p_skip_semis(toks, pos)
    }
    Parsed(stmts, diags)
}

// parse_interface 解析 interface 文件（模块导出签名，语法子集）
// parse_interface parses an interface file (exported signatures, a syntax subset)
pub fn parse_interface(toks) {
    let mut pos = [0]
    let mut stmts = []
    let mut diags = []
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_eof) && len(diags) < 20 {
        match p_interface_statement(toks, pos) {
            Ok(s) => push(stmts, s),
            Err(d) => {
                push(diags, d)
                p_synchronize(toks, pos)
            },
        }
        p_skip_semis(toks, pos)
    }
    Parsed(stmts, diags)
}



