// fold_rewrite.bur — 常量折叠改写遍历。
// fold_rewrite.bur — const-fold rewrite walk.

// fr_trunc 截断环境到标记深度（丢弃遮蔽层）/ fr_trunc truncates the environment to the marked depth
fn fr_trunc(mark, mut env_names, mut env_vals) {
    while len(env_names) > mark {
        let _ = pop(env_names)
        let _ = pop(env_vals)
    }
}
