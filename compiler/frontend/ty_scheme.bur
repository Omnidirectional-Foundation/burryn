// ty_scheme.bur — 泛化/实例化与 SCC。
// ty_scheme.bur — generalize/instantiate and SCC.

// ty_generalize_walk 泛化：低于阈值级别的自由变量变为多态
// ty_generalize_walk generalizes: free variables below the level threshold become polymorphic
fn ty_generalize_walk(tk, tn, ta, tr, tl, h, level, mut vars, mut seen) {
    let x = ty_resolve(tk, tr, h)
    if tk[x] == 2 {
        let dup = match get(seen, x) {
            Some(_) => true,
            None => false,
        }
        if tl[x] > level && !dup {
            put(seen, x, true)
            push(vars, x)
        }
    } else if tk[x] == 0 {
        for a in ta[x] {
            ty_generalize_walk(tk, tn, ta, tr, tl, a, level, vars, seen)
        }
    } else {
        for p in ta[x] {
            ty_generalize_walk(tk, tn, ta, tr, tl, p, level, vars, seen)
        }
        ty_generalize_walk(tk, tn, ta, tr, tl, tr[x], level, vars, seen)
    }
}

// ty_instantiate_cp 实例化：复制多态 scheme，替换约束变量
// ty_instantiate_cp instantiates: copies a polymorphic scheme, substituting constraint variables
fn ty_instantiate_cp(mut tk, mut tn, mut ta, mut tr, mut tl, h, subst) {
    let x = ty_resolve(tk, tr, h)
    if tk[x] == 2 {
        match get(subst, x) {
            Some(n) => n,
            None => x,
        }
    } else if tk[x] == 0 {
        let mut cargs = []
        for a in ta[x] {
            push(cargs, ty_instantiate_cp(tk, tn, ta, tr, tl, a, subst))
        }
        ty_new_con(tk, tn, ta, tr, tl, tn[x], cargs)
    } else {
        let mut ps = []
        for p in ta[x] {
            push(ps, ty_instantiate_cp(tk, tn, ta, tr, tl, p, subst))
        }
        let ret = ty_instantiate_cp(tk, tn, ta, tr, tl, tr[x], subst)
        ty_new_fn(tk, tn, ta, tr, tl, ps, ret)
    }
}

