// parse_capture.bur — capture 列表。
// parse_capture.bur — capture list.

import "burryn.dev/compiler/lib"

// p_capture_list 解析 capture 子句的捕获列表：返回 ref 捕获名（值捕获项不记录）
// p_capture_list parses a capture clause list: returns ref-captured names
// (value-captured items are default and not recorded)
fn p_capture_list(toks, mut pos) {
    match p_expect(toks, pos, t_lparen, "'(' after capture") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let mut crefs = []
    p_skip_semis(toks, pos)
    while !p_check(toks, pos, t_rparen) {
        let is_ref = tok_type(p_peek(toks, pos)) == t_ident && tok_lex(p_peek(toks, pos)) == "ref"
        if is_ref {
            let _ = p_advance(toks, pos)
        }
        let ptok = match p_expect(toks, pos, t_ident, "captured name") {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                lib::Token::Tok(0, "", 0, 0)
            },
        }
        if is_ref {
            push(crefs, tok_lex(ptok))
        }
        if !p_match(toks, pos, t_comma) {
            break
        }
        p_skip_semis(toks, pos)
    }
    match p_expect(toks, pos, t_rparen, "')' after capture list") {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    Ok(crefs)
}
