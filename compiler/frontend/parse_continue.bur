// parse_continue.bur — continue 语句。
// parse_continue.bur — continue statement.

fn p_continue_stmt(toks, mut pos) {
let tok = p_advance(toks, pos)
let mut lb = ""
if p_check(toks, pos, t_ident) {
    lb = tok_lex(p_advance(toks, pos))
}
match p_end_stmt(toks, pos) {
    Ok(_) => {},
    Err(d) => {
        return Err(d)
    },
}
Ok(ContinueStmt(lb, sp_of_tok(tok)))
    
}
