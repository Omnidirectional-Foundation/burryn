// ast_eq_expr.bur — 表达式/模式结构相等。
// ast_eq_expr.bur — expression/pattern structural equality.

fn ast_eq_unary(op1, r1, b) {
    match b {
        Unary(op2, r2, _) => op1 == op2 && ast_eq(r1, r2),
        _ => false,
    }
}

fn ast_eq_binary(op1, l1, r1, b) {
    match b {
        Binary(op2, l2, r2, _) => op1 == op2 && ast_eq(l1, l2) && ast_eq(r1, r2),
        _ => false,
    }
}

fn ast_eq_logical(op1, l1, r1, b) {
    match b {
        Logical(op2, l2, r2, _) => op1 == op2 && ast_eq(l1, l2) && ast_eq(r1, r2),
        _ => false,
    }
}

fn ast_eq_call(c1, a1, b) {
    match b {
        Call(c2, a2, _) => ast_eq(c1, c2) && ast_eq_list(a1, a2),
        _ => false,
    }
}

fn ast_eq_pipe(l1, t1, a1, b) {
    match b {
        Pipe(l2, t2, a2, _) => ast_eq(l1, l2) && ast_eq(t1, t2) && ast_eq_list(a1, a2),
        _ => false,
    }
}

fn ast_eq_index(t1, i1, b) {
    match b {
        Index(t2, i2, _) => ast_eq(t1, t2) && ast_eq(i1, i2),
        _ => false,
    }
}

fn ast_eq_list_lit(e1, b) {
    match b {
        ListLit(e2, _) => ast_eq_list(e1, e2),
        _ => false,
    }
}

fn ast_eq_fn_lit(p1, m1, t1, r1, b1, n1, c1, b) {
    match b {
        FnLit(p2, m2, _, t2, r2, b2, n2, c2, _) => ast_eq_strs(p1, p2) && ast_eq_bools(m1, m2) && ast_eq_list(t1, t2) && ast_eq(r1, r2) && ast_eq(b1, b2) && n1 == n2 && ast_eq_strs(c1, c2),
        _ => false,
    }
}

fn ast_eq_block(s1, b) {
    match b {
        Block(s2, _) => ast_eq_list(s1, s2),
        _ => false,
    }
}

fn ast_eq_if(c1, t1, e1, b) {
    match b {
        IfExpr(c2, t2, e2, _) => ast_eq(c1, c2) && ast_eq(t1, t2) && ast_eq(e1, e2),
        _ => false,
    }
}

fn ast_eq_match(s1, a1, b) {
    match b {
        MatchExpr(s2, a2, _) => ast_eq(s1, s2) && ast_eq_list(a1, a2),
        _ => false,
    }
}

fn ast_eq_match_arm(p1, g1, b1, b) {
    match b {
        MatchArm(p2, g2, b2, _) => ast_eq(p1, p2) && ast_eq(g1, g2) && ast_eq(b1, b2),
        _ => false,
    }
}

fn ast_eq_record_lit(n1, v1, b) {
    match b {
        RecordLit(n2, v2, _) => ast_eq_strs(n1, n2) && ast_eq_list(v1, v2),
        _ => false,
    }
}

fn ast_eq_record_update(ba1, n1, v1, b) {
    match b {
        RecordUpdate(ba2, n2, v2, _) => ast_eq(ba1, ba2) && ast_eq_strs(n1, n2) && ast_eq_list(v1, v2),
        _ => false,
    }
}

fn ast_eq_field_access(e1, f1, b) {
    match b {
        FieldAccess(e2, f2, _) => ast_eq(e1, e2) && f1 == f2,
        _ => false,
    }
}

fn ast_eq_pat_variant(p1, e1, v1, b1, b) {
    match b {
        PatVariant(p2, e2, v2, b2, _) => p1 == p2 && e1 == e2 && v1 == v2 && ast_eq_list(b1, b2),
        _ => false,
    }
}

fn ast_eq_tuple_lit(e1, b) {
    match b {
        TupleLit(e2, _) => ast_eq_list(e1, e2),
        _ => false,
    }
}
