// ast_spanof.bur — span_of。
// ast_spanof.bur — span_of.


// span_of 取节点的源码区间 / span_of returns a node's source span
pub fn span_of(n) {
    match n {
        IntLit(_, sp) => sp,
        FloatLit(_, sp) => sp,
        StrLit(_, sp) => sp,
        BoolLit(_, sp) => sp,
        Ident(_, sp) => sp,
        Unary(_, _, sp) => sp,
        Binary(_, _, _, sp) => sp,
        Logical(_, _, _, sp) => sp,
        Call(_, _, sp) => sp,
        Pipe(_, _, _, sp) => sp,
        Index(_, _, sp) => sp,
        ListLit(_, sp) => sp,
        FnLit(_, _, _, _, _, _, _, _, sp) => sp,
        Block(_, sp) => sp,
        IfExpr(_, _, _, sp) => sp,
        MatchExpr(_, _, sp) => sp,
        MatchArm(_, _, _, sp) => sp,
        VariantAccess(_, _, sp) => sp,
        PkgAccess(_, _, sp) => sp,
        QualVariantAccess(_, _, _, sp) => sp,
        TryExpr(_, sp) => sp,
        RecvExpr(_, sp) => sp,
        RecordLit(_, _, sp) => sp,
        RecordUpdate(_, _, _, sp) => sp,
        FieldAccess(_, _, sp) => sp,
        PatWildcard(sp) => sp,
        PatLiteral(_, sp) => sp,
        PatBinding(_, sp) => sp,
        PatVariant(_, _, _, _, sp) => sp,
        PatRecord(_, sp) => sp,
        LetStmt(_, _, _, _, _, _, sp) => sp,
        ConstDecl(_, _, _, _, _, sp) => sp,
        AssignStmt(_, _, sp) => sp,
        ExprStmt(_, sp) => sp,
        WhileStmt(_, _, sp) => sp,
        ForStmt(_, _, _, _, _, _, _, sp) => sp,
        LabelStmt(_, _, sp) => sp,
        ReturnStmt(_, sp) => sp,
        FnDecl(_, _, _, _, sp) => sp,
        MethodDecl(_, _, _, _, sp) => sp,
        DestructLet(_, _, _, _, sp) => sp,
        TupleLit(_, sp) => sp,
        EnumDecl(_, _, _, _, sp) => sp,
        EnumVariantDecl(_, _, _, sp) => sp,
        ImportDecl(_, _, _, _, sp) => sp,
        SpawnStmt(_, sp) => sp,
        SelectStmt(_, _, _, _, sp) => sp,
        SelectArm(_, _, _, _, _, _, sp) => sp,
        SendStmt(_, _, sp) => sp,
        BreakStmt(_, sp) => sp,
        ContinueStmt(_, sp) => sp,
        DeferStmt(_, _, sp) => sp,
        TypeAliasDecl(_, _, _, sp) => sp,
        TEName(_, _, _, _, sp) => sp,
        TEList(_, sp) => sp,
        TEFn(_, _, sp) => sp,
        TERecord(_, _, _, sp) => sp,
        TETuple(_, sp) => sp,
        NoNode => Sp(0, 0),
    }
}
