// token.bur — 词法单元类型编号表与辅助函数 / Token type ids and helpers.
// 编号是编译器的稳定 ABI：字节码反汇编、格式化器、LSP 都按此解释 token。
// Ids are a stable ABI: the disassembler, formatter, and LSP interpret tokens by these numbers.
import "burryn.dev/compiler/lib"

// 成对分隔符与单字符标点 / Paired delimiters and single-character punctuation
pub let t_lparen = 0
pub let t_rparen = 1
pub let t_lbrace = 2
pub let t_rbrace = 3
pub let t_lbracket = 4
pub let t_rbracket = 5
pub let t_comma = 6
pub let t_dot = 7
pub let t_minus = 8
pub let t_plus = 9
pub let t_slash = 10
pub let t_star = 11
pub let t_percent = 12
pub let t_semi = 13
pub let t_question = 14
pub let t_colon = 15

// 组合操作符：== != <= >= && || -> <- -> / Compound operators
pub let t_bang = 16
pub let t_bang_eq = 17
pub let t_eq = 18
pub let t_eq_eq = 19
pub let t_gt = 20
pub let t_gt_eq = 21
pub let t_lt = 22
pub let t_lt_eq = 23
pub let t_and_and = 24
pub let t_or_or = 25
pub let t_arrow = 26
pub let t_larrow = 27
pub let t_thin_arrow = 28

// 字面量类 / Literal token kinds
pub let t_ident = 29
pub let t_string = 30
pub let t_int = 31
pub let t_float = 32

// 关键字（编号与 grammar.md 的关键字表一一对应）/ Keywords (mirrors grammar.md)
pub let t_let = 33
pub let t_mut = 34
pub let t_fn = 35
pub let t_if = 36
pub let t_else = 37
pub let t_while = 38
pub let t_for = 39
pub let t_in = 40
pub let t_return = 41
pub let t_true = 42
pub let t_false = 43
pub let t_enum = 44
pub let t_match = 45
pub let t_spawn = 46
pub let t_break = 47
pub let t_continue = 48
pub let t_pub = 49
pub let t_import = 50
pub let t_select = 51

pub let t_eof = 52

// 注释作为 trivia 记录，不进语法树 / Comments recorded as trivia, never parsed
pub let t_comment = 53

// 插值字符串片段："{a}{b}" 拆为 start/mid/end / Interpolation string segments
pub let t_interp_start = 54
pub let t_interp_mid = 55
pub let t_interp_end = 56
pub let t_pipe = 57
pub let t_const = 58
pub let t_defer = 59
pub let t_record = 60
pub let t_type = 61
pub let t_bar = 62

// 冻结语法新增：:: 路径限定与 .. range 字面量 / Frozen additions: :: paths, .. ranges
pub let t_colon_colon = 63

pub let t_dot_dot = 64

// 复合赋值 / Compound assignment operators
pub let t_plus_eq = 65
pub let t_minus_eq = 66
pub let t_star_eq = 67
pub let t_slash_eq = 68
pub let t_percent_eq = 69

// 调试/诊断用名称表，下标即 token 编号 / Debug names, indexed by token id
pub let tok_names = ["TLParen", "TRParen", "TLBrace", "TRBrace", "TLBracket", "TRBracket", "TComma", "TDot", "TMinus", "TPlus", "TSlash", "TStar", "TPercent", "TSemi", "TQuestion", "TColon", "TBang", "TBangEq", "TEq", "TEqEq", "TGt", "TGtEq", "TLt", "TLtEq", "TAndAnd", "TOrOr", "TArrow", "TLArrow", "TThinArrow", "TIdent", "TString", "TInt", "TFloat", "TLet", "TMut", "TFn", "TIf", "TElse", "TWhile", "TFor", "TIn", "TReturn", "TTrue", "TFalse", "TEnum", "TMatch", "TSpawn", "TBreak", "TContinue", "TPub", "TImport", "TSelect", "TEOF", "TComment", "TInterpStart", "TInterpMid", "TInterpEnd", "TPipe", "TConst", "TDefer", "TRecord", "TType", "TBar", "TColonColon", "TDotDot", "TPlusEq", "TMinusEq", "TStarEq", "TSlashEq", "TPercentEq"]

// tok_type 返回 token 的类型编号 / tok_type returns the token type id
pub fn tok_type(t) {
    match t {
        lib::Token::Tok(ty, _, _, _) => ty,
    }
}

// tok_lex 返回 token 的 lexeme 文本 / tok_lex returns the token lexeme
pub fn tok_lex(t) {
    match t {
        lib::Token::Tok(_, lx, _, _) => lx,
    }
}

// sp_of_tok 返回 token 的源码区间 / sp_of_tok returns the source span
fn sp_of_tok(t) {
    match t {
        lib::Token::Tok(_, _, s, e) => Sp(s, e),
    }
}

// lex_keyword 映射标识符到关键字编号，非关键字返回 t_ident / lex_keyword maps words to keyword ids; unknown words stay identifiers
fn lex_keyword(word) {
    match word {
        "let" => t_let,
        "mut" => t_mut,
        "const" => t_const,
        "defer" => t_defer,
        "fn" => t_fn,
        "if" => t_if,
        "else" => t_else,
        "while" => t_while,
        "for" => t_for,
        "in" => t_in,
        "return" => t_return,
        "true" => t_true,
        "false" => t_false,
        "enum" => t_enum,
        "match" => t_match,
        "spawn" => t_spawn,
        "break" => t_break,
        "continue" => t_continue,
        "pub" => t_pub,
        "import" => t_import,
        "select" => t_select,
        "record" => t_record,
        "type" => t_type,
        _ => t_ident,
    }
}

// lex_can_end_stmt 判断 token 能否合法结束一条语句（决定自动分号插入）/ lex_can_end_stmt tells whether a token can end a statement (ASI decision)
fn lex_can_end_stmt(t) {
    t == t_ident || t == t_string || t == t_interp_end || t == t_int || t == t_float || t == t_true || t == t_false || t == t_rparen || t == t_rbracket || t == t_rbrace || t == t_question || t == t_return || t == t_break || t == t_continue
}
