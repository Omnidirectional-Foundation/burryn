// fold_diag.bur — 常量折叠诊断。
// fold_diag.bur — const-fold diagnostics.

import "burryn.dev/compiler/lib"

// fc_not_const 报「非编译期常量」诊断 / fc_not_const reports a not-a-compile-time-constant diagnostic
fn fc_not_const(label, sp, mut adiags) {
    match sp {
        Sp(s0, e0) => push(adiags, lib::DiagT::Diag(true, "E0015", "`" + label + "` is not a compile-time constant", fold_help, s0, e0)),
    }
    FRErr
}

// fc_shape 报「非常量形状」错误 / fc_shape reports a not-a-constant-shape error
fn fc_shape(sp, mut adiags) {
    match sp {
        Sp(s0, e0) => push(adiags, lib::DiagT::Diag(true, "E0015", "const initializer must be a compile-time constant expression", fold_help, s0, e0)),
    }
    FRErr
}
