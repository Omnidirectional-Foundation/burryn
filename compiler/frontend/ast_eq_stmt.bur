// ast_eq_stmt.bur — 语句结构相等。
// ast_eq_stmt.bur — statement structural equality.

fn ast_eq_let(n1, m1, pb1, i1, b) {
    match b {
        LetStmt(n2, _, m2, pb2, _, i2, _) => n1 == n2 && m1 == m2 && pb1 == pb2 && ast_eq(i1, i2),
        _ => false,
    }
}

fn ast_eq_const(n1, pb1, i1, b) {
    match b {
        ConstDecl(n2, _, pb2, _, i2, _) => n1 == n2 && pb1 == pb2 && ast_eq(i1, i2),
        _ => false,
    }
}

fn ast_eq_assign(t1, v1, b) {
    match b {
        AssignStmt(t2, v2, _) => ast_eq(t1, t2) && ast_eq(v1, v2),
        _ => false,
    }
}

fn ast_eq_while(c1, b1, b) {
    match b {
        WhileStmt(c2, b2, _) => ast_eq(c1, c2) && ast_eq(b1, b2),
        _ => false,
    }
}

fn ast_eq_for(v1, i1, ch1, b1, b) {
    match b {
        ForStmt(v2, _, _, _, i2, ch2, b2, _) => v1 == v2 && ast_eq(i1, i2) && ch1 == ch2 && ast_eq(b1, b2),
        _ => false,
    }
}

fn ast_eq_fn_decl(n1, p1, f1, b) {
    match b {
        FnDecl(n2, _, p2, f2, _) => n1 == n2 && p1 == p2 && ast_eq(f1, f2),
        _ => false,
    }
}

fn ast_eq_method_decl(t1, n1, f1, b) {
    match b {
        MethodDecl(t2, n2, _, f2, _) => t1 == t2 && n1 == n2 && ast_eq(f1, f2),
        _ => false,
    }
}

fn ast_eq_destruct_let(n1, m1, i1, b) {
    match b {
        DestructLet(n2, _, m2, i2, _) => ast_eq_strs(n1, n2) && m1 == m2 && ast_eq(i1, i2),
        _ => false,
    }
}

fn ast_eq_enum_decl(n1, tp1, v1, p1, b) {
    match b {
        EnumDecl(n2, tp2, v2, p2, _) => n1 == n2 && ast_eq_strs(tp1, tp2) && ast_eq_list(v1, v2) && p1 == p2,
        _ => false,
    }
}

fn ast_eq_enum_variant(n1, a1, f1, b) {
    match b {
        EnumVariantDecl(n2, a2, f2, _) => n1 == n2 && a1 == a2 && ast_eq_list(f1, f2),
        _ => false,
    }
}

fn ast_eq_select(a1, h1, d1, b) {
    match b {
        SelectStmt(a2, h2, d2, _, _) => ast_eq_list(a1, a2) && h1 == h2 && ast_eq(d1, d2),
        _ => false,
    }
}

fn ast_eq_select_arm(s1, bn1, c1, v1, b1, b) {
    match b {
        SelectArm(s2, bn2, _, c2, v2, b2, _) => s1 == s2 && bn1 == bn2 && ast_eq(c1, c2) && ast_eq(v1, v2) && ast_eq(b1, b2),
        _ => false,
    }
}

fn ast_eq_defer(b1, c1, b) {
    match b {
        DeferStmt(b2, c2, _) => ast_eq(b1, b2) && ast_eq_strs(c1, c2),
        _ => false,
    }
}

fn ast_eq_type_alias(n1, t1, p1, b) {
    match b {
        TypeAliasDecl(n2, t2, p2, _) => n1 == n2 && ast_eq(t1, t2) && p1 == p2,
        _ => false,
    }
}

fn ast_eq_te_name(p1, n1, c1, a1, b) {
    match b {
        TEName(p2, n2, c2, a2, _) => p1 == p2 && n1 == n2 && c1 == c2 && ast_eq_list(a1, a2),
        _ => false,
    }
}

fn ast_eq_te_fn(p1, r1, b) {
    match b {
        TEFn(p2, r2, _) => ast_eq_list(p1, p2) && ast_eq(r1, r2),
        _ => false,
    }
}

fn ast_eq_te_record(n1, t1, r1, b) {
    match b {
        TERecord(n2, t2, r2, _) => ast_eq_strs(n1, n2) && ast_eq_list(t1, t2) && ast_eq(r1, r2),
        _ => false,
    }
}
