// fold_combine.bur — 类型/值合并。
// fold_combine.bur — type/value combine.

// fc_type_combine 组合两侧折叠类型（按操作符判定合法性）
// fc_type_combine combines two folded types (operator legality)
fn fc_type_combine(lt, rt, op) {
    match lt {
        FTType(l) => match rt {
            FTType(r) => {
                if op == t_plus && l == r && (l == 0 || l == 1 || l == 2) {
                    FTType(l)
                } else if (op == t_minus || op == t_star || op == t_slash) && l == r && (l == 0 || l == 1) {
                    FTType(l)
                } else if op == t_percent && l == 0 && r == 0 {
                    FTType(0)
                } else if (op == t_lt || op == t_lt_eq || op == t_gt || op == t_gt_eq) && l == r && (l == 0 || l == 1 || l == 2) {
                    FTType(3)
                } else if (op == t_eq_eq || op == t_bang_eq) && l == r {
                    FTType(3)
                } else {
                    FTSoft
                }
            },
            FTBlocked(n) => FTBlocked(n),
            FTSoft => FTSoft,
            FTErr => FTErr,
        },
        FTBlocked(n) => FTBlocked(n),
        FTErr => FTErr,
        FTSoft => match rt {
            FTBlocked(n) => FTBlocked(n),
            FTErr => FTErr,
            _ => FTSoft,
        },
    }
}

// fc_combine 组合两侧求值结果（二元）/ fc_combine combines two fold results (binary)
fn fc_combine(lr, rr, op, sp, mut adiags) {
    match lr {
        FRVal(lv) => match rr {
            FRVal(rv) => fc_bin(op, lv, rv, sp, adiags),
            other => other,
        },
        FRBlocked(n) => FRBlocked(n),
        lother => match rr {
            FRBlocked(n2) => FRBlocked(n2),
            FRErr => FRErr,
            _ => lother,
        },
    }
}
