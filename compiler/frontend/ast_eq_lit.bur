// ast_eq_lit.bur — 字面量/简单节点结构相等。
// ast_eq_lit.bur — literal/simple-node structural equality.

fn ast_eq_int(x, b) {
    match b {
        IntLit(y, _) => x == y,
        _ => false,
    }
}

fn ast_eq_float(x, b) {
    match b {
        FloatLit(y, _) => x == y,
        _ => false,
    }
}

fn ast_eq_str(x, b) {
    match b {
        StrLit(y, _) => x == y,
        _ => false,
    }
}

fn ast_eq_bool(x, b) {
    match b {
        BoolLit(y, _) => x == y,
        _ => false,
    }
}

fn ast_eq_ident(x, b) {
    match b {
        Ident(y, _) => x == y,
        _ => false,
    }
}

fn ast_eq_variant_access(e1, v1, b) {
    match b {
        VariantAccess(e2, v2, _) => e1 == e2 && v1 == v2,
        _ => false,
    }
}

fn ast_eq_pkg_access(p1, n1, b) {
    match b {
        PkgAccess(p2, n2, _) => p1 == p2 && n1 == n2,
        _ => false,
    }
}

fn ast_eq_qual_variant(p1, e1, v1, b) {
    match b {
        QualVariantAccess(p2, e2, v2, _) => p1 == p2 && e1 == e2 && v1 == v2,
        _ => false,
    }
}

fn ast_eq_try(e1, b) {
    match b {
        TryExpr(e2, _) => ast_eq(e1, e2),
        _ => false,
    }
}

fn ast_eq_recv(e1, b) {
    match b {
        RecvExpr(e2, _) => ast_eq(e1, e2),
        _ => false,
    }
}

fn ast_eq_pat_wild(b) {
    match b {
        PatWildcard(_) => true,
        _ => false,
    }
}

fn ast_eq_pat_lit(l1, b) {
    match b {
        PatLiteral(l2, _) => ast_eq(l1, l2),
        _ => false,
    }
}

fn ast_eq_pat_bind(n1, b) {
    match b {
        PatBinding(n2, _) => n1 == n2,
        _ => false,
    }
}

fn ast_eq_pat_rec(n1, b) {
    match b {
        PatRecord(n2, _) => ast_eq_strs(n1, n2),
        _ => false,
    }
}

fn ast_eq_expr_stmt(e1, b) {
    match b {
        ExprStmt(e2, _) => ast_eq(e1, e2),
        _ => false,
    }
}

fn ast_eq_label(l1, inner1, b) {
    match b {
        LabelStmt(l2, inner2, _) => l1 == l2 && ast_eq(inner1, inner2),
        _ => false,
    }
}

fn ast_eq_return(v1, b) {
    match b {
        ReturnStmt(v2, _) => ast_eq(v1, v2),
        _ => false,
    }
}

fn ast_eq_import(a1, p1, b) {
    match b {
        ImportDecl(a2, _, p2, _, _) => a1 == a2 && p1 == p2,
        _ => false,
    }
}

fn ast_eq_spawn(c1, b) {
    match b {
        SpawnStmt(c2, _) => ast_eq(c1, c2),
        _ => false,
    }
}

fn ast_eq_send(c1, v1, b) {
    match b {
        SendStmt(c2, v2, _) => ast_eq(c1, c2) && ast_eq(v1, v2),
        _ => false,
    }
}

fn ast_eq_break(l1, b) {
    match b {
        BreakStmt(l2, _) => l1 == l2,
        _ => false,
    }
}

fn ast_eq_continue(l1, b) {
    match b {
        ContinueStmt(l2, _) => l1 == l2,
        _ => false,
    }
}

fn ast_eq_te_list(e1, b) {
    match b {
        TEList(e2, _) => ast_eq(e1, e2),
        _ => false,
    }
}

fn ast_eq_te_tuple(t1, b) {
    match b {
        TETuple(t2, _) => ast_eq_list(t1, t2),
        _ => false,
    }
}

fn ast_eq_nonode(b) {
    match b {
        NoNode => true,
        _ => false,
    }
}
