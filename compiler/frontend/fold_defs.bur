// fold_defs.bur — 折叠结果/值枚举与边界常量。
// fold_defs.bur — fold result/value enums and bound constants.

import "burryn.dev/compiler/lib"

// 折叠结果：脚本或包集合 / Fold outcome: a script or a package set
pub enum FoldOut {
    FoldedScript([Node], [lib::DiagT]),
    FoldedPkgs([[[Node]]], [lib::DiagT], [str]),
}

// 折叠值：字面值、被遮蔽（未定型）、毒值（错误路径）/ Folded value: literal, masked (not yet typed), or poison (error path)
enum FVal {
    FVInt(int),
    FVFloat(float),
    FVStr(str),
    FVBool(bool),
    FVMasked,
    FVPoison,
}

// 表达式求值结果 / Expression fold result
enum FRes {
    FRVal(FVal),
    FRBlocked(str),
    FRSoft,
    FRErr,
}

// 类型折叠结果 / Type fold result
enum FTRes {
    FTType(int),
    FTBlocked(str),
    FTSoft,
    FTErr,
}

// 折叠整数算术的 i64 边界（溢出检查用）/ i64 bounds for folded integer arithmetic (overflow checks)
let fold_max_int = 9223372036854775807
let fold_min_int = -9223372036854775807 - 1

// 折叠限制提示与 trap 提前报错提示（诊断 help 文本）/ Diagnostic help strings for folding limits and early traps
let fold_help = "const initializers allow literals, references to other constants, arithmetic, comparisons, `&&`/`||`/`!`, and str concatenation"
let trap_help = "this operation traps at runtime; constant initializers are evaluated at compile time, so the trap is reported as a compile error"
