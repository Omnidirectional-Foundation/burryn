// fold_bin.bur — 常量折叠二元/一元运算。
// fold_bin.bur — const-fold binary/unary ops.

// fc_logical 求值逻辑运算 / fc_logical evaluates logical operators
fn fc_logical(op, lv, rv) {
    match lv {
        FVBool(x) => match rv {
            FVBool(y) => if op == t_and_and {
                FRVal(FVBool(x && y))
            } else {
                FRVal(FVBool(x || y))
            },
            _ => FRSoft,
        },
        _ => FRSoft,
    }
}

// fc_bin 按值类型分派二元折叠 / fc_bin dispatches binary folds by value kind
fn fc_bin(op, lv, rv, sp, mut adiags) {
    match lv {
        FVInt(x) => match rv {
            FVInt(y) => fc_bin_int(op, x, y, sp, adiags),
            _ => FRSoft,
        },
        FVFloat(x) => match rv {
            FVFloat(y) => fc_bin_float(op, x, y),
            _ => FRSoft,
        },
        FVStr(x) => match rv {
            FVStr(y) => fc_bin_str(op, x, y),
            _ => FRSoft,
        },
        FVBool(x) => match rv {
            FVBool(y) => fc_bin_bool(op, x, y),
            _ => FRSoft,
        },
        _ => FRSoft,
    }
}
