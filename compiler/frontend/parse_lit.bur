// parse_lit.bur — 字面量转 int。
// parse_lit.bur — literal-to-int.


// lit_to_int 把数字字面量转 int（hex/二进制/十进制，带溢出检查）
// lit_to_int converts a literal lexeme to int (hex/binary/decimal, overflow-checked)
fn lit_to_int(lexeme) {
    let l = str_len(lexeme)
    if l > 2 && substr(lexeme, 0, 2) == "0x" {
        let mut v = 0
        let mut i = 2
        while i < l {
            let c = substr(lexeme, i, 1)
            if c == "_" {
                i = i + 1
                continue
            }
            let d = if c >= "0" && c <= "9" {
                ord(c) - ord("0")
            } else if c >= "a" && c <= "f" {
                ord(c) - ord("a") + 10
            } else if c >= "A" && c <= "F" {
                ord(c) - ord("A") + 10
            } else {
                -1
            }
            if d < 0 || v > (9223372036854775807 - d) / 16 {
                return None
            }
            v = v * 16 + d
            i = i + 1
        }
        Some(v)
    } else if l > 2 && substr(lexeme, 0, 2) == "0b" {
        let mut v = 0
        let mut i = 2
        while i < l {
            let c = substr(lexeme, i, 1)
            if c == "_" {
                i = i + 1
                continue
            }
            let d = if c == "0" || c == "1" {
                ord(c) - ord("0")
            } else {
                -1
            }
            if d < 0 || v > (9223372036854775807 - d) / 2 {
                return None
            }
            v = v * 2 + d
            i = i + 1
        }
        Some(v)
    } else {
        let mut clean = ""
        let mut i = 0
        while i < l {
            let c = substr(lexeme, i, 1)
            if c != "_" {
                clean = clean + c
            }
            i = i + 1
        }
        parse_int(clean)
    }
}
