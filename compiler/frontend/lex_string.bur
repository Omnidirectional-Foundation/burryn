// lex_string.bur — 字符串/插值词法。
// lex_string.bur — string/interpolation lexing.

// lex_string 是普通字符串扫描入口；first 区分开头片段与插值后恢复的片段（后者以 TInterpEnd 结束）
// lex_string scans an ordinary string; first distinguishes the opening segment
// from one resumed after an interpolation-closing `}`; the latter ends in TInterpEnd.
fn lex_string(src, mut st, mut toks, mut diags, mut comments) {
    lex_string_part(src, st, toks, diags, comments, true)
}

// lex_string_part 扫描字符串片段（含转义与插值切换）
// lex_string_part scans a string segment (escapes and interpolation switching)
fn lex_string_part(src, mut st, mut toks, mut diags, mut comments, first) {
    let mut parts = []
    let mut seg = st[1]
    while st[1] < str_len(src) {
        let c = lex_peek(src, st)
        if c == "\"" {
            push(parts, substr(src, seg, st[1] - seg))
            lex_bump(st)
            lex_emit(st, toks, if first {
                t_string
            } else {
                t_interp_end
            }, join(parts, ""))
            return
        } else if c == "" + chr(123) + "" {
            if lex_peek2(src, st) == "" + chr(123) + "" {
                push(parts, substr(src, seg, st[1] - seg))
                push(parts, "" + chr(123) + "")
                st[1] = st[1] + 2
                seg = st[1]
            } else {
                push(parts, substr(src, seg, st[1] - seg))
                lex_bump(st)
                lex_emit(st, toks, if first {
                    t_interp_start
                } else {
                    t_interp_mid
                }, join(parts, ""))
                lex_interpolation(src, st, toks, diags, comments, st[1] - 1, fn(mut s, mut st, mut toks, mut d, mut c) {
                    lex_string_part(s, st, toks, d, c, false)
                })
                return
            }
        } else {
            let _ = lex_advance(src, st)
            if c == "\\" && st[1] < str_len(src) {
                push(parts, substr(src, seg, st[1] - 1 - seg))
                let e = lex_advance(src, st)
                if e == "n" {
                    push(parts, "\n")
                } else if e == "t" {
                    push(parts, "\t")
                } else if e == "\"" {
                    push(parts, "\"")
                } else if e == "\\" {
                    push(parts, "\\")
                } else if e == "r" {
                    push(parts, chr(13))
                } else {
                    lex_fail(diags, st[1] - 2, st[1], "E1003", "supported escapes: \\n \\t \\\" \\\\ \\r", "bad escape \\" + e)
                    push(parts, e)
                }
                seg = st[1]
            }
        }
    }
    lex_fail(diags, st[0], st[0] + 1, "E1002", "add a closing '\"'", "unterminated string")
}
