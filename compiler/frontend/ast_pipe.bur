// ast_pipe.bur — 管道表达式降级。
// ast_pipe.bur — pipe-expression lowering.

// lower_pipes 做管道脱糖：x |> f(a) 展开为 f(x, a)，递归下推整个语法树
// lower_pipes desugars pipes: x |> f(a) becomes f(x, a), pushed recursively through the tree
pub fn lower_pipes(stmts) {
    lower_pipe_nodes(stmts)
}

// lower_pipe_packages 做包级管道脱糖（多文件）/ lower_pipe_packages desugars pipes across a package's files
pub fn lower_pipe_packages(pkgs_stmts) {
    let mut out = []
    for pkg in pkgs_stmts {
        let mut files = []
        for stmts in pkg {
            push(files, lower_pipe_nodes(stmts))
        }
        push(out, files)
    }
    out
}

