// parse_binop.bur — 二元/一元表达式梯子。
// parse_binop.bur — binary/unary expression ladder.


// p_or_expr 解析逻辑或（Pratt 层级：||），兼收 `..` range 字面量
// p_or_expr parses logical or (Pratt level: ||) and the `..` range literal
fn p_or_expr(toks, mut pos) {
    let mut e = match p_and_expr(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    while p_check(toks, pos, t_or_or) {
        p_advance(toks, pos)
        let rhs = match p_and_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Logical(t_or_or, e, rhs, sp_union(span_of(e), span_of(rhs)))
    }
    if p_match(toks, pos, t_dot_dot) {
        let rhs = match p_and_expr(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Call(Ident("range", span_of(e)), [e, rhs], sp_union(span_of(e), span_of(rhs)))
    }
    Ok(e)
}

// p_and_expr 解析逻辑与（Pratt 层级：&&）/ p_and_expr parses logical and (Pratt level: &&)
fn p_and_expr(toks, mut pos) {
    let mut e = match p_equality(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    while p_check(toks, pos, t_and_and) {
        p_advance(toks, pos)
        let rhs = match p_equality(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                NoNode
            },
        }
        e = Logical(t_and_and, e, rhs, sp_union(span_of(e), span_of(rhs)))
    }
    Ok(e)
}

