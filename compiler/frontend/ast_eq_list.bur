// ast_eq_list.bur — 列表相等。
// ast_eq_list.bur — list equality.

// ast_eq_strs 比较两个字符串列表相等 / ast_eq_strs compares string lists
fn ast_eq_strs(xs, ys) {
    if len(xs) != len(ys) {
        return false
    }
    let mut i = 0
    while i < len(xs) {
        if xs[i] != ys[i] {
            return false
        }
        i = i + 1
    }
    true
}

// ast_eq_bools 比较两个 bool 列表相等 / ast_eq_bools compares bool lists
fn ast_eq_bools(xs, ys) {
    if len(xs) != len(ys) {
        return false
    }
    let mut i = 0
    while i < len(xs) {
        if xs[i] != ys[i] {
            return false
        }
        i = i + 1
    }
    true
}
