// lex_ident.bur — 数字/标识符词法。
// lex_ident.bur — number/identifier lexing.

// lex_is_hex 判断字符是否为 16 进制数字 / lex_is_hex tells whether c is a hex digit
fn lex_is_hex(c) {
    lex_is_digit(c) || c >= "a" && c <= "f" || c >= "A" && c <= "F"
}

// lex_ident 扫描标识符并判定关键字 / lex_ident scans an identifier and looks up keywords
fn lex_ident(src, mut st, mut toks) {
    while lex_is_alpha(lex_peek(src, st)) || lex_is_digit(lex_peek(src, st)) {
        lex_bump(st)
    }
    let word = substr(src, st[0], st[1] - st[0])
    lex_emit(st, toks, lex_keyword(word), word)
}

// lex_is_digit 判断字符是否为数字 / lex_is_digit tells whether c is a digit
fn lex_is_digit(c) {
    c >= "0" && c <= "9"
}
