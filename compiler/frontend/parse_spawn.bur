// parse_spawn.bur — spawn/defer。
// parse_spawn.bur — spawn/defer.

// p_spawn_stmt 解析 spawn 语句（必须跟函数调用）/ p_spawn_stmt parses spawn (a function call is required)
fn p_spawn_stmt(toks, mut pos) {
    let tok = p_advance(toks, pos)
    let e = match p_expression(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    let is_call = match e {
        Call(_, _, _) => true,
        _ => false,
    }
    if !is_call {
        return perr("E1106", "", "spawn expects a function call, e.g. `spawn worker(ch)`", sp_of_tok(tok))
    }
    match p_end_stmt(toks, pos) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    Ok(SpawnStmt(e, sp_union(sp_of_tok(tok), span_of(e))))
}

// p_defer_stmt 解析 defer 语句（必须跟块）/ p_defer_stmt parses defer (a block is required)
fn p_defer_stmt(toks, mut pos) {
    let tok = p_advance(toks, pos)
    if !p_check(toks, pos, t_lbrace) && !p_check(toks, pos, t_capture) {
        return perr("E1119", "defer takes a block, e.g. `defer " + chr(123) + " close(ch) }`", "expected '" + chr(123) + "' after defer", sp_of_tok(p_peek(toks, pos)))
    }
    let crefs = if p_match(toks, pos, t_capture) {
        match p_capture_list(toks, pos) {
            Ok(v) => v,
            Err(d) => {
                return Err(d)
                []
            },
        }
    } else {
        []
    }
    let body = match p_block(toks, pos) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            NoNode
        },
    }
    Ok(DeferStmt(body, crefs, sp_union(sp_of_tok(tok), span_of(body))))
}
