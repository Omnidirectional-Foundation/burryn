// fmt_util.bur — 排版辅助（优先级/span/插值/缩进）。
// fmt_util.bur — format helpers (precedence/span/interp/indent).


// fmt_child 子表达式格式化（加括号决策） / fmt_child formats a child expression (parens decision)
fn fmt_child(n, need, src, comments, mut cc, indent, mut buf) {
    if node_prec(n) < need {
        push(buf, "(")
        fmt_expr(n, src, comments, cc, indent, buf)
        push(buf, ")")
    } else {
        fmt_expr(n, src, comments, cc, indent, buf)
    }
}





