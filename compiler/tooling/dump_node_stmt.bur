// dump_node_stmt.bur — 语句节点 dump。
// dump_node_stmt.bur — statement-node dump.

fn dump_let_stmt(pre, deeper, name, nsp, is_mut, is_pub, init, sp) {
    println(pre + "LetStmt " + dump_escape(name) + " " + dump_sp(nsp) + " mut=" + str(is_mut) + " pub=" + str(is_pub) + " " + dump_sp(sp))
    dump_node(init, deeper)
}

fn dump_const_decl(pre, deeper, name, nsp, is_pub, init, sp) {
    println(pre + "ConstDecl " + dump_escape(name) + " " + dump_sp(nsp) + " pub=" + str(is_pub) + " " + dump_sp(sp))
    dump_node(init, deeper)
}

fn dump_assign_stmt(pre, deeper, target, val, sp) {
    println(pre + "AssignStmt " + dump_sp(sp))
    dump_node(target, deeper)
    dump_node(val, deeper)
}

fn dump_expr_stmt(pre, deeper, e, sp) {
    println(pre + "ExprStmt " + dump_sp(sp))
    dump_node(e, deeper)
}

fn dump_while_stmt(pre, deeper, cond, body, sp) {
    println(pre + "WhileStmt " + dump_sp(sp))
    dump_node(cond, deeper)
    dump_node(body, deeper)
}

fn dump_for_stmt(pre, deeper, v, vsp, iter, is_chan, body, sp) {
    println(pre + "ForStmt " + dump_escape(v) + " " + dump_sp(vsp) + " chan=" + str(is_chan) + " " + dump_sp(sp))
    dump_node(iter, deeper)
    dump_node(body, deeper)
}

fn dump_label_stmt(pre, deeper, lb, inner, sp) {
    println(pre + "LabelStmt " + dump_escape(lb) + " " + dump_sp(sp))
    dump_node(inner, deeper)
}

fn dump_return_stmt(pre, deeper, val, sp) {
    println(pre + "ReturnStmt " + dump_sp(sp))
    dump_node(val, deeper)
}

fn dump_destruct_let(pre, deeper, names, is_mut, init, sp) {
    println(pre + "DestructLet " + dump_escape(join(names, ",")) + " mut=" + str(is_mut) + " " + dump_sp(sp))
    dump_node(init, deeper)
}

fn dump_method_decl(pre, deeper, rt, name, nsp, lit, sp) {
    println(pre + "MethodDecl " + dump_escape(rt) + "." + dump_escape(name) + " " + dump_sp(nsp) + " " + dump_sp(sp))
    dump_node(lit, deeper)
}

fn dump_fn_decl(pre, deeper, name, nsp, is_pub, lit, sp) {
    println(pre + "FnDecl " + dump_escape(name) + " " + dump_sp(nsp) + " pub=" + str(is_pub) + " " + dump_sp(sp))
    dump_node(lit, deeper)
}

fn dump_enum_decl(pre, deeper, name, params, variants, is_pub, sp) {
    println(pre + "EnumDecl " + dump_escape(name) + " params=" + dump_strs(params) + " pub=" + str(is_pub) + " " + dump_sp(sp))
    for v in variants {
        dump_node(v, deeper)
    }
}

fn dump_enum_variant_decl(pre, deeper, name, arity, vtypes) {
    println(pre + "EnumVariantDecl " + dump_escape(name) + " " + str(arity))
    for ty in vtypes {
        dump_node(ty, deeper)
    }
}

fn dump_spawn_stmt(pre, deeper, call, sp) {
    println(pre + "SpawnStmt " + dump_sp(sp))
    dump_node(call, deeper)
}

fn dump_defer_stmt(pre, deeper, body, sp) {
    println(pre + "DeferStmt " + dump_sp(sp))
    dump_node(body, deeper)
}

fn dump_type_alias_decl(pre, deeper, name, te, is_pub, sp) {
    println(pre + "TypeAliasDecl " + dump_escape(name) + " pub=" + str(is_pub) + " " + dump_sp(sp))
    dump_node(te, deeper)
}

fn dump_select_stmt(pre, deeper, arms, has_default, dflt, dsp, sp) {
    println(pre + "SelectStmt default=" + str(has_default) + " " + dump_sp(dsp) + " " + dump_sp(sp))
    for a in arms {
        dump_node(a, deeper)
    }
    dump_node(dflt, deeper)
}

fn dump_select_arm(pre, deeper, is_send, bind, bsp, ch, val, body, sp) {
    println(pre + "SelectArm send=" + str(is_send) + " " + dump_escape(bind) + " " + dump_sp(bsp) + " " + dump_sp(sp))
    dump_node(ch, deeper)
    dump_node(val, deeper)
    dump_node(body, deeper)
}

fn dump_send_stmt(pre, deeper, ch, val, sp) {
    println(pre + "SendStmt " + dump_sp(sp))
    dump_node(ch, deeper)
    dump_node(val, deeper)
}

fn dump_pat_variant(pre, deeper, pkg, en, vr, binds, sp) {
    println(pre + "PatVariant " + dump_escape(pkg) + " " + dump_escape(en) + " " + dump_escape(vr) + " " + dump_sp(sp))
    for b in binds {
        dump_node(b, deeper)
    }
}

fn dump_pat_literal(pre, deeper, v, sp) {
    println(pre + "PatLiteral " + dump_sp(sp))
    dump_node(v, deeper)
}
