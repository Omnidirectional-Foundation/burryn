// dump_node_type.bur — 类型表达式节点 dump。
// dump_node_type.bur — type-expression node dump.

fn dump_te_tuple(pre, deeper, ets, sp) {
    println(pre + "TETuple " + dump_sp(sp))
    for e in ets {
        dump_node(e, deeper)
    }
}

fn dump_te_name(pre, deeper, pkg, name, constraint, targs, sp) {
    println(pre + "TEName " + dump_escape(pkg) + " " + dump_escape(name) + " " + dump_escape(constraint) + " " + dump_sp(sp))
    for a in targs {
        dump_node(a, deeper)
    }
}

fn dump_te_list(pre, deeper, elem, sp) {
    println(pre + "TEList " + dump_sp(sp))
    dump_node(elem, deeper)
}

fn dump_te_fn(pre, deeper, params, ret, sp) {
    println(pre + "TEFn " + dump_sp(sp))
    for p in params {
        dump_node(p, deeper)
    }
    dump_node(ret, deeper)
}

fn dump_te_record(pre, deeper, fnames, ftypes, row, sp) {
    println(pre + "TERecord " + dump_escape(join(fnames, ",")) + " " + dump_sp(sp))
    for ft in ftypes {
        dump_node(ft, deeper)
    }
    dump_node(row, deeper)
}
