// lsp_headers.bur — LSP headers。
// lsp_headers.bur — LSP headers.


// lsp_read_headers 读头直到空行 / lsp_read_headers reads headers up to the blank line
fn lsp_read_headers() {
    let header_end = chr(13) + "\n" + chr(13) + "\n"
    let mut buf = ""
    let mut tail = ""
    while true {
        let b = read_stdin(1)
        if str_len(b) == 0 {
            return ""
        }
        buf = buf + b
        tail = tail + b
        if str_len(tail) > 4 {
            tail = substr(tail, str_len(tail) - 4, 4)
        }
        if tail == header_end {
            return substr(buf, 0, str_len(buf) - 4)
        }
    }
    ""
}

// lsp_parse_content_length 解析 Content-Length / lsp_parse_content_length parses Content-Length
fn lsp_parse_content_length(headers) {
    let crlf = chr(13) + "\n"
    let lines = split(headers, crlf)
    let mut result = -1
    for line in lines {
        if result < 0 && str_contains(line, "Content-Length:") {
            let val = trim(substr(line, 15, str_len(line) - 15))
            match parse_int(val) {
                Some(n) => {
                    result = n
                },
                None => {},
            }
        }
    }
    result
}
