// lsp_root.bur — 根/父/模块根。
// lsp_root.bur — root/parent/module root.


// lsp_normalize_root 规范化工作区根路径 / lsp_normalize_root normalizes the workspace root
fn lsp_normalize_root(p) {
    let n = str_len(p)
    if n > 1 && byte_at(p, n - 1) == 47 {
        substr(p, 0, n - 1)
    } else {
        p
    }
}

// lsp_parent_dir 取父目录 / lsp_parent_dir returns the parent directory
fn lsp_parent_dir(path) {
    let mut i = str_len(path) - 1
    while i > 0 && byte_at(path, i) != 47 {
        i = i - 1
    }
    if i <= 0 {
        ""
    } else {
        substr(path, 0, i)
    }
}

