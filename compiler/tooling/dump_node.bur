// dump_node.bur — AST 节点 dump。
// dump_node.bur — AST node dump.

import "burryn.dev/compiler/frontend"

// dump_node 美化打印 AST（调试用）/ dump_node pretty-prints an AST node (debugging)
pub fn dump_node(n, pre) {
    // AST 美化打印：按形态递归缩进
    // AST pretty-print: recursive, indented by shape
    let deeper = pre + "  "
    match n {
        frontend::Node::IntLit(v, sp) => println(pre + "IntLit " + str(v) + " " + dump_sp(sp)),
        frontend::Node::FloatLit(v, sp) => println(pre + "FloatLit " + str(v) + " " + dump_sp(sp)),
        frontend::Node::StrLit(v, sp) => println(pre + "StrLit " + dump_escape(v) + " " + dump_sp(sp)),
        frontend::Node::BoolLit(v, sp) => println(pre + "BoolLit " + str(v) + " " + dump_sp(sp)),
        frontend::Node::Ident(name, sp) => println(pre + "Ident " + dump_escape(name) + " " + dump_sp(sp)),
        frontend::Node::Unary(op, rhs, sp) => dump_unary(pre, deeper, op, rhs, sp),
        frontend::Node::Binary(op, lhs, rhs, sp) => dump_binary(pre, deeper, op, lhs, rhs, sp),
        frontend::Node::Logical(op, lhs, rhs, sp) => dump_logical(pre, deeper, op, lhs, rhs, sp),
        frontend::Node::Call(callee, cargs, sp) => dump_call(pre, deeper, callee, cargs, sp),
        frontend::Node::Pipe(lhs, target, args, sp) => dump_pipe(pre, deeper, lhs, target, args, sp),
        frontend::Node::Index(target, idx, sp) => dump_index(pre, deeper, target, idx, sp),
        frontend::Node::ListLit(elems, sp) => dump_list_lit_node(pre, deeper, elems, sp),
        frontend::Node::FnLit(params, muts, pspans, param_tys, ret_ty, body, name, _, sp) => dump_fn_lit_node(pre, deeper, params, muts, pspans, param_tys, ret_ty, body, name, sp),
        frontend::Node::Block(stmts, sp) => dump_block_node(pre, deeper, stmts, sp),
        frontend::Node::IfExpr(cond, then, els, sp) => dump_if_node(pre, deeper, cond, then, els, sp),
        frontend::Node::MatchExpr(scrut, arms, sp) => dump_match_node(pre, deeper, scrut, arms, sp),
        frontend::Node::MatchArm(pat, guard, body, sp) => dump_match_arm_node(pre, deeper, pat, guard, body, sp),
        frontend::Node::VariantAccess(en, vr, sp) => println(pre + "VariantAccess " + dump_escape(en) + " " + dump_escape(vr) + " " + dump_sp(sp)),
        frontend::Node::PkgAccess(pkg, name, sp) => println(pre + "PkgAccess " + dump_escape(pkg) + " " + dump_escape(name) + " " + dump_sp(sp)),
        frontend::Node::QualVariantAccess(pkg, en, vr, sp) => println(pre + "QualVariantAccess " + dump_escape(pkg) + " " + dump_escape(en) + " " + dump_escape(vr) + " " + dump_sp(sp)),
        frontend::Node::TryExpr(inner, sp) => dump_try_node(pre, deeper, inner, sp),
        frontend::Node::RecvExpr(ch, sp) => dump_recv_node(pre, deeper, ch, sp),
        frontend::Node::RecordLit(names, vals, sp) => dump_record_lit_node(pre, deeper, names, vals, sp),
        frontend::Node::RecordUpdate(base, names, vals, sp) => dump_record_update_node(pre, deeper, base, names, vals, sp),
        frontend::Node::FieldAccess(base, field, sp) => dump_field_access_node(pre, deeper, base, field, sp),
        frontend::Node::PatWildcard(sp) => println(pre + "PatWildcard " + dump_sp(sp)),
        frontend::Node::PatLiteral(v, sp) => dump_pat_literal(pre, deeper, v, sp),
        frontend::Node::PatBinding(name, sp) => println(pre + "PatBinding " + dump_escape(name) + " " + dump_sp(sp)),
        frontend::Node::PatRecord(names, sp) => println(pre + "PatRecord " + dump_escape(join(names, ",")) + " " + dump_sp(sp)),
        frontend::Node::PatVariant(pkg, en, vr, binds, sp) => dump_pat_variant(pre, deeper, pkg, en, vr, binds, sp),
        frontend::Node::LetStmt(name, nsp, is_mut, is_pub, _, init, sp) => dump_let_stmt(pre, deeper, name, nsp, is_mut, is_pub, init, sp),
        frontend::Node::ConstDecl(name, nsp, is_pub, _, init, sp) => dump_const_decl(pre, deeper, name, nsp, is_pub, init, sp),
        frontend::Node::AssignStmt(target, val, sp) => dump_assign_stmt(pre, deeper, target, val, sp),
        frontend::Node::ExprStmt(e, sp) => dump_expr_stmt(pre, deeper, e, sp),
        frontend::Node::WhileStmt(cond, body, sp) => dump_while_stmt(pre, deeper, cond, body, sp),
        frontend::Node::ForStmt(v, vsp, _, _, iter, is_chan, body, sp) => dump_for_stmt(pre, deeper, v, vsp, iter, is_chan, body, sp),
        frontend::Node::LabelStmt(lb, inner, sp) => dump_label_stmt(pre, deeper, lb, inner, sp),
        frontend::Node::ReturnStmt(val, sp) => dump_return_stmt(pre, deeper, val, sp),
        frontend::Node::TETuple(ets, sp) => dump_te_tuple(pre, deeper, ets, sp),
        frontend::Node::DestructLet(names, _, is_mut, init, sp) => dump_destruct_let(pre, deeper, names, is_mut, init, sp),
        frontend::Node::TupleLit(elems, sp) => dump_tuple_lit_node(pre, deeper, elems, sp),
        frontend::Node::MethodDecl(rt, name, nsp, lit, sp) => dump_method_decl(pre, deeper, rt, name, nsp, lit, sp),
        frontend::Node::FnDecl(name, nsp, is_pub, lit, sp) => dump_fn_decl(pre, deeper, name, nsp, is_pub, lit, sp),
        frontend::Node::EnumDecl(name, params, variants, is_pub, sp) => dump_enum_decl(pre, deeper, name, params, variants, is_pub, sp),
        frontend::Node::EnumVariantDecl(name, arity, vtypes, _) => dump_enum_variant_decl(pre, deeper, name, arity, vtypes),
        frontend::Node::ImportDecl(alias, asp, path, psp, sp) => println(pre + "ImportDecl " + dump_escape(alias) + " " + dump_sp(asp) + " " + dump_escape(path) + " " + dump_sp(psp) + " " + dump_sp(sp)),
        frontend::Node::SpawnStmt(call, sp) => dump_spawn_stmt(pre, deeper, call, sp),
        frontend::Node::DeferStmt(body, _, sp) => dump_defer_stmt(pre, deeper, body, sp),
        frontend::Node::TypeAliasDecl(name, te, is_pub, sp) => dump_type_alias_decl(pre, deeper, name, te, is_pub, sp),
        frontend::Node::SelectStmt(arms, has_default, dflt, dsp, sp) => dump_select_stmt(pre, deeper, arms, has_default, dflt, dsp, sp),
        frontend::Node::SelectArm(is_send, bind, bsp, ch, val, body, sp) => dump_select_arm(pre, deeper, is_send, bind, bsp, ch, val, body, sp),
        frontend::Node::SendStmt(ch, val, sp) => dump_send_stmt(pre, deeper, ch, val, sp),
        frontend::Node::BreakStmt(lb, sp) => println(pre + "BreakStmt " + dump_escape(lb) + " " + dump_sp(sp)),
        frontend::Node::ContinueStmt(lb, sp) => println(pre + "ContinueStmt " + dump_escape(lb) + " " + dump_sp(sp)),
        frontend::Node::TEName(pkg, name, constraint, targs, sp) => dump_te_name(pre, deeper, pkg, name, constraint, targs, sp),
        frontend::Node::TEList(elem, sp) => dump_te_list(pre, deeper, elem, sp),
        frontend::Node::TEFn(params, ret, sp) => dump_te_fn(pre, deeper, params, ret, sp),
        frontend::Node::TERecord(fnames, ftypes, row, sp) => dump_te_record(pre, deeper, fnames, ftypes, row, sp),
        frontend::Node::NoNode => println(pre + "frontend.Node.NoNode"),
    }
}
