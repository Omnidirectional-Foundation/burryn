// fmt_stmt.bur — 语句/声明排版。
// fmt_stmt.bur — statement/declaration formatting.

import "burryn.dev/compiler/frontend"

// fmt_stmt 语句格式化 / fmt_stmt formats a statement
fn fmt_stmt(n, src, comments, mut cc, indent, mut buf) {
    // 语句格式化：按形态输出，行尾注释回插
    // Statement formatting: emit per shape, trailing comments reinserted
    match n {
        frontend::Node::ConstDecl(name, _, is_pub, ty, init, _) => fmt_const_decl(name, is_pub, ty, init, src, comments, cc, indent, buf),
        frontend::Node::DestructLet(names, _, is_mut, init, _) => fmt_destruct_let(names, is_mut, init, src, comments, cc, indent, buf),
        frontend::Node::LetStmt(name, _, is_mut, is_pub, ty, init, _) => fmt_let_stmt(name, is_mut, is_pub, ty, init, src, comments, cc, indent, buf),
        frontend::Node::FnDecl(name, _, is_pub, fnlit, _) => fmt_fn_decl_stmt(name, is_pub, fnlit, src, comments, cc, indent, buf),
        frontend::Node::MethodDecl(rt, name, _, fnlit, _) => fmt_method_decl(rt, name, fnlit, src, comments, cc, indent, buf),
        frontend::Node::ReturnStmt(val, _) => fmt_return_stmt_fmt(val, src, comments, cc, indent, buf),
        frontend::Node::AssignStmt(target, val, _) => fmt_assign_stmt_fmt(target, val, src, comments, cc, indent, buf),
        frontend::Node::ExprStmt(e, _) => fmt_expr(e, src, comments, cc, indent, buf),
        frontend::Node::WhileStmt(cond, body, _) => fmt_while_stmt_fmt(cond, body, src, comments, cc, indent, buf),
        frontend::Node::ForStmt(v, _, idx, _, iter, _, body, _) => fmt_for_stmt_fmt(v, idx, iter, body, src, comments, cc, indent, buf),
        frontend::Node::LabelStmt(lb, inner, _) => fmt_label_stmt_fmt(lb, inner, src, comments, cc, indent, buf),
        frontend::Node::SpawnStmt(call, _) => fmt_spawn_stmt_fmt(call, src, comments, cc, indent, buf),
        frontend::Node::DeferStmt(body, crefs, _) => fmt_defer_stmt(body, crefs, src, comments, cc, indent, buf),
        frontend::Node::TypeAliasDecl(name, te, is_pub, _) => fmt_type_alias_fmt(name, te, is_pub, src, comments, cc, indent, buf),
        frontend::Node::SendStmt(ch, val, _) => fmt_send_stmt_fmt(ch, val, src, comments, cc, indent, buf),
        frontend::Node::BreakStmt(lb, _) => fmt_break_stmt_fmt(lb, buf),
        frontend::Node::ContinueStmt(lb, _) => fmt_continue_stmt_fmt(lb, buf),
        frontend::Node::ImportDecl(alias, _, _, psp, _) => fmt_import_decl_fmt(alias, psp, src, buf),
        frontend::Node::EnumDecl(name, tparams, variants, is_pub, sp) => fmt_enum_decl(name, tparams, variants, is_pub, sp, src, comments, cc, indent, buf),
        frontend::Node::SelectStmt(arms, has_default, dflt, dsp, sp) => fmt_select_stmt(arms, has_default, dflt, dsp, sp, src, comments, cc, indent, buf),
        _ => fmt_internal("unhandled statement node"),
    }
}
