// dump_lists.bur — 列表 dump。
// dump_lists.bur — list dump.

// dump_strs 打印字符串列表 / dump_strs prints a string list
fn dump_strs(xs) {
    let mut parts = []
    for x in xs {
        push(parts, dump_escape(x))
    }
    "[" + join(parts, " ") + "]"
}

// dump_bools 打印 bool 列表 / dump_bools prints a bool list
fn dump_bools(xs) {
    let mut parts = []
    for x in xs {
        push(parts, str(x))
    }
    "[" + join(parts, " ") + "]"
}
