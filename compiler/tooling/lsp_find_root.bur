// lsp_find_root.bur — 找模块根。
// lsp_find_root.bur — find module root.

import "burryn.dev/compiler/module"

// lsp_find_module_root 查找模块根 / lsp_find_module_root finds the module root
fn lsp_find_module_root(file_path) {
    let mut dir = lsp_parent_dir(file_path)
    let mut steps = 0
    while dir != "" && steps < 100 {
        if file_exists(dir + "/bur.mod") {
            return dir
        }
        if module::lsp_get_root_path() != "" && dir == module::lsp_get_root_path() {
            return ""
        }
        dir = lsp_parent_dir(dir)
        steps = steps + 1
    }
    ""
}
