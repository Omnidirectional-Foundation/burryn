// dump_diag.bur — 诊断 dump 与对齐辅助。
// dump_diag.bur — diagnostic dump and padding helpers.

import "burryn.dev/compiler/lib"

// dump_diag_f 按文件过滤打印诊断 / dump_diag_f prints diagnostics filtered by file
pub fn dump_diag_f(d, f) {
    match d {
        lib::DiagT::Diag(is_err, code, _, _, s, e) => {
            let kind = if is_err {
                "error"
            } else {
                "warning"
            }
            "diag " + kind + " " + code + " " + f + " " + str(s) + " " + str(e)
        },
        lib::DiagT::DiagX(is_err, code, _, _, s, e, _, _) => {
            let kind = if is_err {
                "error"
            } else {
                "warning"
            }
            "diag " + kind + " " + code + " " + f + " " + str(s) + " " + str(e)
        },
    }
}

// dump_diag 打印诊断 / dump_diag prints a diagnostic
pub fn dump_diag(d) {
    match d {
        lib::DiagT::Diag(is_err, code, _, _, s, e) => {
            let kind = if is_err {
                "error"
            } else {
                "warning"
            }
            "diag " + kind + " " + code + " " + str(s) + " " + str(e)
        },
        lib::DiagT::DiagX(is_err, code, _, _, s, e, _, _) => {
            let kind = if is_err {
                "error"
            } else {
                "warning"
            }
            "diag " + kind + " " + code + " " + str(s) + " " + str(e)
        },
    }
}

