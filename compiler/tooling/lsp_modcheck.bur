// lsp_modcheck.bur — 模块级检查。
// lsp_modcheck.bur — module-level check.

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"
import "burryn.dev/compiler/module"

// lsp_check_module 检查整个模块（didOpen 全量检查） / lsp_check_module checks a module (didOpen full check)
fn lsp_check_module(open_uri) {
    let open_path = lsp_uri_to_path(open_uri)
    let root = lsp_find_module_root(open_path)
    if root == "" {
        match module::lsp_doc_get(open_uri) {
            Some(text) => lsp_publish_diagnostics(open_uri, lsp_check_document(open_uri, text)),
            None => {},
        }
        return
    }
    match module::load_module(root) {
        module::ModOut::ModFailed(diags, dfiles) => {
            lsp_publish_module_diags(open_path, diags, dfiles, [], [])
        },
        module::ModOut::ModLoaded(ldiags, lfiles, pkg_paths, pkgs_stmts, pkgs_fpaths, pkgs_imports, pkg_ids, pkgs_lstarts) => {
            let mut all_diags = concat(ldiags, [])
            let mut all_files = concat(lfiles, [])
            match frontend::fold_const_packages(pkgs_stmts, pkgs_fpaths, pkg_paths, pkgs_imports) {
                frontend::FoldOut::FoldedPkgs(folded, fdiags, ffiles) => {
                    all_diags = concat(all_diags, fdiags)
                    all_files = concat(all_files, ffiles)
                    frontend::lsp_set_recording(true)
                    match module::typecheck_cached(folded, pkgs_fpaths, pkg_paths, pkgs_imports, pkg_ids) {
                        lib::CheckOut::Checked(cdiags, cfiles, _, _, _) => {
                            all_diags = concat(all_diags, cdiags)
                            all_files = concat(all_files, cfiles)
                        },
                    }
                    frontend::lsp_set_recording(false)
                },
                _ => {},
            }
            lsp_publish_module_diags(open_path, all_diags, all_files, pkgs_fpaths, pkgs_lstarts)
        },
    }
}
