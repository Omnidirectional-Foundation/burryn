// dump_pad.bur — 填充。
// dump_pad.bur — padding.

// pad_left 左侧补空格 / pad_left left-pads with spaces
fn pad_left(s, w) {
    let mut out = s
    while str_len(out) < w {
        out = " " + out
    }
    out
}

// pad_right 右侧补空格 / pad_right right-pads with spaces
fn pad_right(s, w) {
    let mut out = s
    while str_len(out) < w {
        out = out + " "
    }
    out
}
