// render.bur — rustc 风格诊断渲染：多 span 标注 + 结构化修复建议。
// rustc-style diagnostic rendering: multi-span annotations and structured fix suggestions.


// pad_num 数字零填充（行号对齐用）/ pad_num zero-pads a number (line-number alignment)
fn pad_num(n, w) {
    let s = str(n)
    let mut out = s
    while str_len(out) < w {
        out = " " + out
    }
    out
}

// spaces 生成 n 个空格 / spaces produces n spaces
fn spaces(n) {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + " "
        i = i + 1
    }
    out
}


