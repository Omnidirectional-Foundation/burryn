// dump.bur — 语法树与字节码转储：AST 节点、token 流、反汇编与诊断渲染。
// Syntax-tree and bytecode dumps: AST nodes, token streams, disassembly and diagnostics.

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

// dump_diag_f 按文件过滤打印诊断 / dump_diag_f prints diagnostics filtered by file
pub fn dump_diag_f(d, f) {
    match d {
        lib::DiagT::Diag(is_err, code, _, _, s, e) => {
            let kind = if is_err {
                "error"
            } else {
                "warning"
            }
            "diag " + kind + " " + code + " " + f + " " + str(s) + " " + str(e)
        },
        lib::DiagT::DiagX(is_err, code, _, _, s, e, _, _) => {
            let kind = if is_err {
                "error"
            } else {
                "warning"
            }
            "diag " + kind + " " + code + " " + f + " " + str(s) + " " + str(e)
        },
    }
}

// dump_diag 打印诊断 / dump_diag prints a diagnostic
pub fn dump_diag(d) {
    match d {
        lib::DiagT::Diag(is_err, code, _, _, s, e) => {
            let kind = if is_err {
                "error"
            } else {
                "warning"
            }
            "diag " + kind + " " + code + " " + str(s) + " " + str(e)
        },
        lib::DiagT::DiagX(is_err, code, _, _, s, e, _, _) => {
            let kind = if is_err {
                "error"
            } else {
                "warning"
            }
            "diag " + kind + " " + code + " " + str(s) + " " + str(e)
        },
    }
}

// dump_disasm 是反汇编入口 / dump_disasm is the disassembly entry
pub fn dump_disasm(fh0, f_name, f_arity, f_nupvals, f_code, f_spans, f_consts, en_qual, en_vnames, _en_varities, starts) {
    // dump_fn 打印一个函数 / dump_fn prints a function
    fn dump_fn(fh) capture(ref f_name, ref f_arity, ref f_nupvals, ref f_code, ref f_spans, ref f_consts, ref en_qual, ref en_vnames, ref starts) {
        let name = if f_name[fh] == "" {
            "<anonymous>"
        } else {
            f_name[fh]
        }
        println("== " + name + " (arity " + str(f_arity[fh]) + ", upvals " + str(f_nupvals[fh]) + ") ==")
        let mut ip = 0
        while ip < len(f_code[fh]) {
            ip = dump_inst(fh, ip, f_code, f_spans, f_consts, f_nupvals, f_name, en_qual, en_vnames, starts)
        }
    }

    // dump_all 打印全部 / dump_all prints everything
    fn dump_all(fh) capture(ref f_name, ref f_arity, ref f_nupvals, ref f_code, ref f_spans, ref f_consts, ref en_qual, ref en_vnames, ref starts, ref dump_fn, ref dump_all) {
        dump_fn(fh)
        for cv in f_consts[fh] {
            match cv {
                lib::CVal::CFn(sub) => {
                    println("")
                    dump_all(sub)
                },
                _ => {},
            }
        }
    }

    dump_all(fh0)
}

fn dump_inst_closure(pre, code, consts, f_nupvals, f_name, en_qual, en_vnames, ip) {
    let v = op_u16(code, ip + 1)
    let sub = match consts[v] {
        lib::CVal::CFn(fh2) => fh2,
        _ => 0,
    }
    println(pre + pad_right("CLOSURE", 16) + " " + str(v) + " (" + repr_cval(consts[v], f_name, en_qual, en_vnames) + ")")
    let mut next = ip + 3
    let mut i = 0
    while i < f_nupvals[sub] {
        let kind = if code[next] == 1 {
            "local"
        } else {
            "upval"
        }
        println(pad_zero(next, 4) + "    |    capture " + kind + " " + str(op_u16(code, next + 1)))
        next = next + 3
        i = i + 1
    }
    next
}

fn dump_inst_const(pre, code, consts, f_name, en_qual, en_vnames, op, ip) {
    let name = if op == lib::op_const {
        "CONST"
    } else if op == lib::op_get_global {
        "GET_GLOBAL"
    } else if op == lib::op_def_global {
        "DEF_GLOBAL"
    } else {
        "SET_GLOBAL"
    }
    let v = op_u16(code, ip + 1)
    println(pre + pad_right(name, 16) + " " + str(v) + " (" + repr_cval(consts[v], f_name, en_qual, en_vnames) + ")")
    ip + 3
}

fn dump_inst_local(pre, code, op, ip) {
    let name = if op == lib::op_get_local {
        "GET_LOCAL"
    } else if op == lib::op_set_local {
        "SET_LOCAL"
    } else if op == lib::op_get_upval {
        "GET_UPVAL"
    } else if op == lib::op_set_upval {
        "SET_UPVAL"
    } else {
        "LIST"
    }
    println(pre + pad_right(name, 16) + " " + str(op_u16(code, ip + 1)))
    ip + 3
}

fn dump_inst_argc(pre, code, op, ip) {
    let name = if op == lib::op_pop_n {
        "POP_N"
    } else if op == lib::op_end_block {
        "END_BLOCK"
    } else if op == lib::op_call {
        "CALL"
    } else if op == lib::op_test_variant {
        "TEST_VARIANT"
    } else if op == lib::op_get_field {
        "GET_FIELD"
    } else {
        "SPAWN"
    }
    println(pre + pad_right(name, 16) + " " + str(code[ip + 1]))
    ip + 2
}

fn dump_inst_record(pre, code, consts, f_name, en_qual, en_vnames, op, ip) {
    let name = if op == lib::op_record {
        "RECORD"
    } else {
        "RECORD_UPDATE"
    }
    let n = code[ip + 1]
    let cidx = op_u16(code, ip + 2)
    println(pre + pad_right(name, 16) + " " + str(n) + " " + repr_cval(consts[cidx], f_name, en_qual, en_vnames))
    ip + 4
}

fn dump_inst_field_name(pre, code, consts, f_name, en_qual, en_vnames, ip) {
    let cidx = op_u16(code, ip + 1)
    println(pre + pad_right("GET_FIELD_NAME", 16) + " " + repr_cval(consts[cidx], f_name, en_qual, en_vnames))
    ip + 3
}

fn dump_inst_jump(pre, code, op, ip) {
    let name = if op == lib::op_jump {
        "JUMP"
    } else if op == lib::op_jump_if_false {
        "JUMP_IF_FALSE"
    } else if op == lib::op_jump_if_true {
        "JUMP_IF_TRUE"
    } else if op == lib::op_jump_if_false_pop {
        "JUMP_IF_FALSE_P"
    } else if op == lib::op_loop {
        "LOOP"
    } else {
        "CHAN_NEXT"
    }
    let sign = if op == lib::op_loop {
        -1
    } else {
        1
    }
    let v = op_u16(code, ip + 1)
    println(pre + pad_right(name, 16) + " " + pad_zero(ip, 4) + " -> " + pad_zero(ip + 3 + sign * v, 4))
    ip + 3
}

fn dump_inst(fh, ip, f_code, f_spans, f_consts, f_nupvals, f_name, en_qual, en_vnames, starts) {
    let code = f_code[fh]
    let spans = f_spans[fh]
    let consts = f_consts[fh]
    let line = match spans[ip] {
        frontend::SpanT::Sp(s, e) => if s == 0 && e == 0 {
            0
        } else {
            lib::line_of(starts, s)
        },
    }
    let pre = pad_zero(ip, 4) + " " + pad_left(str(line), 4) + "  "
    let op = code[ip]
    if op == lib::op_const || op == lib::op_get_global || op == lib::op_def_global || op == lib::op_set_global {
        dump_inst_const(pre, code, consts, f_name, en_qual, en_vnames, op, ip)
    } else if op == lib::op_get_local || op == lib::op_set_local || op == lib::op_get_upval || op == lib::op_set_upval || op == lib::op_list {
        dump_inst_local(pre, code, op, ip)
    } else if op == lib::op_pop_n || op == lib::op_end_block || op == lib::op_call || op == lib::op_test_variant || op == lib::op_get_field || op == lib::op_spawn {
        dump_inst_argc(pre, code, op, ip)
    } else if op == lib::op_jump || op == lib::op_jump_if_false || op == lib::op_jump_if_true || op == lib::op_jump_if_false_pop || op == lib::op_loop || op == lib::op_chan_next {
        dump_inst_jump(pre, code, op, ip)
    } else if op == lib::op_closure {
        dump_inst_closure(pre, code, consts, f_nupvals, f_name, en_qual, en_vnames, ip)
    } else if op == lib::op_select {
        dump_inst_select(pre, code, op, ip)
    } else if op == lib::op_record || op == lib::op_record_update {
        dump_inst_record(pre, code, consts, f_name, en_qual, en_vnames, op, ip)
    } else if op == lib::op_get_field_name {
        dump_inst_field_name(pre, code, consts, f_name, en_qual, en_vnames, ip)
    } else {
        dump_inst_simple(pre, op, ip)
    }
}

fn dump_inst_select(pre, code, _op, ip) {
    let n_arms = code[ip + 1]
    let has_default = code[ip + 2] != 0
    let mut p = ip + 3
    println(pre + pad_right("SELECT", 16) + " arms=" + str(n_arms) + " default=" + str(has_default))
    let mut i = 0
    while i < n_arms {
        let kind = if code[p] == 1 {
            "send"
        } else {
            "recv"
        }
        println(pad_zero(p, 4) + "    |    arm " + str(i) + " " + kind + " -> " + pad_zero(p + 3 + op_u16(code, p + 1), 4))
        p = p + 3
        i = i + 1
    }
    if has_default {
        println(pad_zero(p, 4) + "    |    default -> " + pad_zero(p + 2 + op_u16(code, p), 4))
        p = p + 2
    }
    p
}

fn dump_inst_simple(pre, op, ip) {
    let name = if op == lib::op_unit {
        "UNIT"
    } else if op == lib::op_true {
        "TRUE"
    } else if op == lib::op_false {
        "FALSE"
    } else if op == lib::op_pop {
        "POP"
    } else if op == lib::op_close_upvalue {
        "CLOSE_UPVALUE"
    } else if op == lib::op_eq {
        "EQ"
    } else if op == lib::op_neq {
        "NEQ"
    } else if op == lib::op_gt {
        "GT"
    } else if op == lib::op_gt_eq {
        "GT_EQ"
    } else if op == lib::op_lt {
        "LT"
    } else if op == lib::op_lt_eq {
        "LT_EQ"
    } else if op == lib::op_add {
        "ADD"
    } else if op == lib::op_sub {
        "SUB"
    } else if op == lib::op_mul {
        "MUL"
    } else if op == lib::op_div {
        "DIV"
    } else if op == lib::op_mod {
        "MOD"
    } else if op == lib::op_neg {
        "NEG"
    } else if op == lib::op_not {
        "NOT"
    } else if op == lib::op_return {
        "RETURN"
    } else if op == lib::op_index_get {
        "INDEX_GET"
    } else if op == lib::op_index_set {
        "INDEX_SET"
    } else if op == lib::op_len {
        "LEN"
    } else if op == lib::op_no_match {
        "NO_MATCH"
    } else if op == lib::op_try {
        "TRY"
    } else if op == lib::op_defer {
        "DEFER"
    } else if op == lib::op_send {
        "SEND"
    } else if op == lib::op_recv {
        "RECV"
    } else {
        "UNKNOWN " + str(op)
    }
    println(pre + name)
    ip + 1
}

fn repr_cval(cv, f_name, en_qual, en_vnames) {
    match cv {
        lib::CVal::CInt(n) => str(n),
        lib::CVal::CFloat(f) => str(f),
        lib::CVal::CStr(s) => lib::go_quote(s),
        lib::CVal::CFn(fh) => "<fn " + f_name[fh] + ">",
        lib::CVal::CEnumType(eh) => "<enum " + en_qual[eh] + ">",
        lib::CVal::CSingleton(eh, i) => en_vnames[eh][i],
        lib::CVal::CCtor(eh, i) => "<variant " + en_qual[eh] + "." + en_vnames[eh][i] + ">",
    }
}

fn op_u16(code, ip) {
    code[ip] * 256 + code[ip + 1]
}

// dump_escape 字符串转义（可读输出用）/ dump_escape escapes a string for readable output
fn dump_escape(s) {
    let mut parts = ["\""]
    let mut seg = 0
    let mut i = 0
    while i < str_len(s) {
        let c = char_at(s, i)
        let esc = if c == "\\" {
            "\\\\"
        } else if c == "\n" {
            "\\n"
        } else if c == "\t" {
            "\\t"
        } else if c == "\"" {
            "\\\""
        } else {
            ""
        }
        if esc != "" {
            push(parts, substr(s, seg, i - seg))
            push(parts, esc)
            seg = i + 1
        }
        i = i + 1
    }
    push(parts, substr(s, seg, str_len(s) - seg))
    push(parts, "\"")
    join(parts, "")
}

// dump_strs 打印字符串列表 / dump_strs prints a string list
fn dump_strs(xs) {
    let mut parts = []
    for x in xs {
        push(parts, dump_escape(x))
    }
    "[" + join(parts, " ") + "]"
}

// dump_bools 打印 bool 列表 / dump_bools prints a bool list
fn dump_bools(xs) {
    let mut parts = []
    for x in xs {
        push(parts, str(x))
    }
    "[" + join(parts, " ") + "]"
}

// dump_children 打印表头行，再按给定顺序递归子节点
// dump_children prints the header line, then recurses into the children in order
fn dump_children(pre, header, kids) {
    println(pre + header)
    for k in kids {
        dump_node(k, pre + "  ")
    }
}

// dump_node 美化打印 AST（调试用）/ dump_node pretty-prints an AST node (debugging)
pub fn dump_node(n, pre) {
    // AST 美化打印：按形态递归缩进
    // AST pretty-print: recursive, indented by shape
    let deeper = pre + "  "
    match n {
        frontend::Node::IntLit(v, sp) => println(pre + "IntLit " + str(v) + " " + dump_sp(sp)),
        frontend::Node::FloatLit(v, sp) => println(pre + "FloatLit " + str(v) + " " + dump_sp(sp)),
        frontend::Node::StrLit(v, sp) => println(pre + "StrLit " + dump_escape(v) + " " + dump_sp(sp)),
        frontend::Node::BoolLit(v, sp) => println(pre + "BoolLit " + str(v) + " " + dump_sp(sp)),
        frontend::Node::Ident(name, sp) => println(pre + "Ident " + dump_escape(name) + " " + dump_sp(sp)),
        frontend::Node::Unary(op, rhs, sp) => dump_children(pre, "Unary " + frontend::tok_names[op] + " " + dump_sp(sp), [rhs]),
        frontend::Node::Binary(op, lhs, rhs, sp) => dump_children(pre, "Binary " + frontend::tok_names[op] + " " + dump_sp(sp), [lhs, rhs]),
        frontend::Node::Logical(op, lhs, rhs, sp) => dump_children(pre, "Logical " + frontend::tok_names[op] + " " + dump_sp(sp), [lhs, rhs]),
        frontend::Node::Call(callee, cargs, sp) => dump_children(pre, "Call " + dump_sp(sp), concat([callee], cargs)),
        frontend::Node::Pipe(lhs, target, args, sp) => dump_children(pre, "Pipe " + dump_sp(sp), concat([lhs, target], args)),
        frontend::Node::Index(target, idx, sp) => dump_children(pre, "Index " + dump_sp(sp), [target, idx]),
        frontend::Node::ListLit(elems, sp) => dump_children(pre, "ListLit " + dump_sp(sp), elems),
        frontend::Node::FnLit(params, muts, pspans, param_tys, ret_ty, body, name, _, sp) => dump_fn_lit_node(pre, deeper, params, muts, pspans, param_tys, ret_ty, body, name, sp),
        frontend::Node::Block(stmts, sp) => dump_children(pre, "Block " + dump_sp(sp), stmts),
        frontend::Node::IfExpr(cond, then, els, sp) => dump_children(pre, "IfExpr " + dump_sp(sp), [cond, then, els]),
        frontend::Node::MatchExpr(scrut, arms, sp) => dump_children(pre, "MatchExpr " + dump_sp(sp), concat([scrut], arms)),
        frontend::Node::MatchArm(pat, guard, body, sp) => dump_children(pre, "MatchArm " + dump_sp(sp), [pat, guard, body]),
        frontend::Node::VariantAccess(en, vr, sp) => println(pre + "VariantAccess " + dump_escape(en) + " " + dump_escape(vr) + " " + dump_sp(sp)),
        frontend::Node::PkgAccess(pkg, name, sp) => println(pre + "PkgAccess " + dump_escape(pkg) + " " + dump_escape(name) + " " + dump_sp(sp)),
        frontend::Node::QualVariantAccess(pkg, en, vr, sp) => println(pre + "QualVariantAccess " + dump_escape(pkg) + " " + dump_escape(en) + " " + dump_escape(vr) + " " + dump_sp(sp)),
        frontend::Node::TryExpr(inner, sp) => dump_children(pre, "TryExpr " + dump_sp(sp), [inner]),
        frontend::Node::RecvExpr(ch, sp) => dump_children(pre, "RecvExpr " + dump_sp(sp), [ch]),
        frontend::Node::RecordLit(names, vals, sp) => dump_children(pre, "RecordLit " + dump_escape(join(names, ",")) + " " + dump_sp(sp), vals),
        frontend::Node::RecordUpdate(base, names, vals, sp) => dump_children(pre, "RecordUpdate " + dump_escape(join(names, ",")) + " " + dump_sp(sp), concat([base], vals)),
        frontend::Node::FieldAccess(base, field, sp) => dump_children(pre, "FieldAccess " + dump_escape(field) + " " + dump_sp(sp), [base]),
        frontend::Node::PatWildcard(sp) => println(pre + "PatWildcard " + dump_sp(sp)),
        frontend::Node::PatLiteral(v, sp) => dump_children(pre, "PatLiteral " + dump_sp(sp), [v]),
        frontend::Node::PatBinding(name, sp) => println(pre + "PatBinding " + dump_escape(name) + " " + dump_sp(sp)),
        frontend::Node::PatRecord(names, sp) => println(pre + "PatRecord " + dump_escape(join(names, ",")) + " " + dump_sp(sp)),
        frontend::Node::PatVariant(pkg, en, vr, binds, sp) => dump_children(pre, "PatVariant " + dump_escape(pkg) + " " + dump_escape(en) + " " + dump_escape(vr) + " " + dump_sp(sp), binds),
        frontend::Node::LetStmt(name, nsp, is_mut, is_pub, _, init, sp) => dump_children(pre, "LetStmt " + dump_escape(name) + " " + dump_sp(nsp) + " mut=" + str(is_mut) + " pub=" + str(is_pub) + " " + dump_sp(sp), [init]),
        frontend::Node::ConstDecl(name, nsp, is_pub, _, init, sp) => dump_children(pre, "ConstDecl " + dump_escape(name) + " " + dump_sp(nsp) + " pub=" + str(is_pub) + " " + dump_sp(sp), [init]),
        frontend::Node::AssignStmt(target, val, sp) => dump_children(pre, "AssignStmt " + dump_sp(sp), [target, val]),
        frontend::Node::ExprStmt(e, sp) => dump_children(pre, "ExprStmt " + dump_sp(sp), [e]),
        frontend::Node::WhileStmt(cond, body, sp) => dump_children(pre, "WhileStmt " + dump_sp(sp), [cond, body]),
        frontend::Node::ForStmt(v, vsp, _, _, iter, is_chan, body, sp) => dump_children(pre, "ForStmt " + dump_escape(v) + " " + dump_sp(vsp) + " chan=" + str(is_chan) + " " + dump_sp(sp), [iter, body]),
        frontend::Node::LabelStmt(lb, inner, sp) => dump_children(pre, "LabelStmt " + dump_escape(lb) + " " + dump_sp(sp), [inner]),
        frontend::Node::ReturnStmt(val, sp) => dump_children(pre, "ReturnStmt " + dump_sp(sp), [val]),
        frontend::Node::TETuple(ets, sp) => dump_children(pre, "TETuple " + dump_sp(sp), ets),
        frontend::Node::DestructLet(names, _, is_mut, init, sp) => dump_children(pre, "DestructLet " + dump_escape(join(names, ",")) + " mut=" + str(is_mut) + " " + dump_sp(sp), [init]),
        frontend::Node::TupleLit(elems, sp) => dump_children(pre, "TupleLit " + dump_sp(sp), elems),
        frontend::Node::MethodDecl(rt, name, nsp, lit, sp) => dump_children(pre, "MethodDecl " + dump_escape(rt) + "." + dump_escape(name) + " " + dump_sp(nsp) + " " + dump_sp(sp), [lit]),
        frontend::Node::FnDecl(name, nsp, is_pub, lit, sp) => dump_children(pre, "FnDecl " + dump_escape(name) + " " + dump_sp(nsp) + " pub=" + str(is_pub) + " " + dump_sp(sp), [lit]),
        frontend::Node::EnumDecl(name, params, variants, is_pub, sp) => dump_children(pre, "EnumDecl " + dump_escape(name) + " params=" + dump_strs(params) + " pub=" + str(is_pub) + " " + dump_sp(sp), variants),
        frontend::Node::EnumVariantDecl(name, arity, vtypes, _) => dump_children(pre, "EnumVariantDecl " + dump_escape(name) + " " + str(arity), vtypes),
        frontend::Node::ImportDecl(alias, asp, path, psp, sp) => println(pre + "ImportDecl " + dump_escape(alias) + " " + dump_sp(asp) + " " + dump_escape(path) + " " + dump_sp(psp) + " " + dump_sp(sp)),
        frontend::Node::SpawnStmt(call, sp) => dump_children(pre, "SpawnStmt " + dump_sp(sp), [call]),
        frontend::Node::DeferStmt(body, _, sp) => dump_children(pre, "DeferStmt " + dump_sp(sp), [body]),
        frontend::Node::TypeAliasDecl(name, te, is_pub, sp) => dump_children(pre, "TypeAliasDecl " + dump_escape(name) + " pub=" + str(is_pub) + " " + dump_sp(sp), [te]),
        frontend::Node::SelectStmt(arms, has_default, dflt, dsp, sp) => dump_children(pre, "SelectStmt default=" + str(has_default) + " " + dump_sp(dsp) + " " + dump_sp(sp), concat(arms, [dflt])),
        frontend::Node::SelectArm(is_send, bind, bsp, ch, val, body, sp) => dump_children(pre, "SelectArm send=" + str(is_send) + " " + dump_escape(bind) + " " + dump_sp(bsp) + " " + dump_sp(sp), [ch, val, body]),
        frontend::Node::SendStmt(ch, val, sp) => dump_children(pre, "SendStmt " + dump_sp(sp), [ch, val]),
        frontend::Node::BreakStmt(lb, sp) => println(pre + "BreakStmt " + dump_escape(lb) + " " + dump_sp(sp)),
        frontend::Node::ContinueStmt(lb, sp) => println(pre + "ContinueStmt " + dump_escape(lb) + " " + dump_sp(sp)),
        frontend::Node::TEName(pkg, name, constraint, targs, sp) => dump_children(pre, "TEName " + dump_escape(pkg) + " " + dump_escape(name) + " " + dump_escape(constraint) + " " + dump_sp(sp), targs),
        frontend::Node::TEList(elem, sp) => dump_children(pre, "TEList " + dump_sp(sp), [elem]),
        frontend::Node::TEFn(params, ret, sp) => dump_children(pre, "TEFn " + dump_sp(sp), concat(params, [ret])),
        frontend::Node::TERecord(fnames, ftypes, row, sp) => dump_children(pre, "TERecord " + dump_escape(join(fnames, ",")) + " " + dump_sp(sp), concat(ftypes, [row])),
        frontend::Node::NoNode => println(pre + "frontend.Node.NoNode"),
    }
}

fn dump_fn_lit_node(pre, deeper, params, muts, pspans, param_tys, ret_ty, body, name, sp) {
    println(pre + "FnLit " + dump_escape(name) + " params=" + dump_strs(params) + " muts=" + dump_bools(muts) + " pspans=" + dump_sps(pspans) + " " + dump_sp(sp))
    let mut i = 0
    while i < len(param_tys) {
        println(deeper + "ParamType " + str(i))
        dump_node(param_tys[i], deeper + "  ")
        i = i + 1
    }
    println(deeper + "ReturnType")
    dump_node(ret_ty, deeper + "  ")
    dump_node(body, deeper)
}

// pad_left 左侧补空格 / pad_left left-pads with spaces
fn pad_left(s, w) {
    let mut out = s
    while str_len(out) < w {
        out = " " + out
    }
    out
}

// pad_right 右侧补空格 / pad_right right-pads with spaces
fn pad_right(s, w) {
    let mut out = s
    while str_len(out) < w {
        out = out + " "
    }
    out
}

// pad_zero 零填充 / pad_zero zero-pads
fn pad_zero(n, w) {
    let mut out = str(n)
    while str_len(out) < w {
        out = "0" + out
    }
    out
}

// dump_sp 打印区间 / dump_sp prints a span
fn dump_sp(sp) {
    match sp {
        frontend::SpanT::Sp(s, e) => str(s) + ":" + str(e),
    }
}

// dump_sps 打印区间列表 / dump_sps prints a span list
fn dump_sps(xs) {
    let mut parts = []
    for x in xs {
        push(parts, dump_sp(x))
    }
    "[" + join(parts, " ") + "]"
}

// dump_token 打印 token / dump_token prints a token
pub fn dump_token(t) {
    match t {
        lib::Token::Tok(ty, lexeme, s, e) => frontend::tok_names[ty] + " " + str(s) + " " + str(e) + " " + dump_escape(lexeme),
    }
}
