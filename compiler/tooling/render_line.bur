// render_line.bur — 行/caret。
// render_line.bur — line/caret.


// carets 生成 n 个脱字符 / carets produces n carets
fn carets(n) {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + "^"
        i = i + 1
    }
    out
}

// line_text 取行文本 / line_text returns a line's text
fn line_text(src, starts, ln) {
    let s0 = starts[ln - 1]
    let e0 = if ln < len(starts) {
        starts[ln] - 1
    } else {
        str_len(src)
    }
    if e0 > s0 {
        substr(src, s0, e0 - s0)
    } else {
        ""
    }
}
