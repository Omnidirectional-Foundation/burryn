// compile_declare.bur — declare enum/local（CompileCtx）。
// compile_declare.bur — declare enum/local (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn declare_enum(mut en_qual, mut en_vnames, mut en_varities, mut en_prefix, mut enum_by, mut global_mut, qual, prefix, vnames, varities) {
    push(en_qual, qual)
    push(en_vnames, vnames)
    push(en_varities, varities)
    push(en_prefix, prefix)
    put(enum_by, qual, len(en_qual) - 1)
    put(global_mut, qual, false)
    len(en_qual) - 1
}

fn next_slot(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch) {
    let n = n_locals(ctx.c_l_name, ch)
    if n > 0 {
        ctx.c_l_slot[ch][n - 1] + 1 + (ctx.c_temps[ch] - ctx.c_l_tempsbelow[ch][n - 1])
    } else {
        ctx.c_temps[ch]
    }
}

fn declare_local(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, name, is_mut, sp) {
    let slot = next_slot(ctx, ch)
    if slot > 65534 {
        return frontend::perr("E2003", "", "too many locals", sp)
    }
    push_local(ctx, ch, name, ctx.c_scope_depth[ch], slot, is_mut, ctx.c_temps[ch])
    Ok(true)
}
