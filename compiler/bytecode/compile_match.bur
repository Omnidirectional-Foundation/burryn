// compile_match.bur — match 代码生成辅助（字段排序等；cp_match 主体后续再提）。
// compile_match.bur — match codegen helpers (field sort etc.; cp_match body follows later).

// field_sort_order 返回字段名按字典序排序后的下标排列 /
// field_sort_order returns field indices sorted by name (lexicographic)
fn field_sort_order(names) {
    let mut ord = []
    let mut oi = 0
    while oi < len(names) {
        push(ord, oi)
        oi = oi + 1
    }
    let mut k = 1
    while k < len(ord) {
        let key = ord[k]
        let mut j = k - 1
        while j >= 0 && names[ord[j]] > names[key] {
            ord[j + 1] = ord[j]
            j = j - 1
        }
        ord[j + 1] = key
        k = k + 1
    }
    ord
}
