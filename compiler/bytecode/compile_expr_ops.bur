// compile_expr_ops.bur — 一元/二元/逻辑表达式（CompileCtx）。
// compile_expr_ops.bur — unary/binary/logical exprs (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn cp_unary(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, op, rhs, sp, cp_expr) {
    match cp_expr(ch, rhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    emit(ctx, ch, if op == frontend::t_minus {
        lib::op_neg
    } else {
        lib::op_not
    }, sp)
    Ok(true)
}

fn cp_binary(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, op, lhs, rhs, sp, cp_expr) {
    match cp_expr(ch, lhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] + 1
    match cp_expr(ch, rhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] - 1
    let bop = if op == frontend::t_plus {
        lib::op_add
    } else if op == frontend::t_minus {
        lib::op_sub
    } else if op == frontend::t_star {
        lib::op_mul
    } else if op == frontend::t_slash {
        lib::op_div
    } else if op == frontend::t_percent {
        lib::op_mod
    } else if op == frontend::t_eq_eq {
        lib::op_eq
    } else if op == frontend::t_bang_eq {
        lib::op_neq
    } else if op == frontend::t_gt {
        lib::op_gt
    } else if op == frontend::t_gt_eq {
        lib::op_gt_eq
    } else if op == frontend::t_lt {
        lib::op_lt
    } else {
        lib::op_lt_eq
    }
    emit(ctx, ch, bop, sp)
    Ok(true)
}

fn cp_logical(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, op, lhs, rhs, sp, cp_expr) {
    match cp_expr(ch, lhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let end = emit_jump(ctx, ch, if op == frontend::t_and_and {
        lib::op_jump_if_false
    } else {
        lib::op_jump_if_true
    }, sp)
    emit(ctx, ch, lib::op_pop, sp)
    match cp_expr(ch, rhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    patch_jump(ctx, ch, end)
}
