// compile_for.bur — for 代码生成（CompileCtx）。
// compile_for.bur — for codegen (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

// cp_for for 代码生成 / cp_for codegens the for statement
fn cp_for(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, v, idx, iter, body, sp, cp_expr, cp_stmt) {
    begin_scope(ctx, ch)
    match cp_expr(ch, iter) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    match declare_local(ctx, ch, "(iter)", false, sp) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let iter_slot = ctx.c_l_slot[ch][n_locals(ctx.c_l_name, ch) - 1]
    emit_const(ctx, ch, lib::CVal::CInt(0), sp)
    match declare_local(ctx, ch, "(idx)", false, sp) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let idx_slot = ctx.c_l_slot[ch][n_locals(ctx.c_l_name, ch) - 1]

    push_loop(ctx, ch, next_slot(ctx, ch), -1)

    let cond_start = code_len(ctx, ch)
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, idx_slot, sp)
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, iter_slot, sp)
    emit(ctx, ch, lib::op_len, sp)
    emit(ctx, ch, lib::op_lt, sp)
    let exit_j = emit_jump(ctx, ch, lib::op_jump_if_false_pop, sp)

    begin_scope(ctx, ch)
    if idx != "" {
        emit(ctx, ch, lib::op_get_local, sp)
        emit_u16(ctx, ch, idx_slot, sp)
        match declare_local(ctx, ch, idx, false, sp) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, iter_slot, sp)
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, idx_slot, sp)
    emit(ctx, ch, lib::op_index_get, sp)
    match declare_local(ctx, ch, v, false, sp) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    match body {
        frontend::Node::Block(ss, _) => {
            for s in ss {
                match cp_stmt(ch, s) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
            }
        },
        _ => {},
    }
    end_scope(ctx, ch, sp)

    let li = len(ctx.c_lp_conts[ch]) - 1
    for j in ctx.c_lp_conts[ch][li] {
        match patch_jump(ctx, ch, j) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, idx_slot, sp)
    emit_const(ctx, ch, lib::CVal::CInt(1), sp)
    emit(ctx, ch, lib::op_add, sp)
    emit(ctx, ch, lib::op_set_local, sp)
    emit_u16(ctx, ch, idx_slot, sp)
    emit(ctx, ch, lib::op_pop, sp)
    match emit_loop(ctx, ch, cond_start, sp) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }

    match patch_jump(ctx, ch, exit_j) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    for j in ctx.c_lp_breaks[ch][li] {
        match patch_jump(ctx, ch, j) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    pop_loop(ctx, ch)
    end_scope(ctx, ch, sp)
    Ok(true)
}
