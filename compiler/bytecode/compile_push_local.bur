// compile_push_local.bur — push/pop/n_locals（CompileCtx）。
// compile_push_local.bur — push/pop/n_locals (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

// push_local 压入局部变量记录 / push_local records a local
fn push_local(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, name, depth, slot, is_mut, tempsbelow) {
    push(ctx.c_l_name[ch], name)
    push(ctx.c_l_depth[ch], depth)
    push(ctx.c_l_slot[ch], slot)
    push(ctx.c_l_mut[ch], is_mut)
    push(ctx.c_l_captured[ch], false)
    push(ctx.c_l_tempsbelow[ch], tempsbelow)
}

// pop_local 弹出局部变量记录 / pop_local removes a local
fn pop_local(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch) {
    let _ = pop(ctx.c_l_name[ch])
    let _ = pop(ctx.c_l_depth[ch])
    let _ = pop(ctx.c_l_slot[ch])
    let _ = pop(ctx.c_l_mut[ch])
    let _ = pop(ctx.c_l_captured[ch])
    let _ = pop(ctx.c_l_tempsbelow[ch])
}

// n_locals 取局部变量数 / n_locals counts locals
fn n_locals(c_l_name, ch) {
    len(c_l_name[ch])
}
