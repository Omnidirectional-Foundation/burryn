// compile_frame.bur — 函数/编译器帧（CompileCtx）。
// compile_frame.bur — function/compiler frame (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn new_func(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, name, file, arity) {
    println("DEBUG new_func ctx: " + str(ctx))
    push(ctx.f_name, name)
    push(ctx.f_file, file)
    push(ctx.f_arity, arity)
    push(ctx.f_nupvals, 0)
    push(ctx.f_code, [])
    push(ctx.f_spans, [])
    push(ctx.f_consts, [])
    len(ctx.f_name) - 1
}

fn new_compiler(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, enc, fh) {
    push(ctx.c_enclosing, enc)
    push(ctx.c_fn, fh)
    push(ctx.c_scope_depth, 0)
    push(ctx.c_temps, 0)
    push(ctx.c_l_name, [])
    push(ctx.c_l_depth, [])
    push(ctx.c_l_slot, [])
    push(ctx.c_l_mut, [])
    push(ctx.c_l_captured, [])
    push(ctx.c_l_tempsbelow, [])
    push(ctx.c_u_index, [])
    push(ctx.c_u_islocal, [])
    push(ctx.c_u_mut, [])
    push(ctx.c_u_name, [])
    push(ctx.c_lp_base, [])
    push(ctx.c_lp_contto, [])
    push(ctx.c_lp_breaks, [])
    push(ctx.c_lp_conts, [])
    push(ctx.c_lp_labels, [])
    push(ctx.c_lbl_pending, "")
    len(ctx.c_fn) - 1
}
