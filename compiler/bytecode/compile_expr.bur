// compile_expr.bur — 表达式代码生成（标识符等；cp_expr 主体后续再提）。
// compile_expr.bur — expression codegen (idents first; cp_expr body follows later).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn cp_ident(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, en_varities, en_vnames, en_qual, en_prefix, enum_by, global_mut, pkg_decls, cur_pkg, ch, name, sp) {
    let li = resolve_local(ctx.c_l_name, ctx.c_l_slot, ch, name)
    if li >= 0 {
        emit(ctx, ch, lib::op_get_local, sp)
        emit_u16(ctx, ch, ctx.c_l_slot[ch][li], sp)
        return Ok(true)
    }
    let ui = match resolve_upvalue(ctx, ch, name, sp) {
        Ok(v) => v,
        Err(d) => {
            return Err(d)
            0
        },
    }
    if ui >= 0 {
        emit(ctx, ch, lib::op_get_upval, sp)
        emit_u16(ctx, ch, ui, sp)
        return Ok(true)
    }
    let gname = mangle_if_decl(pkg_decls, cur_pkg, name)
    let declared = match get(global_mut, gname) {
        Some(_) => true,
        None => false,
    }
    if !declared {
        let fv = find_variant(enum_by, en_prefix, en_vnames, cur_pkg, name)
        if fv[0] == -2 {
            return frontend::perr("E2014", "qualify it as Enum." + name, "variant \"" + name + "\" exists in several enums", sp)
        }
        if fv[1] >= 0 {
            emit_variant(ctx, en_varities, ch, fv[0], fv[1], sp)
            return Ok(true)
        }
    }
    let idx = add_const(ctx, ch, lib::CVal::CStr(gname))
    emit(ctx, ch, lib::op_get_global, sp)
    emit_u16(ctx, ch, idx, sp)
    Ok(true)
}
