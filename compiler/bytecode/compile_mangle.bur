// compile_mangle.bur — mangle。
// compile_mangle.bur — mangle.


// mangle_if_decl 对已声明名字做改写 / mangle_if_decl mangles declared names
fn mangle_if_decl(pkg_decls, cur_pkg, name) {
    let hit = match get(pkg_decls, name) {
        Some(_) => true,
        None => false,
    }
    if hit {
        qualify(cur_pkg, name)
    } else {
        name
    }
}
