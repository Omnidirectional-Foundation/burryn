// compile_loop.bur — 循环压栈/弹栈（CompileCtx）。
// compile_loop.bur — loop push/pop (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn push_loop(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, base, cont_to) {
    push(ctx.c_lp_base[ch], base)
    push(ctx.c_lp_contto[ch], cont_to)
    push(ctx.c_lp_breaks[ch], [])
    push(ctx.c_lp_conts[ch], [])
    push(ctx.c_lp_labels[ch], ctx.c_lbl_pending[ch])
}

fn pop_loop(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch) {
    let _ = pop(ctx.c_lp_base[ch])
    let _ = pop(ctx.c_lp_contto[ch])
    let _ = pop(ctx.c_lp_breaks[ch])
    let _ = pop(ctx.c_lp_conts[ch])
    let _ = pop(ctx.c_lp_labels[ch])
}
