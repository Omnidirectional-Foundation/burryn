// compile_if.bur — if 代码生成（CompileCtx）。
// compile_if.bur — if codegen (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn cp_if(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cond, then, els, sp, cp_expr, cp_stmt) {
    match cp_expr(ch, cond) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let else_j = emit_jump(ctx, ch, lib::op_jump_if_false_pop, sp)
    match cp_block_expr(ctx, ch, then, cp_expr, cp_stmt) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let end_j = emit_jump(ctx, ch, lib::op_jump, sp)
    match patch_jump(ctx, ch, else_j) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    match els {
        frontend::Node::NoNode => emit(ctx, ch, lib::op_unit, sp),
        frontend::Node::Block(_, _) => {
            match cp_block_expr(ctx, ch, els, cp_expr, cp_stmt) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
        },
        frontend::Node::IfExpr(c2, t2, e2, sp2) => {
            match cp_if(ctx, ch, c2, t2, e2, sp2, cp_expr, cp_stmt) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
        },
        _ => {
            return frontend::perr("E2018", "", "invalid else branch", sp)
        },
    }
    patch_jump(ctx, ch, end_j)
}
