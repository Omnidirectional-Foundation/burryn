// compile_if.bur — if 代码生成（CompileCtx）。
// compile_if.bur — if codegen (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn cp_if(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cond, then, els, sp, cp_expr, cp_stmt) {
    let mut cur_cond = cond
    let mut cur_then = then
    let mut cur_els = els
    let mut cur_sp = sp
    let mut pending_ends = []
    let mut first = true
    while true {
        match cp_expr(ch, cur_cond) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        let else_j = emit_jump(ctx, ch, lib::op_jump_if_false_pop, cur_sp)
        match cp_block_expr(ctx, ch, cur_then, cp_expr, cp_stmt) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        let end_j = emit_jump(ctx, ch, lib::op_jump, cur_sp)
        match patch_jump(ctx, ch, else_j) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        push(pending_ends, end_j)
        match cur_els {
            frontend::Node::NoNode => {
                emit(ctx, ch, lib::op_unit, cur_sp)
                break
            },
            frontend::Node::Block(_, _) => {
                match cp_block_expr(ctx, ch, cur_els, cp_expr, cp_stmt) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                break
            },
            frontend::Node::IfExpr(c2, t2, e2, sp2) => {
                cur_cond = c2
                cur_then = t2
                cur_els = e2
                cur_sp = sp2
                continue
            },
            _ => {
                return frontend::perr("E2018", "", "invalid else branch", cur_sp)
            },
        }
    }
    for ej in pending_ends {
        match patch_jump(ctx, ch, ej) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    Ok(true)
}
