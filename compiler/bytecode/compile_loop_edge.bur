// compile_loop_edge.bur — labeled/unwind（CompileCtx）。
// compile_loop_edge.bur — labeled/unwind (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn labeled_loop(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, lb, sp) {
    let mut li = len(ctx.c_lp_labels[ch]) - 1
    while li >= 0 {
        if ctx.c_lp_labels[ch][li] == lb {
            let base = ctx.c_lp_base[ch][li]
            let mut i = n_locals(ctx.c_l_name, ch) - 1
            while i >= 0 && ctx.c_l_slot[ch][i] >= base {
                if ctx.c_l_captured[ch][i] {
                    emit(ctx, ch, lib::op_close_upvalue, sp)
                } else {
                    emit(ctx, ch, lib::op_pop, sp)
                }
                i = i - 1
            }
            return Ok(li)
        }
        li = li - 1
    }
    frontend::perr("E2018", "", "no loop labeled `" + lb + "` in scope", sp)
}

fn unwind_to_loop(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, sp) {
    if len(ctx.c_lp_base[ch]) == 0 {
        return frontend::perr("E2013", "", "break/continue outside of a loop", sp)
    }
    let li = len(ctx.c_lp_base[ch]) - 1
    let base = ctx.c_lp_base[ch][li]
    let mut i = n_locals(ctx.c_l_name, ch) - 1
    while i >= 0 && ctx.c_l_slot[ch][i] >= base {
        if ctx.c_l_captured[ch][i] {
            emit(ctx, ch, lib::op_close_upvalue, sp)
        } else {
            emit(ctx, ch, lib::op_pop, sp)
        }
        i = i - 1
    }
    Ok(li)
}
