fn cp_record_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, names, vals, sp, cp_expr) {
    let ord = field_sort_order(names)
    for k in ord {
        match cp_expr(ch, vals[k]) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    let mut enc = ""
    for k in ord {
        enc = enc + names[k] + "\n"
    }
    let cidx = add_const(ctx, ch, lib::CVal::CStr(enc))
    emit(ctx, ch, lib::op_record, sp)
    emit(ctx, ch, len(names), sp)
    emit_u16(ctx, ch, cidx, sp)
    Ok(true)
}

fn cp_record_update(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, base, names, vals, sp, cp_expr) {
    match cp_expr(ch, base) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let ord = field_sort_order(names)
    for k in ord {
        match cp_expr(ch, vals[k]) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    let mut enc = ""
    for k in ord {
        enc = enc + names[k] + "\n"
    }
    let cidx = add_const(ctx, ch, lib::CVal::CStr(enc))
    emit(ctx, ch, lib::op_record_update, sp)
    emit(ctx, ch, len(names), sp)
    emit_u16(ctx, ch, cidx, sp)
    Ok(true)
}

fn cp_field_access(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, base, field, sp, cp_expr) {
    match cp_expr(ch, base) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let cidx = add_const(ctx, ch, lib::CVal::CStr(field))
    emit(ctx, ch, lib::op_get_field_name, sp)
    emit_u16(ctx, ch, cidx, sp)
    Ok(true)
}

fn cp_call(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, method_calls, cur_file, ch, callee, cargs, sp, cp_expr) {
    let mut m_obj = frontend::Node::NoNode
    let mpath = match callee {
        frontend::Node::FieldAccess(obj, _, _) => {
            m_obj = obj
            let cend = match sp {
                frontend::SpanT::Sp(_, ce) => ce,
            }
            match get(method_calls, cur_file + ":" + str(cend)) {
                Some(p) => Some(p),
                None => None,
            }
        },
        _ => None,
    }
    match mpath {
        Some(p) => {
            let gidx = add_const(ctx, ch, lib::CVal::CStr(p))
            emit(ctx, ch, lib::op_get_global, sp)
            emit_u16(ctx, ch, gidx, sp)
            match cp_expr(ch, m_obj) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            for a in cargs {
                match cp_expr(ch, a) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] - (len(cargs) + 1)
            if len(cargs) + 1 > 255 {
                return frontend::perr("E2005", "", "too many arguments", sp)
            }
            emit(ctx, ch, lib::op_call, sp)
            emit(ctx, ch, len(cargs) + 1, sp)
            Ok(true)
        },
        None => {
            match cp_expr(ch, callee) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            for a in cargs {
                match cp_expr(ch, a) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] - (len(cargs) + 1)
            if len(cargs) > 255 {
                return frontend::perr("E2005", "", "too many arguments", sp)
            }
            emit(ctx, ch, lib::op_call, sp)
            emit(ctx, ch, len(cargs), sp)
            Ok(true)
        },
    }
}

fn cp_index(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, target, idx, sp, cp_expr) {
    match cp_expr(ch, target) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] + 1
    match cp_expr(ch, idx) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] - 1
    emit(ctx, ch, lib::op_index_get, sp)
    Ok(true)
}

fn cp_tuple_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, elems, sp, cp_expr) {
    for el in elems {
        match cp_expr(ch, el) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        ctx.c_temps[ch] = ctx.c_temps[ch] + 1
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] - len(elems)
    if len(elems) > 255 {
        return frontend::perr("E2006", "", "tuple literal too large", sp)
    }
    emit(ctx, ch, lib::op_tuple, sp)
    emit(ctx, ch, len(elems), sp)
    Ok(true)
}

fn cp_list_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, elems, sp, cp_expr) {
    for el in elems {
        match cp_expr(ch, el) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        ctx.c_temps[ch] = ctx.c_temps[ch] + 1
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] - len(elems)
    if len(elems) > 65535 {
        return frontend::perr("E2006", "", "list literal too large", sp)
    }
    emit(ctx, ch, lib::op_list, sp)
    emit_u16(ctx, ch, len(elems), sp)
    Ok(true)
}

fn cp_int_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, v, sp) {
    emit_const(ctx, ch, lib::CVal::CInt(v), sp)
    Ok(true)
}

fn cp_float_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, v, sp) {
    emit_const(ctx, ch, lib::CVal::CFloat(v), sp)
    Ok(true)
}

fn cp_str_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, v, sp) {
    emit_const(ctx, ch, lib::CVal::CStr(v), sp)
    Ok(true)
}

fn cp_bool_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, v, sp) {
    emit(ctx, ch, if v {
        lib::op_true
    } else {
        lib::op_false
    }, sp)
    Ok(true)
}

fn cp_unary(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, op, rhs, sp, cp_expr) {
    match cp_expr(ch, rhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    emit(ctx, ch, if op == frontend::t_minus {
        lib::op_neg
    } else {
        lib::op_not
    }, sp)
    Ok(true)
}

fn cp_binary(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, op, lhs, rhs, sp, cp_expr) {
    match cp_expr(ch, lhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] + 1
    match cp_expr(ch, rhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] - 1
    let bop = if op == frontend::t_plus {
        lib::op_add
    } else if op == frontend::t_minus {
        lib::op_sub
    } else if op == frontend::t_star {
        lib::op_mul
    } else if op == frontend::t_slash {
        lib::op_div
    } else if op == frontend::t_percent {
        lib::op_mod
    } else if op == frontend::t_eq_eq {
        lib::op_eq
    } else if op == frontend::t_bang_eq {
        lib::op_neq
    } else if op == frontend::t_gt {
        lib::op_gt
    } else if op == frontend::t_gt_eq {
        lib::op_gt_eq
    } else if op == frontend::t_lt {
        lib::op_lt
    } else {
        lib::op_lt_eq
    }
    emit(ctx, ch, bop, sp)
    Ok(true)
}

fn cp_logical(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, op, lhs, rhs, sp, cp_expr) {
    match cp_expr(ch, lhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let end = emit_jump(ctx, ch, if op == frontend::t_and_and {
        lib::op_jump_if_false
    } else {
        lib::op_jump_if_true
    }, sp)
    emit(ctx, ch, lib::op_pop, sp)
    match cp_expr(ch, rhs) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    patch_jump(ctx, ch, end)
}

// cp_for for 代码生成 / cp_for codegens the for statement
fn cp_for(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, v, idx, iter, body, sp, cp_expr, cp_stmt) {
    begin_scope(ctx, ch)
    match cp_expr(ch, iter) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    declare_local(ctx, ch, "(iter)", false, sp)?
    let iter_slot = ctx.c_l_slot[ch][n_locals(ctx.c_l_name, ch) - 1]
    emit_const(ctx, ch, lib::CVal::CInt(0), sp)
    declare_local(ctx, ch, "(idx)", false, sp)?
    let idx_slot = ctx.c_l_slot[ch][n_locals(ctx.c_l_name, ch) - 1]

    push_loop(ctx, ch, next_slot(ctx, ch), -1)

    let cond_start = code_len(ctx, ch)
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, idx_slot, sp)
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, iter_slot, sp)
    emit(ctx, ch, lib::op_len, sp)
    emit(ctx, ch, lib::op_lt, sp)
    let exit_j = emit_jump(ctx, ch, lib::op_jump_if_false_pop, sp)

    begin_scope(ctx, ch)
    if idx != "" {
        emit(ctx, ch, lib::op_get_local, sp)
        emit_u16(ctx, ch, idx_slot, sp)
        let _ = declare_local(ctx, ch, idx, false, sp)?
    }
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, iter_slot, sp)
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, idx_slot, sp)
    emit(ctx, ch, lib::op_index_get, sp)
    declare_local(ctx, ch, v, false, sp)?
    match body {
        frontend::Node::Block(ss, _) => {
            for s in ss {
                match cp_stmt(ch, s) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
            }
        },
        _ => {},
    }
    end_scope(ctx, ch, sp)

    let li = len(ctx.c_lp_conts[ch]) - 1
    for j in ctx.c_lp_conts[ch][li] {
        let _ = patch_jump(ctx, ch, j)?
    }
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, idx_slot, sp)
    emit_const(ctx, ch, lib::CVal::CInt(1), sp)
    emit(ctx, ch, lib::op_add, sp)
    emit(ctx, ch, lib::op_set_local, sp)
    emit_u16(ctx, ch, idx_slot, sp)
    emit(ctx, ch, lib::op_pop, sp)
    emit_loop(ctx, ch, cond_start, sp)?

    patch_jump(ctx, ch, exit_j)?
    for j in ctx.c_lp_breaks[ch][li] {
        let _ = patch_jump(ctx, ch, j)?
    }
    pop_loop(ctx, ch)
    end_scope(ctx, ch, sp)
    Ok(true)
}

fn cp_for_chan(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, v, iter, body, sp, cp_expr, cp_stmt) {
    begin_scope(ctx, ch)
    match cp_expr(ch, iter) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    declare_local(ctx, ch, "(chan)", false, sp)?
    let chan_slot = ctx.c_l_slot[ch][n_locals(ctx.c_l_name, ch) - 1]

    let cond_start = code_len(ctx, ch)
    push_loop(ctx, ch, next_slot(ctx, ch), cond_start)

    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, chan_slot, sp)
    let exit_j = emit_jump(ctx, ch, lib::op_chan_next, sp)

    begin_scope(ctx, ch)
    declare_local(ctx, ch, v, false, sp)?
    match body {
        frontend::Node::Block(ss, _) => {
            for s in ss {
                match cp_stmt(ch, s) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
            }
        },
        _ => {},
    }
    end_scope(ctx, ch, sp)

    emit_loop(ctx, ch, cond_start, sp)?

    patch_jump(ctx, ch, exit_j)?
    let li = len(ctx.c_lp_breaks[ch]) - 1
    for j in ctx.c_lp_breaks[ch][li] {
        let _ = patch_jump(ctx, ch, j)?
    }
    pop_loop(ctx, ch)
    end_scope(ctx, ch, sp)
    Ok(true)
}

fn new_func(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, name, file, arity) {
    push(ctx.f_name, name)
    push(ctx.f_file, file)
    push(ctx.f_arity, arity)
    push(ctx.f_nupvals, 0)
    push(ctx.f_code, [])
    push(ctx.f_spans, [])
    push(ctx.f_consts, [])
    len(ctx.f_name) - 1
}

fn new_compiler(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, enc, fh) {
    push(ctx.c_enclosing, enc)
    push(ctx.c_fn, fh)
    push(ctx.c_scope_depth, 0)
    push(ctx.c_temps, 0)
    push(ctx.c_l_name, [])
    push(ctx.c_l_depth, [])
    push(ctx.c_l_slot, [])
    push(ctx.c_l_mut, [])
    push(ctx.c_l_captured, [])
    push(ctx.c_l_tempsbelow, [])
    push(ctx.c_u_index, [])
    push(ctx.c_u_islocal, [])
    push(ctx.c_u_mut, [])
    push(ctx.c_u_name, [])
    push(ctx.c_lp_base, [])
    push(ctx.c_lp_contto, [])
    push(ctx.c_lp_breaks, [])
    push(ctx.c_lp_conts, [])
    push(ctx.c_lp_labels, [])
    push(ctx.c_lbl_pending, "")
    len(ctx.c_fn) - 1
}

fn cp_function(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, cur_file, ch, lit, cp_expr, cp_stmt) {
    match lit {
        frontend::Node::FnLit(params, muts, _, _, _, body, name, crefs, lsp) => {
            let fh = new_func(ctx, name, cur_file, len(params))
            let sub = new_compiler(ctx, ch, fh)
            begin_scope(ctx, sub)
            push_local(ctx, sub, name, ctx.c_scope_depth[sub], 0, false, 0)
            if len(params) > 255 {
                return frontend::perr("E2019", "", "too many parameters", lsp)
            }
            let mut seen = map()
            let mut i = 0
            while i < len(params) {
                let dup = match get(seen, params[i]) {
                    Some(_) => true,
                    None => false,
                }
                if dup {
                    return frontend::perr("E2020", "", "duplicate parameter \"" + params[i] + "\"", lsp)
                }
                put(seen, params[i], true)
                push_local(ctx, sub, params[i], ctx.c_scope_depth[sub], ctx.c_l_slot[sub][n_locals(ctx.c_l_name, sub) - 1] + 1, muts[i], 0)
                i = i + 1
            }
            cp_block_expr(ctx, sub, body, cp_expr, cp_stmt)?
            emit(ctx, sub, lib::op_return, lsp)

            let idx = add_const(ctx, ch, lib::CVal::CFn(fh))
            emit(ctx, ch, lib::op_closure, lsp)
            emit_u16(ctx, ch, idx, lsp)
            let mut u = 0
            while u < len(ctx.c_u_index[sub]) {
                let mut flag = 0
                if ctx.c_u_islocal[sub][u] {
                    flag = flag + 1
                }
                let mut ri = 0
                while ri < len(crefs) {
                    if ctx.c_u_name[sub][u] == crefs[ri] {
                        flag = flag + 2
                    }
                    ri = ri + 1
                }
                emit(ctx, ch, flag, lsp)
                emit_u16(ctx, ch, ctx.c_u_index[sub][u], lsp)
                u = u + 1
            }
            Ok(true)
        },
        _ => Ok(true),
    }
}

// define_global 定义全局变量 / define_global defines a global
fn define_global(emit_ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, mut global_mut, _c_fn, enum_by, cur_pkg, ch, name, is_mut, sp) {
    let qual = qualify(cur_pkg, name)
    let exists = match get(global_mut, qual) {
        Some(_) => true,
        None => false,
    }
    if exists {
        let is_enum = match get(enum_by, qual) {
            Some(_) => true,
            None => false,
        }
        if is_enum {
            return frontend::perr("E2007", "", "cannot redeclare enum \"" + name + "\"", sp)
        }
    }
    put(global_mut, qual, is_mut)
    let idx = add_const(emit_ctx, ch, lib::CVal::CStr(qual))
    emit(emit_ctx, ch, lib::op_def_global, sp)
    emit_u16(emit_ctx, ch, idx, sp)
    Ok(true)
}

// register_enum_decl 注册枚举声明 / register_enum_decl registers an enum declaration
fn register_enum_decl(mut en_qual, mut en_vnames, mut en_varities, mut en_prefix, mut enum_by, mut global_mut, cur_pkg, _ch, name, variants, sp) {
    let qual = qualify(cur_pkg, name)
    let exists = match get(enum_by, qual) {
        Some(_) => true,
        None => false,
    }
    if exists {
        return frontend::perr("E2007", "", "enum \"" + name + "\" is already declared", sp)
    }
    let mut seen = map()
    let mut vnames = []
    let mut varities = []
    for vd in variants {
        match vd {
            frontend::Node::EnumVariantDecl(vn, arity, _, _) => {
                let dup = match get(seen, vn) {
                    Some(_) => true,
                    None => false,
                }
                if dup {
                    return frontend::perr("E2009", "", "duplicate variant \"" + vn + "\" in enum \"" + name + "\"", sp)
                }
                put(seen, vn, true)
                push(vnames, vn)
                push(varities, arity)
            },
            _ => {},
        }
    }
    Ok(declare_enum(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, qual, cur_pkg, vnames, varities))
}

fn cp_if(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cond, then, els, sp, cp_expr, cp_stmt) {
    let mut cur_cond = cond
    let mut cur_then = then
    let mut cur_els = els
    let mut cur_sp = sp
    let mut pending_ends = []
    while true {
        match cp_expr(ch, cur_cond) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        let else_j = emit_jump(ctx, ch, lib::op_jump_if_false_pop, cur_sp)
        cp_block_expr(ctx, ch, cur_then, cp_expr, cp_stmt)?
        let end_j = emit_jump(ctx, ch, lib::op_jump, cur_sp)
        patch_jump(ctx, ch, else_j)?
        push(pending_ends, end_j)
        match cur_els {
            frontend::Node::NoNode => {
                emit(ctx, ch, lib::op_unit, cur_sp)
                break
            },
            frontend::Node::Block(_, _) => {
                cp_block_expr(ctx, ch, cur_els, cp_expr, cp_stmt)?
                break
            },
            frontend::Node::IfExpr(c2, t2, e2, sp2) => {
                cur_cond = c2
                cur_then = t2
                cur_els = e2
                cur_sp = sp2
                continue
            },
            _ => {
                return frontend::perr("E2018", "", "invalid else branch", cur_sp)
            },
        }
    }
    for ej in pending_ends {
        let _ = patch_jump(ctx, ch, ej)?
    }
    Ok(true)
}

fn push_loop(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, base, cont_to) {
    push(ctx.c_lp_base[ch], base)
    push(ctx.c_lp_contto[ch], cont_to)
    push(ctx.c_lp_breaks[ch], [])
    push(ctx.c_lp_conts[ch], [])
    push(ctx.c_lp_labels[ch], ctx.c_lbl_pending[ch])
}

fn pop_loop(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch) {
    let _ = pop(ctx.c_lp_base[ch])
    let _ = pop(ctx.c_lp_contto[ch])
    let _ = pop(ctx.c_lp_breaks[ch])
    let _ = pop(ctx.c_lp_conts[ch])
    let _ = pop(ctx.c_lp_labels[ch])
}

fn labeled_loop(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, lb, sp) {
    let mut li = len(ctx.c_lp_labels[ch]) - 1
    while li >= 0 {
        if ctx.c_lp_labels[ch][li] == lb {
            let base = ctx.c_lp_base[ch][li]
            let mut i = n_locals(ctx.c_l_name, ch) - 1
            while i >= 0 && ctx.c_l_slot[ch][i] >= base {
                if ctx.c_l_captured[ch][i] {
                    emit(ctx, ch, lib::op_close_upvalue, sp)
                } else {
                    emit(ctx, ch, lib::op_pop, sp)
                }
                i = i - 1
            }
            return Ok(li)
        }
        li = li - 1
    }
    frontend::perr("E2018", "", "no loop labeled `" + lb + "` in scope", sp)
}

fn unwind_to_loop(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, sp) {
    if len(ctx.c_lp_base[ch]) == 0 {
        return frontend::perr("E2013", "", "break/continue outside of a loop", sp)
    }
    let li = len(ctx.c_lp_base[ch]) - 1
    let base = ctx.c_lp_base[ch][li]
    let mut i = n_locals(ctx.c_l_name, ch) - 1
    while i >= 0 && ctx.c_l_slot[ch][i] >= base {
        if ctx.c_l_captured[ch][i] {
            emit(ctx, ch, lib::op_close_upvalue, sp)
        } else {
            emit(ctx, ch, lib::op_pop, sp)
        }
        i = i - 1
    }
    Ok(li)
}

// mangle_if_decl 对已声明名字做改写 / mangle_if_decl mangles declared names
fn mangle_if_decl(pkg_decls, cur_pkg, name) {
    let hit = match get(pkg_decls, name) {
        Some(_) => true,
        None => false,
    }
    if hit {
        qualify(cur_pkg, name)
    } else {
        name
    }
}

// field_sort_order 返回字段名按字典序排序后的下标排列 /
// field_sort_order returns field indices sorted by name (lexicographic)
fn field_sort_order(names) {
    let mut ord = []
    let mut oi = 0
    while oi < len(names) {
        push(ord, oi)
        oi = oi + 1
    }
    let mut k = 1
    while k < len(ord) {
        let key = ord[k]
        let mut j = k - 1
        while j >= 0 && names[ord[j]] > names[key] {
            ord[j + 1] = ord[j]
            j = j - 1
        }
        ord[j + 1] = key
        k = k + 1
    }
    ord
}

// cp_match match 代码生成：变体测试（枚举身份 + tag）与字段提取，无哈希、无反射
// cp_match codegens match: variant tests (enum identity + tag) and field
// extraction, no hashing, no reflection
fn cp_match(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, enum_by, en_prefix, en_vnames, en_varities, cur_pkg, cur_aliases, ch, scrut, arms, msp, cp_expr) {
    begin_scope(ctx, ch)
    match cp_expr(ch, scrut) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    declare_local(ctx, ch, "(match)", false, msp)?
    let scrut_slot = ctx.c_l_slot[ch][n_locals(ctx.c_l_name, ch) - 1]

    let mut end_jumps = []
    for arm in arms {
        match arm {
            frontend::Node::MatchArm(pat, guard, body, asp) => {
                let mut fail_j = -1
                let mut guard_fail_j = -1
                begin_scope(ctx, ch)
                let mut arm_locals = 0

                match pat {
                    frontend::Node::PatWildcard(_) => {},
                    frontend::Node::PatLiteral(v, _) => {
                        emit(ctx, ch, lib::op_get_local, asp)
                        emit_u16(ctx, ch, scrut_slot, asp)
                        ctx.c_temps[ch] = ctx.c_temps[ch] + 1
                        match cp_expr(ch, v) {
                            Ok(_) => {},
                            Err(d) => {
                                return Err(d)
                            },
                        }
                        ctx.c_temps[ch] = ctx.c_temps[ch] - 1
                        emit(ctx, ch, lib::op_eq, asp)
                        fail_j = emit_jump(ctx, ch, lib::op_jump_if_false_pop, asp)
                    },
                    frontend::Node::PatBinding(name, _) => {
                        let fv = find_variant(enum_by, en_prefix, en_vnames, cur_pkg, name)
                        if fv[0] == -2 {
                            return frontend::perr("E2014", "qualify it as Enum." + name, "variant \"" + name + "\" exists in several enums", asp)
                        } else if fv[1] >= 0 && en_varities[fv[0]][fv[1]] == 0 {
                            fail_j = emit_variant_test(ctx, ch, fv[0], fv[1], scrut_slot, asp)?
                        } else if fv[1] >= 0 {
                            return frontend::perr("E2017", "bind them: " + name + "(...)", "variant \"" + name + "\" has " + str(en_varities[fv[0]][fv[1]]) + " field(s)", asp)
                        } else {
                            emit(ctx, ch, lib::op_get_local, asp)
                            emit_u16(ctx, ch, scrut_slot, asp)
                            declare_local(ctx, ch, name, false, asp)?
                            arm_locals = arm_locals + 1
                        }
                    },
                    frontend::Node::PatVariant(ppkg, penum, pvar, binds, _) => {
                        let mut eh = -1
                        let mut idx = -1
                        if ppkg != "" {
                            let apath = alias_path(cur_aliases, ppkg)
                            let full = if apath != "" {
                                apath + "." + penum
                            } else {
                                ppkg + "." + penum
                            }
                            eh = match get(enum_by, full) {
                                Some(h) => h,
                                None => -1,
                            }
                            if eh < 0 {
                                return frontend::perr("E2015", "", "unknown enum \"" + full + "\"", asp)
                            }
                            let mut i = 0
                            while i < len(en_vnames[eh]) {
                                if en_vnames[eh][i] == pvar {
                                    idx = i
                                }
                                i = i + 1
                            }
                            if idx < 0 {
                                return frontend::perr("E2016", "", "enum \"" + full + "\" has no variant \"" + pvar + "\"", asp)
                            }
                        } else if penum != "" {
                            eh = local_enum(enum_by, en_prefix, cur_pkg, penum)
                            if eh < 0 {
                                return frontend::perr("E2015", "", "unknown enum \"" + penum + "\"", asp)
                            }
                            let mut i = 0
                            while i < len(en_vnames[eh]) {
                                if en_vnames[eh][i] == pvar {
                                    idx = i
                                }
                                i = i + 1
                            }
                            if idx < 0 {
                                return frontend::perr("E2016", "", "enum \"" + penum + "\" has no variant \"" + pvar + "\"", asp)
                            }
                        } else {
                            let fv = find_variant(enum_by, en_prefix, en_vnames, cur_pkg, pvar)
                            if fv[0] == -2 {
                                return frontend::perr("E2014", "qualify it as Enum." + pvar, "variant \"" + pvar + "\" exists in several enums", asp)
                            }
                            if fv[1] < 0 {
                                return frontend::perr("E2016", "", "unknown variant \"" + pvar + "\"", asp)
                            }
                            eh = fv[0]
                            idx = fv[1]
                        }
                        let arity = en_varities[eh][idx]
                        if len(binds) != arity {
                            return frontend::perr("E2017", "", "variant " + pvar + " has " + str(arity) + " field(s), pattern binds " + str(len(binds)), asp)
                        }
                        fail_j = emit_variant_test(ctx, ch, eh, idx, scrut_slot, asp)?
                        let mut i = 0
                        while i < len(binds) {
                            let bname = match binds[i] {
                                frontend::Node::PatBinding(bn, _) => bn,
                                _ => "_",
                            }
                            if bname != "_" {
                                emit(ctx, ch, lib::op_get_local, asp)
                                emit_u16(ctx, ch, scrut_slot, asp)
                                emit(ctx, ch, lib::op_get_field, asp)
                                emit(ctx, ch, i, asp)
                                declare_local(ctx, ch, bname, false, asp)?
                                arm_locals = arm_locals + 1
                            }
                            i = i + 1
                        }
                    },
                    frontend::Node::PatRecord(names, _) => {
                        for fname in names {
                            emit(ctx, ch, lib::op_get_local, asp)
                            emit_u16(ctx, ch, scrut_slot, asp)
                            let cidx = add_const(ctx, ch, lib::CVal::CStr(fname))
                            emit(ctx, ch, lib::op_get_field_name, asp)
                            emit_u16(ctx, ch, cidx, asp)
                            declare_local(ctx, ch, fname, false, asp)?
                            arm_locals = arm_locals + 1
                        }
                    },
                    _ => {},
                }

                match guard {
                    frontend::Node::NoNode => {},
                    _ => {
                        match cp_expr(ch, guard) {
                            Ok(_) => {},
                            Err(d) => {
                                return Err(d)
                            },
                        }
                        guard_fail_j = emit_jump(ctx, ch, lib::op_jump_if_false_pop, frontend::span_of(guard))
                    },
                }
                match cp_expr(ch, body) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                if arm_locals > 0 {
                    emit(ctx, ch, lib::op_end_block, asp)
                    emit(ctx, ch, arm_locals, asp)
                }
                ctx.c_scope_depth[ch] = ctx.c_scope_depth[ch] - 1
                while n_locals(ctx.c_l_name, ch) > 0 && ctx.c_l_depth[ch][n_locals(ctx.c_l_name, ch) - 1] > ctx.c_scope_depth[ch] {
                    pop_local(ctx, ch)
                }
                push(end_jumps, emit_jump(ctx, ch, lib::op_jump, asp))
                if guard_fail_j >= 0 {
                    patch_jump(ctx, ch, guard_fail_j)?
                    if arm_locals > 0 {
                        emit(ctx, ch, lib::op_unit, asp)
                        emit(ctx, ch, lib::op_end_block, asp)
                        emit(ctx, ch, arm_locals, asp)
                        emit(ctx, ch, lib::op_pop, asp)
                    }
                }
                if fail_j >= 0 {
                    let _ = patch_jump(ctx, ch, fail_j)?
                }
            },
            _ => {},
        }
    }
    emit(ctx, ch, lib::op_no_match, msp)
    for j in end_jumps {
        let _ = patch_jump(ctx, ch, j)?
    }
    ctx.c_scope_depth[ch] = ctx.c_scope_depth[ch] - 1
    pop_local(ctx, ch)
    emit(ctx, ch, lib::op_end_block, msp)
    emit(ctx, ch, 1, msp)
    Ok(true)
}

// qualify 限定名字（跨包）/ qualify qualifies a name (cross-package)
fn qualify(cur_pkg, name) {
    if cur_pkg == "" {
        name
    } else {
        cur_pkg + "." + name
    }
}

// alias_path 解析 import 别名 / alias_path resolves an import alias
fn alias_path(cur_aliases, name) {
    match get(cur_aliases, name) {
        Some(p) => p,
        None => "",
    }
}

// push_local 压入局部变量记录 / push_local records a local
fn push_local(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, name, depth, slot, is_mut, tempsbelow) {
    push(ctx.c_l_name[ch], name)
    push(ctx.c_l_depth[ch], depth)
    push(ctx.c_l_slot[ch], slot)
    push(ctx.c_l_mut[ch], is_mut)
    push(ctx.c_l_captured[ch], false)
    push(ctx.c_l_tempsbelow[ch], tempsbelow)
}

// pop_local 弹出局部变量记录 / pop_local removes a local
fn pop_local(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch) {
    let _ = pop(ctx.c_l_name[ch])
    let _ = pop(ctx.c_l_depth[ch])
    let _ = pop(ctx.c_l_slot[ch])
    let _ = pop(ctx.c_l_mut[ch])
    let _ = pop(ctx.c_l_captured[ch])
    let _ = pop(ctx.c_l_tempsbelow[ch])
}

// n_locals 取局部变量数 / n_locals counts locals
fn n_locals(c_l_name, ch) {
    len(c_l_name[ch])
}

// resolve_local 解析局部变量 / resolve_local resolves a local
fn resolve_local(c_l_name, _c_l_slot, ch, name) {
    let mut i = n_locals(c_l_name, ch) - 1
    let mut hit = -1
    while i >= 0 && hit < 0 {
        if c_l_name[ch][i] == name {
            hit = i
        }
        i = i - 1
    }
    hit
}

fn begin_scope(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch) {
    ctx.c_scope_depth[ch] = ctx.c_scope_depth[ch] + 1
}

// cp_select select 代码生成 / cp_select codegens select
fn cp_select(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, arms, has_default, dflt, dsp, sp, cp_expr) {
    let base_temps = ctx.c_temps[ch]
    for arm in arms {
        match arm {
            frontend::Node::SelectArm(is_send, _, _, cch, val, _, _) => {
                match cp_expr(ch, cch) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                ctx.c_temps[ch] = ctx.c_temps[ch] + 1
                if is_send {
                    match cp_expr(ch, val) {
                        Ok(_) => {},
                        Err(d) => {
                            return Err(d)
                        },
                    }
                    ctx.c_temps[ch] = ctx.c_temps[ch] + 1
                }
            },
            _ => {},
        }
    }
    ctx.c_temps[ch] = base_temps

    if len(arms) > 255 {
        return frontend::perr("E2021", "", "too many select arms", sp)
    }
    emit(ctx, ch, lib::op_select, sp)
    emit(ctx, ch, len(arms), sp)
    emit(ctx, ch, if has_default {
        1
    } else {
        0
    }, sp)
    let mut arm_slots = []
    for arm in arms {
        match arm {
            frontend::Node::SelectArm(is_send, _, _, _, _, _, _) => {
                emit(ctx, ch, if is_send {
                    1
                } else {
                    0
                }, sp)
                emit_u16(ctx, ch, 65535, sp)
                push(arm_slots, code_len(ctx, ch) - 2)
            },
            _ => {},
        }
    }
    let mut def_slot = -1
    if has_default {
        emit_u16(ctx, ch, 65535, sp)
        def_slot = code_len(ctx, ch) - 2
    }

    let mut end_jumps = []
    let mut i = 0
    for arm in arms {
        match arm {
            frontend::Node::SelectArm(is_send, bind, _, _, _, body, asp) => {
                patch_jump(ctx, ch, arm_slots[i])?
                begin_scope(ctx, ch)
                if is_send {
                    match cp_expr(ch, body) {
                        Ok(_) => {},
                        Err(d) => {
                            return Err(d)
                        },
                    }
                    emit(ctx, ch, lib::op_pop, asp)
                } else if bind != "" && bind != "_" {
                    declare_local(ctx, ch, bind, false, asp)?
                    // recv 值在栈顶（select exec 留槽），拷入臂变量槽，让 x86 后端拿到权威类型
                    // the recv value sits on the stack top (select exec leaves the slot);
                    // copy it into the arm-variable slot so the x86 backend records an
                    // authoritative type instead of guessing from a polluted stack top
                    emit(ctx, ch, lib::op_set_local, asp)
                    emit_u16(ctx, ch, ctx.c_l_slot[ch][len(ctx.c_l_slot[ch]) - 1], asp)
                    match cp_expr(ch, body) {
                        Ok(_) => {},
                        Err(d) => {
                            return Err(d)
                        },
                    }
                    emit(ctx, ch, lib::op_pop, asp)
                } else {
                    emit(ctx, ch, lib::op_pop, asp)
                    match cp_expr(ch, body) {
                        Ok(_) => {},
                        Err(d) => {
                            return Err(d)
                        },
                    }
                    emit(ctx, ch, lib::op_pop, asp)
                }
                end_scope(ctx, ch, asp)
                push(end_jumps, emit_jump(ctx, ch, lib::op_jump, asp))
            },
            _ => {},
        }
        i = i + 1
    }
    if has_default {
        patch_jump(ctx, ch, def_slot)?
        begin_scope(ctx, ch)
        match cp_expr(ch, dflt) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        emit(ctx, ch, lib::op_pop, dsp)
        end_scope(ctx, ch, dsp)
        push(end_jumps, emit_jump(ctx, ch, lib::op_jump, dsp))
    }
    for j in end_jumps {
        let _ = patch_jump(ctx, ch, j)?
    }
    Ok(true)
}

fn cp_spawn_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, call, sp, cp_expr) {
    match call {
        frontend::Node::Call(callee, cargs, _) => {
            match cp_expr(ch, callee) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            for a in cargs {
                match cp_expr(ch, a) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] - (len(cargs) + 1)
            if len(cargs) > 255 {
                return frontend::perr("E2005", "", "too many arguments", sp)
            }
            emit(ctx, ch, lib::op_spawn, sp)
            emit(ctx, ch, len(cargs), sp)
            Ok(true)
        },
        _ => Ok(true),
    }
}

fn cp_defer_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, cur_file, ch, body, crefs, sp, cp_expr, cp_stmt) {
    cp_function(ctx, cur_file, ch, frontend::Node::FnLit([], [], [], [], frontend::Node::NoNode, body, "<defer>", crefs, sp), cp_expr, cp_stmt)?
    emit(ctx, ch, lib::op_defer, sp)
    Ok(true)
}

fn cp_send_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cch, val, sp, cp_expr) {
    match cp_expr(ch, cch) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] + 1
    match cp_expr(ch, val) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] - 1
    emit(ctx, ch, lib::op_send, sp)
    Ok(true)
}

fn cp_for_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, chan_fors, cur_file, ch, v, idx, iter, body, sp, cp_expr, cp_stmt) {
    let fstart = match sp {
        frontend::SpanT::Sp(fs, _) => fs,
    }
    if contains(chan_fors, cur_file + ":" + str(fstart)) {
        cp_for_chan(ctx, ch, v, iter, body, sp, cp_expr, cp_stmt)
    } else {
        cp_for(ctx, ch, v, idx, iter, body, sp, cp_expr, cp_stmt)
    }
}

fn cp_break_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, lb, sp) {
    let li = if lb == "" {
        unwind_to_loop(ctx, ch, sp)?
    } else {
        labeled_loop(ctx, ch, lb, sp)?
    }
    push(ctx.c_lp_breaks[ch][li], emit_jump(ctx, ch, lib::op_jump, sp))
    Ok(true)
}

fn cp_continue_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, lb, sp) {
    let li = if lb == "" {
        unwind_to_loop(ctx, ch, sp)?
    } else {
        labeled_loop(ctx, ch, lb, sp)?
    }
    if ctx.c_lp_contto[ch][li] >= 0 {
        emit_loop(ctx, ch, ctx.c_lp_contto[ch][li], sp)
    } else {
        push(ctx.c_lp_conts[ch][li], emit_jump(ctx, ch, lib::op_jump, sp))
        Ok(true)
    }
}

fn cp_label_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, lb, inner, cp_stmt) {
    let saved = ctx.c_lbl_pending[ch]
    ctx.c_lbl_pending[ch] = lb
    match cp_stmt(ch, inner) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_lbl_pending[ch] = saved
    Ok(true)
}

fn cp_expr_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, e, sp, cp_expr) {
    match cp_expr(ch, e) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    emit(ctx, ch, lib::op_pop, sp)
    Ok(true)
}

fn cp_return_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, val, sp, cp_expr) {
    match val {
        frontend::Node::NoNode => emit(ctx, ch, lib::op_unit, sp),
        _ => {
            match cp_expr(ch, val) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
        },
    }
    emit(ctx, ch, lib::op_return, sp)
    Ok(true)
}

fn add_upvalue(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, index, is_local, is_mut, name, sp) {
    let mut i = 0
    while i < len(ctx.c_u_index[ch]) {
        if ctx.c_u_index[ch][i] == index && ctx.c_u_islocal[ch][i] == is_local {
            return Ok(i)
        }
        i = i + 1
    }
    if len(ctx.c_u_index[ch]) >= 255 {
        return frontend::perr("E2004", "", "too many captured variables", sp)
    }
    push(ctx.c_u_index[ch], index)
    push(ctx.c_u_islocal[ch], is_local)
    push(ctx.c_u_mut[ch], is_mut)
    push(ctx.c_u_name[ch], name)
    ctx.f_nupvals[ctx.c_fn[ch]] = len(ctx.c_u_index[ch])
    Ok(len(ctx.c_u_index[ch]) - 1)
}

fn resolve_upvalue(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, name, sp) {
    if ctx.c_enclosing[ch] < 0 {
        return Ok(-1)
    }
    let enc = ctx.c_enclosing[ch]
    let li = resolve_local(ctx.c_l_name, ctx.c_l_slot, enc, name)
    if li >= 0 {
        ctx.c_l_captured[enc][li] = true
        return add_upvalue(ctx, ch, ctx.c_l_slot[enc][li], true, ctx.c_l_mut[enc][li], name, sp)
    }
    let ui = resolve_upvalue(ctx, enc, name, sp)?
    if ui >= 0 {
        return add_upvalue(ctx, ch, ui, false, ctx.c_u_mut[enc][ui], name, sp)
    }
    Ok(-1)
}

fn cp_while(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cond, body, sp, cp_expr, cp_stmt) {
    let start = code_len(ctx, ch)
    push_loop(ctx, ch, next_slot(ctx, ch), start)
    match cp_expr(ch, cond) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let exit_j = emit_jump(ctx, ch, lib::op_jump_if_false_pop, sp)
    cp_block_stmts(ctx, ch, body, cp_stmt)?
    emit_loop(ctx, ch, start, sp)?
    patch_jump(ctx, ch, exit_j)?
    let li = len(ctx.c_lp_breaks[ch]) - 1
    for j in ctx.c_lp_breaks[ch][li] {
        let _ = patch_jump(ctx, ch, j)?
    }
    pop_loop(ctx, ch)
    Ok(true)
}
