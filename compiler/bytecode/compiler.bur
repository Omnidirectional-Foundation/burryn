// compiler.bur — 单遍字节码编译器（clox 风格）：locals/upvalues 显式管理，
// 配合 temp 追踪让 match/block 表达式（声明局部变量）能出现在任意表达式深度。
// Single-pass bytecode compiler (clox style): explicit locals/upvalues, plus temp tracking
// so match/block expressions that declare locals can appear at any expression depth.
import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

// 编译输出：常量表/代码/函数表等平行结构，供 VM 加载
// Compiled output: parallel tables (constants, code, functions) for the VM
pub enum CompileOut {
    Compiled([str], [str], [int], [int], [[int]], [[frontend::SpanT]], [[lib::CVal]], [str], [[str]], [[int]]),
    CompileFailed(lib::DiagT, str),
}

// compile_script 是脚本编译入口 / compile_script is the script compile entry
pub fn compile_script(stmts, chan_fors) {
    compile_program([[stmts]], [[""]], false, [""], [[[]]], chan_fors)
}

// compile_program 是全程序编译入口（多包）/ compile_program is the whole-program compile entry (multi-package)
pub fn compile_program(pkgs_stmts, pkgs_fpaths, is_pkg, pkg_paths, pkgs_imports, chan_fors) {
    let mut f_name = []
    let mut f_file = []
    let mut f_arity = []
    let mut f_nupvals = []
    let mut f_code = []
    let mut f_spans = []
    let mut f_consts = []
    let mut en_qual = []
    let mut en_vnames = []
    let mut en_varities = []
    let mut en_prefix = []
    let mut enum_by = map()
    let mut global_mut = map()
    let mut pkg_decls = map()
    let mut method_calls = map()
    for mc in chan_fors {
        match str_index_of(mc, "|") {
            Some(bar) => put(method_calls, substr(mc, 0, bar), substr(mc, bar + 1, str_len(mc) - bar - 1)),
            None => {},
        }
    }
    let mut cur_pkg = ""
    let mut cur_aliases = map()
    let mut c_enclosing = []
    let mut c_fn = []
    let mut c_scope_depth = []
    let mut c_temps = []
    let mut c_l_name = []
    let mut c_l_depth = []
    let mut c_l_slot = []
    let mut c_l_mut = []
    let mut c_l_captured = []
    let mut c_l_tempsbelow = []
    let mut c_u_index = []
    let mut c_u_islocal = []
    let mut c_u_mut = []
    let mut c_u_name = []
    let mut c_lp_base = []
    let mut c_lp_contto = []
    let mut c_lp_breaks = []
    let mut c_lp_conts = []
    let mut c_lp_labels = []
    let mut c_lbl_pending = [""]
    let mut cur_file = ""

    let emit_ctx = record { f_code: f_code, f_spans: f_spans, f_consts: f_consts, c_fn: c_fn, c_l_name: c_l_name, c_l_depth: c_l_depth, c_l_slot: c_l_slot, c_l_mut: c_l_mut, c_l_captured: c_l_captured, c_l_tempsbelow: c_l_tempsbelow, c_scope_depth: c_scope_depth, c_lp_base: c_lp_base, c_lp_contto: c_lp_contto, c_lp_breaks: c_lp_breaks, c_lp_conts: c_lp_conts, c_lp_labels: c_lp_labels, c_lbl_pending: c_lbl_pending, c_temps: c_temps, c_u_index: c_u_index, c_u_islocal: c_u_islocal, c_u_mut: c_u_mut, c_u_name: c_u_name, c_enclosing: c_enclosing, f_nupvals: f_nupvals, f_name: f_name, f_file: f_file, f_arity: f_arity }



    let mut cp_expr_ref = fn(_c, _e) {
        Ok(true)
    }
    let mut cp_stmt_ref = fn(_c, _s) {
        Ok(true)
    }















    // cp_expr 表达式代码生成（带临时槽跟踪）/ cp_expr codegens an expression with temp tracking
    fn cp_expr(ch, e) capture(ref cur_file, ref cp_expr_ref, ref cp_stmt_ref, ref cur_pkg, ref cur_aliases, ref pkg_decls) {
        // 表达式编译：按形态发射字节码，临时槽跟踪栈深度
        // Expression compilation: emit per shape, temp tracking mirrors the value stack
        match e {
            frontend::Node::IntLit(v, sp) => cp_int_lit(emit_ctx, ch, v, sp),
            frontend::Node::FloatLit(v, sp) => cp_float_lit(emit_ctx, ch, v, sp),
            frontend::Node::StrLit(v, sp) => cp_str_lit(emit_ctx, ch, v, sp),
            frontend::Node::BoolLit(v, sp) => cp_bool_lit(emit_ctx, ch, v, sp),
            frontend::Node::Ident(name, sp) => cp_ident(emit_ctx, en_varities, en_vnames, en_qual, en_prefix, enum_by, global_mut, pkg_decls, cur_pkg, ch, name, sp),
            frontend::Node::Unary(op, rhs, sp) => cp_unary(emit_ctx, ch, op, rhs, sp, cp_expr_ref),
            frontend::Node::Binary(op, lhs, rhs, sp) => cp_binary(emit_ctx, ch, op, lhs, rhs, sp, cp_expr_ref),
            frontend::Node::Logical(op, lhs, rhs, sp) => cp_logical(emit_ctx, ch, op, lhs, rhs, sp, cp_expr_ref),
            frontend::Node::Call(callee, cargs, sp) => cp_call(emit_ctx, method_calls, cur_file, ch, callee, cargs, sp, cp_expr_ref),
            // 索引：target 与下标入栈后 INDEX_GET
            // Indexing: push the target and index, then INDEX_GET
            frontend::Node::Index(target, idx, sp) => cp_index(emit_ctx, ch, target, idx, sp, cp_expr_ref),
            frontend::Node::TupleLit(elems, sp) => cp_tuple_lit(emit_ctx, ch, elems, sp, cp_expr_ref),
            frontend::Node::ListLit(elems, sp) => cp_list_lit(emit_ctx, ch, elems, sp, cp_expr_ref),
            frontend::Node::FnLit(_, _, _, _, _, _, _, _, _) => cp_function(emit_ctx, cur_file, ch, e, cp_expr_ref, cp_stmt_ref),
            frontend::Node::Block(_, _) => cp_block_expr(emit_ctx, ch, e, cp_expr_ref, cp_stmt_ref),
            // if/while/for 走各自的专用编译路径
            // if/while/for dispatch to their own compilers
            frontend::Node::IfExpr(cond, then, els, sp) => cp_if(emit_ctx, ch, cond, then, els, sp, cp_expr_ref, cp_stmt_ref),
            // match：变体 tag 测试链，字段提取后绑定臂局部
            // Match: a chain of variant tag tests, field extraction binds arm locals
            frontend::Node::MatchExpr(scrut, arms, sp) => cp_match(emit_ctx, enum_by, en_prefix, en_vnames, en_varities, cur_pkg, cur_aliases, ch, scrut, arms, sp, cp_expr_ref),
            frontend::Node::VariantAccess(en, vr, sp) => cp_variant_access(emit_ctx, enum_by, en_prefix, en_vnames, en_qual, en_varities, cur_pkg, cur_aliases, ch, en, vr, sp),
            frontend::Node::PkgAccess(pkg, name, sp) => cp_pkg_access(emit_ctx, ch, pkg, name, sp),
            frontend::Node::QualVariantAccess(pkg, en, vr, sp) => cp_qual_variant_access(emit_ctx, enum_by, en_vnames, en_qual, en_varities, cur_aliases, ch, pkg, en, vr, sp),
            frontend::Node::TryExpr(inner, sp) => cp_try_expr(emit_ctx, ch, inner, sp, cp_expr_ref),
            frontend::Node::RecvExpr(cch, sp) => cp_recv_expr(emit_ctx, ch, cch, sp, cp_expr_ref),
            // record 字面量：字段值入栈后构造对象
            // Record literals: push field values, then build the object
            frontend::Node::RecordLit(names, vals, sp) => cp_record_lit(emit_ctx, ch, names, vals, sp, cp_expr_ref),
            frontend::Node::RecordUpdate(base, names, vals, sp) => cp_record_update(emit_ctx, ch, base, names, vals, sp, cp_expr_ref),
            frontend::Node::FieldAccess(base, field, sp) => cp_field_access(emit_ctx, ch, base, field, sp, cp_expr_ref),
            _ => Ok(true),
        }
    }
    cp_expr_ref = cp_expr

    // cp_stmt 语句代码生成 / cp_stmt codegens a statement
    fn cp_stmt(ch, s) capture(ref cur_pkg, ref cur_file, ref cp_expr_ref, ref cp_stmt_ref, ref pkg_decls) {
        match s {
            frontend::Node::DestructLet(names, nspans, is_mut, init, sp) => {
                match cp_expr(ch, init) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                match declare_local(emit_ctx, ch, "(dtmp)", false, sp) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                let tslot = c_l_slot[ch][n_locals(c_l_name, ch) - 1]
                let mut i = 0
                while i < len(names) {
                    emit(emit_ctx, ch, lib::op_get_local, sp)
                    emit_u16(emit_ctx, ch, tslot, sp)
                    emit_const(emit_ctx, ch, lib::CVal::CInt(i), sp)
                    emit(emit_ctx, ch, lib::op_index_get, sp)
                    if c_scope_depth[ch] == 0 {
                        match define_global(emit_ctx, global_mut, c_fn, enum_by, cur_pkg, ch, names[i], is_mut, sp) {
                            Ok(_) => {},
                            Err(d) => {
                                return Err(d)
                            },
                        }
                    } else {
                        match declare_local(emit_ctx, ch, names[i], is_mut, sp) {
                            Ok(_) => {},
                            Err(d) => {
                                return Err(d)
                            },
                        }
                    }
                    i = i + 1
                }
                if c_scope_depth[ch] == 0 {
                    emit(emit_ctx, ch, lib::op_pop, sp)
                    let _ = pop_local(emit_ctx, ch)
                }
                Ok(true)
            },
            frontend::Node::LetStmt(name, _, is_mut, _, _, init, sp) => {
                match cp_expr(ch, init) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                if c_scope_depth[ch] == 0 {
                    define_global(emit_ctx, global_mut, c_fn, enum_by, cur_pkg, ch, name, is_mut, sp)
                } else {
                    declare_local(emit_ctx, ch, name, is_mut, sp)
                }
            },
            frontend::Node::MethodDecl(rt, name, _, lit, sp) => {
                if c_scope_depth[ch] == 0 {
                    match cp_function(emit_ctx, cur_file, ch, lit, cp_expr_ref, cp_stmt_ref) {
                        Ok(_) => {},
                        Err(d) => {
                            return Err(d)
                        },
                    }
                    define_global(emit_ctx, global_mut, c_fn, enum_by, cur_pkg, ch, rt + "." + name, false, sp)
                } else {
                    return frontend::perr("E2019", "", "methods must be declared at the top level", sp)
                    Ok(true)
                }
            },
            frontend::Node::FnDecl(name, _, _, lit, sp) => {
                if c_scope_depth[ch] == 0 {
                    match cp_function(emit_ctx, cur_file, ch, lit, cp_expr_ref, cp_stmt_ref) {
                        Ok(_) => {},
                        Err(d) => {
                            return Err(d)
                        },
                    }
                    define_global(emit_ctx, global_mut, c_fn, enum_by, cur_pkg, ch, name, false, sp)
                } else {
                    emit(emit_ctx, ch, lib::op_unit, sp)
                    match declare_local(emit_ctx, ch, name, true, sp) {
                        Ok(_) => {},
                        Err(d) => {
                            return Err(d)
                        },
                    }
                    match cp_function(emit_ctx, cur_file, ch, lit, cp_expr_ref, cp_stmt_ref) {
                        Ok(_) => {},
                        Err(d) => {
                            return Err(d)
                        },
                    }
                    let slot = c_l_slot[ch][resolve_local(c_l_name, c_l_slot, ch, name)]
                    emit(emit_ctx, ch, lib::op_set_local, sp)
                    emit_u16(emit_ctx, ch, slot, sp)
                    emit(emit_ctx, ch, lib::op_pop, sp)
                    c_l_mut[ch][resolve_local(c_l_name, c_l_slot, ch, name)] = false
                    Ok(true)
                }
            },
            frontend::Node::EnumDecl(name, _, variants, _, sp) => {
                if c_scope_depth[ch] > 0 {
                    return frontend::perr("E2008", "", "enum declarations are only allowed at top level", sp)
                }
                let qual = qualify(cur_pkg, name)
                let pre = match get(enum_by, qual) {
                    Some(h) => h,
                    None => -1,
                }
                let eh = if pre >= 0 && cur_pkg != "" {
                    pre
                } else {
                    match register_enum_decl(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, cur_pkg, ch, name, variants, sp) {
                        Ok(v) => v,
                        Err(d) => {
                            return Err(d)
                            0
                        },
                    }
                }
                emit_const(emit_ctx, ch, lib::CVal::CEnumType(eh), sp)
                let idx = add_const(emit_ctx, ch, lib::CVal::CStr(qual))
                emit(emit_ctx, ch, lib::op_def_global, sp)
                emit_u16(emit_ctx, ch, idx, sp)
                Ok(true)
            },
            frontend::Node::ExprStmt(e, sp) => cp_expr_stmt(emit_ctx, ch, e, sp, cp_expr_ref),
            frontend::Node::AssignStmt(target, val, sp) => cp_assign(emit_ctx, global_mut, pkg_decls, cur_pkg, ch, target, val, sp, cp_expr_ref),
            frontend::Node::ReturnStmt(val, sp) => cp_return_stmt(emit_ctx, ch, val, sp, cp_expr_ref),
            frontend::Node::WhileStmt(cond, body, sp) => cp_while(emit_ctx, ch, cond, body, sp, cp_expr_ref, cp_stmt_ref),
            frontend::Node::ForStmt(v, _, idx, _, iter, _, body, sp) => cp_for_stmt(emit_ctx, chan_fors, cur_file, ch, v, idx, iter, body, sp, cp_expr_ref, cp_stmt_ref),
            frontend::Node::BreakStmt(lb, sp) => cp_break_stmt(emit_ctx, ch, lb, sp),
            frontend::Node::ContinueStmt(lb, sp) => cp_continue_stmt(emit_ctx, ch, lb, sp),
            frontend::Node::LabelStmt(lb, inner, _) => cp_label_stmt(emit_ctx, ch, lb, inner, cp_stmt_ref),
            frontend::Node::SpawnStmt(call, sp) => cp_spawn_stmt(emit_ctx, ch, call, sp, cp_expr_ref),
            frontend::Node::DeferStmt(body, crefs, sp) => cp_defer_stmt(emit_ctx, cur_file, ch, body, crefs, sp, cp_expr_ref, cp_stmt_ref),
            frontend::Node::SendStmt(cch, val, sp) => cp_send_stmt(emit_ctx, ch, cch, val, sp, cp_expr_ref),
            frontend::Node::SelectStmt(arms, has_default, dflt, dsp, sp) => cp_select(emit_ctx, ch, arms, has_default, dflt, dsp, sp, cp_expr_ref),
            _ => Ok(true),
        }
    }
    cp_stmt_ref = cp_stmt

    // 内建枚举与 native 预注册：Option/Result/Output + 全局名表
    // Builtin enums and native pre-registration: Option/Result/Output plus the global name table
    declare_enum(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, "Option", "", ["Some", "None"], [1, 0])
    declare_enum(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, "Result", "", ["Ok", "Err"], [1, 1])
    declare_enum(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, "Output", "", ["Output"], [3])
    for n in lib::native_names {
        put(global_mut, n, false)
    }

    // 包模式：建 <module> 帧，逐包注册枚举后按依赖编译顶层语句
    // Package mode: a <module> frame, per-package enum registration, then
    // top-level compilation in dependency order
    if is_pkg {
        let module_fn = new_func(emit_ctx, "<module>", "", 0)
        let c0 = new_compiler(emit_ctx, -1, module_fn)
        push_local(emit_ctx, c0, "", 0, 0, false, 0)
        let n_pkgs = len(pkgs_stmts)
        let mut pi = 0
        while pi < n_pkgs {
            cur_pkg = pkg_paths[pi]
            let files_stmts = pkgs_stmts[pi]
            let file_paths = pkgs_fpaths[pi]
            let file_imports = pkgs_imports[pi]
            let n_files = len(files_stmts)
            pkg_decls = map()
            // 先收声明名（函数/枚举/let），供跨文件引用解析
            // Collect declared names (fn/enum/let) first, for cross-file reference resolution
            let mut fi = 0
            while fi < n_files {
                for s in files_stmts[fi] {
                    match s {
                        frontend::Node::FnDecl(name, _, _, _, _) => put(pkg_decls, name, true),
                        frontend::Node::EnumDecl(name, _, _, _, _) => put(pkg_decls, name, true),
                        frontend::Node::LetStmt(name, _, _, _, _, _, _) => put(pkg_decls, name, true),
                        _ => {},
                    }
                }
                fi = fi + 1
            }
            fi = 0
            while fi < n_files {
                cur_file = file_paths[fi]
                // 注册枚举：变体表与构造器
                // Register enums: variant tables and constructors
                for s in files_stmts[fi] {
                    match s {
                        frontend::Node::EnumDecl(name, _, variants, _, sp) => {
                            match register_enum_decl(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, cur_pkg, c0, name, variants, sp) {
                                Ok(_) => {},
                                Err(d) => {
                                    return CompileFailed(d, cur_file)
                                },
                            }
                        },
                        _ => {},
                    }
                }
                fi = fi + 1
            }
            fi = 0
            while fi < n_files {
                cur_file = file_paths[fi]
                cur_aliases = frontend::aliases_of(file_imports[fi])
                let sub_fn = new_func(emit_ctx, "<init>", cur_file, 0)
                let sub = new_compiler(emit_ctx, -1, sub_fn)
                push_local(emit_ctx, sub, "", 0, 0, false, 0)
                for s in files_stmts[fi] {
                    match cp_stmt(sub, s) {
                        Ok(_) => {},
                        Err(d) => {
                            return CompileFailed(d, cur_file)
                        },
                    }
                }
                emit(emit_ctx, sub, lib::op_unit, frontend::SpanT::Sp(0, 0))
                emit(emit_ctx, sub, lib::op_return, frontend::SpanT::Sp(0, 0))
                let idx = add_const(emit_ctx, c0, lib::CVal::CFn(sub_fn))
                emit(emit_ctx, c0, lib::op_closure, frontend::SpanT::Sp(0, 0))
                emit_u16(emit_ctx, c0, idx, frontend::SpanT::Sp(0, 0))
                emit(emit_ctx, c0, lib::op_call, frontend::SpanT::Sp(0, 0))
                emit(emit_ctx, c0, 0, frontend::SpanT::Sp(0, 0))
                emit(emit_ctx, c0, lib::op_pop, frontend::SpanT::Sp(0, 0))
                fi = fi + 1
            }
            cur_aliases = map()
            pi = pi + 1
        }
        cur_file = ""
        cur_pkg = ""
        let idx = add_const(emit_ctx, c0, lib::CVal::CStr(pkg_paths[n_pkgs - 1] + ".main"))
        emit(emit_ctx, c0, lib::op_get_global, frontend::SpanT::Sp(0, 0))
        emit_u16(emit_ctx, c0, idx, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_call, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, 0, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_pop, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_unit, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_return, frontend::SpanT::Sp(0, 0))
    } else {
        let script_fn = new_func(emit_ctx, "<script>", "", 0)
        let c0 = new_compiler(emit_ctx, -1, script_fn)
        push_local(emit_ctx, c0, "", 0, 0, false, 0)
        for s in pkgs_stmts[0][0] {
            match cp_stmt(c0, s) {
                Ok(_) => {},
                Err(d) => {
                    return CompileFailed(d, "")
                },
            }
        }
        emit(emit_ctx, c0, lib::op_unit, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_return, frontend::SpanT::Sp(0, 0))
    }

    Compiled(f_name, f_file, f_arity, f_nupvals, f_code, f_spans, f_consts, en_qual, en_vnames, en_varities)
}
