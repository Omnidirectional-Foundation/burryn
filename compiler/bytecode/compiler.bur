// compiler.bur — AST → 字节码：作用域与帧布局、表达式与语句发射、
// 模式匹配臂、循环边与 upvalue 捕获。
// AST to bytecode: scope and frame layout, expression and statement emission,
// match arms, loop edges and upvalue capture.

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

// 编译输出：常量表/代码/函数表等平行结构，供 VM 加载
// Compiled output: parallel tables (constants, code, functions) for the VM
pub enum CompileOut {
    Compiled([str], [str], [int], [int], [[int]], [[frontend::SpanT]], [[lib::CVal]], [str], [[str]], [[int]]),
    CompileFailed(lib::DiagT, str),
}

// compile_script 是脚本编译入口 / compile_script is the script compile entry
pub fn compile_script(stmts, chan_fors) {
    compile_program([[stmts]], [[""]], false, [""], [[[]]], chan_fors)
}

// compile_program 是全程序编译入口（多包）/ compile_program is the whole-program compile entry (multi-package)
pub fn compile_program(pkgs_stmts, pkgs_fpaths, is_pkg, pkg_paths, pkgs_imports, chan_fors) {
    let mut f_name = []
    let mut f_file = []
    let mut f_arity = []
    let mut f_nupvals = []
    let mut f_code = []
    let mut f_spans = []
    let mut f_consts = []
    let mut en_qual = []
    let mut en_vnames = []
    let mut en_varities = []
    let mut en_prefix = []
    let mut enum_by = map()
    let mut global_mut = map()
    let mut pkg_decls = map()
    let mut method_calls = map()
    for mc in chan_fors {
        match str_index_of(mc, "|") {
            Some(bar) => put(method_calls, substr(mc, 0, bar), substr(mc, bar + 1, str_len(mc) - bar - 1)),
            None => {},
        }
    }
    let mut cur_pkg = ""
    let mut cur_aliases = map()
    let mut c_enclosing = []
    let mut c_fn = []
    let mut c_scope_depth = []
    let mut c_temps = []
    let mut c_l_name = []
    let mut c_l_depth = []
    let mut c_l_slot = []
    let mut c_l_mut = []
    let mut c_l_captured = []
    let mut c_l_tempsbelow = []
    let mut c_u_index = []
    let mut c_u_islocal = []
    let mut c_u_mut = []
    let mut c_u_name = []
    let mut c_lp_base = []
    let mut c_lp_contto = []
    let mut c_lp_breaks = []
    let mut c_lp_conts = []
    let mut c_lp_labels = []
    let mut c_lbl_pending = [""]
    let mut cur_file = ""

    let emit_ctx = record { f_code: f_code, f_spans: f_spans, f_consts: f_consts, c_fn: c_fn, c_l_name: c_l_name, c_l_depth: c_l_depth, c_l_slot: c_l_slot, c_l_mut: c_l_mut, c_l_captured: c_l_captured, c_l_tempsbelow: c_l_tempsbelow, c_scope_depth: c_scope_depth, c_lp_base: c_lp_base, c_lp_contto: c_lp_contto, c_lp_breaks: c_lp_breaks, c_lp_conts: c_lp_conts, c_lp_labels: c_lp_labels, c_lbl_pending: c_lbl_pending, c_temps: c_temps, c_u_index: c_u_index, c_u_islocal: c_u_islocal, c_u_mut: c_u_mut, c_u_name: c_u_name, c_enclosing: c_enclosing, f_nupvals: f_nupvals, f_name: f_name, f_file: f_file, f_arity: f_arity }

    let mut cp_expr_ref = fn(_c, _e) {
        Ok(true)
    }
    let mut cp_stmt_ref = fn(_c, _s) {
        Ok(true)
    }

    // cp_expr 表达式代码生成（带临时槽跟踪）/ cp_expr codegens an expression with temp tracking
    fn cp_expr(ch, e) capture(ref cur_file, ref cp_expr_ref, ref cp_stmt_ref, ref cur_pkg, ref cur_aliases, ref pkg_decls) {
        // 表达式编译：按形态发射字节码，临时槽跟踪栈深度
        // Expression compilation: emit per shape, temp tracking mirrors the value stack
        match e {
            frontend::Node::IntLit(v, sp) => cp_int_lit(emit_ctx, ch, v, sp),
            frontend::Node::FloatLit(v, sp) => cp_float_lit(emit_ctx, ch, v, sp),
            frontend::Node::StrLit(v, sp) => cp_str_lit(emit_ctx, ch, v, sp),
            frontend::Node::BoolLit(v, sp) => cp_bool_lit(emit_ctx, ch, v, sp),
            frontend::Node::Ident(name, sp) => cp_ident(emit_ctx, en_varities, en_vnames, en_qual, en_prefix, enum_by, global_mut, pkg_decls, cur_pkg, ch, name, sp),
            frontend::Node::Unary(op, rhs, sp) => cp_unary(emit_ctx, ch, op, rhs, sp, cp_expr_ref),
            frontend::Node::Binary(op, lhs, rhs, sp) => cp_binary(emit_ctx, ch, op, lhs, rhs, sp, cp_expr_ref),
            frontend::Node::Logical(op, lhs, rhs, sp) => cp_logical(emit_ctx, ch, op, lhs, rhs, sp, cp_expr_ref),
            frontend::Node::Call(callee, cargs, sp) => cp_call(emit_ctx, method_calls, cur_file, ch, callee, cargs, sp, cp_expr_ref),
            // 索引：target 与下标入栈后 INDEX_GET
            // Indexing: push the target and index, then INDEX_GET
            frontend::Node::Index(target, idx, sp) => cp_index(emit_ctx, ch, target, idx, sp, cp_expr_ref),
            frontend::Node::TupleLit(elems, sp) => cp_tuple_lit(emit_ctx, ch, elems, sp, cp_expr_ref),
            frontend::Node::ListLit(elems, sp) => cp_list_lit(emit_ctx, ch, elems, sp, cp_expr_ref),
            frontend::Node::FnLit(_, _, _, _, _, _, _, _, _) => cp_function(emit_ctx, cur_file, ch, e, cp_expr_ref, cp_stmt_ref),
            frontend::Node::Block(_, _) => cp_block_expr(emit_ctx, ch, e, cp_expr_ref, cp_stmt_ref),
            // if/while/for 走各自的专用编译路径
            // if/while/for dispatch to their own compilers
            frontend::Node::IfExpr(cond, then, els, sp) => cp_if(emit_ctx, ch, cond, then, els, sp, cp_expr_ref, cp_stmt_ref),
            // match：变体 tag 测试链，字段提取后绑定臂局部
            // Match: a chain of variant tag tests, field extraction binds arm locals
            frontend::Node::MatchExpr(scrut, arms, sp) => cp_match(emit_ctx, enum_by, en_prefix, en_vnames, en_varities, cur_pkg, cur_aliases, ch, scrut, arms, sp, cp_expr_ref),
            frontend::Node::VariantAccess(en, vr, sp) => cp_variant_access(emit_ctx, enum_by, en_prefix, en_vnames, en_qual, en_varities, cur_pkg, cur_aliases, ch, en, vr, sp),
            frontend::Node::PkgAccess(pkg, name, sp) => cp_pkg_access(emit_ctx, ch, pkg, name, sp),
            frontend::Node::QualVariantAccess(pkg, en, vr, sp) => cp_qual_variant_access(emit_ctx, enum_by, en_vnames, en_qual, en_varities, cur_aliases, ch, pkg, en, vr, sp),
            frontend::Node::TryExpr(inner, sp) => cp_try_expr(emit_ctx, ch, inner, sp, cp_expr_ref),
            frontend::Node::RecvExpr(cch, sp) => cp_recv_expr(emit_ctx, ch, cch, sp, cp_expr_ref),
            // record 字面量：字段值入栈后构造对象
            // Record literals: push field values, then build the object
            frontend::Node::RecordLit(names, vals, sp) => cp_record_lit(emit_ctx, ch, names, vals, sp, cp_expr_ref),
            frontend::Node::RecordUpdate(base, names, vals, sp) => cp_record_update(emit_ctx, ch, base, names, vals, sp, cp_expr_ref),
            frontend::Node::FieldAccess(base, field, sp) => cp_field_access(emit_ctx, ch, base, field, sp, cp_expr_ref),
            _ => Ok(true),
        }
    }
    cp_expr_ref = cp_expr

    // cp_stmt 语句代码生成 / cp_stmt codegens a statement
    fn cp_stmt(ch, s) capture(ref cur_pkg, ref cur_file, ref cp_expr_ref, ref cp_stmt_ref, ref pkg_decls) {
        match s {
            frontend::Node::DestructLet(names, _nspans, is_mut, init, sp) => {
                cp_expr(ch, init)?
                declare_local(emit_ctx, ch, "(dtmp)", false, sp)?
                let tslot = c_l_slot[ch][n_locals(c_l_name, ch) - 1]
                let mut i = 0
                while i < len(names) {
                    emit(emit_ctx, ch, lib::op_get_local, sp)
                    emit_u16(emit_ctx, ch, tslot, sp)
                    emit_const(emit_ctx, ch, lib::CVal::CInt(i), sp)
                    emit(emit_ctx, ch, lib::op_index_get, sp)
                    if c_scope_depth[ch] == 0 {
                        let _ = define_global(emit_ctx, global_mut, c_fn, enum_by, cur_pkg, ch, names[i], is_mut, sp)?
                    } else {
                        let _ = declare_local(emit_ctx, ch, names[i], is_mut, sp)?
                    }
                    i = i + 1
                }
                if c_scope_depth[ch] == 0 {
                    emit(emit_ctx, ch, lib::op_pop, sp)
                    let _ = pop_local(emit_ctx, ch)
                }
                Ok(true)
            },
            frontend::Node::LetStmt(name, _, is_mut, _, _, init, sp) => {
                cp_expr(ch, init)?
                if c_scope_depth[ch] == 0 {
                    define_global(emit_ctx, global_mut, c_fn, enum_by, cur_pkg, ch, name, is_mut, sp)
                } else {
                    declare_local(emit_ctx, ch, name, is_mut, sp)
                }
            },
            frontend::Node::MethodDecl(rt, name, _, lit, sp) => {
                if c_scope_depth[ch] == 0 {
                    cp_function(emit_ctx, cur_file, ch, lit, cp_expr_ref, cp_stmt_ref)?
                    define_global(emit_ctx, global_mut, c_fn, enum_by, cur_pkg, ch, rt + "." + name, false, sp)
                } else {
                    return frontend::perr("E2019", "", "methods must be declared at the top level", sp)
                    Ok(true)
                }
            },
            frontend::Node::FnDecl(name, _, _, lit, sp) => {
                if c_scope_depth[ch] == 0 {
                    cp_function(emit_ctx, cur_file, ch, lit, cp_expr_ref, cp_stmt_ref)?
                    define_global(emit_ctx, global_mut, c_fn, enum_by, cur_pkg, ch, name, false, sp)
                } else {
                    emit(emit_ctx, ch, lib::op_unit, sp)
                    declare_local(emit_ctx, ch, name, true, sp)?
                    cp_function(emit_ctx, cur_file, ch, lit, cp_expr_ref, cp_stmt_ref)?
                    let slot = c_l_slot[ch][resolve_local(c_l_name, c_l_slot, ch, name)]
                    emit(emit_ctx, ch, lib::op_set_local, sp)
                    emit_u16(emit_ctx, ch, slot, sp)
                    emit(emit_ctx, ch, lib::op_pop, sp)
                    c_l_mut[ch][resolve_local(c_l_name, c_l_slot, ch, name)] = false
                    Ok(true)
                }
            },
            frontend::Node::EnumDecl(name, _, variants, _, sp) => {
                if c_scope_depth[ch] > 0 {
                    return frontend::perr("E2008", "", "enum declarations are only allowed at top level", sp)
                }
                let qual = qualify(cur_pkg, name)
                let pre = match get(enum_by, qual) {
                    Some(h) => h,
                    None => -1,
                }
                let eh = if pre >= 0 && cur_pkg != "" {
                    pre
                } else {
                    register_enum_decl(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, cur_pkg, ch, name, variants, sp)?
                }
                emit_const(emit_ctx, ch, lib::CVal::CEnumType(eh), sp)
                let idx = add_const(emit_ctx, ch, lib::CVal::CStr(qual))
                emit(emit_ctx, ch, lib::op_def_global, sp)
                emit_u16(emit_ctx, ch, idx, sp)
                Ok(true)
            },
            frontend::Node::ExprStmt(e, sp) => cp_expr_stmt(emit_ctx, ch, e, sp, cp_expr_ref),
            frontend::Node::AssignStmt(target, val, sp) => cp_assign(emit_ctx, global_mut, pkg_decls, cur_pkg, ch, target, val, sp, cp_expr_ref),
            frontend::Node::ReturnStmt(val, sp) => cp_return_stmt(emit_ctx, ch, val, sp, cp_expr_ref),
            frontend::Node::WhileStmt(cond, body, sp) => cp_while(emit_ctx, ch, cond, body, sp, cp_expr_ref, cp_stmt_ref),
            frontend::Node::ForStmt(v, _, idx, _, iter, _, body, sp) => cp_for_stmt(emit_ctx, chan_fors, cur_file, ch, v, idx, iter, body, sp, cp_expr_ref, cp_stmt_ref),
            frontend::Node::BreakStmt(lb, sp) => cp_break_stmt(emit_ctx, ch, lb, sp),
            frontend::Node::ContinueStmt(lb, sp) => cp_continue_stmt(emit_ctx, ch, lb, sp),
            frontend::Node::LabelStmt(lb, inner, _) => cp_label_stmt(emit_ctx, ch, lb, inner, cp_stmt_ref),
            frontend::Node::SpawnStmt(call, sp) => cp_spawn_stmt(emit_ctx, ch, call, sp, cp_expr_ref),
            frontend::Node::DeferStmt(body, crefs, sp) => cp_defer_stmt(emit_ctx, cur_file, ch, body, crefs, sp, cp_expr_ref, cp_stmt_ref),
            frontend::Node::SendStmt(cch, val, sp) => cp_send_stmt(emit_ctx, ch, cch, val, sp, cp_expr_ref),
            frontend::Node::SelectStmt(arms, has_default, dflt, dsp, sp) => cp_select(emit_ctx, ch, arms, has_default, dflt, dsp, sp, cp_expr_ref),
            _ => Ok(true),
        }
    }
    cp_stmt_ref = cp_stmt

    // 内建枚举与 native 预注册：Option/Result/Output + 全局名表
    // Builtin enums and native pre-registration: Option/Result/Output plus the global name table
    declare_enum(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, "Option", "", ["Some", "None"], [1, 0])
    declare_enum(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, "Result", "", ["Ok", "Err"], [1, 1])
    declare_enum(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, "Output", "", ["Output"], [3])
    for n in lib::native_names {
        put(global_mut, n, false)
    }

    // 包模式：建 <module> 帧，逐包注册枚举后按依赖编译顶层语句
    // Package mode: a <module> frame, per-package enum registration, then
    // top-level compilation in dependency order
    if is_pkg {
        let module_fn = new_func(emit_ctx, "<module>", "", 0)
        let c0 = new_compiler(emit_ctx, -1, module_fn)
        push_local(emit_ctx, c0, "", 0, 0, false, 0)
        let n_pkgs = len(pkgs_stmts)
        let mut pi = 0
        while pi < n_pkgs {
            cur_pkg = pkg_paths[pi]
            let files_stmts = pkgs_stmts[pi]
            let file_paths = pkgs_fpaths[pi]
            let file_imports = pkgs_imports[pi]
            let n_files = len(files_stmts)
            pkg_decls = map()
            // 先收声明名（函数/枚举/let），供跨文件引用解析
            // Collect declared names (fn/enum/let) first, for cross-file reference resolution
            let mut fi = 0
            while fi < n_files {
                for s in files_stmts[fi] {
                    match s {
                        frontend::Node::FnDecl(name, _, _, _, _) => put(pkg_decls, name, true),
                        frontend::Node::EnumDecl(name, _, _, _, _) => put(pkg_decls, name, true),
                        frontend::Node::LetStmt(name, _, _, _, _, _, _) => put(pkg_decls, name, true),
                        _ => {},
                    }
                }
                fi = fi + 1
            }
            fi = 0
            while fi < n_files {
                cur_file = file_paths[fi]
                // 注册枚举：变体表与构造器
                // Register enums: variant tables and constructors
                for s in files_stmts[fi] {
                    match s {
                        frontend::Node::EnumDecl(name, _, variants, _, sp) => {
                            match register_enum_decl(en_qual, en_vnames, en_varities, en_prefix, enum_by, global_mut, cur_pkg, c0, name, variants, sp) {
                                Ok(_) => {},
                                Err(d) => {
                                    return CompileFailed(d, cur_file)
                                },
                            }
                        },
                        _ => {},
                    }
                }
                fi = fi + 1
            }
            fi = 0
            while fi < n_files {
                cur_file = file_paths[fi]
                cur_aliases = frontend::aliases_of(file_imports[fi])
                let sub_fn = new_func(emit_ctx, "<init>", cur_file, 0)
                let sub = new_compiler(emit_ctx, -1, sub_fn)
                push_local(emit_ctx, sub, "", 0, 0, false, 0)
                for s in files_stmts[fi] {
                    match cp_stmt(sub, s) {
                        Ok(_) => {},
                        Err(d) => {
                            return CompileFailed(d, cur_file)
                        },
                    }
                }
                emit(emit_ctx, sub, lib::op_unit, frontend::SpanT::Sp(0, 0))
                emit(emit_ctx, sub, lib::op_return, frontend::SpanT::Sp(0, 0))
                let idx = add_const(emit_ctx, c0, lib::CVal::CFn(sub_fn))
                emit(emit_ctx, c0, lib::op_closure, frontend::SpanT::Sp(0, 0))
                emit_u16(emit_ctx, c0, idx, frontend::SpanT::Sp(0, 0))
                emit(emit_ctx, c0, lib::op_call, frontend::SpanT::Sp(0, 0))
                emit(emit_ctx, c0, 0, frontend::SpanT::Sp(0, 0))
                emit(emit_ctx, c0, lib::op_pop, frontend::SpanT::Sp(0, 0))
                fi = fi + 1
            }
            cur_aliases = map()
            pi = pi + 1
        }
        cur_file = ""
        cur_pkg = ""
        let idx = add_const(emit_ctx, c0, lib::CVal::CStr(pkg_paths[n_pkgs - 1] + ".main"))
        emit(emit_ctx, c0, lib::op_get_global, frontend::SpanT::Sp(0, 0))
        emit_u16(emit_ctx, c0, idx, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_call, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, 0, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_pop, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_unit, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_return, frontend::SpanT::Sp(0, 0))
    } else {
        let script_fn = new_func(emit_ctx, "<script>", "", 0)
        let c0 = new_compiler(emit_ctx, -1, script_fn)
        push_local(emit_ctx, c0, "", 0, 0, false, 0)
        for s in pkgs_stmts[0][0] {
            match cp_stmt(c0, s) {
                Ok(_) => {},
                Err(d) => {
                    return CompileFailed(d, "")
                },
            }
        }
        emit(emit_ctx, c0, lib::op_unit, frontend::SpanT::Sp(0, 0))
        emit(emit_ctx, c0, lib::op_return, frontend::SpanT::Sp(0, 0))
    }

    Compiled(f_name, f_file, f_arity, f_nupvals, f_code, f_spans, f_consts, en_qual, en_vnames, en_varities)
}

fn cp_assign(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, global_mut, pkg_decls, cur_pkg, ch, target, val, sp, cp_expr) {
    match target {
        frontend::Node::Ident(name, _) => {
            match cp_expr(ch, val) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            let li = resolve_local(ctx.c_l_name, ctx.c_l_slot, ch, name)
            if li >= 0 {
                if !ctx.c_l_mut[ch][li] {
                    return frontend::perr("E2010", "declare it with `let mut`", "cannot assign to immutable variable \"" + name + "\"", sp)
                }
                emit(ctx, ch, lib::op_set_local, sp)
                emit_u16(ctx, ch, ctx.c_l_slot[ch][li], sp)
            } else {
                let ui = resolve_upvalue(ctx, ch, name, sp)?
                if ui >= 0 {
                    if !ctx.c_u_mut[ch][ui] {
                        return frontend::perr("E2010", "declare it with `let mut`", "cannot assign to immutable variable \"" + name + "\"", sp)
                    }
                    emit(ctx, ch, lib::op_set_upval, sp)
                    emit_u16(ctx, ch, ui, sp)
                } else {
                    match get(global_mut, mangle_if_decl(pkg_decls, cur_pkg, name)) {
                        Some(is_mut) => {
                            if !is_mut {
                                return frontend::perr("E2010", "declare it with `let mut`", "cannot assign to immutable variable \"" + name + "\"", sp)
                            }
                            let idx = add_const(ctx, ch, lib::CVal::CStr(mangle_if_decl(pkg_decls, cur_pkg, name)))
                            emit(ctx, ch, lib::op_set_global, sp)
                            emit_u16(ctx, ch, idx, sp)
                        },
                        None => {
                            return frontend::perr("E2011", "", "cannot assign to undeclared variable \"" + name + "\"", sp)
                        },
                    }
                }
            }
            emit(ctx, ch, lib::op_pop, sp)
            Ok(true)
        },
        frontend::Node::Index(itarget, iidx, _) => {
            match cp_expr(ch, itarget) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            match cp_expr(ch, iidx) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            match cp_expr(ch, val) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] - 2
            emit(ctx, ch, lib::op_index_set, sp)
            Ok(true)
        },
        _ => frontend::perr("E2012", "", "invalid assignment target", sp),
    }
}

fn cp_block_stmts(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, blk, cp_stmt) {
    begin_scope(ctx, ch)
    match blk {
        frontend::Node::Block(ss, bsp) => {
            for s in ss {
                match cp_stmt(ch, s) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
            }
            end_scope(ctx, ch, bsp)
        },
        _ => {},
    }
    Ok(true)
}

fn cp_block_expr(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, blk, cp_expr, cp_stmt) {
    begin_scope(ctx, ch)
    match blk {
        frontend::Node::Block(ss, bsp) => {
            let n = len(ss)
            let mut produced = false
            let mut i = 0
            while i < n {
                let s = ss[i]
                let last_expr = if i == n - 1 {
                    match s {
                        frontend::Node::ExprStmt(_, _) => true,
                        _ => false,
                    }
                } else {
                    false
                }
                if last_expr {
                    match s {
                        frontend::Node::ExprStmt(e, _) => {
                            match cp_expr(ch, e) {
                                Ok(_) => {},
                                Err(d) => {
                                    return Err(d)
                                },
                            }
                            produced = true
                        },
                        _ => {},
                    }
                } else {
                    match cp_stmt(ch, s) {
                        Ok(_) => {},
                        Err(d) => {
                            return Err(d)
                        },
                    }
                }
                i = i + 1
            }
            if !produced {
                let last_diverges = if n > 0 {
                    match ss[n - 1] {
                        frontend::Node::BreakStmt(_, _) => true,
                        frontend::Node::ReturnStmt(_, _) => true,
                        _ => false,
                    }
                } else {
                    false
                }
                if !last_diverges {
                    emit(ctx, ch, lib::op_unit, bsp)
                }
            }
            end_scope_expr(ctx, ch, bsp)
        },
        _ => Ok(true),
    }
}

fn declare_enum(mut en_qual, mut en_vnames, mut en_varities, mut en_prefix, mut enum_by, mut global_mut, qual, prefix, vnames, varities) {
    push(en_qual, qual)
    push(en_vnames, vnames)
    push(en_varities, varities)
    push(en_prefix, prefix)
    put(enum_by, qual, len(en_qual) - 1)
    put(global_mut, qual, false)
    len(en_qual) - 1
}

fn next_slot(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch) {
    let n = n_locals(ctx.c_l_name, ch)
    if n > 0 {
        ctx.c_l_slot[ch][n - 1] + 1 + (ctx.c_temps[ch] - ctx.c_l_tempsbelow[ch][n - 1])
    } else {
        ctx.c_temps[ch]
    }
}

fn declare_local(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, name, is_mut, sp) {
    let slot = next_slot(ctx, ch)
    if slot > 65534 {
        return frontend::perr("E2003", "", "too many locals", sp)
    }
    push_local(ctx, ch, name, ctx.c_scope_depth[ch], slot, is_mut, ctx.c_temps[ch])
    Ok(true)
}

// CompileEmitCtx 平行表句柄（与 compile_program 局部 mut 列表共享堆）
// CompileEmitCtx holds parallel-table handles (shared heap with compile_program locals)
// 含 c_fn；勿对 ctx 标 mut（E0597）。
// Includes c_fn; do not mark ctx mut (E0597).

fn emit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, b, sp) {
    push(ctx.f_code[ctx.c_fn[ch]], b)
    push(ctx.f_spans[ctx.c_fn[ch]], sp)
}

fn emit_u16(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, v, sp) {
    emit(ctx, ch, v / 256, sp)
    emit(ctx, ch, v % 256, sp)
}

fn code_len(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch) {
    len(ctx.f_code[ctx.c_fn[ch]])
}

fn add_const(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cv) {
    push(ctx.f_consts[ctx.c_fn[ch]], cv)
    len(ctx.f_consts[ctx.c_fn[ch]]) - 1
}

fn emit_const(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cv, sp) {
    let idx = add_const(ctx, ch, cv)
    emit(ctx, ch, lib::op_const, sp)
    emit_u16(ctx, ch, idx, sp)
}

fn emit_jump(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, op, sp) {
    emit(ctx, ch, op, sp)
    emit_u16(ctx, ch, 65535, sp)
    code_len(ctx, ch) - 2
}

fn patch_jump(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, at) {
    let dist = code_len(ctx, ch) - (at + 2)
    if dist > 65535 {
        return frontend::perr("E2001", "", "jump too large", frontend::SpanT::Sp(0, 0))
    }
    ctx.f_code[ctx.c_fn[ch]][at] = dist / 256
    ctx.f_code[ctx.c_fn[ch]][at + 1] = dist % 256
    Ok(true)
}

fn emit_loop(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, to, sp) {
    emit(ctx, ch, lib::op_loop, sp)
    let dist = code_len(ctx, ch) + 2 - to
    if dist > 65535 {
        return frontend::perr("E2002", "", "loop body too large", sp)
    }
    emit_u16(ctx, ch, dist, sp)
    Ok(true)
}

fn emit_variant(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, en_varities, ch, eh, idx, sp) {
    if en_varities[eh][idx] == 0 {
        emit_const(ctx, ch, lib::CVal::CSingleton(eh, idx), sp)
    } else {
        emit_const(ctx, ch, lib::CVal::CCtor(eh, idx), sp)
    }
}

fn emit_variant_of(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, en_vnames, en_qual, en_varities, ch, eh, variant, sp) {
    let mut i = 0
    while i < len(en_vnames[eh]) {
        if en_vnames[eh][i] == variant {
            emit_variant(ctx, en_varities, ch, eh, i, sp)
            return Ok(true)
        }
        i = i + 1
    }
    frontend::perr("E2016", "", "enum \"" + en_qual[eh] + "\" has no variant \"" + variant + "\"", sp)
}

fn emit_variant_test(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, eh, idx, scrut_slot, sp) {
    emit(ctx, ch, lib::op_get_local, sp)
    emit_u16(ctx, ch, scrut_slot, sp)
    emit_const(ctx, ch, lib::CVal::CEnumType(eh), sp)
    emit(ctx, ch, lib::op_test_variant, sp)
    emit(ctx, ch, idx, sp)
    Ok(emit_jump(ctx, ch, lib::op_jump_if_false_pop, sp))
}

fn end_scope(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, sp) {
    ctx.c_scope_depth[ch] = ctx.c_scope_depth[ch] - 1
    while n_locals(ctx.c_l_name, ch) > 0 && ctx.c_l_depth[ch][n_locals(ctx.c_l_name, ch) - 1] > ctx.c_scope_depth[ch] {
        if ctx.c_l_captured[ch][n_locals(ctx.c_l_name, ch) - 1] {
            emit(ctx, ch, lib::op_close_upvalue, sp)
        } else {
            emit(ctx, ch, lib::op_pop, sp)
        }
        pop_local(ctx, ch)
    }
}

fn end_scope_expr(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, sp) {
    ctx.c_scope_depth[ch] = ctx.c_scope_depth[ch] - 1
    let mut n = 0
    while n_locals(ctx.c_l_name, ch) > 0 && ctx.c_l_depth[ch][n_locals(ctx.c_l_name, ch) - 1] > ctx.c_scope_depth[ch] {
        n = n + 1
        pop_local(ctx, ch)
    }
    if n > 0 {
        if n > 255 {
            return frontend::perr("E2003", "", "too many locals in block", sp)
        }
        emit(ctx, ch, lib::op_end_block, sp)
        emit(ctx, ch, n, sp)
    }
    Ok(true)
}

// find_variant 查找变体 / find_variant finds a variant
fn find_variant(enum_by, en_prefix, en_vnames, cur_pkg, name) {
    let mut found = -1
    let mut idx = -1
    let mut amb = false
    for q in keys(enum_by) {
        match get(enum_by, q) {
            Some(eh) => {
                if en_prefix[eh] == cur_pkg || en_prefix[eh] == "" {
                    let mut i = 0
                    while i < len(en_vnames[eh]) {
                        if en_vnames[eh][i] == name {
                            if found >= 0 {
                                amb = true
                            }
                            found = eh
                            idx = i
                        }
                        i = i + 1
                    }
                }
            },
            None => {},
        }
    }
    if amb {
        [-2, -1]
    } else {
        [found, idx]
    }
}

// local_enum 查找本地枚举 / local_enum finds a local enum
fn local_enum(enum_by, en_prefix, cur_pkg, name) {
    match get(enum_by, qualify(cur_pkg, name)) {
        Some(eh) => eh,
        None => {
            match get(enum_by, name) {
                Some(eh) => if en_prefix[eh] == "" {
                    eh
                } else {
                    -1
                },
                None => -1,
            }
        },
    }
}

fn cp_ident(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, en_varities, en_vnames, _en_qual, en_prefix, enum_by, global_mut, pkg_decls, cur_pkg, ch, name, sp) {
    let li = resolve_local(ctx.c_l_name, ctx.c_l_slot, ch, name)
    if li >= 0 {
        emit(ctx, ch, lib::op_get_local, sp)
        emit_u16(ctx, ch, ctx.c_l_slot[ch][li], sp)
        return Ok(true)
    }
    let ui = resolve_upvalue(ctx, ch, name, sp)?
    if ui >= 0 {
        emit(ctx, ch, lib::op_get_upval, sp)
        emit_u16(ctx, ch, ui, sp)
        return Ok(true)
    }
    let gname = mangle_if_decl(pkg_decls, cur_pkg, name)
    let declared = match get(global_mut, gname) {
        Some(_) => true,
        None => false,
    }
    if !declared {
        let fv = find_variant(enum_by, en_prefix, en_vnames, cur_pkg, name)
        if fv[0] == -2 {
            return frontend::perr("E2014", "qualify it as Enum." + name, "variant \"" + name + "\" exists in several enums", sp)
        }
        if fv[1] >= 0 {
            emit_variant(ctx, en_varities, ch, fv[0], fv[1], sp)
            return Ok(true)
        }
    }
    let idx = add_const(ctx, ch, lib::CVal::CStr(gname))
    emit(ctx, ch, lib::op_get_global, sp)
    emit_u16(ctx, ch, idx, sp)
    Ok(true)
}

fn cp_variant_access(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, enum_by, en_prefix, en_vnames, en_qual, en_varities, cur_pkg, cur_aliases, ch, en, vr, sp) {
    let apath = alias_path(cur_aliases, en)
    if apath != "" {
        let idx = add_const(ctx, ch, lib::CVal::CStr(apath + "." + vr))
        emit(ctx, ch, lib::op_get_global, sp)
        emit_u16(ctx, ch, idx, sp)
        Ok(true)
    } else {
        let eh = local_enum(enum_by, en_prefix, cur_pkg, en)
        if eh < 0 {
            frontend::perr("E2017", "", "cannot find enum `" + en + "`", sp)
        } else {
            emit_variant_of(ctx, en_vnames, en_qual, en_varities, ch, eh, vr, sp)
        }
    }
}

fn cp_pkg_access(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, pkg, name, sp) {
    let idx = add_const(ctx, ch, lib::CVal::CStr(pkg + "." + name))
    emit(ctx, ch, lib::op_get_global, sp)
    emit_u16(ctx, ch, idx, sp)
    Ok(true)
}

fn cp_qual_variant_access(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, enum_by, en_vnames, en_qual, en_varities, cur_aliases, ch, pkg, en, vr, sp) {
    let apath = alias_path(cur_aliases, pkg)
    let full = if apath != "" {
        apath + "." + en
    } else {
        pkg + "." + en
    }
    let eh = match get(enum_by, full) {
        Some(h) => h,
        None => -1,
    }
    if eh < 0 {
        return frontend::perr("E2015", "", "unknown enum \"" + full + "\"", sp)
    }
    emit_variant_of(ctx, en_vnames, en_qual, en_varities, ch, eh, vr, sp)
}

fn cp_try_expr(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, inner, sp, cp_expr) {
    match cp_expr(ch, inner) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    emit(ctx, ch, lib::op_try, sp)
    Ok(true)
}

fn cp_recv_expr(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cch, sp, cp_expr) {
