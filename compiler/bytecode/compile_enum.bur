// compile_enum.bur — 变体/全局/枚举注册。
// compile_enum.bur — variant/global/enum register.


// find_variant 查找变体 / find_variant finds a variant
fn find_variant(enum_by, en_prefix, en_vnames, cur_pkg, name) {
    let mut found = -1
    let mut idx = -1
    let mut amb = false
    for q in keys(enum_by) {
        match get(enum_by, q) {
            Some(eh) => {
                if en_prefix[eh] == cur_pkg || en_prefix[eh] == "" {
                    let mut i = 0
                    while i < len(en_vnames[eh]) {
                        if en_vnames[eh][i] == name {
                            if found >= 0 {
                                amb = true
                            }
                            found = eh
                            idx = i
                        }
                        i = i + 1
                    }
                }
            },
            None => {},
        }
    }
    if amb {
        [-2, -1]
    } else {
        [found, idx]
    }
}
// local_enum 查找本地枚举 / local_enum finds a local enum
fn local_enum(enum_by, en_prefix, cur_pkg, name) {
    match get(enum_by, qualify(cur_pkg, name)) {
        Some(eh) => eh,
        None => {
            match get(enum_by, name) {
                Some(eh) => if en_prefix[eh] == "" {
                    eh
                } else {
                    -1
                },
                None => -1,
            }
        },
    }
}
