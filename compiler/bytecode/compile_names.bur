// compile_names.bur — 名字限定、别名、变体查找与全局/枚举注册。
// compile_names.bur — name qualification, aliases, variant lookup, global/enum registration.

// qualify 限定名字（跨包）/ qualify qualifies a name (cross-package)
fn qualify(cur_pkg, name) {
    if cur_pkg == "" {
        name
    } else {
        cur_pkg + "." + name
    }
}

// alias_path 解析 import 别名 / alias_path resolves an import alias
fn alias_path(cur_aliases, name) {
    match get(cur_aliases, name) {
        Some(p) => p,
        None => "",
    }
}
