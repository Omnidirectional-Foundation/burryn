// compile_stmt_let.bur — let / destruct / fn / method / enum 声明（CompileCtx）。
// compile_stmt_let.bur — let/destruct/fn/method/enum decls (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn cp_expr_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, e, sp, cp_expr) {
    match cp_expr(ch, e) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    emit(ctx, ch, lib::op_pop, sp)
    Ok(true)
}

fn cp_return_stmt(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, val, sp, cp_expr) {
    match val {
        frontend::Node::NoNode => emit(ctx, ch, lib::op_unit, sp),
        _ => {
            match cp_expr(ch, val) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
        },
    }
    emit(ctx, ch, lib::op_return, sp)
    Ok(true)
}
