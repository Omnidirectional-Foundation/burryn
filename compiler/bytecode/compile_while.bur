// compile_while.bur — while 代码生成（CompileCtx）。
// compile_while.bur — while codegen (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn cp_while(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cond, body, sp, cp_expr, cp_stmt) {
    let start = code_len(ctx, ch)
    push_loop(ctx, ch, next_slot(ctx, ch), start)
    match cp_expr(ch, cond) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let exit_j = emit_jump(ctx, ch, lib::op_jump_if_false_pop, sp)
    match cp_block_stmts(ctx, ch, body, cp_stmt) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    match emit_loop(ctx, ch, start, sp) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    match patch_jump(ctx, ch, exit_j) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let li = len(ctx.c_lp_breaks[ch]) - 1
    for j in ctx.c_lp_breaks[ch][li] {
        match patch_jump(ctx, ch, j) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    pop_loop(ctx, ch)
    Ok(true)
}
