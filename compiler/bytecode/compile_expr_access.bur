// compile_expr_access.bur — 变体/包访问、try/recv、record、字段（CompileCtx）。
// compile_expr_access.bur — variant/pkg access, try/recv, record, field (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn cp_variant_access(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, enum_by, en_prefix, en_vnames, en_qual, en_varities, cur_pkg, cur_aliases, ch, en, vr, sp) {
    let apath = alias_path(cur_aliases, en)
    if apath != "" {
        let idx = add_const(ctx, ch, lib::CVal::CStr(apath + "." + vr))
        emit(ctx, ch, lib::op_get_global, sp)
        emit_u16(ctx, ch, idx, sp)
        Ok(true)
    } else {
        let eh = local_enum(enum_by, en_prefix, cur_pkg, en)
        if eh < 0 {
            frontend::perr("E2017", "", "cannot find enum `" + en + "`", sp)
        } else {
            emit_variant_of(ctx, en_vnames, en_qual, en_varities, ch, eh, vr, sp)
        }
    }
}

fn cp_pkg_access(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, pkg, name, sp) {
    let idx = add_const(ctx, ch, lib::CVal::CStr(pkg + "." + name))
    emit(ctx, ch, lib::op_get_global, sp)
    emit_u16(ctx, ch, idx, sp)
    Ok(true)
}

fn cp_qual_variant_access(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, enum_by, en_vnames, en_qual, en_varities, cur_aliases, ch, pkg, en, vr, sp) {
    let apath = alias_path(cur_aliases, pkg)
    let full = if apath != "" {
        apath + "." + en
    } else {
        pkg + "." + en
    }
    let eh = match get(enum_by, full) {
        Some(h) => h,
        None => -1,
    }
    if eh < 0 {
        return frontend::perr("E2015", "", "unknown enum \"" + full + "\"", sp)
    }
    emit_variant_of(ctx, en_vnames, en_qual, en_varities, ch, eh, vr, sp)
}

fn cp_try_expr(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, inner, sp, cp_expr) {
    match cp_expr(ch, inner) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    emit(ctx, ch, lib::op_try, sp)
    Ok(true)
}

fn cp_recv_expr(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, cch, sp, cp_expr) {
    match cp_expr(ch, cch) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    emit(ctx, ch, lib::op_recv, sp)
    Ok(true)
}

fn cp_record_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, names, vals, sp, cp_expr) {
    let ord = field_sort_order(names)
    for k in ord {
        match cp_expr(ch, vals[k]) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    let mut enc = ""
    for k in ord {
        enc = enc + names[k] + "\n"
    }
    let cidx = add_const(ctx, ch, lib::CVal::CStr(enc))
    emit(ctx, ch, lib::op_record, sp)
    emit(ctx, ch, len(names), sp)
    emit_u16(ctx, ch, cidx, sp)
    Ok(true)
}

fn cp_record_update(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, base, names, vals, sp, cp_expr) {
    match cp_expr(ch, base) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let ord = field_sort_order(names)
    for k in ord {
        match cp_expr(ch, vals[k]) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
    }
    let mut enc = ""
    for k in ord {
        enc = enc + names[k] + "\n"
    }
    let cidx = add_const(ctx, ch, lib::CVal::CStr(enc))
    emit(ctx, ch, lib::op_record_update, sp)
    emit(ctx, ch, len(names), sp)
    emit_u16(ctx, ch, cidx, sp)
    Ok(true)
}

fn cp_field_access(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, base, field, sp, cp_expr) {
    match cp_expr(ch, base) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    let cidx = add_const(ctx, ch, lib::CVal::CStr(field))
    emit(ctx, ch, lib::op_get_field_name, sp)
    emit_u16(ctx, ch, cidx, sp)
    Ok(true)
}
