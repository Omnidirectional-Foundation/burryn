// compile_expr_call.bur — 调用/索引/元组/列表字面量（CompileCtx）。
// compile_expr_call.bur — call/index/tuple/list literals (CompileCtx).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn cp_call(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, method_calls, cur_file, ch, callee, cargs, sp, cp_expr) {
    let mut m_obj = frontend::Node::NoNode
    let mpath = match callee {
        frontend::Node::FieldAccess(obj, _, _) => {
            m_obj = obj
            let cend = match sp {
                frontend::SpanT::Sp(_, ce) => ce,
            }
            match get(method_calls, cur_file + ":" + str(cend)) {
                Some(p) => Some(p),
                None => None,
            }
        },
        _ => None,
    }
    match mpath {
        Some(p) => {
            let gidx = add_const(ctx, ch, lib::CVal::CStr(p))
            emit(ctx, ch, lib::op_get_global, sp)
            emit_u16(ctx, ch, gidx, sp)
            match cp_expr(ch, m_obj) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            for a in cargs {
                match cp_expr(ch, a) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] - (len(cargs) + 1)
            if len(cargs) + 1 > 255 {
                return frontend::perr("E2005", "", "too many arguments", sp)
            }
            emit(ctx, ch, lib::op_call, sp)
            emit(ctx, ch, len(cargs) + 1, sp)
            Ok(true)
        },
        None => {
            match cp_expr(ch, callee) {
                Ok(_) => {},
                Err(d) => {
                    return Err(d)
                },
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            for a in cargs {
                match cp_expr(ch, a) {
                    Ok(_) => {},
                    Err(d) => {
                        return Err(d)
                    },
                }
                ctx.c_temps[ch] = ctx.c_temps[ch] + 1
            }
            ctx.c_temps[ch] = ctx.c_temps[ch] - (len(cargs) + 1)
            if len(cargs) > 255 {
                return frontend::perr("E2005", "", "too many arguments", sp)
            }
            emit(ctx, ch, lib::op_call, sp)
            emit(ctx, ch, len(cargs), sp)
            Ok(true)
        },
    }
}

fn cp_index(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, target, idx, sp, cp_expr) {
    match cp_expr(ch, target) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] + 1
    match cp_expr(ch, idx) {
        Ok(_) => {},
        Err(d) => {
            return Err(d)
        },
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] - 1
    emit(ctx, ch, lib::op_index_get, sp)
    Ok(true)
}

fn cp_tuple_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, elems, sp, cp_expr) {
    for el in elems {
        match cp_expr(ch, el) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        ctx.c_temps[ch] = ctx.c_temps[ch] + 1
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] - len(elems)
    if len(elems) > 255 {
        return frontend::perr("E2006", "", "tuple literal too large", sp)
    }
    emit(ctx, ch, lib::op_tuple, sp)
    emit(ctx, ch, len(elems), sp)
    Ok(true)
}

fn cp_list_lit(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, elems, sp, cp_expr) {
    for el in elems {
        match cp_expr(ch, el) {
            Ok(_) => {},
            Err(d) => {
                return Err(d)
            },
        }
        ctx.c_temps[ch] = ctx.c_temps[ch] + 1
    }
    ctx.c_temps[ch] = ctx.c_temps[ch] - len(elems)
    if len(elems) > 65535 {
        return frontend::perr("E2006", "", "list literal too large", sp)
    }
    emit(ctx, ch, lib::op_list, sp)
    emit_u16(ctx, ch, len(elems), sp)
    Ok(true)
}
