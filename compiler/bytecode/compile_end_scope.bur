// compile_end_scope.bur — end_scope（CompileCtx 含 locals）。
// compile_end_scope.bur — end_scope (CompileCtx includes locals).

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

fn end_scope(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, sp) {
    ctx.c_scope_depth[ch] = ctx.c_scope_depth[ch] - 1
    while n_locals(ctx.c_l_name, ch) > 0 && ctx.c_l_depth[ch][n_locals(ctx.c_l_name, ch) - 1] > ctx.c_scope_depth[ch] {
        if ctx.c_l_captured[ch][n_locals(ctx.c_l_name, ch) - 1] {
            emit(ctx, ch, lib::op_close_upvalue, sp)
        } else {
            emit(ctx, ch, lib::op_pop, sp)
        }
        pop_local(ctx, ch)
    }
}

fn end_scope_expr(ctx: record { f_code: [[int]], f_spans: [[frontend::SpanT]], f_consts: [[lib::CVal]], c_fn: [int], c_l_name: [[str]], c_l_depth: [[int]], c_l_slot: [[int]], c_l_mut: [[bool]], c_l_captured: [[bool]], c_l_tempsbelow: [[int]], c_scope_depth: [int], c_lp_base: [[int]], c_lp_contto: [[int]], c_lp_breaks: [[[int]]], c_lp_conts: [[[int]]], c_lp_labels: [[str]], c_lbl_pending: [str], c_temps: [int], c_u_index: [[int]], c_u_islocal: [[bool]], c_u_mut: [[bool]], c_u_name: [[str]], c_enclosing: [int], f_nupvals: [int], f_name: [str], f_file: [str], f_arity: [int] }, ch, sp) {
    ctx.c_scope_depth[ch] = ctx.c_scope_depth[ch] - 1
    let mut n = 0
    while n_locals(ctx.c_l_name, ch) > 0 && ctx.c_l_depth[ch][n_locals(ctx.c_l_name, ch) - 1] > ctx.c_scope_depth[ch] {
        n = n + 1
        pop_local(ctx, ch)
    }
    if n > 0 {
        if n > 255 {
            return frontend::perr("E2003", "", "too many locals in block", sp)
        }
        emit(ctx, ch, lib::op_end_block, sp)
        emit(ctx, ch, n, sp)
    }
    Ok(true)
}
