// compile_resolve.bur — resolve_local。
// compile_resolve.bur — resolve_local.

// resolve_local 解析局部变量 / resolve_local resolves a local
fn resolve_local(c_l_name, _c_l_slot, ch, name) {
    let mut i = n_locals(c_l_name, ch) - 1
    let mut hit = -1
    while i >= 0 && hit < 0 {
        if c_l_name[ch][i] == name {
            hit = i
        }
        i = i - 1
    }
    hit
}
