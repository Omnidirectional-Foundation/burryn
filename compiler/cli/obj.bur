// cli/obj.bur — 目标文件名/清理。
// cli/obj.bur — object name / cleanup.



// obj_name .c 源文件路径 → 目标 .o 名 / obj_name maps a .c source path to its .o name
fn obj_name(c) {
    let b = base_name(c)
    if ends_with(b, ".c") {
        substr(b, 0, str_len(b) - 2) + ".o"
    } else {
        b + ".o"
    }
}

// cleanup_native 删除构建中间产物 / cleanup_native removes build intermediates
fn cleanup_native(files, objs, runtime_objs) {
    let mut rm_args = []
    for f in files {
        push(rm_args, f[0])
        if ends_with(f[0], ".c") {
            push(rm_args, obj_name(f[0]))
        }
    }
    for o in objs {
        push(rm_args, o)
    }
    for o in runtime_objs {
        push(rm_args, o)
    }
    match exec("rm", rm_args) {
        Ok(_) => {},
        Err(_) => {},
    }
}
