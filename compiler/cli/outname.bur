// cli/outname.bur — 默认输出名。
// cli/outname.bur — default output names.


// default_out_name 默认输出名（去 .bur 后缀）
// default_out_name derives the default output name (drop the .bur suffix)
fn default_out_name(path) {
    let p = strip_trailing_slash(path)
    let base = base_name(p)
    if ends_with(base, ".bur") {
        substr(base, 0, str_len(base) - 4)
    } else {
        base
    }
}

// base_name 取路径末段 / base_name returns the last path segment
fn base_name(p) {
    let mut start = 0
    let mut i = 0
    while i < str_len(p) {
        if char_at(p, i) == "/" {
            start = i + 1
        }
        i = i + 1
    }
    substr(p, start, str_len(p) - start)
}
