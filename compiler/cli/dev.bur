// cli/dev.bur — dev/mod/test 子命令。
// cli/dev.bur — dev/mod/test subcommands.

import "burryn.dev/compiler/lib"

// dev_cmd 隐藏 dev 子命令分派 / dev_cmd dispatches hidden dev subcommands
// dev_cmd 隐藏调试子命令：分段转储与内部入口
// dev_cmd hidden debug subcommands: staged dumps and internal entries
pub fn dev_cmd(rest) {
    // dev 隐藏子命令：lex/parse/check/dis 等分段转储
    // dev hidden subcommands: staged dumps (lex/parse/check/dis, ...)
    if len(rest) < 2 {
        eprintln("usage: bur dev <lex|parse|check|dis|emit-c> <file.bur>")
        eprintln("       bur dev <build-dir|run-dir> <dir>")
        exit(exit_usage)
    }
    let sub = rest[0]
    if sub == "build-dir" {
        dev_build_dir(rest[1])
        return
    }
    if sub == "run-dir" {
        run_module(rest[1], mode_run, slice(rest, 2, len(rest)))
        return
    }
    if sub == "run" {
        run_file(rest[1], mode_run, slice(rest, 2, len(rest)))
        return
    }
    if sub == "mod-graph" {
        dev_mod_graph(strip_trailing_slash(rest[1]))
        return
    }
    if sub == "interface" {
        dev_interface(strip_trailing_slash(rest[1]))
        return
    }
    if sub == "interface-parse" {
        dev_interface_parse(rest[1])
        return
    }
    if sub == "embed-std" {
        if len(rest) < 2 {
            eprintln("usage: bur dev embed-std <repo-root>")
            exit(exit_usage)
        }
        match lib::embed_std(strip_trailing_slash(rest[1])) {
            Ok(_) => {},
            Err(msg) => {
                eprintln("embed-std:", msg)
                exit(exit_static)
            },
        }
        return
    }
    if sub == "run-test" {
        if len(rest) < 3 {
            eprintln("usage: bur dev run-test <dir> <fn>")
            exit(exit_usage)
        }
        run_test_target(strip_trailing_slash(rest[1]), rest[2])
        return
    }
    if sub == "hover" {
        if len(rest) < 4 {
            eprintln("usage: bur dev hover <dir> <file> <offset>")
            exit(exit_usage)
        }
        dev_hover(strip_trailing_slash(rest[1]), rest[2], rest[3])
        return
    }
    let src = match read_file(rest[1]) {
        Ok(s) => s,
        Err(msg) => {
            println("error:", msg)
            exit(exit_no_input)
        },
    }
    if sub == "lex" {
        dev_lex(src)
    } else if sub == "parse" {
        dev_parse(src)
    } else if sub == "check" {
        dev_check(src)
    } else if sub == "dis" {
        dev_dis(src)
    } else if sub == "emit-c" {
        dev_emit_c(src, rest[1])
    } else if sub == "fmt" {
        dev_fmt(src)
    } else {
        println("unknown dev command:", sub)
        exit(exit_usage)
    }
}




