// cli/build.bur — build/compile/native。
// cli/build.bur — build/compile/native.

import "burryn.dev/compiler/backends/x86"
// build_cmd build 子命令 / build_cmd handles the build subcommand
// build_cmd 解析 build 参数（backend/输出），分派 C 或 x86 后端
// build_cmd parses build flags (backend/output), dispatching to the C or x86 backend
pub fn build_cmd(rest) {
    let mut out = ""
    let mut emit_c = false
    let mut backend = "c"
    let mut target_os_flag = "linux"
    let mut input = ""
    let mut i = 0
    while i < len(rest) {
        let arg = rest[i]
        if arg == "-o" {
            if i + 1 >= len(rest) {
                usage()
                exit(exit_usage)
            }
            out = rest[i + 1]
            i = i + 2
        } else if arg == "--emit" {
            if i + 1 >= len(rest) || rest[i + 1] != "c" {
                usage()
                exit(exit_usage)
            }
            emit_c = true
            i = i + 2
        } else if arg == "--backend" {
            if i + 1 >= len(rest) {
                usage()
                exit(exit_usage)
            }
            backend = rest[i + 1]
            i = i + 2
        } else if arg == "--os" {
            if i + 1 >= len(rest) {
                usage()
                exit(exit_usage)
            }
            target_os_flag = rest[i + 1]
            i = i + 2
        } else if starts_with(arg, "-") {
            usage()
            exit(exit_usage)
        } else {
            if input != "" {
                usage()
                exit(exit_usage)
            }
            input = arg
            i = i + 1
        }
    }
    if input == "" {
        usage()
        exit(exit_usage)
    }
    if target_os_flag != "linux" && target_os_flag != "windows" && target_os_flag != "darwin" {
        eprintln("error: unsupported --os '" + target_os_flag + "' (available: linux, windows, darwin)")
        exit(exit_usage)
    }
    if backend == "x86" {
        x86::set_target_os(target_os_flag)
    }
    build_input(input, emit_c, out, backend)
}

// build_input 解析 build 输入（文件/目录/backend） / build_input resolves the build input (file/dir/backend)
fn build_input(input, emit_c, out, backend) {
    if backend != "c" && backend != "x86" && backend != "llvm" && backend != "cranelift" && backend != "wasm" {
        eprintln("error: unknown backend '" + backend + "' (available: c, x86, llvm, cranelift, wasm)")
        exit(exit_usage)
    }
    if backend == "c" {
        let csrc = compile_to_c(input)
        if emit_c {
            let mut s = ""
            for f in csrc {
                s = s + f[1]
            }
            if out == "" || out == "-" {
                print(s)
            } else {
                match write_file(out, s) {
                    Ok(_) => {},
                    Err(msg) => {
                        eprintln("error: " + msg)
                        exit(exit_no_input)
                    },
                }
            }
        } else {
            let dst = if out == "" {
                default_out_name(input)
            } else {
                out
            }
            build_native(csrc, dst)
        }
    } else if backend == "x86" {
        let bytes = compile_to_x86(input)
        let dst = if out == "" {
            default_out_name(input)
        } else {
            out
        }
        match write_file(dst, bytes) {
            Ok(_) => {
                match exec("chmod", ["+x", dst]) {
                    Ok(o) => match o {
                        Output(code, _, _) => {
                            if code != 0 {
                                eprintln("error: chmod +x failed for " + dst)
                                exit(exit_static)
                            }
                        },
                    },
                    Err(msg) => {
                        eprintln("error: chmod failed: " + msg)
                        exit(exit_static)
                    },
                }
            },
            Err(msg) => {
                eprintln("error: " + msg)
                exit(exit_no_input)
            },
        }
    } else {
        eprintln("error: backend '" + backend + "' is not yet implemented")
        exit(exit_static)
    }
}


