// cli/testcmd.bur — test 子命令。
// cli/testcmd.bur — test subcommand.

import "burryn.dev/compiler/module"

// test_cmd test 子命令 / test_cmd handles the test subcommand
// test_cmd 测试子命令：发现/运行目标，汇总结果
// test_cmd runs tests: discovery, targets, summary
pub fn test_cmd(rest) {
    // 测试子命令：解析 --run/-v，发现并运行目标
    // Test subcommand: parse --run/-v, discover and run targets
    let mut dir = "."
    let mut run_filter = ""
    let mut verbose = false
    let mut i = 0
    while i < len(rest) {
        let a = rest[i]
        if a == "--run" {
            if i + 1 >= len(rest) {
                eprintln("usage: bur test [dir] [--run <substr>] [-v]")
                exit(exit_usage)
            }
            run_filter = rest[i + 1]
            i = i + 1
        } else if a == "-v" {
            verbose = true
        } else {
            dir = strip_trailing_slash(a)
        }
        i = i + 1
    }
    if !file_exists(dir + "/bur.mod") {
        eprintln("error: bur.mod not found in " + dir)
        exit(exit_no_input)
    }
    let mut all = []
    let mut all_dirs = []
    let mut all_fns = []
    for rel in module::test_walk(dir) {
        let pdir = if rel == "." {
            dir
        } else {
            dir + "/" + rel
        }
        match module::test_discover(pdir) {
            Ok(ns) => {
                for n in ns {
                    if rel == "." {
                        push(all, n)
                    } else {
                        push(all, rel + "/" + n)
                    }
                    push(all_dirs, pdir)
                    push(all_fns, n)
                }
            },
            Err(m) => {
                eprintln("error: " + m)
                exit(exit_no_input)
            },
        }
    }
    let mut selected = []
    let mut sel_dirs = []
    let mut sel_fns = []
    let mut ai = 0
    while ai < len(all) {
        if run_filter == "" || str_contains(all[ai], run_filter) {
            push(selected, all[ai])
            push(sel_dirs, all_dirs[ai])
            push(sel_fns, all_fns[ai])
        }
        ai = ai + 1
    }
    if len(selected) == 0 {
        println("no tests to run")
        return
    }
    let self_path = self_exe()
    if self_path == "" {
        eprintln("error: cannot resolve own binary via readlink /proc/self/exe")
        exit(exit_no_input)
    }
    let mut failed = 0
    let mut si = 0
    while si < len(selected) {
        let name = selected[si]
        match exec("env", ["BUR_DETERMINISTIC=1", self_path, "dev", "run-test", sel_dirs[si], sel_fns[si]]) {
            Ok(o) => match o {
                Output(code, so, se) => {
                    if code == 0 {
                        println("ok   " + name)
                        if verbose && so != "" {
                            print(so)
                        }
                    } else {
                        failed = failed + 1
                        println("FAIL " + name + " (exit " + str(code) + ")")
                        if so != "" {
                            print(so)
                        }
                        if trim(se) != "" {
                            println(trim(se))
                        }
                    }
                },
            },
            Err(m) => {
                failed = failed + 1
                println("FAIL " + name + ": " + m)
            },
        }
        si = si + 1
    }
    if failed == 0 {
        println("PASS  " + str(len(selected)) + " test(s)")
    } else {
        println("FAIL  " + str(failed) + " of " + str(len(selected)) + " test(s)")
        exit(exit_static)
    }
}
