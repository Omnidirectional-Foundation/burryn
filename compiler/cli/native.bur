// cli/native.bur — 本地链接构建。
// cli/native.bur — native link build.

// build_native 调 cc 产出原生二进制 / build_native invokes cc to produce a native binary
fn build_native(files, out) {
    for f in files {
        match write_file(f[0], f[1]) {
            Ok(_) => {},
            Err(msg) => {
                cleanup_native(files, [], [])
                eprintln("error: " + msg)
                exit(exit_no_input)
            },
        }
    }
    let cc = find_cc()
    if cc == "" {
        eprintln("error: no C compiler found (install clang/cc/gcc)")
        eprintln("hint: run without a toolchain using `bur run`")
        exit(exit_static)
    }
    let mut objs = []
    for f in files {
        if ends_with(f[0], ".c") {
            match exec(cc, ["-O1", "-g1", "-c", f[0], "-Iruntime"]) {
                Ok(o) => match o {
                    Output(code, _, err) => {
                        if code != 0 {
                            cleanup_native(files, objs, [])
                            eprint_raw(err)
                            eprintln("error: C compiler failed")
                            exit(exit_static)
                        }
                        push(objs, obj_name(f[0]))
                    },
                },
                Err(msg) => {
                    cleanup_native(files, objs, [])
                    eprintln("error: " + msg)
                    exit(exit_static)
                },
            }
        }
    }
    let mut runtime_objs = []
    for r in ["runtime/burrt_impl.c", "runtime/burrt_natives.c"] {
        match exec(cc, ["-O1", "-g1", "-c", r, "-Iruntime"]) {
            Ok(o) => match o {
                Output(code, _, err) => {
                    if code != 0 {
                        cleanup_native(files, objs, runtime_objs)
                        eprint_raw(err)
                        eprintln("error: C compiler failed")
                        exit(exit_static)
                    }
                    push(runtime_objs, obj_name(r))
                },
            },
            Err(msg) => {
                cleanup_native(files, objs, runtime_objs)
                eprintln("error: " + msg)
                exit(exit_static)
            },
        }
    }
    let mut args = ["-O1", "-g1", "-o", out]
    for o in objs {
        push(args, o)
    }
    for o in runtime_objs {
        push(args, o)
    }
    push(args, "-lm")
    let mut link_ok = false
    match exec(cc, args) {
        Ok(o) => match o {
            Output(code, _, err) => {
                if code != 0 {
                    eprint_raw(err)
                    eprintln("error: C compiler failed")
                } else {
                    link_ok = true
                }
            },
        },
        Err(msg) => {
            eprintln("error: " + msg)
        },
    }
    cleanup_native(files, objs, runtime_objs)
    if !link_ok {
        exit(exit_static)
    }
}
