// cli/testpath.bur — 测试路径工具。
// cli/testpath.bur — test path helpers.

// parent_dir 取父目录 / parent_dir returns the parent directory
fn parent_dir(p) {
    let mut cut = -1
    let mut i = 0
    while i < str_len(p) {
        if char_at(p, i) == "/" {
            cut = i
        }
        i = i + 1
    }
    if cut < 0 {
        if p == "." {
            ""
        } else {
            "."
        }
    } else if cut == 0 {
        if p == "/" {
            ""
        } else {
            "/"
        }
    } else {
        substr(p, 0, cut)
    }
}

// module_root_of 查找模块根（bur.mod 所在处） / module_root_of finds the module root (where bur.mod lives)
fn module_root_of(p0) {
    let mut p = strip_trailing_slash(p0)
    let mut root = ""
    let mut going = true
    while going {
        if file_exists(p + "/bur.mod") {
            root = p
            going = false
        } else {
            let d = parent_dir(p)
            if d == "" {
                going = false
            } else {
                p = d
            }
        }
    }
    root
}
