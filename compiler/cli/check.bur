// cli/check.bur — check 入口。
// cli/check.bur — check entry.

import "burryn.dev/compiler/tooling"

// run_check check 模式：类型检查 / run_check runs the typecheck mode
fn run_check(cdiags, path, binds) {
    let mut has_err = false
    for line in binds {
        println(line)
    }
    for d in cdiags {
        if diag_is_error(d) {
            has_err = true
        }
        println(tooling::render_diag(d, path))
    }
    has_err
}

// run_check_f 按文件 check / run_check_f checks per file
fn run_check_f(cdiags, cfiles, binds) {
    let mut has_err = false
    for line in binds {
        println(line)
    }
    let mut i = 0
    while i < len(cdiags) {
        if diag_is_error(cdiags[i]) {
            has_err = true
        }
        println(tooling::render_diag(cdiags[i], cfiles[i]))
        i = i + 1
    }
    has_err
}
