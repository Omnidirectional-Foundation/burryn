// cli/cc_works.bur — cc_works。
// cli/cc_works.bur — cc_works.

// cc_works 判断 cc 是否可用 / cc_works tells whether cc is usable
fn cc_works(name) {
    match exec(name, ["--version"]) {
        Ok(o) => match o {
            Output(code, _, _) => code == 0,
        },
        Err(_) => false,
    }
}
