// cli/mod.bur — mod/get 子命令。
// cli/mod.bur — mod/get subcommands.

import "burryn.dev/compiler/module"

// dev_mod_graph 处理 dev mod-graph / dev_mod_graph handles dev mod-graph
// dev_mod_graph 处理 dev mod-graph / dev_mod_graph handles dev mod-graph
fn dev_mod_graph(dir) {
    match module::mvs_resolve(dir) {
        Ok(pick) => {
            let root = module::cache_root()
            match pick {
                module::ModPick::MP(paths, vers) => {
                    let mut hashes = []
                    let mut i = 0
                    while i < len(paths) {
                        match module::tree_hash(root + "/" + paths[i] + "@" + vers[i]) {
                            Ok(h) => push(hashes, h),
                            Err(m) => {
                                eprintln("error: " + m)
                                exit(exit_static)
                            },
                        }
                        i = i + 1
                    }
                    print(module::sum_render(pick, hashes))
                },
            }
        },
        Err(m) => {
            eprintln("error: " + m)
            exit(exit_static)
        },
    }
}

// mod_report 打印模块报告 / mod_report prints a module report
fn mod_report(r) {
    match r {
        Ok(msg) => println(msg),
        Err(m) => {
            eprintln("error: " + m)
            exit(exit_static)
        },
    }
}
