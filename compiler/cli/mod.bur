// mod.bur — mod / get 子命令：init、tidy、download、verify 与依赖新增。
// The mod and get subcommands: init, tidy, download, verify and adding requires.

import "burryn.dev/compiler/module"
import "burryn.dev/compiler/lib"

// dev_mod_graph 处理 dev mod-graph / dev_mod_graph handles dev mod-graph
fn dev_mod_graph(dir) {
    match module::mvs_resolve(dir) {
        Ok(pick) => {
            let root = module::cache_root()
            match pick {
                module::ModPick::MP(paths, vers) => {
                    let mut hashes = []
                    let mut i = 0
                    while i < len(paths) {
                        match module::tree_hash(root + "/" + paths[i] + "@" + vers[i]) {
                            Ok(h) => push(hashes, h),
                            Err(m) => {
                                eprintln("error: " + m)
                                exit(exit_static)
                            },
                        }
                        i = i + 1
                    }
                    print(module::sum_render(pick, hashes))
                },
            }
        },
        Err(m) => {
            eprintln("error: " + m)
            exit(exit_static)
        },
    }
}

// mod_report 打印模块报告 / mod_report prints a module report
fn mod_report(r) {
    match r {
        Ok(msg) => println(msg),
        Err(m) => {
            eprintln("error: " + m)
            exit(exit_static)
        },
    }
}

// mod_cmd mod 子命令 / mod_cmd handles the mod subcommand
pub fn mod_cmd(rest) {
    if len(rest) == 0 {
        eprintln("usage: bur mod <init|tidy|download|verify> [args]")
        exit(exit_usage)
    }
    let sub = rest[0]
    let dir = if len(rest) >= 2 {
        lib::strip_trailing_slash(rest[1])
    } else {
        "."
    }
    if sub == "init" {
        if len(rest) != 2 {
            eprintln("usage: bur mod init <module-path>")
            exit(exit_usage)
        }
        if file_exists("bur.mod") {
            eprintln("error: bur.mod already exists")
            exit(exit_static)
        }
        match module::mod_init_text(rest[1]) {
            Ok(text) => match write_file("bur.mod", text) {
                Ok(_) => {},
                Err(m) => {
                    eprintln("error: " + m)
                    exit(exit_no_input)
                },
            },
            Err(m) => {
                eprintln("error: " + m)
                exit(exit_usage)
            },
        }
    } else if sub == "tidy" {
        mod_report(module::mod_tidy(dir))
    } else if sub == "download" {
        mod_report(module::mod_download(dir))
    } else if sub == "verify" {
        mod_report(module::mod_verify(dir))
    } else {
        eprintln("unknown mod command: " + sub)
        exit(exit_usage)
    }
}

// get_cmd get 子命令 / get_cmd handles the get subcommand
pub fn get_cmd(rest) {
    if len(rest) != 1 {
        eprintln("usage: bur get <path>@<version>")
        exit(exit_usage)
    }
    mod_report(module::mod_get(".", rest[0]))
}
