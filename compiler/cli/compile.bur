// cli/compile.bur — 源到 C/x86 编译路径。
// cli/compile.bur — source-to-C/x86 compile paths.

// compile_to_c 编译为 C（--emit c 或默认路径） / compile_to_c compiles to C (--emit c or the default path)
fn compile_to_c(input) {
    if is_dir(input) {
        compile_module_to_c(strip_trailing_slash(input))
    } else {
        compile_file_to_c(input)
    }
}
