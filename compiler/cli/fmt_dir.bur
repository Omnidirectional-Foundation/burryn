// cli/fmt_dir.bur — 目录 fmt。
// cli/fmt_dir.bur — directory fmt.

// fmt_dir 格式化目录 / fmt_dir formats a directory
fn fmt_dir(dir, check_only, mut state) {
    match read_dir(dir) {
        Ok(names) => {
            for n in names {
                if !starts_with(n, ".") {
                    let p = dir + "/" + n
                    if ends_with(n, ".bur") {
                        fmt_one(p, check_only, state)
                    } else {
                        match read_dir(p) {
                            Ok(_) => fmt_dir(p, check_only, state),
                            Err(_) => {},
                        }
                    }
                }
            }
        },
        Err(msg) => {
            eprintln("error: " + msg)
            exit(exit_no_input)
        },
    }
}
