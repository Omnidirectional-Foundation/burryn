// fmt.bur — fmt 子命令：文件、目录与 stdin 三条路径。
// The fmt subcommand over files, directories and stdin.

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/tooling"
import "burryn.dev/compiler/frontend"

// fmt_cmd 处理 fmt 子命令：文件/目录/stdin 与 --check
// fmt_cmd handles the fmt subcommand: file/dir/stdin and --check
pub fn fmt_cmd(rest) {
    let mut check_only = false
    let mut targets = []
    for a in rest {
        if a == "--check" {
            check_only = true
        } else {
            push(targets, a)
        }
    }
    if len(targets) == 0 {
        usage()
        exit(exit_usage)
    }
    let mut state = [0, 0]
    for t in targets {
        if t == "-" {
            fmt_stdin(state)
        } else if lib::str_has_suffix(t, ".bur") {
            fmt_one(t, check_only, state)
        } else {
            fmt_dir(lib::strip_trailing_slash(t), check_only, state)
        }
    }
    if state[1] > 0 || check_only && state[0] > 0 {
        exit(exit_static)
    }
}

// fmt_source 格式化单个源码 / fmt_source formats one source
fn fmt_source(path, src, mut state) {
    match frontend::lex(src) {
        lib::LexOut::Lexed(toks, ldiags, comments) => {
            if len(ldiags) > 0 {
                let _ = emit_errors(ldiags, path, false)
                state[1] = 1
                return None
            }
            match frontend::parse(toks) {
                frontend::ParseOut::Parsed(stmts, pdiags) => {
                    if len(pdiags) > 0 {
                        let _ = emit_errors(pdiags, path, false)
                        state[1] = 1
                        return None
                    }
                    match tooling::format_verified(stmts, src, comments) {
                        Ok(out) => Some(out),
                        Err(msg) => {
                            eprintln("internal error: " + msg)
                            exit(4)
                        },
                    }
                },
            }
        },
    }
}

// fmt_dir 格式化目录 / fmt_dir formats a directory
fn fmt_dir(dir, check_only, mut state) {
    match read_dir(dir) {
        Ok(names) => {
            for n in names {
                if !lib::str_has_prefix(n, ".") {
                    let p = dir + "/" + n
                    if lib::str_has_suffix(n, ".bur") {
                        fmt_one(p, check_only, state)
                    } else {
                        match read_dir(p) {
                            Ok(_) => fmt_dir(p, check_only, state),
                            Err(_) => {},
                        }
                    }
                }
            }
        },
        Err(msg) => {
            eprintln("error: " + msg)
            exit(exit_no_input)
        },
    }
}

// fmt_one 格式化单个文件 / fmt_one formats one file
fn fmt_one(path, check_only, mut state) {
    let src = match read_file(path) {
        Ok(s) => s,
        Err(msg) => {
            eprintln("error: " + msg)
            exit(exit_no_input)
        },
    }
    match fmt_source(path, src, state) {
        Some(out) => {
            if out != src {
                if check_only {
                    println(path)
                    state[0] = 1
                } else {
                    match write_file(path, out) {
                        Ok(_) => {},
                        Err(msg) => {
                            eprintln("error: " + msg)
                            exit(exit_no_input)
                        },
                    }
                }
            }
        },
        None => {},
    }
}

// fmt_stdin 格式化 stdin / fmt_stdin formats stdin
fn fmt_stdin(mut state) {
    let src = match read_file("/dev/stdin") {
        Ok(s) => s,
        Err(msg) => {
            eprintln("error: " + msg)
            exit(exit_no_input)
        },
    }
    match fmt_source("<stdin>", src, state) {
        Some(out) => print(out),
        None => {},
    }
}
