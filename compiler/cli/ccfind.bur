// cli/ccfind.bur — 查找 C 编译器。
// cli/ccfind.bur — find C compiler.



// eprint_raw 原样打印到 stderr / eprint_raw prints verbatim to stderr
fn eprint_raw(s) {
    if str_len(s) > 0 {
        eprintln(s)
    }
}

// find_cc 探测 clang/cc/gcc / find_cc probes for clang/cc/gcc
// clang 优先：自举链编 program.c 的峰值内存约为 gcc 一半（实测 2.0GB vs 3.8GB），
// 8GB 级机器上「编译器进程 + cc 子进程」叠加时 clang 可全程存活，gcc 必 OOM。
// clang first: peak RSS compiling the bootstrap's program.c is about half of
// gcc's (measured 2.0GB vs 3.8GB); on 8GB boxes clang survives the compiler-
// process-plus-cc overlap that OOM-kills gcc.
fn find_cc() {
    let candidates = ["clang", "cc", "gcc"]
    let mut found = ""
    for name in candidates {
        if found == "" && cc_works(name) {
            found = name
        }
    }
    found
}

