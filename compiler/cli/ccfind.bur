// cli/ccfind.bur — 查找 C 编译器。
// cli/ccfind.bur — find C compiler.



// eprint_raw 原样打印到 stderr / eprint_raw prints verbatim to stderr
fn eprint_raw(s) {
    if str_len(s) > 0 {
        eprintln(s)
    }
}

// find_cc 探测 cc/gcc/clang / find_cc probes for cc/gcc/clang
fn find_cc() {
    let candidates = ["cc", "gcc", "clang"]
    let mut found = ""
    for name in candidates {
        if found == "" && cc_works(name) {
            found = name
        }
    }
    found
}

