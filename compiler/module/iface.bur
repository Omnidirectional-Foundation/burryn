// iface.bur — 包 interface 文件（导出签名）的扁平化与查询。
// Package interface files (exported signatures): flattening and lookup.
import "burryn.dev/compiler/frontend"




// typecheck_cached 带缓存类型检查 / typecheck_cached typechecks with cache
pub fn typecheck_cached(pkgs_stmts, pkgs_fpaths, pkg_paths, pkgs_imports, pkg_ids) {
    let n = len(pkg_paths)
    let mut hits = []
    let mut any_hit = false
    let mut in_stmts = []
    let mut in_fpaths = []
    let mut in_imports = []
    let mut side_chans = []
    let mut i = 0
    while i < n {
        let mut used = false
        if pkg_ids[i] != "" && len(pkgs_fpaths[i]) > 0 {
            used = iface_try_load(pkg_ids[i], pkg_paths[i], in_stmts, in_fpaths, in_imports, side_chans)
        }
        if used {
            any_hit = true
        } else {
            push(in_stmts, pkgs_stmts[i])
            push(in_fpaths, pkgs_fpaths[i])
            push(in_imports, pkgs_imports[i])
            push(side_chans, [])
        }
        push(hits, used)
        i = i + 1
    }
    if any_hit {
        let r = frontend::typecheck_program(in_stmts, in_fpaths, true, pkg_paths, in_imports)
        if !iface_has_err(r) {
            iface_store(r, pkgs_fpaths, pkg_paths, pkg_ids, hits)
            return iface_merge_chans(r, pkgs_fpaths, hits, side_chans)
        }
    }
    let full = frontend::typecheck_program(pkgs_stmts, pkgs_fpaths, true, pkg_paths, pkgs_imports)
    let mut miss = []
    i = 0
    while i < n {
        push(miss, false)
        i = i + 1
    }
    iface_store(full, pkgs_fpaths, pkg_paths, pkg_ids, miss)
    full
}
