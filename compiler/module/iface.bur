// iface.bur — 包接口文件：读写 .iface 缓存，供跨包类型检查复用。
// Package interface files: the .iface cache read and written for cross-package checking.

import "burryn.dev/compiler/frontend"
import "burryn.dev/compiler/lib"

// typecheck_cached 带缓存类型检查 / typecheck_cached typechecks with cache
pub fn typecheck_cached(pkgs_stmts, pkgs_fpaths, pkg_paths, pkgs_imports, pkg_ids) {
    let n = len(pkg_paths)
    let mut hits = []
    let mut any_hit = false
    let mut in_stmts = []
    let mut in_fpaths = []
    let mut in_imports = []
    let mut side_chans = []
    let mut i = 0
    while i < n {
        let mut used = false
        if pkg_ids[i] != "" && len(pkgs_fpaths[i]) > 0 {
            used = iface_try_load(pkg_ids[i], pkg_paths[i], in_stmts, in_fpaths, in_imports, side_chans)
        }
        if used {
            any_hit = true
        } else {
            push(in_stmts, pkgs_stmts[i])
            push(in_fpaths, pkgs_fpaths[i])
            push(in_imports, pkgs_imports[i])
            push(side_chans, [])
        }
        push(hits, used)
        i = i + 1
    }
    if any_hit {
        let r = frontend::typecheck_program(in_stmts, in_fpaths, true, pkg_paths, in_imports)
        if !iface_has_err(r) {
            iface_store(r, pkgs_fpaths, pkg_paths, pkg_ids, hits)
            return iface_merge_chans(r, pkgs_fpaths, hits, side_chans)
        }
    }
    let full = frontend::typecheck_program(pkgs_stmts, pkgs_fpaths, true, pkg_paths, pkgs_imports)
    let mut miss = []
    i = 0
    while i < n {
        push(miss, false)
        i = i + 1
    }
    iface_store(full, pkgs_fpaths, pkg_paths, pkg_ids, miss)
    full
}

// iface_cache_dir 取接口缓存目录 / iface_cache_dir returns the interface cache directory
fn iface_cache_dir(id) {
    cache_root() + "/.interfaces/" + id
}

// iface_dirname 取接口目录名 / iface_dirname returns the interface dirname
fn iface_dirname(p) {
    let mut cut = -1
    let mut i = 0
    while i < str_len(p) {
        if char_at(p, i) == "/" {
            cut = i
        }
        i = i + 1
    }
    if cut < 0 {
        ""
    } else {
        substr(p, 0, cut)
    }
}

// iface_try_load 尝试加载缓存的接口 / iface_try_load tries loading a cached interface
fn iface_try_load(id, pkg_path, mut o_stmts, mut o_fpaths, mut o_imports, mut o_chans) {
    let base = iface_cache_dir(id) + "/" + iface_flat_pkg(pkg_path)
    let src = match read_file(base + ".buri") {
        Ok(s) => s,
        Err(_) => {
            return false
            ""
        },
    }
    let meta = match read_file(base + ".meta") {
        Ok(s) => s,
        Err(_) => {
            return false
            ""
        },
    }
    let mlines = split(meta, "\n")
    if len(mlines) == 0 || mlines[0] != "buri1" {
        return false
    }
    let mut entries = []
    let mut mi = 1
    while mi < len(mlines) {
        if mlines[mi] != "" {
            if !str_contains(mlines[mi], ":") {
                return false
            }
            push(entries, mlines[mi])
        }
        mi = mi + 1
    }
    match frontend::lex(src) {
        lib::LexOut::Lexed(toks, ldiags, _) => {
            if len(ldiags) > 0 {
                return false
            }
            match frontend::parse_interface(toks) {
                frontend::ParseOut::Parsed(stmts, pdiags) => {
                    if len(pdiags) > 0 {
                        return false
                    }
                    let mut imps = []
                    let mut kept = []
                    let mut imports_done = false
                    for s in stmts {
                        match s {
                            frontend::Node::ImportDecl(_, _, _, _, _) => {
                                if imports_done {
                                    return false
                                }
                                push(imps, s)
                            },
                            _ => {
                                imports_done = true
                                push(kept, s)
                            },
                        }
                    }
                    let mut rdiags = []
                    let mut rfiles = []
                    let decls = resolve_file_tes(kept, frontend::aliases_of(imps), pkg_path, base + ".buri", rdiags, rfiles)
                    if len(rdiags) > 0 {
                        return false
                    }
                    push(o_stmts, [decls])
                    push(o_fpaths, [base + ".buri"])
                    push(o_imports, [imps])
                    push(o_chans, entries)
                    true
                },
            }
        },
    }
}

// iface_has_err 判断结果是否错误 / iface_has_err tells whether the result is an error
fn iface_has_err(r) {
    match r {
        lib::CheckOut::Checked(diags, _, _, _, _) => {
            let mut has = false
            for d in diags {
                match d {
                    lib::DiagT::Diag(ie, _, _, _, _, _) => {
                        if ie {
                            has = true
                        }
                    },
                    lib::DiagT::DiagX(ie, _, _, _, _, _, _, _) => {
                        if ie {
                            has = true
                        }
                    },
                }
            }
            has
        },
    }
}

// iface_flat_pkg 展开包接口：递归收集子包签名
// iface_flat_pkg flattens a package interface: collect subpackage signatures recursively
fn iface_flat_pkg(path) {
    let mut out = ""
    let mut i = 0
    while i < str_len(path) {
        let c = char_at(path, i)
        if c == "/" {
            out = out + "@"
        } else {
            out = out + c
        }
        i = i + 1
    }
    out
}

// iface_store 存入缓存 / iface_store stores into the cache
fn iface_store(r, pkgs_fpaths, pkg_paths, pkg_ids, hits) {
    if iface_has_err(r) {
        return
    }
    match r {
        lib::CheckOut::Checked(_, _, _, chan_fors, ifaces) => {
            let mut i = 0
            while i < len(pkg_paths) {
                if pkg_ids[i] != "" && !hits[i] && len(pkgs_fpaths[i]) > 0 {
                    iface_write_pkg(pkg_ids[i], pkg_paths[i], iface_dirname(pkgs_fpaths[i][0]), ifaces[i], chan_fors)
                }
                i = i + 1
            }
        },
    }
}

// iface_merge_chans 合并 channel 类型信息 / iface_merge_chans merges channel type info
fn iface_merge_chans(r, pkgs_fpaths, hits, side_chans) {
    match r {
        lib::CheckOut::Checked(diags, dfiles, binds, chan_fors, ifaces) => {
            let mut merged = []
            for e in chan_fors {
                push(merged, e)
            }
            let mut i = 0
            while i < len(hits) {
                if hits[i] && len(pkgs_fpaths[i]) > 0 {
                    let pkgdir = iface_dirname(pkgs_fpaths[i][0])
                    for e in side_chans[i] {
                        push(merged, pkgdir + "/" + e)
                    }
                }
                i = i + 1
            }
            lib::CheckOut::Checked(diags, dfiles, binds, merged, ifaces)
        },
    }
}

// iface_write_atomic 原子写文件 / iface_write_atomic writes a file atomically
fn iface_write_atomic(path, content) {
    match write_file(path + ".tmp", content) {
        Ok(_) => {
            let _ = exec("mv", ["-f", path + ".tmp", path])
        },
        Err(_) => {},
    }
}

// iface_write_pkg 写包接口 / iface_write_pkg writes a package interface
fn iface_write_pkg(id, pkg_path, pkgdir, iface_src, chan_fors) {
    let _ = exec("mkdir", ["-p", iface_cache_dir(id)])
    let prefix = pkgdir + "/"
    let mut meta = "buri1\n"
    for e in chan_fors {
        if lib::str_has_prefix(e, prefix) {
            let rest = substr(e, str_len(prefix), str_len(e) - str_len(prefix))
            if !str_contains(rest, "/") {
                meta = meta + rest + "\n"
            }
        }
    }
    let base = iface_cache_dir(id) + "/" + iface_flat_pkg(pkg_path)
    iface_write_atomic(base + ".meta", meta)
    iface_write_atomic(base + ".buri", iface_src)
}
