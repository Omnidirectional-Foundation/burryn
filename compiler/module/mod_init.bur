// mod_init.bur — bur.mod 初始化文本。
// mod_init.bur — bur.mod init text.


// mod_init_text 生成 bur.mod 初始化文本 / mod_init_text builds the bur.mod init text
pub fn mod_init_text(mpath) {
    if !valid_import_path(mpath) {
        Err("invalid module path \"" + mpath + "\"")
    } else {
        Ok("module " + mpath + "\n")
    }
}
