// mod_mvs_resolve.bur — MVS 解析入口。
// mod_mvs_resolve.bur — MVS resolve entry.


// mvs_resolve 是依赖解析入口 / mvs_resolve is the dependency resolution entry
pub fn mvs_resolve(dir) {
    mvs_walk(dir, false)
}

// mvs_resolve_fetch 解析并拉取 / mvs_resolve_fetch resolves and fetches
pub fn mvs_resolve_fetch(dir) {
    mvs_walk(dir, true)
}
