// mod_ver.bur — 版本比较与 cache root。
// mod_ver.bur — version compare and cache root.

import "burryn.dev/compiler/lib"

// ver_cmp 语义版本比较 / ver_cmp compares semantic versions
pub fn ver_cmp(a, b) {
    let pa = ver_parts(a)
    let pb = ver_parts(b)
    let mut i = 0
    while i < 3 {
        if pa[i] < pb[i] {
            return -1
        }
        if pa[i] > pb[i] {
            return 1
        }
        i = i + 1
    }
    0
}

// ver_parts 拆分版本号 / ver_parts splits a version into parts
fn ver_parts(v) {
    let s = if lib::str_has_prefix(v, "v") {
        substr(v, 1, str_len(v) - 1)
    } else {
        v
    }
    let bits = split(s, ".")
    let mut out = []
    let mut i = 0
    while i < 3 {
        if i < len(bits) {
            match parse_int(bits[i]) {
                Some(n) => push(out, n),
                None => push(out, 0),
            }
        } else {
            push(out, 0)
        }
        i = i + 1
    }
    out
}

