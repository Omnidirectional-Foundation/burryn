// mod_collect.bur — 收集文件/哈希。
// mod_collect.bur — collect files/hashes.

import "burryn.dev/compiler/lib"

// collect_files 递归收集文件 / collect_files recursively collects files
fn collect_files(root, rel, mut acc) {
    let dir = if rel == "" {
        root
    } else {
        root + "/" + rel
    }
    match read_dir(dir) {
        Ok(names) => {
            for n in names {
                if !lib::str_has_prefix(n, ".") {
                    let r = if rel == "" {
                        n
                    } else {
                        rel + "/" + n
                    }
                    match read_dir(dir + "/" + n) {
                        Ok(_) => collect_files(root, r, acc),
                        Err(_) => push(acc, r),
                    }
                }
            }
        },
        Err(_) => {},
    }
}


// mod_hashes 模块文件哈希 / mod_hashes hashes module files
fn mod_hashes(pick, root) {
    match pick {
        MP(paths, vers) => {
            let mut hs = []
            let mut i = 0
            while i < len(paths) {
                let h = tree_hash(root + "/" + paths[i] + "@" + vers[i])?
                push(hs, h)
                i = i + 1
            }
            Ok(hs)
        },
    }
}
