// mod_valid.bur — 路径/常量校验。
// mod_valid.bur — path/const validation.

import "burryn.dev/compiler/lib"

// iface_id_of 生成接口缓存 id / iface_id_of derives the interface cache id
fn iface_id_of(hash) {
    let mut out = ""
    let mut i = 0
    while i < str_len(hash) {
        let c = char_at(hash, i)
        if c == "+" {
            out = out + "-"
        } else if c == "/" {
            out = out + "_"
        } else if c == "=" || c == ":" {} else {
            out = out + c
        }
        i = i + 1
    }
    lib::toolchain_version + "-" + out
}

// valid_import_path 校验 import 路径 / valid_import_path validates an import path
fn valid_import_path(p) {
    if p == "" || lib::str_has_prefix(p, "/") || str_ends_with(p, "/") {
        false
    } else {
        let mut ok = true
        for el in split(p, "/") {
            if el == "" || el == "." || el == ".." {
                ok = false
            }
        }
        if str_contains(p, "\\") || str_contains(p, " ") || str_contains(p, "\t") || str_contains(p, "\"") || str_contains(p, "'") || str_contains(p, "`") {
            ok = false
        }
        ok
    }
}
