// modgraph.bur — 模块图：依赖解析（MVS）、bur.sum 校验、import 驱动加载。
// Module graph: dependency resolution (MVS), bur.sum verification, import-driven loading.
import "burryn.dev/compiler/lib"

// 模块信息
// Module info
pub enum ModInfo {
    MI(str, [str], [str]),
}

// 版本选择结果
// Version pick result
pub enum ModPick {
    MP([str], [str]),
}

// modgraph_parse 解析 go.mod 风格 require 块 / modgraph_parse parses a go.mod-style require block
pub fn modgraph_parse(text) {
    let mut mpath = ""
    let mut rpaths = []
    let mut rvers = []
    for line in split(text, "\n") {
        let mut t = line
        match str_index_of(t, "//") {
            Some(ix) => {
                t = substr(t, 0, ix)
            },
            None => {},
        }
        let fields = str_fields(t)
        if len(fields) > 0 {
            if fields[0] == "module" {
                if len(fields) != 2 || !valid_import_path(fields[1]) {
                    return Err("malformed module directive")
                }
                if mpath != "" {
                    return Err("duplicate module directive")
                }
                mpath = fields[1]
            } else if fields[0] == "require" {
                if len(fields) != 3 || !valid_import_path(fields[1]) || !lib::str_has_prefix(fields[2], "v") {
                    return Err("malformed require directive")
                }
                push(rpaths, fields[1])
                push(rvers, fields[2])
            } else {
                return Err("unknown directive \"" + fields[0] + "\"")
            }
        }
    }
    if mpath == "" {
        return Err("missing module directive")
    }
    Ok(MI(mpath, rpaths, rvers))
}




