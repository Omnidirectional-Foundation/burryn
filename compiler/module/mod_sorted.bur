// mod_sorted.bur — 字符串排序。
// mod_sorted.bur — string sort.


// sorted_strs 字符串列表排序 / sorted_strs sorts a string list
fn sorted_strs(xs) {
    let mut out = []
    for x in xs {
        let mut i = 0
        while i < len(out) && out[i] < x {
            i = i + 1
        }
        out = concat(concat(slice(out, 0, i), [x]), slice(out, i, len(out)))
    }
    out
}
