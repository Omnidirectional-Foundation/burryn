// iface_load.bur — interface 缓存加载。
// iface_load.bur — interface cache load.

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

// iface_try_load 尝试加载缓存的接口 / iface_try_load tries loading a cached interface
fn iface_try_load(id, pkg_path, mut o_stmts, mut o_fpaths, mut o_imports, mut o_chans) {
    let base = iface_cache_dir(id) + "/" + iface_flat_pkg(pkg_path)
    let src = match read_file(base + ".buri") {
        Ok(s) => s,
        Err(_) => {
            return false
            ""
        },
    }
    let meta = match read_file(base + ".meta") {
        Ok(s) => s,
        Err(_) => {
            return false
            ""
        },
    }
    let mlines = split(meta, "\n")
    if len(mlines) == 0 || mlines[0] != "buri1" {
        return false
    }
    let mut entries = []
    let mut mi = 1
    while mi < len(mlines) {
        if mlines[mi] != "" {
            if !str_contains(mlines[mi], ":") {
                return false
            }
            push(entries, mlines[mi])
        }
        mi = mi + 1
    }
    match frontend::lex(src) {
        lib::LexOut::Lexed(toks, ldiags, _) => {
            if len(ldiags) > 0 {
                return false
            }
            match frontend::parse_interface(toks) {
                frontend::ParseOut::Parsed(stmts, pdiags) => {
                    if len(pdiags) > 0 {
                        return false
                    }
                    let mut imps = []
                    let mut kept = []
                    let mut imports_done = false
                    for s in stmts {
                        match s {
                            frontend::Node::ImportDecl(_, _, _, _, _) => {
                                if imports_done {
                                    return false
                                }
                                push(imps, s)
                            },
                            _ => {
                                imports_done = true
                                push(kept, s)
                            },
                        }
                    }
                    let mut rdiags = []
                    let mut rfiles = []
                    let decls = resolve_file_tes(kept, frontend::aliases_of(imps), pkg_path, base + ".buri", rdiags, rfiles)
                    if len(rdiags) > 0 {
                        return false
                    }
                    push(o_stmts, [decls])
                    push(o_fpaths, [base + ".buri"])
                    push(o_imports, [imps])
                    push(o_chans, entries)
                    true
                },
            }
        },
    }
}

// iface_has_err 判断结果是否错误 / iface_has_err tells whether the result is an error
fn iface_has_err(r) {
    match r {
        lib::CheckOut::Checked(diags, _, _, _, _) => {
            let mut has = false
            for d in diags {
                match d {
                    lib::DiagT::Diag(ie, _, _, _, _, _) => {
                        if ie {
                            has = true
                        }
                    },
                    lib::DiagT::DiagX(ie, _, _, _, _, _, _, _) => {
                        if ie {
                            has = true
                        }
                    },
                }
            }
            has
        },
    }
}
