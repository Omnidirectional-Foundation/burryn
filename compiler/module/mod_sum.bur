// mod_sum.bur — tree hash 与 bur.sum。
// mod_sum.bur — tree hash and bur.sum.

// sum_render 渲染 bur.sum / sum_render renders bur.sum
pub fn sum_render(pick, hashes) {
    match pick {
        MP(paths, vers) => {
            let mut lines = []
            let mut i = 0
            while i < len(paths) {
                push(lines, paths[i] + " " + vers[i] + " " + hashes[i] + "\n")
                i = i + 1
            }
            join(lines, "")
        },
    }
}
