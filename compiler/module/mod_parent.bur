// mod_parent.bur — parent_dir。
// mod_parent.bur — parent_dir.

// parent_dir 取父目录 / parent_dir returns the parent directory
fn parent_dir(p) {
    let mut last = -1
    let mut i = 0
    while i < str_len(p) {
        if char_at(p, i) == "/" {
            last = i
        }
        i = i + 1
    }
    if last <= 0 {
        "."
    } else {
        substr(p, 0, last)
    }
}
