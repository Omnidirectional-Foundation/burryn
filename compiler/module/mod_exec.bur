// mod_exec.bur — exec_ok。
// mod_exec.bur — exec_ok.

// exec_ok 判断命令是否成功 / exec_ok tells whether the command succeeded
fn exec_ok(cmd, cargs, what) {
    match exec(cmd, cargs) {
        Ok(o) => match o {
            Output(code, _, se) => {
                if code == 0 {
                    Ok(0)
                } else {
                    Err(what + ": " + trim(se))
                }
            },
        },
        Err(m) => Err(what + ": " + m),
    }
}
