// mod_env.bur — 环境/缓存根。
// mod_env.bur — env / cache root.

// env_lookup 带默认值的环境变量查找 / env_lookup looks up an env var with a default
fn env_lookup(name) {
    match exec("printenv", [name]) {
        Ok(o) => match o {
            Output(code, so, _) => {
                if code == 0 {
                    Some(trim(so))
                } else {
                    None
                }
            },
        },
        Err(_) => None,
    }
}

// cache_root 取模块缓存根（BURCACHE）/ cache_root returns the module cache root (BURCACHE)
pub fn cache_root() {
    match env_lookup("BURCACHE") {
        Some(p) => p,
        None => match env_lookup("HOME") {
            Some(h) => h + "/.burryn/pkg",
            None => "/tmp/burryn-pkg",
        },
    }
}
