// x86gen_split_native 内联 split：按分隔符拆分 / x86gen_split_native inlines split: divide by a separator
// split inline: split on a separator
fn x86gen_split_native() {
    let push = mov_mr(r15, 0 - 24, r12) + mov_rr(rdi, r12) + mov_mr(rdi, 0, rcx) + mov_rr(rsi, r9) + add_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rr(rdi, r12) + add_ri32(rdi, 8) + mov_rm(rcx, r15, 0 - 24) + mov_rm(rcx, rcx, 0) + rep_movsb() + mov_rm(rcx, r15, 0 - 24) + mov_rm(rcx, rcx, 0) + add_rr(r12, rcx) + add_ri32(r12, 8) + mov_rm(rdi, r15, 0 - 24) + mov_rr(r11, r12) + sub_rr(r11, rdi) + gc_rec(rdi, mov_rr(rsi, r11)) + mov_rm(rdi, r15, 0 - 8) + mov_rm(rsi, r15, 0 - 24) + mov_mr(rdi, 0, rsi) + add_ri32(rdi, 8) + mov_mr(r15, 0 - 8, rdi)
    let done = mov_rr(rcx, r8) + sub_rr(rcx, rdx) + push + mov_rm(rdi, r15, 0 - 16) + mov_rm(rsi, r15, 0 - 8) + sub_rr(rsi, rdi) + sub_ri32(rsi, 24) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shr_rcl(rsi) + mov_mr(rdi, 0, rsi) + mov_mr(r15, 0 - 24, rdi) + vs_pop_n(2)
    let matched = mov_rr(rcx, rax) + sub_rr(rcx, rdx) + push + mov_rm(r11, r10, 0) + add_rr(rax, r11) + mov_rr(rdx, rax)
    let no_match = add_ri32(rax, 1)
    let loop_tail = mov_rr(rsi, r9) + add_rr(rsi, rax) + add_ri32(rsi, 8) + mov_rr(rdi, r10) + add_ri32(rdi, 8) + mov_rr(rcx, r11) + repe_cmpsb() + je_rel32(str_len(no_match) + 5)
    let cond_ja = mov_rm(r11, r10, 0) + mov_rr(rcx, rax) + add_rr(rcx, r11) + cmp_rr(rcx, r8) + ja_rel32(str_len(loop_tail) + str_len(no_match) + 5 + str_len(matched) + 5)
    let cond_je = test_rr(r11, r11) + je_rel32(str_len(cond_ja) + str_len(loop_tail) + str_len(no_match) + 5 + str_len(matched) + 5)
    let loop_head = cond_je + cond_ja + loop_tail
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(no_match) + 5))
    let matched_back = jmp_rel32(0 - (str_len(loop_head) + str_len(no_match) + 5 + str_len(matched) + 5))
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_rm(r8, r9, 0) + mov_rm(r11, r10, 0) + mov_rr(rdi, r12) + xor_rr(rax, rax) + mov_mr(rdi, 0, rax) + mov_mr(rdi, 8, rax) + mov_mr(rdi, 16, rax) + mov_rr(rdx, r8) + add_ri32(rdx, 1) + mov_mr(rdi, 8, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_ri32(rdx, 24) + mov_rr(rax, rdi) + add_ri32(rax, 24) + mov_mr(rdi, 16, rax) + add_rr(r12, rdx) + mov_mr(r15, 0 - 16, rdi) + mov_rr(rsi, rdi) + add_ri32(rsi, 24) + mov_mr(r15, 0 - 8, rsi) + xor_rr(rax, rax) + xor_rr(rdx, rdx)
    head + loop_head + no_match + back + matched + matched_back + done
}

// x86gen_str_find_native 内联 str_contains/str_index_of：子串查找
// x86gen_str_find_native inlines str_contains/str_index_of: substring search
// str_contains/str_index_of inline: substring search
fn x86gen_str_find_native(as_option) {
    let some = if as_option {
        mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 0) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    } else {
        mov_ri64(rax, 1) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2)
    }
    let none = if as_option {
        mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + add_ri32(r12, 16) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2) + jmp_rel32(str_len(some))
    } else {
        mov_ri64(rax, 0) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2) + jmp_rel32(str_len(some))
    }
    let next = add_ri32(rax, 1)
    let loop_tail = mov_rr(rsi, r9) + add_rr(rsi, rax) + add_ri32(rsi, 8) + mov_rr(rdi, r10) + add_ri32(rdi, 8) + mov_rr(rcx, r11) + test_rr(rcx, rcx) + repe_cmpsb() + je_rel32(str_len(next) + 5 + str_len(none))
    let loop_head = mov_rr(rcx, rax) + add_rr(rcx, r11) + cmp_rr(rcx, r8) + ja_rel32(str_len(loop_tail) + str_len(next) + 5) + loop_tail
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(next) + 5))
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_rm(r8, r9, 0) + mov_rm(r11, r10, 0) + xor_rr(rax, rax)
    head + loop_head + next + back + none + some
}

// x86gen_read_stdin_native 内联 read_stdin：read syscall，同步阻塞读 stdin 为 str
// x86gen_read_stdin_native inlines read_stdin: a synchronous read syscall into a str
// read_stdin inline: synchronous read of stdin into a str
fn x86gen_read_stdin_native() {
    let empty_str = mov_rr(r8, r12) + xor_rr(rdx, rdx) + mov_mr(r8, 0, rdx) + add_ri32(r12, 8) + mov_mr(r15, 0 - 16, r8) + vs_pop_n(1)
    let read_seq = mov_rr(r8, r12) + xor_rr(rdx, rdx) + mov_mr(r8, 0, rdx) + lea(rsi, r8, 8) + mov_rr(rdx, r9) + xor_rr(rdi, rdi) + sys_mov_rax(0) + syscall() + mov_mr(r8, 0, rax) + add_ri32(r12, 8) + add_rr(r12, rax) + mov_mr(r15, 0 - 16, r8) + vs_pop_n(1)
    let skip = jmp_rel32(str_len(empty_str))
    let head = mov_rm(r9, r15, 0 - 8) + test_rr(r9, r9) + jle_rel32(str_len(read_seq + skip)) + read_seq + skip + empty_str
    head
}

// x86gen_str_native 内联 str(int)：带符号十进制，逐位除 10 + 负号
// x86gen_str_native inlines str(int): signed decimal, digit-wise /10 plus the sign
// str(int) inline: signed decimal, digit-by-digit div-10 with a minus sign
fn x86gen_str_native() {
    let loop_body = xor_rr(rdx, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 10) + div_r(rcx) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(r10, 1) + test_rr(rax, rax)
    let loop_jne = jne_rel32(0 - (str_len(loop_body) + 6))
    let neg_write = mov_ri64(rdx, 45) + mov_mr(rdi, 0, rdx) + add_ri32(rdi, 1)
    let alloc = mov_rr(rdx, r10) + add_rr(rdx, r8) + mov_rr(r11, r12) + mov_mr(r11, 0, rdx) + lea(rcx, rdx, 8) + add_rr(r12, rcx) + gc_rec(r11, mov_rr(rsi, rcx)) + lea(rdi, r11, 8) + test_rr(r8, r8) + je_rel32(str_len(neg_write)) + neg_write
    let pop_body = pop_r(rax) + e1(136) + e1(7) + add_ri32(rdi, 1) + sub_ri32(r10, 1)
    let pop_jne = jne_rel32(0 - (str_len(pop_body) + 6))
    let neg_path = mov_ri64(r8, 1) + neg_r(rax)
    let head = mov_rm(rax, r15, 0 - 8) + xor_rr(r8, r8) + test_rr(rax, rax) + jge_rel32(str_len(neg_path))
    let loop_start = xor_rr(r10, r10)
    head + neg_path + loop_start + loop_body + loop_jne + alloc + pop_body + pop_jne + mov_mr(r15, 0 - 16, r11) + vs_pop_n(1)
}

// x86gen_str_const_at 在堆上构造编译期字符串并写回 [r15+off]
// x86gen_str_const_at builds a compile-time string on the heap and stores it at [r15+off]
fn x86gen_str_const_at(off, s) {
    let mut store = mov_rr(r11, r12) + mov_ri64(r9, str_len(s)) + mov_mr(r11, 0, r9) + lea(rdi, r11, 8)
    let mut ci = 0
    while ci < str_len(s) {
        store = store + mov_ri64(r10, byte_at(s, ci)) + mov_mr(rdi, 0, r10) + add_ri32(rdi, 1)
        ci = ci + 1
    }
    store = store + add_rr(r12, r9) + add_ri32(r12, 8) + mov_mr(r15, off, r11)
    store
}

// x86gen_concat_native 内联 concat：两列表拼接 / x86gen_concat_native inlines concat: join two lists
// concat inline: concatenate two lists
fn x86gen_concat_native() {
    mov_rm(r9, r15, 0 - 16) + mov_rm(r8, r15, 0 - 8) + mov_rm(rcx, r9, 0) + mov_rm(rdx, r8, 0) + add_rr(rcx, rdx) + mov_rr(r11, r12) + mov_mr(r11, 0, rcx) + mov_mr(r11, 8, rcx) + lea(r10, r11, 24) + mov_mr(r11, 16, r10) + mov_rm(rsi, r9, 16) + mov_rr(rdi, r10) + mov_rm(rdx, r9, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rm(rsi, r8, 16) + mov_rm(rdx, r8, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rm(rax, r9, 0) + mov_rm(rdx, r8, 0) + add_rr(rax, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rax) + add_ri32(rax, 24) + add_rr(rax, r11) + mov_rr(r12, rax) + mov_mr(r15, 0 - 24, r11) + vs_pop_n(2)
}

// x86gen_eq_str 生成字符串相等比较 / x86gen_eq_str emits string equality
// String equality compare
fn x86gen_eq_str() {
    let cmp_body = lea(rsi, rax, 8) + lea(rdi, rcx, 8) + mov_rr(rcx, rdx) + repe_cmpsb() + sete(r10)
    let done = mov_mr(r15, 0 - 16, r10) + vs_pop_n(1)
    mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + mov_rm(rdx, rax, 0) + mov_rm(r9, rcx, 0) + xor_rr(r10, r10) + cmp_rr(rdx, r9) + jne_rel32(str_len(cmp_body)) + cmp_body + done
}

// x86gen_tcp_listen_native 内联 tcp_listen：socket/bind/listen syscalls，返回 Result<int, str>
// x86gen_tcp_listen_native inlines tcp_listen: socket/bind/listen syscalls, returning Result<int,
// str>
fn x86gen_tcp_listen_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let fail = err_str + err_inst + add_ri32(rsp, 32)
    let fail_close = mov_rr(rdi, r9) + sys_mov_rax(3) + syscall() + fail
    let listen_ok = mov_rr(rax, r9) + ok_inst + add_ri32(rsp, 32) + jmp_rel32(str_len(fail_close))
    let listen_fail = test_rr(rax, rax) + jl_rel32(str_len(listen_ok))
    let listen_seq = mov_rr(rdi, r9) + mov_ri64(rsi, 128) + sys_mov_rax(50) + syscall()
    let bind_seq = mov_rr(rdi, r9) + lea(rsi, rsp, 16) + mov_ri64(rdx, 16) + sys_mov_rax(49) + syscall() + test_rr(rax, rax) + jl_rel32(str_len(listen_seq) + str_len(listen_fail) + str_len(listen_ok))
    let reuse_seq = mov_ri64(rax, 1) + mov_mr(rsp, 4, rax) + mov_rr(rdi, r9) + mov_ri64(rsi, 1) + mov_ri64(rdx, 2) + lea(r10, rsp, 4) + mov_ri64(r8, 4) + sys_mov_rax(54) + syscall()
    // listener fd 置 O_NONBLOCK：accept 返回 EAGAIN 才能 park（VM 语义：socket 出生即非阻塞）
    // set O_NONBLOCK on the listener fd: accept must return EAGAIN to park (VM semantics: sockets
    // are born non-blocking)
    let nonblock_seq = mov_mr(rsp, 8, r9) + x86gen_set_nonblock_at(rsp, 8)
    let socket_seq = mov_ri64(rdi, 2) + mov_ri64(rsi, 1) + xor_rr(rdx, rdx) + sys_mov_rax(41) + syscall() + mov_rr(r9, rax) + test_rr(rax, rax) + jl_rel32(str_len(nonblock_seq) + str_len(reuse_seq) + str_len(bind_seq) + str_len(listen_seq) + str_len(listen_fail) + str_len(listen_ok))
    let sockaddr = x86gen_sockaddr_at()
    let ip_fail = test_rr(rax, rax) + jne_rel32(str_len(mov_rm(r9, r15, 0 - 8)) + str_len(sockaddr) + str_len(socket_seq) + str_len(nonblock_seq) + str_len(reuse_seq) + str_len(bind_seq) + str_len(listen_seq) + str_len(listen_fail) + str_len(listen_ok))
    let head = sub_ri32(rsp, 32) + x86gen_parse_ip_at(0 - 16) + ip_fail + mov_rm(r9, r15, 0 - 8)
    head + sockaddr + socket_seq + nonblock_seq + reuse_seq + bind_seq + listen_seq + listen_fail + listen_ok + fail_close
}

// x86gen_chan_format_at 生成 chan→str 转换：<chan cap=<cap> len=<len>>
// x86gen_chan_format_at emits chan-to-str: <chan cap=<cap> len=<len>>
fn x86gen_chan_format_at(off) {
    let mb_al = e1(136) + e1(7)
    let mb = fn(c) {
        e1(198) + e1(7) + sb(c)
    }
    let dl_loop = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
    let dl_jne = jne_rel32(0 - (str_len(dl_loop) + 6))
    let int2_loop = xor_rr(rdx, rdx) + mov_ri64(rsi, 10) + idiv_r(rsi) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(rcx, 1) + test_rr(rax, rax)
    let int2_jne = jne_rel32(0 - (str_len(int2_loop) + 6))
    let write2_body = pop_r(rax) + mb_al + add_ri32(rdi, 1) + sub_ri32(rcx, 1) + test_rr(rcx, rcx)
    let write2 = write2_body + jne_rel32(0 - (str_len(write2_body) + 6))
    let int2_zero = mb(48) + add_ri32(rdi, 1) + jmp_rel32(str_len(int2_loop) + str_len(int2_jne) + str_len(write2))
    let int2_at = fn(r, foff) {
        mov_rm(rax, r, foff) + xor_rr(rcx, rcx) + test_rr(rax, rax) + jne_rel32(str_len(int2_zero)) + int2_zero + int2_loop + int2_jne + write2
    }
    let l1 = mov_rm(r9, r15, off) + mov_rr(r10, r9) + mov_ri64(rcx, 16) + mov_rm(rax, r10, CH_CAP) + xor_rr(rsi, rsi) + dl_loop + dl_jne + add_rr(rcx, rsi) + mov_rm(rax, r10, CH_BUFLEN) + xor_rr(rsi, rsi) + dl_loop + dl_jne + add_rr(rcx, rsi)
    let alloc = mov_rr(r9, r12) + mov_mr(r9, 0, rcx) + lea(rdi, r9, 8) + add_rr(r12, rcx) + add_ri32(r12, 8) + gc_rec(r9, mov_rr(rsi, rcx))
    let lit_head = mov_ri64(rdx, 7017488302826087228) + mov_mr(rdi, 0, rdx) + add_ri32(rdi, 8) + mov_ri64(rdx, 15728) + mov_mr(rdi, 0, rdx) + add_ri32(rdi, 2)
    let lit_mid = mov_ri64(rdx, 263845145632) + mov_mr(rdi, 0, rdx) + add_ri32(rdi, 5)
    let l2 = lit_head + int2_at(r10, CH_CAP) + lit_mid + int2_at(r10, CH_BUFLEN) + mb(62) + add_ri32(rdi, 1)
    l1 + alloc + l2 + mov_mr(r15, off, r9)
}

// x86gen_trap_exit 发射 trap：文本按 8B 块写入 [rsp-n..] + write(2) + exit 4
// x86gen_trap_exit emits a trap: the message in 8-byte chunks at [rsp-n..] + write(2) + exit 4
fn x86gen_trap_exit(msg) {
    let mlen = str_len(msg)
    let nchunks = (mlen + 7) / 8
    let mut code = ""
    let mut ci = 0
    while ci < nchunks {
        let mut ask = 8
        if mlen - ci * 8 < 8 {
            ask = mlen - ci * 8
        }
        let chunk = substr(msg, ci * 8, ask)
        let clen = str_len(chunk)
        let mut v = 0
        let mut mul = 1
        let mut bj = 0
        while bj < clen {
            v = v + ord(substr(chunk, bj, 1)) * mul
            if bj + 1 < clen {
                mul = mul * 256
            }
            bj = bj + 1
        }
        code = code + mov_ri64(rax, v) + mov_mr(rsp, 0 - 8 * (nchunks - ci), rax)
        ci = ci + 1
    }
    code + mov_ri64(rdi, 2) + lea(rsi, rsp, 0 - 8 * nchunks) + mov_ri64(rdx, mlen) + sys_mov_rax(1) + syscall() + mov_ri64(rdi, 4) + mov_ri64(rax, 60) + syscall()
}

// x86gen_join_native 内联 join：字符串列表用分隔符连接
// x86gen_join_native inlines join: connect a string list with a separator
// join inline: join string lists with a separator
fn x86gen_join_native() {
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_rm(r8, r9, 0) + mov_rm(r11, r10, 0) + xor_rr(rdx, rdx) + xor_rr(rax, rax)
    let done_copy = vs_pop_n(2)
    let pass2_elem = mov_rr(rsi, rax) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + mov_rm(rcx, r9, 16) + add_rr(rcx, rsi) + mov_rm(rcx, rcx, 0) + mov_rr(rsi, rcx) + add_ri32(rsi, 8) + mov_rm(rdx, rcx, 0) + mov_rr(rcx, rdx) + rep_movsb()
    let pass2_no = mov_rr(rsi, r10) + add_ri32(rsi, 8) + mov_rr(rcx, r11) + rep_movsb()
    let pass2_je = test_rr(rax, rax) + je_rel32(str_len(pass2_no))
    let pass2_head = cmp_rr(rax, r8) + jge_rel32(str_len(pass2_je) + str_len(pass2_no) + str_len(pass2_elem) + 9)
    let loop_copy_body = pass2_je + pass2_no + pass2_elem + add_ri32(rax, 1)
    let back_copy = jmp_rel32(0 - (str_len(pass2_head) + str_len(loop_copy_body) + 5))
    let loop_copy = pass2_head + loop_copy_body + back_copy
    let done_len_tail = mov_mr(r15, 0 - 24, r12) + mov_rr(rdi, r12) + mov_mr(rdi, 0, rdx) + add_rr(r12, rdx) + add_ri32(r12, 8) + mov_rm(rdi, r15, 0 - 24) + add_ri32(rdi, 8) + xor_rr(rax, rax)
    let pass1_elem = mov_rr(rsi, rax) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + mov_rm(rcx, r9, 16) + add_rr(rcx, rsi) + mov_rm(rcx, rcx, 0) + mov_rm(rsi, rcx, 0) + add_rr(rdx, rsi)
    let pass1_no = add_rr(rdx, r11)
    let pass1_je = test_rr(rax, rax) + je_rel32(str_len(pass1_no))
    let pass1_head = cmp_rr(rax, r8) + jge_rel32(str_len(pass1_je) + str_len(pass1_no) + str_len(pass1_elem) + 9)
    let loop_len_body = pass1_je + pass1_no + pass1_elem + add_ri32(rax, 1)
    let back_len = jmp_rel32(0 - (str_len(pass1_head) + str_len(loop_len_body) + 5))
    let loop_len = pass1_head + loop_len_body + back_len
    head + loop_len + done_len_tail + loop_copy + done_copy
}

// x86gen_trim_native 内联 trim：去首尾空白 / x86gen_trim_native inlines trim: strip leading and trailing
// whitespace
// trim inline: strip leading/trailing whitespace
fn x86gen_trim_native() {
    let read = mov_rr(rsi, r9) + add_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rm(rax, rsi, 0) + mov_ri64(r10, 255) + and_rr(rax, r10)
    let done = sub_rr(rcx, rdx) + mov_mr(r15, 0 - 16, r12) + mov_rr(rdi, r12) + mov_mr(rdi, 0, rcx) + mov_rr(rsi, r9) + add_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rr(rdi, r12) + add_ri32(rdi, 8) + mov_rm(rcx, r15, 0 - 16) + mov_rm(rcx, rcx, 0) + rep_movsb() + mov_rm(rcx, r15, 0 - 16) + mov_rm(rcx, rcx, 0) + add_rr(r12, rcx) + add_ri32(r12, 8) + mov_rm(rsi, r15, 0 - 16) + mov_mr(r15, 0 - 16, rsi) + vs_pop_n(1)
    let yes2 = sub_ri32(rcx, 1)
    let no2 = jmp_rel32(str_len(yes2) + 5)
    let jb2 = sub_ri32(rax, 9) + sub_ri32(rax, 5) + jb_rel32(str_len(no2))
    let je2 = mov_rr(r10, rax) + sub_ri32(r10, 32) + test_rr(r10, r10) + je_rel32(str_len(jb2) + str_len(no2))
    let tail2 = mov_rr(rsi, r9) + add_rr(rsi, rcx) + add_ri32(rsi, 7) + mov_rm(rax, rsi, 0) + mov_ri64(r10, 255) + and_rr(rax, r10) + je2 + jb2 + no2 + yes2
    let cond2 = cmp_rr(rcx, rdx) + jle_rel32(str_len(tail2) + 5)
    let back2 = jmp_rel32(0 - (str_len(cond2) + str_len(tail2) + 5))
    let loop2 = cond2 + tail2 + back2
    let yes1 = add_ri32(rdx, 1)
    let no1 = jmp_rel32(str_len(yes1) + 5)
    let jb1 = sub_ri32(rax, 9) + sub_ri32(rax, 5) + jb_rel32(str_len(no1))
    let je1 = mov_rr(r10, rax) + sub_ri32(r10, 32) + test_rr(r10, r10) + je_rel32(str_len(jb1) + str_len(no1))
    let tail1 = read + je1 + jb1 + no1 + yes1
    let cond1 = cmp_rr(rdx, rcx) + jge_rel32(str_len(tail1) + 5)
    let back1 = jmp_rel32(0 - (str_len(cond1) + str_len(tail1) + 5))
    let loop1 = cond1 + tail1 + back1
    let head = mov_rm(r9, r15, 0 - 8) + mov_rm(r8, r9, 0) + xor_rr(rdx, rdx) + mov_rr(rcx, r8)
    head + loop1 + loop2 + done
}

// x86gen_write_file_native 内联 write_file：open/write/close syscall，返回 Result<unit, str>
// x86gen_write_file_native inlines write_file: open/write/close syscalls, returning Result<unit,
// str>
// write_file inline: open/write/close syscalls into Result<unit, str>
fn x86gen_write_file_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rdx) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let fail = err_str + err_inst
    let write_seq = mov_rm(r9, r15, 0 - 8) + mov_rr(rsi, r9) + add_ri32(rsi, 8) + mov_rm(rdx, r9, 0) + mov_rr(rdi, r8) + sys_mov_rax(1) + syscall() + sys_mov_rax(3) + syscall() + ok_inst + jmp_rel32(str_len(fail))
    let open_fail = test_rr(rax, rax) + jl_rel32(str_len(write_seq)) + write_seq + fail
    let head = x86gen_nul_path_at(0 - 16) + mov_rr(rdi, r11) + sys_mov_rsi(577) + sys_mov_rdx(420) + sys_mov_rax(2) + syscall() + mov_rr(r8, rax) + open_fail
    head
}
