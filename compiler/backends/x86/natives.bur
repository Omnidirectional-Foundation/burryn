    // (clobbers rcx/rdx/rsi/rdi/r9)
    fn copy_one() capture(ref c1, ref def_path, ref defb, ref di, ref argv_alloc, ref cmd_copy, ref body, ref cond, ref back, ref argv_loop, ref null_tail, ref pipe1, ref pipe2, ref pipe3, ref envp_load, ref fail_write, ref found_seq, ref env_adv, ref default_seq, ref b5, ref b4, ref b3, ref b2, ref b1, ref env_loop_head, ref env_loop_back, ref env_scan, ref strlen_add, ref strlen_head, ref strlen_body, ref strlen_loop, ref cmd_len_seq, ref dir_len, ref cand_base, ref src_tmp, ref r8_next, ref src, ref bump, ref dst, ref copy_dir, ref slash, ref copy_cmd, ref nul, ref save_cand, ref exec_seq, ref flag_set, ref eacces, ref seg_end_body, ref seg_end_len, ref nul_chk, ref seg_body, ref scan_back, ref seg_head, ref seg_back, ref seg_end, ref set13, ref path_end, ref walk, ref direct, ref nul_je, ref slash_body, ref slash_head, ref slash_back, ref dup1, ref dup2, ref child_closes, ref child_seq, ref init_out, ref init_err, ref parent_ok, ref fork_fail, ref parent_seq, ref done_seq, ref fork_seq, ref f3, ref f2, ref f1, ref skip_fail, ref p3_fail, ref p2_fail, ref p1_fail, ref pipes) {
