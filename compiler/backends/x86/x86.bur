// x86.bur — 手写 x86-64 机器码后端：逐条 opcode 内联发射（无 runtime 依赖，静态 ELF）。
// Hand-written x86-64 backend: each opcode is inlined into raw machine code (no runtime, static
// ELF).
// 值 = 8B 原始 int64（无 tag，与 C runtime 的 16B tagged Value 不混用）。
// Values are 8-byte raw int64s (untagged; never mixed with the C runtime's 16-byte tagged Value).
// 寄存器约定：r15 = 值栈顶、r14 = 帧基、r13 = 跳转表、r12 = 堆指针、rbx = 全局基（ABI 级，勿改）。
// Register conventions: r15 value stack top, r14 frame base, r13 jump table, r12 heap ptr, rbx
// globals base (ABI-level, do not change).
import "burryn.dev/compiler/lib"

// X86Ctx 各生成 helper 共用的上下文 / X86Ctx is the context shared by the codegen helpers
type X86Ctx = record { f_name: [str], f_arity: [int], f_nupvals: [int], f_code: [[int]], f_consts: [[lib::CVal]], en_qual: [str], en_vnames: [[str]], nfn: int, f2s_h: int, const_slot_map: map(int, int), record_encs: [str], record_offs: [int], record_field_types: map(str, [str]), enum_field_types: map(str, [[str]]), enum_variant_types: map(str, [str]), out_enc: str, res_out_enc: str, res_int_enc: str, opt_res_enc: str, global_type: map(str, str), sig_specs: map(str, [str]), sig_ret: map(str, str), p_sig_grew: [bool], method_full_map: map(str, int), created_by: map(int, [int]), fn_ret_type: [str], fn_ret_param: [int], fn_param_types: [[str]], fn_variants: [[[str]]] }

// x86gen_program_to_buf 是 x86 后端入口：字节码表 → x86-64 ELF 二进制字节
// x86gen_program_to_buf is the x86 backend entry: bytecode tables to x86-64 ELF binary bytes
// Entry: bytecode tables to x86-64 ELF binary bytes
// ls_files/ls_names/ls_tables/ls_bases：回溯用源文件表（f_file 键、显示名、行起始表、
// 该文件在源码文本中的起始偏移——单文件模式下注入的 float_rt 位于其前）
// ls_files/ls_names/ls_tables/ls_bases: the source-file tables for traces (f_file
// key, display name, line-start table, and the file's start offset within the
// source text — in single-file mode the injected float_rt precedes it)
pub fn x86gen_program_to_buf(f_name, f_file, f_arity, f_nupvals, f_code, f_spans, f_consts, en_qual, en_vnames, _en_varities, ls_files, ls_names, ls_tables, ls_bases) {
    // format_float 注入函数 handle（列表/枚举浮点格式化用）
    // handle of the injected format_float (used by list/enum float formatting)
    let f2s_h = find_fn_by_name(f_name, "frt_format_float")

    let nfn = len(f_name)
    let mut const_data = ""
    let mut const_slot_map = map()
    let mut enum_const_map = map()
    let mut sf = 0
    while sf < nfn {
        let consts = f_consts[sf]
        let mut ci = 0
        while ci < len(consts) {
            match consts[ci] {
                lib::CVal::CStr(s) => {
                    let key = const_slot_key(sf, ci)
                    let dup = match get(const_slot_map, key) {
                        Some(_) => true,
                        None => false,
                    }
                    if !dup {
                        put(const_slot_map, key, str_len(const_data))
                        const_data = const_data + e8(str_len(s)) + s
                        while str_len(const_data) % 8 != 0 {
                            const_data = const_data + byte_chr(0)
                        }
                    }
                },
                lib::CVal::CEnumType(_) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                lib::CVal::CSingleton(_, _) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                lib::CVal::CCtor(_, _) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                _ => {},
            }
            ci = ci + 1
        }
        sf = sf + 1
    }
    let mut record_encs = []
    let mut record_offs = []
    let mut rf = 0
    let mut record_field_types = map()
    // enum_field_types 枚举 payload 字段类型表 / enum_field_types holds enum payload field types
    // key = "enum:<qual>|variant0,f0,f1;variant1,f0" (variant 分隔 ";", 字段分隔 ",")
    let mut enum_field_types = map()
    // enum_variant_types 用户枚举 variant 字段类型（key = "v:<eh>:<vi>"）
    // enum_variant_types holds user enum variant field types (key = "v:<eh>:<vi>")
    let mut enum_variant_types = map()
    // exec 系列返回类型编码 / exec-family return type encodings
    let out_enc = enum_payload_enc(enum_field_types, "Output", [["int", "str", "str"]])
    let res_out_enc = enum_payload_enc(enum_field_types, "Result", [[out_enc], ["str"]])
    let res_int_enc = enum_payload_enc(enum_field_types, "Result", [["int"], ["str"]])
    let opt_res_enc = enum_payload_enc(enum_field_types, "Option", [[res_out_enc], []])
    // 共享上下文：全部共享表就绪后构造一次，此后只经容器原地变更 / shared ctx built once
    let mut method_full_map = map()
    let mut fn_ret_type = []
    let mut rhAlloc = 0
    while rhAlloc < nfn {
        push(fn_ret_type, "")
        rhAlloc = rhAlloc + 1
    }
    let mut fn_ret_param = []
    let mut rpAlloc = 0
    while rpAlloc < nfn {
        push(fn_ret_param, 0 - 1)
        rpAlloc = rpAlloc + 1
    }
    let mut fn_param_types = []
    let mut phAlloc = 0
    while phAlloc < nfn {
        let mut plist = []
        let mut piAlloc = 0
        while piAlloc < f_arity[phAlloc] {
            push(plist, "")
            piAlloc = piAlloc + 1
        }
        push(fn_param_types, plist)
        phAlloc = phAlloc + 1
    }
    // created_by: fh -> [创建者 fh, 闭包指令 ip]（upvalue 形态判定的链根）
    // created_by: fh -> [creator fh, closure instruction ip] (chain root for upvalue cell-ness)
    let mut created_by = map()
    let mut global_type = map()
    // sig_specs: 多态函数被调用的去重实参签名（key = psig_key(handle, argtypes)）
    // sig_specs: deduped argument signatures for polymorphic functions
    let mut sig_specs = map()
    // p_sig_grew: 求解期新收集到嵌套签名（列表元素作跨 fn 引用标记）
    // p_sig_grew: a nested signature was collected during the solve (list elem as ref flag)
    let mut p_sig_grew = [false]
    // sig_ret: per-signature 返回类型；aggregate 轮后由签名求解填充
    // sig_ret: per-signature return types, filled by the signature solve after the rounds
    let mut sig_ret = map()
    let mut fn_variants = []
    let mut fv_alloc = 0
    while fv_alloc < nfn {
        push(fn_variants, [])
        fv_alloc = fv_alloc + 1
    }

    // X86Ctx：共享生成上下文（封闭 record；字段=被提升 helper 的隐式共享状态）。
    // 容器字段是堆引用，原地变更对所有持有者可见；字段在构造后不再被重新绑定。
    // X86Ctx: shared codegen context for the lifted helpers below (closed record);
    // container fields are heap references whose in-place mutations every holder
    // sees; no field is rebound after this construction.
    let ctx = record { f_name: f_name, f_arity: f_arity, f_nupvals: f_nupvals, f_code: f_code, f_consts: f_consts, en_qual: en_qual, en_vnames: en_vnames, nfn: nfn, f2s_h: f2s_h, const_slot_map: const_slot_map, record_encs: record_encs, record_offs: record_offs, record_field_types: record_field_types, enum_field_types: enum_field_types, enum_variant_types: enum_variant_types, out_enc: out_enc, res_out_enc: res_out_enc, res_int_enc: res_int_enc, opt_res_enc: opt_res_enc, global_type: global_type, sig_specs: sig_specs, sig_ret: sig_ret, p_sig_grew: p_sig_grew, method_full_map: method_full_map, created_by: created_by, fn_ret_type: fn_ret_type, fn_ret_param: fn_ret_param, fn_param_types: fn_param_types, fn_variants: fn_variants }

    while rf < nfn {
        let rcode = f_code[rf]
        let mut rip = 0
        while rip < len(rcode) {
            let rop = rcode[rip]
            if rop == lib::op_record || rop == lib::op_record_update {
                let cidx = read_u16(rcode, rip + 2)
                let enc = const_str(ctx, rf, cidx)
                if str_len(enc) > 0 {
                    const_data = add_record_enc(record_encs, record_offs, enc, const_data)
                }
            }
            rip = rip + inst_len(ctx, rf, rcode, rip)
        }
        rf = rf + 1
    }

    let mut globals_map = map()
    let mut n_globals = 0
    let mut gf = 0
    while gf < nfn {
        let gcode = f_code[gf]
        let mut gip = 0
        while gip < len(gcode) {
            let gop = gcode[gip]
            if gop == lib::op_def_global {
                let gidx = read_u16(gcode, gip + 1)
                let gname = const_str(ctx, gf, gidx)
                let exists = match get(globals_map, gname) {
                    Some(_) => true,
                    None => false,
                }
                if !exists {
                    put(globals_map, gname, n_globals)
                    n_globals = n_globals + 1
                }
            }
            gip = gip + inst_len(ctx, gf, gcode, gip)
        }
        gf = gf + 1
    }
    // 隐藏全局槽：exec 进程表（见 natives.bur 的 proc_reg_g）
    // hidden global slot: the exec process table (see natives.bur's proc_reg_g)
    proc_reg_g = n_globals
    n_globals = n_globals + 1
    net_reg_g = n_globals
    n_globals = n_globals + 1
    // 方法全名映射：CLOSURE + DEF_GLOBAL 配对记录「全局名 → fn handle」
    // map from fully-qualified method names to fn handles (CLOSURE + DEF_GLOBAL pairs)
    // 被 SET_GLOBAL 重赋值的全局不是稳定函数定义（如闭包变量），不注册——否则调用
    // 会误走「按名直接调用」而跳过闭包读取
    // globals reassigned via SET_GLOBAL are not stable function definitions (e.g.
    // closure variables); skip them so calls go through the closure slot
    let mut set_globals = map()
    let mut sgi = 0
    while sgi < nfn {
        let mut sgip = 0
        while sgip < len(f_code[sgi]) {
            if f_code[sgi][sgip] == lib::op_set_global {
                let sgidx = read_u16(f_code[sgi], sgip + 1)
                let sgname = const_str(ctx, sgi, sgidx)
                put(set_globals, sgname, true)
            }
            sgip = sgip + inst_len(ctx, sgi, f_code[sgi], sgip)
        }
        sgi = sgi + 1
    }
    let mut mfi = 0
    while mfi < nfn {
        let mut mgip = 0
        while mgip < len(f_code[mfi]) {
            if f_code[mfi][mgip] == lib::op_def_global && mgip >= 3 && f_code[mfi][mgip - 3] == lib::op_closure {
                let mgidx = read_u16(f_code[mfi], mgip + 1)
                let mgname = const_str(ctx, mfi, mgidx)
                let mcidx = read_u16(f_code[mfi], mgip - 2)
                let mfh = fn_const(ctx, mfi, mcidx)
                if mfh >= 0 {
                    let exists = match get(method_full_map, mgname) {
                        Some(_) => true,
                        None => false,
                    }
                    let reassigned = match get(set_globals, mgname) {
                        Some(_) => true,
                        None => false,
                    }
                    if !exists && !reassigned {
                        put(method_full_map, mgname, mfh)
                    }
                }
            }
            mgip = mgip + inst_len(ctx, mfi, f_code[mfi], mgip)
        }
        mfi = mfi + 1
    }
    // fn_ret_param: 函数直接返回第 k 个参数（返回类型 = 实参类型）；-1 = 非参数直返
    // fn_ret_param: function returns param k directly (ret type = arg type); -1 = not a param passthrough
    let mut cbScan = 0
    while cbScan < nfn {
        let cbcode = f_code[cbScan]
        let mut ccip = 0
        while ccip < len(cbcode) {
            if cbcode[ccip] == lib::op_closure {
                let cbsub = fn_const(ctx, cbScan, read_u16(cbcode, ccip + 1))
                let cexists = match get(created_by, cbsub) {
                    Some(_) => true,
                    None => false,
                }
                if !cexists {
                    put(created_by, cbsub, [cbScan, ccip])
                }
            }
            ccip = ccip + inst_len(ctx, cbScan, cbcode, ccip)
        }
        cbScan = cbScan + 1
    }
    let mut p_depth_maps = []
    // pt_target_shadow: 跳转目标处的 shadow/type_shadow 快照（psim 记录、主循环替换），
    // 修复 break/return 的互斥弹栈导致的静态模拟错位
    // pt_target_shadow: shadow/type_shadow snapshots at jump targets (recorded by psim,
    // applied by the emit loop); fixes static-simulation drift from mutually exclusive
    // pops on break/return paths
    let mut pt_target_shadow = map()
    let mut round = 0
    while round < 4 {
        let mut pti = nfn
        p_depth_maps = []
        // 每轮重置跳转目标快照：跨函数 chan 元素类型在轮间收敛，首次 wins 会卡住首轮
        // reset jump-target snapshots per round: cross-function channel element types
        // converge across rounds; first-wins would pin the incomplete first round
        pt_target_shadow = map()
        while pti > 0 {
            let ptfh = pti - 1
            let mut pd_round = map()
            psim(ctx, ptfh, fn_param_types[ptfh], true, pt_target_shadow, pd_round)
            push(p_depth_maps, pd_round)
            pti = pti - 1
        }
        round = round + 1
    }
    // 签名求解：迭代至收敛（嵌套多态经 sig_ret/sig_specs 传播，直到签名不再增长）
    // signature solve: iterate to fixpoint (nested polymorphism propagates via sig_ret and
    // sig_specs until the signature set stops growing)
    // pd_sink：非聚合 psim 调用的深度表出口（结果不读，仅承接） / throwaway depth-map sink
    let mut pd_sink = map()
    let mut s_changed = true
    let mut s_guard = 0
    while s_changed && s_guard < 8 {
        s_changed = false
        p_sig_grew[0] = false
        let s_all = keys(sig_specs)
        let mut s_i = 0
        while s_i < len(s_all) {
            let skey = s_all[s_i]
            match str_index_of(skey, "@") {
                Some(sci) => {
                    match parse_int(substr(skey, 0, sci)) {
                        Some(shv) => {
                            let s_arg_t = match get(sig_specs, skey) {
                                Some(st) => st,
                                None => [],
                            }
                            let s_new = psim(ctx, shv, s_arg_t, false, pt_target_shadow, pd_sink)
                            let s_old = match get(sig_ret, skey) {
                                Some(v) => v,
                                None => "",
                            }
                            if s_new != s_old {
                                put(sig_ret, skey, s_new)
                                s_changed = true
                            }
                        },
                        None => {},
                    }
                },
                None => {},
            }
            s_i = s_i + 1
        }
        if p_sig_grew[0] {
            s_changed = true
        }
        s_guard = s_guard + 1
    }
    pt_target_shadow = map()
    let mut rti = nfn
    while rti > 0 {
        psim(ctx, rti - 1, fn_param_types[rti - 1], true, pt_target_shadow, pd_sink)
        rti = rti - 1
    }

    // fn_variants: 每个函数的去重调用签名（每个元素 = 一个参数类型列表）
    // fn_variants: deduped call signatures per function (each = one param-type list)
    let fv_all = keys(sig_specs)
    let mut fv_i = 0
    while fv_i < len(fv_all) {
        let fv_key = fv_all[fv_i]
        match str_index_of(fv_key, "@") {
            Some(fvi) => {
                match parse_int(substr(fv_key, 0, fvi)) {
                    Some(fv_h) => {
                        if fv_h >= 0 && fv_h < len(fn_variants) {
                            match get(sig_specs, fv_key) {
                                Some(fv_at) => {
                                    let fv_src = fn_variants[fv_h]
                                    let mut fv_cur = []
                                    let mut fv_cp = 0
                                    while fv_cp < len(fv_src) {
                                        push(fv_cur, fv_src[fv_cp])
                                        fv_cp = fv_cp + 1
                                    }
                                    let mut fv_dup = false
                                    let mut fv_j = 0
                                    while fv_j < len(fv_cur) {
                                        if psig_key(fv_h, fv_cur[fv_j]) == fv_key {
                                            fv_dup = true
                                        }
                                        fv_j = fv_j + 1
                                    }
                                    if !fv_dup {
                                        push(fv_cur, fv_at)
                                        fn_variants[fv_h] = fv_cur
                                    }
                                },
                                None => {},
                            }
                        }
                    },
                    None => {},
                }
            },
            None => {},
        }
        fv_i = fv_i + 1
    }
    // 排序每个函数的签名（确定性）；单签名/未调用函数回退 fn_param_types 单 body
    // sort each function's signatures (determinism); single-sig/uncalled fns fall back to
    // one body seeded from fn_param_types
    let mut fv_s = 0
    while fv_s < nfn {
        let fv_lst_src = fn_variants[fv_s]
        let mut fv_lst = []
        let mut fv_lcp = 0
        while fv_lcp < len(fv_lst_src) {
            push(fv_lst, fv_lst_src[fv_lcp])
            fv_lcp = fv_lcp + 1
        }
        if len(fv_lst) >= 2 {
            let mut fv_i2 = 1
            while fv_i2 < len(fv_lst) {
                let fv_key2 = psig_key(fv_s, fv_lst[fv_i2])
                let mut fv_j2 = fv_i2
                while fv_j2 > 0 && psig_key(fv_s, fv_lst[fv_j2 - 1]) > fv_key2 {
                    let fv_tmp = fv_lst[fv_j2]
                    fv_lst[fv_j2] = fv_lst[fv_j2 - 1]
                    fv_lst[fv_j2 - 1] = fv_tmp
                    fv_j2 = fv_j2 - 1
                }
                fv_i2 = fv_i2 + 1
            }
            fn_variants[fv_s] = fv_lst
        } else if len(fv_lst) == 1 {
            // 单次调用签名仍保留具体实参类型（如 native:str）；勿退回聚合表，
            // 否则 map_first(str, …) 单独出现时 body 看不到 native:，动态调用解引用 0。
            // keep the sole call's concrete arg types (e.g. native:str); do not fall
            // back to the aggregate table — otherwise a lone map_first(str, …) body
            // never sees native: and the dynamic call dereferences 0.
            fn_variants[fv_s] = fv_lst
        } else {
            let mut fv_one = []
            push(fv_one, fn_param_types[fv_s])
            fn_variants[fv_s] = fv_one
        }
        fv_s = fv_s + 1
    }
    // fn_extra_base: 各多态函数在跳转表额外槽区的起始偏移
    // fn_extra_base: each polymorphic function's start offset in the jump-table extra region
    let mut fn_extra_base = []
    let mut eb_alloc = 0
    while eb_alloc < nfn {
        push(fn_extra_base, 0 - 1)
        eb_alloc = eb_alloc + 1
    }
    let mut n_extra = 0
    let mut eb_i = 0
    while eb_i < nfn {
        if len(fn_variants[eb_i]) >= 2 {
            fn_extra_base[eb_i] = n_extra
            n_extra = n_extra + len(fn_variants[eb_i]) - 1
        }
        eb_i = eb_i + 1
    }

    // 位置无关（PIE）：同一镜像按两个基址各装配一遍——先以 PIC_PROBE_SHIFT 平移的
    // 探针基址，再以真实基址；pic_image 比对两遍的代码/数据字节，把随基址变化的
    // mov imm64 地址改写成 RIP 相对 lea，见 pic.bur 与 architecture.md §5.22
    // Position independence (PIE): the same image is assembled at two bases —
    // first at the probe base shifted by PIC_PROBE_SHIFT, then at the real
    // base; pic_image diffs the two passes' code/data bytes and rewrites every
    // base-dependent mov imm64 address into a RIP-relative lea, see pic.bur and
    // architecture.md §5.22
    set_pic_pass(true)
    x86gen_image(ctx, const_data, n_globals, globals_map, p_depth_maps, pt_target_shadow, pd_sink, fn_extra_base, global_type, record_field_types, enum_field_types, enum_variant_types, f_file, f_spans, ls_files, ls_names, ls_tables, ls_bases)
    set_pic_pass(false)
    x86gen_image(ctx, const_data, n_globals, globals_map, p_depth_maps, pt_target_shadow, pd_sink, fn_extra_base, global_type, record_field_types, enum_field_types, enum_variant_types, f_file, f_spans, ls_files, ls_names, ls_tables, ls_bases)
}

// x86gen_image 从已求解的共享上下文装配整份镜像：内部子程序 + 各函数变体 + 跳转表 +
// _start（+ 分派器/.pdata），再交给目标格式的 emit_*；地址经 layout.bur 的
// img_base/data_origin 收口，故可按探针基址重放
// x86gen_image assembles the whole image from the solved shared context:
// internal subroutines, every function variant, the jump table and _start
// (plus the dispatcher/.pdata), then hands off to the target format's emit_*;
// addresses funnel through layout.bur's img_base/data_origin, so it can be
// replayed at the probe base
fn x86gen_image(ctx: X86Ctx, const_data, n_globals, globals_map, p_depth_maps, mut pt_target_shadow, mut pd_sink, fn_extra_base, mut global_type: map(str, str), mut record_field_types: map(str, [str]), mut enum_field_types: map(str, [[str]]), mut enum_variant_types: map(str, [str]), f_file, f_spans, ls_files, ls_names, ls_tables, ls_bases) {
    let f_name = ctx.f_name
    let f_arity = ctx.f_arity
    let f_nupvals = ctx.f_nupvals
    let f_code = ctx.f_code
    let f_consts = ctx.f_consts
    let en_qual = ctx.en_qual
    let en_vnames = ctx.en_vnames
    let nfn = ctx.nfn
    let f2s_h = ctx.f2s_h
    let method_full_map = ctx.method_full_map
    let fn_ret_type = ctx.fn_ret_type
    let fn_ret_param = ctx.fn_ret_param
    let fn_param_types = ctx.fn_param_types
    let record_encs = ctx.record_encs
    let record_offs = ctx.record_offs
    let out_enc = ctx.out_enc
    let res_out_enc = ctx.res_out_enc
    let res_int_enc = ctx.res_int_enc
    let opt_res_enc = ctx.opt_res_enc
    let fn_variants = ctx.fn_variants
    let const_data_len = str_len(const_data)
    let gc_rec_bytes = x86gen_gc_record()
    let gc_col = x86gen_gc_collect(n_globals, code_origin() + const_data_len)
    let gc_mark = x86gen_mark_addr()
    // 调度器块（sched/yield/done）与 channel 子程序（schedule/wake_waiters/push_queue）在
    // funcs 头部、GC 子程序之后；地址编译期确定，供 _start / prologue 插桩 / spawn 的
    // fake frame / channel opcode 引用
    // die 引用在各块内都是定长 mov imm64：先以 0 量出各块长度，定址后再重建
    // die references are fixed-size mov imm64s in every block: measure the blocks
    // with 0 first, then rebuild once the address is known
    die_addr_g = 0
    let sched_bytes = x86gen_sched_block()
    let sched_addr = code_origin() + const_data_len + str_len(gc_rec_bytes) + str_len(gc_col) + str_len(gc_mark)
    let yield_bytes = x86gen_yield_block(sched_addr)
    let yield_addr = sched_addr + str_len(sched_bytes)
    let done_bytes = x86gen_fiber_done_block(sched_addr)
    let done_addr = yield_addr + str_len(yield_bytes)
    let chan_sched_bytes = x86gen_chan_schedule_block()
    let chan_sched_addr = done_addr + str_len(done_bytes)
    let chan_wake_bytes = x86gen_chan_wake_waiters_block(chan_sched_addr)
    let chan_wake_addr = chan_sched_addr + str_len(chan_sched_bytes)
    let chan_push_sendq_bytes = x86gen_chan_push_queue_block(CH_SENDQ)
    let chan_push_sendq_addr = chan_wake_addr + str_len(chan_wake_bytes)
    let chan_push_recvq_bytes = x86gen_chan_push_queue_block(CH_RECVQ)
    let chan_push_recvq_addr = chan_push_sendq_addr + str_len(chan_push_sendq_bytes)
    let chan_push_waiters_bytes = x86gen_chan_push_queue_block(CH_WAITERS)
    let chan_push_waiters_addr = chan_push_recvq_addr + str_len(chan_push_recvq_bytes)
    let chan_remove_waiter_bytes = x86gen_chan_remove_waiter_block()
    let chan_remove_waiter_addr = chan_push_waiters_addr + str_len(chan_push_waiters_bytes)
    let waitset_add_bytes = x86gen_waitset_add_block()
    let waitset_add_addr = chan_remove_waiter_addr + str_len(chan_remove_waiter_bytes)
    let timer_add_bytes = x86gen_timer_add_block()
    let timer_add_addr = waitset_add_addr + str_len(waitset_add_bytes)
    let die_addr = timer_add_addr + str_len(timer_add_bytes)
    die_undef_g = die_addr
    die_addr_g = die_addr + die_entry_off()
    let die_len = str_len(x86gen_die_block(0, 0, 0, 0))
    let die_off = die_addr - (code_origin() + const_data_len)
    // 字符串构建器子程序紧跟 die（格式化用，见 fmt.bur） / the string-builder
    // subroutines follow die (used by formatting, see fmt.bur)
    sb_set_addrs(die_addr + die_len)
    errtext_g = die_addr + die_len + str_len(la_link(x86gen_sb_items()))
    let mut funcs_bytes = gc_rec_bytes + gc_col + gc_mark + x86gen_sched_block() + yield_bytes + done_bytes + chan_sched_bytes + chan_wake_bytes + chan_push_sendq_bytes + chan_push_recvq_bytes + chan_push_waiters_bytes + chan_remove_waiter_bytes + x86gen_waitset_add_block() + x86gen_timer_add_block() + x86gen_die_block(0, 0, 0, 0) + la_link(x86gen_sb_items()) + la_link(x86gen_errtext_items())
    // fn 名表：每函数一项 8B 偏移（自表基址起算），指向 [len:8][bytes] 名字串；
    // 空名记为 anonymous（对齐 C 的 bur_format）。放在用户代码之前，其绝对地址在此
    // 处即已最终确定（与 sb_set_addrs 同基准），fmt 子程序经 mov_ri64 取基址。
    // fn-name table: one 8B offset per fn (from the table base) into [len:8][bytes]
    // name strings; empty names are stored as "anonymous" (matching C's
    // bur_format). It sits before user code and its absolute address is final
    // right here (same basis as sb_set_addrs), so fmt subroutines can reach it
    // through a mov_ri64 base.
    let mut fn_names_bytes = ""
    let mut fn_name_strs = []
    let mut fnh = 0
    while fnh < nfn {
        push(fn_name_strs, if f_name[fnh] == "" {
            "anonymous"
        } else {
            f_name[fnh]
        })
        fnh = fnh + 1
    }
    let mut fn_at = 8 * nfn
    fnh = 0
    while fnh < nfn {
        fn_names_bytes = fn_names_bytes + e8(fn_at)
        fn_at = fn_at + 8 + str_len(fn_name_strs[fnh])
        fnh = fnh + 1
    }
    fnh = 0
    while fnh < nfn {
        fn_names_bytes = fn_names_bytes + e8(str_len(fn_name_strs[fnh])) + fn_name_strs[fnh]
        fnh = fnh + 1
    }
    fn_names_g = code_origin() + const_data_len + str_len(funcs_bytes)
    funcs_bytes = funcs_bytes + fn_names_bytes
    // 内部子程序 unwind 覆盖：gc_record（9-push）、mark_addr（7-push）与其余六个纯
    // call/ret、零序言的子程序（gc_collect、chan 系四个、waitset_add、timer_add）——
    // 序言形态逐个核对自 runtime.bur 源码（push_r 出现次数与顺序）。调度器三块
    // （sched/yield/done）是纤程切换机制本身，边界与 PE/Mach-O 一致不覆盖（见
    // architecture.md §5.19/GOALS.md）。rt_unwind_* 三个并行数组供三个后端的
    // unwind-info 构建复用，push_regs 为空数组表示零序言。
    // Internal-subroutine unwind coverage: gc_record (9-push), mark_addr
    // (7-push), and six purely call/ret, zero-prologue subroutines
    // (gc_collect, the four chan_* ones, waitset_add, timer_add) — prologue
    // shapes were checked one by one against runtime.bur's source (push_r
    // call count and order). The three scheduler blocks (sched/yield/done)
    // are the fiber-switch mechanism itself, left uncovered to match the
    // PE/Mach-O boundary (see architecture.md §5.19 / GOALS.md). The three
    // rt_unwind_* parallel arrays feed all three backends' unwind-info
    // builders; an empty push_regs array means a zero prologue.
    let internal_base = code_origin() + const_data_len
    let rt_unwind_offsets = [0, str_len(gc_rec_bytes), str_len(gc_rec_bytes) + str_len(gc_col), chan_sched_addr - internal_base, chan_wake_addr - internal_base, chan_push_sendq_addr - internal_base, chan_push_recvq_addr - internal_base, chan_push_waiters_addr - internal_base, chan_remove_waiter_addr - internal_base, waitset_add_addr - internal_base, timer_add_addr - internal_base]
    let rt_unwind_lens = [str_len(gc_rec_bytes), str_len(gc_col), str_len(gc_mark), str_len(chan_sched_bytes), str_len(chan_wake_bytes), str_len(chan_push_sendq_bytes), str_len(chan_push_recvq_bytes), str_len(chan_push_waiters_bytes), str_len(chan_remove_waiter_bytes), str_len(waitset_add_bytes), str_len(timer_add_bytes)]
    let rt_unwind_pushes = [[rdx, rdi, rsi, rax, rcx, r8, r9, r10, r11], [], [rax, rcx, rdx, rdi, r8, r9, r10], [], [], [], [], [], [], [], []]
    let mut func_offsets = []
    let mut variant_offsets = []
    // pdata_offsets/pdata_lens：每个变体的 (funcs_bytes 内偏移, 字节长度)，按发射顺序
    // 记录——与 func_offsets/variant_offsets 按 vi==0 分流不同，这两个不分流，直接
    // 保留发射顺序，即地址升序，供 PE .pdata 的 RUNTIME_FUNCTION 数组（要求按
    // BeginAddress 升序）使用
    // pdata_offsets/pdata_lens: each variant's (offset within funcs_bytes, byte
    // length), recorded in emission order — unlike func_offsets/variant_offsets
    // which split on vi==0, these two don't split; emission order is address
    // order, which is what PE .pdata's RUNTIME_FUNCTION array needs (it must be
    // sorted ascending by BeginAddress)
    let mut pdata_offsets = []
    let mut pdata_lens = []
    // 回溯表项（扁平 [off, line, fh]，off 相对首个用户函数）；fh_li 为各函数的行表下标
    // trace-table entries (flat [off, line, fh], off relative to the first user
    // function); fh_li is each function's line-table index
    let user_lo = str_len(funcs_bytes)
    let mut tr_ents = []
    let mut fh_li = []
    let mut tli = 0
    while tli < nfn {
        push(fh_li, trace_fh_li(f_file, tli, ls_files))
        tli = tli + 1
    }
    let mut fh = 0
    while fh < nfn {
        let vsigs = fn_variants[fh]
        let nv = len(vsigs)
        let mut vi = 0
        while vi < nv {
            if vi == 0 {
                push(func_offsets, str_len(funcs_bytes))
            } else {
                push(variant_offsets, str_len(funcs_bytes))
            }
            push(pdata_offsets, str_len(funcs_bytes))
            let mut ln_sink = []
            let fbytes = emit_one_variant(ctx, fh, vi, vsigs, f_name, f_arity, f_nupvals, f_code, f_consts, en_qual, en_vnames, nfn, f2s_h, p_depth_maps, pt_target_shadow, pd_sink, globals_map, n_globals, global_type, method_full_map, fn_ret_type, fn_ret_param, fn_param_types, fn_extra_base, record_encs, record_offs, record_field_types, enum_field_types, enum_variant_types, out_enc, res_out_enc, res_int_enc, opt_res_enc, yield_addr, sched_addr, timer_add_addr, done_addr, chan_sched_addr, chan_wake_addr, chan_push_sendq_addr, chan_push_recvq_addr, chan_push_waiters_addr, chan_remove_waiter_addr, waitset_add_addr, ln_sink)
            push(pdata_lens, str_len(fbytes))
            let vstart = str_len(funcs_bytes) - user_lo
            let mut cur_line = 0
            let mut lk = 0
            while lk + 1 < len(ln_sink) {
                let ln = trace_ip_line(f_spans, fh, ln_sink[lk], fh_li[fh], ls_tables, ls_bases)
                if ln >= 0 {
                    cur_line = ln
                }
                let efh = if cur_line == 0 {
                    0 - 1
                } else {
                    fh
                }
                let eoff = if lk == 0 {
                    vstart
                } else {
                    vstart + ln_sink[lk + 1]
                }
                let ne = len(tr_ents)
                if ne == 0 || tr_ents[ne - 1] != efh || tr_ents[ne - 2] != cur_line {
                    push(tr_ents, eoff)
                    push(tr_ents, cur_line)
                    push(tr_ents, efh)
                }
                lk = lk + 2
            }
            funcs_bytes = funcs_bytes + fbytes
            vi = vi + 1
        }
        fh = fh + 1
    }

    // 跳转表：每个函数一项，存入口相对表基址的偏移（jt_load 加回 r13），供闭包按
    // fn 索引调用
    // Jump table: one entry per function holding the entry's offset from the
    // table base (jt_load adds r13 back), closures call by fn index
    let mut jt_bytes = ""
    let mut jh = 0
    while jh < nfn {
        jt_bytes = jt_bytes + e8s(func_offsets[jh] - str_len(funcs_bytes))
        jh = jh + 1
    }
    // 多态函数的额外变体槽位（追加在默认表之后，按 fn_extra_base 定位）
    // Extra variant slots for polymorphic functions (appended after the default entries)
    let mut jx = 0
    while jx < len(variant_offsets) {
        jt_bytes = jt_bytes + e8s(variant_offsets[jx] - str_len(funcs_bytes))
        jx = jx + 1
    }
    // 回溯表（只读）落在代码域末尾——跳转表必须紧贴 _start（_start 以 RIP 相对
    // 定位它）；各目标定出表址后，die 以真实地址重建并原位换入（定长）
    // The trace table (read-only) goes at the very end of the code domain — the
    // jump table must sit right before _start, which locates it RIP-relative;
    // once each target fixes the table address, die is rebuilt with the real
    // addresses and swapped in place (same length)
    push(tr_ents, str_len(funcs_bytes) - user_lo)
    push(tr_ents, 0)
    push(tr_ents, 0 - 1)
    let mut gnames = []
    while len(gnames) < n_globals {
        push(gnames, "")
    }
    for gk in keys(globals_map) {
        match get(globals_map, gk) {
            Some(gs) => {
                gnames[gs] = gk
            },
            None => {},
        }
    }
    let tr_bytes = trace_table_bytes(tr_ents, f_name, f_file, ls_files, ls_names, gnames)
    let fn_base = code_origin() + const_data_len
    // 布局：常量区 + 函数体（GC 子程序在头部）+ 跳转表 + _start 构成代码域；
    // runtime 区独立成数据段，不再挤进代码流
    // Layout: constants + function bodies (GC subroutines at the head) + jump
    // table + _start form the code domain; the runtime area becomes its own
    // data segment instead of sitting in the code stream
    let gc_rec_addr = code_origin() + const_data_len
    let gc_col_addr = gc_rec_addr + str_len(gc_rec_bytes)
    let gc_mark_addr = gc_col_addr + str_len(gc_col)
    // runtime 槽初始值全零：waitset/timer 计数槽（16B）与数组零填充，使 runtime_bytes
    // 恰好 RUNTIME_SIZE 长；三个 GC 子程序槽与分派器槽不在镜像里存绝对地址，由
    // _start 开头按运行期地址写入（rt_init），其余由 _start 后续填充
    // Runtime slots start zeroed: the waitset/timer count slots (16B) and arrays
    // are zero-filled so runtime_bytes is exactly RUNTIME_SIZE long; the three GC
    // subroutine slots and the dispatcher slot keep no absolute address in the
    // image — _start stores their run-time addresses first thing (rt_init), and
    // fills the rest later
    let mut rt_zero = ""
    let mut rzi = 0
    while rzi < 16 + WAITSET_CAP * 16 + TIMER_CAP * 16 + WAITSET_CAP * 8 {
        rt_zero = rt_zero + byte_chr(0)
        rzi = rzi + 1
    }
    let runtime_bytes = e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + rt_zero
    let start_off = const_data_len + str_len(funcs_bytes) + str_len(jt_bytes)
    let rt_init = mov_ri64(rax, gc_rec_addr) + mov_ri64(r11, rt_slot(rt_gc_record_fn)) + mov_mr(r11, 0, rax) + mov_ri64(rax, gc_col_addr) + mov_ri64(r11, rt_slot(rt_gc_collect_fn)) + mov_mr(r11, 0, rax) + mov_ri64(rax, gc_mark_addr) + mov_ri64(r11, rt_slot(rt_mark_addr_fn)) + mov_mr(r11, 0, rax)
    // 分派器（windows/darwin）紧跟 _start；_start 长度与写入值无关，先以 0 量长再定址
    // The dispatcher (windows/darwin) follows _start; _start's length does not
    // depend on the stored value, so measure it with 0 first, then address it
    let mut start_bytes = x86gen_start(nfn + len(variant_offsets), n_globals, sched_addr, done_addr, rt_init)
    if target_os != "linux" {
        let thunk_probe = rt_init + mov_ri64(rax, 0) + mov_ri64(r11, thunk_slot_abs()) + mov_mr(r11, 0, rax)
        let disp_addr = img_base() + start_off + str_len(x86gen_start(nfn + len(variant_offsets), n_globals, sched_addr, done_addr, thunk_probe))
        start_bytes = x86gen_start(nfn + len(variant_offsets), n_globals, sched_addr, done_addr, rt_init + mov_ri64(rax, disp_addr) + mov_ri64(r11, thunk_slot_abs()) + mov_mr(r11, 0, rax))
    }
    if target_os == "windows" {
        // PE 装配：可写 runtime 区（含分派器地址槽、fd 表、WSA 区）独立进
        // 固定高 RVA 的 .data；kernel32 + ws2_32 导入 blob 跟在 runtime 区之后同
        // 落 .data——加载器解析导入时要原地写 IAT，只读的 .text 收不下。分派器
        // 接在 _start 后，槽由 _start 写入。
        // PE assembly: the writable runtime area (the dispatcher-address slot,
        // fd table and WSA area included) moves into a fixed-high-RVA .data;
        // the kernel32 + ws2_32 import blob follows the runtime area in the
        // same .data — the loader writes the IAT in place while resolving
        // imports, which a read-only .text cannot host. The dispatcher follows
        // _start, which stores the slot.
        let import_dlls = pe_import_dlls()
        let import_counts = pe_import_counts()
        let import_names = pe_import_names()
        let disp_off = start_off + str_len(start_bytes)
        let runtime_with_thunk = runtime_bytes + e8(0)
        // fd 表：全 0xFF 填充（kind=-1 空闲），Windows 独有尾区；其后 WSA 区全零
        // （WSAStartup 未调标记 + 写区 + poll 暂存，见 layout.bur wsa_base）
        // fd table: filled with 0xFF (kind=-1 means free), a Windows-only tail;
        // the WSA area after it is zeroed (WSAStartup-not-run flag plus scratch,
        // see layout.bur wsa_base)
        let mut fd_fill = ""
        let mut ffi = 0
        while ffi < FD_CAP * FD_ENTRY {
            fd_fill = fd_fill + byte_chr(255)
            ffi = ffi + 1
        }
        let mut wsa_fill = ""
        let mut wfi = 0
        while wfi < WSA_REGION_LEN {
            wsa_fill = wsa_fill + byte_chr(0)
            wfi = wfi + 1
        }
        let runtime_with_fd = runtime_with_thunk + fd_fill + wsa_fill
        // 导入 blob 落在 .data 内 runtime 区之后；描述符与 IAT 预填里写的是
        // RVA（基底 DATA_VA_OFF），代码侧引用 IAT 槽用的是绝对 VA（经
        // data_origin 收口），两套量纲不能混。
        // The import blob sits in .data after the runtime area; descriptors
        // and the IAT prefill carry RVAs (based at DATA_VA_OFF) while code
        // references to the IAT slots use absolute VAs (funneled through
        // data_origin) — the two scales must not be mixed.
        let idata_data_off = str_len(runtime_with_fd)
        let idata_rva = DATA_VA_OFF + idata_data_off
        let iat_abs0 = data_origin() + idata_data_off + pe_import_desc_size(len(import_dlls)) + pe_ilt_size(len(import_names), len(import_dlls))
        // IAT 逐 DLL 独立以零项收尾（同 pe_build_imports 的间隙说明），故各 DLL
        // 的绝对地址列表要跳过每组之间的空槽，不能按扁平 n*8 连续算
        // The IAT is zero-terminated per DLL (same gap as pe_build_imports), so
        // each DLL's absolute-address run must skip the null slot between
        // groups instead of assuming a flat, contiguous n*8 stride
        let mut iat_addrs = []
        let mut iat_doff = 0
        let mut iat_di = 0
        while iat_di < len(import_dlls) {
            let mut iat_ci = 0
            while iat_ci < import_counts[iat_di] {
                push(iat_addrs, iat_abs0 + 8 * iat_doff)
                iat_doff = iat_doff + 1
                iat_ci = iat_ci + 1
            }
            iat_doff = iat_doff + 1
            iat_di = iat_di + 1
        }
        let dispatcher = pe_build_dispatcher(iat_addrs)
        let imports = pe_build_imports(import_dlls, import_counts, import_names, idata_rva)
        // .pdata：紧接分派器，4B 对齐（RUNTIME_FUNCTION 三个字段皆 DWORD）；数组在前、
        // 共享 UNWIND_INFO 在后。用户函数序言形态唯一（natives.bur 的
        // x86gen_prologue：push rbp + sub rsp,8），故全程序共享一份 UNWIND_INFO；
        // GC/调度器等内部子程序不建标准帧或做原生纤程切栈，本轮不纳入 .pdata 覆盖
        // （未覆盖地址落回 Windows 默认的叶函数假设，不劣于改动前的现状）。
        // .pdata: right after the dispatcher, 4B-aligned (all three
        // RUNTIME_FUNCTION fields are DWORDs); the array first, the shared
        // UNWIND_INFO after. User functions share one prologue shape
        // (natives.bur's x86gen_prologue: push rbp + sub rsp,8), so one shared
        // UNWIND_INFO covers all of them. The GC/scheduler internals don't build
        // a standard frame or do raw fiber stack-switching, so they're left out
        // of .pdata coverage this round (an uncovered address falls back to
        // Windows' default leaf-function assumption, no worse than before this
        // change).
        let code_base_off = const_data_len
        let disp_end = disp_off + str_len(dispatcher)
        let pdata_off = pe_align(disp_end, 4)
        let mut pdata_pad = ""
        let mut ppi = disp_end
        while ppi < pdata_off {
            pdata_pad = pdata_pad + byte_chr(0)
            ppi = ppi + 1
        }
        // 内部子程序 unwind 覆盖：三份 UNWIND_INFO（零序言、gc_record 的 9-push、
        // mark_addr 的 7-push）跟在用户函数共享的那份后面；.pdata 数组把内部子程序
        // 的 11 项放在用户函数前面（内部子程序地址恒低于全部用户函数，符合
        // RtlLookupFunctionEntry 要求的 BeginAddress 升序）。索引 0/2 对应
        // rt_unwind_pushes 里 gc_record/mark_addr 的真实寄存器列表，其余 9 项零序言。
        // Internal-subroutine unwind coverage: three UNWIND_INFO blobs (zero
        // prologue, gc_record's 9-push, mark_addr's 7-push) follow the one
        // shared by user functions; the .pdata array places the internal
        // subroutines' 11 entries before the user functions (internal
        // subroutines always sit at lower addresses than every user function,
        // satisfying RtlLookupFunctionEntry's ascending-BeginAddress
        // requirement). Indices 0/2 use rt_unwind_pushes' real register lists
        // for gc_record/mark_addr; the other 9 entries are zero-prologue.
        let unwind_off = pdata_off + 12 * (len(pdata_offsets) + len(rt_unwind_offsets))
        let zero_unwind_off = unwind_off + str_len(pe_unwind_info())
        let push9_unwind_off = zero_unwind_off + str_len(pe_unwind_info_zero())
        let push7_unwind_off = push9_unwind_off + str_len(pe_unwind_info_pushes(rt_unwind_pushes[0]))
        let internal_unwind_offs = [push9_unwind_off, zero_unwind_off, push7_unwind_off, zero_unwind_off, zero_unwind_off, zero_unwind_off, zero_unwind_off, zero_unwind_off, zero_unwind_off, zero_unwind_off, zero_unwind_off]
        let internal_pdata = pe_build_pdata_multi(rt_unwind_offsets, rt_unwind_lens, code_base_off, internal_unwind_offs)
        let pdata_bytes = internal_pdata + pe_build_pdata(pdata_offsets, pdata_lens, code_base_off, unwind_off)
        let unwind_blobs = pe_unwind_info() + pe_unwind_info_zero() + pe_unwind_info_pushes(rt_unwind_pushes[0]) + pe_unwind_info_pushes(rt_unwind_pushes[2])
        let pe_tail = jt_bytes + start_bytes + dispatcher + pdata_pad + pdata_bytes + unwind_blobs
        emit_pe(pic_text(const_data + die_splice(funcs_bytes, die_off, die_len, fn_base + str_len(funcs_bytes) + str_len(pe_tail), fn_base, user_lo, done_addr) + pe_tail + tr_bytes, img_base()), start_off, idata_rva, str_len(imports), pdata_off, str_len(pdata_bytes), pic_data(runtime_with_fd + imports))
    } else if target_os == "darwin" {
        // Mach-O 装配：__TEXT 承载常量/代码/分派器，可写 runtime 区独立进
        // 固定高 VA 的 __DATA；分派器接在 _start 后，槽由 _start 写入。
        // Mach-O assembly: __TEXT carries constants/code/dispatcher while the
        // writable runtime area lives in a fixed-high-VA __DATA; the dispatcher
        // follows _start, which stores the slot.
        let entry_in_text = const_data_len + str_len(funcs_bytes) + str_len(jt_bytes)
        let dispatcher = macho_build_dispatcher()
        let runtime_with_thunk = runtime_bytes + e8(0)
        let mo_tail = jt_bytes + start_bytes + dispatcher
        emit_macho(pic_text(const_data + die_splice(funcs_bytes, die_off, die_len, fn_base + str_len(funcs_bytes) + str_len(mo_tail), fn_base, user_lo, done_addr) + mo_tail + tr_bytes, img_base()), entry_in_text, pic_data(runtime_with_thunk), pdata_offsets, pdata_lens, MACHO_TEXT_OFF + const_data_len, rt_unwind_offsets, rt_unwind_lens, rt_unwind_pushes)
    } else {
        // ELF 装配：代码域（常量/函数/跳转表/_start）R-X；可写 runtime 区独立成
        // 固定高 VA 的 R-W 数据段。
        // ELF assembly: the code domain (constants/functions/jump table/_start)
        // is R-X; the writable runtime area becomes its own R-W data segment at
        // the fixed high VA.
        let elf_tail = jt_bytes + start_bytes
        emit_elf(pic_text(const_data + die_splice(funcs_bytes, die_off, die_len, fn_base + str_len(funcs_bytes) + str_len(elf_tail), fn_base, user_lo, done_addr) + elf_tail + tr_bytes, img_base()), start_off, pic_data(runtime_bytes), pdata_offsets, pdata_lens, const_data_len, rt_unwind_offsets, rt_unwind_lens, rt_unwind_pushes)
    }
}
