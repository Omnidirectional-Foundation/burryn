// x86.bur — 手写 x86-64 机器码后端：逐条 opcode 内联发射（无 runtime 依赖，静态 ELF）。
// Hand-written x86-64 backend: each opcode is inlined into raw machine code (no runtime, static
// ELF).
// 值 = 8B 原始 int64（无 tag，与 C runtime 的 16B tagged Value 不混用）。
// Values are 8-byte raw int64s (untagged; never mixed with the C runtime's 16-byte tagged Value).
// 寄存器约定：r15 = 值栈顶、r14 = 帧基、r13 = 跳转表、r12 = 堆指针、rbx = 全局基（ABI 级，勿改）。
// Register conventions: r15 value stack top, r14 frame base, r13 jump table, r12 heap ptr, rbx
// globals base (ABI-level, do not change).
import "burryn.dev/compiler/lib"

// x86gen_program_to_buf 是 x86 后端入口：字节码表 → x86-64 ELF 二进制字节
// x86gen_program_to_buf is the x86 backend entry: bytecode tables to x86-64 ELF binary bytes
// Entry: bytecode tables to x86-64 ELF binary bytes
pub fn x86gen_program_to_buf(f_name, _f_file, f_arity, f_nupvals, f_code, _f_spans, f_consts, en_qual, en_vnames, _en_varities) {
    // format_float 注入函数 handle（列表/枚举浮点格式化用）
    // handle of the injected format_float (used by list/enum float formatting)
    let f2s_h = find_fn_by_name(f_name, "frt_format_float")

    let nfn = len(f_name)
    let mut const_data = ""
    let mut const_slot_map = map()
    let mut enum_const_map = map()
    let mut sf = 0
    while sf < nfn {
        let consts = f_consts[sf]
        let mut ci = 0
        while ci < len(consts) {
            match consts[ci] {
                lib::CVal::CStr(s) => {
                    let key = const_slot_key(sf, ci)
                    let dup = match get(const_slot_map, key) {
                        Some(_) => true,
                        None => false,
                    }
                    if !dup {
                        put(const_slot_map, key, str_len(const_data))
                        const_data = const_data + e8(str_len(s)) + s
                        while str_len(const_data) % 8 != 0 {
                            const_data = const_data + byte_chr(0)
                        }
                    }
                },
                lib::CVal::CEnumType(_) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                lib::CVal::CSingleton(_, _) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                lib::CVal::CCtor(_, _) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                _ => {},
            }
            ci = ci + 1
        }
        sf = sf + 1
    }
    let mut record_encs = []
    let mut record_offs = []
    let mut rf = 0
    let mut record_field_types = map()
    // enum_field_types 枚举 payload 字段类型表 / enum_field_types holds enum payload field types
    // key = "enum:<qual>|variant0,f0,f1;variant1,f0" (variant 分隔 ";", 字段分隔 ",")
    let mut enum_field_types = map()
    // enum_variant_types 用户枚举 variant 字段类型（key = "v:<eh>:<vi>"）
    // enum_variant_types holds user enum variant field types (key = "v:<eh>:<vi>")
    let mut enum_variant_types = map()
    // exec 系列返回类型编码 / exec-family return type encodings
    let out_enc = enum_payload_enc(enum_field_types, "Output", [["int", "str", "str"]])
    let res_out_enc = enum_payload_enc(enum_field_types, "Result", [[out_enc], ["str"]])
    let res_int_enc = enum_payload_enc(enum_field_types, "Result", [["int"], ["str"]])
    let opt_res_enc = enum_payload_enc(enum_field_types, "Option", [[res_out_enc], []])
    // 共享上下文：全部共享表就绪后构造一次，此后只经容器原地变更 / shared ctx built once
    let mut method_full_map = map()
    let mut fn_ret_type = []
    let mut rhAlloc = 0
    while rhAlloc < nfn {
        push(fn_ret_type, "")
        rhAlloc = rhAlloc + 1
    }
    let mut fn_ret_param = []
    let mut rpAlloc = 0
    while rpAlloc < nfn {
        push(fn_ret_param, 0 - 1)
        rpAlloc = rpAlloc + 1
    }
    let mut fn_param_types = []
    let mut phAlloc = 0
    while phAlloc < nfn {
        let mut plist = []
        let mut piAlloc = 0
        while piAlloc < f_arity[phAlloc] {
            push(plist, "")
            piAlloc = piAlloc + 1
        }
        push(fn_param_types, plist)
        phAlloc = phAlloc + 1
    }
    // created_by: fh -> [创建者 fh, 闭包指令 ip]（upvalue 形态判定的链根）
    // created_by: fh -> [creator fh, closure instruction ip] (chain root for upvalue cell-ness)
    let mut created_by = map()
    let mut global_type = map()
    // sig_specs: 多态函数被调用的去重实参签名（key = psig_key(handle, argtypes)）
    // sig_specs: deduped argument signatures for polymorphic functions
    let mut sig_specs = map()
    // p_sig_grew: 求解期新收集到嵌套签名（列表元素作跨 fn 引用标记）
    // p_sig_grew: a nested signature was collected during the solve (list elem as ref flag)
    let mut p_sig_grew = [false]
    // sig_ret: per-signature 返回类型；aggregate 轮后由签名求解填充
    // sig_ret: per-signature return types, filled by the signature solve after the rounds
    let mut sig_ret = map()
    let mut fn_variants = []
    let mut fv_alloc = 0
    while fv_alloc < nfn {
        push(fn_variants, [])
        fv_alloc = fv_alloc + 1
    }

    // X86Ctx：共享生成上下文（封闭 record；字段=被提升 helper 的隐式共享状态）。
    // 容器字段是堆引用，原地变更对所有持有者可见；字段在构造后不再被重新绑定。
    // X86Ctx: shared codegen context for the lifted helpers below (closed record);
    // container fields are heap references whose in-place mutations every holder
    // sees; no field is rebound after this construction.
    let ctx = record {
        f_name: f_name,
        f_arity: f_arity,
        f_nupvals: f_nupvals,
        f_code: f_code,
        f_consts: f_consts,
        en_qual: en_qual,
        en_vnames: en_vnames,
        nfn: nfn,
        f2s_h: f2s_h,
        const_slot_map: const_slot_map,
        record_encs: record_encs,
        record_offs: record_offs,
        record_field_types: record_field_types,
        enum_field_types: enum_field_types,
        enum_variant_types: enum_variant_types,
        out_enc: out_enc,
        res_out_enc: res_out_enc,
        res_int_enc: res_int_enc,
        opt_res_enc: opt_res_enc,
        global_type: global_type,
        sig_specs: sig_specs,
        sig_ret: sig_ret,
        p_sig_grew: p_sig_grew,
        method_full_map: method_full_map,
        created_by: created_by,
        fn_ret_type: fn_ret_type,
        fn_ret_param: fn_ret_param,
        fn_param_types: fn_param_types,
        fn_variants: fn_variants,
    }

    while rf < nfn {
        let rcode = f_code[rf]
        let mut rip = 0
        while rip < len(rcode) {
            let rop = rcode[rip]
            if rop == lib::op_record || rop == lib::op_record_update {
                let cidx = read_u16(rcode, rip + 2)
                let enc = const_str(ctx, rf, cidx)
                if str_len(enc) > 0 {
                    const_data = add_record_enc(record_encs, record_offs, enc, const_data)
                }
            }
            rip = rip + inst_len(ctx, rf, rcode, rip)
        }
        rf = rf + 1
    }

    let const_data_len = str_len(const_data)
    let mut globals_map = map()
    let mut n_globals = 0
    let mut gf = 0
    while gf < nfn {
        let gcode = f_code[gf]
        let mut gip = 0
        while gip < len(gcode) {
            let gop = gcode[gip]
            if gop == lib::op_def_global {
                let gidx = read_u16(gcode, gip + 1)
                let gname = const_str(ctx, gf, gidx)
                let exists = match get(globals_map, gname) {
                    Some(_) => true,
                    None => false,
                }
                if !exists {
                    put(globals_map, gname, n_globals)
                    n_globals = n_globals + 1
                }
            }
            gip = gip + inst_len(ctx, gf, gcode, gip)
        }
        gf = gf + 1
    }
    // 方法全名映射：CLOSURE + DEF_GLOBAL 配对记录「全局名 → fn handle」
    // map from fully-qualified method names to fn handles (CLOSURE + DEF_GLOBAL pairs)
    // 被 SET_GLOBAL 重赋值的全局不是稳定函数定义（如闭包变量），不注册——否则调用
    // 会误走「按名直接调用」而跳过闭包读取
    // globals reassigned via SET_GLOBAL are not stable function definitions (e.g.
    // closure variables); skip them so calls go through the closure slot
    let mut set_globals = map()
    let mut sgi = 0
    while sgi < nfn {
        let mut sgip = 0
        while sgip < len(f_code[sgi]) {
            if f_code[sgi][sgip] == lib::op_set_global {
                let sgidx = read_u16(f_code[sgi], sgip + 1)
                let sgname = const_str(ctx, sgi, sgidx)
                put(set_globals, sgname, true)
            }
            sgip = sgip + inst_len(ctx, sgi, f_code[sgi], sgip)
        }
        sgi = sgi + 1
    }
    let mut mfi = 0
    while mfi < nfn {
        let mut mgip = 0
        while mgip < len(f_code[mfi]) {
            if f_code[mfi][mgip] == lib::op_def_global && mgip >= 3 && f_code[mfi][mgip - 3] == lib::op_closure {
                let mgidx = read_u16(f_code[mfi], mgip + 1)
                let mgname = const_str(ctx, mfi, mgidx)
                let mcidx = read_u16(f_code[mfi], mgip - 2)
                let mfh = fn_const(ctx, mfi, mcidx)
                if mfh >= 0 {
                    let exists = match get(method_full_map, mgname) {
                        Some(_) => true,
                        None => false,
                    }
                    let reassigned = match get(set_globals, mgname) {
                        Some(_) => true,
                        None => false,
                    }
                    if !exists && !reassigned {
                        put(method_full_map, mgname, mfh)
                    }
                }
            }
            mgip = mgip + inst_len(ctx, mfi, f_code[mfi], mgip)
        }
        mfi = mfi + 1
    }
    // fn_ret_param: 函数直接返回第 k 个参数（返回类型 = 实参类型）；-1 = 非参数直返
    // fn_ret_param: function returns param k directly (ret type = arg type); -1 = not a param passthrough
    let mut cbScan = 0
    while cbScan < nfn {
        let cbcode = f_code[cbScan]
        let mut ccip = 0
        while ccip < len(cbcode) {
            if cbcode[ccip] == lib::op_closure {
                let cbsub = fn_const(ctx, cbScan, read_u16(cbcode, ccip + 1))
                let cexists = match get(created_by, cbsub) {
                    Some(_) => true,
                    None => false,
                }
                if !cexists {
                    put(created_by, cbsub, [cbScan, ccip])
                }
            }
            ccip = ccip + inst_len(ctx, cbScan, cbcode, ccip)
        }
        cbScan = cbScan + 1
    }
    let mut p_depth_maps = []
    // pt_target_shadow: 跳转目标处的 shadow/type_shadow 快照（psim 记录、主循环替换），
    // 修复 break/return 的互斥弹栈导致的静态模拟错位
    // pt_target_shadow: shadow/type_shadow snapshots at jump targets (recorded by psim,
    // applied by the emit loop); fixes static-simulation drift from mutually exclusive
    // pops on break/return paths
    let mut pt_target_shadow = map()
    let mut round = 0
    while round < 4 {
        let mut pti = nfn
        p_depth_maps = []
        // 每轮重置跳转目标快照：跨函数 chan 元素类型在轮间收敛，首次 wins 会卡住首轮
        // reset jump-target snapshots per round: cross-function channel element types
        // converge across rounds; first-wins would pin the incomplete first round
        pt_target_shadow = map()
        while pti > 0 {
            let ptfh = pti - 1
            let mut pd_round = map()
            psim(ctx, ptfh, fn_param_types[ptfh], true, pt_target_shadow, pd_round)
            push(p_depth_maps, pd_round)
            pti = pti - 1
        }
        round = round + 1
    }
    // 签名求解：迭代至收敛（嵌套多态经 sig_ret/sig_specs 传播，直到签名不再增长）
    // signature solve: iterate to fixpoint (nested polymorphism propagates via sig_ret and
    // sig_specs until the signature set stops growing)
    // pd_sink：非聚合 psim 调用的深度表出口（结果不读，仅承接） / throwaway depth-map sink
    let mut pd_sink = map()
    let mut s_changed = true
    let mut s_guard = 0
    while s_changed && s_guard < 8 {
        s_changed = false
        p_sig_grew[0] = false
        let s_all = keys(sig_specs)
        let mut s_i = 0
        while s_i < len(s_all) {
            let skey = s_all[s_i]
            match str_index_of(skey, "@") {
                Some(sci) => {
                    match parse_int(substr(skey, 0, sci)) {
                        Some(shv) => {
                            let s_arg_t = match get(sig_specs, skey) {
                                Some(st) => st,
                                None => [],
                            }
                            let s_new = psim(ctx, shv, s_arg_t, false, pt_target_shadow, pd_sink)
                            let s_old = match get(sig_ret, skey) {
                                Some(v) => v,
                                None => "",
                            }
                            if s_new != s_old {
                                put(sig_ret, skey, s_new)
                                s_changed = true
                            }
                        },
                        None => {},
                    }
                },
                None => {},
            }
            s_i = s_i + 1
        }
        if p_sig_grew[0] {
            s_changed = true
        }
        s_guard = s_guard + 1
    }
    pt_target_shadow = map()
    let mut rti = nfn
    while rti > 0 {
        psim(ctx, rti - 1, fn_param_types[rti - 1], true, pt_target_shadow, pd_sink)
        rti = rti - 1
    }

    // fn_variants: 每个函数的去重调用签名（每个元素 = 一个参数类型列表）
    // fn_variants: deduped call signatures per function (each = one param-type list)
    let fv_all = keys(sig_specs)
    let mut fv_i = 0
    while fv_i < len(fv_all) {
        let fv_key = fv_all[fv_i]
        match str_index_of(fv_key, "@") {
            Some(fvi) => {
                match parse_int(substr(fv_key, 0, fvi)) {
                    Some(fv_h) => {
                        if fv_h >= 0 && fv_h < len(fn_variants) {
                            match get(sig_specs, fv_key) {
                                Some(fv_at) => {
                                    let fv_src = fn_variants[fv_h]
                                    let mut fv_cur = []
                                    let mut fv_cp = 0
                                    while fv_cp < len(fv_src) {
                                        push(fv_cur, fv_src[fv_cp])
                                        fv_cp = fv_cp + 1
                                    }
                                    let mut fv_dup = false
                                    let mut fv_j = 0
                                    while fv_j < len(fv_cur) {
                                        if psig_key(fv_h, fv_cur[fv_j]) == fv_key {
                                            fv_dup = true
                                        }
                                        fv_j = fv_j + 1
                                    }
                                    if !fv_dup {
                                        push(fv_cur, fv_at)
                                        fn_variants[fv_h] = fv_cur
                                    }
                                },
                                None => {},
                            }
                        }
                    },
                    None => {},
                }
            },
            None => {},
        }
        fv_i = fv_i + 1
    }
    // 排序每个函数的签名（确定性）；单签名/未调用函数回退 fn_param_types 单 body
    // sort each function's signatures (determinism); single-sig/uncalled fns fall back to
    // one body seeded from fn_param_types
    let mut fv_s = 0
    while fv_s < nfn {
        let fv_lst_src = fn_variants[fv_s]
        let mut fv_lst = []
        let mut fv_lcp = 0
        while fv_lcp < len(fv_lst_src) {
            push(fv_lst, fv_lst_src[fv_lcp])
            fv_lcp = fv_lcp + 1
        }
        if len(fv_lst) >= 2 {
            let mut fv_i2 = 1
            while fv_i2 < len(fv_lst) {
                let fv_key2 = psig_key(fv_s, fv_lst[fv_i2])
                let mut fv_j2 = fv_i2
                while fv_j2 > 0 && psig_key(fv_s, fv_lst[fv_j2 - 1]) > fv_key2 {
                    let fv_tmp = fv_lst[fv_j2]
                    fv_lst[fv_j2] = fv_lst[fv_j2 - 1]
                    fv_lst[fv_j2 - 1] = fv_tmp
                    fv_j2 = fv_j2 - 1
                }
                fv_i2 = fv_i2 + 1
            }
            fn_variants[fv_s] = fv_lst
        } else {
            let mut fv_one = []
            push(fv_one, fn_param_types[fv_s])
            fn_variants[fv_s] = fv_one
        }
        fv_s = fv_s + 1
    }
    // fn_extra_base: 各多态函数在跳转表额外槽区的起始偏移
    // fn_extra_base: each polymorphic function's start offset in the jump-table extra region
    let mut fn_extra_base = []
    let mut eb_alloc = 0
    while eb_alloc < nfn {
        push(fn_extra_base, 0 - 1)
        eb_alloc = eb_alloc + 1
    }
    let mut n_extra = 0
    let mut eb_i = 0
    while eb_i < nfn {
        if len(fn_variants[eb_i]) >= 2 {
            fn_extra_base[eb_i] = n_extra
            n_extra = n_extra + len(fn_variants[eb_i]) - 1
        }
        eb_i = eb_i + 1
    }

    let gc_rec_bytes = x86gen_gc_record()
    let gc_col = x86gen_gc_collect(n_globals, code_origin() + const_data_len)
    let gc_mark = x86gen_mark_addr()
    // 调度器块（sched/yield/done）与 channel 子程序（schedule/wake_waiters/push_queue）在
    // funcs 头部、GC 子程序之后；地址编译期确定，供 _start / prologue 插桩 / spawn 的
    // fake frame / channel opcode 引用
    let sched_bytes = x86gen_sched_block()
    let sched_addr = code_origin() + const_data_len + str_len(gc_rec_bytes) + str_len(gc_col) + str_len(gc_mark)
    let yield_bytes = x86gen_yield_block(sched_addr)
    let yield_addr = sched_addr + str_len(sched_bytes)
    let done_bytes = x86gen_fiber_done_block(sched_addr)
    let done_addr = yield_addr + str_len(yield_bytes)
    let chan_sched_bytes = x86gen_chan_schedule_block()
    let chan_sched_addr = done_addr + str_len(done_bytes)
    let chan_wake_bytes = x86gen_chan_wake_waiters_block(chan_sched_addr)
    let chan_wake_addr = chan_sched_addr + str_len(chan_sched_bytes)
    let chan_push_sendq_bytes = x86gen_chan_push_queue_block(CH_SENDQ)
    let chan_push_sendq_addr = chan_wake_addr + str_len(chan_wake_bytes)
    let chan_push_recvq_bytes = x86gen_chan_push_queue_block(CH_RECVQ)
    let chan_push_recvq_addr = chan_push_sendq_addr + str_len(chan_push_sendq_bytes)
    let chan_push_waiters_bytes = x86gen_chan_push_queue_block(CH_WAITERS)
    let chan_push_waiters_addr = chan_push_recvq_addr + str_len(chan_push_recvq_bytes)
    let chan_remove_waiter_bytes = x86gen_chan_remove_waiter_block()
    let chan_remove_waiter_addr = chan_push_waiters_addr + str_len(chan_push_waiters_bytes)
    let waitset_add_bytes = x86gen_waitset_add_block()
    let waitset_add_addr = chan_remove_waiter_addr + str_len(chan_remove_waiter_bytes)
    let timer_add_bytes = x86gen_timer_add_block()
    let timer_add_addr = waitset_add_addr + str_len(waitset_add_bytes)
    let mut funcs_bytes = gc_rec_bytes + gc_col + gc_mark + sched_bytes + yield_bytes + done_bytes + chan_sched_bytes + chan_wake_bytes + chan_push_sendq_bytes + chan_push_recvq_bytes + chan_push_waiters_bytes + chan_remove_waiter_bytes + waitset_add_bytes + timer_add_bytes
    let mut func_offsets = []
    let mut variant_offsets = []
    let mut fh = 0
    while fh < nfn {
        let vsigs = fn_variants[fh]
        let nv = len(vsigs)
        let mut vi = 0
        while vi < nv {
            if vi == 0 {
                push(func_offsets, str_len(funcs_bytes))
            } else {
                push(variant_offsets, str_len(funcs_bytes))
            }
            let fbytes = emit_one_variant(ctx, fh, vi, vsigs, f_name, f_arity, f_nupvals, f_code, f_consts, en_qual, en_vnames, nfn, f2s_h, p_depth_maps, pt_target_shadow, pd_sink, globals_map, n_globals, global_type, method_full_map, fn_ret_type, fn_ret_param, fn_param_types, fn_extra_base, record_encs, record_offs, record_field_types, enum_field_types, enum_variant_types, out_enc, res_out_enc, res_int_enc, opt_res_enc, yield_addr, sched_addr, timer_add_addr, done_addr, chan_sched_addr, chan_wake_addr, chan_push_sendq_addr, chan_push_recvq_addr, chan_push_waiters_addr, chan_remove_waiter_addr, waitset_add_addr)
            funcs_bytes = funcs_bytes + fbytes
            vi = vi + 1
        }
        fh = fh + 1
    }

    // 跳转表：每个函数一个入口地址，供闭包按 fn 索引调用
    // Jump table: one entry per function, closures call by fn index
    let mut jt_bytes = ""
    let mut jh = 0
    while jh < nfn {
        jt_bytes = jt_bytes + e8(code_origin() + const_data_len + func_offsets[jh])
        jh = jh + 1
    }
    // 多态函数的额外变体槽位（追加在默认表之后，按 fn_extra_base 定位）
    // Extra variant slots for polymorphic functions (appended after the default entries)
    let mut jx = 0
    while jx < len(variant_offsets) {
        jt_bytes = jt_bytes + e8(code_origin() + const_data_len + variant_offsets[jx])
        jx = jx + 1
    }
    // 布局：runtime 区 + 常量区 + 函数体（GC 子程序在头部）+ 跳转表 + _start，装配 ELF
    // Layout: runtime slots + constants + function bodies (GC subroutines at the head)
    // + jump table + _start
    let gc_rec_addr = code_origin() + const_data_len
    let gc_col_addr = gc_rec_addr + str_len(gc_rec_bytes)
    let gc_mark_addr = gc_col_addr + str_len(gc_col)
    // runtime 槽初始值：三个 GC 子程序地址编译期写入；waitset/timer 计数槽（16B）
    // 与数组零填充，使 runtime_bytes 恰好 RUNTIME_SIZE 长；其余 0 由 _start 填充
    // Runtime slots: the three subroutine addresses are compile-time constants; the
    // waitset/timer count slots (16B) and arrays are zero-filled so runtime_bytes is
    // exactly RUNTIME_SIZE long; the rest are set by _start
    let mut rt_zero = ""
    let mut rzi = 0
    while rzi < 16 + WAITSET_CAP * 16 + TIMER_CAP * 16 + WAITSET_CAP * 8 {
        rt_zero = rt_zero + byte_chr(0)
        rzi = rzi + 1
    }
    let runtime_bytes = e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(gc_rec_addr) + e8(gc_col_addr) + e8(gc_mark_addr) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + e8(0) + rt_zero
    let start_off = rt_region_size() + const_data_len + str_len(funcs_bytes) + str_len(jt_bytes)
    let start_bytes = x86gen_start(nfn + len(variant_offsets), n_globals, sched_addr, done_addr)
    if target_os == "windows" {
        // PE 装配：runtime 区尾的 8B 槽填分派器绝对地址；分派器与 kernel32
        // 导入表依次接在 _start 后。分派器长度与值无关，先以零地址测长，
        // 再按真实 IAT 绝对址重发；槽值据此可算，无需回补。
        // PE assembly: the 8-byte slot at the end of the runtime area holds
        // the dispatcher's absolute address; the dispatcher and the kernel32
        // import table follow _start. The dispatcher length is value-independent,
        // so it is measured once with zero addresses and rebuilt with real IAT
        // addresses; the slot value follows without backpatching.
        let import_names = ["GetStdHandle", "WriteFile", "ExitProcess", "VirtualAlloc", "QueryPerformanceCounter", "QueryPerformanceFrequency"]
        // 分派器接在 _start 之后；槽与导入表 RVA 都从真实内容偏移算起
        // The dispatcher follows _start; the slot and import RVAs derive from
        // the true content offsets.
        let disp_off = start_off + str_len(start_bytes)
        let disp_probe = pe_build_dispatcher([0, 0, 0, 0, 0, 0])
        let idata_off = disp_off + str_len(disp_probe)
        let iat_abs0 = img_base() + idata_off + pe_import_desc_size(len(import_names)) + pe_ilt_size(len(import_names))
        let dispatcher = pe_build_dispatcher([iat_abs0, iat_abs0 + 8, iat_abs0 + 16, iat_abs0 + 24, iat_abs0 + 32, iat_abs0 + 40])
        let runtime_with_thunk = runtime_bytes + e8(img_base() + disp_off)
        let imports = pe_build_imports(import_names, idata_off)
        emit_pe(runtime_with_thunk + const_data + funcs_bytes + jt_bytes + start_bytes + dispatcher + imports, start_off, idata_off, str_len(imports))
    } else if target_os == "darwin" {
        // Mach-O 装配：__TEXT 承载常量/代码/分派器，可写 runtime 区独立进
        // 固定高 VA 的 __DATA；槽值是分派器绝对地址（在 _start 之后），
        // 分派器长度与值无关，单次构建即可。
        // Mach-O assembly: __TEXT carries constants/code/dispatcher while the
        // writable runtime area lives in a fixed-high-VA __DATA; the slot holds
        // the dispatcher's absolute address (right after _start), whose length
        // is value-independent, so a single build suffices.
        let entry_in_text = const_data_len + str_len(funcs_bytes) + str_len(jt_bytes)
        let dispatcher = macho_build_dispatcher()
        let dispatcher_va = img_base() + entry_in_text + str_len(start_bytes)
        let runtime_with_thunk = runtime_bytes + e8(dispatcher_va)
        emit_macho(const_data + funcs_bytes + jt_bytes + start_bytes + dispatcher, entry_in_text, runtime_with_thunk)
    } else {
        emit_elf(runtime_bytes + const_data + funcs_bytes + jt_bytes + start_bytes, start_off)
    }
}

