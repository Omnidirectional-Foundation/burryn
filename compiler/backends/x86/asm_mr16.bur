// asm_mr16.bur — mov_mr16。
// asm_mr16.bur — mov_mr16.



// mov_mr16 发射 16 位寄存器到内存 / mov_mr16 emits a 16-bit register-to-memory store
pub fn mov_mr16(base, disp, src) {
    let op = if disp == 0 && base % 8 != 5 {
        modrm(0, src, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        modrm(1, src, base) + sib_for(base) + sb(disp)
    } else {
        modrm(2, src, base) + sib_for(base) + e4s(disp)
    }
    e1(102) + rex(0, src, 0, base) + e1(137) + op
}
