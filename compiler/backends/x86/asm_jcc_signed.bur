// asm_jcc_signed.bur — 有符号跳转。
// asm_jcc_signed.bur — signed jumps.

// jl_rel32 发射 jl rel32（有符号小于） / jl_rel32 emits jl rel32 (signed less-than)
// jl_rel32 emits jl rel32 (signed less-than)
// jl rel32 (signed less)
pub fn jl_rel32(off) {
    e1(15) + e1(140) + e4s(off)
}

// jg_rel32 发射 jg rel32（有符号大于） / jg_rel32 emits jg rel32 (signed greater-than)
// jg_rel32 emits jg rel32 (signed greater-than)
// jg rel32 (signed greater)
pub fn jg_rel32(off) {
    e1(15) + e1(143) + e4s(off)
}
