// emit_map_parts.bur — map key/val。
// emit_map_parts.bur — map key/val.

// map_key_type 取 map 键类型 / map_key_type extracts the map key type
fn map_key_type(t) {
    if t == "map-str" || t == "map-str-int" || t == "map-str-str" || t == "map-str-float" {
        "str"
    } else if t == "map-int" || t == "map-int-str" || t == "map-int-int" || t == "map-int-float" {
        "int"
    } else {
        ""
    }
}

// map_val_type 取 map 值类型 / map_val_type extracts the map value type
fn map_val_type(t) {
    if t == "map-str-int" || t == "map-int-int" {
        "int"
    } else if t == "map-str-str" || t == "map-int-str" {
        "str"
    } else if t == "map-str-float" || t == "map-int-float" {
        "float"
    } else {
        ""
    }
}
