// errtext_msvc 是 Windows CRT 的 strerror(1..135)（CI dump 逐字；100+ 段是 WSA 映射的
// 小写文本） / errtext_msvc is the Windows CRT's strerror(1..135), verbatim from the
// CI dump (the 100+ range is WSA-mapped lowercase text)
fn errtext_msvc() {
    ["Operation not permitted", "No such file or directory", "No such process", "Interrupted function call", "Input/output error", "No such device or address", "Arg list too long", "Exec format error", "Bad file descriptor", "No child processes", "Resource temporarily unavailable", "Not enough space", "Permission denied", "Bad address", "Unknown error", "Resource device", "File exists", "Improper link", "No such device", "Not a directory", "Is a directory", "Invalid argument", "Too many open files in system", "Too many open files", "Inappropriate I/O control operation", "Unknown error", "File too large", "No space left on device", "Invalid seek", "Read-only file system", "Too many links", "Broken pipe", "Domain error", "Result too large", "Unknown error", "Resource deadlock avoided", "Unknown error", "Filename too long", "No locks available", "Function not implemented", "Directory not empty", "Illegal byte sequence", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "Unknown error", "address in use", "address not available", "address family not supported", "connection already in progress", "bad message", "operation canceled", "connection aborted", "connection refused", "connection reset", "destination address required", "host unreachable", "identifier removed", "operation in progress", "already connected", "too many symbolic link levels", "message size", "network down", "network reset", "network unreachable", "no buffer space", "no message available", "no link", "no message", "no protocol option", "no stream resources", "not a stream", "not connected", "state not recoverable", "not a socket", "not supported", "operation not supported", "Unknown error", "value too large", "owner dead", "protocol error", "protocol not supported"]
}

// errtext_table 取当前目标的文本表（下标 = errno - 1），空表表示回落 "os error"
// errtext_table returns the current target's text table (index = errno - 1);
// an empty table means falling back to "os error"
fn errtext_table() {
    if target_os == "linux" {
        errtext_glibc()
    } else if target_os == "darwin" {
        errtext_darwin()
    } else {
        errtext_msvc()
    }
}

// errtext_unknown_prefix 是越界码的平台格式前缀；Windows 不带号码
// errtext_unknown_prefix is the platform's out-of-range format; Windows omits
// the number entirely
fn errtext_unknown_prefix() {
    if target_os == "darwin" {
        "Unknown error: "
    } else {
        "Unknown error "
    }
}

// gai_noname_text 对齐各平台 gai_strerror(EAI_NONAME)，值逐字取自 CI dump（Windows
// 的 gai_strerror 返回带尾随空格的定宽缓冲，按原样保留）
// gai_noname_text matches each platform's gai_strerror(EAI_NONAME), verbatim
// from the CI dump (Windows' gai_strerror returns a padded buffer; the trailing
// space is kept as-is)
fn gai_noname_text() {
    if target_os == "linux" {
        "Name or service not known"
    } else if target_os == "darwin" {
        "nodename nor servname provided, or not known"
    } else {
        "No such host is known. "
    }
}

// la_lea_rip 以 RIP 相对 lea 取标签地址 / la_lea_rip loads a label's address with a RIP-relative lea
fn la_lea_rip(reg, name) {
    let pre = rex(1, reg, 0, 0) + e1(141) + modrm(0, reg, 5)
    "J" + byte_chr(str_len(pre)) + pre + name
}

// x86gen_errtext_items 生成 errtext 子程序：表 [n:8][off:8 * n][串 [len:8][bytes]]
// 接在代码后；越界码走平台格式（Windows 不拼号码）
// x86gen_errtext_items emits the errtext subroutine with its table
// [n:8][off:8 * n][strings [len:8][bytes]] after the code; out-of-range codes
// take the platform's format (Windows emits no number)
fn x86gen_errtext_items() {
    let tab = errtext_table()
    let n = len(tab)
    let mut it = []
    push(it, la_lea_rip(r9, "et_table"))
    if n == 0 {
        push(it, la_b(mov_rm(rax, r9, 8) + add_rr(rax, r9) + ret()))
    } else {
        push(it, la_b(cmp_ri32(rdi, 1)))
        push(it, la_jcc(CC_L, "et_unknown"))
        push(it, la_b(cmp_ri32(rdi, n)))
        push(it, la_jcc(CC_G, "et_unknown"))
        push(it, la_b(mov_rr(rax, rdi) + shl_ri(rax, 3) + add_rr(rax, r9) + mov_rm(rax, rax, 0) + add_rr(rax, r9) + ret()))
        push(it, la_l("et_unknown"))
        if target_os == "windows" {
            // MSVC 的越界文本不带号码 / MSVC's out-of-range text carries no number
            push(it, la_b(push_r(rdi) + sb_call(sb_new_g) + mov_rr(rdi, rax) + push_r(rdi) + sb_lit_bytes(errtext_unknown_prefix()) + pop_r(rdi) + pop_r(rsi) + sb_call(sb_fin_g) + ret()))
        } else {
            push(it, la_b(push_r(rdi) + sb_call(sb_new_g) + pop_r(rsi) + push_r(rax) + mov_rr(rdi, rax) + push_r(rsi) + sb_lit_bytes(errtext_unknown_prefix()) + pop_r(rsi) + mov_rm(rdi, rsp, 0) + sb_call(sb_int_g) + pop_r(rdi) + sb_call(sb_fin_g) + ret()))
        }
    }
    // 表：n = 0 时唯一一项是回落文本 / table: with n = 0 its only entry is the fallback text
    let texts = if n == 0 {
        ["os error"]
    } else {
        tab
    }
    let mut offs = []
    let mut strs = []
    let mut at = 8 + 8 * len(texts)
    let mut k = 0
    while k < len(texts) {
        push(offs, e8(at))
        push(strs, e8(str_len(texts[k])) + texts[k])
        at = at + 8 + str_len(texts[k])
        k = k + 1
    }
    push(it, la_l("et_table"))
    push(it, la_b(e8(len(texts)) + join(offs, "") + join(strs, "")))
    it
}

// x86gen_err_from_errno 由 rax = 负 errno 构造 Err(文本) 实例（rax 返回）
// x86gen_err_from_errno builds an Err(text) instance from rax = negative errno
// (returned in rax)
fn x86gen_err_from_errno() {
    neg_r(rax) + mov_rr(rdi, rax) + mov_ri64(r11, errtext_g) + call_r(r11) + mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_rr(rax, rcx)
}

// x86gen_errno_text 构造 "<op>: <strerror(errno)>" 字符串（rax 返回）：rdi = 正 errno。
// 构建器只经机器栈引用且序列内无 GC 安全点；errtext 会破坏 r9，errno 经 rdx 与机器栈
// 跨 errtext 调用
// x86gen_errno_text builds the "<op>: <strerror(errno)>" string (returned in
// rax): rdi = positive errno. The builder is only referenced from the machine
// stack and the sequence has no GC safepoint; errtext clobbers r9, and the
// errno travels in rdx and on the machine stack across the errtext call
fn x86gen_errno_text(op) {
    push_r(rdi) + sb_call(sb_new_g) + mov_rr(rdi, rax) + sb_lit_bytes(op + ": ") + pop_r(rdx) + push_r(rdi) + mov_rr(rdi, rdx) + mov_ri64(r11, errtext_g) + call_r(r11) + mov_rr(rsi, rax) + mov_rm(rdx, rax, 0) + add_ri32(rsi, 8) + pop_r(rdi) + sb_call(sb_app_g) + sb_call(sb_fin_g)
}

// x86gen_err_op_errno 构造 Err("<op>: <strerror(errno)>") 实例（rax 返回）
// x86gen_err_op_errno builds an Err("<op>: <strerror(errno)>") instance
// (returned in rax)
fn x86gen_err_op_errno(op) {
    x86gen_errno_text(op) + mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_rr(rax, rcx)
}

// x86gen_str_lit 在堆上构造字符串字面量对象（rax 返回，8B 分块写入）
// x86gen_str_lit builds a string literal object on the heap (returned in rax,
// written in 8-byte chunks)
fn x86gen_str_lit(text) {
    let n = str_len(text)
    let mut code = mov_rr(rax, r12) + mov_ri64(rdx, n) + mov_mr(rax, 0, rdx)
    let mut ci = 0
    while ci * 8 < n {
        let mut v = 0
        let mut mul = 1
        let mut bj = 0
        while bj < 8 && ci * 8 + bj < n {
            v = v + byte_at(text, ci * 8 + bj) * mul
            if bj < 7 {
                mul = mul * 256
            }
            bj = bj + 1
        }
        code = code + mov_ri64(rdx, v) + mov_mr(rax, 8 + 8 * ci, rdx)
        ci = ci + 1
    }
    code + add_ri32(r12, 8 + (n + 7) / 8 * 8)
}

// x86gen_err_lit 构造 Err(固定文本) 实例（rax 返回） / x86gen_err_lit builds an
// Err(fixed text) instance (returned in rax)
fn x86gen_err_lit(text) {
    x86gen_str_lit(text) + mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_rr(rax, rcx)
}
