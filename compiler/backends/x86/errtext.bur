// errtext.bur — 系统错误码 → 错误文本，逐目标对齐该平台 C 运行时的 strerror。
// System error codes to error text, matched per target to that platform's C
// runtime strerror.
//
// errtext 子程序：rdi = 正 errno → rax = 字符串对象（表内文本常驻代码域，未知码
// 按平台格式现拼）。Linux 表取自 glibc（scripts/errtext-dump.c 输出的 1..133）；
// darwin/windows 的表待真机数据补上，此前仍回落 "os error"。
// The errtext subroutine: rdi = positive errno -> rax = string object (table
// texts live in the code domain; unknown codes are built per the platform's
// format). The Linux table comes from glibc (1..133 as printed by
// scripts/errtext-dump.c); the darwin/windows tables are pending real-runner
// data and fall back to "os error" until then.

pub let mut errtext_g = 0

// errtext_glibc 是 glibc 的 strerror(1..133) / errtext_glibc is glibc's strerror(1..133)
fn errtext_glibc() {
    ["Operation not permitted", "No such file or directory", "No such process", "Interrupted system call", "Input/output error", "No such device or address", "Argument list too long", "Exec format error", "Bad file descriptor", "No child processes", "Resource temporarily unavailable", "Cannot allocate memory", "Permission denied", "Bad address", "Block device required", "Device or resource busy", "File exists", "Invalid cross-device link", "No such device", "Not a directory", "Is a directory", "Invalid argument", "Too many open files in system", "Too many open files", "Inappropriate ioctl for device", "Text file busy", "File too large", "No space left on device", "Illegal seek", "Read-only file system", "Too many links", "Broken pipe", "Numerical argument out of domain", "Numerical result out of range", "Resource deadlock avoided", "File name too long", "No locks available", "Function not implemented", "Directory not empty", "Too many levels of symbolic links", "Unknown error 41", "No message of desired type", "Identifier removed", "Channel number out of range", "Level 2 not synchronized", "Level 3 halted", "Level 3 reset", "Link number out of range", "Protocol driver not attached", "No CSI structure available", "Level 2 halted", "Invalid exchange", "Invalid request descriptor", "Exchange full", "No anode", "Invalid request code", "Invalid slot", "Unknown error 58", "Bad font file format", "Device not a stream", "No data available", "Timer expired", "Out of streams resources", "Machine is not on the network", "Package not installed", "Object is remote", "Link has been severed", "Advertise error", "Srmount error", "Communication error on send", "Protocol error", "Multihop attempted", "RFS specific error", "Bad message", "Value too large for defined data type", "Name not unique on network", "File descriptor in bad state", "Remote address changed", "Can not access a needed shared library", "Accessing a corrupted shared library", ".lib section in a.out corrupted", "Attempting to link in too many shared libraries", "Cannot exec a shared library directly", "Invalid or incomplete multibyte or wide character", "Interrupted system call should be restarted", "Streams pipe error", "Too many users", "Socket operation on non-socket", "Destination address required", "Message too long", "Protocol wrong type for socket", "Protocol not available", "Protocol not supported", "Socket type not supported", "Operation not supported", "Protocol family not supported", "Address family not supported by protocol", "Address already in use", "Cannot assign requested address", "Network is down", "Network is unreachable", "Network dropped connection on reset", "Software caused connection abort", "Connection reset by peer", "No buffer space available", "Transport endpoint is already connected", "Transport endpoint is not connected", "Cannot send after transport endpoint shutdown", "Too many references: cannot splice", "Connection timed out", "Connection refused", "Host is down", "No route to host", "Operation already in progress", "Operation now in progress", "Stale file handle", "Structure needs cleaning", "Not a XENIX named type file", "No XENIX semaphores available", "Is a named type file", "Remote I/O error", "Disk quota exceeded", "No medium found", "Wrong medium type", "Operation canceled", "Required key not available", "Key has expired", "Key has been revoked", "Key was rejected by service", "Owner died", "State not recoverable", "Operation not possible due to RF-kill", "Memory page has hardware error"]
}

// errtext_table 取当前目标的文本表（下标 = errno - 1），空表表示回落 "os error"
// errtext_table returns the current target's text table (index = errno - 1);
// an empty table means falling back to "os error"
fn errtext_table() {
    if target_os == "linux" {
        errtext_glibc()
    } else {
        []
    }
}

// la_lea_rip 以 RIP 相对 lea 取标签地址 / la_lea_rip loads a label's address with a RIP-relative lea
fn la_lea_rip(reg, name) {
    let pre = rex(1, reg, 0, 0) + e1(141) + modrm(0, reg, 5)
    "J" + byte_chr(str_len(pre)) + pre + name
}

// x86gen_errtext_items 生成 errtext 子程序：表 [n:8][off:8 * n][串 [len:8][bytes]]
// 接在代码后；越界码走平台格式的 "Unknown error N"
// x86gen_errtext_items emits the errtext subroutine with its table
// [n:8][off:8 * n][strings [len:8][bytes]] after the code; out-of-range codes
// take the platform's "Unknown error N" form
fn x86gen_errtext_items() {
    let tab = errtext_table()
    let n = len(tab)
    let mut it = []
    push(it, la_lea_rip(r9, "et_table"))
    if n == 0 {
        push(it, la_b(mov_rm(rax, r9, 8) + add_rr(rax, r9) + ret()))
    } else {
        push(it, la_b(cmp_ri32(rdi, 1)))
        push(it, la_jcc(CC_L, "et_unknown"))
        push(it, la_b(cmp_ri32(rdi, n)))
        push(it, la_jcc(CC_G, "et_unknown"))
        push(it, la_b(mov_rr(rax, rdi) + shl_ri(rax, 3) + add_rr(rax, r9) + mov_rm(rax, rax, 0) + add_rr(rax, r9) + ret()))
        push(it, la_l("et_unknown"))
        push(it, la_b(push_r(rdi) + sb_call(sb_new_g) + pop_r(rsi) + push_r(rax) + mov_rr(rdi, rax) + push_r(rsi) + sb_lit_bytes("Unknown error ") + pop_r(rsi) + mov_rm(rdi, rsp, 0) + sb_call(sb_int_g) + pop_r(rdi) + sb_call(sb_fin_g) + ret()))
    }
    // 表：n = 0 时唯一一项是回落文本 / table: with n = 0 its only entry is the fallback text
    let texts = if n == 0 {
        ["os error"]
    } else {
        tab
    }
    let mut offs = []
    let mut strs = []
    let mut at = 8 + 8 * len(texts)
    let mut k = 0
    while k < len(texts) {
        push(offs, e8(at))
        push(strs, e8(str_len(texts[k])) + texts[k])
        at = at + 8 + str_len(texts[k])
        k = k + 1
    }
    push(it, la_l("et_table"))
    push(it, la_b(e8(len(texts)) + join(offs, "") + join(strs, "")))
    it
}

// x86gen_err_from_errno 由 rax = 负 errno 构造 Err(文本) 实例（rax 返回）
// x86gen_err_from_errno builds an Err(text) instance from rax = negative errno
// (returned in rax)
fn x86gen_err_from_errno() {
    neg_r(rax) + mov_rr(rdi, rax) + mov_ri64(r11, errtext_g) + call_r(r11) + mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_rr(rax, rcx)
}

// x86gen_str_lit 在堆上构造字符串字面量对象（rax 返回，8B 分块写入）
// x86gen_str_lit builds a string literal object on the heap (returned in rax,
// written in 8-byte chunks)
fn x86gen_str_lit(text) {
    let n = str_len(text)
    let mut code = mov_rr(rax, r12) + mov_ri64(rdx, n) + mov_mr(rax, 0, rdx)
    let mut ci = 0
    while ci * 8 < n {
        let mut v = 0
        let mut mul = 1
        let mut bj = 0
        while bj < 8 && ci * 8 + bj < n {
            v = v + byte_at(text, ci * 8 + bj) * mul
            if bj < 7 {
                mul = mul * 256
            }
            bj = bj + 1
        }
        code = code + mov_ri64(rdx, v) + mov_mr(rax, 8 + 8 * ci, rdx)
        ci = ci + 1
    }
    code + add_ri32(r12, 8 + (n + 7) / 8 * 8)
}

// x86gen_err_lit 构造 Err(固定文本) 实例（rax 返回） / x86gen_err_lit builds an
// Err(fixed text) instance (returned in rax)
fn x86gen_err_lit(text) {
    x86gen_str_lit(text) + mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_rr(rax, rcx)
}
