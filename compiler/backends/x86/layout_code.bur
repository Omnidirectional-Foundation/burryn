// layout_code.bur — 代码/数据原点。
// layout_code.bur — code/data origins.

// code_origin 返回代码/常量内容的绝对起点：darwin 的 runtime 区已迁出 __TEXT，
// 常量紧跟头区；其余目标的常量仍在 runtime 区之后。
// code_origin returns the absolute start of code/constants content: on darwin
// the runtime area has moved out of __TEXT so constants follow the headers
// directly; other targets keep them after the runtime area.
pub fn code_origin() {
    if target_os == "darwin" {
        img_base()
    } else {
        img_base() + rt_region_size()
    }
}

// data_origin 返回可写 runtime 区的绝对基址：darwin 独立落在固定高 VA 的
// __DATA 段（与 __TEXT 尺寸解耦），其余目标与代码同域。
// data_origin returns the writable runtime area's absolute base: on darwin it
// lives in a fixed-high-VA __DATA segment (decoupled from the __TEXT size);
// other targets share the code domain.
pub fn data_origin() {
    if target_os == "darwin" {
        macho_base + MACHO_DATA_VA_OFF
    } else {
        img_base()
    }
}
