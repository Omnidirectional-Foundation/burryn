// emit_variant_idx.bur — variant_index。
// emit_variant_idx.bur — variant_index.

import "burryn.dev/compiler/lib"

// variant_index: 实参类型在 fn_variants 中的下标（未命中 0 = 默认变体）
// variant_index: index of arg types in fn_variants (0 = default variant if absent)
fn variant_index(ctx: record { f_name: [str], f_arity: [int], f_nupvals: [int], f_code: [[int]], f_consts: [[lib::CVal]], en_qual: [str], en_vnames: [[str]], nfn: int, f2s_h: int, const_slot_map: map(int, int), record_encs: [str], record_offs: [int], record_field_types: map(str, [str]), enum_field_types: map(str, [[str]]), enum_variant_types: map(str, [str]), out_enc: str, res_out_enc: str, res_int_enc: str, opt_res_enc: str, global_type: map(str, str), sig_specs: map(str, [str]), sig_ret: map(str, str), p_sig_grew: [bool], method_full_map: map(str, int), created_by: map(int, [int]), fn_ret_type: [str], fn_ret_param: [int], fn_param_types: [[str]], fn_variants: [[[str]]] }, h, ats) {
    if h >= 0 && h < len(ctx.fn_variants) {
        let fv_vs = ctx.fn_variants[h]
        let fv_vk = psig_key(h, ats)
        let mut fv_vi = 0
        while fv_vi < len(fv_vs) {
            if psig_key(h, fv_vs[fv_vi]) == fv_vk {
                return fv_vi
            }
            fv_vi = fv_vi + 1
        }
        let mut fv_best = 0 - 1
        let mut fv_best_n = 0 - 1
        fv_vi = 0
        while fv_vi < len(fv_vs) {
            let fv_spec = fv_vs[fv_vi]
            if len(fv_spec) == len(ats) {
                let mut fv_ok = true
                let mut fv_eq = 0
                let mut fv_k = 0
                while fv_k < len(ats) {
                    let a = ats[fv_k]
                    let s = fv_spec[fv_k]
                    if str_len(s) > 0 && str_len(a) > 0 && s != a {
                        fv_ok = false
                    } else if str_len(s) > 0 && s == a {
                        fv_eq = fv_eq + 1
                    }
                    fv_k = fv_k + 1
                }
                if fv_ok && fv_eq > fv_best_n {
                    fv_best_n = fv_eq
                    fv_best = fv_vi
                }
            }
            fv_vi = fv_vi + 1
        }
        if fv_best >= 0 {
            return fv_best
        }
    }
    0
}
