// macho.bur — Mach-O 输出：load command、段与 dylib 绑定，UUID 与链接编辑。
// Mach-O output: load commands, segments and dylib bindings, UUID and link edit.

pub let macho_base = 4294967296

// MACHO_TEXT_OFF 是 __TEXT 内容在文件与 VM 中的起点（头区命令块之后的首页）
// MACHO_TEXT_OFF is where __TEXT content starts in both file and VM (the first
// page after the command block)
pub let MACHO_TEXT_OFF = 4096

// macho_hdr_size 是命令块总长：32B mach_header_64 之后接十一条命令
// （PAGEZERO/TEXT+两节(__text、__unwind_info)/DATA/LINKEDIT 四段 448B、UUID 24、
// MAIN 24、BUILD_VERSION 24、DYLINKER 28、LOAD_DYLIB 56、CHAINED_FIXUPS 16、
// FUNCTION_STARTS 16）
// macho_hdr_size is the command-block length: a 32-byte mach_header_64
// followed by eleven commands (four segments PAGEZERO/TEXT+two sections
// (__text, __unwind_info)/DATA/LINKEDIT at 448B total, UUID 24, MAIN 24,
// BUILD_VERSION 24, DYLINKER 28, LOAD_DYLIB 56, CHAINED_FIXUPS 16,
// FUNCTION_STARTS 16)
pub fn macho_hdr_size() {
    668
}

// uleb128 生成小端 ULEB128 变长编码（LC_FUNCTION_STARTS 载荷的编码单位）；调用方
// 保证 n 非负——文件内偏移天然非负，用不上负数分支
// uleb128 emits little-endian ULEB128 (the encoding unit for LC_FUNCTION_STARTS'
// payload); callers guarantee n is non-negative — file offsets are inherently
// so, no negative branch is needed
fn uleb128(n) {
    let mut out = ""
    let mut v = n
    let mut going = true
    while going {
        let mut b = v % 128
        v = v / 128
        if v != 0 {
            b = b + 128
        } else {
            going = false
        }
        out = out + byte_chr(b)
    }
    out
}

// macho_function_starts_payload 生成 LC_FUNCTION_STARTS 载荷：升序偏移表压成
// ULEB128 差分序列（首项相对 __TEXT vmaddr，其余相对上一项），tool 无需符号表
// 即可按函数边界符号化。offs 是 funcs_bytes 内偏移（发射顺序 = 地址升序，与 PE
// .pdata 复用同一份 pdata_offsets），code_base 是 funcs_bytes 在文件内的起点
// （MACHO_TEXT_OFF + funcs_bytes 在 text_content 内的偏移）。
// macho_function_starts_payload builds LC_FUNCTION_STARTS' payload: the
// ascending offset table packed into a ULEB128 delta sequence (the first entry
// is relative to __TEXT's vmaddr, the rest to the previous entry), letting tools
// symbolicate by function boundary without a symbol table. offs are offsets
// within funcs_bytes (emission order = ascending address, reusing the same
// pdata_offsets as PE's .pdata); code_base is funcs_bytes' file-relative start
// (MACHO_TEXT_OFF + funcs_bytes' offset within text_content).
fn macho_function_starts_payload(offs, code_base) {
    let mut payload = ""
    let mut prev = 0
    let mut i = 0
    while i < len(offs) {
        let abs_off = code_base + offs[i]
        payload = payload + uleb128(abs_off - prev)
        prev = abs_off
        i = i + 1
    }
    payload
}

// macho_function_starts_cmd 生成 LC_FUNCTION_STARTS（linkedit_data_command，
// 与 macho_chained_fixups 同构：cmd + cmdsize(16) + dataoff + datasize）
// macho_function_starts_cmd builds LC_FUNCTION_STARTS (a linkedit_data_command,
// the same shape as macho_chained_fixups: cmd + cmdsize(16) + dataoff + datasize)
fn macho_function_starts_cmd(dataoff, datasize) {
    u32(38) + u32(16) + u32(dataoff) + u32(datasize)
}

// macho_unwind_encoding 生成全程序共享的 x86_64 compact unwind 编码：唯一序言
// 形态（push rbp + sub rsp,8，共 16 字节栈占用、1 个保存寄存器）落在
// UNWIND_X86_64_MODE_STACK_IMMD——frameless（rbp 不当帧指针）、栈立即数、按
// LLVM `compact_unwind_encoding.h` 逐字核对的排列码：
// mode(0x02000000) | stack_size=16/8=2 左移 16 位 | reg_count=1 左移 10 位 |
// permutation。排列码按官方 permute_encode 算法手算：仅存 RBP（寄存器号 6，
// UNWIND_X86_64_REG_RBP），registerCount=1 时 renumregs[5] =
// registers[5] - countless - 1 = 6 - 0 - 1 = 5，故 permutation = 5。
// 未接真机验证（S8.5 R1/R2 之外的项，写的时候不需要真机）——比特级来源是权威文档
// 逐字抄的算法，不是凭记忆猜的，但没有拿真实二进制或 lldb 反查过，如实记此状态。
// macho_unwind_encoding builds the whole-program shared x86_64 compact unwind
// encoding: the sole prologue shape (push rbp + sub rsp,8, 16 bytes of stack use,
// 1 saved register) lands on UNWIND_X86_64_MODE_STACK_IMMD — frameless (rbp is
// not a frame pointer), stack-immediate, permutation checked byte-for-byte
// against LLVM's compact_unwind_encoding.h: mode(0x02000000) |
// stack_size=16/8=2 shifted left 16 | reg_count=1 shifted left 10 | permutation.
// The permutation is hand-computed via the documented permute_encode algorithm:
// only RBP is saved (register number 6, UNWIND_X86_64_REG_RBP), and with
// registerCount=1, renumregs[5] = registers[5] - countless - 1 = 6 - 0 - 1 = 5,
// so permutation = 5.
// Not verified against real hardware (an item outside S8.5's R1/R2, which don't
// need real hardware to write) — the bit-level source is copied verbatim from
// authoritative documentation, not guessed from memory, but it has not been
// cross-checked against a real binary or lldb; stating that plainly rather than
// implying more confidence than earned.
fn macho_unwind_encoding() {
    33686533
}

// macho_unwind_encoding_pushes 生成"入口连续 push、不带 sub rsp"这一类序言
// （`gc_record`/`mark_addr`，空数组即零序言）的 compact unwind 编码：仍是
// UNWIND_X86_64_MODE_STACK_IMMD（frameless、栈立即数），stack_size 字段直接
// 等于 push 条数（每条 push 定长搬 8 字节，不像 PE/ELF 的按字节偏移那样需要
// 区分 REX 前缀长度——compact unwind 的 stack_size 单位本就是 8 字节，不是
// 指令字节数），reg_count 与 permutation 都置 0——不为这些寄存器（多数不是
// callee-saved，是这些子程序特意保护的调用者寄存器）走 permutation 编码：
// compact unwind 的 permutation 字段设计上只描述标准 callee-saved 寄存器
// （rbx/r12-r15/rbp）的保存位置，供异常传播时真正"恢复"用；本项目不做
// personality/LSDA 异常展开（见 macho_unwind_info 的空异常处理器留白），
// 只要 stack_size correct 就能正确算出 CFA/返回地址、继续回溯——reg_count=0
// 等价于"不描述任何寄存器恢复位置"，对纯回溯无影响。
// macho_unwind_encoding_pushes builds the compact unwind encoding for the
// "consecutive pushes at entry, no sub rsp" prologue shape (gc_record/
// mark_addr; an empty array is the zero prologue): still
// UNWIND_X86_64_MODE_STACK_IMMD (frameless, stack-immediate). The stack_size
// field is simply the push count (each push moves a fixed 8 bytes — unlike
// PE/ELF's byte-offset tracking, compact unwind's stack_size unit is already
// 8 bytes, not instruction bytes, so there's no need to distinguish
// REX-prefixed push lengths here). reg_count and permutation stay 0 — these
// pushes mostly aren't callee-saved registers (they're caller-saved
// registers these subroutines deliberately protect), and compact unwind's
// permutation field is designed to describe only the standard callee-saved
// set (rbx/r12-r15/rbp) for actually restoring them during exception
// propagation; this project does no personality/LSDA-based exception
// unwinding (see macho_unwind_info's empty exception-handler fields), so a
// correct stack_size alone is enough to compute CFA/the return address and
// keep walking the backtrace — reg_count=0 means "no register-restore
// locations described," which doesn't matter for pure backtracing.
fn macho_unwind_encoding_pushes(push_regs) {
    33554432 + len(push_regs) * 65536
}

// macho_unwind_info 生成 __TEXT,__unwind_info 节内容：不用 compressed 二级页
// （不需要共享编码索引表那层间接——regular 页本就逐项直存编码值，异质编码
// 天然支持，不必额外绕一层压缩索引）；单个 regular 二级页装全部函数（用户
// 函数与内部子程序混在同一页，按地址升序排列），一级索引两项（真实页 + 终结
// 哨兵，终结项 secondLevelPagesSectionOffset=0、functionOffset=末函数结尾，
// dyld 靠它界定覆盖范围末端）；personality/LSDA 数组留空（无异常处理器）。
// encodings 与 offs/lens 平行，逐项指定各自的 compact unwind 编码——内部子
// 程序（gc_record 的 9-push、mark_addr 的 7-push、其余零序言）与用户函数三种
// 编码交错出现，regular 页格式天然按项存储，不需要为异质编码单独设计结构。
// macho_unwind_info builds the __TEXT,__unwind_info section content: no
// compressed second-level pages (no need for that layer of indirection
// through a shared-encoding table — a regular page already stores the
// encoding value per entry, so heterogeneous encodings are natively
// supported without an extra compression layer); a single regular
// second-level page holds every function (user functions and internal
// subroutines interleaved in the same page, in ascending address order), and
// the first-level index has two entries (the real page plus a terminating
// sentinel — the sentinel has secondLevelPagesSectionOffset=0 and
// functionOffset=the last function's end, which is how dyld bounds the
// covered range); the personality/LSDA arrays stay empty (no exception
// handler). encodings runs parallel to offs/lens, giving each entry its own
// compact unwind encoding — the internal subroutines' three shapes
// (gc_record's 9-push, mark_addr's 7-push, the rest zero-prologue)
// interleave with the user-function shape, and the regular page format
// stores per-entry values natively, needing no extra structure for
// heterogeneous encodings.
fn macho_unwind_info(offs, lens, code_base, encodings) {
    let n = len(offs)
    let index_off = 28
    let page_off = index_off + 2 * 12
    let last = code_base + offs[n - 1] + lens[n - 1]
    let hdr = u32(1) + u32(index_off) + u32(0) + u32(index_off) + u32(0) + u32(index_off) + u32(2)
    let index = u32(code_base + offs[0]) + u32(page_off) + u32(page_off) + u32(last) + u32(0) + u32(page_off)
    let mut page = u32(2) + u16(8) + u16(n)
    let mut i = 0
    while i < n {
        page = page + u32(code_base + offs[i]) + u32(encodings[i])
        i = i + 1
    }
    hdr + index + page
}

// macho_chained_fixups 生成 LC_DYLD_CHAINED_FIXUPS 指向 __LINKEDIT 内的元数据
// macho_chained_fixups builds LC_DYLD_CHAINED_FIXUPS pointing at the metadata
// inside __LINKEDIT
fn macho_chained_fixups(dataoff, datasize) {
    u32(2147483700) + u32(16) + u32(dataoff) + u32(datasize)
}

// macho_data_segment 生成 __DATA：固定高 VA 槽，文件紧随 __TEXT 页界之后，R-W
// macho_data_segment builds __DATA: the fixed high VA slot, file body right
// after the __TEXT page boundary, R-W
fn macho_data_segment(data_fileoff, data_len) {
    u32(25) + u32(72) + macho_seg_name("__DATA") + u64(macho_base + DATA_VA_OFF) + u64(pe_align(data_len, 4096)) + u64(data_fileoff) + u64(data_len) + u32(3) + u32(3) + u32(0) + u32(0)
}

// macho_dylinker 生成 LC_DYLINKER 指向 /usr/lib/dyld
// macho_dylinker builds LC_DYLINKER pointing at /usr/lib/dyld
fn macho_dylinker() {
    let name = macho_pad8("/usr/lib/dyld")
    u32(14) + u32(12 + str_len(name)) + u32(12) + name
}

// macho_dylib 生成 LC_LOAD_DYLIB 挂载 libSystem（dyld 要求至少一条 dylib）
// macho_dylib builds LC_LOAD_DYLIB pulling in libSystem (dyld expects at least
// one dylib)
fn macho_dylib() {
    let name = macho_pad8("/usr/lib/libSystem.B.dylib")
    u32(12) + u32(24 + str_len(name)) + u32(24) + u32(0) + u32(0) + u32(0) + name
}

// emit_macho 装配 Mach-O：命令块 + 垫零至 0x1000 + __TEXT 内容（含 __unwind_info）
// + 垫零至页界 + __DATA 内容 + 垫零至页界后的 __LINKEDIT（链式修复元数据 +
// LC_FUNCTION_STARTS 载荷）；入口在 __TEXT 内容内 entry_in_text 处。pdata_offsets/
// pdata_lens 是 funcs_bytes 内每个变体的 (偏移, 长度)，与 PE .pdata 共用同一份
// （x86.bur 的发射顺序 = 地址升序，见 pe_build_pdata 的同一注释）；code_base 是
// funcs_bytes 在文件内的起点。
// emit_macho assembles the Mach-O: command block + zero padding to 0x1000 +
// __TEXT content (including __unwind_info) + padding to the page boundary +
// __DATA content + __LINKEDIT after padding to the next page boundary
// (chained-fixups metadata plus the LC_FUNCTION_STARTS payload); the entry sits
// at entry_in_text within the __TEXT content. pdata_offsets/pdata_lens are each
// variant's (offset, length) within funcs_bytes, shared with PE's .pdata
// (x86.bur's emission order is ascending address, see pe_build_pdata's matching
// comment); code_base is funcs_bytes' file-relative start. rt_unwind_offsets/
// rt_unwind_lens/rt_unwind_pushes are the internal subroutines' (gc_record/
// mark_addr/…) offsets/lengths/entry push-register lists, sharing the same
// __unwind_info regular page as the user functions — internal subroutines
// always sit at lower addresses, so they're prepended before building the
// combined, address-ascending offs/lens/encodings arrays.
pub fn emit_macho(text_content, entry_in_text, data_content, pdata_offsets, pdata_lens, code_base, rt_unwind_offsets, rt_unwind_lens, rt_unwind_pushes) {
    let mut all_offs = []
    let mut all_lens = []
    let mut all_encs = []
    let mut ri = 0
    while ri < len(rt_unwind_offsets) {
        push(all_offs, rt_unwind_offsets[ri])
        push(all_lens, rt_unwind_lens[ri])
        push(all_encs, macho_unwind_encoding_pushes(rt_unwind_pushes[ri]))
        ri = ri + 1
    }
    let mut ui = 0
    while ui < len(pdata_offsets) {
        push(all_offs, pdata_offsets[ui])
        push(all_lens, pdata_lens[ui])
        push(all_encs, macho_unwind_encoding())
        ui = ui + 1
    }
    let unwind_content = macho_unwind_info(all_offs, all_lens, code_base, all_encs)
    let unwind_len = str_len(unwind_content)
    // 不对 ULEB128 载荷做尾部零字节补齐——补齐用的 0x00 本身就是「值为 0」的合法
    // ULEB128 编码，会被解码器当成多出的一个函数起点，把最后一个真实条目复制一遍
    // （已用真机构建实测复现）；datasize 精确等于载荷长度，链接编辑区里它已是最后
    //一块内容，没有后续结构需要对齐它的结尾。
    // no trailing zero-byte padding on the ULEB128 payload — a 0x00 pad byte is
    // itself a valid ULEB128 encoding of 0, so a decoder reads it as one more
    // function start and ends up duplicating the last real entry (reproduced via
    // an actual build). datasize is exactly the payload length; it's already the
    // last thing in __LINKEDIT, so nothing downstream needs its end aligned.
    let fstarts_payload = macho_function_starts_payload(pdata_offsets, code_base)
    let text_end = MACHO_TEXT_OFF + str_len(text_content) + unwind_len
    let data_fileoff = pe_align(text_end, 4096)
    let linkedit_off = pe_align(data_fileoff + str_len(data_content), 4096)
    let chained_payload = macho_linkedit_payload()
    let fstarts_dataoff = linkedit_off + str_len(chained_payload)
    let full_linkedit_payload = chained_payload + fstarts_payload
    let hdrs = macho_header(11, 524 + 16 + 96) + macho_pagezero() + macho_text_segment(str_len(text_content), unwind_len) + macho_data_segment(data_fileoff, str_len(data_content)) + macho_linkedit_segment(linkedit_off, str_len(full_linkedit_payload)) + macho_uuid() + macho_main(MACHO_TEXT_OFF + entry_in_text) + macho_build_version() + macho_dylinker() + macho_dylib() + macho_chained_fixups(linkedit_off, str_len(chained_payload)) + macho_function_starts_cmd(fstarts_dataoff, str_len(fstarts_payload))
    let mut head_pad = ""
    let mut pi = macho_hdr_size()
    while pi < MACHO_TEXT_OFF {
        head_pad = head_pad + byte_chr(0)
        pi = pi + 1
    }
    let mut mid_pad = ""
    pi = MACHO_TEXT_OFF + str_len(text_content) + unwind_len
    while pi < data_fileoff {
        mid_pad = mid_pad + byte_chr(0)
        pi = pi + 1
    }
    let mut tail = ""
    let mut ti = data_fileoff + str_len(data_content)
    while ti < linkedit_off {
        tail = tail + byte_chr(0)
        ti = ti + 1
    }
    hdrs + head_pad + text_content + unwind_content + mid_pad + data_content + tail + full_linkedit_payload
}

// macho_build_dispatcher 生成 darwin syscall 兼容分派器。
// macho_build_dispatcher emits the darwin syscall shim dispatcher.
// 契约对齐 Linux syscall：只破坏 rax/rcx/r11，保全其余寄存器；结果走 rax。
// Contract mirrors Linux syscall: only rax/rcx/r11 die, everything else survives;
// result returns in rax.
// 直译表：1 write→BSD write(0x2000004)、60 exit→0x2000001、9 mmap→0x20000C5
// （内核从 r10 取第 4 参——libc 桩为躲过 syscall 对 rcx 的破坏而走 r10——
// 只需把 flags 值换成 0x1002）；错误返回正 errno 且 CF=1，转回 Linux 式负值。
// Translation table: 1 write→BSD write(0x2000004), 60 exit→0x2000001,
// 9 mmap→0x20000C5 (the kernel reads the 4th arg from r10 — libc stubs route
// rcx through r10 to survive syscall clobbering rcx — so only the flags value
// changes to 0x1002); errors return positive errno with CF set, converted back
// to Linux-style negatives.
// 228 clock_gettime 在 BSD 表里没有对应号，改走 gettimeofday(0x2000074) 的第三参
// uint64_t *mach_absolute_time：x86_64 上该时基即纳秒，除 1e9 拆成 timespec。
// 228 clock_gettime has no number in the BSD table, so it routes through
// gettimeofday's (0x2000074) third argument uint64_t *mach_absolute_time: that
// timebase is nanoseconds on x86_64, divided by 1e9 into a timespec.
// exec 族（57 fork、59 execve、61 wait4、33 dup2、293 pipe2、35 nanosleep）见各臂。
// 其余号落 ud2 立即崩溃暴露缺口。
// The exec family (57 fork, 59 execve, 61 wait4, 33 dup2, 293 pipe2, 35
// nanosleep) is described at each arm. Every other number hits ud2.
// 无导入无 API 调用，故帧只需保存六个输入寄存器（mmap 改写 r10、clock 改写
// rdi/rsi/rdx/r10，尾声弹回），无需影子空间与栈定位。
// No imports and no API calls, so the frame only saves the six input registers
// (mmap rewrites r10, clock rewrites rdi/rsi/rdx/r10, all restored by the
// epilogue); no shadow space or frame pointer needed.
// macho_errno_remap 把 darwin 特有 errno 换成调用方认的 Linux 号：EAGAIN
// 35→11，EINPROGRESS 36→115；成功 0 与其余错误不动（EINTR 两边同为 4）。
// macho_errno_remap translates darwin-specific errnos to the Linux numbers the
// callers expect: EAGAIN 35→11, EINPROGRESS 36→115; success and the rest pass
// through (EINTR is 4 on both sides)
fn macho_errno_remap() {
    let to_again = mov_ri64(rax, 0 - 11)
    let chk_again = mov_ri64(r10, 0 - 35) + cmp_rr(rax, r10) + jne_rel32(str_len(to_again)) + to_again
    let to_prog = mov_ri64(rax, 0 - 115)
    let chk_prog = mov_ri64(r10, 0 - 36) + cmp_rr(rax, r10) + jne_rel32(str_len(to_prog)) + to_prog
    chk_again + chk_prog
}

// macho_fcntl_nonblock 把 F_SETFL 参数里的 Linux O_NONBLOCK 位（2048）换成
// BSD 位（4），其余位原样保留；GET 类命令不碰参数。
// macho_fcntl_nonblock swaps the Linux O_NONBLOCK bit (2048) in an F_SETFL
// argument for the BSD bit (4), keeping every other bit; GET commands leave
// the argument alone
fn macho_fcntl_nonblock() {
    let set_bit = mov_ri64(r11, 4) + or_rr(rdx, r11)
    let nb_test = test_rr(r10, r10) + je_rel32(str_len(set_bit)) + set_bit
    let clr_linux = mov_ri64(r11, 0 - 2049) + and_rr(rdx, r11)
    mov_rr(r10, rdx) + mov_ri64(r11, 2048) + and_rr(r10, r11) + clr_linux + nb_test
}

pub fn macho_build_dispatcher() {
    let head = e1(87) + e1(86) + e1(82) + e1(65) + e1(80) + e1(65) + e1(81) + e1(65) + e1(82)
    let epilogue = e1(65) + e1(90) + e1(65) + e1(89) + e1(65) + e1(88) + e1(90) + e1(94) + e1(95) + e1(195)
    let errno_tail = e1(115) + e1(3) + e1(72) + e1(247) + e1(216)

    // write(fd=rdi, buf=rsi, len=rdx)：参数寄存器与 Linux 完全同形，任意 fd 直通；
    // 套接字上的 EAGAIN/EINPROGRESS 走 errno_remap
    // write(fd=rdi, buf=rsi, len=rdx): argument registers match Linux exactly; every fd passes through;
    // EAGAIN/EINPROGRESS on sockets goes through errno_remap
    let write_case = mov_ri64(rax, 33554436) + e1(15) + e1(5) + errno_tail + macho_errno_remap()

    // exit(code=rdi)：BSD exit 不返回；int3 兜底
    // exit(code=rdi): BSD exit never returns; int3 as a guard
    let exit_case = mov_ri64(rax, 33554433) + e1(15) + e1(5) + e1(204)

    // mmap(addr=rdi, len=rsi, prot=rdx, flags=r10, fd, off)：第 4 参本就在
    // r10，只换值为 MAP_ANON 0x1002（尾声弹回原 r10）；错误转负
    // mmap(addr=rdi, len=rsi, prot=rdx, flags in r10, fd, off): the 4th arg is
    // already in r10, so only its value changes to MAP_ANON 0x1002 (the
    // epilogue restores the original r10); errors convert negative
    let mmap_case = mov_ri64(rax, 33554629) + mov_ri64(r10, 4098) + e1(15) + e1(5) + errno_tail

    // clock_gettime(clk_id=rdi, tp=rsi)：开 32 字节暂存并把 tp 存 [rsp+16]；
    // timeval 落 [rsp] 弃用，mach 纳秒落 [rsp+24]，除 1e9 得 {sec, nsec} 写回 tp
    // clock_gettime(clk_id=rdi, tp=rsi): 32 scratch bytes with tp saved at
    // [rsp+16]; the timeval at [rsp] is discarded, the mach nanoseconds land at
    // [rsp+24] and divide by 1e9 into the {sec, nsec} written back through tp
    let clock_case = e1(72) + e1(131) + e1(236) + e1(32) + e1(72) + e1(137) + e1(116) + e1(36) + e1(16) + e1(72) + e1(137) + e1(231) + e1(72) + e1(49) + e1(246) + e1(72) + e1(141) + e1(84) + e1(36) + e1(24) + mov_ri64(rax, 33554548) + e1(15) + e1(5) + e1(72) + e1(139) + e1(68) + e1(36) + e1(24) + e1(72) + e1(49) + e1(210) + mov_ri64(r10, 1000000000) + e1(73) + e1(247) + e1(242) + e1(72) + e1(139) + e1(116) + e1(36) + e1(16) + e1(72) + e1(137) + e1(6) + e1(72) + e1(137) + e1(86) + e1(8) + e1(72) + e1(131) + e1(196) + e1(32) + e1(72) + e1(49) + e1(192)

    // poll(fds=rdi, nfds=rsi, timeout=rdx)：struct pollfd 布局与 POLLIN/POLLOUT 值两边相同，直通
    // poll(fds=rdi, nfds=rsi, timeout=rdx): struct pollfd layout and the POLLIN/POLLOUT values match; passes through
    let poll_case = mov_ri64(rax, 33554662) + e1(15) + e1(5) + errno_tail

    // mprotect(addr=rdi, len=rsi, prot=rdx)：PROT_READ/WRITE/EXEC 两边同值，直通
    // mprotect(addr=rdi, len=rsi, prot=rdx): PROT_READ/WRITE/EXEC share values; passes through
    let mprotect_case = mov_ri64(rax, 33554506) + e1(15) + e1(5) + errno_tail

    // open(path=rdi, flags=rsi, mode=rdx)：BSD 号直通，参数寄存器与 Linux 同形。
    // 注意调用方传 Linux 标志：write_file 在 darwin 下改传 1537
    // （O_WRONLY|O_CREAT|O_TRUNC 的 BSD 值），见 read_file/write_file。
    // open(path=rdi, flags=rsi, mode=rdx): BSD numbers pass through with the
    // same argument registers as Linux. Callers pass Linux flags except
    // write_file, which uses the BSD value 1537 on darwin (see its native).
    let open_case = mov_ri64(rax, 33554437) + e1(15) + e1(5) + errno_tail

    // read(fd=rdi, buf=rsi, len=rdx)：直通；套接字上的 EAGAIN/EINPROGRESS
    // 走 errno_remap（文件读从不触发）。
    // read(fd=rdi, buf=rsi, len=rdx): passes through; EAGAIN/EINPROGRESS on
    // sockets goes through errno_remap (file reads never trigger it)
    let read_case = mov_ri64(rax, 33554435) + e1(15) + e1(5) + errno_tail + macho_errno_remap()

    // close(fd=rdi)：直通 / passthrough
    let close_case = mov_ri64(rax, 33554438) + e1(15) + e1(5) + errno_tail

    // stat(path=rdi, struct=rsi)：直通，调用方只看返回值符号，结构体免翻译
    // stat(path=rdi, struct=rsi): passes through; callers only check the sign,
    // so the struct needs no translation
    let stat_case = mov_ri64(rax, 33554620) + e1(15) + e1(5) + errno_tail

    // fstat(fd=rdi, struct=rsi)：直通后把 BSD st_size（+72）拷到 Linux 位
    // (+48)，调用方只读该偏移。裸 syscall 189 填的是内核 user64_stat（32 位
    // ino、三组 timespec、120B）：24B 头已 8 对齐故 atime 起于 +24，
    // size@72、blocks@80、blksize@88；libc struct stat 的 size@96 是带
    // birthtime 的 stat64 布局，裸 189 不按它填。
    // fstat(fd=rdi, struct=rsi): passes through, then copies the BSD st_size
    // (+72) to the Linux offset (+48) the callers read. Raw syscall 189 fills
    // the kernel user64_stat (32-bit ino, three timespecs, 120B): the 24B
    // header stays 8-aligned so atime starts at +24, size@72, blocks@80,
    // blksize@88. The libc struct stat's size@96 is the stat64 layout with
    // birthtime, which raw 189 does not produce.
    let fstat_copy = mov_rm(r10, rsi, 72) + mov_mr(rsi, 48, r10)
    let fstat_case = mov_ri64(rax, 33554621) + e1(15) + e1(5) + errno_tail + fstat_copy

    // getdirentries64(fd=rdi, buf=rsi, nbytes=rdx, basep=r10)：直通，调用方备
    // scratch 作 basep；错误经 errno_tail 转负。
    // getdirentries64(fd=rdi, buf=rsi, nbytes=rdx, basep=r10): passes through
    // with a caller-provided basep scratch; errors convert negative.
    let getdirentries_case = mov_ri64(rax, 33554776) + e1(15) + e1(5) + errno_tail

    // socket(domain=rdi, type=rsi, proto=rdx)：AF_INET/SOCK_STREAM 取值两边相同，直通
    // socket(domain=rdi, type=rsi, proto=rdx): AF_INET/SOCK_STREAM share values; passes through
    let socket_case = mov_ri64(rax, 33554529) + e1(15) + e1(5) + errno_tail

    // bind(fd=rdi, addr=rsi, len=rdx)：sockaddr_in 布局两边相同，直通
    // bind(fd=rdi, addr=rsi, len=rdx): sockaddr_in layout matches; passes through
    let bind_case = mov_ri64(rax, 33554536) + e1(15) + e1(5) + errno_tail

    // listen(fd=rdi, backlog=rsi)：直通 / passthrough
    let listen_case = mov_ri64(rax, 33554538) + e1(15) + e1(5) + errno_tail

    // connect(fd=rdi, addr=rsi, len=rdx)：直通；非阻塞建连的 EINPROGRESS 经
    // errno_remap 换成调用方等的 115 后 park
    // connect(fd=rdi, addr=rsi, len=rdx): passes through; EINPROGRESS on a
    // non-blocking connect goes through errno_remap to the 115 the callers park on
    let connect_case = mov_ri64(rax, 33554530) + e1(15) + e1(5) + errno_tail + macho_errno_remap()

    // accept(fd=rdi, addr=rsi, len=rdx)：直通（NULL 地址沿用调用方传值）；
    // 空轮询的 EAGAIN 经 errno_remap 换成 11 后 park
    // accept(fd=rdi, addr=rsi, len=rdx): passes through (NULL addresses flow
    // through as the callers pass them); EAGAIN on an empty queue goes through
    // errno_remap to the 11 the callers park on
    let accept_case = mov_ri64(rax, 33554462) + e1(15) + e1(5) + errno_tail + macho_errno_remap()

    // setsockopt(fd=rdi, level=rsi, name=rdx, val=r10, len=r8)：调用方传 Linux
    // 常量（SOL_SOCKET=1、SO_REUSEADDR=2），换成 BSD 值（0xFFFF、4）再直通
    // setsockopt(fd=rdi, level=rsi, name=rdx, val=r10, len=r8): callers pass
    // Linux constants (SOL_SOCKET=1, SO_REUSEADDR=2); translate to the BSD
    // values (0xFFFF, 4), then pass through
    let reuse_name = mov_ri64(rdx, 4)
    let reuse_name_chk = mov_ri64(r11, 2) + cmp_rr(rdx, r11) + jne_rel32(str_len(reuse_name)) + reuse_name
    let reuse_level = mov_ri64(rsi, 65535)
    let reuse_level_chk = mov_ri64(r11, 1) + cmp_rr(rsi, r11) + jne_rel32(str_len(reuse_level)) + reuse_level
    let setsockopt_case = reuse_level_chk + reuse_name_chk + mov_ri64(rax, 33554537) + e1(15) + e1(5) + errno_tail

    // getsockopt(fd=rdi, level=rsi, name=rdx, val=r10, len=r8)：调用方传
    // (SOL_SOCKET=1, SO_ERROR=4)，换成 (0xFFFF, 0x1007) 再直通
    // getsockopt(fd=rdi, level=rsi, name=rdx, val=r10, len=r8): callers pass
    // (SOL_SOCKET=1, SO_ERROR=4); translate to (0xFFFF, 0x1007), then pass through
    let err_name = mov_ri64(rdx, 4103)
    let err_name_chk = mov_ri64(r11, 4) + cmp_rr(rdx, r11) + jne_rel32(str_len(err_name)) + err_name
    let err_level = mov_ri64(rsi, 65535)
    let err_level_chk = mov_ri64(r11, 1) + cmp_rr(rsi, r11) + jne_rel32(str_len(err_level)) + err_level
    let getsockopt_case = err_level_chk + err_name_chk + mov_ri64(rax, 33554550) + e1(15) + e1(5) + errno_tail

    // fcntl(fd=rdi, cmd=rsi, arg=rdx)：F_GETFL/F_GETFD 直通；F_SETFL 先把 Linux
    // O_NONBLOCK 位换成 BSD 位（调用方按 Linux 位拼参数）
    // fcntl(fd=rdi, cmd=rsi, arg=rdx): F_GETFL/F_GETFD pass through; F_SETFL
    // first swaps the Linux O_NONBLOCK bit for the BSD one (callers assemble
    // the argument with Linux bits)
    let fcntl_set = macho_fcntl_nonblock()
    let fcntl_set_chk = mov_ri64(r11, 4) + cmp_rr(rsi, r11) + jne_rel32(str_len(fcntl_set)) + fcntl_set
    let fcntl_case = fcntl_set_chk + mov_ri64(rax, 33554524) + e1(15) + e1(5) + errno_tail

    // exec 族：fork/execve/wait4/dup2/pipe2/nanosleep。子进程只做裸 syscall
    // （dup2、close、execve、write、exit），不回到 libSystem，故裸 fork 足够。
    // The exec family: fork/execve/wait4/dup2/pipe2/nanosleep. The child only
    // issues raw syscalls (dup2, close, execve, write, exit) and never returns
    // into libSystem, so a raw fork suffices.
    let sc = e1(15) + e1(5)
    // fork()：BSD fork(0x2000002) 在父子两边都返回对方/子 pid，子进程另置
    // rdx=1；据 rdx 把子进程返回值归零，错误转负。
    // fork(): BSD fork (0x2000002) returns a pid on both sides and sets rdx=1
    // in the child; rdx zeroes the child's return value, errors convert negative.
    let fork_child = xor_rr(rax, rax)
    let fork_err = neg_r(rax)
    let fork_ok = test_rr(rdx, rdx) + je_rel32(str_len(fork_child)) + fork_child + jmp_rel32(str_len(fork_err))
    let fork_case = mov_ri64(rax, 33554434) + sc + jb_rel32(str_len(fork_ok)) + fork_ok + fork_err

    // execve(path=rdi, argv=rsi, envp=rdx)：直通；ENOENT/EACCES 两边同号
    // execve(path=rdi, argv=rsi, envp=rdx): passes through; ENOENT/EACCES share numbers
    let execve_case = mov_ri64(rax, 33554491) + sc + errno_tail

    // wait4(pid=rdi, status=rsi, options=rdx, rusage=r10)：BSD 7，第 4 参本在 r10，
    // 状态字布局两边相同，直通
    // wait4(pid=rdi, status=rsi, options=rdx, rusage=r10): BSD 7, the 4th arg
    // already in r10, the status word layout matches; passes through
    let wait4_case = mov_ri64(rax, 33554439) + sc + errno_tail

    // dup2(old=rdi, new=rsi)：BSD 90，直通 / dup2(old=rdi, new=rsi): BSD 90, passes through
    let dup2_case = mov_ri64(rax, 33554522) + sc + errno_tail

    // pipe2(fds=rdi, flags=rsi)：BSD 只有 pipe(0x200002A)，两端经 rax/rdx 返回；
    // 写回 fds[0]/fds[1]（各 4 字节）后按 Linux 标志逐端补 fcntl：O_CLOEXEC
    // (0x80000)→F_SETFD FD_CLOEXEC，O_NONBLOCK(2048)→F_SETFL 的 BSD 位 4。
    // r8/r9 暂存 flags 与 fds（头部已保存，尾声弹回）。
    // pipe2(fds=rdi, flags=rsi): BSD only has pipe (0x200002A), returning both
    // ends in rax/rdx; after writing fds[0]/fds[1] (4 bytes each) the Linux
    // flags are applied per end through fcntl: O_CLOEXEC (0x80000) → F_SETFD
    // FD_CLOEXEC, O_NONBLOCK (2048) → F_SETFL with BSD bit 4. r8/r9 hold the
    // flags and fds (saved by the head, restored by the epilogue).
    let pipe_fl = fn(off, bit, cmd, arg) {
        let call = mov_rm32(rdi, r9, off) + mov_ri64(rsi, cmd) + mov_ri64(rdx, arg) + mov_ri64(rax, 33554524) + e1(15) + e1(5)
        mov_ri64(r11, bit) + test_rr(r8, r11) + je_rel32(str_len(call)) + call
    }
    let pipe_ok = mov_mr32(r9, 0, rax) + mov_mr32(r9, 4, rdx) + pipe_fl(0, 524288, 2, 1) + pipe_fl(4, 524288, 2, 1) + pipe_fl(0, 2048, 4, 4) + pipe_fl(4, 2048, 4, 4) + xor_rr(rax, rax)
    let pipe_err = neg_r(rax) + jmp_rel32(str_len(pipe_ok))
    let pipe2_case = mov_rr(r9, rdi) + mov_rr(r8, rsi) + mov_ri64(rax, 33554474) + sc + jae_rel32(str_len(pipe_err)) + pipe_err + pipe_ok

    // nanosleep(req=rdi, rem=rsi)：BSD 无此号，换算成毫秒走 poll(NULL, 0, ms)
    // nanosleep(req=rdi, rem=rsi): no BSD number, so convert to milliseconds
    // and take poll(NULL, 0, ms)
    let nanosleep_case = mov_rm(rax, rdi, 8) + xor_rr(rdx, rdx) + mov_ri64(r11, 1000000) + div_r(r11) + mov_rr(r8, rax) + mov_rm(rax, rdi, 0) + mov_ri64(r11, 1000) + imul_rr(rax, r11) + add_rr(rax, r8) + mov_rr(rdx, rax) + xor_rr(rdi, rdi) + xor_rr(rsi, rsi) + mov_ri64(rax, 33554662) + sc + errno_tail

    sys_dispatch_chain(head, [1, 60, 9, 228, 7, 10, 2, 0, 3, 4, 5, 217, 41, 42, 43, 49, 50, 54, 55, 72, 57, 59, 61, 33, 293, 35], [write_case, exit_case, mmap_case, clock_case, poll_case, mprotect_case, open_case, read_case, close_case, stat_case, fstat_case, getdirentries_case, socket_case, connect_case, accept_case, bind_case, listen_case, setsockopt_case, getsockopt_case, fcntl_case, fork_case, execve_case, wait4_case, dup2_case, pipe2_case, nanosleep_case], epilogue)
}

// macho_header 生成 mach_header_64 / macho_header builds the mach_header_64
fn macho_header(ncmds, sizeofcmds) {
    // 0xFEEDFACF · CPU_TYPE_X86_64 · CPU_SUBTYPE_X86_64_LIB64 · MH_EXECUTE ·
    // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE（代码 RIP 相对、__DATA 不存绝对
    // 地址，dyld 施 slide 无需任何 rebase）
    // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE (the code is RIP-relative
    // and __DATA holds no absolute address, so dyld slides it with no rebase)
    u32(4277009103) + u32(16777223) + u32(2147483651) + u32(2) + u32(ncmds) + u32(sizeofcmds) + u32(2097285) + u32(0)
}

// macho_seg_name 补齐 16B 段名 / macho_seg_name pads a segment name to 16 bytes
fn macho_seg_name(name) {
    let mut out = name
    let mut ni = str_len(name)
    while ni < 16 {
        out = out + byte_chr(0)
        ni = ni + 1
    }
    out
}

// macho_linkedit_segment 生成 __LINKEDIT：内容为 80B 零导入链式修复元数据，
// fileoff+filesize 恰到文件尾，满足 codesign 严格校验；签名时由 codesign 扩写
// macho_linkedit_segment builds __LINKEDIT: its content is the 80-byte
// zero-import chained-fixups metadata and fileoff+filesize lands exactly at
// EOF, satisfying codesign's strict rule; codesign rewrites it when signing
fn macho_linkedit_segment(linkedit_off, payload_len) {
    u32(25) + u32(72) + macho_seg_name("__LINKEDIT") + u64(macho_base + linkedit_off) + u64(pe_align(payload_len, 4096)) + u64(linkedit_off) + u64(payload_len) + u32(1) + u32(1) + u32(0) + u32(32)
}

// macho_linkedit_payload 生成链式修复元数据：32B 头 + 20B image starts +
// 24B segment starts（仅 __DATA 有表，页起点 NONE）+ 对齐垫，共 80B，
// 导入与符号表均为空
// macho_linkedit_payload builds the chained-fixups metadata: a 32B header +
// 20B image starts + 24B segment starts (only __DATA has a table with page
// starts NONE) + alignment padding, 80 bytes total, with empty import and
// symbol tables
fn macho_linkedit_payload() {
    let payload = u32(0) + u32(32) + u32(80) + u32(80) + u32(0) + u32(1) + u32(0) + u32(0)
    let starts_in_image = u32(4) + u32(0) + u32(0) + u32(20) + u32(0)
    // PageSize 4096 与 PointerFormat 6（PTR_64_OFFSET）合入一个 u32；
    // PageCount 1 与页起点 NONE（0xFFFF）合入末尾 u32
    let starts_in_segment = u32(24) + u32(397312) + u64(DATA_VA_OFF) + u32(0) + u32(4294901761)
    let mut out = payload + starts_in_image + starts_in_segment
    while str_len(out) % 16 != 0 {
        out = out + byte_chr(0)
    }
    out
}

// macho_pagezero 生成空 PAGEZERO，盖住低 4GB 空指针
// macho_pagezero builds the empty PAGEZERO covering the low 4GB null region
fn macho_pagezero() {
    u32(25) + u32(72) + macho_seg_name("__PAGEZERO") + u64(0) + u64(macho_base) + u64(0) + u64(0) + u32(0) + u32(0) + u32(0) + u32(0)
}

// macho_text_segment 生成 __TEXT：fileoff 0 从头区盖起，maxprot/initprot R-X，
// 内含两节——纯指令 __text 与紧随其后的 __unwind_info（S8.5 崩溃可诊断性，
// LC_FUNCTION_STARTS 的对等项；见 macho_unwind_info）
// macho_text_segment builds __TEXT: fileoff 0 covering the headers onward,
// maxprot/initprot R-X, carrying two sections — the pure-instructions __text
// and __unwind_info right after it (S8.5 crash diagnostics, LC_FUNCTION_STARTS'
// counterpart; see macho_unwind_info)
fn macho_text_segment(text_len, unwind_len) {
    let unwind_off = MACHO_TEXT_OFF + text_len
    let text_sect = macho_seg_name("__text") + macho_seg_name("__TEXT") + u64(macho_base + MACHO_TEXT_OFF) + u64(text_len) + u32(MACHO_TEXT_OFF) + u32(6) + u32(0) + u32(0) + u32(2147483648) + u32(0) + u32(0) + u32(0)
    let unwind_sect = macho_seg_name("__unwind_info") + macho_seg_name("__TEXT") + u64(macho_base + unwind_off) + u64(unwind_len) + u32(unwind_off) + u32(2) + u32(0) + u32(0) + u32(0) + u32(0) + u32(0) + u32(0)
    let total_len = unwind_off + unwind_len
    u32(25) + u32(232) + macho_seg_name("__TEXT") + u64(macho_base) + u64(pe_align(total_len, 4096)) + u64(0) + u64(total_len) + u32(5) + u32(5) + u32(2) + u32(0) + text_sect + unwind_sect
}

// macho_uuid 生成 LC_UUID（占位全零即可被接受）
// macho_uuid builds LC_UUID (an all-zero placeholder is accepted)
fn macho_uuid() {
    u32(27) + u32(24) + u32(0) + u32(0) + u32(0) + u32(0)
}

// macho_main 生成 LC_MAIN：entryoff 为文件偏移，栈大小交内核默认
// macho_main builds LC_MAIN: entryoff is a file offset; the stack size stays
// at the kernel default
fn macho_main(entryoff) {
    u32(2147483688) + u32(24) + u64(entryoff) + u64(0)
}

// macho_build_version 生成 LC_BUILD_VERSION：macOS 12.0 平台基准
// macho_build_version builds LC_BUILD_VERSION pinned to the macOS 12.0 baseline
fn macho_build_version() {
    u32(50) + u32(24) + u32(1) + u32(786432) + u32(786432) + u32(0)
}

// macho_pad8 把字符串补齐到 8 的倍数（load command 内字符串的对齐要求）
// macho_pad8 pads a string to a multiple of 8 (the alignment load-command
// strings must keep)
fn macho_pad8(name) {
    let mut out = name
    while str_len(out) % 8 != 0 {
        out = out + byte_chr(0)
    }
    out
}
