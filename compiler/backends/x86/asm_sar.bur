// asm_sar.bur — sar/lea。
// asm_sar.bur — sar/lea.



// sar_rcl 发射按 CL 算术右移 / sar_rcl emits an arithmetic shift-right by CL
pub fn sar_rcl(dst) {
    rex(1, 0, 0, dst) + e1(211) + modrm_reg(7, dst)
}

// lea 发射 lea 地址计算 / lea emits lea (address computation)
pub fn lea(dst, base, disp) {
    if disp == 0 && base % 8 != 5 {
        rex(1, dst, 0, base) + e1(141) + modrm(0, dst, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        rex(1, dst, 0, base) + e1(141) + modrm(1, dst, base) + sib_for(base) + sb(disp)
    } else {
        rex(1, dst, 0, base) + e1(141) + modrm(2, dst, base) + sib_for(base) + e4s(disp)
    }
}
