// emit_float_str.bur — float→str / format_for_enc。
// emit_float_str.bur — float→str / format_for_enc.

import "burryn.dev/compiler/lib"

// x86gen_float_to_str_at 生成 float→str 转换（调用注入的 format_float），作用于 [r15+off] 的 float 盒
// x86gen_float_to_str_at emits float-to-str by calling the injected format_float
// (operates on the box at [r15+off])
// 调用约定：压 fn_ref+bits 两槽后 call，返回后 r15 少 8、返回值在原 fn_ref 槽（新 [r15-8]）；写回 [r15+off] 并恢复 r15
// call convention: push fn_ref+bits, call; r15 drops by 8 and the result sits at the former
// fn_ref slot (new [r15-8]);
// write it back to [r15+off] and restore r15
fn x86gen_float_to_str_at(ctx: record { f_name: [str], f_arity: [int], f_nupvals: [int], f_code: [[int]], f_consts: [[lib::CVal]], en_qual: [str], en_vnames: [[str]], nfn: int, f2s_h: int, const_slot_map: map(int, int), record_encs: [str], record_offs: [int], record_field_types: map(str, [str]), enum_field_types: map(str, [[str]]), enum_variant_types: map(str, [str]), out_enc: str, res_out_enc: str, res_int_enc: str, opt_res_enc: str, global_type: map(str, str), sig_specs: map(str, [str]), sig_ret: map(str, str), p_sig_grew: [bool], method_full_map: map(str, int), created_by: map(int, [int]), fn_ret_type: [str], fn_ret_param: [int], fn_param_types: [[str]], fn_variants: [[[str]]] }, off) {
    let ff_h = find_fn_by_name(ctx.f_name, "frt_format_float")
    let f2s_call = mov_rm(rax, r15, off) + mov_rm(rax, rax, 0) + vs_push_zero() + vs_push(rax) + mov_rm(rax, r13, 8 * ff_h) + call_r(rax)
    let f2s_fin = mov_rm(rax, r15, 0 - 8) + mov_mr(r15, off - 8, rax) + sub_ri32(r15, 8)
    f2s_call + f2s_fin
}

// enum_format_for_enc 为任意枚举编码生成格式化 / enum_format_for_enc emits formatting for any enum encoding
fn enum_format_for_enc(ctx: record { f_name: [str], f_arity: [int], f_nupvals: [int], f_code: [[int]], f_consts: [[lib::CVal]], en_qual: [str], en_vnames: [[str]], nfn: int, f2s_h: int, const_slot_map: map(int, int), record_encs: [str], record_offs: [int], record_field_types: map(str, [str]), enum_field_types: map(str, [[str]]), enum_variant_types: map(str, [str]), out_enc: str, res_out_enc: str, res_int_enc: str, opt_res_enc: str, global_type: map(str, str), sig_specs: map(str, [str]), sig_ret: map(str, str), p_sig_grew: [bool], method_full_map: map(str, int), created_by: map(int, [int]), fn_ret_type: [str], fn_ret_param: [int], fn_param_types: [[str]], fn_variants: [[[str]]] }, off, enc) {
    let feh = if str_len(enc) > 6 && substr(enc, 0, 6) == "enum:e" {
        match parse_int(if str_len(enc) > 6 {
            let _eb = substr(enc, 6, str_len(enc) - 6)
            match str_index_of(_eb, "#") {
                Some(_h) => substr(_eb, 0, _h),
                None => _eb,
            }
        } else {
            ""
        }) {
            Some(fehv) => fehv,
            None => 0,
        }
    } else {
        enum_qual_to_eh(ctx, enum_qual(enc))
    }
    let mut fvts = []
    let mut fvi = 0
    let mut fmax = 0
    if feh >= 0 && feh < len(ctx.en_vnames) {
        fmax = len(ctx.en_vnames[feh])
    }
    while fvi < fmax {
        push(fvts, enum_fields_resolve(ctx, enc, fvi))
        fvi = fvi + 1
    }
    x86gen_enum_format_at(ctx, off, feh, fvts)
}
