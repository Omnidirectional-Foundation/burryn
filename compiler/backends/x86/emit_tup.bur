// emit_tup.bur — tuple/list 编码。
// emit_tup.bur — tuple/list encoding.

import "burryn.dev/compiler/lib"

// tup_enc 长度前缀编码 tuple 元素类型；嵌套类型内嵌的分隔符不会引起歧义
// tup_enc length-prefixes tuple element types; separators nested inside element types never
// clash
fn tup_enc(ets) {
    let mut s = "tup:"
    let mut ti = 0
    while ti < len(ets) {
        s = s + str(str_len(ets[ti])) + ":" + ets[ti]
        ti = ti + 1
    }
    s
}

// tup_elems 解析长度前缀编码 / tup_elems parses the length-prefixed encoding
fn tup_elems(t) {
    let mut out = []
    let body = substr(t, 4, str_len(t) - 4)
    let mut pos = 0
    while pos < str_len(body) {
        let rest = substr(body, pos, str_len(body) - pos)
        match str_index_of(rest, ":") {
            None => {
                pos = str_len(body)
            },
            Some(colon) => {
                let nv = match parse_int(substr(rest, 0, colon)) {
                    Some(v) => v,
                    None => -1,
                }
                let start = pos + colon + 1
                if nv >= 0 && start + nv <= str_len(body) {
                    push(out, substr(body, start, nv))
                    pos = start + nv
                } else {
                    pos = str_len(body)
                }
            },
        }
    }
    out
}

