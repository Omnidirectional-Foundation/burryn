// natives_float_cmp.bur — float cmp/neg。
// natives_float_cmp.bur — float cmp/neg.

// x86gen_float_cmp 生成装箱 float 比较：结果 bool 落 r15-16（cmpsd 掩码 → neg → 0/1）
// x86gen_float_cmp emits a boxed float comparison: bool to [r15-16] (cmpsd mask negated to 0/1)
// cmp 取值：eq/neq/lt/le/gt/ge
fn x86gen_float_cmp(cmp) {
    let c = if cmp == "eq" {
        cmpsd_xmm(0, 1, 0)
    } else if cmp == "neq" {
        cmpsd_xmm(0, 1, 4)
    } else if cmp == "lt" {
        cmpsd_xmm(0, 1, 1)
    } else if cmp == "le" {
        cmpsd_xmm(0, 1, 2)
    } else if cmp == "gt" {
        cmpsd_xmm(1, 0, 1)
    } else {
        cmpsd_xmm(1, 0, 2)
    }
    mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + mov_rm(rax, rax, 0) + mov_rm(rcx, rcx, 0) + movq_xmm_gpr(0, rax) + movq_xmm_gpr(1, rcx) + c + movq_gpr_xmm(rax, 0) + neg_r(rax) + mov_mr(r15, 0 - 16, rax) + vs_pop_n(1)
}

// x86gen_float_neg 生成装箱 float 取负：0.0 - x（匹配 VM，±0.0 都得 +0.0），新盒落 r15-8
// x86gen_float_neg emits boxed float negation: 0.0 - x (matches the VM; +/-0.0 both yield +0.0),
// fresh box at [r15-8]
fn x86gen_float_neg() {
    mov_rm(rax, r15, 0 - 8) + mov_rm(rax, rax, 0) + movq_xmm_gpr(1, rax) + xor_rr(rax, rax) + movq_xmm_gpr(0, rax) + subsd_xmm(0, 1) + movq_gpr_xmm(rax, 0) + x86gen_float_box_rax(0 - 8)
}
