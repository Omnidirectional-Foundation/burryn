// elf_test.bur — elf.bur 的 bur test 套件：.eh_frame CIE/FDE 编码
// bur test suite for elf.bur: .eh_frame CIE/FDE encoding

fn test_eh_cie_encoding() {
    let cie = eh_cie()
    let want = u32(20) + u32(0) + byte_chr(1) + "zR" + byte_chr(0) + byte_chr(1) + byte_chr(120) + byte_chr(16) + byte_chr(1) + byte_chr(27) + byte_chr(12) + byte_chr(7) + byte_chr(8) + byte_chr(144) + byte_chr(1) + byte_chr(0) + byte_chr(0)
    assert(cie == want, "length=20, CIE_id=0, version=1, augmentation zR with FDE encoding 0x1b (pcrel sdata4), code_align=1, data_align=-8 (SLEB128 0x78), RA col=16 (rip), def_cfa(rsp,8), offset(rip,cfa-8), 2-byte nop pad to 8-byte alignment")
}

fn test_eh_fde_pcrel_layout() {
    let instrs = byte_chr(65) + byte_chr(14) + byte_chr(16)
    let fde = eh_fde(28, 0 - 100, 20, instrs)
    let want = u32(20) + u32(28) + e4s(0 - 100) + u32(20) + byte_chr(0) + instrs + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0)
    assert(fde == want, "CIE_pointer, signed pcrel initial location, udata4 range, zero augmentation length, instructions, nop pad so the record length is a multiple of 8")
}

fn test_elf_eh_frame_single_function() {
    let eh = elf_eh_frame([0], [20], 4194304, 4198400)
    let cie = eh_cie()
    let instrs = byte_chr(65) + byte_chr(14) + byte_chr(16) + byte_chr(134) + byte_chr(2) + byte_chr(68) + byte_chr(14) + byte_chr(24)
    let want = cie + eh_fde(str_len(cie) + 4, 4194304 - (4198400 + str_len(cie) + 8), 20, instrs)
    assert(eh == want, "one CIE + one FDE: CIE_pointer back to the shared CIE, initial location relative to its own field inside .eh_frame, fixed advance_loc/def_cfa_offset/offset instruction stream")
}

fn test_elf_eh_frame_multi_functions_share_one_cie() {
    let eh = elf_eh_frame([0, 100, 250], [50, 100, 30], 4194304, 4198400)
    let cie = eh_cie()
    let instrs = byte_chr(65) + byte_chr(14) + byte_chr(16) + byte_chr(134) + byte_chr(2) + byte_chr(68) + byte_chr(14) + byte_chr(24)
    let at0 = str_len(cie)
    let fde0 = eh_fde(at0 + 4, 4194304 + 0 - (4198400 + at0 + 8), 50, instrs)
    let at1 = at0 + str_len(fde0)
    let fde1 = eh_fde(at1 + 4, 4194304 + 100 - (4198400 + at1 + 8), 100, instrs)
    let at2 = at1 + str_len(fde1)
    let fde2 = eh_fde(at2 + 4, 4194304 + 250 - (4198400 + at2 + 8), 30, instrs)
    assert(eh == cie + fde0 + fde1 + fde2, "3 functions share one CIE; each FDE's CIE_pointer and pcrel initial location count from its own position")
}

fn test_elf_eh_frame_empty() {
    assert(elf_eh_frame([], [], 4194304, 4198400) == eh_cie(), "no functions means the CIE alone, no FDEs")
}

fn test_elf_shstrtab_layout() {
    let want = byte_chr(0) + ".eh_frame" + byte_chr(0) + ".shstrtab" + byte_chr(0)
    assert(elf_shstrtab() == want, "leading NUL, then .eh_frame\\0 at offset 1, then .shstrtab\\0 at offset 11")
}

fn test_elf_section_header_encoding() {
    let sh = elf_section_header(1, 1, 4194304, 128, 56)
    let want = u32(1) + u32(1) + u64(0) + u64(4194304) + u64(128) + u64(56) + u32(0) + u32(0) + u64(1) + u64(0)
    assert(sh == want, "Elf64_Shdr: name/type/flags/addr/offset/size/link/info/addralign/entsize, 64 bytes total")
}

fn test_eh_push_instrs_empty_is_zero_prologue() {
    assert(eh_push_instrs([]) == "", "no pushes at entry means no CFI instructions at all — the CIE's initial rule holds throughout")
}

fn test_eh_push_instrs_low_registers_one_byte_each() {
    // rdx(2)/rdi(7)/rsi(6)/rax(0)/rcx(1): all <8, each push_r is 1 byte, so each
    // advance_loc step is 1
    let instrs = eh_push_instrs([rdx, rdi, rsi, rax, rcx])
    let want = byte_chr(65) + byte_chr(14) + byte_chr(16) + byte_chr(65) + byte_chr(14) + byte_chr(24) + byte_chr(65) + byte_chr(14) + byte_chr(32) + byte_chr(65) + byte_chr(14) + byte_chr(40) + byte_chr(65) + byte_chr(14) + byte_chr(48)
    assert(instrs == want, "5 low-register pushes: advance_loc(1) + def_cfa_offset(+8 each) per step, CFA ending at rsp+48")
}

fn test_eh_push_instrs_high_registers_two_bytes_each() {
    // r8(8)/r9(9)/r10(10)/r11(11): all >=8, REX prefix makes each push_r 2 bytes
    let instrs = eh_push_instrs([r8, r9, r10, r11])
    let want = byte_chr(66) + byte_chr(14) + byte_chr(16) + byte_chr(66) + byte_chr(14) + byte_chr(24) + byte_chr(66) + byte_chr(14) + byte_chr(32) + byte_chr(66) + byte_chr(14) + byte_chr(40)
    assert(instrs == want, "4 REX-prefixed pushes: advance_loc(2) + def_cfa_offset(+8 each) per step, CFA ending at rsp+40")
}

fn test_eh_push_instrs_gc_record_shape() {
    // x86gen_gc_record's push3 order: rdx,rdi,rsi,rax,rcx (1B each), r8,r9,r10,r11 (2B each)
    let instrs = eh_push_instrs([rdx, rdi, rsi, rax, rcx, r8, r9, r10, r11])
    let want = byte_chr(65) + byte_chr(14) + byte_chr(16) + byte_chr(65) + byte_chr(14) + byte_chr(24) + byte_chr(65) + byte_chr(14) + byte_chr(32) + byte_chr(65) + byte_chr(14) + byte_chr(40) + byte_chr(65) + byte_chr(14) + byte_chr(48) + byte_chr(66) + byte_chr(14) + byte_chr(56) + byte_chr(66) + byte_chr(14) + byte_chr(64) + byte_chr(66) + byte_chr(14) + byte_chr(72) + byte_chr(66) + byte_chr(14) + byte_chr(80)
    assert(instrs == want, "gc_record's real 9-push prologue: CFA ends at rsp+80 (8 initial + 9*8)")
}

fn test_elf_eh_frame_internal_zero_and_push_shapes() {
    let user_eh = elf_eh_frame([0], [20], 4194304, 4198400)
    let internal = elf_eh_frame_internal([100, 150], [30, 40], 4194304, 4198400, [[], [rax, rcx]], str_len(user_eh))
    let at0 = str_len(user_eh)
    let zero_fde = eh_fde(at0 + 4, 4194304 + 100 - (4198400 + at0 + 8), 30, "")
    let push_instrs = byte_chr(65) + byte_chr(14) + byte_chr(16) + byte_chr(65) + byte_chr(14) + byte_chr(24)
    let at1 = at0 + str_len(zero_fde)
    let push_fde = eh_fde(at1 + 4, 4194304 + 150 - (4198400 + at1 + 8), 40, push_instrs)
    assert(internal == zero_fde + push_fde, "a zero-prologue entry (empty instruction stream) and a 2-push entry, both counting cie_pointer back across the user FDEs that precede them")
}

fn test_phdr_load_rx_code_and_rw_data_encodings() {
    let rx = phdr_load(0, 4194304, 240, 240, pf_r + pf_x)
    let want_rx = u32(1) + u32(5) + u64(0) + u64(4194304) + u64(4194304) + u64(240) + u64(240) + u64(4096)
    assert(rx == want_rx, "code segment PT_LOAD: p_flags=5 (R-X), offset=vaddr, filesz=memsz, align=4096")
    let rw = phdr_load(4096, base_addr + DATA_VA_OFF, 2704, 2704, pf_r + pf_w)
    let want_rw = u32(1) + u32(6) + u64(4096) + u64(base_addr + DATA_VA_OFF) + u64(base_addr + DATA_VA_OFF) + u64(2704) + u64(2704) + u64(4096)
    assert(rw == want_rw, "data segment PT_LOAD: p_flags=6 (R-W, no execute) at the fixed high VA")
}
