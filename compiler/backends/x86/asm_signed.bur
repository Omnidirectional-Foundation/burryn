// asm_signed.bur — 有符号立即数。
// asm_signed.bur — signed immediates.



// sb 把有符号 int8 折叠进 0..255（补码）/ sb folds a signed int8 into 0..255 (two's complement)
pub fn sb(v) {
    let m = v % 256
    if m < 0 {
        byte_chr(m + 256)
    } else {
        byte_chr(m)
    }
}

// e4s 发射有符号 4 字节 / e4s emits a signed 4-byte value
pub fn e4s(v) {
    if v < 0 {
        e4(v + 4294967296)
    } else {
        e4(v)
    }
}

// e8s 发射有符号 8 字节 / e8s emits a signed 8-byte value
pub fn e8s(v) {
    if v >= 0 {
        e8(v)
    } else {
        let u = 0 - v
        let lo = u % 4294967296
        let hi = u / 4294967296 % 4294967296
        let nlo = 4294967295 - lo
        let nhi = 4294967295 - hi
        let mut flo = nlo + 1
        let mut fhi = nhi
        if flo >= 4294967296 {
            flo = flo - 4294967296
            fhi = fhi + 1
        }
        e4(flo) + e4(fhi)
    }
}
