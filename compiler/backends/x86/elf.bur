// elf.bur — 手写 ELF64 可执行文件生成器（无链接器依赖）。
// Hand-written ELF64 executable emitter (no linker dependency).
// 布局：ELF 头 + 程序头 + 字符串表 + 代码（函数体） + 跳转表 + _start。
// Layout: ELF header, program header, string table, code (function bodies), jump table, _start.
let et_exec = 2
let em_x86_64 = 62
let pt_load = 1
let pf_x = 1
let pf_r = 4
let pf_w = 2

// 固定加载基址（静态非 PIE）/ Fixed load base (static, non-PIE)
pub let base_addr = 4194304



