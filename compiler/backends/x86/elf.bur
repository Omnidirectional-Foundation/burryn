// elf.bur — ELF 输出：程序头、段布局与 Linux syscall 编号。
// ELF output: program headers, segment layout and Linux syscall numbers.

let et_exec = 2
let em_x86_64 = 62
let pt_load = 1
let pf_x = 1
let pf_r = 4
let pf_w = 2

// 固定加载基址（静态非 PIE）/ Fixed load base (static, non-PIE)
pub let base_addr = 4194304

// ELF_CODE_OFF 是代码内容在文件与 VA 中的公共起点：64B ELF 头 + 两条 phdr
// （代码段与数据段）共 112B。
// ELF_CODE_OFF is the common start of code content in both the file and VA
// space: the 64-byte ELF header plus two program headers (the code and data
// segments) total 112 bytes.
pub let ELF_CODE_OFF = 176

// elf_header_with_sh 生成 ELF 头，带一张节头表：gdb/readelf 靠节名定位
// .eh_frame——PT_GNU_EH_FRAME 程序头只服务运行中进程的 libgcc 展开，gdb 事后
// 调试走的是节头表这条路，见 architecture.md §5.19 的实测记录
// elf_header_with_sh builds the ELF header, carrying a section header table —
// gdb/readelf locate .eh_frame by section name; PT_GNU_EH_FRAME only serves an
// in-process libgcc unwinder, gdb's post-mortem debugging path goes through
// the section header table instead, see architecture.md §5.19 for the
// measured findings
fn elf_header_with_sh(entry, phnum, shoff, shnum, shstrndx) {
    let ident = byte_chr(127) + "ELF" + byte_chr(2) + byte_chr(1) + byte_chr(1) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0)

    ident + u16(et_exec) + u16(em_x86_64) + u32(1) + u64(entry) + u64(64) + u64(shoff) + u32(0) + u16(64) + u16(56) + u16(phnum) + u16(64) + u16(shnum) + u16(shstrndx)
}

// phdr_load 生成 PT_LOAD 程序头，flags 由调用方给：代码段 R-X、数据段 R-W（GC
// runtime 槽独立成段后代码域不再可写）。
// phdr_load builds a PT_LOAD program header with caller-supplied flags: the
// code segment is R-X and the data segment R-W (once the GC runtime slots
// live in their own segment, the code domain is no longer writable).
fn phdr_load(offset, vaddr, filesz, memsz, flags) {
    u32(pt_load) + u32(flags) + u64(offset) + u64(vaddr) + u64(vaddr) + u64(filesz) + u64(memsz) + u64(4096)
}

// eh_cie 是全程序共享的 CIE（.eh_frame 的头部记录）：初始规则 CFA=rsp+8（函数
// 入口、序言尚未执行时，返回地址在 [rsp]），返回地址列（DWARF 寄存器号 16 =
// rip）在 cfa-8。空 augmentation（版本 1 后紧跟单个 NUL），FDE 里的地址字段因此
// 是原生 8 字节绝对值，不带 PC 相对重定位——与本程序固定基址、非 PIE 的现状一致，
// 也省掉了 LEB128 变长指针编码的复杂度。code_alignment_factor=1、
// data_alignment_factor=-8（字节 0x78 是 SLEB128(-8) 的单字节编码，因为只有这
// 一处用得上、不值得写通用 SLEB128）。6 字节 DW_CFA_nop 补齐到 8 字节对齐。
// eh_cie is the single program-wide CIE (the .eh_frame header record): the
// initial rule is CFA=rsp+8 (function entry, before the prologue runs, return
// address sits at [rsp]), and the return-address column (DWARF register 16 =
// rip) is at cfa-8. Empty augmentation (version 1 followed directly by a
// single NUL), so FDE address fields are plain native 8-byte absolute values
// with no PC-relative relocation — matching this backend's fixed-base,
// non-PIE binaries and skipping LEB128 variable-length pointer encoding
// entirely. code_alignment_factor=1, data_alignment_factor=-8 (byte 0x78 is
// the one-byte SLEB128(-8) encoding; a general SLEB128 helper isn't worth it
// for this single use). Six DW_CFA_nop bytes pad the record to 8-byte
// alignment.
fn eh_cie() {
    let content = u32(0) + byte_chr(1) + byte_chr(0) + byte_chr(1) + byte_chr(120) + byte_chr(16) + byte_chr(12) + byte_chr(7) + byte_chr(8) + byte_chr(144) + byte_chr(1) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0)
    u32(str_len(content)) + content
}

// elf_eh_frame 生成 .eh_frame：一份共享 CIE + 每函数一条 FDE。用户函数序言形态
// 全程序唯一（natives.bur 的 x86gen_prologue：push rbp、sub rsp,8，各自结束于
// 序言第 1/5 字节），故每条 FDE 的指令字节完全相同（advance_loc 1→
// def_cfa_offset 16→rbp 存于 cfa-16；advance_loc 4→def_cfa_offset 24），只有
// CIE_pointer/initial_location/address_range 三个字段随函数变化。GC/调度器等
// 内部子程序（普通 call/ret，不建此序言）本轮不纳入覆盖——与已交付的 PE
// .pdata/Mach-O __unwind_info 同等范围。
// elf_eh_frame builds .eh_frame: one shared CIE plus one FDE per function.
// User functions share one program-wide prologue shape (natives.bur's
// x86gen_prologue: push rbp, sub rsp,8, ending at prologue byte 1 and 5
// respectively), so every FDE's instruction bytes are identical (advance_loc
// 1 → def_cfa_offset 16 → rbp saved at cfa-16; advance_loc 4 →
// def_cfa_offset 24); only CIE_pointer/initial_location/address_range vary
// per function. Internal runtime subroutines (plain call/ret, no such
// prologue) aren't covered this round — the same scope already delivered for
// PE .pdata / Mach-O __unwind_info.
pub fn elf_eh_frame(offs, lens, code_va_base) {
    let cie = eh_cie()
    let instrs = byte_chr(65) + byte_chr(14) + byte_chr(16) + byte_chr(134) + byte_chr(2) + byte_chr(68) + byte_chr(14) + byte_chr(24)
    let n = len(offs)
    let mut fdes = ""
    let mut i = 0
    while i < n {
        let cie_pointer = str_len(cie) + str_len(fdes) + 4
        let content = u32(cie_pointer) + u64(code_va_base + offs[i]) + u64(lens[i]) + instrs
        fdes = fdes + u32(str_len(content)) + content
        i = i + 1
    }
    cie + fdes
}

// eh_push_instrs 由入口连续 push 的寄存器列表生成 FDE 指令流：每条 push 各自的
// 编码字节数（寄存器号 <8 一字节，r8-r15 因 REX 前缀两字节）决定 advance_loc 步长，
// CFA 偏移每条 push 固定 +8。内部子程序（`runtime.bur` 的 gc_record/mark_addr）
// 序言只做连续 push、不像用户函数序言那样再接 `sub rsp`，故不需要区分两种指令；
// 空数组（零序言：GC/调度器里纯 call/ret、不建帧的子程序）返回空指令流——CIE 的
// 初始规则（CFA=rsp+8）原样贯穿整个函数体，不需要任何 CFI 指令。delta/累计偏移
// 均远小于 64/128（内部子程序序言最多 9 个寄存器），单字节 ULEB128/advance_loc
// 足够，不需要通用变长编码。
// eh_push_instrs builds the FDE instruction stream from the list of registers
// pushed at function entry: each push's own encoding length (1 byte for
// registers <8, 2 bytes for r8-r15 due to the REX prefix) sets the
// advance_loc step, while the CFA offset always grows by 8 per push.
// Internal subroutines (runtime.bur's gc_record/mark_addr) only do
// consecutive pushes at entry, unlike user functions which follow with a
// `sub rsp` — so there's no need to distinguish two instruction shapes here.
// An empty array (zero prologue: GC/scheduler subroutines that are plain
// call/ret and build no frame) returns an empty instruction stream — the
// CIE's initial rule (CFA=rsp+8) holds unchanged for the whole function body,
// needing no CFI instructions at all. Every delta/running offset stays well
// under 64/128 (at most 9 registers), so single-byte advance_loc/ULEB128 is
// enough — no general variable-length encoder needed.
fn eh_push_instrs(push_regs) {
    let mut instrs = ""
    let mut cfa_off = 8
    let mut i = 0
    while i < len(push_regs) {
        let reg = push_regs[i]
        let ilen = if reg >= 8 {
            2
        } else {
            1
        }
        cfa_off = cfa_off + 8
        instrs = instrs + byte_chr(64 + ilen) + byte_chr(14) + byte_chr(cfa_off)
        i = i + 1
    }
    instrs
}

// elf_eh_frame_internal 追加内部子程序的 FDE，跟在 elf_eh_frame 已生成的一批 FDE
// 后面，复用同一份共享 CIE——prior_len 是前面已有内容（CIE + 已发射 FDE）的总字节
// 数，供 cie_pointer 往回数。push_regs_list 与 offs/lens 平行，每项是该函数入口
// 连续 push 的寄存器列表（空数组＝零序言）。
// elf_eh_frame_internal appends internal-subroutine FDEs after the batch
// elf_eh_frame already produced, reusing the same shared CIE — prior_len is
// the total byte length of what precedes this call (CIE plus FDEs already
// emitted), which cie_pointer counts back across. push_regs_list runs
// parallel to offs/lens: each entry is the list of registers pushed at that
// function's entry (an empty array means a zero prologue).
pub fn elf_eh_frame_internal(offs, lens, code_va_base, push_regs_list, prior_len) {
    let n = len(offs)
    let mut fdes = ""
    let mut i = 0
    while i < n {
        let instrs = eh_push_instrs(push_regs_list[i])
        let cie_pointer = prior_len + str_len(fdes) + 4
        let content = u32(cie_pointer) + u64(code_va_base + offs[i]) + u64(lens[i]) + instrs
        fdes = fdes + u32(str_len(content)) + content
        i = i + 1
    }
    fdes
}

// elf_shstrtab 是节名字符串表：唯一有名字的节是 .eh_frame，供 gdb/readelf 的 CFI
// 读取路径按名字定位——不需要完整符号表（崩溃可诊断性只要求返回地址能正确回溯，
// 不要求源码级符号名，与 PE/Mach-O 已交付的范围一致）
// elf_shstrtab is the section-name string table: the only named section is
// .eh_frame, which is what gdb/readelf's CFI-reading path looks up by name —
// no full symbol table is needed (crash-diagnosability only requires a
// correct return-address backtrace, not source-level symbol names, matching
// the scope already delivered for PE/Mach-O)
fn elf_shstrtab() {
    byte_chr(0) + ".eh_frame" + byte_chr(0) + ".shstrtab" + byte_chr(0)
}

// elf_section_header 生成一条 Elf64_Shdr（64B：name/type/flags/addr/offset/size/
// link/info/addralign/entsize）
// elf_section_header builds one Elf64_Shdr (64B: name/type/flags/addr/offset/
// size/link/info/addralign/entsize)
fn elf_section_header(name, typ, addr, off, size) {
    u32(name) + u32(typ) + u64(0) + u64(addr) + u64(off) + u64(size) + u32(0) + u32(0) + u64(1) + u64(0)
}

// emit_elf 是 ELF 装配入口。代码域（常量 + 函数 + 跳转表 + _start）与 .eh_frame
// 组成 R-X 的第一条 PT_LOAD；可写 runtime 区独立成 R-W 的第二条 PT_LOAD，落在
// base_addr + DATA_VA_OFF 的固定高 VA，文件内页对齐紧跟 .eh_frame 之后。节头表
// 与 .shstrtab 落在两条 PT_LOAD 之外（纯尾部调试数据，execve 从不读取它们，已用
// 手工构造的最小 ELF 在 gdb 下实测验证——见 architecture.md §5.19）。
// pdata_offsets/pdata_lens 是 x86.bur codegen 循环已经无条件收集的每函数偏移/
// 长度（PE/Mach-O 复用同一份数据），code_base 是 funcs_bytes 在 code 里的起始
// 偏移，换算 elf_eh_frame 需要的绝对 VA 基址。rt_unwind_* 三个并行数组是内部
// 子程序（gc_record/mark_addr/…）的偏移/长度/入口 push 寄存器列表，追加在用户
// 函数 FDE 后面，同一份共享 CIE。
// emit_elf is the ELF assembly entry. The code domain (constants + functions +
// jump table + _start) plus .eh_frame forms the first, R-X PT_LOAD; the
// writable runtime area becomes its own R-W PT_LOAD at the fixed high VA of
// base_addr + DATA_VA_OFF, page-aligned right after .eh_frame in the file. The
// section header table and .shstrtab sit outside both PT_LOADs (pure trailing
// debug data — execve never reads them, verified against a hand-built minimal
// ELF under real gdb, see architecture.md §5.19). pdata_offsets/pdata_lens are
// the per-function offset/length pairs x86.bur's codegen loop already collects
// unconditionally (shared with PE/Mach-O); code_base is funcs_bytes' starting
// offset within code, converted to the absolute VA base elf_eh_frame needs.
// The three rt_unwind_* parallel arrays are the internal subroutines'
// (gc_record/mark_addr/…) offsets/lengths/entry push-register lists, appended
// after the user-function FDEs, sharing the same CIE.
pub fn emit_elf(code, entry_off, data_content, pdata_offsets, pdata_lens, code_base, rt_unwind_offsets, rt_unwind_lens, rt_unwind_pushes) {
    let code_offset = ELF_CODE_OFF
    let entry = base_addr + code_offset + entry_off
    let va_base = base_addr + code_offset + code_base
    let user_eh = elf_eh_frame(pdata_offsets, pdata_lens, va_base)
    let internal_eh = elf_eh_frame_internal(rt_unwind_offsets, rt_unwind_lens, va_base, rt_unwind_pushes, str_len(user_eh))
    let eh_frame = user_eh + internal_eh
    let eh_frame_off = code_offset + str_len(code)
    let text_total = eh_frame_off + str_len(eh_frame)
    let data_foff = pe_align(text_total, 4096)
    let mut text_pad = ""
    let mut tpi = text_total
    while tpi < data_foff {
        text_pad = text_pad + byte_chr(0)
        tpi = tpi + 1
    }
    let data_len = str_len(data_content)
    let shstrtab = elf_shstrtab()
    let sh_off = data_foff + data_len + str_len(shstrtab)
    let null_sh = elf_section_header(0, 0, 0, 0, 0)
    let eh_sh = elf_section_header(1, 1, base_addr + eh_frame_off, eh_frame_off, str_len(eh_frame))
    let shstr_sh = elf_section_header(11, 3, 0, data_foff + data_len, str_len(shstrtab))
    elf_header_with_sh(entry, 2, sh_off, 3, 2) + phdr_load(0, base_addr, text_total, text_total, pf_r + pf_x) + phdr_load(data_foff, base_addr + DATA_VA_OFF, data_len, data_len, pf_r + pf_w) + code + eh_frame + text_pad + data_content + shstrtab + null_sh + eh_sh + shstr_sh
}

// syscall 只在 linux 发裸 syscall 指令；其余目标没有稳定的裸 syscall 契约
// （Windows 无裸接口，darwin 的号与 ABI 都不同），一律经 runtime 区尾的分派器
// 槽间接调用（movabs rcx,<slot>; call [rcx]）。槽里是分派器绝对地址，不是可
// 执行桩。rcx/r11 本就是 Linux syscall 契约的牺牲寄存器，调用点语义不变。
// syscall emits the raw syscall instruction on linux only; other targets lack a
// stable raw-syscall contract (Windows has no raw surface, darwin differs in
// numbers and ABI), so they uniformly call through the dispatcher pointer slot
// appended after the runtime area (movabs rcx,<slot>; call [rcx]). The slot
// holds the dispatcher's absolute address, not executable stub bytes. rcx/r11
// die under the Linux contract anyway, keeping every call site's semantics
// unchanged.
pub fn syscall() {
    if target_os == "linux" {
        byte_chr(15) + byte_chr(5)
    } else {
        byte_chr(72) + byte_chr(185) + e8(thunk_slot_abs()) + byte_chr(255) + byte_chr(17)
    }
}

// sys_mov_rax 装载 syscall 号到 rax / sys_mov_rax loads the syscall number into rax
pub fn sys_mov_rax(n) {
    byte_chr(72) + byte_chr(184) + u64(n)
}

// sys_mov_rdi 装载参数 1 到 rdi / sys_mov_rdi loads argument 1 into rdi
pub fn sys_mov_rdi(v) {
    byte_chr(72) + byte_chr(191) + u64(v)
}

// sys_mov_rsi 装载参数 2 到 rsi / sys_mov_rsi loads argument 2 into rsi
pub fn sys_mov_rsi(v) {
    byte_chr(72) + byte_chr(190) + u64(v)
}

// sys_mov_rdx 装载参数 3 到 rdx / sys_mov_rdx loads argument 3 into rdx
pub fn sys_mov_rdx(v) {
    byte_chr(72) + byte_chr(186) + u64(v)
}

// u16 生成小端 u16 字节序列 / u16 builds a little-endian u16
fn u16(v) {
    byte_chr(v % 256) + byte_chr(v / 256 % 256)
}

// u32 生成 4 字节小端 / u32 builds 4 little-endian bytes
fn u32(v) {
    byte_chr(v % 256) + byte_chr(v / 256 % 256) + byte_chr(v / 65536 % 256) + byte_chr(v / 16777216 % 256)
}

// u64 生成 8 字节小端 / u64 builds 8 little-endian bytes
fn u64(v) {
    u32(v % 4294967296) + u32(v / 4294967296)
}
