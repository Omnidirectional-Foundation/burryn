// elf.bur — ELF 输出：程序头、段布局与 Linux syscall 编号。
// ELF output: program headers, segment layout and Linux syscall numbers.

let et_exec = 2
let em_x86_64 = 62
let pt_load = 1
let pf_x = 1
let pf_r = 4
let pf_w = 2

// 固定加载基址（静态非 PIE）/ Fixed load base (static, non-PIE)
pub let base_addr = 4194304

// elf_header 生成 ELF 头 / elf_header builds the ELF header
fn elf_header(entry, phnum) {
    let ident = byte_chr(127) + "ELF" + byte_chr(2) + byte_chr(1) + byte_chr(1) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0)

    ident + u16(et_exec) + u16(em_x86_64) + u32(1) + u64(entry) + u64(64) + u64(0) + u32(0) + u16(64) + u16(56) + u16(phnum) + u16(64) + u16(0) + u16(0)
}

// phdr_load 生成 PT_LOAD 程序头（读+写+执行：GC runtime 槽需写）/ phdr_load builds a PT_LOAD program header (RWX: GC runtime slots are writable)
fn phdr_load(offset, vaddr, filesz, memsz) {
    u32(pt_load) + u32(pf_r + pf_x + pf_w) + u64(offset) + u64(vaddr) + u64(vaddr) + u64(filesz) + u64(memsz) + u64(4096)
}

// emit_elf 是 ELF 装配入口 / emit_elf is the ELF assembly entry
pub fn emit_elf(code, entry_off) {
    let hdr_size = 64
    let ph_size = 56
    let code_offset = hdr_size + ph_size
    let entry = base_addr + code_offset + entry_off
    let total = code_offset + str_len(code)
    elf_header(entry, 1) + phdr_load(0, base_addr, total, total) + code
}

// syscall 只在 linux 发裸 syscall 指令；其余目标没有稳定的裸 syscall 契约
// （Windows 无裸接口，darwin 的号与 ABI 都不同），一律经 runtime 区尾的分派器
// 槽间接调用（movabs rcx,<slot>; call [rcx]）。槽里是分派器绝对地址，不是可
// 执行桩。rcx/r11 本就是 Linux syscall 契约的牺牲寄存器，调用点语义不变。
// syscall emits the raw syscall instruction on linux only; other targets lack a
// stable raw-syscall contract (Windows has no raw surface, darwin differs in
// numbers and ABI), so they uniformly call through the dispatcher pointer slot
// appended after the runtime area (movabs rcx,<slot>; call [rcx]). The slot
// holds the dispatcher's absolute address, not executable stub bytes. rcx/r11
// die under the Linux contract anyway, keeping every call site's semantics
// unchanged.
pub fn syscall() {
    if target_os == "linux" {
        byte_chr(15) + byte_chr(5)
    } else {
        byte_chr(72) + byte_chr(185) + e8(thunk_slot_abs()) + byte_chr(255) + byte_chr(17)
    }
}

// sys_mov_rax 装载 syscall 号到 rax / sys_mov_rax loads the syscall number into rax
pub fn sys_mov_rax(n) {
    byte_chr(72) + byte_chr(184) + u64(n)
}

// sys_mov_rdi 装载参数 1 到 rdi / sys_mov_rdi loads argument 1 into rdi
pub fn sys_mov_rdi(v) {
    byte_chr(72) + byte_chr(191) + u64(v)
}

// sys_mov_rsi 装载参数 2 到 rsi / sys_mov_rsi loads argument 2 into rsi
pub fn sys_mov_rsi(v) {
    byte_chr(72) + byte_chr(190) + u64(v)
}

// sys_mov_rdx 装载参数 3 到 rdx / sys_mov_rdx loads argument 3 into rdx
pub fn sys_mov_rdx(v) {
    byte_chr(72) + byte_chr(186) + u64(v)
}

// u16 生成小端 u16 字节序列 / u16 builds a little-endian u16
fn u16(v) {
    byte_chr(v % 256) + byte_chr(v / 256 % 256)
}

// u32 生成 4 字节小端 / u32 builds 4 little-endian bytes
fn u32(v) {
    byte_chr(v % 256) + byte_chr(v / 256 % 256) + byte_chr(v / 65536 % 256) + byte_chr(v / 16777216 % 256)
}

// u64 生成 8 字节小端 / u64 builds 8 little-endian bytes
fn u64(v) {
    u32(v % 4294967296) + u32(v / 4294967296)
}
