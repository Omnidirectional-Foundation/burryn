// emit.bur — x86 后端发射器：字节码逐条翻译为机器码，
// 附常量池、局部槽位、枚举与 record 类型解析、值格式化。
// The x86 backend emitter: translates bytecode opcode by opcode into machine code,
// with the constant pool, local slots, enum and record type resolution,
// and value formatting.

import "burryn.dev/compiler/lib"

// emit_one_variant：单函数单变体发射（含嵌套 emit_inst）
// emit_one_variant: emit one function variant (nested emit_inst included)
fn emit_one_variant(ctx, fh, vi, vsigs, f_name, f_arity, f_nupvals, f_code, f_consts, en_qual, _en_vnames, nfn, f2s_h, p_depth_maps, mut pt_target_shadow, mut pd_sink, globals_map, n_globals, mut global_type, method_full_map, fn_ret_type, fn_ret_param, fn_param_types, fn_extra_base, record_encs, record_offs, mut record_field_types, mut _enum_field_types, mut _enum_variant_types, out_enc, res_out_enc, res_int_enc, opt_res_enc, yield_addr, sched_addr, timer_add_addr, done_addr, chan_sched_addr, chan_wake_addr, chan_push_sendq_addr, chan_push_recvq_addr, chan_push_waiters_addr, chan_remove_waiter_addr, waitset_add_addr) {
    let code = f_code[fh]
    let arity = f_arity[fh]
    let locals = count_locals(ctx, fh)

    let mut out = []
    let mut patches = []
    let mut shadow = []
    let mut type_shadow = []
    let mut cur_variant = -1
    let mut cur_enum_eh = -1
    let mut pos_types = []
    let mut pos_auth = []
    let mut top_slot = -1
    let mut pending_cvds = []
    let mut pending_olds = []
    // 本条指令是否为描述符常量加载（盖章抑制标志，供启发式读取）
    let mut sup_stamp = false
    let mut seed = 0
    while seed < arity + 1 {
        push(shadow, "")
        push(type_shadow, "")
        seed = seed + 1
    }
    let mut seed2 = 0
    while seed2 < arity + 1 {
        push(pos_types, "")
        push(pos_auth, false)
        seed2 = seed2 + 1
    }
    let mut pseed_e = 1
    while pseed_e < arity + 1 {
        if pseed_e - 1 < len(vsigs[vi]) {
            pos_types[pseed_e] = vsigs[vi][pseed_e - 1]
        }
        // 参数槽的值在调用帧里（无 set_local）：标记权威
        // parameter slots hold values in the call frame (no set_local): mark them authoritative
        pos_auth[pseed_e] = true
        pseed_e = pseed_e + 1
    }
    // 预扫描本函数闭包描述符：ref 捕获的局部槽提升为 cell 指针槽
    // pre-scan closure descriptors: ref-captured locals are lifted to cell slots
    let mut lifted = []
    let mut lip = 0
    while lip < len(code) {
        if code[lip] == lib::op_closure {
            let lsub = fn_const(ctx, fh, read_u16(code, lip + 1))
            let lnup = f_nupvals[lsub]
            let mut lui = 0
            while lui < lnup {
                let lflag = code[lip + 3 + 3 * lui]
                if lflag >= 2 && lflag % 2 == 1 {
                    let luidx = read_u16(code, lip + 4 + 3 * lui)
                    while len(lifted) <= luidx {
                        push(lifted, false)
                    }
                    lifted[luidx] = true
                }
                lui = lui + 1
            }
        }
        lip = lip + inst_len(ctx, fh, code, lip)
    }
    let mut ip_to_byte = map()
    // w 追加字节 / w appends bytes
    // Append bytes
    // is_lifted 判断槽是否已提升为 cell 指针槽
    // is_lifted tells whether a slot has been lifted to a cell slot
    fn is_lifted(slot) {
        slot > 0 && slot < len(lifted) && lifted[slot]
    }
    fn w(s) {
        push(out, s)
    }
    // cur_byte 取当前字节位置 / cur_byte returns the current byte position
    // Current byte position
    fn cur_byte() {
        str_len(join(out, ""))
    }

    // emit_inst 发射单条指令 / emit_inst emits one instruction
    // Emit one instruction
    fn emit_inst(ip, in_dead) capture(ref cur_variant, ref shadow, ref type_shadow, ref pos_types, ref pos_auth, ref top_slot, ref pending_cvds, ref pending_olds, ref sched_addr, ref timer_add_addr, ref sup_stamp) {
        if in_dead {
            // 死代码不可达：只发占位 trap，不做任何 shadow 维护
            // unreachable code: emit a placeholder trap, no shadow bookkeeping
            w(int3())
            return
        }
        let op = code[ip]
        let sl_ed = len(shadow)
        let tl_ed = len(type_shadow)
        // 所有 park（send/recv/chan_next/select）共享：lea-push 恢复点（P 后紧跟的
        // L 地址）→ 保存 ctx → 跳 sched；sched 恢复 = ret 弹 [FB_RSP]（与 yield 的
        // call 返回地址同机制，lea 的 rel32 = push+保存+跳转的固定长度）
        // Shared park tail: lea-push the resume point (the L right after P), save
        // the ctx, jump to the scheduler; resume is ret popping [FB_RSP], the
        // same mechanism as the yield block's call return address
        let park_save = mov_mr(rax, FB_RSP, rsp) + mov_mr(rax, FB_RBP, rbp) + mov_mr(rax, FB_R14, r14) + mov_mr(rax, FB_R15, r15)
        let park_tail = mov_ri64(r8, sched_addr) + jmp_r(r8)
        let park_push = lea_rip_rel32(r8, str_len(push_r(r8)) + str_len(park_save) + str_len(park_tail)) + push_r(r8)
        // 常量加载：int 立即数直接发射，其余走常量区指针
        // Constant load: int immediates inline; everything else via constant-area pointers
        if op == lib::op_const {
            let idx = read_u16(code, ip + 1)
            match f_consts[fh][idx] {
                lib::CVal::CInt(v) => w(rex(1, 0, 0, rax) + e1(184) + e8s(v) + vs_push(rax)),
                lib::CVal::CStr(_) => w(mov_ri64(rax, const_addr(ctx, fh, idx)) + vs_push(rax)),
                lib::CVal::CEnumType(_) => {
                    w(mov_ri64(rax, const_addr(ctx, fh, idx)) + vs_push(rax))
                    sup_stamp = true
                },
                lib::CVal::CSingleton(_, _) => {
                    w(mov_ri64(rax, const_addr(ctx, fh, idx)) + vs_push(rax))
                    sup_stamp = true
                },
                lib::CVal::CCtor(_, _) => w(mov_ri64(rax, const_addr(ctx, fh, idx)) + vs_push(rax)),
                lib::CVal::CFloat(fl) => w(x86gen_float_const(float_bits(fl))),
                _ => w(int3()),
            }
            match f_consts[fh][idx] {
                lib::CVal::CStr(_) => {
                    push(shadow, "str")
                    push(type_shadow, "str")
                },
                lib::CVal::CEnumType(eh) => {
                    push(shadow, "enumtype")
                    push(type_shadow, "enum:e" + str(eh))
                },
                lib::CVal::CSingleton(seh, svi) => {
                    push(shadow, "ctor:" + str(seh) + ":" + str(svi))
                    push(type_shadow, "enum:e" + str(seh) + "#" + str(svi) + ":")
                },
                lib::CVal::CCtor(ceh, cvi) => {
                    push(shadow, "ctor:" + str(ceh) + ":" + str(cvi))
                    push(type_shadow, "ctor")
                },
                lib::CVal::CFloat(_) => {
                    push(shadow, "float")
                    push(type_shadow, "float")
                },
                _ => {
                    push(shadow, "")
                    push(type_shadow, "int")
                },
            }
        } else if op == lib::op_unit {
            w(vs_push_zero())
            push(shadow, "")
            push(type_shadow, "unit")
        } else if op == lib::op_true {
            w(e1(73) + e1(199) + modrm(0, 0, r15) + e4(1) + add_ri32(r15, 8))
            push(shadow, "")
            push(type_shadow, "bool")
        } else if op == lib::op_false {
            w(vs_push_zero())
            push(shadow, "")
            push(type_shadow, "bool")
        } else if op == lib::op_pop {
            w(vs_pop_n(1))
            shadow_pop(shadow, 1)
            shadow_pop(type_shadow, 1)
        } else if op == lib::op_pop_n {
            let n = code[ip + 1]
            w(vs_pop_n(n))
            shadow_pop(shadow, n)
            shadow_pop(type_shadow, n)
        } else if op == lib::op_end_block {
            let n = code[ip + 1]
            w(mov_rm(rax, r15, 0 - 8) + sub_ri32(r15, 8 * (n + 1)) + mov_mr(r15, 0, rax) + add_ri32(r15, 8))
            let res_name = if len(shadow) > 0 {
                shadow[len(shadow) - 1]
            } else {
                ""
            }
            let res_type = if len(type_shadow) > 0 {
                type_shadow[len(type_shadow) - 1]
            } else {
                "int"
            }
            shadow_pop(shadow, n + 1)
            shadow_pop(type_shadow, n + 1)
            push(shadow, res_name)
            push(type_shadow, res_type)
            let live_n = len(type_shadow)
            let mut ci = live_n
            while ci < len(pos_types) {
                pos_types[ci] = ""
                if ci < len(pos_auth) {
                    pos_auth[ci] = false
                }
                ci = ci + 1
            }
        } else if op == lib::op_get_local {
            let slot = read_u16(code, ip + 1)
            if slot == 0 {
                w(vs_push_zero())
                push(shadow, f_name[fh])
                push(type_shadow, "")
            } else {
                // 未初始化的 local（如 match 的 (match) 临时）采用当前栈顶类型并回写
                // an uninitialized local (e.g. a match's (match) temp) takes the current
                // stack-top type and writes it back
                let mut stype = ""
                if slot < len(pos_types) && str_len(pos_types[slot]) > 0 {
                    stype = pos_types[slot]
                    if len(type_shadow) > 0 {
                        let top_t = type_shadow[len(type_shadow) - 1]
                        if slot == len(type_shadow) - 1 && is_enum_enc(top_t) && top_t != stype {
                            stype = top_t
                            pos_types[slot] = top_t
                        } else if slot == len(type_shadow) - 1 && is_enum_enc(stype) && !is_enum_enc(top_t) && str_len(top_t) > 0 {
                            stype = top_t
                            pos_types[slot] = top_t
                        }
                    }
                } else if slot < len(pos_auth) && pos_auth[slot] {
                    stype = ""
                } else if len(type_shadow) > 0 && slot == len(type_shadow) - 1 {
                    stype = type_shadow[len(type_shadow) - 1]
                    if slot >= len(pos_types) {
                        while len(pos_types) <= slot {
                            push(pos_types, "")
                        }
                    }
                    pos_types[slot] = stype
                }
                if is_lifted(slot) {
                    if slot < len(pos_auth) && pos_auth[slot] {
                        // 提升槽：槽存 cell 指针，读须解引用
                        // lifted slot: the slot holds a cell pointer, dereference on read
                        w(mov_rm(rax, r14, 8 * slot) + mov_rm(rax, rax, 0) + vs_push(rax))
                    } else {
                        // 兜底：let 初始化无 SET_LOCAL（CONST 落槽），槽里是裸值——
                        // 分配 cell 装入并回写，后续读写走 cell
                        // fallback: let init has no SET_LOCAL (const lands in the slot),
                        // the slot holds a raw value; allocate a cell, move the value in,
                        // and write the cell pointer back
                        w(mov_rm(rax, r14, 8 * slot) + mov_rr(r11, r12) + mov_mr(r11, 0, rax) + add_ri32(r12, 8) + gc_rec(r11, mov_ri64(rsi, 8)) + mov_mr(r14, 8 * slot, r11) + mov_rm(rax, r11, 0) + vs_push(rax))
                        while len(pos_auth) <= slot {
                            push(pos_auth, false)
                        }
                        pos_auth[slot] = true
                    }
                } else {
                    w(mov_rm(rax, r14, 8 * slot) + vs_push(rax))
                }
                push(shadow, "slot:" + str(slot))
                top_slot = slot
                // 声明值被读取，确认是真声明：摘除该槽的回滚链，不再回滚
                // the declaration value has been read; confirm it and drop
                // its rollback chain
                let mut pc_c = 0
                let mut pc_f = []
                let mut pc_fo = []
                while pc_c < len(pending_cvds) {
                    if pending_cvds[pc_c] != slot {
                        push(pc_f, pending_cvds[pc_c])
                        push(pc_fo, pending_olds[pc_c])
                    }
                    pc_c = pc_c + 1
                }
                pending_cvds = pc_f
                pending_olds = pc_fo
                push(type_shadow, stype)
            }
        } else if op == lib::op_set_local {
            let slot = read_u16(code, ip + 1)
            let was_auth = slot > 0 && slot < len(pos_auth) && pos_auth[slot]
            if slot > 0 {
                while len(pos_types) <= slot {
                    push(pos_types, "")
                }
                if len(type_shadow) > 0 {
                    pos_types[slot] = type_shadow[len(type_shadow) - 1]
                } else {
                    // select recv 臂体的 set_local：栈顶类型已被 select 弹掉，默认 int
                    // select recv arm body set_local: select popped the stack-top type,
                    // default to int instead of leaving the slot untyped
                    pos_types[slot] = "int"
                }
                while len(pos_auth) <= slot {
                    push(pos_auth, false)
                }
                pos_auth[slot] = true
            }
            if is_lifted(slot) {
                if was_auth {
                    // 后续写：写 cell 内容
                    // subsequent writes: write through the cell
                    w(mov_rm(rcx, r14, 8 * slot) + mov_rm(rax, r15, 0 - 8) + mov_mr(rcx, 0, rax))
                } else {
                    // 首次写：分配 cell，槽存指针（gc_rec 在 r11 跨调用存活）
                    // first write: allocate the cell, the slot holds the pointer
                    // (gc_rec preserves r11 across the call)
                    w(mov_rr(r11, r12) + mov_rm(rax, r15, 0 - 8) + mov_mr(r11, 0, rax) + add_ri32(r12, 8) + gc_rec(r11, mov_ri64(rsi, 8)) + mov_mr(r14, 8 * slot, r11))
                }
            } else {
                w(mov_rm(rax, r15, 0 - 8) + mov_mr(r14, 8 * slot, rax))
            }
        } else if op == lib::op_get_global {
            let idx = read_u16(code, ip + 1)
            let name = const_str(ctx, fh, idx)
            match get(globals_map, name) {
                Some(slot) => w(mov_rm(rax, rbx, 8 * slot) + vs_push(rax)),
                None => w(vs_push_zero()),
            }
            push(shadow, name)
            let gtype = if find_fn_by_name(f_name, name) >= 0 {
                ""
            } else if contains(lib::native_names, name) {
                "native:" + name
            } else {
                match get(global_type, name) {
                    Some(t) => t,
                    None => "",
                }
            }
            push(type_shadow, gtype)
        } else if op == lib::op_def_global {
            let idx = read_u16(code, ip + 1)
            let name = const_str(ctx, fh, idx)
            let slot = match get(globals_map, name) {
                Some(s) => s,
                None => 0,
            }
            let gtype = match len(type_shadow) {
                0 => "",
                _ => type_shadow[len(type_shadow) - 1],
            }
            let gcur = match get(global_type, name) {
                Some(t) => t,
                None => "",
            }
            put(ctx.global_type, name, merge_type(gcur, gtype))
            w(mov_rm(rax, r15, 0 - 8) + mov_mr(rbx, 8 * slot, rax) + vs_pop_n(1))
            shadow_pop(shadow, 1)
            shadow_pop(type_shadow, 1)
        } else if op == lib::op_set_global {
            let idx = read_u16(code, ip + 1)
            let name = const_str(ctx, fh, idx)
            let slot = match get(globals_map, name) {
                Some(s) => s,
                None => 0,
            }
            w(mov_rm(rax, r15, 0 - 8) + mov_mr(rbx, 8 * slot, rax))
            put(ctx.global_type, name, type_shadow[len(type_shadow) - 1])
        } else if op == lib::op_eq {
            let sa_eq = if len(type_shadow) > 1 {
                type_shadow[len(type_shadow) - 2]
            } else {
                ""
            }
            let sb_eq = if len(type_shadow) > 0 {
                type_shadow[len(type_shadow) - 1]
            } else {
                ""
            }
            if sa_eq == "str" && sb_eq == "str" {
                w(x86gen_eq_str())
            } else if is_record_type(sa_eq) && is_record_type(sb_eq) {
                let rq_schema = if str_len(record_schema(sa_eq)) > 0 {
                    record_schema(sa_eq)
                } else {
                    record_schema(sb_eq)
                }
                match get(record_field_types, rq_schema) {
                    Some(ft) => w(x86gen_record_eq(ft)),
                    None => w(x86gen_record_eq([])),
                }
            } else if is_enum_enc(sa_eq) && is_enum_enc(sb_eq) {
                let eq_enc1 = enum_eq_enc(ctx, sa_eq)
                let eq_enc2 = if str_len(eq_enc1) > 0 {
                    eq_enc1
                } else {
                    enum_eq_enc(ctx, sb_eq)
                }
                w(x86gen_enum_eq_at(ctx, eq_enc2))
            } else if sa_eq == "float" && sb_eq == "float" {
                w(x86gen_float_cmp("eq"))
            } else {
                w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + sete(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
            }
            shadow_pop(shadow, 2)
            shadow_pop(type_shadow, 2)
            push(shadow, "")
            push(type_shadow, "bool")
        } else if op == lib::op_neq {
            let sa_neq = if len(type_shadow) > 1 {
                type_shadow[len(type_shadow) - 2]
            } else {
                ""
            }
            let sb_neq = if len(type_shadow) > 0 {
                type_shadow[len(type_shadow) - 1]
            } else {
                ""
            }
            if sa_neq == "str" && sb_neq == "str" {
                let cmp_body_neq = lea(rsi, rax, 8) + lea(rdi, rcx, 8) + mov_rr(rcx, rdx) + repe_cmpsb() + setne(r10)
                w(mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + mov_rm(rdx, rax, 0) + mov_rm(r9, rcx, 0) + xor_rr(r10, r10) + cmp_rr(rdx, r9) + jne_rel32(str_len(cmp_body_neq)) + cmp_body_neq + mov_mr(r15, 0 - 16, r10) + vs_pop_n(1))
            } else if is_record_type(sa_neq) && is_record_type(sb_neq) {
                let rn_schema = if str_len(record_schema(sa_neq)) > 0 {
                    record_schema(sa_neq)
                } else {
                    record_schema(sb_neq)
                }
                match get(record_field_types, rn_schema) {
                    Some(ft) => w(x86gen_record_eq(ft) + mov_rm(rax, r15, 0 - 8) + test_rr(rax, rax) + sete(r8) + mov_mr(r15, 0 - 8, r8)),
                    None => w(x86gen_record_eq([]) + mov_rm(rax, r15, 0 - 8) + test_rr(rax, rax) + sete(r8) + mov_mr(r15, 0 - 8, r8)),
                }
            } else if is_enum_enc(sa_neq) && is_enum_enc(sb_neq) {
                let neq_enc1 = enum_eq_enc(ctx, sa_neq)
                let neq_enc2 = if str_len(neq_enc1) > 0 {
                    neq_enc1
                } else {
                    enum_eq_enc(ctx, sb_neq)
                }
                w(x86gen_enum_eq_at(ctx, neq_enc2) + mov_rm(rax, r15, 0 - 8) + test_rr(rax, rax) + sete(r8) + mov_mr(r15, 0 - 8, r8))
            } else if sa_neq == "float" && sb_neq == "float" {
                w(x86gen_float_cmp("neq"))
            } else {
                w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setne(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
            }
            shadow_pop(shadow, 2)
            shadow_pop(type_shadow, 2)
            push(shadow, "")
            push(type_shadow, "bool")
        } else if op == lib::op_gt {
            let s_gt = if len(type_shadow) > 0 {
                type_shadow[len(type_shadow) - 1]
            } else {
                ""
            }
            if s_gt == "float" {
                w(x86gen_float_cmp("gt"))
            } else {
                w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setg(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
            }
            shadow_pop(shadow, 2)
            shadow_pop(type_shadow, 2)
            push(shadow, "")
            push(type_shadow, "bool")
        } else if op == lib::op_gt_eq {
            let s_ge = if len(type_shadow) > 0 {
                type_shadow[len(type_shadow) - 1]
            } else {
                ""
            }
            if s_ge == "float" {
                w(x86gen_float_cmp("ge"))
            } else {
                w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setge(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
            }
            shadow_pop(shadow, 2)
            shadow_pop(type_shadow, 2)
            push(shadow, "")
            push(type_shadow, "bool")
        } else if op == lib::op_lt {
            let s_lt = if len(type_shadow) > 0 {
                type_shadow[len(type_shadow) - 1]
            } else {
                ""
            }
            if s_lt == "float" {
                w(x86gen_float_cmp("lt"))
            } else {
                w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setl(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
            }
            shadow_pop(shadow, 2)
            shadow_pop(type_shadow, 2)
            push(shadow, "")
            push(type_shadow, "bool")
        } else if op == lib::op_lt_eq {
            let s_le = if len(type_shadow) > 0 {
                type_shadow[len(type_shadow) - 1]
            } else {
                ""
            }
            if s_le == "float" {
                w(x86gen_float_cmp("le"))
            } else {
                w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setle(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
            }
            shadow_pop(shadow, 2)
            shadow_pop(type_shadow, 2)
            push(shadow, "")
            push(type_shadow, "bool")
        } else if op == lib::op_add {
            let sa = type_shadow[len(type_shadow) - 2]
            let sb = type_shadow[len(type_shadow) - 1]
            if sa == "str" || sb == "str" {
                if sa == "int" || sa == "bool" || sa == "float" || sa == "unit" {
