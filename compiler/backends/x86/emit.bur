                let NONE = mov_rr(rcx, r12) + mov_ri64(rdx, recv_eh) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + add_ri32(r12, 16) + mov_mr(r15, 0 - 16, rcx) + vs_pop_n(1)
