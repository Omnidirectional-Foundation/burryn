                let GOT_handoff = mov_rm(rdx, rax, CH_SENDQ) + mov_rm(r9, rdx, 0) + mov_rm(rcx, rax, CH_NSENDQ) + sub_ri32(rcx, 1) + mov_rr(r10, rcx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(r10) + mov_rr(rcx, r10) + mov_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rr(rdi, rdx) + rep_movsb() + mov_rm(rcx, rax, CH_NSENDQ) + sub_ri32(rcx, 1) + mov_mr(rax, CH_NSENDQ, rcx) + mov_rm(rdx, r9, FB_R15) + mov_rm(rdx, rdx, 0 - 8) + mov_rm(r10, rax, CH_BUFLEN) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(r10) + mov_rm(r11, rax, CH_BUF) + add_rr(r11, r10) + mov_mr(r11, 0, rdx) + mov_rm(rcx, rax, CH_BUFLEN) + add_ri32(rcx, 1) + mov_mr(rax, CH_BUFLEN, rcx) + mov_rr(rax, r9) + mov_ri64(r10, chan_sched_addr) + call_r(r10) + GOT_wake
                let GOT_pop = mov_rm(r10, rax, CH_BUFLEN) + mov_rm(rdx, rax, CH_BUF) + mov_rm(r8, rdx, 0) + mov_rm(rcx, rax, CH_BUFLEN) + sub_ri32(rcx, 1) + mov_rr(r10, rcx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(r10) + mov_rr(rcx, r10) + mov_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rr(rdi, rdx) + rep_movsb() + mov_rm(rcx, rax, CH_BUFLEN) + sub_ri32(rcx, 1) + mov_mr(rax, CH_BUFLEN, rcx) + mov_rm(rcx, rax, CH_NSENDQ) + test_rr(rcx, rcx) + je_rel32(str_len(GOT_handoff) - str_len(GOT_wake)) + GOT_handoff
