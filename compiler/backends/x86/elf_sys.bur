// elf_sys.bur — syscall / 参数寄存器。
// elf_sys.bur — syscall / arg regs.



// syscall 发射 syscall 指令；Windows 无稳定裸 syscall，改为经 runtime 区尾的
// 分派器槽间接调用（movabs rcx,<slot>; call [rcx]）。槽里是分派器绝对地址，
// 不是可执行桩。rcx/r11 本就是 Linux syscall 契约的牺牲寄存器，调用点语义不变。
// syscall emits the syscall instruction; Windows has no stable raw syscalls,
// so it calls through the dispatcher slot appended after the runtime area
// (movabs rcx,<slot>; call [rcx]). The slot holds the dispatcher's absolute
// address, not executable stub bytes. rcx/r11 die under the Linux contract
// anyway, keeping every call site's semantics unchanged.
pub fn syscall() {
    if target_os == "windows" {
        byte_chr(72) + byte_chr(185) + e8(thunk_slot_abs()) + byte_chr(255) + byte_chr(17)
    } else {
        byte_chr(15) + byte_chr(5)
    }
}

// sys_mov_rax 装载 syscall 号到 rax / sys_mov_rax loads the syscall number into rax
pub fn sys_mov_rax(n) {
    byte_chr(72) + byte_chr(184) + u64(n)
}

