// layout_origin.bur — 镜像基址/段原点。
// layout_origin.bur — image base / section origins.

pub fn set_target_os(os) {
    target_os = os
}

// img_base 返回代码/常量域的绝对基址：ELF 在 base+120（头 64+56B）；
// PE 头区占满首个 RVA 页，内容从 base+4096 起；Mach-O 的 __TEXT 内容
// 从 base+0x1000 起。所有绝对地址编码经此收口。
// img_base returns the absolute base of the code/constants domain: ELF sits at
// base+120 (64+56 bytes of headers); PE headers fill the first RVA page, so
// content starts at base+4096; Mach-O __TEXT content starts at base+0x1000.
// Every absolute encoding funnels through here.
pub fn img_base() {
    if target_os == "windows" {
        base_addr + 4096
    } else if target_os == "darwin" {
        macho_base + MACHO_TEXT_OFF
    } else {
        base_addr + 120
    }
}
