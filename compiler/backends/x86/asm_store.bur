// asm_store.bur — 存内存。
// asm_store.bur — store to memory.



// mov_mr 发射寄存器到内存 / mov_mr emits register-to-memory
pub fn mov_mr(base, disp, src) {
    if disp == 0 && base % 8 != 5 {
        rex(1, src, 0, base) + e1(137) + modrm(0, src, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        rex(1, src, 0, base) + e1(137) + modrm(1, src, base) + sib_for(base) + sb(disp)
    } else {
        rex(1, src, 0, base) + e1(137) + modrm(2, src, base) + sib_for(base) + e4s(disp)
    }
}

// mov_mr32 发射 32 位寄存器到内存 / mov_mr32 emits a 32-bit register-to-memory store
pub fn mov_mr32(base, disp, src) {
    if disp == 0 && base % 8 != 5 {
        rex(0, src, 0, base) + e1(137) + modrm(0, src, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        rex(0, src, 0, base) + e1(137) + modrm(1, src, base) + sib_for(base) + sb(disp)
    } else {
        rex(0, src, 0, base) + e1(137) + modrm(2, src, base) + sib_for(base) + e4s(disp)
    }
}

