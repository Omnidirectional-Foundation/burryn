// emit_enum.bur — x86 枚举字段解析、格式化与相等比较发射。
// emit_enum.bur — x86 enum field resolve, formatting, and equality emit.

import "burryn.dev/compiler/lib"

// reg_enum_type 注册枚举实例类型 / reg_enum_type registers an enum instance type
// qual = 枚举限定名, vts = 各 variant 字段类型列表; 返回编码字符串
fn reg_enum_type(mut enum_field_types, qual, vts) {
    let key = enum_field_key(qual, vts)
    put(enum_field_types, key, vts)
    key
}


