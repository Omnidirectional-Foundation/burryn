// natives_float_unbox.bur — unbox/box。
// natives_float_unbox.bur — unbox/box.



// x86gen_float_unbox 生成"把 r15+off 处指针所指盒的 8B 位模式读到 rax" / x86gen_float_unbox reads the 8-byte bit
// pattern of the box pointed at [r15+off] into rax
fn x86gen_float_unbox(off) {
    mov_rm(rax, r15, off) + mov_rm(rax, rax, 0)
}

// x86gen_float_unbox_to 生成"把 [r15+off] 指针所指盒的位模式写入 r15+dst_off"
// x86gen_float_unbox_to copies the box bits at [r15+off] to [r15+dst_off]
fn x86gen_float_unbox_to(src_off, dst_off) {
    mov_rm(rax, r15, src_off) + mov_rm(rax, rax, 0) + mov_mr(r15, dst_off, rax)
}

// x86gen_float_box_rax 生成"把 rax 的位模式装箱并写回 r15+off" / x86gen_float_box_rax boxes rax's bit pattern
// and writes the pointer to [r15+off]
fn x86gen_float_box_rax(off) {
    mov_rr(r11, r12) + mov_mr(r11, 0, rax) + add_ri32(r12, 8) + mov_mr(r15, off, r11)
}
