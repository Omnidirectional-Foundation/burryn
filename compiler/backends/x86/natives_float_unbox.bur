// natives_float_unbox.bur — unbox/box。
// natives_float_unbox.bur — unbox/box.

// x86gen_float_box_rax 生成"把 rax 的位模式装箱并写回 r15+off" / x86gen_float_box_rax boxes rax's bit pattern
// and writes the pointer to [r15+off]
fn x86gen_float_box_rax(off) {
    mov_rr(r11, r12) + mov_mr(r11, 0, rax) + add_ri32(r12, 8) + mov_mr(r15, off, r11)
}
