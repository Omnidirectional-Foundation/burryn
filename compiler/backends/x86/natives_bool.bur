// x86gen_bool_convert_at 生成 bool→str 转换：true/false 常量字符串
// x86gen_bool_convert_at emits bool-to-str: true/false constant strings
// bool-to-str: the constant strings true/false
fn x86gen_bool_convert_at(off) {
    let fpath = mov_rr(r11, r12) + mov_ri64(r10, 5) + mov_mr(r11, 0, r10) + mov_ri64(rdx, 435728179558) + mov_mr(r11, 8, rdx) + add_ri32(r10, 8) + add_rr(r12, r10) + gc_rec(r11, mov_rr(rsi, r10)) + mov_mr(r15, off, r11)
    let tpath = mov_rr(r11, r12) + mov_ri64(r10, 4) + mov_mr(r11, 0, r10) + mov_ri64(rdx, 1702195828) + mov_mr(r11, 8, rdx) + add_ri32(r10, 8) + add_rr(r12, r10) + gc_rec(r11, mov_rr(rsi, r10)) + mov_mr(r15, off, r11) + jmp_rel32(str_len(fpath))
    mov_rm(rax, r15, off) + test_rr(rax, rax) + je_rel32(str_len(tpath)) + tpath + fpath
}

// x86gen_unit_convert_at 生成 unit→str 转换：()
// x86gen_unit_convert_at emits unit-to-str: ()
