// natives_listfmt.bur — list 格式化。
// natives_listfmt.bur — list format.



// x86gen_list_format_at 生成列表格式化（两遍：先算总长，再写内容）
// x86gen_list_format_at emits list formatting (two passes: total length, then contents)
// List formatting (two passes: total length, then contents). str/int/float elements use
// inline handlers; bool/unit/container elements call the prebuilt elem_code formatter
fn x86gen_list_format_at(off, elem_type, elem_code, ff_h) {
    let mb_al = e1(136) + e1(7)
    let mb = fn(c) {
        e1(198) + e1(7) + sb(c)
    }
    let h1 = mov_rm(r9, r15, off) + mov_rm(r8, r9, 0) + mov_rm(r10, r9, 16) + mov_ri64(rcx, 2) + xor_rr(r11, r11)
    let int1_loop = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
    let int1_loop_jne = jne_rel32(0 - (str_len(int1_loop) + 6))
    let int1 = mov_rr(rax, rdx) + xor_rr(rsi, rsi)
    let int1_add = add_rr(rcx, rsi) + jmp_rel32(0)
    let str1 = mov_rm(rsi, rdx, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
    let e1_load = mov_rr(rax, rcx) + mov_rr(rsi, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + add_rr(rsi, r10) + mov_rm(rdx, rsi, 0) + mov_rr(rcx, rax)
    let sep1_bytes = add_ri32(rcx, 2)
    let sep1 = test_rr(r11, r11) + je_rel32(str_len(sep1_bytes)) + sep1_bytes
    let next1_wo = add_ri32(r11, 1)
    let int1_neg = add_ri32(rcx, 1) + neg_r(rax)
    let int1_head = test_rr(rax, rax) + jge_rel32(str_len(int1_neg))
    let float1 = push_r(r10) + push_r(r9) + push_r(r8) + push_r(r11) + push_r(rcx) + mov_rm(rax, rdx, 0) + vs_push_zero() + vs_push(rax) + mov_rm(rax, r13, 8 * ff_h) + call_r(rax) + mov_rm(rax, r15, 0 - 8) + mov_rm(rsi, rax, 0) + sub_ri32(r15, 8) + pop_r(rcx) + pop_r(r11) + pop_r(r8) + pop_r(r9) + pop_r(r10) + add_rr(rcx, rsi)
    // 非 str/int/float 元素：拷入值栈临时槽，调元素 formatter，读 box 长度
    // non-str/int/float elements: copy into a value-stack temp slot, call the element formatter,
    // read the box length
    let wrap1 = push_r(r8) + push_r(r9) + push_r(r10) + push_r(r11) + push_r(rcx) + vs_push(rdx) + elem_code + mov_rm(rax, r15, 0 - 8) + mov_rm(rsi, rax, 0) + sub_ri32(r15, 8) + pop_r(rcx) + pop_r(r11) + pop_r(r10) + pop_r(r9) + pop_r(r8) + add_rr(rcx, rsi)
    let tail1 = if elem_type == "float" {
        float1
    } else if elem_type == "str" {
        str1
    } else if elem_type == "int" {
        int1 + int1_head + int1_neg + int1_loop + int1_loop_jne + int1_add
    } else {
        wrap1
    }
    let test1 = cmp_rr(r11, r8) + jae_rel32(str_len(sep1) + str_len(e1_load) + str_len(tail1) + str_len(next1_wo) + 5)
    let next1 = next1_wo + jmp_rel32(0 - (str_len(test1) + str_len(sep1) + str_len(e1_load) + str_len(tail1) + str_len(next1_wo) + 5))
    let alloc_zone = mov_rr(r9, r12) + mov_mr(r9, 0, rcx) + lea(rdi, r9, 8) + add_rr(r12, rcx) + add_ri32(r12, 8) + mb(91) + add_ri32(rdi, 1) + xor_rr(r11, r11)
    let int2_loop = xor_rr(rdx, rdx) + mov_ri64(rsi, 10) + idiv_r(rsi) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(rcx, 1) + test_rr(rax, rax)
    let int2_loop_jne = jne_rel32(0 - (str_len(int2_loop) + 6))
    let write2_body = pop_r(rax) + mb_al + add_ri32(rdi, 1) + sub_ri32(rcx, 1) + test_rr(rcx, rcx)
    let write2 = write2_body + jne_rel32(0 - (str_len(write2_body) + 6))
    let int2_zero = mb(48) + add_ri32(rdi, 1) + jmp_rel32(str_len(int2_loop) + str_len(int2_loop_jne) + str_len(write2))
    let int2_neg = mb(45) + add_ri32(rdi, 1) + neg_r(rax)
    let int2_head = test_rr(rax, rax) + jge_rel32(str_len(int2_neg))
    let int2 = mov_rr(rax, rdx) + xor_rr(rcx, rcx) + int2_head + int2_neg + test_rr(rax, rax) + jne_rel32(str_len(int2_zero)) + int2_zero + int2_loop + int2_loop_jne + write2
    let str2 = mb(34) + add_ri32(rdi, 1) + mov_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rm(rcx, rdx, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
    let float2 = push_r(r10) + push_r(r9) + push_r(r8) + push_r(r11) + push_r(rdi) + mov_rm(rax, rdx, 0) + vs_push_zero() + vs_push(rax) + mov_rm(rax, r13, 8 * ff_h) + call_r(rax) + mov_rm(rax, r15, 0 - 8) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + sub_ri32(r15, 8) + pop_r(rdi) + pop_r(r11) + pop_r(r8) + pop_r(r9) + pop_r(r10) + rep_movsb()
    // pass 2 非 str/int/float 元素：写元素 formatter 结果字节
    // pass 2 non-str/int/float elements: write the element formatter result bytes
    let wrap2 = push_r(r8) + push_r(r9) + push_r(r10) + push_r(r11) + push_r(rdi) + vs_push(rdx) + elem_code + mov_rm(rax, r15, 0 - 8) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + sub_ri32(r15, 8) + pop_r(rdi) + pop_r(r11) + pop_r(r10) + pop_r(r9) + pop_r(r8) + rep_movsb()
    let e2_load = mov_rr(rsi, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + add_rr(rsi, r10) + mov_rm(rdx, rsi, 0)
    let sep2_bytes = mb(44) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
    let sep2 = test_rr(r11, r11) + je_rel32(str_len(sep2_bytes)) + sep2_bytes
    let next2_wo = add_ri32(r11, 1)
    let tail2 = if elem_type == "float" {
        float2
    } else if elem_type == "str" {
        str2
    } else if elem_type == "int" {
        int2
    } else {
        wrap2
    }
    let test2 = cmp_rr(r11, r8) + jae_rel32(str_len(sep2) + str_len(e2_load) + str_len(tail2) + str_len(next2_wo) + 5)
    let next2 = next2_wo + jmp_rel32(0 - (str_len(test2) + str_len(sep2) + str_len(e2_load) + str_len(tail2) + str_len(next2_wo) + 5))
    let endfill = mb(93) + add_ri32(rdi, 1) + mov_mr(r15, off, r9)
    h1 + test1 + sep1 + e1_load + tail1 + next1 + alloc_zone + test2 + sep2 + e2_load + tail2 + next2 + endfill
}
