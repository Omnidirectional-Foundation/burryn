// layout.bur — 代码与数据布局：段起点、代码偏移与运行时表定位。
// Code and data layout: segment origins, code offsets and runtime table placement.

// 目标 OS：linux | windows | darwin。main.bur 经 set_target_os 在 build 入口设定；
// syscall()/装配尾据此分叉，ELF 路径字节零变化。
// Target OS: linux | windows | darwin. main.bur sets it via set_target_os at
// entry; syscall()/the assembly tail branch on it, leaving ELF bytes intact.
pub let mut target_os = "linux"

// thunk_slot_abs 是分派器地址槽的绝对地址（runtime 区首字节之后）。
// thunk_slot_abs is the absolute address of the dispatcher-address slot
// (the first byte past the stock runtime area).
pub fn thunk_slot_abs() {
    data_origin() + RUNTIME_SIZE
}

// GC runtime 槽（可写数据段内的固定区，data_origin() 起，每槽 8B）
// GC runtime slots: the fixed region inside the writable data segment (from
// data_origin()), 8 bytes each
pub let rt_gc_cnt = 0
pub let rt_gc_threshold = 8
pub let rt_gc_cycles = 16
pub let rt_gc_last_freed = 24
pub let rt_stack_base = 32
pub let rt_heap_start = 40
// P1：rec 表/gray 栈删除后，rt_gc_recs、rt_gray 等槽退役留位（偏移稳定不重排）；
// rt_gray 槽改挂 exec 排水空闲链头（0 = 空链，镜像零初始化天然成立）。
// P1: with the rec table and gray stack gone, slots like rt_gc_recs/rt_gray are
// retired in place (offsets stay stable); the rt_gray slot now parks exec's
// drain free-list head (0 = empty, which the zero-initialized image provides).
pub let rt_gc_recs = 48
pub let rt_gc_record_fn = 56
pub let rt_gc_collect_fn = 64
pub let rt_mark_addr_fn = 72
pub let rt_gray = 80
pub let rt_cur_fiber = 88
pub let rt_ready_head = 96
pub let rt_ready_tail = 104
pub let rt_main_fiber = 112
pub let rt_fiber_list = 120
pub let rt_waitset_n = 128
pub let rt_timer_n = 136
// P0：堆上界与 PE 提交水位（P1 起供分配 stub 使用）
// P0: the heap limit and the PE commit watermark (consumed by the alloc stub from P1 on)
pub let rt_heap_limit = 144
// P1：descriptor 表与 start bitmap 的运行时基址槽（152 复用原 rt_commit_top 位）。
// P1: runtime base slots for the descriptor table and the start bitmap (152
// reuses the retired rt_commit_top position).
pub let rt_desc_table = 152
pub let rt_start_bitmap = 160
// waitset 每项 16B = pollfd([fd:4][events:2][revents:2]) + [fiber:8]；poll(2) 只认连续 8B 记录，
// 故 poll 前把各条目前 8B 拷入 POLLFD_BASE 暂存区，返回后把 revents 回写条目 +6
// waitset entries are 16B = pollfd([fd:4][events:2][revents:2]) + [fiber:8]; poll(2) consumes
// contiguous 8B records, so each entry's leading 8B is staged into POLLFD_BASE before polling,
// and revents is written back to entry+6 afterwards
pub let WAITSET_CAP = 64
pub let TIMER_CAP = 64
// timer 每项 16B = [deadline_ns:8][fiber:8]
// timer entries are 16B = [deadline_ns:8][fiber:8]
pub let WAITSET_BASE = 176
// POLLFD_BASE/TIMER_BASE/RUNTIME_SIZE 是包级字面量（编译器限制：包级 let 只允许字面量算术），
// 依赖 WAITSET_CAP/TIMER_CAP=64：TIMER_BASE = 176 + 64*16 = 1200、
// POLLFD_BASE = TIMER_BASE + TIMER_CAP * 16 = 2224；
// RUNTIME_SIZE = 128 + 16 + 32 + 64*16 + 64*16 + 64*8 = 2736
// POLLFD_BASE/TIMER_BASE/RUNTIME_SIZE are package-level literals (the compiler restricts
// package lets to literal arithmetic); they depend on WAITSET_CAP/TIMER_CAP=64:
// TIMER_BASE = 144 + 64*16 = 1168, POLLFD_BASE = TIMER_BASE + TIMER_CAP * 16 = 2192;
pub let TIMER_BASE = 1200
pub let POLLFD_BASE = 2224
pub let RUNTIME_SIZE = 2736
// P1：rec 表与 gray 栈的容量常量（rec 项 24B）随 rec 表删除退役，仅留字面量占位。
// P1: the rec table's/gray stack's capacity constants (24B per rec entry) are
// retired along with the rec table; kept as literals only.
pub let GC_RECS_CAP = 65536
pub let GC_GRAY_CAP = 65536
pub let GC_INIT_THRESHOLD = 256
// P0：x86 堆预留（任务书 §3.6）与 PE 提交粒度；Linux 的 mmap flags 加 MAP_NORESERVE
// P0: the x86 heap reserve (task brief §3.6) and the PE commit granularity; Linux's mmap
// flags add MAP_NORESERVE
pub let X86GC_RESERVE = 1073741824
// P1：start bitmap 每 8B granule 一**字节**（bit0 = 块起点），垫在堆区之前。
// 对任务书「每 8B 一位」的空间换指令偏离：1B/granule 让站点置位只发一条
// or byte [base+idx]（1-bit 要拆位多两条且挤第三个寄存器），128MB 的
// NORESERVE 映射不值钱，P3 sweep 还能按字节快跳零段。
// P1: the start bitmap keeps one BYTE per 8-byte granule (bit0 = block start)
// and pads in front of the heap. Space-for-instructions deviation from the
// brief's one-bit-per-8B: 1B/granule turns the per-site set into a single
// "or byte [base+idx]" (1-bit needs two extra split instructions and a third
// register), the 128MB NORESERVE mapping is cheap, and P3's sweep can skip
// zero runs byte-wise.
pub let X86GC_BITMAP_SIZE = 134217728
pub let X86GC_MMAP_FLAGS = 16418

// fiber struct 堆布局（80B）/ fiber struct heap layout (80 bytes)
pub let FB_STATUS = 0
pub let FB_BUDGET = 8
pub let FB_STACK_LO = 16
pub let FB_RSP = 24
pub let FB_RBP = 32
pub let FB_R14 = 40
pub let FB_R15 = 48
pub let FB_READY_NEXT = 56
pub let FB_LIST_NEXT = 64
// FB_LIMIT：序言处 rsp 的下限，低于即调用深度超过 DEPTH_MAX（见 x86gen_prologue）
// FB_LIMIT: the prologue's rsp floor; going below it means the call depth
// exceeds DEPTH_MAX (see x86gen_prologue)
pub let FB_LIMIT = 72
pub let FB_SIZE = 80
// DEPTH_MAX 是每 fiber 的函数调用深度上限（与 C/VM 同为 2048，fiber 入口帧不计）；
// 用户函数帧恒占 24B 原生栈（返回地址 + 保存的 rbp + defer 槽）
// DEPTH_MAX is the per-fiber call-depth cap (2048, as in C/VM; the fiber's
// entry frame does not count); a user frame always takes 24B of native
// stack (return address + saved rbp + defer slot)
pub let DEPTH_MAX = 2048
pub let FRAME_BYTES = 24
// fiber 状态 / fiber statuses
pub let FB_READY = 0
pub let FB_BLOCKED_SEND = 1
pub let FB_BLOCKED_RECV = 2
pub let FB_BLOCKED_SELECT = 3
pub let FB_DONE = 4
pub let FB_BLOCKED_FD = 5
pub let FB_BLOCKED_TIMER = 6
// 每 fiber 独立栈：1MiB + 4KiB guard page（对齐 C runtime BUR_STACK_SIZE）
// per-fiber stack: 1MiB plus a 4KiB guard page (matches C runtime BUR_STACK_SIZE)
pub let FIBER_STACK_SIZE = 1048576
pub let BUDGET_SLICE = 10000
// channel struct 堆布局（112B，OChannel 去 Obj 头）/ channel struct heap layout (112 bytes,
// OChannel minus the Obj header)
pub let CH_CAP = 0
pub let CH_BUF = 8
pub let CH_BUFLEN = 16
pub let CH_BUFCAP = 24
pub let CH_SENDQ = 32
pub let CH_NSENDQ = 40
pub let CH_SENDQCAP = 48
pub let CH_RECVQ = 56
pub let CH_NRECVQ = 64
pub let CH_RECVQCAP = 72
pub let CH_WAITERS = 80
pub let CH_NWAIT = 88
pub let CH_WAITCAP = 96
pub let CH_CLOSED = 104
pub let CH_SIZE = 112
// 队列数组倍增系数：len==cap 时 newcap = cap*2 + QUEUE_GROW_ADD
// queue-array growth: newcap = cap*2 + QUEUE_GROW_ADD when len == cap
pub let QUEUE_GROW_ADD = 4

// rt_slot 返回 runtime 槽的绝对地址
// rt_slot returns a runtime slot's absolute address
pub fn rt_slot(off) {
    data_origin() + off
}

// DATA_VA_OFF 是三目标统一的可写数据段固定偏移：与代码尺寸解耦，使 rt_slot 等
// 地址公式在代码长度确定前即可求值；代码段与数据段之间留未映射 VA 空洞。
// DATA_VA_OFF is the three targets' shared writable-data segment's fixed offset
// from the image base, decoupled from the code size so address formulas like
// rt_slot resolve before the code length is known; an unmapped VA hole sits
// between the code and data segments.
pub let DATA_VA_OFF = 16777216

// code_origin 返回代码/常量内容的绝对起点：三目标的 runtime 区都已迁出代码域，
// 常量紧跟各自的头区。
// code_origin returns the absolute start of code/constants content: all three
// targets keep the runtime area out of the code domain, so constants follow
// the headers directly.
pub fn code_origin() {
    img_base()
}

// data_origin 返回可写 runtime 区的绝对基址：三目标一致落在镜像基址加
// DATA_VA_OFF 的独立可写段（ELF 第二条 PT_LOAD、PE .data、Mach-O __DATA）。
// data_origin returns the writable runtime area's absolute base: all three
// targets place it in the standalone writable segment at the image base plus
// DATA_VA_OFF (ELF's second PT_LOAD, PE's .data, Mach-O's __DATA).
pub fn data_origin() {
    if target_os == "darwin" {
        macho_base + DATA_VA_OFF + addr_shift
    } else {
        base_addr + DATA_VA_OFF + addr_shift
    }
}

pub fn set_target_os(os) {
    target_os = os
}

// get_target_os 跨模块只读访问目标（cli 在注入 dns_rt 时按目标分流）
// get_target_os is the cross-module read view of the target (cli branches the
// dns_rt injection on it)
pub fn get_target_os() {
    target_os
}

// img_base 返回代码/常量域的绝对基址：ELF 在 base+176（64B 头 + 两条 phdr，即
// ELF_CODE_OFF）；PE 头区占满首个 RVA 页，内容从 base+4096 起；Mach-O 的
// __TEXT 内容从 base+0x1000 起。所有绝对地址编码经此收口。
// img_base returns the absolute base of the code/constants domain: ELF sits at
// base+176 (64-byte header plus two program headers, ELF_CODE_OFF); PE headers
// fill the first RVA page, so content starts at base+4096; Mach-O __TEXT
// content starts at base+0x1000. Every absolute encoding funnels through here.
pub fn img_base() {
    if target_os == "windows" {
        base_addr + 4096 + addr_shift
    } else if target_os == "darwin" {
        macho_base + MACHO_TEXT_OFF + addr_shift
    } else {
        base_addr + ELF_CODE_OFF + addr_shift
    }
}

// fd 表：Windows 独有尾区（thunk 槽之后），FD_CAP 项 × 16B [handle:8][kind:8]。
// kind: -1 空闲 / 0 文件管道控制台 / 1 socket（P4 用，P3 只写不读）。
// fd table: a Windows-only tail region past the thunk slot, FD_CAP entries of
// [handle:8][kind:8]. kind: -1 free / 0 file-pipe-console / 1 socket (P4 reads it).
pub let FD_CAP = 1024
pub let FD_ENTRY = 16

// fd_base 返回 fd 表绝对基址（仅 windows 有意义，其余目标不调用）。
// fd_base returns the fd table's absolute base (meaningful on windows only;
// other targets never call it).
pub fn fd_base() {
    data_origin() + RUNTIME_SIZE + 8
}

// WSA 区：Windows 独有尾区（fd 表之后），[init:8][wsadata:400][poll 暂存:768]。
// init 0 表未调过 WSAStartup；wsadata 为 WSAStartup 的 400B 写区；poll 暂存放
// 64 条 WSAPOLLFD（16B：SOCKET 对齐撑大，SOCKET:8 + events:2 + revents:2），供 poll nfds>0 臂。
// WSA area: a Windows-only tail past the fd table holding [init:8][wsadata:400]
// plus 768B of poll staging for 64 WSAPOLLFD records (12B each: SOCKET:8 +
// events:2 + revents:2) consumed by the poll nfds>0 arm. init zero means
// WSAStartup has not run yet
pub let WSA_ONCE = 0
pub let WSA_DATA = 8
pub let WSA_DATA_LEN = 400
pub let WSA_POLL = 408
pub let WSA_POLL_ENTRY = 16
pub let WSA_REGION_LEN = 1432

// wsa_base 返回 WSA 区绝对基址（仅 windows 有意义）。
// wsa_base returns the WSA area's absolute base (meaningful on windows only).
pub fn wsa_base() {
    fd_base() + FD_CAP * FD_ENTRY
}
