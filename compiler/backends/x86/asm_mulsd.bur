// asm_mulsd.bur — mul/div sd。
// asm_mulsd.bur — mul/div sd.



// mulsd xmm<xdst>, xmm<xsrc>：double 乘 / mulsd: double multiply
pub fn mulsd_xmm(xdst, xsrc) {
    e1(242) + rex(0, xdst, 0, xsrc) + e1(15) + e1(89) + modrm(3, xdst, xsrc)
}

// divsd xmm<xdst>, xmm<xsrc>：double 除 / divsd: double divide
pub fn divsd_xmm(xdst, xsrc) {
    e1(242) + rex(0, xdst, 0, xsrc) + e1(15) + e1(94) + modrm(3, xdst, xsrc)
}
