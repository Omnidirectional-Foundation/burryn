// gc.bur — P1 精确 GC 的分配前端：块头 / descriptor 表 / start bitmap 的发射期生成器。
// gc.bur — the P1 precise-GC allocation front end: emission-time generators for the
// block header, the descriptor table and the start bitmap.

// 块布局：[hdr:8][payload]。用户拿到的指针恒为 payload 起点（hdr 落在 ptr-8），
// 因此全部既有字段偏移（串 [len][bytes]、record [tag][x][fields]、fiber/channel
// 结构体……）零改动；hdr 属于块本身，precise 扫描按 ptr-8 回溯块头。
// Block layout: [hdr:8][payload]. The pointer handed to users is always the
// payload start (the hdr sits at ptr-8), so every existing field offset (str
// [len][bytes], record [tag][x][fields], fiber/channel structs, ...) is
// untouched; the hdr belongs to the block itself and precise scans back up a
// pointer through ptr-8.
// hdr 64 位 = payload 字节数（8 的倍数，低 40 位）| desc_id（desc 表内字节偏移，
// 40..61）| MARK 位 62 | FREE 位 63。P1 分配恒 MARK/FREE 清零；P1 不回收，
// payload 无需清零（bump 区原生零页）。
// The 64-bit hdr = payload byte count (a multiple of 8, low 40 bits) |
// desc_id (byte offset into the desc table, bits 40..61) | MARK bit 62 |
// FREE bit 63. P1 always allocates with MARK/FREE clear and never collects,
// so payloads need no zeroing (the bump region is fresh zero pages).
// start bitmap：每 8B granule 一**字节**（bit0 = 块起点；对任务书「每 8B 一位」
// 的空间换指令偏离——1B/granule 让站点置位只需一条 or byte [base+idx]，
// 128MB NORESERVE 映射不值钱，且 P3 sweep 可按字节快速跳过零段）。
// Start bitmap: one BYTE per 8-byte granule (bit0 = block start; a
// space-for-instructions deviation from the brief's one-bit-per-8B — 1B per
// granule makes the per-site set a single "or byte [base+idx]", the 128MB
// NORESERVE mapping is cheap, and P3's sweep can skip zero runs byte-wise).
// 块起点恒 8 对齐：r12 起点 8 对齐（heap_start 由 _start 在 globals 前导区后
// 盖章），每个块 bump = 8 + payload（payload 圆整到 8）。
// Block starts stay 8-aligned: r12 starts aligned (heap_start is stamped by
// _start after the globals preamble) and every bump = 8 + payload (payload
// rounded up to 8).

// desc kind：NOSCAN 无指针 / ALL_PTR 全词皆指针 / ALL_MAYBE 全词 MAYBE 扫描 /
// BITMAP 位图描述 / PREFIX 头部标量词跳过 + 尾部按单一 kind 扫。P2 批 4 逐类精化。
// desc kinds: NOSCAN no pointers / ALL_PTR every word a pointer / ALL_MAYBE
// speculative whole-word scan / BITMAP per-field bitmap / PREFIX skip head
// scalar words then scan the tail at a single kind. P2 batch 4 refines per type.
pub let GC_KIND_NOSCAN = 0
pub let GC_KIND_ALL_PTR = 1
pub let GC_KIND_ALL_MAYBE = 2
pub let GC_KIND_BITMAP = 3
pub let GC_KIND_PREFIX = 4
// P1 的全站占位 desc_id = 0。注意：它实际是 **NOSCAN**——desc_reset 的首个注册
// 条目是 noscan（P1 注释曾许诺 ALL_MAYBE，从未兑现，值栈影子掩盖到 P3）。GC_DESC_ALL
// 因此只准用于**确保无指针载荷**的对象（str/float box/格式化缓冲等）；凡可能持指针
// 的容器必须挂显式 desc（bitmap_desc 逐形 / desc_allptr / desc_list 家族），P3 批 3
// 修过 record/enum 实例/提升 cell/map keys/vals 数组/chan 缓冲五处挂错。
// P1's site-wide placeholder desc_id = 0. Note: it is really **NOSCAN** —
// desc_reset's first registered entry is noscan (the P1 comment promised
// ALL_MAYBE and never delivered; value-stack shadows masked that until P3).
// GC_DESC_ALL is therefore only for payloads guaranteed pointer-free (str/float
// boxes/format buffers); any container that may hold pointers needs an explicit
// desc (bitmap_desc per shape / desc_allptr / the desc_list family). P3 batch 3
// fixed five mis-users: record/enum instances, lift cells, map keys/vals arrays,
// chan buffers.
pub let GC_DESC_ALL = 0
// desc 表 = 静态/按需条目 + GC_DESC_POOL 零垫，总长发射期定值（GC_DESC_TABLE_LEN，
// desc_reset 定值）。定长的原因：表挂 const_data，而条目在装配遍中才注册齐——
// x86gen_image 逐遍把最新表字节拼接回 const_data 尾段，probe/real 两遍拼到同一份
// 最终字节（预热遍后注册即收敛），pic_data 逐字节必等；垫底零字节 = NOSCAN，
// 野读安全；位图容量公式（表长 - desc_id）也随之有界。
// the desc table = registered entries + a GC_DESC_POOL zero pad, its total
// length fixed at emission (GC_DESC_TABLE_LEN, set by desc_reset). Fixed length
// because the table rides const_data while entries only finish registering
// during the assembly passes — x86gen_image splices the latest table bytes back
// into const_data's tail every pass, so probe and real splice the same final
// bytes (registration converges after the warmup pass) and pic_data matches
// byte for byte; the zero pad reads as NOSCAN, safe for stray reads, and the
// bitmap-capacity formula (table length - desc_id) stays bounded.
pub let GC_DESC_POOL = 4096
pub let mut GC_DESC_TABLE_LEN = 8
// 2^40：hdr 内 desc 字段的位权 / 2^40: the desc field's bit weight in the hdr
pub let GC_DESC_SHIFT = 1099511627776
// hdr desc 字段宽 22 位（2^22−1）：hdr = [size:34][scanned:1][rsvd:5][desc:22]
// [flags:2]，verify 读 desc 前先掩掉标志位，位 34/62/63 置位时 desc 不得误报
// 越界（>>40 后三者全部落出 22 位窗外）
// the hdr desc field is 22 bits wide (2^22-1): hdr = [size:34][scanned:1]
// [rsvd:5][desc:22][flags:2]; verify masks the flag bits before reading desc so
// set flags never misreport an out-of-table desc id (after >>40 all three fall
// outside the 22-bit window)
pub let GC_DESC_MASK = 4194303

// desc 注册表：keys/ids 平行 list（包级 let 只许字面量，map() 进不来；异构对
// [str,int] 过不了同型检查；条目量 ~30 线性查无碍）。desc_pool 持全部条目字节
// （静态条目也入池），每程序 desc_reset 清零后按确定序重注册 → 两遍装配的 id
// 完全一致。
// the desc registry: parallel keys/ids lists (package-level lets only take
// literals so map() is out, and a heterogeneous [str,int] pair fails the
// same-type check; ~30 entries make linear scans fine). desc_pool holds every
// entry's bytes (static ones included); desc_reset clears per program and
// re-registers in a deterministic order, so both assembly passes see identical
// ids.
pub let mut desc_keys = []
pub let mut desc_ids = []
pub let mut desc_pool = []
pub let mut desc_noscan = 0
pub let mut desc_allptr = 0
pub let mut desc_cell = 0
pub let mut desc_lenptrs = 0
pub let mut desc_caplenptrs = 0
pub let mut desc_list_scalar = 0
pub let mut desc_list_ptr = 0
pub let mut desc_list_maybe = 0
pub let mut desc_chan = 0
pub let mut desc_map = 0
pub let mut desc_fb = 0
pub let mut desc_sb = 0
pub let mut desc_box_ptr = 0

fn desc_register(key: str, bytes: [int]) -> int {
    let mut found = 0 - 1
    let mut i = 0
    while i < len(desc_keys) {
        if desc_keys[i] == key {
            found = desc_ids[i]
        }
        i = i + 1
    }
    if found >= 0 {
        found
    } else {
        let id = len(desc_pool)
        let mut k = 0
        while k < len(bytes) {
            push(desc_pool, bytes[k])
            k = k + 1
        }
        push(desc_keys, key)
        push(desc_ids, id)
        id
    }
}

// desc_reset 每程序清注册表并按确定序预注册全部静态形：
// NOSCAN / ALL_PTR / cell·closure=PREFIX(0,PTR) / [len][ptrs]=PREFIX(1,PTR) /
// [cap][len][ptrs]=PREFIX(2,PTR) / list=PREFIX(3,SCALAR|PTR|MAYBE)（头 3 词
// len/cap/衍生 data 指针不扫，尾元素区按元素 kind）/ chan=BITMAP 位 1/4/7/10
// （buf/sendq/recvq/waiters）/ map=BITMAP 位 2/3（keys/vals）/ fb=BITMAP 位 7/8
// （READY_NEXT/LIST_NEXT）/ sb builder=BITMAP 位 2 / [tag][x][ptr]=BITMAP 位 2
//（Result/Option 盒，载荷为指针时）。
// desc_reset clears the registry per program and pre-registers every static
// shape in a deterministic order (see the Chinese comment for the shapes).
pub fn desc_reset() {
    desc_keys = []
    desc_ids = []
    desc_pool = []
    desc_noscan = desc_register("noscan", [0])
    desc_allptr = desc_register("allptr", [1])
    desc_cell = desc_register("cell", [4, 0, 1])
    desc_lenptrs = desc_register("lenptrs", [4, 1, 1])
    desc_caplenptrs = desc_register("caplenptrs", [4, 2, 1])
    desc_list_scalar = desc_register("list-s", [4, 3, 0])
    desc_list_ptr = desc_register("list-p", [4, 3, 1])
    desc_list_maybe = desc_register("list-m", [4, 3, 2])
    // chan 14 词，位 1/4/7/10 = buf/sendq/recvq/waiters：byte0 = 2|16|128 = 146，
    // byte1 = 位10 = 4。位图字节紧随 kind 字节（收集器从 desc+1 顺序读），无计数字节
    // chan is 14 words; bits 1/4/7/10 = buf/sendq/recvq/waiters: byte0 =
    // 2|16|128 = 146, byte1 = bit10 = 4. Bitmap bytes follow the kind byte
    // directly (the collector reads them sequentially from desc+1, no count byte)
    desc_chan = desc_register("chan", [3, 146, 4])
    // map 4 词，位 2/3 = keys/vals
    // map is 4 words; bits 2/3 = keys/vals
    desc_map = desc_register("map", [3, 12])
    // fb 11 词，位 7/8 = READY_NEXT/LIST_NEXT：byte0 = 128（位7），byte1 = 1（位8）
    //——byte1 写 64 会指向词 14（fb 只有 11 词，LIST_NEXT 从此漏标）
    // fb is 11 words; bits 7/8 = READY_NEXT/LIST_NEXT: byte0 = 128 (bit7),
    // byte1 = 1 (bit8) — a byte1 of 64 points at word 14 (fb is 11 words, so
    // LIST_NEXT would never be marked)
    desc_fb = desc_register("fb", [3, 128, 1])
    // sb builder 88B，位 2 = buf 指针
    // the sb builder is 88B; bit 2 = the buf pointer
    desc_sb = desc_register("sb", [3, 4])
    // Result/Option 盒 [tag][x][payload]，载荷为指针时位 2 可扫
    // a Result/Option box [tag][x][payload]; bit 2 scannable when the payload
    // is a pointer
    desc_box_ptr = desc_register("box-p", [3, 4])
    GC_DESC_TABLE_LEN = len(desc_pool) + GC_DESC_POOL
}

// desc_list 按元素影子 kind 选 list 的 PREFIX 尾 kind。
// desc_list picks the list PREFIX tail kind from the element's shadow kind.
pub fn desc_list(k) {
    if k == GC_SHADOW_PTR {
        desc_list_ptr
    } else if k == GC_SHADOW_SCALAR {
        desc_list_scalar
    } else {
        desc_list_maybe
    }
}

// bitmap_desc 按形态注册 BITMAP desc（key 去重，两遍发射同序注册 pic_data 必等）：
// 前 skip 词不扫，其后每词一律置位——位由静态类型折 SCALAR 收缩会在模型漂移时
// 漏扫指针载荷（与根扫描同因，见 gc_vs 注释）：mark 的三重过滤使多扫一个标量
// 无害，漏扫一个指针即悬垂，故载荷区宁全扫。types 只定宽度。
// bitmap_desc registers a per-shape BITMAP desc (deduped by key; both emission
// passes register in the same order so pic_data matches byte for byte): the
// leading `skip` words stay unscanned and every later word gets its bit — no
// SCALAR fold, which under a drifting type model drops pointer payloads from
// the scan (same cause as the root scan, see the gc_vs note): mark's three
// gates make over-scanning a scalar harmless while missing one pointer
// dangles, so the payload area is scanned whole. `types` only fixes the width.
pub fn bitmap_desc(key, skip, types) {
    let words = skip + len(types)
    let mut bits = []
    let mut bz = 0
    while bz < (words + 7) / 8 {
        push(bits, 0)
        bz = bz + 1
    }
    let mut bi = 0
    let mut byte_i = 0
    let mut mask = 1
    while bi < words {
        if bi >= skip {
            bits[byte_i] = bits[byte_i] + mask
        }
        mask = mask + mask
        if mask == 256 {
            mask = 1
            byte_i = byte_i + 1
        }
        bi = bi + 1
    }
    let mut entry = []
    push(entry, 3)
    let mut ez = 0
    while ez < len(bits) {
        push(entry, bits[ez])
        ez = ez + 1
    }
    let rid = desc_register(key, entry)
    rid
}

// gc_desc_image 拼当前注册态的表镜像：条目字节 + 零垫到 GC_DESC_TABLE_LEN。
// P3 批 2：两处发射 bug 连修——
// ① e8 改 e1：e8 是 8 字节编码器，每条目字节实写 8 字节 [v 00×7]，镜像膨胀
// 8 倍（4128 -> 32760），splice 保留窗与 rt_init 的表址都按 GC_DESC_TABLE_LEN
// 算——运行时 desc 表窗口全落零垫，每个条目读出 kind 0=NOSCAN，gc_pw 的载荷
// 走查从未进过任何块（x86 的标记传播只到根对象本身）。
// ② 垫零边界 GC_DESC_POOL 改 GC_DESC_TABLE_LEN：镜像长度 = 池字节 + 垫到
// TABLE_LEN；旧边界让镜像恒短 len(desc_pool)（本程序 32 字节），splice 后
// 表窗口相对镜像错位 32——条目 id（desc_pool 字节偏移）与 [表址+id] 寻址
// 对不上，list 的 [4,3,2] 读成别的字节，数组/元素照样整链死亡（gc_stress
// 的 kept[0] 串被链节点覆盖成空串，watchpoint 实锤）。表长恒为
// GC_DESC_TABLE_LEN，三遍发射的 pic_data 才逐字节相等。
// gc_desc_image assembles the table image for the current registration state:
// entry bytes plus zero padding up to GC_DESC_TABLE_LEN.
// P3 batch 2: two emission bugs fixed in tandem —
// (1) e8 -> e1: e8 is the 8-byte encoder, so each entry byte wrote 8 bytes
// ([v 00*7]) and the image grew 8x (4128 -> 32760) while the splice's
// preserved window and rt_init's table address both assume GC_DESC_TABLE_LEN —
// the runtime's desc-table window fell entirely in the zero pad, every entry
// read kind 0=NOSCAN, and gc_pw's payload walk never entered any block (x86
// mark propagation stopped at the root objects themselves).
// (2) the pad bound GC_DESC_POOL -> GC_DESC_TABLE_LEN: the image length is
// pool bytes + padding up to TABLE_LEN; the old bound left the image
// len(desc_pool) (32 bytes here) short, so the spliced window sat 32 bytes
// off the image — the entry ids (desc_pool byte offsets) no longer matched
// the [table + id] addressing, the list's [4,3,2] read as other bytes, and
// arrays/elements still died wholesale (gc_stress's kept[0] string
// overwritten by a chain node into an empty string — watchpoint-confirmed).
// A fixed GC_DESC_TABLE_LEN also keeps the three emission passes'
// pic_data byte-identical.
pub fn gc_desc_image() {
    let mut out = ""
    let mut i = 0
    while i < len(desc_pool) {
        out = out + e1(desc_pool[i])
        i = i + 1
    }
    while i < GC_DESC_TABLE_LEN {
        out = out + e1(0)
        i = i + 1
    }
    out
}

// gc_scratch1/gc_scratch2 选分配序列的两枚 scratch 寄存器：默认 rcx/rdx，
// 与 dst 冲突时换 rsi（push/pop 全保护，选谁都不破坏现场）。
// gc_scratch1/gc_scratch2 pick the alloc sequence's two scratch registers:
// rcx/rdx by default, rsi on a dst collision (everything is push/pop saved, so
// any choice preserves the surroundings).
fn gc_scratch1(dst) {
    if dst == rcx {
        rdx
    } else if dst == rdx {
        rcx
    } else {
        rcx
    }
}

fn gc_scratch2(dst) {
    if dst == rcx {
        rsi
    } else if dst == rdx {
        rsi
    } else {
        rdx
    }
}

// gc_oom_die 生成越界 die 调用（push/pop rax 保护现场；oom_die_g 为发射期
// 全局，funcs 头部定址——与 P0 x86gen_oom_check 同款）。
// gc_oom_die emits the over-limit die call (push/pop rax preserves the
// surroundings; oom_die_g is the emission-time global addressed at funcs' head
// — same pattern as P0's x86gen_oom_check).
fn gc_oom_die() {
    push_r(rax) + mov_ri64(rax, oom_die_g) + call_r(rax) + pop_r(rax)
}

// gc_bitmap_set 生成 start-bit 置位：granule = (hdr_addr - rt_heap_start) >> 3，
// 字节地址 = rt_start_bitmap + granule，or byte [base+idx], 1。
// s1 = 基址寄存器（承载 bitmap 基址），s2 = 索引寄存器（承载 granule 号）；
// ModRM=00 /1 100(SIB)，SIB = s2:8+s1，无 REX（两组寄存器均 <8 且非 rsp 系）。
// gc_bitmap_set emits the start-bit set: granule = (hdr_addr - rt_heap_start)
// >> 3, byte address = rt_start_bitmap + granule, "or byte [base+idx], 1".
// s1 = the base register (bitmap base), s2 = the index register (granule
// number); ModRM = 00 /1 100(SIB), SIB = s2:8+s1, no REX (both groups are <8
// and outside the rsp encoding).
fn gc_bitmap_set(s1, s2) {
    e1(128) + e1(12) + e1(s2 * 8 + s1) + sb(1)
}

// gc_cap_round 把请求尺寸（8 倍数）取成块 cap：≤64 精确，>64 取 2 的幂。幂档
// 让 sweep 链入的块与之后同档请求一一对上（见 layout.bur 的类头注释）。
// gc_cap_round turns the requested size (a multiple of 8) into the block cap:
// exact up to 64, a power of two above. The power rung makes every swept block
// line up with the later requests of the same rung (see the class-head comment
// in layout.bur).
fn gc_cap_round(sz) {
    if sz <= 8 {
        8
    } else if sz <= 16 {
        16
    } else if sz <= 32 {
        32
    } else if sz <= 64 {
        64
    } else {
        let mut cap = 128
        while cap < sz {
            cap = cap * 2
        }
        cap
    }
}

// gc_class_slot 按 cap 给出类头槽偏移（rt_slot 的入参）：≤64 用精确类，>64 用
// 幂档数组。cap 必须已过 gc_cap_round。
// gc_class_slot returns the class-head slot offset (the rt_slot argument): the
// exact classes up to 64, the power-of-two array above. cap must have gone
// through gc_cap_round.
fn gc_class_slot(cap) {
    if cap <= 8 {
        rt_free8
    } else if cap <= 16 {
        rt_free16
    } else if cap <= 32 {
        rt_free32
    } else if cap <= 64 {
        rt_free64
    } else {
        let mut e = 7
        let mut c = 128
        while c < cap {
            c = c * 2
            e = e + 1
        }
        rt_free_class_base + (e - 7) * 8
    }
}

// x86gen_alloc 立即数尺寸分配（size = payload 字节数，发射期圆整到 8、再按
// gc_cap_round 取块 cap）：dst = r12+8（payload 起点）→ r12 += cap+8 → 限界检查
//（越界先回滚 + collect + 重查类链头，仍空进 oom_die）→ [dst-8] = cap|desc<<40
// → bitmap 置 start 位。
// 寄存器代价：毁 s1/s2（push/pop 保护）与 r12；写 dst；rax 仅 die/fail 路径触碰
//（亦保护）。FLAGS 被破坏——与旧内联 bump（add 亦毁 FLAGS）同级，站点内
// test→je 相邻对不受影响（分配序列插在原 bump 位置）。
// x86gen_alloc immediate-size allocation (size = payload bytes, rounded to 8 at
// emission and then to the block cap by gc_cap_round): dst = r12+8 (payload
// start) -> r12 += cap+8 -> bound check (past the limit rolls back, collects
// and rechecks the class head; oom_die only when it stays empty) ->
// [dst-8] = cap|desc<<40 -> set the start bit. Register cost: clobbers s1/s2
// (push/pop saved) and r12; writes dst; rax only touched on the die/fail paths
// (also saved). FLAGS are clobbered — same class as the old inline bump (add
// clobbers FLAGS too); adjacent test->je pairs inside sites are unaffected (the
// sequence goes where the bump was).
fn x86gen_alloc(dst, size, desc) {
    let sz = (size + 7) / 8 * 8
    let cap = gc_cap_round(sz)
    let s1 = gc_scratch1(dst)
    let s2 = gc_scratch2(dst)
    let die = gc_oom_die()
    let hdr_bump = mov_ri64(s1, cap + desc * GC_DESC_SHIFT) + mov_mr(dst, 0 - 8, s1)
    // 复用路径 hdr = 原块 cap（非请求尺寸）：hdr 链下一块 = hdr + 8 + size，写小
    // 了走查会切进本块内部。cap 由 sweep 写在节点 [payload+8]。
    // the reuse path's hdr = the block's original cap (not the requested size):
    // the hdr chain's next block sits at hdr + 8 + size, so writing the smaller
    // request would make the walk cut into this block. The sweep stores cap at
    // node [payload+8].
    let hdr_reuse = if desc != 0 {
        mov_ri64(s1, desc * GC_DESC_SHIFT) + or_rr(s2, s1) + mov_mr(dst, 0 - 8, s2)
    } else {
        mov_mr(dst, 0 - 8, s2)
    }
    let bits = mov_rr(s2, dst) + sub_ri32(s2, 8) + mov_ri64(s1, rt_slot(rt_heap_start)) + mov_rm(s1, s1, 0) + sub_rr(s2, s1) + shr_ri(s2, 3) + mov_ri64(s1, rt_slot(rt_start_bitmap)) + mov_rm(s1, s1, 0) + gc_bitmap_set(s1, s2)
    // --gc-stress：切块前先同步 collect（收集器全寄存器自保，rax 再 push/pop 双保
    // 险）；非 stress 换成阈值钩子——r12 ≥ rt_gc_threshold 即同步 collect，同样挂
    // 在切块前（新块尚不存在，无 born-unmarked 窗口），collect 尾按堆跨度几何式
    // 抬升阈值。stress 下每次 alloc 都 collect，阈值钩子被吸收不发。
    // --gc-stress: collect right before every bump (the collector saves all
    // registers itself; the rax push/pop is belt and suspenders). Non-stress
    // swaps in the threshold hook — collect synchronously once r12 reaches
    // rt_gc_threshold, also before the block exists (no born-unmarked window);
    // the collect tail raises the threshold geometrically with the heap span.
    // Under stress every alloc collects anyway, so the threshold hook is absorbed.
    let hook = if gc_stress_g {
        push_r(rax) + mov_ri64(rax, gc_collect_g) + call_r(rax) + pop_r(rax)
    } else {
        push_r(rax) + mov_ri64(rax, rt_slot(rt_gc_threshold)) + mov_rm(rax, rax, 0) + cmp_rr(rax, r12) + ja_rel32(str_len(mov_ri64(rax, gc_collect_g)) + str_len(call_r(rax))) + mov_ri64(rax, gc_collect_g) + call_r(rax) + pop_r(rax)
    }
    // P3 尺寸类自由链复用：sweep 把死块按 cap 链入 8/16/32/64 精确类与 >64 的
    // 2 的幂档；分配端按请求 cap 选类（立即数版发射期即常量）后查该类链头，
    // cap ≥ sz 即摘头复用，否则照旧 bump。幂档内块 cap 恒等于档值，链头必命中：
    // `substr`/拼接 churn 的尺寸逐次微增也不会像旧 big 单链那样整窗落空。8B 类
    // 的节点只放 [next] 一个字（cap 由类隐含为 8），是唯一不需要 cap 比较的一档。
    // P3 size-class free-list reuse: the sweep chains dead blocks into the exact
    // 8/16/32/64 classes and the power-of-two rungs above 64; the alloc side
    // picks the class by the request cap (an emission-time constant for
    // immediate-size sites) and checks that class's head, popping when cap >= sz,
    // else bumping as before. Within a rung every block's cap equals the rung, so
    // the head always hits: the substr/concat churn's slowly growing sizes no
    // longer miss a whole window as they did with the old single big head. The
    // 8B class stores just the [next] word (the class implies cap 8), the only
    // rung without a cap compare.
    let cls = gc_class_slot(cap)
    let next_ld = mov_rm(dst, s1, 0)
    // head_pop 的槽址走 s2（头加载前装入、贯穿复用段不毁）：旧版把槽址装 rax
    // 再写 [rax]=dst——dst==rax 的站点（str 系，实测）mov_ri64(rax,&slot) 先毁
    // 掉 rax 里的 next，[rax]=rax 把槽址自己写进链头=链头自指，后续分配
    // 把槽当块、cap 读到 .eh_frame 文本、hdr 写穿类头槽。
    // head_pop keeps the slot address in s2 (loaded before the head load, alive
    // across the reuse stretch): the old cut parked it in rax and stored
    // [rax]=dst — at dst==rax sites (the str family, observed) mov_ri64(rax,&slot)
    // destroyed the next sitting in rax, so [rax]=rax wrote the slot's own
    // address into the head: the next allocation took the slot for a block, read
    // .eh_frame text as its cap and wrote hdrs through the class heads.
    let head_pop = mov_mr(s2, 0, dst)
    let dst_set = mov_rr(dst, s1)
    let cap_ld = mov_rm(s2, dst, 8)
    // bump 拆成 pre/ja/fail 三段 + 失败保底 collect（终盘回收驱动）：阈值钩子
    // 在终盘静音（threshold 可越过 limit，见 collect 尾），bump 越界时先回滚
    // r12 再同步 collect——回滚保证安全点 [heap_start, r12) 全为有效 hdr（sweep
    // 沿 hdr 链走查，半截块会让走查读到零 hdr 死循环）——然后重查类链头：命中
    // 则跳回复用段摘块（不再 bump；collect 不缩 r12，bound 检查结果不可变，
    // 成功路径天然一次即止，无需防重入标志），仍空才进 oom_die。s2 在两条
    // miss 路（空链头 je / cap 不足 jb）都持类头槽址，fail 直接复用。
    // the bump splits into pre/ja/fail plus a bump-fail fallback collect (the
    // endgame reclamation driver): the threshold hook goes silent in the
    // endgame (the threshold may pass the limit, see the collect tail), so a
    // bump past the limit rolls r12 back and collects synchronously first —
    // the rollback keeps the safepoint [heap_start, r12) full of valid hdrs
    // (the sweep walks the hdr chain; a half-written block would stall the
    // walk on a zero hdr) — then rechecks the class head: a hit jumps back
    // into the reuse stretch and pops (no second bump; a collect never
    // shrinks r12 and the bound verdict cannot change, so the success path
    // stops naturally after one round — no reentry flag needed), an empty
    // head falls to oom_die. s2 holds the class-head slot address on both
    // miss paths (the empty-head je and the cap-miss jb), and fail reuses it.
    let bump_pre = lea(dst, r12, 8) + add_ri32(r12, cap + 8) + mov_ri64(s1, rt_slot(rt_heap_limit)) + mov_rm(s1, s1, 0) + cmp_rr(s1, r12)
    let fail_head = add_ri32(r12, 0 - (cap + 8)) + push_r(rax) + mov_ri64(rax, gc_collect_g) + call_r(rax) + pop_r(rax) + mov_rm(s1, s2, 0) + test_rr(s1, s1)
    let fail_len = str_len(fail_head) + 6 + str_len(die)
    let bump_len = str_len(bump_pre) + 6 + fail_len
    let jmp_bits = jmp_rel32(bump_len + str_len(hdr_bump))
    let reuse_tail = cap_ld + hdr_reuse + jmp_bits
    let cap_chk = mov_rm(dst, s1, 8) + cmp_ri32(dst, sz) + jb_rel32(str_len(next_ld) + str_len(head_pop) + str_len(dst_set) + str_len(reuse_tail))
    let reuse_general = mov_ri64(s2, rt_slot(cls)) + mov_rm(s1, s2, 0) + test_rr(s1, s1) + je_rel32(str_len(cap_chk) + str_len(next_ld) + str_len(head_pop) + str_len(dst_set) + str_len(reuse_tail)) + cap_chk + next_ld + head_pop + dst_set + reuse_tail
    // 8B 类：节点只有 [next] 一个字（cap 恒为 8），命中直接弹、无需 cap 比较；
    // hdr 写立即数 8|desc<<40。8B 块此前不链、只能 bump——每次执行被捕获的
    // `let mut` 声明都分配一个 cell，堆顶随执行线性增长，collect 尾又从头重走
    // 整个堆，回收成本是 O(heap²)。
    // the 8B class: a node is one [next] word (cap is always 8), so a hit pops
    // without a cap compare and writes the immediate 8|desc<<40 hdr. 8B blocks
    // used to be left unchained and bump-only — every executed captured
    // `let mut` declaration allocates a cell, so the heap top grew with
    // execution and each collect re-walked the whole heap, making reclaim
    // O(heap^2).
    let next8 = mov_rm(dst, s1, 0)
    let head_pop8 = mov_mr(s2, 0, dst)
    let dst_set8 = mov_rr(dst, s1)
    let hdr_reuse8 = mov_ri64(s1, cap + desc * GC_DESC_SHIFT) + mov_mr(dst, 0 - 8, s1) + jmp_bits
    let reuse8 = mov_ri64(s2, rt_slot(rt_free8)) + mov_rm(s1, s2, 0) + test_rr(s1, s1) + je_rel32(str_len(next8) + str_len(head_pop8) + str_len(dst_set8) + str_len(hdr_reuse8)) + next8 + head_pop8 + dst_set8 + hdr_reuse8
    let reuse = if sz <= 8 {
        reuse8
    } else {
        reuse_general
    }
    // fail 的回跳目标是复用段的摘块头（next_ld / next8）：s1 已重载为链头
    // 节点，复用段从读 [s1] 起步正好接上。位移 = 回跳点至 jne 尾的全部字节
    // （pop 段 + bump_pre + ja + fail_head + jne 自身）。
    // fail jumps back to the reuse stretch's pop head (next_ld / next8): s1
    // has been reloaded with the chain head, and the reuse stretch starts by
    // reading [s1], so the two join up. The displacement spans every byte from
    // the jump target to the jne's end (pop stretch + bump_pre + ja +
    // fail_head + the jne itself).
    let pop_seg = next_ld + head_pop + dst_set + reuse_tail
    let fail_back = str_len(pop_seg) + str_len(bump_pre) + 6 + str_len(fail_head) + 6
    let fail = fail_head + jne_rel32(0 - fail_back) + die
    let fail8_back = str_len(next8) + str_len(head_pop8) + str_len(dst_set8) + str_len(hdr_reuse8) + str_len(bump_pre) + 6 + str_len(fail_head) + 6
    let fail8 = fail_head + jne_rel32(0 - fail8_back) + die
    let fail_blk = if sz <= 8 {
        fail8
    } else {
        fail
    }
    let bump = bump_pre + ja_rel32(str_len(fail_blk)) + fail_blk
    hook + push_r(s1) + push_r(s2) + reuse + bump + hdr_bump + bits + pop_r(s2) + pop_r(s1)
}

// x86gen_alloc_r 寄存器尺寸分配（size_reg 承载 payload 字节数，运行期圆整）：
// sz = (size_reg+7) & -8 先算进 s1；>64 的请求再抬到 2 的幂档（cap），s1 随档
// 更新，bump 推进与 hdr 都按 cap。限界检查越界先回滚 + collect + 重查类链头
//（按 s1 分派回 8B/general 摘块），仍空进 oom_die。desc≠0 时对 hdr 补 OR（P1
// desc 恒 0，该分支零字节）。size_reg 的调用方原值由入口 push/pop 复原；
// size_reg 不得等于 dst（dst 在读 size 前被覆写——站点审计保证）。
// x86gen_alloc_r register-size allocation (size_reg carries the payload byte
// count, rounded at run time): sz = (size_reg+7) & -8 lands in s1 first; a
// request above 64 is then raised to its power-of-two rung (cap) and s1 follows
// the rung, so the bump advance and the hdr both use cap. The bound check rolls
// back, collects and rechecks the class head on overflow (dispatching on s1
// into the 8B/general pop); oom_die only when it stays empty. desc != 0 ORs the
// hdr (P1's desc is always 0, so that branch emits no bytes). The caller's
// size_reg is restored by the entry push/pop; size_reg must not equal dst (dst
// is overwritten before the size is read — audited per site).
fn x86gen_alloc_r(dst, size_reg, desc) {
    let s1 = gc_scratch1(dst)
    let s2 = gc_scratch2(dst)
    let die = gc_oom_die()
    // 圆整提前到分支前：s1 承载圆整尺寸（>64 再抬成幂档 cap）贯穿 bump
    //（add_rr r12）与 hdr_or；复用路径的 hdr 取块内原 cap，s1 在复用尾重载，
    // 两路共用 hdr_or。
    // the rounding hoists above the branch: s1 carries the rounded size (raised
    // to the power rung above 64) through the bump (add_rr r12) and hdr_or; the
    // reuse path's hdr takes the block's stored cap, reloading s1 at its tail —
    // both paths share the same hdr_or/hdr_write.
    let round = mov_rr(s1, size_reg) + add_ri32(s1, 7) + and_ri32(s1, 0 - 8)
    let hdr_or = if desc != 0 {
        mov_ri64(s2, desc * GC_DESC_SHIFT) + or_rr(s1, s2)
    } else {
        ""
    }
    let hdr_write = mov_mr(dst, 0 - 8, s1)
    let bits = mov_rr(s2, dst) + sub_ri32(s2, 8) + mov_ri64(s1, rt_slot(rt_heap_start)) + mov_rm(s1, s1, 0) + sub_rr(s2, s1) + shr_ri(s2, 3) + mov_ri64(s1, rt_slot(rt_start_bitmap)) + mov_rm(s1, s1, 0) + gc_bitmap_set(s1, s2)
    // --gc-stress / 阈值钩子：同 x86gen_alloc / same as x86gen_alloc
    let hook = if gc_stress_g {
        push_r(rax) + mov_ri64(rax, gc_collect_g) + call_r(rax) + pop_r(rax)
    } else {
        push_r(rax) + mov_ri64(rax, rt_slot(rt_gc_threshold)) + mov_rm(rax, rax, 0) + cmp_rr(rax, r12) + ja_rel32(str_len(mov_ri64(rax, gc_collect_g)) + str_len(call_r(rax))) + mov_ri64(rax, gc_collect_g) + call_r(rax) + pop_r(rax)
    }
    // P3 尺寸类链头（alloc_r 运行期选类）：≤64 走精确类的比较链（jb 严格小于
    // 24/40/72——尺寸恒 8 倍数，cap ≤ 16 ⟺ cap < 24）；>64 走 2 的幂档，cap 从
    // 128 起倍增到 ≥ sz、槽址同步 +8（循环不碰 cl，size_reg 可能正是 rcx/rdx），
    // 出口把 cap 写回 s1，使 bump 推进、hdr 与请求尺寸都按档值。档内 cap 恒等于
    // 档值，链头必命中；两条 miss 路径（je/jb）直落 jmp_over_free8 跳过 8B 段
    // 进 bump（停靠寄存器到站点尾才弹）。
    // P3 size-class heads (alloc_r picks at run time): up to 64 uses the exact
    // classes' compare chain (strict jb bounds 24/40/72 — sizes are always
    // 8-multiples, so cap <= 16 iff cap < 24); above 64 uses the power-of-two
    // rungs, doubling cap from 128 until >= sz and stepping the slot +8 in
    // tandem (the loop never touches cl: size_reg may be rcx/rdx). The exit
    // copies cap back into s1 so the bump advance, the hdr and the request size
    // all use the rung. Within a rung every block's cap equals the rung, so the
    // head always hits; both miss paths (je/jb) fall through jmp_over_free8,
    // skipping the 8B stretch into the bump (the parked register pops at the
    // site tail).
    let big_step = add_rr(dst, dst) + add_ri32(s2, 8)
    let big_cmp = cmp_rr(dst, s1)
    let big_back = jmp_rel32(0 - (str_len(big_cmp) + 6 + str_len(big_step) + 5))
    let big_skip = jae_rel32(str_len(big_step) + str_len(big_back))
    let sel_big = mov_ri64(dst, 128) + mov_ri64(s2, rt_slot(rt_free_class_base)) + big_cmp + big_skip + big_step + big_back + mov_rr(s1, dst)
    let sel2 = mov_ri64(s2, rt_slot(rt_free64)) + cmp_ri32(s1, 72) + jb_rel32(str_len(sel_big))
    let sel1 = mov_ri64(s2, rt_slot(rt_free32)) + cmp_ri32(s1, 40) + jb_rel32(str_len(sel2) + str_len(sel_big))
    let sel0 = mov_ri64(s2, rt_slot(rt_free16)) + cmp_ri32(s1, 24) + jb_rel32(str_len(sel1) + str_len(sel2) + str_len(sel_big))
    // bump 拆成 pre/ja/fail 三段 + 失败保底 collect（终盘回收驱动）：阈值钩子
    // 在终盘静音（threshold 可越过 limit，见 collect 尾），bump 越界时先回滚
    // r12（r12 -= s1 + 8，s1 是档值/圆整尺寸）再同步 collect——回滚保证安全点
    // [heap_start, r12) 全为有效 hdr（sweep 沿 hdr 链走查，半截块会让走查读到
    // 零 hdr 死循环）——然后按停靠寄存器里的类头槽址重查链头：命中按 s1 分派
    // 回 8B 摘块（free8_mid）或 general 摘块（reuse_mid），仍空才进 oom_die。
    // 停靠寄存器贯穿 bump 与 fail、到站点尾才统一弹出：旧版 bail 在 miss 路
    // 弹出、reuse_mid 在命中路弹出，而 8B 路线不 park——两套弹出点无法与「8B
    // miss 也要保底重查」共存；统一到尾弹出后 sel8 必须同样 park，所有到尾的
    // 路径恰 push 一次 pop 一次。collect 全寄存器自保，停靠寄存器/s1（档值）/
    // s2 穿越无损；dst==rax 的站点停 r11，dst 写入不毁槽址。
    // the bump splits into pre/ja/fail plus a bump-fail fallback collect (the
    // endgame reclamation driver): the threshold hook goes silent in the
    // endgame (the threshold may pass the limit, see the collect tail), so a
    // bump past the limit rolls r12 back first (r12 -= s1 + 8, s1 being the
    // rung/rounded size) and collects synchronously — the rollback keeps the
    // safepoint [heap_start, r12) full of valid hdrs (the sweep walks the hdr
    // chain; a half-written block would stall the walk on a zero hdr) — then
    // rechecks the class head through the parked slot address: a hit
    // dispatches on s1 back into the 8B pop (free8_mid) or the general pop
    // (reuse_mid), an empty head falls to oom_die. The parked register now
    // lives through the bump and the fail and pops once at the site tail: bail
    // used to pop it on the miss paths and reuse_mid on the hit path, while
    // the 8B route never parked — two pop points cannot coexist with "the 8B
    // miss also retries"; parking in sel8 too makes every tail-reaching path
    // push and pop exactly once. The collector saves all registers itself, so
    // the parked register, s1 (the rung) and s2 cross it unharmed; dst==rax
    // sites park in r11 so dst writes never destroy the slot address.
    let bump_pre = lea(dst, r12, 8) + add_rr(r12, s1) + add_ri32(r12, 8) + mov_ri64(s2, rt_slot(rt_heap_limit)) + mov_rm(s2, s2, 0) + cmp_rr(s2, r12)
    // 槽址停靠寄存器按 dst 选：dst==rax 的站点停 r11——reuse_mid 的
    // mov_rm(dst,...) 会先毁掉停在 rax 的槽址，[rax]=next 写到 next 自身、
    // 槽头不动=同一节点双发；其余站点维持 rax。两者都 push/pop 全保护。
    // the slot-address park register follows dst: dst==rax sites park in r11
    // (reuse_mid's mov_rm(dst,...) would destroy a rax-parked address first,
    // so [rax]=next stores into next itself and the head never moves = the
    // same node handed out twice); the rest keep rax. Both push/pop saved.
    let park = if dst == rax {
        push_r(r11) + mov_rr(r11, s2)
    } else {
        push_r(rax) + mov_rr(rax, s2)
    }
    let slot_reg = if dst == rax {
        r11
    } else {
        rax
    }
    let park_pop = if dst == rax {
        pop_r(r11)
    } else {
        pop_r(rax)
    }
    let dst_set = mov_rr(dst, s2)
    let cap_re = mov_rm(s1, dst, 8)
    let head_ld = mov_rm(s2, s2, 0)
    let head_test = test_rr(s2, s2)
    let cmp16 = cmp_ri32(s1, 16)
    let fail_roll = sub_rr(r12, s1) + sub_ri32(r12, 8)
    let fail_collect = push_r(rax) + mov_ri64(rax, gc_collect_g) + call_r(rax) + pop_r(rax)
    let fail_reload = mov_rm(s2, slot_reg, 0) + test_rr(s2, s2)
    let fail_head = fail_roll + fail_collect + fail_reload
    let fail_probe = cmp16 + jb_rel32(0) + jmp_rel32(0)
    let fail_len = str_len(fail_head) + 6 + str_len(fail_probe) + str_len(die)
    let bump_ja = ja_rel32(fail_len)
    let bump_tail = str_len(bump_pre) + 6 + fail_len
    // 8B 类（圆整后 s1 < 16，即 0/8）：不走 cap 比较链，改走 sel8——同样 park
    // 后查链头（s2 = 节点），命中 free8_mid 摘块（节点只有 [next] 一字，cap 由
    // 类隐含为 8），空链落 bump。8B 块此前不链、只能 bump——每次执行被捕获的
    // `let mut` 声明都分配一个 cell，堆顶随执行线性增长，collect 尾又从头重走
    // 整个堆，回收成本是 O(heap²)。
    // the 8B class (s1 < 16 after rounding, i.e. 0/8): skip the cap-compare
    // chain for sel8 — park, then check the head (s2 = the node); a hit pops
    // via free8_mid (the node is a single [next] word, cap implied as 8 by the
    // class), an empty head falls to bump. 8B blocks used to be left unchained
    // and bump-only — every executed captured `let mut` declaration allocates
    // a cell, so the heap top grew with execution and each collect re-walked
    // the whole heap, making reclaim O(heap^2).
    let free8_mid = mov_rm(dst, s2, 0) + mov_mr(slot_reg, 0, dst) + mov_ri64(s1, 8) + jmp_rel32(bump_tail)
    let sel8 = mov_ri64(s2, rt_slot(rt_free8)) + park + head_ld + head_test + je_rel32(str_len(free8_mid)) + free8_mid
    let jmp_over_free8 = jmp_rel32(str_len(sel8))
    // jmp_hdr 跨过 jmp_over_free8+sel8+bump 全段直达 hdr_or；命中路径的停靠
    // 寄存器到站点尾才弹（见 bump 注），位移不再计 bail。
    // jmp_hdr skips jmp_over_free8 + sel8 + the whole bump straight to hdr_or;
    // the hit path's parked register pops at the site tail (see the bump note),
    // so the relocation no longer counts a bail.
    let jmp_hdr = jmp_rel32(str_len(jmp_over_free8) + str_len(sel8) + bump_tail)
    let reuse_mid = mov_rm(dst, s2, 0) + mov_mr(slot_reg, 0, dst) + dst_set + cap_re + jmp_hdr
    let cap_chk = mov_rm(dst, s2, 8) + cmp_rr(dst, s1) + jb_rel32(str_len(reuse_mid))
    let reuse_general = sel0 + sel1 + sel2 + sel_big + park + head_ld + head_test + je_rel32(str_len(cap_chk) + str_len(reuse_mid)) + cap_chk + reuse_mid
    // fail 的回跳目标按 s1 分派：s1 < 16 回 8B 摘块（free8_mid），否则回
    // general 摘块（reuse_mid）；链头空则经 je 落 oom_die。位移 = 回跳点至
    // jb/jmp 尾的全部字节（fail_probe 与真分派等长，仅位移占位）。
    // fail dispatches its jump-back on s1: below 16 returns to the 8B pop
    // (free8_mid), otherwise to the general pop (reuse_mid); an empty head
    // falls through the je to oom_die. The displacements span every byte from
    // the jump target to the jb/jmp's end (fail_probe matches the real
    // dispatch in length, its displacement a placeholder).
    let fail_back8 = str_len(free8_mid) + str_len(bump_pre) + 6 + str_len(fail_head) + 6 + str_len(cmp16) + 6
    let fail_backg = str_len(reuse_mid) + str_len(jmp_over_free8) + str_len(sel8) + str_len(bump_pre) + 6 + str_len(fail_head) + 6 + str_len(fail_probe)
    let fail_disp = cmp16 + jb_rel32(0 - fail_back8) + jmp_rel32(0 - fail_backg)
    let fail = fail_head + je_rel32(str_len(fail_disp)) + fail_disp + die
    let bump = bump_pre + bump_ja + fail
    let reuse = cmp16 + jb_rel32(str_len(reuse_general) + str_len(jmp_over_free8)) + reuse_general + jmp_over_free8 + sel8
    hook + push_r(s1) + push_r(s2) + round + reuse + bump + hdr_or + hdr_write + bits + park_pop + pop_r(s2) + pop_r(s1)
}

// x86gen_gc_verify_seq 生成堆走查校验序列（--gc-debug 时内联在调度器 exit0 前）：
// 从 rt_heap_start 沿 hdr 链走到 r12，逐块校验 size 非零且 8 对齐、desc_id 落在
// desc 表内、start-bit 置位；收口要求游标恰好等于 r12（最后一块越过堆顶也算腐
// 化）。毁 rax/rcx/rdx/rdi/r9（退出路径无活值）。毁 FLAGS。失败信息区分四类检
// 查（size/desc/bit/top），且经 die_call(flags=0) 无回溯退出——调度器上下文没
// 有用户栈帧，flags=1 的回溯会踩空段错误。
// x86gen_gc_verify_seq emits the heap-walk verification sequence (inlined before
// the scheduler's exit0 under --gc-debug): walk the hdr chain from rt_heap_start
// to r12, checking per block that size is nonzero and 8-aligned, desc_id lands
// inside the desc table, and the start bit is set; the walk must land exactly on
// r12 (the last block overshooting the top counts as corruption). Clobbers
// rax/rcx/rdx/rdi/r9 (no live values on the exit path). Clobbers FLAGS. The four
// failure classes report distinct messages, and the exit goes through
// die_call(flags=0) — no backtrace: the scheduler context has no user frame, so
// a flags=1 unwind would walk garbage and segfault.
fn x86gen_gc_verify_seq() {
    let mut it = []
    // 游标 r9 = heap_start（当前块 hdr 地址）
    push(it, la_b(mov_ri64(r9, rt_slot(rt_heap_start)) + mov_rm(r9, r9, 0)))
    push(it, la_l("gv_loop"))
    push(it, la_b(cmp_rr(r9, r12)))
    push(it, la_jcc(CC_AE, "gv_done"))
    push(it, la_b(mov_rm(rax, r9, 0)))
    // size = hdr 低 34 位：非零且 8 对齐
    push(it, la_b(mov_rr(rcx, rax) + mov_ri64(rdx, 17179869183) + and_rr(rcx, rdx)))
    push(it, la_b(test_rr(rcx, rcx)))
    push(it, la_jcc(CC_E, "gv_fail_size"))
    push(it, la_b(mov_ri64(rdx, 7) + and_rr(rdx, rcx)))
    push(it, la_jcc(CC_NE, "gv_fail_size"))
    // desc_id = (hdr >> 40) & GC_DESC_MASK：必须落在 desc 表内（P1 表 8B，仅条目 0）
    // desc_id = (hdr >> 40) & GC_DESC_MASK: must land inside the desc table
    push(it, la_b(mov_rr(rcx, rax) + shr_ri(rcx, 40) + mov_ri64(rdx, GC_DESC_MASK) + and_rr(rcx, rdx) + cmp_ri32(rcx, GC_DESC_TABLE_LEN)))
    push(it, la_jcc(CC_AE, "gv_fail_desc"))
    // start bit：bitmap[(hdr - heap_start) >> 3] 的 bit0 必须为 1
    //（cmp byte [rcx + rdx], 0 —— base+index 形式 mem_operand 不覆盖，手写编码）
    push(it, la_b(mov_ri64(rcx, rt_slot(rt_start_bitmap)) + mov_rm(rcx, rcx, 0)))
    push(it, la_b(mov_rr(rdx, r9) + mov_ri64(rdi, rt_slot(rt_heap_start)) + mov_rm(rdi, rdi, 0) + sub_rr(rdx, rdi) + shr_ri(rdx, 3)))
    push(it, la_b(e1(128) + e1(60) + e1(rdx * 8 + rcx) + e1(0)))
    push(it, la_jcc(CC_E, "gv_fail_bit"))
    // next = hdr + 8 + size
    push(it, la_b(mov_rr(rcx, rax) + mov_ri64(rdx, 17179869183) + and_rr(rcx, rdx) + lea(r9, r9, 8) + add_rr(r9, rcx)))
    push(it, la_jmp("gv_loop"))
    push(it, la_l("gv_fail_size"))
    push(it, la_b(x86gen_die_call("gc verify: bad block size", 0)))
    push(it, la_l("gv_fail_desc"))
    push(it, la_b(x86gen_die_call("gc verify: desc id out of table", 0)))
    push(it, la_l("gv_fail_bit"))
    push(it, la_b(x86gen_die_call("gc verify: start bit missing", 0)))
    push(it, la_l("gv_done"))
    // 收口：游标必须恰好等于 r12；相等则跳过 die 落到序列尾（exit0 主流程）
    push(it, la_b(cmp_rr(r9, r12)))
    push(it, la_jcc(CC_E, "gv_ok"))
    push(it, la_b(x86gen_die_call("gc verify: heap top mismatch", 0)))
    push(it, la_l("gv_ok"))
    la_link(it)
}

// P2 收集器：mark 子程序 + collect 主块。调用点仅 mov_ri64(gc_collect_g)+call——
// 块自身入口固定序 push 14 个 GPR（rax..r15 除 rsp/r12），既做寄存器保存区根，
// 也让收集器对调用方零破坏（出口按逆序 pop，rax 一并还原；仅 FLAGS 出栈非恒）。
// r12（堆顶）、rbx（全局基）、rbp 只读不写。汇编期地址 gc_collect_g/gc_mark_g
// 双遍量测定值（mov imm64 定长，先以 0 量长再重建），PIC 改写按位移成立。
// P2 collector: the mark subroutine + the collect main block. Call sites are a
// bare mov_ri64(gc_collect_g)+call — the block pushes the 14 GPRs (rax..r15
// minus rsp/r12) in a fixed order at entry, which doubles as the register
// save-area root and makes the collector zero-damage for its caller (the exit
// pops in reverse, rax included; only FLAGS escape). r12 (heap top), rbx
// (globals base), rbp are read-only. Assembly-time addresses gc_collect_g /
// gc_mark_g go through the two-pass measure-then-fix pattern (mov imm64 is
// fixed-size: measure with 0, rebuild once known), so the PIC rewrite holds.
pub let mut gc_collect_g = 0
pub let mut gc_mark_g = 0
// 发射期三开关（build.bur 解析 --gc-stress/--gc-poison/--gc-debug 后置位）：
// stress = 每次 alloc 前同步 collect；poison = sweep 死块 payload 填 0xAB；
// debug = verify（P1 已接）。
// emission-time switches (build.bur sets them from --gc-stress/--gc-poison/
// --gc-debug): stress = collect before every alloc; poison = sweep fills dead
// payloads with 0xAB; debug = verify (wired since P1).
pub let mut gc_stress_g = false
pub let mut gc_poison_g = false

pub fn set_gc_stress(v: bool) {
    gc_stress_g = v
}

pub fn set_gc_poison(v: bool) {
    gc_poison_g = v
}

// hdr 标志位与位域：位 62 = MARK（本轮可达），位 63 = FREE（已死，P3 复用时
// 读），位 34 = SCANNED（payload 已被 gc_pw 展开过——收敛多趟里每活块只展开
// 一次，终结每层引用深度一次全堆 payload 重扫的 O(depth×heap)）；size 域缩到
// 34 位（上限 16GiB），高于 12GiB 堆预留，任何在堆块都放得下。
// hdr flag bits and fields: bit 62 = MARK (reachable this cycle), bit 63 =
// FREE (dead, read back by P3's reuse), bit 34 = SCANNED (the payload was
// already expanded by gc_pw — once per live block across the convergence
// passes, ending the O(depth×heap) whole-heap payload rescan per reference
// depth); the size field narrows to 34 bits (16GiB cap), above the 12GiB heap
// reservation, so every in-heap block fits.
pub let GC_MARK_BIT = 4611686018427387904
pub let GC_FREE_BIT = 0 - 9223372036854775807 - 1
pub let GC_SCANNED_BIT = 17179869184
pub let GC_SIZE_MASK = 17179869183

// x86gen_gc_mark_block：mark(rdi) 子程序——对齐过滤 + [heap_start+8, r12) 界内 +
// start-bit 命中三者全过才认指针：置 hdr 位 62、rt_gc_cnt++。已 MARK 直退。
// 候选是 payload 指针：首个块的 hdr 就压在 heap_start，payload 最早在
// heap_start+8，故 rdi <= heap_start 一律拒——相等时 (rdi-8-heap)>>3 下溢，
// 起点位图会按 0x1fff... 的索引越界读。
// start-bit 按候选的块头粒度查（(rdi-8-heap)>>3，与分配站点/verify 同口径）：
// 位只落在 hdr 粒度上，按 rdi 本身粒度查恒差一格——真指针全被拒收，而值恰为
// 某块 hdr 地址的值反会过检，把 MARK 写进 [hdr-8] = 前一块 payload 尾字。
// start-bit 是唯一把「值」变「块」的闸门，粒度错位即收集器整体失效。
// x86gen_gc_mark_block: the mark(rdi) subroutine — an aligned candidate inside
// [heap_start+8, r12) whose start-bit is set counts as a pointer: set hdr bit 62
// and rt_gc_cnt++. Already-MARKed exits early. The candidate is a payload
// pointer: the first block's hdr sits at heap_start, so the earliest payload is
// heap_start+8 and rdi <= heap_start must be rejected — equality would
// underflow (rdi-8-heap)>>3 into a 0x1fff... bitmap index. The start-bit is
// checked at the candidate's BLOCK-HEADER granule ((rdi-8-heap)>>3, same
// convention as the alloc sites and verify): bits only ever land on hdr
// granules, so checking at rdi's own granule is always one granule off — every
// real pointer gets rejected, while any value that happens to equal some
// block's hdr address passes and MARK lands at [hdr-8], the previous block's
// last payload word.
// Saves rax/rcx/rdx/rsi (push/pop), touches nothing else; clobbers FLAGS.
fn x86gen_gc_mark_block() {
    let mut it = []
    push(it, la_b(push_r(rax) + push_r(rcx) + push_r(rdx) + push_r(rsi)))
    // 未对齐候选直接弃（值栈里的 int/bool 位样式一概过滤）
    // misaligned candidates are rejected outright (int/bool bit patterns in
    // stack slots all filter out here)
    push(it, la_b(mov_rr(rax, rdi) + and_ri32(rax, 7)))
    push(it, la_jcc(CC_NE, "gm_done"))
    push(it, la_b(mov_ri64(rsi, rt_slot(rt_heap_start)) + mov_rm(rsi, rsi, 0)))
    push(it, la_b(cmp_rr(rdi, rsi)))
    push(it, la_jcc(CC_BE, "gm_done"))
    push(it, la_b(cmp_rr(rdi, r12)))
    push(it, la_jcc(CC_AE, "gm_done"))
    push(it, la_b(mov_rr(rax, rdi) + sub_ri32(rax, 8) + sub_rr(rax, rsi) + shr_ri(rax, 3)))
    push(it, la_b(mov_ri64(rcx, rt_slot(rt_start_bitmap)) + mov_rm(rcx, rcx, 0)))
    // cmp byte [rcx+rax], 0（base+index 手写编码，同 verify_seq）
    // cmp byte [rcx+rax], 0 (handwritten base+index encoding, same as verify_seq)
    push(it, la_b(e1(128) + e1(60) + e1(rax * 8 + rcx) + e1(0)))
    push(it, la_jcc(CC_E, "gm_done"))
    push(it, la_b(mov_rm(rax, rdi, 0 - 8) + mov_ri64(rdx, GC_MARK_BIT)))
    push(it, la_b(test_rr(rdx, rax)))
    push(it, la_jcc(CC_NE, "gm_done"))
    push(it, la_b(or_rr(rax, rdx) + mov_mr(rdi, 0 - 8, rax)))
    // rt_gc_cnt++（inc qword [rcx]，REX.W FF /0 mod=00）
    // rt_gc_cnt++ (inc qword [rcx], REX.W FF /0 mod=00)
    push(it, la_b(mov_ri64(rcx, rt_slot(rt_gc_cnt)) + e1(72) + e1(255) + modrm(0, 0, rcx)))
    push(it, la_l("gm_done"))
    push(it, la_b(pop_r(rsi) + pop_r(rdx) + pop_r(rcx) + pop_r(rax) + ret()))
    la_link(it)
}

// x86gen_gc_collect_block：完整回收一轮。fixpoint 线性趟——每趟扫根（①保存区
// 9 个 caller GPR 词（callee 槽持非堆地址，扫描可证明空操作）、②全局 kind 表非
// SCALAR 槽、③各 fiber 值栈全槽（当前 fiber 用保存区里的活 r15）、④fb 结构自身、
// ⑤exec 排水自由链 rt_gray）再沿 hdr 链展开每个未 SCANNED 的 MARK 块 payload
//（按 desc 试 mark；SCANNED 位让每活块在全部趟里只展开一次，否则每层引用深度
// 都重扫全堆 payload，O(depth×heap) 是单轮 225~376s 的主因）；
// cnt 相邻两趟不变即收敛。③不看影子字节：那份判定由逐指令静态类型折出，模型漂移
// 即漏扫活指针（详见 gc_vs 处注释）；全局 kind 表取声明类型，无此漂移，仍按表筛。
// sweep：MARK+SCANNED 双位清除保活，否则置 FREE 并（poison 开时）payload 填 0xAB；
// rt_gc_cycles++、rt_gc_last_freed=死块字节和。栈布局：入口 sub rsp,16 后
// [rsp+112]=cnt 快照、[rsp+120]=cur_fiber，再 push 14 个 GPR。毁 FLAGS，其余全保。
// x86gen_gc_collect_block: one full collection round. Fixpoint linear passes —
// each pass scans the roots (1. the save area's 9 caller-GPR words — the callee
// slots hold non-heap addresses, a provable no-op — 2. non-SCALAR global-kind
// slots, 3. every slot of every fiber's value stack, the current fiber using the
// live r15 from the save area, 4. the fb structs themselves, 5. exec's drain
// free chain at rt_gray), then walks the hdr chain expanding every not-yet-
// SCANNED MARKed block's payload per its desc (the SCANNED bit makes each live
// block expand exactly once across the passes — without it every reference
// depth rescanned the whole heap, O(depth×heap), 225~376s per round);
// convergence when cnt stops changing between passes. 3
// ignores the shadow byte: that verdict is folded from per-instruction static
// types, and model drift drops live pointers from the scan (see the gc_vs
// note); the global kind table comes from declared types, has no such drift,
// and still filters by its table. Sweep: MARK+SCANNED cleared on live blocks,
// the rest get FREE set plus a 0xAB payload fill when poison is on;
// rt_gc_cycles++ and rt_gc_last_freed = the dead byte total. Stack layout:
// entry sub rsp,16 puts [rsp+112]=cnt snapshot and [rsp+120]=cur_fiber, then
// the 14 pushes. Clobbers FLAGS, preserves everything else.
fn x86gen_gc_collect_block(n_globals) {
    let mark_call = mov_ri64(rax, gc_mark_g) + call_r(rax)
    let mut it = []
    // 入口：快照区 + cur_fiber 暂存，再固定序存 14 个 GPR（r15 最后进 [rsp]）
    // entry: scratch slots + cur_fiber stash, then the 14 GPRs in fixed order
    // (r15 lands at [rsp])
    push(it, la_b(sub_ri32(rsp, 16) + push_r(rax) + push_r(rcx) + push_r(rdx) + push_r(rbx) + push_r(rbp) + push_r(rsi) + push_r(rdi) + push_r(r8) + push_r(r9) + push_r(r10) + push_r(r11) + push_r(r13) + push_r(r14) + push_r(r15)))
    push(it, la_b(mov_ri64(rax, rt_slot(rt_gc_cnt)) + xor_rr(rcx, rcx) + mov_mr(rax, 0, rcx)))
    push(it, la_b(mov_ri64(rax, rt_slot(rt_cur_fiber)) + mov_rm(rax, rax, 0) + mov_mr(rsp, 120, rax)))
    push(it, la_l("gc_outer"))
    // 本趟基线快照 / this pass's baseline
    push(it, la_b(mov_ri64(rax, rt_slot(rt_gc_cnt)) + mov_rm(rax, rax, 0) + mov_mr(rsp, 112, rax)))
    // ①保存区：仅 9 个 caller GPR 按 MAYBE 扫（findings §11.3 收紧）。callee
    // 槽——r15 值栈顶、r14 帧基、r13 跳转表、rbp 帧指针、rbx 全局基——按寄存器
    // 约定（x86.bur:6）只持镜像/跳转表/纤维栈/原生栈地址，全在 GC 堆预留之外；
    // mark 的三重过滤（对齐/堆界/起点位图）对它们恒拒绝，扫描是可证明的空操作
    // （发射端 grep 实锤：这些寄存器只在 park/resume 保存恢复与 prologue 帧
    // 建立、trap die 扫栈时被写，值全是非堆地址）。caller 槽在保存区里分两段
    // 连续：r11,r10,r9,r8,rdi,rsi（[rsp+24..72)）与 rdx,rcx,rax
    // （[rsp+88..112)），rbp/rbx（+72/+80）夹在中间跳过。
    // ① save area: only the 9 caller GPRs get the MAYBE scan (findings §11.3
    // tightening). The callee slots — r15 value-stack top, r14 frame base, r13
    // jump table, rbp frame pointer, rbx globals base — hold image, jump-table,
    // fiber-stack or native-stack addresses by the register conventions
    // (x86.bur:6), all outside the GC-heap reservation; mark's three gates
    // (alignment / heap range / start bitmap) reject them unconditionally, so
    // scanning them is a provable no-op (emitter grep confirms these registers
    // are written only by park/resume save-restore, prologue frame setup and
    // trap's die-path stack scan — all non-heap values). The caller slots form
    // two contiguous runs in the save area: r11,r10,r9,r8,rdi,rsi
    // ([rsp+24..72)) and rdx,rcx,rax ([rsp+88..112)), skipping rbp/rbx
    // (+72/+80) in between.
    push(it, la_b(mov_rr(r10, rsp) + add_ri32(r10, 24) + mov_ri64(rcx, 6)))
    push(it, la_l("gc_sv1"))
    push(it, la_b(mov_rm(rdi, r10, 0) + mark_call + add_ri32(r10, 8) + sub_ri32(rcx, 1)))
    push(it, la_jcc(CC_NE, "gc_sv1"))
    push(it, la_b(mov_rr(r10, rsp) + add_ri32(r10, 88) + mov_ri64(rcx, 3)))
    push(it, la_l("gc_sv2"))
    push(it, la_b(mov_rm(rdi, r10, 0) + mark_call + add_ri32(r10, 8) + sub_ri32(rcx, 1)))
    push(it, la_jcc(CC_NE, "gc_sv2"))
    // ②全局：kind 表字节非 SCALAR 的槽 / globals: non-SCALAR kind slots
    push(it, la_b(mov_ri64(r10, rt_slot(rt_global_kinds)) + mov_rm(r10, r10, 0) + mov_rr(r11, rbx) + mov_ri64(rcx, n_globals)))
    push(it, la_l("gc_gl"))
    push(it, la_b(test_rr(rcx, rcx)))
    push(it, la_jcc(CC_E, "gc_gl_done"))
    push(it, la_b(movzx_rm8(rdi, r10, 0) + test_rr(rdi, rdi)))
    push(it, la_jcc(CC_E, "gc_gl_next"))
    push(it, la_b(mov_rm(rdi, r11, 0) + mark_call))
    push(it, la_l("gc_gl_next"))
    push(it, la_b(add_ri32(r10, 1) + add_ri32(r11, 8) + sub_ri32(rcx, 1)))
    push(it, la_jmp("gc_gl"))
    push(it, la_l("gc_gl_done"))
    // ③④⑤fibers：链上每个 fb——mark(fb)、值栈影子扫、native 栈 [LIMIT, RSP+16] 扫
    // fibers: for each fb on the chain — mark(fb), the shadow stack scan, and
    // the native-stack [LIMIT, RSP+16] scan
    push(it, la_b(mov_ri64(r9, rt_slot(rt_fiber_list)) + mov_rm(r9, r9, 0)))
    push(it, la_l("gc_fb"))
    push(it, la_b(test_rr(r9, r9)))
    push(it, la_jcc(CC_E, "gc_fb_done"))
    push(it, la_b(mov_rr(rdi, r9) + mark_call))
    // 活 r15：当前 fiber 取保存区 [rsp]，其余取 [fb+FB_R15]
    // live r15: the current fiber reads [rsp] (save area), others [fb+FB_R15]
    push(it, la_b(mov_rm(rax, rsp, 120) + cmp_rr(r9, rax)))
    push(it, la_jcc(CC_E, "gc_fb_cur"))
    push(it, la_b(mov_rm(rdx, r9, FB_R15)))
    push(it, la_jmp("gc_fb_r15"))
    push(it, la_l("gc_fb_cur"))
    push(it, la_b(mov_rm(rdx, rsp, 0)))
    push(it, la_l("gc_fb_r15"))
    // 活槽一律试 mark，不读影子字节：影子 kind 由静态类型模型折出，模型一漂
    // （X86TDRIFT）就把指针载荷判成 SCALAR，该槽当轮不扫、对象被 sweep 成死
    // 块——下一次读到的 [payload+0] 已是自由链 next（指针），编译期的字符串
    // 常量首字即地址，拼接按它当长度申请 127TiB 假 OOM。mark 的三重过滤（对
    // 齐/堆界/起点位）对真标量恒拒绝，多扫一个标量无害，漏扫一个指针即悬垂。
    // 原生栈 [LIMIT, RSP+16] 与保存区本就无影子全扫，值栈与之一致。
    // every live slot is offered to mark without reading the shadow byte: the
    // shadow kind is folded from the static type model, and once that model
    // drifts (X86TDRIFT) a pointer payload reads as SCALAR, the slot is skipped
    // for the round and the object is swept — the next read of [payload+0] is a
    // free-list next (a pointer), so a compile-time string constant starts with
    // an address and concatenation allocates 127TiB on it (false OOM). mark's
    // three gates (alignment / heap range / start bit) reject real scalars
    // unconditionally: over-scanning a scalar is harmless, under-scanning a
    // pointer dangles. The native stack [LIMIT, RSP+16] and the save area are
    // already scanned shadow-free; the value stack now matches them.
    push(it, la_b(mov_rm(r10, r9, FB_STACK_LO) + sub_rr(rdx, r10) + shr_ri(rdx, 3) + xor_rr(rcx, rcx)))
    push(it, la_l("gc_vs"))
    push(it, la_b(cmp_rr(rcx, rdx)))
    push(it, la_jcc(CC_AE, "gc_vs_done"))
    push(it, la_b(mov_rr(r8, rcx) + shl_ri(r8, 3) + add_rr(r8, r10) + mov_rm(rdi, r8, 0) + mark_call + add_ri32(rcx, 1)))
    push(it, la_jmp("gc_vs"))
    push(it, la_l("gc_vs_done"))
    push(it, la_b(mov_rm(r10, r9, FB_LIMIT) + mov_rm(r11, r9, FB_RSP) + add_ri32(r11, 16)))
    push(it, la_l("gc_ns"))
    push(it, la_b(cmp_rr(r10, r11)))
    push(it, la_jcc(CC_AE, "gc_ns_done"))
    push(it, la_b(mov_rm(rdi, r10, 0) + mark_call + add_ri32(r10, 8)))
    push(it, la_jmp("gc_ns"))
    push(it, la_l("gc_ns_done"))
    push(it, la_b(mov_rm(r9, r9, FB_LIST_NEXT)))
    push(it, la_jmp("gc_fb"))
    push(it, la_l("gc_fb_done"))
    // ⑤exec 排水自由链（POISON 下不保活会被拆链）/ exec's drain free chain
    push(it, la_b(mov_ri64(r9, rt_slot(rt_gray)) + mov_rm(r9, r9, 0)))
    push(it, la_l("gc_ch"))
    push(it, la_b(test_rr(r9, r9)))
    push(it, la_jcc(CC_E, "gc_ch_done"))
    push(it, la_b(mov_rr(rdi, r9) + mark_call + mov_rm(r9, r9, 0)))
    push(it, la_jmp("gc_ch"))
    push(it, la_l("gc_ch_done"))
    // MARK 块 payload 按 desc 扫 / MARKed payloads per desc
    push(it, la_b(mov_ri64(r9, rt_slot(rt_heap_start)) + mov_rm(r9, r9, 0)))
    push(it, la_l("gc_pw"))
    push(it, la_b(cmp_rr(r9, r12)))
    push(it, la_jcc(CC_AE, "gc_pw_done"))
    push(it, la_b(mov_rm(rax, r9, 0) + mov_ri64(rdx, GC_MARK_BIT) + test_rr(rdx, rax)))
    push(it, la_jcc(CC_E, "gc_pw_next"))
    // SCANNED 已置 = payload 在更早的趟已展开：跳过（每活块每次 collect 只展开
    // 一次——旧版每层引用深度都重扫全部 MARK payload，O(depth×heap) 是 fixpoint
    // 单轮 225~376s 的主因）。扫描前先置位：本轮该块必然被展开，之后各趟与
    // sweep 都不再碰它（sweep 存活路径按位清除）。
    // SCANNED set = the payload was expanded in an earlier pass: skip (every
    // live block expands once per collect — the old cut rescanned every MARKed
    // payload per reference depth, and that O(depth×heap) dominated the 225~
    // 376s single collect). The bit goes on before the scan: the block is
    // certainly expanded this round, later passes and the sweep leave it alone
    // (the sweep's live path clears it bit-wise).
    push(it, la_b(mov_ri64(rdx, GC_SCANNED_BIT) + test_rr(rdx, rax)))
    push(it, la_jcc(CC_NE, "gc_pw_next"))
    push(it, la_b(mov_rr(rdx, rax) + mov_ri64(rcx, GC_SCANNED_BIT) + or_rr(rdx, rcx) + mov_mr(r9, 0, rdx) + mov_rr(rax, rdx)))
    push(it, la_b(mov_rr(rdx, rax) + mov_ri64(rcx, GC_SIZE_MASK) + and_rr(rdx, rcx)))
    // desc_id = (hdr>>40) & GC_DESC_MASK；r8 = desc 表基址 + desc_id（条目首字节）
    // desc_id = (hdr>>40) & GC_DESC_MASK; r8 = desc table base + desc_id (the
    // entry's first byte)
    push(it, la_b(mov_rr(rcx, rax) + shr_ri(rcx, 40) + mov_ri64(rdi, GC_DESC_MASK) + and_rr(rcx, rdi)))
    push(it, la_b(mov_ri64(r8, rt_slot(rt_desc_table)) + mov_rm(r8, r8, 0) + add_rr(r8, rcx)))
    push(it, la_b(movzx_rm8(rdi, r8, 0) + cmp_ri32(rdi, 1)))
    push(it, la_jcc(CC_E, "gc_sw_words"))
    push(it, la_b(cmp_ri32(rdi, 2)))
    push(it, la_jcc(CC_E, "gc_sw_words"))
    push(it, la_b(cmp_ri32(rdi, 3)))
    push(it, la_jcc(CC_E, "gc_sw_bitmap"))
    // P3 批 2：prefix(4) 不再落空——旧分支「跳过全部前缀词 + 尾 kind 0 不扫」
    // 让 list 的数组指针永不被 mark（列表活着、数组与元素整链死亡，详见
    // gc_sw_prefix 处注释）。list 形状专扫块外元素区，其余 prefix 形状并入全词扫。
    // P3 batch 2: prefix(4) no longer falls through — the old branch ("skip
    // every prefix word; tail kind 0 scans nothing") never marked the list's
    // array pointer (list alive, array + elements collected wholesale; see the
    // gc_sw_prefix note). The list shape gets a dedicated out-of-block element
    // walk; other prefix shapes fold into the all-words scan.
    push(it, la_b(cmp_ri32(rdi, 4)))
    push(it, la_jcc(CC_E, "gc_sw_prefix"))
    push(it, la_jmp("gc_pw_next"))
    // words：全词扫 / all words scanned
    push(it, la_l("gc_sw_words"))
    push(it, la_b(shr_ri(rdx, 3) + xor_rr(rcx, rcx) + lea(r10, r9, 8)))
    push(it, la_jmp("gc_scan"))
    // prefix：list 形状（prefix=3）的元素区在块外——[len][cap][data 指针]，
    // 元素指针躺在 data 数组里。P2 设计注释写明「尾元素区按元素 kind」，实现
    // 却从未跟随 data 指针：数组块与全部元素首轮 collect 即不可达（gc_stress
    // 的 kept[0] 串被 sweep 链节点 [next][cap] 覆盖成空串，watchpoint 实锤）。
    // 此处补齐：mark(data 指针) 保活数组块，再按 len 逐词 mark 元素（list-s
    // 标量元素的位样由 mark 三重过滤安全拒绝；[len, cap) 的滞后槽位是悬垂
    // 指针，不扫）。其余 prefix 形状（cell/
    // lenptrs/caplenptrs）指针都在块内，并进全词扫即可。
    // prefix: the list shape (prefix=3) keeps its element region OUT of the
    // block — [len][cap][data pointer], the element pointers living in the
    // data array. The P2 design note says "the tail element region scans per
    // the element kind", but the walk never followed the data pointer: the
    // array block and all its elements went unreachable at the first collect
    // (gc_stress's kept[0] string overwritten by a sweep chain node's
    // [next][cap] into an empty string — watchpoint-confirmed). This fills it
    // in: mark(data ptr) keeps the array block alive, then every array word
    // under len gets mark()ed (list-s scalar bit patterns fall to mark's three
    // gates; the stale slots [len, cap) hold dangling pointers into freed
    // blocks and must not retain them). Other prefix shapes (cell/lenptrs/
    // caplenptrs) keep their pointers in-block and fold into the all-words
    // scan.
    push(it, la_l("gc_sw_prefix"))
    push(it, la_b(movzx_rm8(rcx, r8, 1) + cmp_ri32(rcx, 3)))
    push(it, la_jcc(CC_NE, "gc_sw_words"))
    push(it, la_l("gc_sw_list"))
    // r9 指向 hdr：payload 三词在 [r9+8]=len、[r9+16]=cap、[r9+24]=data 指针
    // （首版写成 +16/+8——把 payload 相对序当 hdr 相对序，cap 被当地址解引用
    // 即 SEGV）。元素界取 len 而非 cap：[len, cap) 的滞后槽位是悬垂指针，
    // 误 mark 会把已死元素整链保活。数组块本身也要 mark（否则 sweep 链节点
    // 覆盖 elem 槽位），mark 的入参寄存器是 rdi。
    // r9 points at the hdr: the three payload words live at [r9+8]=len,
    // [r9+16]=cap, [r9+24]=data pointer (the first cut wrote +16/+8 — payload
    // relative treated as hdr relative — and the cap got dereferenced as an
    // address = SEGV). The element bound is len, not cap: the stale slots in
    // [len, cap) are dangling pointers, and mis-marking them keeps whole
    // chains of dead elements alive. The array block itself must be mark()ed
    // too (else the sweep chain node overwrites the element slots); mark's
    // argument register is rdi.
    push(it, la_b(mov_rm(r10, r9, 24) + mov_rr(rdi, r10) + mark_call + mov_rm(r11, r9, 8) + xor_rr(rcx, rcx)))
    push(it, la_l("gc_list_loop"))
    push(it, la_b(cmp_rr(rcx, r11)))
    push(it, la_jcc(CC_AE, "gc_pw_next"))
    push(it, la_b(mov_rr(rdi, rcx) + shl_ri(rdi, 3) + add_rr(rdi, r10) + mov_rm(rdi, rdi, 0) + mark_call + add_ri32(rcx, 1)))
    push(it, la_jmp("gc_list_loop"))
    // bitmap：位图逐词（容量 = 表尾余量×8）/ bitmap: per-bit, capped by the
    // table's tail margin ×8
    push(it, la_l("gc_sw_bitmap"))
    push(it, la_b(shr_ri(rdx, 3) + mov_ri64(rax, GC_DESC_TABLE_LEN) + sub_rr(rax, rcx) + sub_ri32(rax, 1) + shl_ri(rax, 3)))
    push(it, la_b(cmp_rr(rdx, rax)))
    push(it, la_jcc(CC_BE, "gc_bm_cap"))
    push(it, la_b(mov_rr(rdx, rax)))
    push(it, la_l("gc_bm_cap"))
    // 字节指针走 r11：rax 跨 mark_call 会被调用序列覆写（mov_ri64 进 rax）
    // the byte pointer lives in r11: rax is overwritten across mark_call (the
    // call sequence mov_ri64's into rax)
    push(it, la_b(lea(r10, r9, 8) + mov_rr(r11, r8) + add_ri32(r11, 1) + xor_rr(rcx, rcx) + mov_ri64(rsi, 1)))
    push(it, la_l("gc_bm"))
    push(it, la_b(cmp_rr(rcx, rdx)))
    push(it, la_jcc(CC_AE, "gc_pw_next"))
    push(it, la_b(movzx_rm8(rdi, r11, 0) + test_rr(rdi, rsi)))
    push(it, la_jcc(CC_E, "gc_bm_skip"))
    push(it, la_b(mov_rr(rdi, rcx) + shl_ri(rdi, 3) + add_rr(rdi, r10) + mov_rm(rdi, rdi, 0) + mark_call))
    push(it, la_l("gc_bm_skip"))
    push(it, la_b(shl_ri(rsi, 1) + cmp_ri32(rsi, 256)))
    push(it, la_jcc(CC_NE, "gc_bm_noroll"))
    push(it, la_b(mov_ri64(rsi, 1) + add_ri32(r11, 1)))
    push(it, la_l("gc_bm_noroll"))
    push(it, la_b(add_ri32(rcx, 1)))
    push(it, la_jmp("gc_bm"))
    // 共享词扫尾：[r10+8i] for i in [rcx, rdx) / shared word-scan tail
    push(it, la_l("gc_scan"))
    push(it, la_b(cmp_rr(rcx, rdx)))
    push(it, la_jcc(CC_AE, "gc_pw_next"))
    push(it, la_b(mov_rr(r8, rcx) + shl_ri(r8, 3) + add_rr(r8, r10) + mov_rm(rdi, r8, 0) + mark_call + add_ri32(rcx, 1)))
    push(it, la_jmp("gc_scan"))
    push(it, la_l("gc_pw_next"))
    push(it, la_b(mov_rm(rax, r9, 0) + mov_ri64(rcx, GC_SIZE_MASK) + and_rr(rax, rcx) + lea(r9, r9, 8) + add_rr(r9, rax)))
    push(it, la_jmp("gc_pw"))
    push(it, la_l("gc_pw_done"))
    // 收敛判定：cnt 与快照同 → sweep / convergence: cnt unchanged -> sweep
    push(it, la_b(mov_ri64(rax, rt_slot(rt_gc_cnt)) + mov_rm(rcx, rax, 0) + mov_rm(rdx, rsp, 112) + cmp_rr(rcx, rdx)))
    push(it, la_jcc(CC_NE, "gc_outer"))
    // sweep：MARK+SCANNED 清位保活；已 FREE（上轮入链未复用）跳过；其余置
    // FREE + desc 换 NOSCAN + 链入自由链（poison 开时 payload 填 0xAB）
    // sweep: MARK set -> clear (SCANNED too) and keep; already-FREE (chained
    // last round, unreused) -> skip; else FREE + desc swapped to NOSCAN +
    // chained into the free list (payload filled with 0xAB when poison is on)
    push(it, la_b(mov_ri64(r9, rt_slot(rt_heap_start)) + mov_rm(r9, r9, 0) + xor_rr(r10, r10)))
    push(it, la_l("gc_sw"))
    push(it, la_b(cmp_rr(r9, r12)))
    push(it, la_jcc(CC_AE, "gc_sw_done"))
    push(it, la_b(mov_rm(rax, r9, 0) + mov_ri64(rcx, GC_MARK_BIT) + test_rr(rcx, rax)))
    push(it, la_jcc(CC_NE, "gc_sw_live"))
    // 已 FREE 直接跳推进——重链会让同一块在链上出现两次 = 双重分配
    // already-FREE jumps straight to the advance — re-chaining would list the
    // same block twice = double allocation
    push(it, la_b(mov_ri64(rcx, 1) + shl_ri(rcx, 63) + test_rr(rcx, rax)))
    push(it, la_jcc(CC_NE, "gc_sw_next"))
    push(it, la_b(mov_rr(rdx, rax) + mov_ri64(rcx, GC_SIZE_MASK) + and_rr(rdx, rcx)))
    // FREE 位 63 = 1<<63：imm64 字面量经 e8s 的 0−x 折算会在 i64 下溢，改移位合成。
    // hdr desc 同步换 NOSCAN：野指针把自由块误 mark 时 payload（含链 next）不可
    // 扫，自由链不会整链复活；复用端写 hdr 时连 desc 一起重写。
    // the FREE bit 63 = 1<<63: an imm64 literal would overflow i64 inside e8s's
    // 0-x fold, so synthesize it by shifting. The hdr desc swaps to NOSCAN at
    // the same time: if a stray pointer mis-marks a free block, its payload
    // (including the chain next) must not be scanned or the whole free list
    // revives; the reuse side rewrites the desc along with the hdr anyway.
    push(it, la_b(mov_rr(rax, rdx) + mov_ri64(rcx, desc_noscan * GC_DESC_SHIFT) + or_rr(rax, rcx) + mov_ri64(rcx, 1) + shl_ri(rcx, 63) + or_rr(rax, rcx) + mov_mr(r9, 0, rax) + add_rr(r10, rdx)))
    if gc_poison_g {
        // rep stosb：rdi=payload、rcx=size、AL=0xAB（imm64 任意值低字节即可）
        // rep stosb: rdi=payload, rcx=size, AL=0xAB (any imm64 whose low byte is 0xAB)
        push(it, la_b(mov_rr(rdi, r9) + add_ri32(rdi, 8) + mov_rr(rcx, rdx) + mov_ri64(rax, 171) + e1(243) + e1(170)))
    }
    // 链入尺寸类自由链：8B 载荷走隐式 cap 类，节点只有 [next] 一个字
    //（payload+0），cap 由类隐含；≥16B 按 cap 选类头槽址进 rdi：≤64 走精确类
    //（比较链，jb 严格小于 24/40/72），>64 走幂档——类号 = bsr(cap-1)+1，
    // 槽 = base + (类号-7)*8。节点 = [next:8][cap:8]（payload+0/+8）。8B 块的
    // +8 槽已是下一块 hdr，放不下第二字——类表因此多出 8 这一档。
    // chain into the size-class free list: 8B payloads take the implicit-cap
    // class whose node is the single [next] word (payload+0), cap implied by the
    // class; >= 16B picks the class head slot by cap into rdi: up to 64 the
    // exact classes (compare chain, strict jb bounds 24/40/72), above 64 the
    // power rungs — class = bsr(cap-1)+1, slot = base + (class-7)*8. Node =
    // [next:8][cap:8] (payload+0/+8). An 8B block's +8 slot is already the next
    // block's hdr, so a second node word does not fit — hence the extra 8 rung.
    push(it, la_b(cmp_ri32(rdx, 8)))
    push(it, la_jcc(CC_B, "gc_sw_nolink"))
    push(it, la_jcc(CC_E, "gc_sw_link8"))
    let sel_big = mov_rr(rdi, rdx) + sub_ri32(rdi, 1) + bsr_rr(rdi, rdi) + sub_ri32(rdi, 6) + shl_ri(rdi, 3) + mov_ri64(rcx, rt_slot(rt_free_class_base)) + add_rr(rdi, rcx)
    let sel2 = mov_ri64(rdi, rt_slot(rt_free64)) + cmp_ri32(rdx, 72) + jb_rel32(str_len(sel_big))
    let sel1 = mov_ri64(rdi, rt_slot(rt_free32)) + cmp_ri32(rdx, 40) + jb_rel32(str_len(sel2) + str_len(sel_big))
    let sel0 = mov_ri64(rdi, rt_slot(rt_free16)) + cmp_ri32(rdx, 24) + jb_rel32(str_len(sel1) + str_len(sel2) + str_len(sel_big))
    push(it, la_b(sel0 + sel1 + sel2 + sel_big + mov_rm(rcx, rdi, 0) + mov_mr(r9, 8, rcx) + mov_mr(r9, 16, rdx) + lea(rcx, r9, 8) + mov_mr(rdi, 0, rcx)))
    let link8 = mov_ri64(rdi, rt_slot(rt_free8)) + mov_rm(rcx, rdi, 0) + mov_mr(r9, 8, rcx) + lea(rcx, r9, 8) + mov_mr(rdi, 0, rcx)
    push(it, la_b(jmp_rel32(str_len(link8))))
    push(it, la_l("gc_sw_link8"))
    push(it, la_b(link8))
    push(it, la_l("gc_sw_nolink"))
    push(it, la_l("gc_sw_next"))
    push(it, la_b(mov_rm(rax, r9, 0) + mov_ri64(rcx, GC_SIZE_MASK) + and_rr(rax, rcx) + lea(r9, r9, 8) + add_rr(r9, rax)))
    push(it, la_jmp("gc_sw"))
    push(it, la_l("gc_sw_live"))
    // 活块清 MARK 必须用 XOR（此时 MARK 必已置位，异或即清位、size/desc 原样
    // 保留）。P2 初版写成 and_rr(rax, rcx)＝hdr & MARK——hdr 只剩 MARK 位、
    // size/desc 全毁成 0，下一轮走查每步只进 8B，把 fb 的字段逐槽当块释放，
    // 节点覆盖 FB_STACK_LO/RSP 后收集器影子扫描解引用 [8] 段错误。该路径在
    // P2/P3 批 1 从未真正执行过——彼时全部 GC 验证（三开关矩阵、hello 探针）
    // 都经 run 走 VM，x86 sweep 直至本批二进制验收才首次落地。
    // a live block's MARK clear must be XOR (MARK is guaranteed set here, so
    // the xor clears exactly that bit and preserves size/desc). The original
    // P2 cut wrote and_rr(rax, rcx) = hdr & MARK — the hdr collapses to the
    // bare MARK bit, the next walk advances 8B per step, frees the fb's fields
    // slot by slot as "blocks", the chained node overwrites FB_STACK_LO/RSP,
    // and the next collect's shadow scan dereferences [8] and segfaults. That
    // path never executed in P2/P3-batch-1: every GC validation back then
    // (matrix, hello probes) went through the VM via run — the x86 sweep only
    // touched silicon with this batch's binary-level acceptance.
    // SCANNED 同步清除（条件式）：收敛证明保证 sweep 时每个 MARK 块必已
    // SCANNED，无条件 XOR 亦可——但若证明有洞，无条件 XOR 会把未置位的块误
    // 置 SCANNED，下一轮 gc_pw 永久跳过其 payload = 活指针漏扫；条件式最坏
    // 只是慢一轮。r10/r9/rax 不动，rcx 复用。
    // SCANNED is cleared at the same time (conditionally): the convergence
    // proof guarantees every MARKed block is SCANNED by sweep time, so an
    // unconditional xor would also do — but if the proof has a hole, the
    // unconditional form would SET the bit on an unscanned block and the next
    // gc_pw would skip its payload forever, dropping live pointers; the
    // conditional form degrades to one slower round at worst. r10/r9/rax stay
    // untouched, rcx is reused.
    push(it, la_b(xor_rr(rax, rcx) + mov_ri64(rcx, GC_SCANNED_BIT) + test_rr(rcx, rax)))
    push(it, la_jcc(CC_E, "gc_sw_sc_done"))
    push(it, la_b(xor_rr(rax, rcx)))
    push(it, la_l("gc_sw_sc_done"))
    push(it, la_b(mov_mr(r9, 0, rax)))
    push(it, la_b(mov_rm(rax, r9, 0) + mov_ri64(rcx, GC_SIZE_MASK) + and_rr(rax, rcx) + lea(r9, r9, 8) + add_rr(r9, rax)))
    push(it, la_jmp("gc_sw"))
    push(it, la_l("gc_sw_done"))
    push(it, la_b(mov_ri64(rax, rt_slot(rt_gc_cycles)) + mov_rm(rcx, rax, 0) + add_ri32(rcx, 1) + mov_mr(rax, 0, rcx)))
    push(it, la_b(mov_ri64(rax, rt_slot(rt_gc_last_freed)) + mov_mr(rax, 0, r10)))
    // P3 阈值步进：下一轮回收点 = 当前堆顶 + clamp(堆跨度/4, MIN, MAX)。固定
    // 16MiB 步进下 collect 次数随堆线性增长，而每次 sweep 重走整堆 ⇒ O(堆²)；
    // 几何步进在 12GiB 跨度下只回收几十次。跨度与界都是非负小数，有符号条件
    // 跳转与无符号等价。
    // 不钳 limit：collect 后 threshold = r12 + slack > r12，钩子不会连环 fire；
    // threshold 越过 limit 后钩子在终盘永久静音，回收由分配站点的 bump-fail
    // 保底 collect 驱动。钳到 limit − MIN 曾把 threshold 锁死在 r12 附近，每
    // 个 bump 后的分配点（含 reuse 命中）连环全堆 collect——12GiB 单轮 376s，
    // 终盘 2h 零推进。
    // P3 threshold step: the next collection point = the current heap top +
    // clamp(heap span / 4, MIN, MAX). With a fixed 16MiB step the collect count
    // grows linearly with the heap while every sweep re-walks the whole heap
    // (O(heap²)); the geometric step collects a few dozen times at a 12GiB span.
    // The span and bounds are non-negative small values, so signed conditionals
    // match the unsigned ones.
    // No limit clamp: after a collect the threshold sits at r12 + slack > r12,
    // so the hook never chain-fires; once the threshold passes the limit the
    // hook goes permanently silent in the endgame and reclamation is driven by
    // the alloc sites' bump-fail fallback collect. Clamping to limit − MIN used
    // to pin the threshold next to r12, chaining a whole-heap collect after
    // every bump (reuse hits included) — 376s per 12GiB round, 2h of zero
    // progress.
    let span_slack = mov_ri64(rcx, rt_slot(rt_heap_start)) + mov_rm(rcx, rcx, 0) + mov_rr(rdx, r12) + sub_rr(rdx, rcx) + shr_ri(rdx, 2) + mov_ri64(rcx, GC_THRESH_MAX) + cmp_rr(rdx, rcx) + jle_rel32(str_len(mov_rr(rdx, rcx))) + mov_rr(rdx, rcx) + mov_ri64(rcx, GC_THRESH_MIN) + cmp_rr(rdx, rcx) + jge_rel32(str_len(mov_rr(rdx, rcx))) + mov_rr(rdx, rcx)
    push(it, la_b(mov_ri64(rax, rt_slot(rt_gc_threshold)) + span_slack + add_rr(rdx, r12) + mov_mr(rax, 0, rdx)))
    // 出口：逆序弹 14 个 GPR，还快照区，ret
    push(it, la_b(pop_r(r15) + pop_r(r14) + pop_r(r13) + pop_r(r11) + pop_r(r10) + pop_r(r9) + pop_r(r8) + pop_r(rdi) + pop_r(rsi) + pop_r(rbp) + pop_r(rbx) + pop_r(rdx) + pop_r(rcx) + pop_r(rax) + add_ri32(rsp, 16) + ret()))
    la_link(it)
}

// x86gen_heap_objects_block：heap_objects 内建体——沿 hdr 链走查 [heap_start, r12)，
// 数 FREE 位（位 63）未置的块。heap_objects 的语义 = 当前存活对象数；P2 初版误读
// rt_gc_cnt（只是上一轮 collect 的 mark 计数，collect 前恒 0），gc_stress.bur 的
// after_churn > before 断言因此在 x86 假红（VM/C 用真实存活计数，两边不等）。
// 保存 rax/rcx/rdx/r9/r10（push/pop），r12/rbx 只读；毁 FLAGS。
// x86gen_heap_objects_block: the heap_objects builtin body — walk the hdr chain
// over [heap_start, r12) counting blocks whose FREE bit (bit 63) is clear.
// heap_objects' semantics = the current live-object count; the first P2 cut
// misread rt_gc_cnt (only the last collect's mark count, always 0 before any
// collect), which tripped gc_stress.bur's after_churn > before assertion on
// x86 (VM/C use a true live count, so the three disagreed). Saves
// rax/rcx/rdx/r9/r10 (push/pop), reads r12/rbx; clobbers FLAGS.
fn x86gen_heap_objects_block() {
    let mut it = []
    push(it, la_b(push_r(rax) + push_r(rcx) + push_r(rdx) + push_r(r9) + push_r(r10)))
    push(it, la_b(mov_ri64(r9, rt_slot(rt_heap_start)) + mov_rm(r9, r9, 0) + xor_rr(rcx, rcx) + mov_ri64(r10, 1) + shl_ri(r10, 63)))
    push(it, la_l("ho_loop"))
    push(it, la_b(cmp_rr(r9, r12)))
    push(it, la_jcc(CC_AE, "ho_done"))
    push(it, la_b(mov_rm(rax, r9, 0) + test_rr(r10, rax)))
    push(it, la_jcc(CC_NE, "ho_next"))
    push(it, la_b(add_ri32(rcx, 1)))
    push(it, la_l("ho_next"))
    push(it, la_b(mov_rr(rdx, rax) + mov_ri64(rax, GC_SIZE_MASK) + and_rr(rdx, rax) + lea(r9, r9, 8) + add_rr(r9, rdx)))
    push(it, la_jmp("ho_loop"))
    push(it, la_l("ho_done"))
    push(it, la_b(mov_mr(r15, 0 - 8, rcx)))
    push(it, la_b(pop_r(r10) + pop_r(r9) + pop_r(rdx) + pop_r(rcx) + pop_r(rax)))
    la_link(it)
}
