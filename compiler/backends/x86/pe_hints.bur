// pe_hints.bur — hints size。
// pe_hints.bur — hints size.



// pe_hints_size 累计 hint/name 段尺寸（每项 2B hint + 名字 + NUL，补偶）
// pe_hints_size totals the hint/name segment (per entry 2B hint + name + NUL, even-padded)
pub fn pe_hints_size(fns) {
    let mut acc = 0
    let mut i = 0
    while i < len(fns) {
        let raw = 2 + str_len(fns[i]) + 1
        acc = acc + raw + raw % 2
        i = i + 1
    }
    acc
}
