// emit_payload.bur — payload enc。
// emit_payload.bur — payload enc.

import "burryn.dev/compiler/lib"

// enum_payload_enc 生成内置枚举 payload 编码 / enum_payload_enc builds a builtin enum payload encoding
fn enum_payload_enc(mut enum_field_types, qual, payloads) {
    reg_enum_type(enum_field_types, qual, payloads)
}

// enum_payload_enc_ctx：经 ctx 字段注册（put 作用于堆上的 map，不需把字段当 mut 参数传出）
// enum_payload_enc_ctx registers via the ctx field (put mutates the heap map; no mut field arg)
fn enum_payload_enc_ctx(ctx: record { f_name: [str], f_arity: [int], f_nupvals: [int], f_code: [[int]], f_consts: [[lib::CVal]], en_qual: [str], en_vnames: [[str]], nfn: int, f2s_h: int, const_slot_map: map(int, int), record_encs: [str], record_offs: [int], record_field_types: map(str, [str]), enum_field_types: map(str, [[str]]), enum_variant_types: map(str, [str]), out_enc: str, res_out_enc: str, res_int_enc: str, opt_res_enc: str, global_type: map(str, str), sig_specs: map(str, [str]), sig_ret: map(str, str), p_sig_grew: [bool], method_full_map: map(str, int), created_by: map(int, [int]), fn_ret_type: [str], fn_ret_param: [int], fn_param_types: [[str]], fn_variants: [[[str]]] }, qual, payloads) {
    let key = enum_field_key(qual, payloads)
    put(ctx.enum_field_types, key, payloads)
    key
}
