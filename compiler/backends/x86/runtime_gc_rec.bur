// runtime_gc_rec.bur — GC 记录插桩。
// runtime_gc_rec.bur — GC record stubs.

// gc_rec 生成分配记录插桩（rdi=ptr 寄存器, size 立即数或寄存器；保存调用方 rdi/rsi）
// gc_rec emits the alloc-recording stub (rdi=ptr register, size immediate
// or register; preserves caller rdi/rsi)
fn gc_rec(ptr_reg, size) {
    let call = mov_ri64(r8, rt_slot(rt_gc_record_fn)) + mov_rm(r8, r8, 0) + call_r(r8)
    push_r(rdi) + push_r(rsi) + push_r(r8) + mov_rr(rdi, ptr_reg) + size + call + pop_r(r8) + pop_r(rsi) + pop_r(rdi)
}
