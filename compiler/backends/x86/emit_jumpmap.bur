// emit_jumpmap.bur — 跳转目标/局部计数。
// emit_jumpmap.bur — jump targets / local count.

import "burryn.dev/compiler/lib"

// jump_targets 构建跳转目标表 / jump_targets builds the jump target table
fn jump_targets(ctx: record { f_name: [str], f_arity: [int], f_nupvals: [int], f_code: [[int]], f_consts: [[lib::CVal]], en_qual: [str], en_vnames: [[str]], nfn: int, f2s_h: int, const_slot_map: map(int, int), record_encs: [str], record_offs: [int], record_field_types: map(str, [str]), enum_field_types: map(str, [[str]]), enum_variant_types: map(str, [str]), out_enc: str, res_out_enc: str, res_int_enc: str, opt_res_enc: str, global_type: map(str, str), sig_specs: map(str, [str]), sig_ret: map(str, str), p_sig_grew: [bool], method_full_map: map(str, int), created_by: map(int, [int]), fn_ret_type: [str], fn_ret_param: [int], fn_param_types: [[str]], fn_variants: [[[str]]] }, fh) {
    let code = ctx.f_code[fh]
    let mut targets = map()
    let mut ip = 0
    while ip < len(code) {
        let op = code[ip]
        if op == lib::op_jump || op == lib::op_jump_if_false || op == lib::op_jump_if_true || op == lib::op_jump_if_false_pop {
            put(targets, ip + 3 + read_u16(code, ip + 1), true)
            ip = ip + 3
        } else if op == lib::op_loop {
            put(targets, ip + 3 - read_u16(code, ip + 1), true)
            ip = ip + 3
        } else if op == lib::op_chan_next {
            put(targets, ip + 3 + read_u16(code, ip + 1), true)
            ip = ip + 3
        } else if op == lib::op_select {
            let mut p = ip + 1
            let n_arms = code[p]
            let has_default = code[p + 1] != 0
            p = p + 2
            let mut i = 0
            while i < n_arms {
                p = p + 1
                put(targets, p + 2 + read_u16(code, p), true)
                p = p + 2
                i = i + 1
            }
            if has_default {
                put(targets, p + 2 + read_u16(code, p), true)
                p = p + 2
            }
            ip = p
        } else {
            ip = ip + inst_len(ctx, fh, code, ip)
        }
    }
    targets
}

