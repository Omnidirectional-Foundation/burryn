// emit_enum_resolve.bur — 字段解析。
// emit_enum_resolve.bur — field resolve.

import "burryn.dev/compiler/lib"

// enum_fields_for_variant 取某 variant 的字段类型 / enum_fields_for_variant fetches a variant's field
// types
fn enum_fields_for_variant(ctx: record { f_name: [str], f_arity: [int], f_nupvals: [int], f_code: [[int]], f_consts: [[lib::CVal]], en_qual: [str], en_vnames: [[str]], nfn: int, f2s_h: int, const_slot_map: map(int, int), record_encs: [str], record_offs: [int], record_field_types: map(str, [str]), enum_field_types: map(str, [[str]]), enum_variant_types: map(str, [str]), out_enc: str, res_out_enc: str, res_int_enc: str, opt_res_enc: str, global_type: map(str, str), sig_specs: map(str, [str]), sig_ret: map(str, str), p_sig_grew: [bool], method_full_map: map(str, int), created_by: map(int, [int]), fn_ret_type: [str], fn_ret_param: [int], fn_param_types: [[str]], fn_variants: [[[str]]] }, enc, vidx) {
    match get(ctx.enum_field_types, enc) {
        Some(vts) => {
            if vidx >= 0 && vidx < len(vts) {
                vts[vidx]
            } else {
                []
            }
        },
        None => [],
    }
}
