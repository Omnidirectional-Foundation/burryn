// pe_test.bur — pe.bur 的 bur test 套件：.pdata / UNWIND_INFO 编码
// bur test suite for pe.bur: .pdata / UNWIND_INFO encoding

fn test_pe_unwind_info() {
    let uw = pe_unwind_info()
    let want = byte_chr(1) + byte_chr(5) + byte_chr(2) + byte_chr(0) + byte_chr(5) + byte_chr(2) + byte_chr(1) + byte_chr(80)
    assert(uw == want, "header(ver1/flags0,prolog5,codes2,frame0) + ALLOC_SMALL(sub rsp,8 @5) + PUSH_NONVOL(rbp=5 @1)")
}

fn test_pe_build_pdata_single() {
    let pdata = pe_build_pdata([0], [100], 4096, 5000)
    let want = e4(pe_content_rva(4096)) + e4(pe_content_rva(4196)) + e4(pe_content_rva(5000))
    assert(pdata == want, "single RUNTIME_FUNCTION: begin/end/unwind RVAs")
}

// 前提：offs/lens 已按调用方发射顺序（=地址升序）传入，本函数只逐项映射，不排序
// precondition: offs/lens arrive in the caller's emission order (= ascending
// address); this function only maps entries across, it does not sort
fn test_pe_build_pdata_multi_shares_one_unwind() {
    let code_base = 4096
    let unwind_off = 9999
    let offs = [0, 100, 250]
    let lens = [50, 100, 30]
    let pdata = pe_build_pdata(offs, lens, code_base, unwind_off)
    let want = e4(pe_content_rva(code_base + 0)) + e4(pe_content_rva(code_base + 50)) + e4(pe_content_rva(unwind_off)) + e4(pe_content_rva(code_base + 100)) + e4(pe_content_rva(code_base + 200)) + e4(pe_content_rva(unwind_off)) + e4(pe_content_rva(code_base + 250)) + e4(pe_content_rva(code_base + 280)) + e4(pe_content_rva(unwind_off))
    assert(pdata == want, "3 entries: begin=base+off, end=begin+len, all sharing one UnwindInfoAddress")
}

fn test_pe_build_pdata_empty() {
    assert(pe_build_pdata([], [], 4096, 5000) == "", "no functions means an empty RUNTIME_FUNCTION array")
}

fn test_pe_unwind_info_zero() {
    let uw = pe_unwind_info_zero()
    let want = byte_chr(1) + byte_chr(0) + byte_chr(0) + byte_chr(0)
    assert(uw == want, "header(ver1/flags0, prolog0, codes0, frame0), no UNWIND_CODE entries")
}

fn test_pe_unwind_info_pushes_low_registers_odd_count_padded() {
    // rdx(2)/rdi(7)/rsi(6): 3 low registers, 1 byte each -> CodeOffset 1,2,3;
    // codes listed in undo order (rsi,rdi,rdx), padded with one zero slot for
    // the odd count
    let uw = pe_unwind_info_pushes([rdx, rdi, rsi])
    let want = byte_chr(1) + byte_chr(3) + byte_chr(3) + byte_chr(0) + byte_chr(3) + byte_chr(6 * 16) + byte_chr(2) + byte_chr(7 * 16) + byte_chr(1) + byte_chr(2 * 16) + byte_chr(0) + byte_chr(0)
    assert(uw == want, "3 low-register pushes: SizeOfProlog=3, 3 codes in undo order, padded to 4 slots (DWORD alignment)")
}

fn test_pe_unwind_info_pushes_gc_record_shape() {
    // x86gen_gc_record's push3 order: rdx,rdi,rsi,rax,rcx (1B each), r8,r9,r10,r11 (2B each)
    let uw = pe_unwind_info_pushes([rdx, rdi, rsi, rax, rcx, r8, r9, r10, r11])
    let hdr = byte_chr(1) + byte_chr(13) + byte_chr(9) + byte_chr(0)
    let codes = byte_chr(13) + byte_chr(r11 * 16) + byte_chr(11) + byte_chr(r10 * 16) + byte_chr(9) + byte_chr(r9 * 16) + byte_chr(7) + byte_chr(r8 * 16) + byte_chr(5) + byte_chr(rcx * 16) + byte_chr(4) + byte_chr(rax * 16) + byte_chr(3) + byte_chr(rsi * 16) + byte_chr(2) + byte_chr(rdi * 16) + byte_chr(1) + byte_chr(rdx * 16) + byte_chr(0) + byte_chr(0)
    assert(uw == hdr + codes, "gc_record's real 9-push prologue: SizeOfProlog=13 (5x1B+4x2B), 9 codes in undo order padded to 10 slots")
}

fn test_pe_build_pdata_multi_per_entry_unwind() {
    let pdata = pe_build_pdata_multi([0, 50], [30, 40], 4096, [5000, 6000])
    let want = e4(pe_content_rva(4096)) + e4(pe_content_rva(4126)) + e4(pe_content_rva(5000)) + e4(pe_content_rva(4146)) + e4(pe_content_rva(4186)) + e4(pe_content_rva(6000))
    assert(pdata == want, "each entry gets its own UnwindInfoAddress instead of one shared value")
}

fn test_pe_build_section_entry_text_and_data() {
    let text = pe_build_section_entry(".text", 100, 4096, 512, 1024, 1610612768)
    let want_text = ".text" + byte_chr(0) + byte_chr(0) + byte_chr(0) + e4(100) + e4(4096) + e4(512) + e4(1024) + e4(0) + e4(0) + e2(0) + e2(0) + e4(1610612768)
    assert(text == want_text, ".text entry: CODE|EXECUTE|READ (0x60000020), code domain at RVA 4096")
    let data = pe_build_section_entry(".data", 5168, DATA_VA_OFF, 5632, 1536, 3221225536)
    let want_data = ".data" + byte_chr(0) + byte_chr(0) + byte_chr(0) + e4(5168) + e4(DATA_VA_OFF) + e4(5632) + e4(1536) + e4(0) + e4(0) + e2(0) + e2(0) + e4(3221225536)
    assert(data == want_data, ".data entry: INITIALIZED_DATA|READ|WRITE (0xC0000040) at the fixed high RVA, no execute bit")
}

fn test_pe_emit_headers_sections_adjacent_across_data_hole() {
    let hdr = pe_emit_headers(0, 100000, DATA_VA_OFF, 16, 0, 0, 5000)
    assert(substr(hdr, 70, 2) == e2(3), "three sections: .text, the .bss gap filler and .data")
    let gap_va = 4096 + pe_align(100000, 4096)
    let want_text = pe_build_section_entry(".text", 100000, 4096, pe_align(100000, 512), 1024, 1610612768)
    let want_gap = pe_build_section_entry(".bss", DATA_VA_OFF - gap_va, gap_va, 0, 0, 1073741952)
    let want_data = pe_build_section_entry(".data", 5000, DATA_VA_OFF, pe_align(5000, 512), 1024 + pe_align(100000, 512), 3221225536)
    assert(substr(hdr, 328, 120) == want_text + want_gap + want_data, "section VAs ascend and are adjacent: the filler spans .text's aligned end up to DATA_VA_OFF")
}
