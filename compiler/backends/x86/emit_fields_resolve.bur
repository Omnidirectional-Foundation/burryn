// emit_fields_resolve.bur — fields_resolve。
// emit_fields_resolve.bur — fields_resolve.

import "burryn.dev/compiler/lib"

// enum_fields_resolve 从枚举编码解析 variant 字段类型（先全表后用户 variant 表）
// enum_fields_resolve resolves a variant's field types (full table first, then the user
// variant table)
fn enum_fields_resolve(ctx: record { f_name: [str], f_arity: [int], f_nupvals: [int], f_code: [[int]], f_consts: [[lib::CVal]], en_qual: [str], en_vnames: [[str]], nfn: int, f2s_h: int, const_slot_map: map(int, int), record_encs: [str], record_offs: [int], record_field_types: map(str, [str]), enum_field_types: map(str, [[str]]), enum_variant_types: map(str, [str]), out_enc: str, res_out_enc: str, res_int_enc: str, opt_res_enc: str, global_type: map(str, str), sig_specs: map(str, [str]), sig_ret: map(str, str), p_sig_grew: [bool], method_full_map: map(str, int), created_by: map(int, [int]), fn_ret_type: [str], fn_ret_param: [int], fn_param_types: [[str]], fn_variants: [[[str]]] }, enc, vidx) {
    if str_len(enc) > 6 && substr(enc, 0, 6) == "enum:e" {
        match str_index_of(enc, "#") {
            Some(hash) => {
                let rest = substr(enc, hash, str_len(enc) - hash)
                let mut start = 0
                let mut i = 0
                while i <= str_len(rest) {
                    if i == str_len(rest) || substr(rest, i, 1) == ";" {
                        let chunk = substr(rest, start, i - start)
                        if str_len(chunk) > 1 && substr(chunk, 0, 1) == "#" {
                            match str_index_of(chunk, ":") {
                                Some(col) => {
                                    match parse_int(substr(chunk, 1, col - 1)) {
                                        Some(avi) => {
                                            if avi == vidx {
                                                let ts = substr(chunk, col + 1, str_len(chunk) - col - 1)
                                                let mut fields = []
                                                if str_len(ts) > 0 {
                                                    let mut st = 0
                                                    let mut j = 0
                                                    while j <= str_len(ts) {
                                                        if j == str_len(ts) || substr(ts, j, 1) == "," {
                                                            push(fields, substr(ts, st, j - st))
                                                            st = j + 1
                                                        }
                                                        j = j + 1
                                                    }
                                                }
                                                return fields
                                            }
                                        },
                                        None => {},
                                    }
                                },
                                None => {},
                            }
                        }
                        start = i + 1
                    }
                    i = i + 1
                }
            },
            None => {},
        }
    }
    let full = enum_fields_for_variant(ctx, enc, vidx)
    if len(full) > 0 {
        full
    } else if str_len(enc) > 6 && substr(enc, 0, 6) == "enum:e" {
        let eh_body = substr(enc, 6, str_len(enc) - 6)
        let mut eh_n = 0
        while eh_n < str_len(eh_body) {
            let ch = substr(eh_body, eh_n, 1)
            if ch < "0" || ch > "9" {
                break
            }
            eh_n = eh_n + 1
        }
        let eh_s = if eh_n > 0 {
            substr(eh_body, 0, eh_n)
        } else {
            eh_body
        }
        match parse_int(eh_s) {
            Some(eh_v) => enum_variant_fields(ctx, eh_v, vidx),
            None => [],
        }
    } else {
        []
    }
}
