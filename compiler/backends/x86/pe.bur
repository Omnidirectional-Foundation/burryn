    let getsockopt_case = mov_mr(rsp, 40, r10) + pe_fd_lookup(iat, str_len(go_val) + str_len(go_level_chk) + str_len(go_name_chk) + str_len(go_call)) + go_val + go_level_chk + go_name_chk + go_call

