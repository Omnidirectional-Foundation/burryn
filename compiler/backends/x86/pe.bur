    let so_val = mov_rm(r9, rsp, 40)
    let setsockopt_case = mov_mr(rsp, 40, r10) + pe_fd_lookup(iat, str_len(so_val) + str_len(so_level_chk) + str_len(so_name_chk) + str_len(so_call)) + so_val + so_level_chk + so_name_chk + so_call

