    // +48=w，+56=超时，+64=staged 基址。正向循环把命中条目译进 Windows 静态
    // WSAPOLLFD 暂存（miss 记 POLLNVAL 不进数组）；调 WSAPoll（本体失败返 0
    // 事件，负值会触发调用方的 EINTR 重试环）；回写循环按同一顺序重走，
    // scratch[w] 的 WS revents 译回 staged+6。
    // poll_ws_block: the nfds>0 WSAPoll translation. On entry rdi stages base
    // (POLLFD_BASE, Linux pollfd 8B records), rsi holds nfds, rdx the timeout
    // milliseconds. Dispatcher locals: +40=i, +48=w, +56=timeout, +64=staged
    // base. The forward loop stages hit entries into the Windows static
    // WSAPollFD scratch (misses record POLLNVAL and stay out of the array);
    // a WSAPoll failure of its own returns zero events (a negative would trip
    // the caller's EINTR retry loop); the writeback loop replays the same order
    // and translates scratch[w] WS revents back into staged+6.
    let pw_b_wr = mov_mr16(r8, 6, r10)
    let pw_b_or8 = mov_ri64(rcx, 8) + or_rr(r10, rcx)
    let pw_b_c3 = mov_rr(rax, rdx) + mov_ri64(rcx, 0 - 273) + and_rr(rax, rcx) + test_rr(rax, rax) + je_rel32(str_len(pw_b_or8)) + pw_b_or8
    let pw_b_or4 = mov_ri64(rcx, 4) + or_rr(r10, rcx)
    let pw_b_c2 = mov_ri64(rax, 16) + test_rr(rdx, rax) + je_rel32(str_len(pw_b_or4)) + pw_b_or4
    let pw_b_or1 = mov_ri64(rcx, 1) + or_rr(r10, rcx)
    let pw_b_c1 = mov_ri64(rax, 256) + test_rr(rdx, rax) + je_rel32(str_len(pw_b_or1)) + pw_b_or1
    let pw_b_z = xor_rr(r10, r10)
    let pw_b_rev = mov_rm32(rdx, r9, 10) + mov_ri64(rcx, 65535) + and_rr(rdx, rcx)
    let pw_b_winc = mov_rm(rax, rsp, 48) + add_ri32(rax, 1) + mov_mr(rsp, 48, rax)
    let pw_b_hit = ws_ptr_at_w() + pw_b_rev + pw_b_z + pw_b_c1 + pw_b_c2 + pw_b_c3 + pw_b_wr + pw_b_winc
    let pw_b_pred = mov_rm32(rcx, r8, 6) + mov_ri64(r10, 65535) + and_rr(rcx, r10) + test_rr(rcx, rcx) + jne_rel32(str_len(pw_b_hit))
    let pw_b_inc = mov_rm(rax, rsp, 40) + add_ri32(rax, 1) + mov_mr(rsp, 40, rax)
    let pw_b_body = pw_stage_entry() + pw_b_pred + pw_b_hit + pw_b_inc
    let pw_b_top = mov_rm(rax, rsp, 40) + cmp_rr(rax, rsi) + jge_rel32(str_len(pw_b_body) + 5)
    let pw_b_back = jmp_rel32(0 - (str_len(pw_b_top) + str_len(pw_b_body) + 5))
    let pw_b_loop = pw_b_top + pw_b_body + pw_b_back
    let pw_zero = xor_rr(rax, rax)
    let pw_map = test_rr(rax, rax) + jge_rel32(str_len(pw_zero)) + pw_zero
    let pw_call = mov_ri64(rcx, wsa_base() + WSA_POLL) + mov_rm(rdx, rsp, 48) + mov_rm(r8, rsp, 56) + mov_ri64(r10, iat[28]) + e1(65) + e1(255) + e1(18) + cdqe() + pw_map
    let pw_wzero = xor_rr(rax, rax) + jmp_rel32(str_len(pw_call) + str_len(pw_map))
    let pw_w_chk = mov_rm(rax, rsp, 48) + test_rr(rax, rax) + jne_rel32(str_len(pw_wzero)) + pw_wzero
    let pw_f_miss = mov_ri64(rcx, 32) + mov_mr16(r8, 6, rcx)
    let pw_f_hit_jmp = jmp_rel32(str_len(pw_f_miss))
    let pw_f_winc = mov_rm(rax, rsp, 48) + add_ri32(rax, 1) + mov_mr(rsp, 48, rax)
    let pw_f_store_rev0 = mov_mr16(r9, 10, rcx)
    let pw_f_zero = xor_rr(rcx, rcx)
    let pw_f_store_ev = mov_mr16(r9, 8, r10)
    let pw_f_or2 = mov_ri64(rcx, 16) + or_rr(r10, rcx)
    let pw_f_c2 = mov_ri64(rax, 4) + test_rr(rdx, rax) + je_rel32(str_len(pw_f_or2)) + pw_f_or2
    let pw_f_or1 = mov_ri64(rcx, 256) + or_rr(r10, rcx)
    let pw_f_c1 = mov_ri64(rax, 1) + test_rr(rdx, rax) + je_rel32(str_len(pw_f_or1)) + pw_f_or1
    let pw_f_z = xor_rr(r10, r10)
    let pw_f_store_sock = mov_rm(rcx, r11, 0) + mov_mr(r9, 0, rcx)
    let pw_f_ev = mov_rm32(rdx, r8, 4) + mov_ri64(rcx, 65535) + and_rr(rdx, rcx)
    let pw_f_hit = pw_stage_entry() + pw_f_ev + ws_ptr_at_w() + pw_f_store_sock + pw_f_z + pw_f_c1 + pw_f_c2 + pw_f_store_ev + pw_f_zero + pw_f_store_rev0 + pw_f_winc
    let pw_f_lookup = pe_fd_lookup(iat, str_len(pw_f_hit) + str_len(pw_f_hit_jmp))
    let pw_f_entry = pw_stage_entry() + mov_rm32(rcx, r8, 0) + mov_rr(rdi, rcx)
    let pw_f_inc = mov_rm(rax, rsp, 40) + add_ri32(rax, 1) + mov_mr(rsp, 40, rax)
    let pw_f_body = pw_f_entry + pw_f_lookup + pw_f_hit + pw_f_hit_jmp + pw_f_miss + pw_f_inc
    let pw_f_top = mov_rm(rax, rsp, 40) + cmp_rr(rax, rsi) + jge_rel32(str_len(pw_f_body) + 5)
    let pw_f_back = jmp_rel32(0 - (str_len(pw_f_top) + str_len(pw_f_body) + 5))
    let pw_f_loop = pw_f_top + pw_f_body + pw_f_back
    let poll_ws_init = mov_mr(rsp, 64, rdi) + mov_mr(rsp, 56, rdx) + xor_rr(rax, rax) + mov_mr(rsp, 40, rax) + mov_mr(rsp, 48, rax)
    // 回写按同一顺序重走，i/w 归零：正向结束 i=nfds，不归零回写首判即 jge 退出。
    // The writeback replays the same order with i/w reset: forward leaves i=nfds.
    let pw_b_reset = xor_rr(rax, rax) + mov_mr(rsp, 40, rax) + mov_mr(rsp, 48, rax)
    let poll_ws_block = poll_ws_init + pw_f_loop + pw_w_chk + pw_wzero + pw_call + pw_map + pw_b_reset + pw_b_loop
    // poll(fds=rdi, nfds=rsi, timeout=rdx)：nfds==0 走 Sleep（timer 等待唯一可达
    // 路径，单位同为毫秒）；负超时钳到 Sleep(0) 让步；nfds>0 走 WSAPoll。
    // poll(fds=rdi, nfds=rsi, timeout=rdx): nfds==0 takes Sleep (the only
    // reachable timer-wait path, same millisecond unit); negative timeouts clamp
    // to a Sleep(0) yield; nfds>0 takes WSAPoll (below)
    let slp_arg = mov_rr(rcx, rdx) + test_rr(rdx, rdx) + jge_rel32(str_len(xor_rr(rcx, rcx))) + xor_rr(rcx, rcx)
    let slp_call = mov_ri64(r10, iat[6]) + e1(65) + e1(255) + e1(18) + xor_rr(rax, rax)
    // Sleep 路径必须跳过 WSAPoll 块再落到链尾的 epi 跳转（对照 mp_ret 的写法）；
    // jne 的目标同步后移一个 jmp 的长度。
    // The Sleep path must hop over the WSAPoll block before reaching the
    // chain's epi jump (cf. mp_ret); the jne target moves by one jmp length.
    let poll_ws_jmp = jmp_rel32(str_len(poll_ws_block))
    let poll_case = test_rr(rsi, rsi) + jne_rel32(str_len(slp_arg) + str_len(slp_call) + str_len(poll_ws_jmp)) + slp_arg + slp_call + poll_ws_jmp + poll_ws_block

    // mprotect(addr=rdi, len=rsi, prot=rdx)：唯一调用方传 prot=0（fiber guard）；
    // 0→PAGE_NOACCESS，其余→PAGE_EXECUTE_READWRITE；成功返 0，失败返 -1。
    // out 参数用分派器局部 [+40]（各 case 互斥，可复用）。
    // mprotect(addr=rdi, len=rsi, prot=rdx): the only caller passes prot=0 (the
    // fiber guard); 0→PAGE_NOACCESS, anything else→PAGE_EXECUTE_READWRITE;
    // 0 on success, -1 on failure. The out-param borrows dispatcher local [+40]
    // (cases are mutually exclusive, so locals are reusable).
    let mp_ret = test_rr(rax, rax) + je_rel32(str_len(xor_rr(rax, rax)) + 5 + str_len(mov_ri64(rax, 0 - 1))) + xor_rr(rax, rax) + jmp_rel32(str_len(mov_ri64(rax, 0 - 1))) + mov_ri64(rax, 0 - 1)
    let mprotect_case = mov_rr(rcx, rdi) + mov_ri64(r8, 64) + test_rr(rdx, rdx) + jne_rel32(str_len(mov_ri64(r8, 1))) + mov_ri64(r8, 1) + mov_rr(rdx, rsi) + lea(r9, rsp, 40) + mov_ri64(r10, iat[7]) + e1(65) + e1(255) + e1(18) + mp_ret

    // 1000/1001/1002 FindFirstFileA/FindNextFileA/FindClose：合成号直调，
    // 返回 HANDLE/-1、非零继续/0 收尾、忽略返回值。
    // 1000/1001/1002 FindFirstFileA/FindNextFileA/FindClose: synthetic numbers
    // called directly, returning HANDLE/-1, nonzero-more/0-done, and ignored.
    let findfirst_case = mov_rr(rcx, rdi) + mov_rr(rdx, rsi) + mov_ri64(r10, iat[13]) + e1(65) + e1(255) + e1(18)
    let findnext_case = mov_rr(rcx, rdi) + mov_rr(rdx, rsi) + mov_ri64(r10, iat[14]) + e1(65) + e1(255) + e1(18)
    let findclose_case = mov_rr(rcx, rdi) + mov_ri64(r10, iat[15]) + e1(65) + e1(255) + e1(18) + xor_rr(rax, rax)
    sys_dispatch_chain(head, [1, 60, 9, 228, 7, 10, 3, 2, 0, 4, 5, 1000, 1001, 1002, 41, 49, 50, 42, 43, 54, 55, 72], [write_case, exit_case, mmap_case, clock_case, poll_case, mprotect_case, close_case, open_case, read_case, stat_case, fstat_case, findfirst_case, findnext_case, findclose_case, socket_case, bind_case, listen_case, connect_case, accept_case, setsockopt_case, getsockopt_case, fcntl_case], epilogue)
}

// pe_emit_headers 生成 DOS 头 + COFF + PE32+ 可选头（240B 含 16 个数据目录）+ 单节表
// pe_emit_headers lays out DOS + COFF + PE32+ optional header (240B with 16 data
// directories) + the single section table
pub fn pe_emit_headers(entry_off, content_len, idata_off, idata_len) {
    // DOS：MZ 魔数 + e_lfanew=64，其余补零
    // DOS: MZ magic + e_lfanew=64, zero padding elsewhere
    let mut dos = "MZ"
    let mut di = 2
    while di < 60 {
        dos = dos + byte_chr(0)
        di = di + 1
    }
    dos = dos + e4(64)
    // COFF：AMD64、单节、可执行镜像 + 大地址感知
    // COFF: AMD64, one section, executable image + large-address-aware
    let coff = "PE" + byte_chr(0) + byte_chr(0) + e2(34404) + e2(1) + e4(0) + e4(0) + e4(0) + e2(240) + e2(34)
    let image_size = 4096 + pe_align(content_len, 4096)
    let opt = e2(523) + e1(0) + e1(0) + e4(content_len) + e4(0) + e4(0) + e4(pe_content_rva(entry_off)) + e4(4096) + e8(4194304) + e4(4096) + e4(512) + e2(6) + e2(0) + e2(0) + e2(0) + e2(6) + e2(0) + e4(0) + e4(image_size) + e4(512) + e4(0) + e2(3) + e2(0) + e8(8388608) + e8(1048576) + e8(1048576) + e8(4096) + e4(0) + e4(16)
    // 16 个数据目录，仅 [1]=导入表非零 / sixteen data directories, only [1]=imports set
    let mut dirs = ""
    let mut k = 0
    while k < 16 {
        if k == 1 {
            dirs = dirs + e4(pe_content_rva(idata_off)) + e4(idata_len)
        } else {
            dirs = dirs + e4(0) + e4(0)
        }
        k = k + 1
    }
    // 节表：.bub，CODE|EXECUTE|READ|WRITE
    // Section table: .bub with CODE|EXECUTE|READ|WRITE
    let sect = ".bub" + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + e4(content_len) + e4(4096) + e4(pe_align(content_len, 512)) + e4(512) + e4(0) + e4(0) + e2(0) + e2(0) + e4(3758154784)
    let hdr = dos + coff + opt + dirs + sect
    let mut pad = ""
    let mut pi = str_len(hdr)
    while pi < 512 {
        pad = pad + byte_chr(0)
        pi = pi + 1
    }
    hdr + pad
}

// pe_content_rva 把内容内偏移换算成 RVA（头区独占 RVA 0..4096，文件 0..512）
// pe_content_rva maps a content offset to its RVA (headers own RVA 0..4096, file 0..512)
pub fn pe_content_rva(off) {
    4096 + off
}

// pe_align 向上对齐：用模运算补齐（此处的整数除法链会向下截断）
// pe_align rounds up via modulo (a division-based form truncates downward)
pub fn pe_align(n, a) {
    let m = n % a
    if m == 0 {
        n
    } else {
        n + a - m
    }
}

// pe_hints_size 累计 hint/name 段尺寸（每项 2B hint + 名字 + NUL，补偶）
// pe_hints_size totals the hint/name segment (per entry 2B hint + name + NUL, even-padded)
pub fn pe_hints_size(fns) {
    let mut acc = 0
    let mut i = 0
    while i < len(fns) {
        let raw = 2 + str_len(fns[i]) + 1
        acc = acc + raw + raw % 2
        i = i + 1
    }
    acc
}

// pe_ilt_size / pe_iat_size：n 个真实项 + 每 DLL 一个零终止项
// pe_ilt_size / pe_iat_size: n real entries plus one null terminator per DLL
pub fn pe_ilt_size(n, n_dlls) {
    8 * (n + n_dlls)
}

pub fn pe_iat_size(n, n_dlls) {
    8 * (n + n_dlls)
}

// 导入 blob 段落定长偏移：DESC（每 DLL 20B + 20B 空终止）| ILT | IAT | HINTS | DLLNAME
// Import blob segments in fixed order: DESCs (20B per DLL plus a 20B null
// terminator) | ILT | IAT | HINTS | DLLNAME
pub fn pe_import_desc_size(n_dlls) {
    20 * (n_dlls + 1)
}
