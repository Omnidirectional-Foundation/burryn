// pe.bur — PE 输出：头、节表与导入表（ILT/IAT/hint），Windows 分派臂。
// PE output: headers, section table and the import tables (ILT/IAT/hint),
// plus the Windows dispatch arms.

// emit_pe 装配 PE32+：头区(512B) + 内容(补齐 512)；入口在内容内 entry_off 处
// emit_pe assembles the PE32+: 512-byte header area + content (padded to 512);
// the entry point sits at entry_off within the content
pub fn emit_pe(content, entry_off, idata_off, idata_len) {
    let mut padded = content
    let n = str_len(content) % 512
    if n != 0 {
        let mut pz = ""
        let mut zi = 0
        while zi < 512 - n {
            pz = pz + byte_chr(0)
            zi = zi + 1
        }
        padded = padded + pz
    }
    pe_emit_headers(entry_off, str_len(content), idata_off, idata_len) + padded
}

// pe_build_imports 生成导入 blob；dll_names 与 fn_counts 等长（每 DLL 的函数数），
// fns 为按 DLL 顺序拍平的函数名表；idata_off 是 blob 在内容内的起点。
// ILT/IAT 为整表共享数组，各 DLL 的 DESC 切片指向其中自家区间；DLL 名依次附后。
// pe_build_imports builds the import blob; dll_names parallels fn_counts (each
// DLL's function count) while fns is the flattened name table in DLL order;
// idata_off is the blob's content offset. ILT/IAT are shared whole-table arrays
// with per-DLL descriptors slicing their own ranges; DLL names append in order
pub fn pe_build_imports(dll_names, fn_counts, fns, idata_off) {
    let n_dlls = len(dll_names)
    let n = len(fns)
    let desc_sz = pe_import_desc_size(n_dlls)
    let ilt_off = desc_sz
    let iat_off = ilt_off + pe_ilt_size(n, n_dlls)
    let hints_off = iat_off + pe_iat_size(n, n_dlls)
    let dll_off = hints_off + pe_hints_size(fns)
    let r = fn(off) {
        e4(pe_content_rva(idata_off + off))
    }
    // hint/name 各项的 blob 内偏移 / per-entry hint/name offsets inside the blob
    let mut hn = []
    let mut acc = 0
    let mut i = 0
    while i < n {
        push(hn, hints_off + acc)
        let raw = 2 + str_len(fns[i]) + 1
        acc = acc + raw + raw % 2
        i = i + 1
    }
    // 各 DLL 名的 blob 内偏移 / per-DLL name offsets inside the blob
    let mut dn = []
    let mut dacc = 0
    let mut ddi = 0
    while ddi < n_dlls {
        push(dn, dll_off + dacc)
        dacc = dacc + str_len(dll_names[ddi]) + 1
        ddi = ddi + 1
    }
    // 各 DLL 的 DESC：ILT/IAT 切片按「函数数 + 1 空终止」前缀和定位——每个
    // DLL 的 ILT/IAT 都是独立以零项收尾的数组，PE 加载器逐 DLL 读到零才停，
    // 数组间不留空隙会把下一 DLL 的项当成本 DLL 的导入，加载失败
    // （STATUS_DLL_NOT_FOUND：第一个 DLL 读出下一个 DLL 的函数名，解析不到）。
    // per-DLL descriptors: ILT/IAT slices located by "function count + 1 null"
    // prefixes — each DLL's ILT/IAT is its own zero-terminated array, and the
    // loader reads each until it hits a zero; without a gap between arrays the
    // next DLL's entries get mistaken for this DLL's imports and loading fails
    // (STATUS_DLL_NOT_FOUND: the first DLL reads into the next DLL's function
    // names and can't resolve them).
    let mut blob = ""
    let mut doff = 0
    let mut dj = 0
    while dj < n_dlls {
        blob = blob + r(ilt_off + 8 * doff) + e4(0) + e4(0) + r(dn[dj]) + r(iat_off + 8 * doff)
        doff = doff + fn_counts[dj] + 1
        dj = dj + 1
    }
    blob = blob + e4(0) + e4(0) + e4(0) + e4(0) + e4(0)
    let mut ii = 0
    let mut dk = 0
    while dk < n_dlls {
        let mut ci = 0
        while ci < fn_counts[dk] {
            blob = blob + e8(pe_content_rva(idata_off + hn[ii]))
            ii = ii + 1
            ci = ci + 1
        }
        blob = blob + e8(0)
        dk = dk + 1
    }
    let mut ai = 0
    let mut dl = 0
    while dl < n_dlls {
        let mut ci2 = 0
        while ci2 < fn_counts[dl] {
            blob = blob + e8(pe_content_rva(idata_off + hn[ai]))
            ai = ai + 1
            ci2 = ci2 + 1
        }
        blob = blob + e8(0)
        dl = dl + 1
    }
    let mut hi = 0
    while hi < n {
        let nm = fns[hi]
        let raw = 2 + str_len(nm) + 1
        blob = blob + e2(0) + nm + byte_chr(0)
        if raw % 2 == 1 {
            blob = blob + byte_chr(0)
        }
        hi = hi + 1
    }
    let mut db = ""
    let mut bi = 0
    while bi < n_dlls {
        db = db + dll_names[bi] + byte_chr(0)
        bi = bi + 1
    }
    blob = blob + db + byte_chr(0)
    blob
}

// pe_build_dispatcher 生成 syscall 兼容分派器。
// pe_build_dispatcher emits the syscall shim dispatcher.
// 契约对齐 Linux syscall：只破坏 rax/rcx/r11，保全其余寄存器；结果走 rax。
// IAT 目标一律经 mov_ri64(r10, …) 装载——r10 是 call qword [r10] 与 mul/div r10
// 的操作数，手写 REX.B 极易误成 REX.R 而静默改打 rdx。
// Contract mirrors Linux syscall: only rax/rcx/r11 die, everything else
// survives; result returns in rax. Every IAT target loads through
// mov_ri64(r10, …): r10 is the operand of call qword [r10] and of mul/div r10,
// and a hand-written REX.B is easily mistyped as REX.R, silently hitting rdx.
// 支持号：1 write→WriteFile（经 fd 表查句柄；kind==1 走 recv）、60 exit→ExitProcess、
// 9 mmap→VirtualAlloc、228 clock_gettime→QPC/QPF 合成 timespec、
// 7 poll→Sleep（仅 nfds==0 的 timer 等待）/ nfds>0 走 WSAPoll（SOCKET 翻译）、
// 10 mprotect→VirtualProtect、3 close→CloseHandle（销 fd 表槽；kind==1 走 closesocket）、
// 2 open→CreateFileA（返 HANDLE，由 native 登记进表）、0 read→ReadFile（kind==1 走 recv）、
// 4 stat→GetFileAttributesA（只返 0/-1）、5 fstat→GetFileSizeEx（写 rsi 指向的
// 8B）、41 socket→socket（WSAStartup 懒初始化，返槽号，kind=1）、49 bind、
// 50 listen、42 connect、43 accept（返槽号，kind=1）、54 setsockopt、
// 55 getsockopt、72 fcntl（1/3 查表验证，4 走 ioctlsocket）、1000/1001/1002
// FindFirstFileA/FindNextFileA/FindClose（合成号，无 Linux 对应物，供 read_dir
// 直调）；其余 ud2 立即崩溃暴露缺口。
// Supported: 1 write→WriteFile (via the fd table; kind==1 takes recv), 60
// exit→ExitProcess, 9 mmap→VirtualAlloc, 228 clock_gettime→QPC/QPF synthesizing
// timespec, 7 poll→Sleep (nfds==0 timer waits only) or WSAPoll for nfds>0 (with
// SOCKET translation), 10 mprotect→VirtualProtect, 3 close→CloseHandle (frees
// the fd table slot; kind==1 takes closesocket), 2 open→CreateFileA (returns the
// HANDLE for the native to register), 0 read→ReadFile (kind==1 takes recv),
// 4 stat→GetFileAttributesA (0/-1 only), 5 fstat→GetFileSizeEx (writing 8B
// through rsi), 41 socket→socket (lazy WSAStartup, returns the slot, kind=1),
// 49 bind, 50 listen, 42 connect, 43 accept (returns the slot, kind=1),
// 54 setsockopt, 55 getsockopt, 72 fcntl (1/3 validate through the table,
// 4 takes ioctlsocket); 1000/1001/1002 FindFirstFileA/FindNextFileA/FindClose
// (synthetic numbers with no Linux counterpart, called by read_dir directly,
// see natives); anything else hits ud2.
// iat 为三十个 IAT 槽的绝对地址：前十六个见旧表（GetStdHandle … FindClose），
// 后十四个为 ws2_32：WSAStartup / socket / bind / listen / accept / connect /
// setsockopt / getsockopt / ioctlsocket / closesocket / recv / send / WSAPoll /
// WSAGetLastError。
// iat holds thirty absolute IAT addresses: the first sixteen as before
// (GetStdHandle through FindClose), then fourteen ws2_32 entries in this order:
// WSAStartup, socket, bind, listen, accept, connect, setsockopt, getsockopt,
// ioctlsocket, closesocket, recv, send, WSAPoll, WSAGetLastError.

// wsa_err_map 把 WSAGetLastError 码（rax）换成 Linux 式负 errno：WOULDBLOCK
// (10035)→EAGAIN(11)（调用方 park），WSAEINTR(10004)→EINTR(4)（调用方重试），
// 其余取负（调用方只认 11/4，其余一律 Err）。仅在 Winsock 调用返 SOCKET_ERROR
// 后接本段；成功路径不得经过（0 会取负成 0 恰好无害，但语义上只接失败路）。
// wsa_err_map converts a WSAGetLastError code (rax) to a Linux-style negative
// errno: WOULDBLOCK (10035)→EAGAIN (11, the callers park), WSAEINTR
// (10004)→EINTR (4, the callers retry), anything else negated (the callers only
// recognize 11/4, the rest becomes Err). Append it only after a Winsock call
// returning SOCKET_ERROR.
fn wsa_err_map(getlasterror_slot) {
    let neg_it = neg_r(rax)
    let to_intr = mov_ri64(rax, 0 - 4) + jmp_rel32(str_len(neg_it))
    let chk_intr = mov_ri64(r10, 10004) + cmp_rr(rax, r10) + jne_rel32(str_len(to_intr)) + to_intr + neg_it
    let to_again = mov_ri64(rax, 0 - 11) + jmp_rel32(str_len(chk_intr))
    let chk_block = mov_ri64(r10, 10035) + cmp_rr(rax, r10) + jne_rel32(str_len(to_again)) + to_again + chk_intr
    mov_ri64(r10, getlasterror_slot) + e1(65) + e1(255) + e1(18) + chk_block
}

// ws_ptr_at_w 生成 scratch[w] 地址到 r9（w 在分派器局部 +48；毁 rax/rcx/r9）。
// scratch 条目 12B：[SOCKET:8][events:2][revents:2]，基址见 layout.bur wsa_base。
// ws_ptr_at_w resolves scratch[w] into r9 (w lives in dispatcher local +48;
// clobbers rax/rcx/r9). Scratch entries are 12B ([SOCKET:8][events:2][revents:2]
// at layout.bur wsa_base)
fn ws_ptr_at_w() {
    mov_rm(rax, rsp, 48) + mov_rr(r9, rax) + mov_ri32(rcx, 3) + shl_rcl(r9) + mov_rm(rax, rsp, 48) + mov_ri32(rcx, 2) + shl_rcl(rax) + add_rr(r9, rax) + mov_ri64(rax, wsa_base() + WSA_POLL) + add_rr(r9, rax)
}

// pw_stage_entry 生成 staged[i] 地址到 r8（i 在分派器局部 +40，基址在 +64）。
// staged 条目为 Linux pollfd 8B 记录（[fd:4][events:2][revents:2]）。
// pw_stage_entry resolves staged[i] into r8 (i lives in dispatcher local +40,
// base in +64). Staged entries are Linux pollfd 8B records
// ([fd:4][events:2][revents:2])
fn pw_stage_entry() {
    mov_rm(rax, rsp, 40) + mov_ri32(rcx, 3) + shl_rcl(rax) + mov_rm(r8, rsp, 64) + add_rr(r8, rax)
}

// pe_fd_lookup 把 rdi 的小整数 fd 换成表槽地址（r11）；miss（负数 / ≥64 /
// 槽空闲）返 -EBADF 并跳过调用方剩余 skip_after 字节。0/1/2 槽首次使用时懒初始化
// （GetStdHandle(-10-fd) 存句柄，kind=0）；open 从不返回 0-2。
// pe_fd_lookup resolves the small-int fd in rdi to the table slot (r11); on a
// miss (negative / >=64 / free slot) it returns -EBADF and skips the caller's
// remaining skip_after bytes. Slots 0-2 initialize lazily on first use
// (GetStdHandle(-10-fd), kind=0); open never hands out 0-2.
fn pe_fd_lookup(iat, skip_after) {
    // miss 块与越过它的 hop 分开命名：jl/jae/ja 只跨 hop（5B）落 miss 首，
    // jne→HIT 才跨 hop+miss 落 body 首；合二为一必错一处（教训：比较 cmp 产物）。
    // The hop and the miss block stay separately named: jl/jae/ja span only
    // the hop onto miss, only jne→HIT spans hop+miss.
    let miss = mov_ri64(rax, 0 - 9) + jmp_rel32(skip_after)
    let hop = jmp_rel32(str_len(miss))
    // 懒调用前后保 r11（槽地址）：Win64 被调用方寄存器，GetStdHandle 可毁；
    // rdi 用完即死，不保。push/pop 在 64B 保留区内平衡，epilogue 无感。
    // Preserve r11 (the slot) across the lazy call: Win64 caller-saved, and
    // GetStdHandle may clobber it; rdi is dead after this point. The push/pop
    // balances inside the reserved area, invisible to the epilogue.
    let lazy = push_r(r11) + mov_ri64(rcx, 0 - 10) + sub_rr(rcx, rdi) + mov_ri64(r10, iat[0]) + e1(65) + e1(255) + e1(18) + pop_r(r11) + mov_mr(r11, 0, rax) + xor_rr(r10, r10) + mov_mr(r11, 8, r10)
    let free_chk = mov_ri64(r10, 2) + cmp_rr(rdi, r10) + ja_rel32(str_len(lazy) + str_len(hop))
    let kind_chk = mov_rm(rax, r11, 8) + mov_ri64(r10, 0 - 1) + cmp_rr(rax, r10) + jne_rel32(str_len(free_chk) + str_len(lazy) + str_len(hop) + str_len(miss))
    let slot = mov_rr(r11, rdi) + add_rr(r11, r11) + add_rr(r11, r11) + add_rr(r11, r11) + add_rr(r11, r11) + mov_ri64(r10, fd_base()) + add_rr(r11, r10)
    let bound = mov_ri64(r10, 64) + cmp_rr(rdi, r10) + jae_rel32(str_len(slot) + str_len(kind_chk) + str_len(free_chk) + str_len(lazy) + str_len(hop))
    test_rr(rdi, rdi) + jl_rel32(str_len(bound) + str_len(slot) + str_len(kind_chk) + str_len(free_chk) + str_len(lazy) + str_len(hop)) + bound + slot + kind_chk + free_chk + lazy + hop + miss
}

pub fn pe_build_dispatcher(iat) {
    // 先压 SysV 仍活寄存器，再 16 字节对齐并开出 Win64 影子空间与局部量。
    // 128B（非旧 64B）：accept 的 addr/addrlen 写到 +64/+80（各 case 共用同一
    // 保留区，取各自互斥的最大需求），64B 时 +64 起已经出界，落进 head 压栈的
    // rdi..r10 家——net 臂新增的每个 case 都要在这同一块保留区里选未占用偏移，
    // 越界的后果是 epilogue 弹栈把这里的垃圾值还给调用者（读代码时这条必须
    // 在场，否则不会有人去查这个边界）。
    // Save still-live SysV regs, then 16-byte-align and open Win64 shadow plus
    // locals. 128B (not the old 64B): accept writes addr/addrlen to +64/+80
    // (every case shares one reserved region, sized for the largest of their
    // mutually-exclusive needs); at 64B, +64 onward is already out of bounds,
    // landing on the rdi..r10 homes head's prologue pushed — every case the net
    // arm adds must pick an unused offset within this same reserved region, and
    // going out of bounds means the epilogue's pop hands the caller garbage
    // (this note must be in place when reading the code, or no one will think
    // to check this boundary).
    let head = e1(85) + e1(72) + e1(137) + e1(229) + e1(87) + e1(86) + e1(82) + e1(65) + e1(80) + e1(65) + e1(81) + e1(65) + e1(82) + e1(72) + e1(131) + e1(228) + e1(240) + e1(72) + e1(129) + e1(236) + e1(128) + e1(0) + e1(0) + e1(0)

    // 尾声：rsp 回到保存区再弹寄存器
    // Epilogue: rsp back to the save area, then pop
    let epilogue = e1(72) + e1(141) + e1(101) + e1(208) + e1(65) + e1(90) + e1(65) + e1(89) + e1(65) + e1(88) + e1(90) + e1(94) + e1(95) + e1(201) + e1(195)

    // write(fd=rdi, buf=rsi, len=rdx)：fd 经表查句柄（0/1/2 懒初始化后与旧
    // GetStdHandle 每次调用同值）；kind==1 走 send（WOULDBLOCK 即 park），
    // 否则 WriteFile；四寄存器槽按 Win64 装填；长度先存局部
    // write(fd=rdi, buf=rsi, len=rdx): fd resolves through the table (lazy
    // slots 0-2 hold the same handles the old per-call GetStdHandle returned);
    // kind==1 takes send (WOULDBLOCK parks), otherwise WriteFile;
    // Win64 rcx/rdx/r8/r9; length in a local
    // buf/len 存 [rsp+48]/[rsp+56]（shadow 区 [rsp, rsp+32) 之上）：懒调用会毁
    // shadow，旧代码把 len 放 +56 正为此；+48 与 tail 的 written-count 家复用
    // （先取 buf 再被 WriteFile 覆盖，无冲突）。
    // buf/len spill above the shadow area ([rsp, rsp+32) dies across the lazy
    // call; the old code kept len at +56 for the same reason). +48 doubles as
    // the written-count home (buf is reloaded first, no conflict).
    // 失败返 -1（成功返 len；旧 `or rax,-1` 是死代码，意图在此复活）。
    // Failure returns -1, success the length (reviving the dead or's intent).
    let wsa_write_err = wsa_err_map(iat[29])
    let write_ws = mov_rm(rcx, r11, 0) + mov_rm(rdx, rsp, 48) + mov_rm(r8, rsp, 56) + xor_rr(r9, r9) + mov_ri64(r10, iat[27]) + e1(65) + e1(255) + e1(18) + cdqe() + test_rr(rax, rax) + jge_rel32(str_len(wsa_write_err)) + wsa_write_err
    let write_tail = mov_rm(rcx, r11, 0) + e1(72) + e1(137) + e1(242) + e1(76) + e1(139) + e1(68) + e1(36) + e1(56) + e1(72) + e1(199) + e1(68) + e1(36) + e1(32) + e4(0) + e1(76) + e1(141) + e1(76) + e1(36) + e1(48) + mov_ri64(r10, iat[1]) + e1(65) + e1(255) + e1(18) + e1(133) + e1(192) + jne_rel32(str_len(mov_ri64(rax, 0 - 1)) + 5) + mov_ri64(rax, 0 - 1) + jmp_rel32(str_len(mov_rm(rax, rsp, 56))) + mov_rm(rax, rsp, 56)
    let write_body = mov_rm(rsi, rsp, 48) + mov_rm(rdx, rsp, 56) + write_tail
    let write_file = write_body + jmp_rel32(str_len(write_ws))
    let write_split = mov_rm(r10, r11, 8) + mov_ri64(rcx, 1) + cmp_rr(r10, rcx) + je_rel32(str_len(write_file))
    let write_case = mov_mr(rsp, 48, rsi) + mov_mr(rsp, 56, rdx) + pe_fd_lookup(iat, str_len(write_split) + str_len(write_file) + str_len(write_ws)) + write_split + write_file + write_ws

    // close(fd=rdi)：查表→kind==1 走 closesocket，否则 CloseHandle→标空闲；
    // miss 在 lookup 内返 -EBADF。CloseHandle/closesocket 返回值不纠缠（与现有
    // close 路径忽略错误一致）。Win64 调用毁 r11：槽地址先存分派器局部 +40
    // （各 case 互斥，同 mprotect 的 out 参），call 后取回再标空闲。
    // close(fd=rdi): table lookup → closesocket for kind==1, CloseHandle
    // otherwise, then mark free; misses return -EBADF inside the lookup.
    // Neither call's own result matters, matching the existing close paths.
    // Both are Win64 calls and r11 is volatile: spill the slot address to
    // dispatcher local +40 (cases are mutually exclusive, same as mprotect's
    // out-param) and reload it after the call before marking the slot free.
    let close_free = mov_rm(r11, rsp, 40) + mov_ri64(r10, 0 - 1) + mov_mr(r11, 8, r10) + xor_rr(rax, rax)
    let close_ws = mov_rm(rcx, r11, 0) + mov_mr(rsp, 40, r11) + mov_ri64(r10, iat[25]) + e1(65) + e1(255) + e1(18) + close_free
    let close_file = mov_rm(rcx, r11, 0) + mov_mr(rsp, 40, r11) + mov_ri64(r10, iat[8]) + e1(65) + e1(255) + e1(18) + close_free + jmp_rel32(str_len(close_ws))
    let close_split = mov_rm(r10, r11, 8) + mov_ri64(rcx, 1) + cmp_rr(r10, rcx) + je_rel32(str_len(close_file))
    let close_case = pe_fd_lookup(iat, str_len(close_split) + str_len(close_file) + str_len(close_ws)) + close_split + close_file + close_ws

    // stat(path=rdi)：GetFileAttributesA，存在返 0，不存在返 -1（调用方只看符号）。
    // DWORD 返回值先清零扩展再比 -1（高 32 位未定义）。
    // stat(path=rdi): GetFileAttributesA, 0 when present, -1 when missing (the
    // caller only checks the sign). The DWORD result is zero-extended before
    // comparing against -1 (upper bits undefined).
    let stat_ret = mov_ri32(rcx, 32) + shl_rcl(rax) + shr_rcl(rax) + mov_ri32(r10, 4294967295) + cmp_rr(rax, r10) + jne_rel32(str_len(mov_ri64(rax, 0 - 1)) + 5) + mov_ri64(rax, 0 - 1) + jmp_rel32(str_len(xor_rr(rax, rax))) + xor_rr(rax, rax)
    let stat_case = mov_rr(rcx, rdi) + mov_ri64(r10, iat[11]) + e1(65) + e1(255) + e1(18) + stat_ret

    // fstat(fd=rdi, size_out=rsi)：查表→GetFileSizeEx 写 8B 长度到 rsi，
    // 成功返 0，失败返 -1（调用方传 [rsp+48] 作 dest，见 read_file）。
    // fstat(fd=rdi, size_out=rsi): table lookup → GetFileSizeEx writing the
    // 8-byte size through rsi, 0 on success, -1 on failure (callers pass
    // [rsp+48] as dest, see read_file).
    let fstat_tail = mov_rm(rcx, r11, 0) + mov_rr(rdx, rsi) + mov_ri64(r10, iat[12]) + e1(65) + e1(255) + e1(18) + e1(133) + e1(192) + jne_rel32(str_len(mov_ri64(rax, 0 - 1)) + 5) + mov_ri64(rax, 0 - 1) + jmp_rel32(str_len(xor_rr(rax, rax))) + xor_rr(rax, rax)
