// pe.bur — 手写 PE32+ 可执行文件生成器（Windows，无链接器依赖）。
// Hand-written PE32+ executable emitter (Windows, no linker dependency).
// 单一 RWX 节承载全部内容（对应 ELF 的单 PT_LOAD）；导入表只挂 kernel32，
// 供 syscall 兼容分派器调用。无重定位：DllCharacteristics 关 ASLR，固定基址加载。
// One RWX section carries the whole image (the counterpart of ELF's single
// PT_LOAD); imports hook kernel32 only, consumed by the syscall shim
// dispatcher. No relocations: ASLR off in DllCharacteristics, fixed-base load.

// emit_pe 装配 PE32+：头区(512B) + 内容(补齐 512)；入口在内容内 entry_off 处
// emit_pe assembles the PE32+: 512-byte header area + content (padded to 512);
// the entry point sits at entry_off within the content
pub fn emit_pe(content, entry_off, idata_off, idata_len) {
    let mut padded = content
    let n = str_len(content) % 512
    if n != 0 {
        let mut pz = ""
        let mut zi = 0
        while zi < 512 - n {
            pz = pz + byte_chr(0)
            zi = zi + 1
        }
        padded = padded + pz
    }
    pe_emit_headers(entry_off, str_len(content), idata_off, idata_len) + padded
}
