    // (the already-initialized path jumps over it via jne); do not append it
    // again here, or WSAStartup fires an extra time on every socket() call
    let socket_case = mov_mr(rsp, 40, rsi) + mov_mr(rsp, 48, rdx) + wsa_chk + mov_rr(rcx, rdi) + mov_rm(rdx, rsp, 40) + mov_rm(r8, rsp, 48) + sock_call

    // bind(fd=rdi, addr=rsi, len=rdx)：查表→bind；失败取负（调用方只看符号）。
