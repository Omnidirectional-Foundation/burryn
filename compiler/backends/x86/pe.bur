// pe.bur — PE 输出：头、节表与导入表（ILT/IAT/hint），Windows 分派臂。
// PE output: headers, section table and the import tables (ILT/IAT/hint),
// plus the Windows dispatch arms.

// emit_pe 装配 PE32+：头区(512B) + 内容(补齐 512)；入口在内容内 entry_off 处
// emit_pe assembles the PE32+: 512-byte header area + content (padded to 512);
// the entry point sits at entry_off within the content
pub fn emit_pe(content, entry_off, idata_off, idata_len) {
    let mut padded = content
    let n = str_len(content) % 512
    if n != 0 {
        let mut pz = ""
        let mut zi = 0
        while zi < 512 - n {
            pz = pz + byte_chr(0)
            zi = zi + 1
        }
        padded = padded + pz
    }
    pe_emit_headers(entry_off, str_len(content), idata_off, idata_len) + padded
}

// pe_build_imports 生成导入 blob；idata_off 是 blob 在内容内的起点
// pe_build_imports builds the import blob; idata_off is the blob's content offset
pub fn pe_build_imports(fns, idata_off) {
    let n = len(fns)
    let desc_sz = pe_import_desc_size(n)
    let ilt_off = desc_sz
    let iat_off = ilt_off + pe_ilt_size(n)
    let hints_off = iat_off + pe_iat_size(n)
    let dll_off = hints_off + pe_hints_size(fns)
    let r = fn(off) {
        e4(pe_content_rva(idata_off + off))
    }
    // hint/name 各项的 blob 内偏移 / per-entry hint/name offsets inside the blob
    let mut hn = []
    let mut acc = 0
    let mut i = 0
    while i < n {
        push(hn, hints_off + acc)
        let raw = 2 + str_len(fns[i]) + 1
        acc = acc + raw + raw % 2
        i = i + 1
    }
    let mut blob = r(ilt_off) + e4(0) + e4(0) + r(dll_off) + r(iat_off)
    blob = blob + e4(0) + e4(0) + e4(0) + e4(0) + e4(0)
    let mut ii = 0
    while ii < n {
        blob = blob + e8(pe_content_rva(idata_off + hn[ii]))
        ii = ii + 1
    }
    blob = blob + e8(0)
    let mut ai = 0
    while ai < n {
        blob = blob + e8(pe_content_rva(idata_off + hn[ai]))
        ai = ai + 1
    }
    blob = blob + e8(0)
    let mut hi = 0
    while hi < n {
        let nm = fns[hi]
        let raw = 2 + str_len(nm) + 1
        blob = blob + e2(0) + nm + byte_chr(0)
        if raw % 2 == 1 {
            blob = blob + byte_chr(0)
        }
        hi = hi + 1
    }
    blob = blob + "kernel32.dll" + byte_chr(0) + byte_chr(0)
    blob
}

// pe_build_dispatcher 生成 syscall 兼容分派器。
// pe_build_dispatcher emits the syscall shim dispatcher.
// 契约对齐 Linux syscall：只破坏 rax/rcx/r11，保全其余寄存器；结果走 rax。
// IAT 目标一律经 mov_ri64(r10, …) 装载——r10 是 call qword [r10] 与 mul/div r10
// 的操作数，手写 REX.B 极易误成 REX.R 而静默改打 rdx。
// Contract mirrors Linux syscall: only rax/rcx/r11 die, everything else
// survives; result returns in rax. Every IAT target loads through
// mov_ri64(r10, …): r10 is the operand of call qword [r10] and of mul/div r10,
// and a hand-written REX.B is easily mistyped as REX.R, silently hitting rdx.
// 支持号：1 write→WriteFile（经 fd 表查句柄）、60 exit→ExitProcess、
// 9 mmap→VirtualAlloc、228 clock_gettime→QPC/QPF 合成 timespec、
// 7 poll→Sleep（仅 nfds==0 的 timer 等待；nfds>0 仍 ud2，WSAPoll 翻译随 P4 落地）、
// 10 mprotect→VirtualProtect、3 close→CloseHandle（销 fd 表槽）、
// 2 open→CreateFileA（返 HANDLE，由 native 登记进表）、0 read→ReadFile、
// 4 stat→GetFileAttributesA（只返 0/-1）、5 fstat→GetFileSizeEx（写 rsi 指向的
// 8B）、1000/1001/1002 FindFirstFileA/FindNextFileA/FindClose（合成号，
// 无 Linux 对应物，供 read_dir 直调）；其余 ud2 立即崩溃暴露缺口。
// Supported: 1 write→WriteFile (via the fd table), 60 exit→ExitProcess,
// 9 mmap→VirtualAlloc, 228 clock_gettime→QPC/QPF synthesizing timespec,
// 7 poll→Sleep (nfds==0 timer waits only; nfds>0 still hits ud2, the WSAPoll
// translation lands with P4), 10 mprotect→VirtualProtect, 3 close→CloseHandle
// (frees the fd table slot), 2 open→CreateFileA (returns the HANDLE for the
// native to register), 0 read→ReadFile, 4 stat→GetFileAttributesA (0/-1 only),
// 5 fstat→GetFileSizeEx (writing 8B through rsi); 1000/1001/1002
// FindFirstFileA/FindNextFileA/FindClose (synthetic numbers with no Linux
// counterpart, called by read_dir directly, see natives); anything else hits ud2.
// iat 为十六个 IAT 槽的绝对地址：GetStdHandle / WriteFile / ExitProcess /
// VirtualAlloc / QueryPerformanceCounter / QueryPerformanceFrequency /
// Sleep / VirtualProtect / CloseHandle / CreateFileA / ReadFile /
// GetFileAttributesA / GetFileSizeEx / FindFirstFileA / FindNextFileA / FindClose。
// iat holds sixteen absolute IAT addresses in that order.

// guarded_ud2: ud2 只许显式跳转进入，永不 fallthrough（成功路径掉陷阱类 bug
// 的结构解，要求调用方把成功出口数全越过它）。
// guarded_ud2: ud2 is reachable only by explicit jump, never by fallthrough.
fn guarded_ud2() {
    jmp_rel32(2) + e1(15) + e1(11)
}

// pe_fd_lookup 把 rdi 的小整数 fd 换成表槽地址（r11）；miss（负数 / ≥64 /
// 槽空闲）返 -EBADF 并跳过调用方剩余 skip_after 字节。0/1/2 槽首次使用时懒初始化
// （GetStdHandle(-10-fd) 存句柄，kind=0）；open 从不返回 0-2。
// pe_fd_lookup resolves the small-int fd in rdi to the table slot (r11); on a
// miss (negative / >=64 / free slot) it returns -EBADF and skips the caller's
// remaining skip_after bytes. Slots 0-2 initialize lazily on first use
// (GetStdHandle(-10-fd), kind=0); open never hands out 0-2.
fn pe_fd_lookup(iat, skip_after) {
    // miss 块与越过它的 hop 分开命名：jl/jae/ja 只跨 hop（5B）落 miss 首，
    // jne→HIT 才跨 hop+miss 落 body 首；合二为一必错一处（教训：比较 cmp 产物）。
    // The hop and the miss block stay separately named: jl/jae/ja span only
    // the hop onto miss, only jne→HIT spans hop+miss.
    let miss = mov_ri64(rax, 0 - 9) + jmp_rel32(skip_after)
    let hop = jmp_rel32(str_len(miss))
    // 懒调用前后保 r11（槽地址）：Win64 被调用方寄存器，GetStdHandle 可毁；
    // rdi 用完即死，不保。push/pop 在 64B 保留区内平衡，epilogue 无感。
    // Preserve r11 (the slot) across the lazy call: Win64 caller-saved, and
    // GetStdHandle may clobber it; rdi is dead after this point. The push/pop
    // balances inside the reserved area, invisible to the epilogue.
    let lazy = push_r(r11) + mov_ri64(rcx, 0 - 10) + sub_rr(rcx, rdi) + mov_ri64(r10, iat[0]) + e1(65) + e1(255) + e1(18) + pop_r(r11) + mov_mr(r11, 0, rax) + xor_rr(r10, r10) + mov_mr(r11, 8, r10)
    let free_chk = mov_ri64(r10, 2) + cmp_rr(rdi, r10) + ja_rel32(str_len(lazy) + str_len(hop))
    let kind_chk = mov_rm(rax, r11, 8) + mov_ri64(r10, 0 - 1) + cmp_rr(rax, r10) + jne_rel32(str_len(free_chk) + str_len(lazy) + str_len(hop) + str_len(miss))
    let slot = mov_rr(r11, rdi) + add_rr(r11, r11) + add_rr(r11, r11) + add_rr(r11, r11) + add_rr(r11, r11) + mov_ri64(r10, fd_base()) + add_rr(r11, r10)
    let bound = mov_ri64(r10, 64) + cmp_rr(rdi, r10) + jae_rel32(str_len(slot) + str_len(kind_chk) + str_len(free_chk) + str_len(lazy) + str_len(hop))
    test_rr(rdi, rdi) + jl_rel32(str_len(bound) + str_len(slot) + str_len(kind_chk) + str_len(free_chk) + str_len(lazy) + str_len(hop)) + bound + slot + kind_chk + free_chk + lazy + hop + miss
}

pub fn pe_build_dispatcher(iat) {
    // 先压 SysV 仍活寄存器，再 16 字节对齐并开出 Win64 影子空间与局部量
    // Save still-live SysV regs, then 16-byte-align and open Win64 shadow plus locals
    let head = e1(85) + e1(72) + e1(137) + e1(229) + e1(87) + e1(86) + e1(82) + e1(65) + e1(80) + e1(65) + e1(81) + e1(65) + e1(82) + e1(72) + e1(131) + e1(228) + e1(240) + e1(72) + e1(129) + e1(236) + e1(64) + e1(0) + e1(0) + e1(0)

    // 尾声：rsp 回到保存区再弹寄存器
    // Epilogue: rsp back to the save area, then pop
    let epilogue = e1(72) + e1(141) + e1(101) + e1(208) + e1(65) + e1(90) + e1(65) + e1(89) + e1(65) + e1(88) + e1(90) + e1(94) + e1(95) + e1(201) + e1(195)

    // write(fd=rdi, buf=rsi, len=rdx)：fd 经表查句柄（0/1/2 懒初始化后与旧
    // GetStdHandle 每次调用同值）；WriteFile 四寄存器槽按 Win64 装填；长度先存局部
    // write(fd=rdi, buf=rsi, len=rdx): fd resolves through the table (lazy
    // slots 0-2 hold the same handles the old per-call GetStdHandle returned);
    // Win64 rcx/rdx/r8/r9; length in a local
    // buf/len 存 [rsp+48]/[rsp+56]（shadow 区 [rsp, rsp+32) 之上）：懒调用会毁
    // shadow，旧代码把 len 放 +56 正为此；+48 与 tail 的 written-count 家复用
    // （先取 buf 再被 WriteFile 覆盖，无冲突）。
    // buf/len spill above the shadow area ([rsp, rsp+32) dies across the lazy
    // call; the old code kept len at +56 for the same reason). +48 doubles as
    // the written-count home (buf is reloaded first, no conflict).
    // 失败返 -1（成功返 len；旧 `or rax,-1` 是死代码，意图在此复活）。
    // Failure returns -1, success the length (reviving the dead or's intent).
    let write_tail = mov_rm(rcx, r11, 0) + e1(72) + e1(137) + e1(242) + e1(76) + e1(139) + e1(68) + e1(36) + e1(56) + e1(72) + e1(199) + e1(68) + e1(36) + e1(32) + e4(0) + e1(76) + e1(141) + e1(76) + e1(36) + e1(48) + mov_ri64(r10, iat[1]) + e1(65) + e1(255) + e1(18) + e1(133) + e1(192) + jne_rel32(str_len(mov_ri64(rax, 0 - 1)) + 5) + mov_ri64(rax, 0 - 1) + jmp_rel32(str_len(mov_rm(rax, rsp, 56))) + mov_rm(rax, rsp, 56)
    let write_body = mov_rm(rsi, rsp, 48) + mov_rm(rdx, rsp, 56) + write_tail
    let write_case = mov_mr(rsp, 48, rsi) + mov_mr(rsp, 56, rdx) + pe_fd_lookup(iat, str_len(write_body)) + write_body

    // close(fd=rdi)：查表→CloseHandle→标空闲；miss 在 lookup 内返 -EBADF。
    // CloseHandle 返回值不纠缠（与现有 close 路径忽略错误一致）。
    // close(fd=rdi): table lookup → CloseHandle → mark free; misses return
    // -EBADF inside the lookup. CloseHandle's own result is ignored, matching
    // the existing close paths.
    let close_tail = mov_rm(rcx, r11, 0) + mov_ri64(r10, iat[8]) + e1(65) + e1(255) + e1(18) + mov_ri64(r10, 0 - 1) + mov_mr(r11, 8, r10) + xor_rr(rax, rax)
    let close_case = pe_fd_lookup(iat, str_len(close_tail)) + close_tail

    // stat(path=rdi)：GetFileAttributesA，存在返 0，不存在返 -1（调用方只看符号）。
    // DWORD 返回值先清零扩展再比 -1（高 32 位未定义）。
    // stat(path=rdi): GetFileAttributesA, 0 when present, -1 when missing (the
    // caller only checks the sign). The DWORD result is zero-extended before
    // comparing against -1 (upper bits undefined).
    let stat_ret = mov_ri32(rcx, 32) + shl_rcl(rax) + shr_rcl(rax) + mov_ri32(r10, 4294967295) + cmp_rr(rax, r10) + jne_rel32(str_len(mov_ri64(rax, 0 - 1)) + 5) + mov_ri64(rax, 0 - 1) + jmp_rel32(str_len(xor_rr(rax, rax))) + xor_rr(rax, rax)
    let stat_case = mov_rr(rcx, rdi) + mov_ri64(r10, iat[11]) + e1(65) + e1(255) + e1(18) + stat_ret

    // fstat(fd=rdi, size_out=rsi)：查表→GetFileSizeEx 写 8B 长度到 rsi，
    // 成功返 0，失败返 -1（调用方传 [rsp+48] 作 dest，见 read_file）。
    // fstat(fd=rdi, size_out=rsi): table lookup → GetFileSizeEx writing the
    // 8-byte size through rsi, 0 on success, -1 on failure (callers pass
    // [rsp+48] as dest, see read_file).
    let fstat_tail = mov_rm(rcx, r11, 0) + mov_rr(rdx, rsi) + mov_ri64(r10, iat[12]) + e1(65) + e1(255) + e1(18) + e1(133) + e1(192) + jne_rel32(str_len(mov_ri64(rax, 0 - 1)) + 5) + mov_ri64(rax, 0 - 1) + jmp_rel32(str_len(xor_rr(rax, rax))) + xor_rr(rax, rax)
    let fstat_case = pe_fd_lookup(iat, str_len(fstat_tail)) + fstat_tail

    // read(fd=rdi, buf=rsi, len=rdx)：查表→ReadFile，返读到字节数，失败 -1。
    // len 先存局部（lookup 的懒调用可毁 rdx）；buf 在 rsi，Win64 被调用方保存。
    // read(fd=rdi, buf=rsi, len=rdx): table lookup → ReadFile, returning the
    // byte count or -1. len spills to a local first (the lookup's lazy call may
    // clobber rdx); buf stays in rsi, which Win64 callees preserve.
    let read_tail = mov_rm(rcx, r11, 0) + mov_rr(rdx, rsi) + mov_rm(r8, rsp, 56) + lea(r9, rsp, 48) + e1(72) + e1(199) + e1(68) + e1(36) + e1(32) + e4(0) + mov_ri64(r10, iat[10]) + e1(65) + e1(255) + e1(18) + e1(133) + e1(192) + jne_rel32(str_len(mov_ri64(rax, 0 - 1)) + 5) + mov_ri64(rax, 0 - 1) + jmp_rel32(str_len(mov_rm(rax, rsp, 48))) + mov_rm(rax, rsp, 48)
    let read_body = mov_mr(rsp, 56, rdx) + read_tail
    let read_case = pe_fd_lookup(iat, str_len(read_body)) + read_body

    // mmap(addr=0, len=rsi, prot, flags, ...)：固定 RW 私有页，prot/flags 忽略
    // mmap(addr=0, len=rsi, prot, flags, ...): fixed RW private pages, prot/flags ignored
    let mmap_case = e1(69) + e1(49) + e1(201) + e1(65) + e1(185) + e4(4) + e1(69) + e1(49) + e1(192) + e1(65) + e1(184) + e4(12288) + e1(72) + e1(137) + e1(242) + e1(72) + e1(49) + e1(201) + mov_ri64(r10, iat[3]) + e1(65) + e1(255) + e1(18)

    // exit(code=rdi)：ExitProcess 不返回；int3 兜底
    // exit(code=rdi): ExitProcess never returns; int3 as a guard
    let exit_case = e1(72) + e1(137) + e1(249) + mov_ri64(r10, iat[2]) + e1(65) + e1(255) + e1(18) + e1(204)

    // open(path=rdi, flags=rsi, mode=rdx)：CreateFileA。access 取 accmode 两位，
    // disposition 取 CREAT/TRUNC 两位；全组合覆盖，仅 accmode=3 无效返 -EINVAL。
    // 返回 HANDLE 原值（INVALID_HANDLE_VALUE=-1 恰落入既有 jl 检查）。
    // open(path=rdi, flags=rsi, mode=rdx): CreateFileA. Access comes from the
    // accmode bits, disposition from CREAT/TRUNC; every combination is covered
    // except accmode 3, which returns -EINVAL. The HANDLE returns as-is
    // (INVALID_HANDLE_VALUE=-1 flows into the existing jl checks).
    let o_a2 = mov_ri32(rdx, 3221225472)
    let o_a1 = mov_ri32(rdx, 1073741824) + jmp_rel32(str_len(o_a2))
    let o_a0 = mov_ri32(rdx, 2147483648) + jmp_rel32(str_len(o_a1) + str_len(o_a2))
    let o_call = mov_rr(rcx, r11) + mov_ri64(r8, 7) + xor_rr(r10, r10) + mov_mr(rsp, 32, r10) + mov_mr(rsp, 48, r10) + mov_ri64(r10, 128) + mov_mr(rsp, 40, r10) + mov_ri64(r10, iat[9]) + e1(65) + e1(255) + e1(18)
    let o_t11 = mov_ri32(r9, 2)
    let o_t10 = mov_ri32(r9, 4) + jmp_rel32(str_len(o_t11))
    let o_c1t = mov_rr(r9, rsi) + mov_ri64(r10, 512) + and_rr(r9, r10) + test_rr(r9, r9) + jne_rel32(str_len(o_t10))
    let o_t01 = mov_ri32(r9, 5) + jmp_rel32(str_len(o_c1t) + str_len(o_t10) + str_len(o_t11))
    let o_d00 = mov_ri32(r9, 3) + jmp_rel32(str_len(o_t01) + str_len(o_c1t) + str_len(o_t10) + str_len(o_t11))
    let o_dt0 = mov_rr(r9, rsi) + mov_ri64(r10, 512) + and_rr(r9, r10) + test_rr(r9, r9) + jne_rel32(str_len(o_d00))
    let o_dc = mov_rr(r9, rsi) + mov_ri64(r10, 64) + and_rr(r9, r10) + test_rr(r9, r9) + jne_rel32(str_len(o_dt0) + str_len(o_d00) + str_len(o_t01))
    let o_disp_all = o_dc + o_dt0 + o_d00 + o_t01 + o_c1t + o_t10 + o_t11
    let o_bad = mov_ri64(rax, 0 - 22) + jmp_rel32(str_len(o_a0) + str_len(o_a1) + str_len(o_a2) + str_len(o_disp_all) + str_len(o_call))
    let o_t2 = mov_ri64(r10, 2) + cmp_rr(r8, r10) + je_rel32(str_len(o_bad) + str_len(o_a0) + str_len(o_a1))
    let o_t1 = mov_ri64(r10, 1) + cmp_rr(r8, r10) + je_rel32(str_len(o_t2) + str_len(o_bad) + str_len(o_a0))
    let o_t0 = mov_ri64(r10, 0) + cmp_rr(r8, r10) + je_rel32(str_len(o_t1) + str_len(o_t2) + str_len(o_bad))
    let o_acc = mov_rr(r11, rdi) + mov_rr(r8, rsi) + mov_ri64(r10, 3) + and_rr(r8, r10)
    let open_case = o_acc + o_t0 + o_t1 + o_t2 + o_bad + o_a0 + o_a1 + o_a2 + o_disp_all + o_call

    // clock_gettime(CLOCK_MONOTONIC, ts=rsi)：QPC/QPF 合成 {sec, nsec}，
    // 商余拆分乘法避免 int64 溢出（与 C runtime 的 bur_mono_ns 同式）
    // clock_gettime(CLOCK_MONOTONIC, ts=rsi): QPC/QPF synthesized {sec, nsec}
    // with quotient/remainder split multiply (same shape as bur_mono_ns)
    let clock_case = e1(72) + e1(141) + e1(76) + e1(36) + e1(32) + mov_ri64(r10, iat[4]) + e1(65) + e1(255) + e1(18) + e1(72) + e1(141) + e1(76) + e1(36) + e1(40) + mov_ri64(r10, iat[5]) + e1(65) + e1(255) + e1(18) + e1(72) + e1(139) + e1(68) + e1(36) + e1(32) + e1(72) + e1(49) + e1(210) + e1(72) + e1(247) + e1(116) + e1(36) + e1(40) + e1(72) + e1(105) + e1(192) + e4(1000000000) + e1(73) + e1(137) + e1(193) + e1(72) + e1(137) + e1(208) + mov_ri64(r10, 1000000000) + e1(73) + e1(247) + e1(226) + e1(72) + e1(247) + e1(116) + e1(36) + e1(40) + e1(76) + e1(1) + e1(200) + mov_ri64(r10, 1000000000) + e1(72) + e1(49) + e1(210) + e1(73) + e1(247) + e1(242) + e1(72) + e1(137) + e1(6) + e1(72) + e1(137) + e1(86) + e1(8)

    // poll(fds=rdi, nfds=rsi, timeout=rdx)：nfds==0 走 Sleep（timer 等待唯一可达
    // 路径，单位同为毫秒）；负超时钳到 Sleep(0) 让步；nfds>0 落 ud2（P4 补 WSAPoll）。
    // poll(fds=rdi, nfds=rsi, timeout=rdx): nfds==0 takes Sleep (the only
    // reachable timer-wait path, same millisecond unit); negative timeouts clamp
    // to a Sleep(0) yield; nfds>0 falls into ud2 (P4 brings WSAPoll).
    let slp_arg = mov_rr(rcx, rdx) + test_rr(rdx, rdx) + jge_rel32(str_len(xor_rr(rcx, rcx))) + xor_rr(rcx, rcx)
    let slp_call = mov_ri64(r10, iat[6]) + e1(65) + e1(255) + e1(18) + xor_rr(rax, rax)
    // 成功路径必须跳过兜底 ud2 再落到链尾的 epi 跳转（对照 mp_ret 的写法）；
    // jne 的目标同步后移一个 jmp 的长度。
    // The success path must hop over the fallback ud2 before reaching the
    // chain's epi jump (cf. mp_ret); the jne target moves by one jmp length.
    let poll_case = test_rr(rsi, rsi) + jne_rel32(str_len(slp_arg) + str_len(slp_call) + str_len(guarded_ud2()) - 2) + slp_arg + slp_call + guarded_ud2()

    // mprotect(addr=rdi, len=rsi, prot=rdx)：唯一调用方传 prot=0（fiber guard）；
    // 0→PAGE_NOACCESS，其余→PAGE_EXECUTE_READWRITE；成功返 0，失败返 -1。
    // out 参数用分派器局部 [+40]（各 case 互斥，可复用）。
    // mprotect(addr=rdi, len=rsi, prot=rdx): the only caller passes prot=0 (the
    // fiber guard); 0→PAGE_NOACCESS, anything else→PAGE_EXECUTE_READWRITE;
    // 0 on success, -1 on failure. The out-param borrows dispatcher local [+40]
    // (cases are mutually exclusive, so locals are reusable).
    let mp_ret = test_rr(rax, rax) + je_rel32(str_len(xor_rr(rax, rax)) + 5 + str_len(mov_ri64(rax, 0 - 1))) + xor_rr(rax, rax) + jmp_rel32(str_len(mov_ri64(rax, 0 - 1))) + mov_ri64(rax, 0 - 1)
    let mprotect_case = mov_rr(rcx, rdi) + mov_ri64(r8, 64) + test_rr(rdx, rdx) + jne_rel32(str_len(mov_ri64(r8, 1))) + mov_ri64(r8, 1) + mov_rr(rdx, rsi) + lea(r9, rsp, 40) + mov_ri64(r10, iat[7]) + e1(65) + e1(255) + e1(18) + mp_ret

    // 1000/1001/1002 FindFirstFileA/FindNextFileA/FindClose：合成号直调，
    // 返回 HANDLE/-1、非零继续/0 收尾、忽略返回值。
    // 1000/1001/1002 FindFirstFileA/FindNextFileA/FindClose: synthetic numbers
    // called directly, returning HANDLE/-1, nonzero-more/0-done, and ignored.
    let findfirst_case = mov_rr(rcx, rdi) + mov_rr(rdx, rsi) + mov_ri64(r10, iat[13]) + e1(65) + e1(255) + e1(18)
    let findnext_case = mov_rr(rcx, rdi) + mov_rr(rdx, rsi) + mov_ri64(r10, iat[14]) + e1(65) + e1(255) + e1(18)
    let findclose_case = mov_rr(rcx, rdi) + mov_ri64(r10, iat[15]) + e1(65) + e1(255) + e1(18) + xor_rr(rax, rax)
    sys_dispatch_chain(head, [1, 60, 9, 228, 7, 10, 3, 2, 0, 4, 5, 1000, 1001, 1002], [write_case, exit_case, mmap_case, clock_case, poll_case, mprotect_case, close_case, open_case, read_case, stat_case, fstat_case, findfirst_case, findnext_case, findclose_case], epilogue)
}

// pe_emit_headers 生成 DOS 头 + COFF + PE32+ 可选头（240B 含 16 个数据目录）+ 单节表
// pe_emit_headers lays out DOS + COFF + PE32+ optional header (240B with 16 data
// directories) + the single section table
pub fn pe_emit_headers(entry_off, content_len, idata_off, idata_len) {
    // DOS：MZ 魔数 + e_lfanew=64，其余补零
    // DOS: MZ magic + e_lfanew=64, zero padding elsewhere
    let mut dos = "MZ"
    let mut di = 2
    while di < 60 {
        dos = dos + byte_chr(0)
        di = di + 1
    }
    dos = dos + e4(64)
    // COFF：AMD64、单节、可执行镜像 + 大地址感知
    // COFF: AMD64, one section, executable image + large-address-aware
    let coff = "PE" + byte_chr(0) + byte_chr(0) + e2(34404) + e2(1) + e4(0) + e4(0) + e4(0) + e2(240) + e2(34)
    let image_size = 4096 + pe_align(content_len, 4096)
    let opt = e2(523) + e1(0) + e1(0) + e4(content_len) + e4(0) + e4(0) + e4(pe_content_rva(entry_off)) + e4(4096) + e8(4194304) + e4(4096) + e4(512) + e2(6) + e2(0) + e2(0) + e2(0) + e2(6) + e2(0) + e4(0) + e4(image_size) + e4(512) + e4(0) + e2(3) + e2(0) + e8(8388608) + e8(1048576) + e8(1048576) + e8(4096) + e4(0) + e4(16)
    // 16 个数据目录，仅 [1]=导入表非零 / sixteen data directories, only [1]=imports set
    let mut dirs = ""
    let mut k = 0
    while k < 16 {
        if k == 1 {
            dirs = dirs + e4(pe_content_rva(idata_off)) + e4(idata_len)
        } else {
            dirs = dirs + e4(0) + e4(0)
        }
        k = k + 1
    }
    // 节表：.bub，CODE|EXECUTE|READ|WRITE
    // Section table: .bub with CODE|EXECUTE|READ|WRITE
    let sect = ".bub" + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + e4(content_len) + e4(4096) + e4(pe_align(content_len, 512)) + e4(512) + e4(0) + e4(0) + e2(0) + e2(0) + e4(3758154784)
    let hdr = dos + coff + opt + dirs + sect
    let mut pad = ""
    let mut pi = str_len(hdr)
    while pi < 512 {
        pad = pad + byte_chr(0)
        pi = pi + 1
    }
    hdr + pad
}

// pe_content_rva 把内容内偏移换算成 RVA（头区独占 RVA 0..4096，文件 0..512）
// pe_content_rva maps a content offset to its RVA (headers own RVA 0..4096, file 0..512)
pub fn pe_content_rva(off) {
    4096 + off
}

// pe_align 向上对齐：用模运算补齐（此处的整数除法链会向下截断）
// pe_align rounds up via modulo (a division-based form truncates downward)
pub fn pe_align(n, a) {
    let m = n % a
    if m == 0 {
        n
    } else {
        n + a - m
    }
}

// pe_hints_size 累计 hint/name 段尺寸（每项 2B hint + 名字 + NUL，补偶）
// pe_hints_size totals the hint/name segment (per entry 2B hint + name + NUL, even-padded)
pub fn pe_hints_size(fns) {
    let mut acc = 0
    let mut i = 0
    while i < len(fns) {
        let raw = 2 + str_len(fns[i]) + 1
        acc = acc + raw + raw % 2
        i = i + 1
    }
    acc
}

pub fn pe_ilt_size(n) {
    8 * (n + 1)
}

pub fn pe_iat_size(n) {
    8 * (n + 1)
}

// 导入 blob 五段定长偏移：DESC | ILT | IAT | HINTS | DLLNAME
// Import blob segments in fixed order: DESC | ILT | IAT | HINTS | DLLNAME
pub fn pe_import_desc_size(_n) {
    40
}
