    let bind_call = mov_rm(rcx, r11, 0) + mov_rr(r8, rdx) + mov_rr(rdx, rsi) + mov_ri64(r10, iat[18]) + e1(65) + e1(255) + e1(18) + cdqe() + test_rr(rax, rax) + jge_rel32(str_len(wsa_bind_err)) + wsa_bind_err
    let bind_case = pe_fd_lookup(iat, str_len(bind_call)) + bind_call

