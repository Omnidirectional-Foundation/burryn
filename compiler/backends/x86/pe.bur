// pe.bur — 手写 PE32+ 可执行文件生成器（Windows，无链接器依赖）。
// Hand-written PE32+ executable emitter (Windows, no linker dependency).
// 单一 RWX 节承载全部内容（对应 ELF 的单 PT_LOAD）；导入表只挂 kernel32，
// 供 syscall 兼容分派器调用。无重定位：DllCharacteristics 关 ASLR，固定基址加载。
// One RWX section carries the whole image (the counterpart of ELF's single
// PT_LOAD); imports hook kernel32 only, consumed by the syscall shim
// dispatcher. No relocations: ASLR off in DllCharacteristics, fixed-base load.

// pe_content_rva 把内容内偏移换算成 RVA（头区独占 RVA 0..4096，文件 0..512）
// pe_content_rva maps a content offset to its RVA (headers own RVA 0..4096, file 0..512)
pub fn pe_content_rva(off) {
    4096 + off
}

// pe_align 向上对齐：用模运算补齐（此处的整数除法链会向下截断）
// pe_align rounds up via modulo (a division-based form truncates downward)
pub fn pe_align(n, a) {
    let m = n % a
    if m == 0 {
        n
    } else {
        n + a - m
    }
}

// 导入 blob 五段定长偏移：DESC | ILT | IAT | HINTS | DLLNAME
// Import blob segments in fixed order: DESC | ILT | IAT | HINTS | DLLNAME

// pe_import_desc_size 固定 40B：单 DLL 一条描述符 + 一条空终止，与函数数无关
// pe_import_desc_size is a fixed 40B: one descriptor per DLL plus the null
// terminator, independent of the function count
pub fn pe_import_desc_size() {
    40
}

pub fn pe_ilt_size(n) {
    8 * (n + 1)
}

pub fn pe_iat_size(n) {
    8 * (n + 1)
}

// pe_hints_size 累计 hint/name 段尺寸（每项 2B hint + 名字 + NUL，补偶）
// pe_hints_size totals the hint/name segment (per entry 2B hint + name + NUL, even-padded)
pub fn pe_hints_size(fns) {
    let mut acc = 0
    let mut i = 0
    while i < len(fns) {
        let raw = 2 + str_len(fns[i]) + 1
        acc = acc + raw + raw % 2
        i = i + 1
    }
    acc
}

// pe_build_imports 生成导入 blob；idata_off 是 blob 在内容内的起点
// pe_build_imports builds the import blob; idata_off is the blob's content offset
pub fn pe_build_imports(fns, idata_off) {
    let n = len(fns)
    let desc_sz = pe_import_desc_size()
    let ilt_off = desc_sz
    let iat_off = ilt_off + pe_ilt_size(n)
    let hints_off = iat_off + pe_iat_size(n)
    let dll_off = hints_off + pe_hints_size(fns)
    let r = fn(off) {
        e4(pe_content_rva(idata_off + off))
    }
    // hint/name 各项的 blob 内偏移 / per-entry hint/name offsets inside the blob
    let mut hn = []
    let mut acc = 0
    let mut i = 0
    while i < n {
        push(hn, hints_off + acc)
        let raw = 2 + str_len(fns[i]) + 1
        acc = acc + raw + raw % 2
        i = i + 1
    }
    // 单描述符：ILT/IAT RVA + 时间戳/前向链零 + DLL 名 RVA，后接空终止
    // One descriptor: ILT/IAT RVAs + zero timestamp/forwarder chain + DLL name
    // RVA, followed by the null terminator
    let mut blob = r(ilt_off) + e4(0) + e4(0) + r(dll_off) + r(iat_off)
    blob = blob + e4(0) + e4(0) + e4(0) + e4(0) + e4(0)
    let mut ii = 0
    while ii < n {
        blob = blob + e8(pe_content_rva(idata_off + hn[ii]))
        ii = ii + 1
    }
    blob = blob + e8(0)
    let mut ai = 0
    while ai < n {
        blob = blob + e8(pe_content_rva(idata_off + hn[ai]))
        ai = ai + 1
    }
    blob = blob + e8(0)
    let mut hi = 0
    while hi < n {
        let nm = fns[hi]
        let raw = 2 + str_len(nm) + 1
        blob = blob + e2(0) + nm + byte_chr(0)
        if raw % 2 == 1 {
            blob = blob + byte_chr(0)
        }
        hi = hi + 1
    }
    blob = blob + "kernel32.dll" + byte_chr(0) + byte_chr(0)
    blob
}

// pe_build_dispatcher 生成 syscall 兼容分派器。
// pe_build_dispatcher emits the syscall shim dispatcher.
// 契约对齐 Linux syscall：只破坏 rax/rcx/r11，保全其余寄存器；结果走 rax。
// Contract mirrors Linux syscall: only rax/rcx/r11 die, everything else
// survives; result returns in rax.
// 支持号：1 write→WriteFile、60 exit→ExitProcess、9 mmap→VirtualAlloc、
// 228 clock_gettime→QPC/QPF 合成 timespec；其余 ud2 立即崩溃暴露缺口。
// Supported: 1 write→WriteFile, 60 exit→ExitProcess, 9 mmap→VirtualAlloc,
// 228 clock_gettime→QPC/QPF synthesizing timespec; anything else hits ud2.
// iat 为六个 IAT 槽的绝对地址：GetStdHandle / WriteFile / ExitProcess /
// VirtualAlloc / QueryPerformanceCounter / QueryPerformanceFrequency。
// iat holds six absolute IAT addresses in that order.
// 编码注记：movabs r10 用 REX.W+B（49 BA）——opcode B8+r 的寄存器扩展只认
// REX.B，REX.R 对 opcode 寄存器无效，写成 4C 会变成 movabs rdx 并踩掉参数。
// Encoding note: movabs r10 needs REX.W+B (49 BA) — the B8+r opcode register
// extends only via REX.B; REX.R does not apply to opcode registers, and a 4C
// prefix silently re-encodes it as movabs rdx, clobbering an argument.
// 帧布局：先保存寄存器再对齐/开栈，使影子空间与局部量位于保存区之下，
// API home space 不会踩到保存的输入寄存器；尾声按 rbp 定位弹回。
// Frame layout: registers are saved before aligning/opening the frame, so the
// shadow space and locals sit below the save area and API home space cannot
// clobber saved inputs; the epilogue unwinds via rbp.
pub fn pe_build_dispatcher(iat) {
    // 入口：push rbp + 六个可能存活的输入寄存器（rdi/rsi/rdx/r8/r9/r10），
    // 再 and rsp 对齐并开 64B（32B 影子空间 + 局部量）
    // Prologue: push rbp plus the six possibly-live input registers
    // (rdi/rsi/rdx/r8/r9/r10), then and rsp to align and open 64B
    // (32B shadow space + locals)
    let head = e1(85) + e1(72) + e1(137) + e1(229) + e1(87) + e1(86) + e1(82) + e1(65) + e1(80) + e1(65) + e1(81) + e1(65) + e1(82) + e1(72) + e1(131) + e1(228) + e1(240) + e1(72) + e1(131) + e1(236) + e1(64)

    // 分派链：cmp rax, imm32 + je rel32；四个 case 全部放在 ud2 之后
    // Dispatch chain: cmp rax,imm32 + je rel32; all four cases live after ud2
    let cmp_write = e1(72) + e1(61) + e4(1) + e1(15) + e1(132)
    let cmp_exit = e1(72) + e1(61) + e4(60) + e1(15) + e1(132)
    let cmp_mmap = e1(72) + e1(61) + e4(9) + e1(15) + e1(132)
    let cmp_clock = e1(72) + e1(61) + e4(228) + e1(15) + e1(132)
    let default_case = e1(15) + e1(11)
    let arm = str_len(cmp_write) + 4
    let dispatch_end = 4 * arm + str_len(default_case)

    // 尾声：lea rsp,[rbp-48] 回到保存区底，逆序弹出六个寄存器与 rbp
    // Epilogue: lea rsp,[rbp-48] lands at the bottom of the save area; the six
    // registers and rbp pop in reverse order
    let epilogue = e1(72) + e1(141) + e1(101) + e1(208) + e1(65) + e1(90) + e1(65) + e1(89) + e1(65) + e1(88) + e1(90) + e1(94) + e1(95) + e1(93) + e1(195)

    // write(fd=rdi, buf=rsi, len=rdx)：句柄 1→STD_OUTPUT 其余→STD_ERROR；
    // 长度在首次 Win64 调用前存入局部 [rsp+40]（rdx 属调用方保存）；
    // WriteFile(hANDLE, buf, len, &written=[rsp+48], NULL@[rsp+32])；
    // 成功回传长度（Linux 语义），失败 -1
    // write(fd=rdi, buf=rsi, len=rdx): handle 1→STD_OUTPUT else STD_ERROR;
    // the length is stashed in local [rsp+40] before the first Win64 call
    // (rdx is caller-saved); WriteFile(handle, buf, len, &written=[rsp+48],
    // NULL@[rsp+32]); returns length on success (Linux semantics), -1 on failure
    let write_case = e1(72) + e1(137) + e1(84) + e1(36) + e1(40) + e1(73) + e1(199) + e1(195) + e1(245) + e1(255) + e1(255) + e1(255) + e1(72) + e1(131) + e1(255) + e1(1) + e1(116) + e1(7) + e1(73) + e1(199) + e1(195) + e1(244) + e1(255) + e1(255) + e1(255) + e1(76) + e1(137) + e1(217) + e1(73) + e1(186) + e8(iat[0]) + e1(65) + e1(255) + e1(18) + e1(72) + e1(137) + e1(193) + e1(72) + e1(137) + e1(242) + e1(76) + e1(139) + e1(68) + e1(36) + e1(40) + e1(72) + e1(199) + e1(68) + e1(36) + e1(32) + e4(0) + e1(76) + e1(141) + e1(76) + e1(36) + e1(48) + e1(73) + e1(186) + e8(iat[1]) + e1(65) + e1(255) + e1(18) + e1(133) + e1(192) + e1(72) + e1(139) + e1(68) + e1(36) + e1(40) + e1(116) + e1(4) + e1(72) + e1(131) + e1(200) + e1(255)

    // exit(code=rdi)：ExitProcess 不返回；int3 兜底
    // exit(code=rdi): ExitProcess never returns; int3 as a guard
    let exit_case = e1(72) + e1(137) + e1(249) + e1(73) + e1(186) + e8(iat[2]) + e1(65) + e1(255) + e1(18) + e1(204)

    // mmap(addr=0, len=rsi, prot, flags, ...)：固定 RW 私有页，prot/flags 忽略
    // mmap(addr=0, len=rsi, prot, flags, ...): fixed RW private pages, prot/flags ignored
    let mmap_case = e1(65) + e1(184) + e4(12288) + e1(65) + e1(185) + e4(4) + e1(72) + e1(137) + e1(242) + e1(72) + e1(49) + e1(201) + e1(73) + e1(186) + e8(iat[3]) + e1(65) + e1(255) + e1(18)

    // clock_gettime(CLOCK_MONOTONIC, ts=rsi)：QPC/QPF 合成 {sec, nsec}：
    // tv_sec=count/freq，tv_nsec=(count%freq)*1e9/freq（商余拆分乘法，
    // 与 C runtime 的 bur_mono_ns 同式）
    // clock_gettime(CLOCK_MONOTONIC, ts=rsi): QPC/QPF synthesized {sec, nsec}:
    // tv_sec=count/freq, tv_nsec=(count%freq)*1e9/freq (quotient/remainder
    // split multiply, same shape as bur_mono_ns in the C runtime)
    let clock_case = e1(72) + e1(141) + e1(76) + e1(36) + e1(32) + e1(73) + e1(186) + e8(iat[4]) + e1(65) + e1(255) + e1(18) + e1(72) + e1(141) + e1(76) + e1(36) + e1(40) + e1(73) + e1(186) + e8(iat[5]) + e1(65) + e1(255) + e1(18) + e1(72) + e1(139) + e1(68) + e1(36) + e1(32) + e1(72) + e1(49) + e1(210) + e1(72) + e1(247) + e1(116) + e1(36) + e1(40) + e1(72) + e1(137) + e1(6) + e1(73) + e1(186) + e8(1000000000) + e1(72) + e1(137) + e1(208) + e1(73) + e1(247) + e1(226) + e1(72) + e1(247) + e1(116) + e1(36) + e1(40) + e1(72) + e1(137) + e1(70) + e1(8)

    // 各 case 相对分派链头的偏移 / per-case offsets from the dispatch chain head
    let write_off = dispatch_end
    let exit_off = write_off + str_len(write_case) + 5
    let mmap_off = exit_off + str_len(exit_case)
    let clock_off = mmap_off + str_len(mmap_case) + 5
    let epi_off = clock_off + str_len(clock_case)

    // je rel32 位移自指令尾起算；write/mmap 以 5B jmp rel32 归拢到尾声
    // je rel32 displacements measure from each instruction's end; write/mmap
    // funnel into the shared epilogue via 5-byte jmp rel32
    let jmp_epi_after_write = e1(233) + e4(epi_off - exit_off)
    let jmp_epi_after_mmap = e1(233) + e4(epi_off - clock_off)
    head + cmp_write + e4(write_off - arm) + cmp_exit + e4(exit_off - 2 * arm) + cmp_mmap + e4(mmap_off - 3 * arm) + cmp_clock + e4(clock_off - 4 * arm) + default_case + write_case + jmp_epi_after_write + exit_case + mmap_case + jmp_epi_after_mmap + clock_case + epilogue
}

// pe_emit_headers 生成 DOS 头 + COFF + PE32+ 可选头（240B 含 16 个数据目录）+ 单节表
// pe_emit_headers lays out DOS + COFF + PE32+ optional header (240B with 16 data
// directories) + the single section table
pub fn pe_emit_headers(entry_off, content_len, idata_off, idata_len) {
    // DOS：MZ 魔数 + e_lfanew=64，其余补零
    // DOS: MZ magic + e_lfanew=64, zero padding elsewhere
    let mut dos = "MZ"
    let mut di = 2
    while di < 60 {
        dos = dos + byte_chr(0)
        di = di + 1
    }
    dos = dos + e4(64)
    // COFF：AMD64、单节、可执行镜像 + 大地址感知
    // COFF: AMD64, one section, executable image + large-address-aware
    let coff = "PE" + byte_chr(0) + byte_chr(0) + e2(34404) + e2(1) + e4(0) + e4(0) + e4(0) + e2(240) + e2(34)
    let image_size = 4096 + pe_align(content_len, 4096)
    let opt = e2(523) + e1(0) + e1(0) + e4(content_len) + e4(0) + e4(0) + e4(pe_content_rva(entry_off)) + e4(4096) + e8(4194304) + e4(4096) + e4(512) + e2(6) + e2(0) + e2(0) + e2(0) + e2(6) + e2(0) + e4(0) + e4(image_size) + e4(512) + e4(0) + e2(3) + e2(0) + e8(8388608) + e8(1048576) + e8(1048576) + e8(4096) + e4(0) + e4(16)
    // 16 个数据目录，仅 [1]=导入表非零 / sixteen data directories, only [1]=imports set
    let mut dirs = ""
    let mut k = 0
    while k < 16 {
        if k == 1 {
            dirs = dirs + e4(pe_content_rva(idata_off)) + e4(idata_len)
        } else {
            dirs = dirs + e4(0) + e4(0)
        }
        k = k + 1
    }
    // 节表：.bub，CODE|EXECUTE|READ|WRITE
    // Section table: .bub with CODE|EXECUTE|READ|WRITE
    let sect = ".bub" + byte_chr(0) + byte_chr(0) + byte_chr(0) + byte_chr(0) + e4(content_len) + e4(4096) + e4(pe_align(content_len, 512)) + e4(512) + e4(0) + e4(0) + e2(0) + e2(0) + e4(3758154784)
    let hdr = dos + coff + opt + dirs + sect
    let mut pad = ""
    let mut pi = str_len(hdr)
    while pi < 512 {
        pad = pad + byte_chr(0)
        pi = pi + 1
    }
    hdr + pad
}

// emit_pe 装配 PE32+：头区(512B) + 内容(补齐 512)；入口在内容内 entry_off 处
// emit_pe assembles the PE32+: 512-byte header area + content (padded to 512);
// the entry point sits at entry_off within the content
pub fn emit_pe(content, entry_off, idata_off, idata_len) {
    let mut padded = content
    let n = str_len(content) % 512
    if n != 0 {
        let mut pz = ""
        let mut zi = 0
        while zi < 512 - n {
            pz = pz + byte_chr(0)
            zi = zi + 1
        }
        padded = padded + pz
    }
    pe_emit_headers(entry_off, str_len(content), idata_off, idata_len) + padded
}
