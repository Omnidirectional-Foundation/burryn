    let clock_case = e1(72) + e1(141) + e1(76) + e1(36) + e1(32) + mov_ri64(r10, iat[4]) + e1(65) + e1(255) + e1(18) + e1(72) + e1(141) + e1(76) + e1(36) + e1(40) + mov_ri64(r10, iat[5]) + e1(65) + e1(255) + e1(18) + e1(72) + e1(139) + e1(68) + e1(36) + e1(32) + e1(72) + e1(49) + e1(210) + e1(72) + e1(247) + e1(116) + e1(36) + e1(40) + e1(72) + e1(105) + e1(192) + e4(1000000000) + e1(73) + e1(137) + e1(193) + e1(72) + e1(137) + e1(208) + mov_ri64(r10, 1000000000) + e1(73) + e1(247) + e1(226) + e1(72) + e1(247) + e1(116) + e1(36) + e1(40) + e1(76) + e1(1) + e1(200) + mov_ri64(r10, 1000000000) + e1(72) + e1(49) + e1(210) + e1(73) + e1(247) + e1(242) + e1(72) + e1(137) + e1(6) + e1(72) + e1(137) + e1(86) + e1(8)

