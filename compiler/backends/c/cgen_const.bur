// cgen_const.bur — 常量键与常量取值。
// cgen_const.bur — constant keys and lookups.

import "burryn.dev/compiler/lib"

fn cgen_reg_key(cv) {
    match cv {
        lib::CVal::CFn(fh) => "f:" + str(fh),
        lib::CVal::CEnumType(eh) => "e:" + str(eh),
        lib::CVal::CSingleton(eh, i) => "s:" + str(eh) + ":" + str(i),
        lib::CVal::CCtor(eh, i) => "c:" + str(eh) + ":" + str(i),
        _ => "",
    }
}

fn cgen_const_str(fh, idx, f_consts) {
    match f_consts[fh][idx] {
        lib::CVal::CStr(s) => s,
        _ => "",
    }
}

fn cgen_fn_const(fh, idx, f_consts) {
    match f_consts[fh][idx] {
        lib::CVal::CFn(sub) => sub,
        _ => 0,
    }
}
