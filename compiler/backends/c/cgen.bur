// cgen.bur — C 后端：把字节码逐条翻译为 C 函数体（忠实 by construction）。
// The C backend: translates bytecode opcode by opcode into C function bodies
// (faithful by construction).
// 生成程序带 #line 指令映射回 .bur 源码，cc 报错行号直接指向 Burryn 源码；
// 值模型 = 16B tagged Value（与 VM 一致），C 局部变量显式存活于 shadow stack 供精确 GC 扫描。
// Emitted C carries #line directives mapping back to the .bur sources,
// so cc errors point at Burryn code;
// the value model is the 16-byte tagged Value (same as the VM), with C locals
// rooted on a shadow stack for precise GC.

import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/frontend"

// cgen_program_to_buf 是 C 后端入口：整程序字节码表 → 按源文件拆成多单元 C 文件，
// 返回 [name, content] 列表（含 bur_units.h 与 program.c），由 cc 分单元编译后链接
// cgen_program_to_buf is the entry: whole-program bytecode tables to per-source-file
// C units; returns [name, content] pairs (including bur_units.h and program.c)
pub fn cgen_program_to_buf(f_name, f_file, f_arity, f_nupvals, f_code, f_spans, f_consts, en_qual, en_vnames, en_varities, ls_files, ls_names, ls_tables) {
    let mut out = []
    // w 追加到输出缓冲 / w appends to the output
    fn w(s) capture(ref f_name, ref f_file, ref f_arity, ref f_nupvals, ref f_code, ref f_spans, ref f_consts, ref en_qual, ref en_vnames, ref en_varities, ref ls_files, ref ls_names, ref ls_tables, ref out, ref o_kind, ref o_str, ref o_a, ref o_b, ref ids, ref fconst_ids, ref opt_id, ref res_id, ref out_id, ref entry, ref fun_ids, ref fun_fhs, ref oi, ref fi, ref bi) {
        push(out, s)
    }

    let mut o_kind = []
    let mut o_str = []
    let mut o_a = []
    let mut o_b = []
    let mut ids = map()
    let mut fconst_ids = []
    for _f in f_name {
        push(fconst_ids, [])
    }

    // alloc_obj 生成对象分配的 C 代码 / alloc_obj emits object allocation C code
    fn alloc_obj(kind, s, a, b) capture(ref f_name, ref f_file, ref f_arity, ref f_nupvals, ref f_code, ref f_spans, ref f_consts, ref en_qual, ref en_vnames, ref en_varities, ref ls_files, ref ls_names, ref ls_tables, ref out, ref o_kind, ref o_str, ref o_a, ref o_b, ref ids, ref fconst_ids, ref opt_id, ref res_id, ref out_id, ref entry, ref fun_ids, ref fun_fhs, ref oi, ref fi, ref bi) {
        push(o_kind, kind)
        push(o_str, s)
        push(o_a, a)
        push(o_b, b)
        len(o_kind) - 1
    }

    // register 注册常量并分配 id / register allocates a constant id
    fn register(cv) capture(ref f_name, ref f_file, ref f_arity, ref f_nupvals, ref f_code, ref f_spans, ref f_consts, ref en_qual, ref en_vnames, ref en_varities, ref ls_files, ref ls_names, ref ls_tables, ref out, ref o_kind, ref o_str, ref o_a, ref o_b, ref ids, ref fconst_ids, ref opt_id, ref res_id, ref out_id, ref entry, ref fun_ids, ref fun_fhs, ref oi, ref fi, ref bi) {
        let key = cgen_reg_key(cv)
        if key != "" {
            match get(ids, key) {
                Some(id) => {
                    return id
                },
                None => {},
            }
        }
        let id = match cv {
            lib::CVal::CStr(s) => alloc_obj(0, s, 0, 0),
            lib::CVal::CFn(fh) => alloc_obj(1, "", fh, 0),
            lib::CVal::CEnumType(eh) => alloc_obj(2, "", eh, 0),
            lib::CVal::CCtor(eh, i) => alloc_obj(3, "", eh, i),
            lib::CVal::CSingleton(eh, i) => alloc_obj(4, "", eh, i),
            _ => -1,
        }
        if key != "" {
            put(ids, key, id)
        }
        match cv {
            lib::CVal::CFn(fh) => {
                let mut slot_ids = []
                for c in f_consts[fh] {
                    let is_obj = match c {
                        lib::CVal::CInt(_) => false,
                        lib::CVal::CFloat(_) => false,
                        _ => true,
                    }
                    push(slot_ids, if is_obj {
                        register(c)
                    } else {
                        -1
                    })
                }
                fconst_ids[fh] = slot_ids
            },
            lib::CVal::CCtor(eh, _) => {
                let _ = register(lib::CVal::CEnumType(eh))
            },
            lib::CVal::CSingleton(eh, _) => {
                let _ = register(lib::CVal::CEnumType(eh))
            },
            _ => {},
        }
        id
    }

    let opt_id = register(lib::CVal::CEnumType(0))
    let res_id = register(lib::CVal::CEnumType(1))
    let out_id = register(lib::CVal::CEnumType(2))
    let entry = register(lib::CVal::CFn(0))

    w("// Generated by the Burryn C backend. Do not edit.\n")
    w("#include \"burrt.h\"\n")
    w("#include \"bur_units.h\"\n")
    w("\n")
    let mut head = ["// Generated by the Burryn C backend. Do not edit.\n", "#include \"burrt.h\"\n", "#include \"bur_units.h\"\n", "\n"]

    let mut units_h = []
    let mut mark_units = []
    let mut mark_starts = []
    let mut fun_ids = []
    let mut fun_fhs = []
    let mut oi = 0
    while oi < len(o_kind) {
        if o_kind[oi] == 1 {
            push(fun_ids, oi)
            push(fun_fhs, o_a[oi])
        }
        oi = oi + 1
    }

    {
        push(units_h, "// bur_units.h — cross-unit declarations. Do not edit.\n")
        push(units_h, "#ifndef BUR_UNITS_H\n#define BUR_UNITS_H\n\n")
        push(units_h, "extern Obj *bur_K[];\n")
    }
    for id in fun_ids {
        push(units_h, "extern void bur_fn_" + str(id) + "(void);\n")
    }
    push(units_h, "\n")

    w("Obj *bur_K[" + str(len(o_kind)) + "];\n")
    let mut fi = 0
    while fi < len(fun_ids) {
        if len(f_consts[fun_fhs[fi]]) > 0 {
            push(units_h, "extern Value bur_consts_" + str(fun_ids[fi]) + "[];\n")
            push(mark_units, unit_of(f_file[fun_fhs[fi]]))
            push(mark_starts, len(out))
            w("Value bur_consts_" + str(fun_ids[fi]) + "[" + str(len(f_consts[fun_fhs[fi]])) + "];\n")
        }
        fi = fi + 1
    }
    w("\n")

    // c_value 把常量转 C 值 / c_value converts a constant to a C value
    fn c_value(cv, id) capture(ref f_name, ref f_file, ref f_arity, ref f_nupvals, ref f_code, ref f_spans, ref f_consts, ref en_qual, ref en_vnames, ref en_varities, ref ls_files, ref ls_names, ref ls_tables, ref out, ref o_kind, ref o_str, ref o_a, ref o_b, ref ids, ref fconst_ids, ref opt_id, ref res_id, ref out_id, ref entry, ref fun_ids, ref fun_fhs, ref oi, ref fi, ref bi) {
        match cv {
            lib::CVal::CInt(n) => "bur_int((int64_t)UINT64_C(" + dec_uint64(n) + "))",
            lib::CVal::CFloat(fl) => "bur_float(" + c_float(fl) + ")",
            _ => "bur_obj(bur_K[" + str(id) + "])",
        }
    }

    // emit_inst 按 opcode 发射 C 代码（与 VM 语义逐条对应）
    // emit_inst emits C per opcode (line-by-line VM semantics)
    fn emit_inst(id, fh, code, ip, hd) capture(ref f_name, ref f_file, ref f_arity, ref f_nupvals, ref f_code, ref f_spans, ref f_consts, ref en_qual, ref en_vnames, ref en_varities, ref ls_files, ref ls_names, ref ls_tables, ref out, ref o_kind, ref o_str, ref o_a, ref o_b, ref ids, ref fconst_ids, ref opt_id, ref res_id, ref out_id, ref entry, ref fun_ids, ref fun_fhs, ref oi, ref fi, ref bi) {
        let op = code[ip]
        if op == lib::op_const {
            w("\tbur_push(bur_consts_" + str(id) + "[" + str(cgen_read_u16(code, ip + 1)) + "]);\n")
            ip + 3
        } else if op == lib::op_unit {
            w("\tbur_push(bur_unit());\n")
            ip + 1
        } else if op == lib::op_true {
            w("\tbur_push(bur_bool(true));\n")
            ip + 1
        } else if op == lib::op_false {
            w("\tbur_push(bur_bool(false));\n")
            ip + 1
        } else if op == lib::op_pop {
            w("\tbur_pop();\n")
            ip + 1
        } else if op == lib::op_pop_n {
            w("\tbur_cur->top -= " + str(code[ip + 1]) + ";\n")
            ip + 2
        } else if op == lib::op_close_upvalue {
            w("\tbur_close_upvalues(bur_cur->top - 1); bur_pop();\n")
            ip + 1
        } else if op == lib::op_end_block {
            let n = str(code[ip + 1])
            w("\t" + chr(123) + " Value v = bur_pop(); bur_close_upvalues(bur_cur->top - " + n + "); bur_cur->top -= " + n + "; bur_push(v); }\n")
            ip + 2
        } else if op == lib::op_get_local {
            w("\tbur_push(bur_cur->stack[base + " + str(cgen_read_u16(code, ip + 1)) + "]);\n")
            ip + 3
        } else if op == lib::op_set_local {
            w("\tbur_cur->stack[base + " + str(cgen_read_u16(code, ip + 1)) + "] = bur_peek(0);\n")
            ip + 3
        } else if op == lib::op_get_global {
            let n = cgen_const_str(fh, cgen_read_u16(code, ip + 1), f_consts)
            w("\tbur_push(bur_get_global(" + c_str(n) + ", " + str(str_len(n)) + "));\n")
            ip + 3
        } else if op == lib::op_def_global {
            let n = cgen_const_str(fh, cgen_read_u16(code, ip + 1), f_consts)
            w("\t" + chr(123) + " Value v = bur_pop(); bur_globals_put(" + c_str(n) + ", " + str(str_len(n)) + ", v); }\n")
            ip + 3
        } else if op == lib::op_set_global {
            let n = cgen_const_str(fh, cgen_read_u16(code, ip + 1), f_consts)
            w("\tbur_set_global(" + c_str(n) + ", " + str(str_len(n)) + ", bur_peek(0));\n")
            ip + 3
        } else if op == lib::op_get_upval {
            w("\tbur_push(upvalue_get(self->upvals[" + str(cgen_read_u16(code, ip + 1)) + "]));\n")
            ip + 3
        } else if op == lib::op_set_upval {
            w("\tupvalue_set(self->upvals[" + str(cgen_read_u16(code, ip + 1)) + "], bur_peek(0));\n")
            ip + 3
        } else if op == lib::op_eq {
            w("\t" + chr(123) + " Value r = bur_bool(bur_eq(bur_peek(1), bur_peek(0))); bur_cur->top -= 2; bur_push(r); }\n")
            ip + 1
        } else if op == lib::op_neq {
            w("\t" + chr(123) + " Value r = bur_bool(!bur_eq(bur_peek(1), bur_peek(0))); bur_cur->top -= 2; bur_push(r); }\n")
            ip + 1
        } else if op == lib::op_gt || op == lib::op_gt_eq || op == lib::op_lt || op == lib::op_lt_eq {
            let kind = if op == lib::op_gt {
                0
            } else if op == lib::op_gt_eq {
                1
            } else if op == lib::op_lt {
                2
            } else {
                3
            }
            w("\t" + chr(123) + " Value r = bur_compare(bur_peek(1), bur_peek(0), " + str(kind) + "); bur_cur->top -= 2; bur_push(r); }\n")
            ip + 1
        } else if op == lib::op_add {
            w("\t" + chr(123) + " Value r = bur_add(bur_peek(1), bur_peek(0)); bur_cur->top -= 2; bur_push(r); }\n")
            ip + 1
        } else if op == lib::op_sub || op == lib::op_mul || op == lib::op_div || op == lib::op_mod {
            let c = if op == lib::op_sub {
                "'-'"
            } else if op == lib::op_mul {
                "'*'"
            } else if op == lib::op_div {
                "'/'"
            } else {
                "'%'"
            }
            w("\t" + chr(123) + " Value r = bur_arith(bur_peek(1), bur_peek(0), " + c + "); bur_cur->top -= 2; bur_push(r); }\n")
            ip + 1
        } else if op == lib::op_neg {
            w("\t" + chr(123) + " Value v = bur_pop(); bur_push(bur_neg(v)); }\n")
            ip + 1
        } else if op == lib::op_not {
            w("\t" + chr(123) + " Value v = bur_pop(); bur_push(bur_not(v)); }\n")
            ip + 1
        } else if op == lib::op_jump {
            w("\tgoto L" + str(ip + 3 + cgen_read_u16(code, ip + 1)) + ";\n")
            ip + 3
        } else if op == lib::op_jump_if_false {
            w("\t" + chr(123) + " Value c = bur_peek(0); if (c.t != VBOOL) bur_trap(\"condition must be a bool, got %s\", bur_typename(c)); if (!c.u.b) goto L" + str(ip + 3 + cgen_read_u16(code, ip + 1)) + "; }\n")
            ip + 3
        } else if op == lib::op_jump_if_true {
            w("\t" + chr(123) + " Value c = bur_peek(0); if (c.t != VBOOL) bur_trap(\"condition must be a bool, got %s\", bur_typename(c)); if (c.u.b) goto L" + str(ip + 3 + cgen_read_u16(code, ip + 1)) + "; }\n")
            ip + 3
        } else if op == lib::op_jump_if_false_pop {
            w("\t" + chr(123) + " Value c = bur_peek(0); if (c.t != VBOOL) bur_trap(\"condition must be a bool, got %s\", bur_typename(c)); bool t = c.u.b; bur_pop(); if (!t) goto L" + str(ip + 3 + cgen_read_u16(code, ip + 1)) + "; }\n")
            ip + 3
        } else if op == lib::op_loop {
            w("\tif (--bur_cur->budget <= 0) bur_preempt();\n")
            w("\tgoto L" + str(ip + 3 - cgen_read_u16(code, ip + 1)) + ";\n")
            ip + 3
        } else if op == lib::op_call {
            w("\tbur_call(" + str(code[ip + 1]) + ");\n")
            ip + 2
        } else if op == lib::op_closure {
            let fn_c = cgen_read_u16(code, ip + 1)
            let sub = cgen_fn_const(fh, fn_c, f_consts)
            let mut p = ip + 3
            w("\t" + chr(123) + " OClosure *cl = bur_new_closure((OFunc *)bur_consts_" + str(id) + "[" + str(fn_c) + "].u.o); bur_push(bur_obj((Obj *)cl));\n")
            let mut i = 0
            while i < f_nupvals[sub] {
                // 描述符：bit0=islocal，bit1=ref（capture(ref name) 声明）
                // descriptor: bit0=islocal, bit1=ref (capture(ref name) declaration)
                let flag = code[p]
                p = p + 1
                let uidx = cgen_read_u16(code, p)
                p = p + 2
                if flag % 2 == 1 {
                    if flag >= 2 {
                        w("\t  cl->upvals[" + str(i) + "] = bur_capture_upvalue(base + " + str(uidx) + ");\n")
                    } else {
                        // 值捕获：独立 closed cell 快照（不共享、不 open）
                        // value capture: an independent closed-cell snapshot
                        w("\t  cl->upvals[" + str(i) + "] = bur_capture_value(base + " + str(uidx) + ");\n")
                    }
                } else {
                    // 透传父 upvalue：父 open（ref）共享，父 closed（值捕获）再拷一份独立快照
                    // inherit the parent upvalue: share an open (ref) cell, copy a
                    // closed (value-captured) cell into a fresh independent snapshot
                    w("\t  cl->upvals[" + str(i) + "] = self->upvals[" + str(uidx) + "]->open ? self->upvals[" + str(uidx) + "] : bur_new_closed_cell(upvalue_get(self->upvals[" + str(uidx) + "]));\n")
                }
                i = i + 1
            }
            w("\t}\n")
            p
        } else if op == lib::op_return {
            if hd {
                w("\t" + chr(123) + " bur_run_defers(dbase); Value r = bur_pop(); bur_close_upvalues(base); bur_cur->top = base; bur_push(r); return; }\n")
            } else {
                w("\t" + chr(123) + " Value r = bur_pop(); bur_close_upvalues(base); bur_cur->top = base; bur_push(r); return; }\n")
            }
            ip + 1
        } else if op == lib::op_list {
            let n = str(cgen_read_u16(code, ip + 1))
            w("\t" + chr(123) + " OList *l = bur_new_list(&bur_cur->stack[bur_cur->top - " + n + "], " + n + "); bur_cur->top -= " + n + "; bur_push(bur_obj((Obj *)l)); }\n")
            ip + 3
        } else if op == lib::op_index_get {
            w("\t" + chr(123) + " Value r = bur_index_get(bur_peek(1), bur_peek(0)); bur_cur->top -= 2; bur_push(r); }\n")
            ip + 1
        } else if op == lib::op_index_set {
            w("\t" + chr(123) + " Value val = bur_pop(); Value idx = bur_pop(); Value tgt = bur_pop(); bur_index_set(tgt, idx, val); }\n")
            ip + 1
        } else if op == lib::op_len {
            w("\t" + chr(123) + " Value v = bur_pop(); bur_push(bur_int(bur_len(v))); }\n")
            ip + 1
        } else if op == lib::op_test_variant {
            w("\t" + chr(123) + " Value et = bur_pop(); Value cand = bur_pop(); bool m = false; if (cand.t == VOBJ && cand.u.o->type == OBJ_ENUMINST) " + chr(123) + " OEnumInst *in = (OEnumInst *)cand.u.o; m = in->enm == (OEnumType *)et.u.o && in->variant == " + str(code[ip + 1]) + "; } bur_push(bur_bool(m)); }\n")
            ip + 2
        } else if op == lib::op_get_field {
            w("\t" + chr(123) + " Value v = bur_pop(); OEnumInst *in = (OEnumInst *)v.u.o; bur_push(in->fields[" + str(code[ip + 1]) + "]); }\n")
            ip + 2
        } else if op == lib::op_no_match {
            w("\t" + chr(123) + " Buf nb = " + chr(123) + "0}; bur_format(&nb, bur_peek(0), true); buf_char(&nb, 0); bur_trap(\"no pattern matched value %s\", nb.data ? nb.data : \"\"); }\n")
            ip + 1
        } else if op == lib::op_try {
            w("\t" + chr(123) + " Value v = bur_peek(0);\n")
            w("\t  OEnumInst *in = (v.t == VOBJ && v.u.o->type == OBJ_ENUMINST) ? (OEnumInst *)v.u.o : NULL;\n")
            w("\t  if (!in || (in->enm != bur_opt_enum && in->enm != bur_res_enum)) bur_trap(\"'?' needs an Option or Result, got %s\", bur_typename(v));\n")
            w("\t  if (in->variant == 0) " + chr(123) + " Value inner = in->fields[0]; bur_pop(); bur_push(inner); }\n")
            if hd {
                w("\t  else " + chr(123) + " bur_run_defers(dbase); bur_pop(); bur_close_upvalues(base); bur_cur->top = base; bur_push(v); return; } }\n")
            } else {
                w("\t  else " + chr(123) + " bur_pop(); bur_close_upvalues(base); bur_cur->top = base; bur_push(v); return; } }\n")
            }
            ip + 1
        } else if op == lib::op_defer {
            w("\t" + chr(123) + " Value cl = bur_pop(); bur_defer_push(cl); }\n")
            ip + 1
        } else if op == lib::op_spawn {
            w("\tbur_spawn(" + str(code[ip + 1]) + ");\n")
            ip + 2
        } else if op == lib::op_send {
            w("\t" + chr(123) + " Value val = bur_pop(); Value ch = bur_pop(); bur_send(ch, val); }\n")
            ip + 1
        } else if op == lib::op_recv {
            w("\t" + chr(123) + " Value v = bur_recv(bur_peek(0)); bur_pop(); bur_push(v); }\n")
            ip + 1
        } else if op == lib::op_chan_next {
            w("\t" + chr(123) + " Value v; if (bur_chan_next(bur_peek(0), &v)) " + chr(123) + " bur_pop(); bur_push(v); } else " + chr(123) + " bur_pop(); goto L" + str(ip + 3 + cgen_read_u16(code, ip + 1)) + "; } }\n")
            ip + 3
        } else if op == lib::op_select {
            let mut p = ip + 1
            let n_arms = code[p]
            let has_default = code[p + 1] != 0
            p = p + 2
            let mut kinds = []
            let mut tgts = []
            let mut i = 0
            while i < n_arms {
                push(kinds, code[p])
                p = p + 1
                push(tgts, p + 2 + cgen_read_u16(code, p))
                p = p + 2
                i = i + 1
            }
            let mut default_target = -1
            if has_default {
                default_target = p + 2 + cgen_read_u16(code, p)
                p = p + 2
            }
            let mut ks = []
            for k in kinds {
                push(ks, str(k))
            }
            w("\t" + chr(123) + " static const unsigned char selk_" + str(id) + "_" + str(ip) + "[] = " + chr(123) + "" + join(ks, ", ") + "};\n")
            w("\t  switch (bur_select(selk_" + str(id) + "_" + str(ip) + ", " + str(n_arms) + ", " + str(has_default) + ")) " + chr(123) + "\n")
            i = 0
            while i < n_arms {
                w("\t  case " + str(i) + ": goto L" + str(tgts[i]) + ";\n")
                i = i + 1
            }
            if has_default {
                w("\t  case " + str(n_arms) + ": goto L" + str(default_target) + ";\n")
            }
            w("\t  }\n\t}\n")
            p
        } else if op == lib::op_tuple {
            let n = code[ip + 1]
            w("\tbur_tuple_make(" + str(n) + ");\n")
            ip + 2
        } else if op == lib::op_record {
            let n = code[ip + 1]
            let cidx = cgen_read_u16(code, ip + 2)
            w("\tbur_record_make(" + str(n) + ", " + c_str(cgen_const_str(fh, cidx, f_consts)) + ");\n")
            ip + 4
        } else if op == lib::op_get_field_name {
            let cidx = cgen_read_u16(code, ip + 1)
            w("\tbur_record_get(" + c_str(cgen_const_str(fh, cidx, f_consts)) + ");\n")
            ip + 3
        } else if op == lib::op_record_update {
            let n = code[ip + 1]
            let cidx = cgen_read_u16(code, ip + 2)
            w("\tbur_record_update(" + str(n) + ", " + c_str(cgen_const_str(fh, cidx, f_consts)) + ");\n")
            ip + 4
        } else {
            ip + 1
        }
    }

    let mut bi = 0
    while bi < len(fun_ids) {
        let id = fun_ids[bi]
        let fh = fun_fhs[bi]
        let code = f_code[fh]
        let targets = cgen_jump_targets(fh, f_code, f_nupvals, f_consts)
        let li = cgen_ls_index(f_file[fh], ls_files)
        // line_dir 生成 #line 指令 / line_dir emits a #line directive
        fn line_dir(ip, with_ln) {
            if li >= 0 && ip < len(f_spans[fh]) {
                match f_spans[fh][ip] {
                    frontend::SpanT::Sp(s0, _) => {
                        let ln = cgen_line_of_off(ls_tables[li], s0)
                        if with_ln {
                            w("\tBUR_LN(" + str(ln) + ");\n")
                        }
                        w("#line " + str(ln) + " " + c_str(ls_names[li]) + "\n")
                    },
                }
            }
        }
        line_dir(0, false)
        let hd = cgen_fn_has_defer(fh, f_code, f_nupvals, f_consts)
        if true {
            push(mark_units, unit_of(f_file[fh]))
            push(mark_starts, len(out))
        }
        w("void bur_fn_" + str(id) + "(void) " + chr(123) + " // " + f_name[fh] + "\n")
        w("\tint base = bur_cur->top - " + str(f_arity[fh]) + " - 1; (void)base;\n")
        w("\tOClosure *self = bur_cur_closure; (void)self;\n")
        if hd {
            w("\tint dbase = bur_cur->ndefers;\n")
        }
        w("\tif (--bur_cur->budget <= 0) bur_preempt();\n")
        let mut ip = 0
        while ip < len(code) {
            if cgen_is_target(targets, ip) {
                w("L" + str(ip) + ":;\n")
            }
            line_dir(ip, true)
            ip = emit_inst(id, fh, code, ip, hd)
        }
        if cgen_is_target(targets, len(code)) {
            w("L" + str(len(code)) + ":;\n")
        }
        w("}\n\n")
        bi = bi + 1
    }

    let glob_start = len(out)
    w("static void bur_init_objs(void) " + chr(123) + "\n")
    oi = 0
    while oi < len(o_kind) {
        let names = if o_kind[oi] == 0 {
            ["OBJ_STRING", "OString"]
        } else if o_kind[oi] == 1 {
            ["OBJ_FUNC", "OFunc"]
        } else if o_kind[oi] == 2 {
            ["OBJ_ENUMTYPE", "OEnumType"]
        } else if o_kind[oi] == 3 {
            ["OBJ_VARIANTCTOR", "OVariantCtor"]
        } else {
            ["OBJ_ENUMINST", "OEnumInst"]
        }
        w("\tbur_K[" + str(oi) + "] = bur_alloc(sizeof(" + names[1] + "), " + names[0] + ");\n")
        oi = oi + 1
    }
    oi = 0
    while oi < len(o_kind) {
        w("\tbur_add_root(bur_K[" + str(oi) + "]);\n")
        oi = oi + 1
    }
    oi = 0
    while oi < len(o_kind) {
        if o_kind[oi] == 0 {
            let s = o_str[oi]
            let n = str(str_len(s))
            w("\t" + chr(123) + " OString *s = (OString *)bur_K[" + str(oi) + "]; s->len = " + n + "; s->data = (char *)malloc(" + str(str_len(s) + 1) + "); memcpy(s->data, " + c_str(s) + ", " + n + "); s->data[" + n + "] = 0; }\n")
        } else if o_kind[oi] == 2 {
            let eh = o_a[oi]
            let mut vs = []
            let mut i = 0
            while i < len(en_vnames[eh]) {
                push(vs, "" + chr(123) + "" + c_str(en_vnames[eh][i]) + ", " + str(en_varities[eh][i]) + "}")
                i = i + 1
            }
            w("\t" + chr(123) + " static VariantInfo vs[" + str(len(en_vnames[eh])) + "] = " + chr(123) + "" + join(vs, ", ") + "}; OEnumType *e = (OEnumType *)bur_K[" + str(oi) + "]; e->name = " + c_str(en_qual[eh]) + "; e->variants = vs; e->nvariants = " + str(len(en_vnames[eh])) + "; }\n")
        } else if o_kind[oi] == 3 {
            let ekey = "e:" + str(o_a[oi])
            let eid = match get(ids, ekey) {
                Some(x) => x,
                None => 0,
            }
            w("\t" + chr(123) + " OVariantCtor *c = (OVariantCtor *)bur_K[" + str(oi) + "]; c->enm = (OEnumType *)bur_K[" + str(eid) + "]; c->idx = " + str(o_b[oi]) + "; }\n")
        } else if o_kind[oi] == 4 {
            let ekey = "e:" + str(o_a[oi])
            let eid = match get(ids, ekey) {
                Some(x) => x,
                None => 0,
            }
            w("\t" + chr(123) + " OEnumInst *in = (OEnumInst *)bur_K[" + str(oi) + "]; in->enm = (OEnumType *)bur_K[" + str(eid) + "]; in->variant = " + str(o_b[oi]) + "; in->nfields = 0; }\n")
        } else {
            let fh = o_a[oi]
            let nconsts = len(f_consts[fh])
            let consts = if nconsts > 0 {
                "bur_consts_" + str(oi)
            } else {
                "NULL"
            }
            let fli = cgen_ls_index(f_file[fh], ls_files)
            let file = if fli >= 0 {
                c_str(ls_names[fli])
            } else if f_file[fh] != "" {
                c_str(f_file[fh])
            } else {
                "NULL"
            }
            let mut line = "\t" + chr(123) + " OFunc *fn = (OFunc *)bur_K[" + str(oi) + "]; fn->name = " + c_str(f_name[fh]) + "; fn->file = " + file + "; fn->arity = " + str(f_arity[fh]) + "; fn->numUpvals = " + str(f_nupvals[fh]) + "; fn->code = bur_fn_" + str(oi) + "; fn->consts = " + consts + "; fn->nconsts = " + str(nconsts) + ";"
            let mut i = 0
            while i < nconsts {
                line = line + " bur_consts_" + str(oi) + "[" + str(i) + "] = " + c_value(f_consts[fh][i], fconst_ids[fh][i]) + ";"
                i = i + 1
            }
            w(line + " }\n")
        }
        oi = oi + 1
    }
    w("\tbur_opt_enum = (OEnumType *)bur_K[" + str(opt_id) + "];\n")
    w("\tbur_res_enum = (OEnumType *)bur_K[" + str(res_id) + "];\n")
    w("\tbur_out_enum = (OEnumType *)bur_K[" + str(out_id) + "];\n")
    w("}\n\n")

    w("int main(int argc, char **argv) " + chr(123) + "\n")
    w("\tbur_boot(argc, argv);\n")
    w("\tbur_init_objs();\n")
    w("\tbur_register_natives();\n")
    w("\tbur_gc_ready = true;\n")
    w("\tOClosure *entry = bur_new_closure((OFunc *)bur_K[" + str(entry) + "]);\n")
    w("\tbur_main_fiber = bur_new_fiber(entry, NULL, 0, BUR_MAIN_STACK_SIZE);\n")
    w("\tbur_schedule(bur_main_fiber);\n")
    w("\tbur_scheduler();\n")
    w("\tfflush(stdout);\n")
    w("\treturn 0;\n")
    w("}\n")

    push(units_h, "#endif // BUR_UNITS_H\n")
    let mut files = []
    push(files, ["bur_units.h", join(units_h, "")])
    if len(mark_starts) == 0 {
        push(files, ["program.c", join(out, "")])
        return files
    }
    let mut unit_order = []
    let mut seen = map()
    let mut mk = 0
    while mk < len(mark_units) {
        let u = mark_units[mk]
        match get(seen, u) {
            Some(_) => {},
            None => {
                put(seen, u, true)
                push(unit_order, u)
            },
        }
        mk = mk + 1
    }
    for u in unit_order {
        let mut body = []
        push(body, join(head, ""))
        let mut mi = 0
        while mi < len(mark_starts) {
            if mark_units[mi] == u {
                let start = mark_starts[mi]
                let end = if mi + 1 < len(mark_starts) {
                    mark_starts[mi + 1]
                } else {
                    glob_start
                }
                push(body, seg_copy(out, start, end))
            }
            mi = mi + 1
        }
        push(files, [u + ".c", join(body, "")])
    }
    let mut prog = []
    push(prog, seg_copy(out, 0, mark_starts[0]))
    push(prog, seg_copy(out, glob_start, len(out)))
    push(files, ["program.c", join(prog, "")])
    files
}

fn cgen_read_u16(code, at) {
    code[at] * 256 + code[at + 1]
}

fn cgen_line_of_off(table, off) {
    let mut lo = 0
    let mut hi = len(table) - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if table[mid] <= off {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    lo + 1
}

fn cgen_inst_len(fh, code, ip, f_nupvals, f_consts) {
    let op = code[ip]
    if op == lib::op_const || op == lib::op_get_local || op == lib::op_set_local || op == lib::op_get_global || op == lib::op_def_global || op == lib::op_set_global || op == lib::op_get_upval || op == lib::op_set_upval || op == lib::op_jump || op == lib::op_jump_if_false || op == lib::op_jump_if_true || op == lib::op_jump_if_false_pop || op == lib::op_loop || op == lib::op_list || op == lib::op_chan_next || op == lib::op_get_field_name {
        3
    } else if op == lib::op_pop_n || op == lib::op_call || op == lib::op_spawn || op == lib::op_end_block || op == lib::op_test_variant || op == lib::op_get_field {
        2
    } else if op == lib::op_record || op == lib::op_record_update {
        4
    } else if op == lib::op_closure {
        let idx = cgen_read_u16(code, ip + 1)
        let sub = match f_consts[fh][idx] {
            lib::CVal::CFn(s) => s,
            _ => 0,
        }
        3 + f_nupvals[sub] * 3
    } else if op == lib::op_select {
        let n_arms = code[ip + 1]
        let has_default = code[ip + 2] != 0
        3 + n_arms * 3 + (if has_default {
            2
        } else {
            0
        })
    } else {
        1
    }
}

fn cgen_jump_targets(fh, f_code, f_nupvals, f_consts) {
    let code = f_code[fh]
    let mut targets = map()
    let mut ip = 0
    while ip < len(code) {
        let op = code[ip]
        if op == lib::op_jump || op == lib::op_jump_if_false || op == lib::op_jump_if_true || op == lib::op_jump_if_false_pop {
            put(targets, ip + 3 + cgen_read_u16(code, ip + 1), true)
            ip = ip + 3
        } else if op == lib::op_loop {
            put(targets, ip + 3 - cgen_read_u16(code, ip + 1), true)
            ip = ip + 3
        } else if op == lib::op_chan_next {
            put(targets, ip + 3 + cgen_read_u16(code, ip + 1), true)
            ip = ip + 3
        } else if op == lib::op_select {
            let mut p = ip + 1
            let n_arms = code[p]
            let has_default = code[p + 1] != 0
            p = p + 2
            let mut i = 0
            while i < n_arms {
                p = p + 1
                put(targets, p + 2 + cgen_read_u16(code, p), true)
                p = p + 2
                i = i + 1
            }
            if has_default {
                put(targets, p + 2 + cgen_read_u16(code, p), true)
                p = p + 2
            }
            ip = p
        } else {
            ip = ip + cgen_inst_len(fh, code, ip, f_nupvals, f_consts)
        }
    }
    targets
}

fn cgen_is_target(targets, ip) {
    match get(targets, ip) {
        Some(_) => true,
        None => false,
    }
}

fn cgen_fn_has_defer(fh, f_code, f_nupvals, f_consts) {
    let code = f_code[fh]
    let mut ip = 0
    while ip < len(code) {
        if code[ip] == lib::op_defer {
            return true
        }
        ip = ip + cgen_inst_len(fh, code, ip, f_nupvals, f_consts)
    }
    false
}

fn cgen_ls_index(file, ls_files) {
    let mut i = 0
    while i < len(ls_files) {
        if ls_files[i] == file {
            return i
        }
        i = i + 1
    }
    -1
}

fn cgen_reg_key(cv) {
    match cv {
        lib::CVal::CFn(fh) => "f:" + str(fh),
        lib::CVal::CEnumType(eh) => "e:" + str(eh),
        lib::CVal::CSingleton(eh, i) => "s:" + str(eh) + ":" + str(i),
        lib::CVal::CCtor(eh, i) => "c:" + str(eh) + ":" + str(i),
        _ => "",
    }
}

fn cgen_const_str(fh, idx, f_consts) {
    match f_consts[fh][idx] {
        lib::CVal::CStr(s) => s,
        _ => "",
    }
}

fn cgen_fn_const(fh, idx, f_consts) {
    match f_consts[fh][idx] {
        lib::CVal::CFn(sub) => sub,
        _ => 0,
    }
}

// c_str 转义 C 字符串字面量 / c_str escapes a C string literal
fn c_str(s) {
    let mut parts = ["\""]
    let mut seg = 0
    let mut i = 0
    while i < str_len(s) {
        let o = byte_at(s, i)
        let esc = if o == 34 {
            "\\\""
        } else if o == 92 {
            "\\\\"
        } else if o >= 32 && o < 127 {
            ""
        } else {
            "\\" + str(o / 64 % 8) + str(o / 8 % 8) + str(o % 8)
        }
        if esc != "" {
            push(parts, substr(s, seg, i - seg))
            push(parts, esc)
            seg = i + 1
        }
        i = i + 1
    }
    push(parts, substr(s, seg, str_len(s) - seg))
    push(parts, "\"")
    join(parts, "")
}

// c_float 生成 C 浮点字面量 / c_float renders a C float literal
fn c_float(f) {
    // 手工拆 IEEE 754 位模式（int64 域内），避免浮点格式化误差
    // Manually decompose the IEEE 754 bit pattern (int64-safe) to dodge float formatting errors
    let bits = float_bits(f)
    let neg = bits < 0
    let low63 = if neg {
        bits + 9223372036854775807 + 1
    } else {
        bits
    }
    let exp = low63 / 4503599627370496
    let mant = low63 % 4503599627370496
    // 特殊值：无穷与 NaN
    // Specials: infinities and NaN
    if exp == 2047 {
        if mant == 0 {
            if neg {
                "-INFINITY"
            } else {
                "INFINITY"
            }
        } else {
            "NAN"
        }
    } else {
        let sign = if neg {
            "-"
        } else {
            ""
        }
        // 常规值：16 进制科学计数（C 十六进制浮点字面量）
        // Regulars: hexadecimal scientific form (C hex float literals)
        if exp == 0 && mant == 0 {
            sign + "0x0p+00"
        } else {
            let mut nibbles = []
            let mut m = mant
            let mut i = 0
            while i < 13 {
                push(nibbles, m % 16)
                m = m / 16
                i = i + 1
            }
            let mut first = 0
            let mut found = false
            let mut j = 0
            while j < 13 {
                if nibbles[j] != 0 && !found {
                    first = j
                    found = true
                }
                j = j + 1
            }
            let mut digits = ""
            if found {
                let mut k = 12
                while k >= first {
                    digits = digits + hex_digit(nibbles[k])
                    k = k - 1
                }
            }
            let lead = if exp == 0 {
                "0x0"
            } else {
                "0x1"
            }
            let e10 = if exp == 0 {
                -1022
            } else {
                exp - 1023
            }
            let esign = if e10 < 0 {
                "-"
            } else {
                "+"
            }
            let eabs = if e10 < 0 {
                -e10
            } else {
                e10
            }
            let edig = if eabs < 10 {
                "0" + str(eabs)
            } else {
                str(eabs)
            }
            if digits == "" {
                sign + lead + "p" + esign + edig
            } else {
                sign + lead + "." + digits + "p" + esign + edig
            }
        }
    }
}

// hex_digit 把 0-15 转 16 进制字符 / hex_digit renders 0-15 as a hex character
fn hex_digit(n) {
    if n < 10 {
        chr(48 + n)
    } else {
        chr(65 + n - 10)
    }
}

// dec_add 逐位十进制字符串加法（常量折叠用，避免浮点误差）
// dec_add adds decimal strings digit by digit (const folding, avoids float error)
fn dec_add(a, b) {
    let mut out = []
    let mut i = str_len(a) - 1
    let mut j = str_len(b) - 1
    let mut carry = 0
    while i >= 0 || j >= 0 || carry > 0 {
        let da = if i >= 0 {
            ord(char_at(a, i)) - 48
        } else {
            0
        }
        let db = if j >= 0 {
            ord(char_at(b, j)) - 48
        } else {
            0
        }
        let s = da + db + carry
        push(out, chr(48 + s % 10))
        carry = s / 10
        i = i - 1
        j = j - 1
    }
    let mut rev = []
    let mut k = len(out) - 1
    while k >= 0 {
        push(rev, out[k])
        k = k - 1
    }
    join(rev, "")
}

// dec_uint64 把 u64 转十进制字符串 / dec_uint64 renders a u64 as decimal
fn dec_uint64(v) {
    if v >= 0 {
        str(v)
    } else {
        dec_add("9223372036854775808", str(v + 9223372036854775807 + 1))
    }
}

// seg_copy 复制 list 区间并拼接为字符串 / seg_copy joins a list slice into a string
fn seg_copy(src, from, to) {
    let mut r = []
    let mut i = from
    while i < to {
        push(r, src[i])
        i = i + 1
    }
    join(r, "")
}

// unit_of 由源文件路径派生存放单元名（空路径归 main）/ unit_of derives the
// storage unit name from the source path (empty paths go to the main unit)
fn unit_of(f) {
    if f == "" {
        "main"
    } else {
        let mut start = 0
        let mut i = 0
        while i < str_len(f) {
            if char_at(f, i) == "/" {
                start = i + 1
            }
            i = i + 1
        }
        let base = substr(f, start, str_len(f) - start)
        let bl = str_len(base)
        if bl >= 4 && substr(base, bl - 4, 4) == ".bur" {
            substr(base, 0, bl - 4)
        } else {
            base
        }
    }
}
