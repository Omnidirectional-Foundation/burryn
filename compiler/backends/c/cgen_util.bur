// cgen_util.bur — C 后端字符串/十进制/单元名辅助。
// cgen_util.bur — C-backend string/decimal/unit-name helpers.

// cgen_program_to_buf 是 C 后端入口：整程序字节码表 → 一个可编译的 C 源文件（cc 落成原生二进制）
// cgen_program_to_buf is the entry: whole-program bytecode tables to one
// compilable C file (cc turns it into a native binary)
// seg_copy 复制 list 区间并拼接为字符串 / seg_copy joins a list slice into a string
fn seg_copy(src, from, to) {
    let mut r = []
    let mut i = from
    while i < to {
        push(r, src[i])
        i = i + 1
    }
    join(r, "")
}

// unit_of 由源文件路径派生存放单元名（空路径归 main）/ unit_of derives the
// storage unit name from the source path (empty paths go to the main unit)
fn unit_of(f) {
    if f == "" {
        "main"
    } else {
        let mut start = 0
        let mut i = 0
        while i < str_len(f) {
            if char_at(f, i) == "/" {
                start = i + 1
            }
            i = i + 1
        }
        let base = substr(f, start, str_len(f) - start)
        let bl = str_len(base)
        if bl >= 4 && substr(base, bl - 4, 4) == ".bur" {
            substr(base, 0, bl - 4)
        } else {
            base
        }
    }
}
