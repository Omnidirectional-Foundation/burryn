// cgen_bc.bur — 字节码导航（u16 / 指令长度 / 行号）。
// cgen_bc.bur — bytecode navigation (u16 / inst length / line numbers).

import "burryn.dev/compiler/lib"

fn cgen_read_u16(code, at) {
    code[at] * 256 + code[at + 1]
}

fn cgen_line_of_off(table, off) {
    let mut lo = 0
    let mut hi = len(table) - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if table[mid] <= off {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    lo + 1
}

fn cgen_inst_len(fh, code, ip, f_nupvals, f_consts) {
    let op = code[ip]
    if op == lib::op_const || op == lib::op_get_local || op == lib::op_set_local || op == lib::op_get_global || op == lib::op_def_global || op == lib::op_set_global || op == lib::op_get_upval || op == lib::op_set_upval || op == lib::op_jump || op == lib::op_jump_if_false || op == lib::op_jump_if_true || op == lib::op_jump_if_false_pop || op == lib::op_loop || op == lib::op_list || op == lib::op_chan_next || op == lib::op_get_field_name {
        3
    } else if op == lib::op_pop_n || op == lib::op_call || op == lib::op_spawn || op == lib::op_end_block || op == lib::op_test_variant || op == lib::op_get_field {
        2
    } else if op == lib::op_record || op == lib::op_record_update {
        4
    } else if op == lib::op_closure {
        let idx = cgen_read_u16(code, ip + 1)
        let sub = match f_consts[fh][idx] {
            lib::CVal::CFn(s) => s,
            _ => 0,
        }
        3 + f_nupvals[sub] * 3
    } else if op == lib::op_select {
        let n_arms = code[ip + 1]
        let has_default = code[ip + 2] != 0
        3 + n_arms * 3 + (if has_default {
            2
        } else {
            0
        })
    } else {
        1
    }
}

fn cgen_jump_targets(fh, f_code, f_nupvals, f_consts) {
    let code = f_code[fh]
    let mut targets = map()
    let mut ip = 0
    while ip < len(code) {
        let op = code[ip]
        if op == lib::op_jump || op == lib::op_jump_if_false || op == lib::op_jump_if_true || op == lib::op_jump_if_false_pop {
            put(targets, ip + 3 + cgen_read_u16(code, ip + 1), true)
            ip = ip + 3
        } else if op == lib::op_loop {
            put(targets, ip + 3 - cgen_read_u16(code, ip + 1), true)
            ip = ip + 3
        } else if op == lib::op_chan_next {
            put(targets, ip + 3 + cgen_read_u16(code, ip + 1), true)
            ip = ip + 3
        } else if op == lib::op_select {
            let mut p = ip + 1
            let n_arms = code[p]
            let has_default = code[p + 1] != 0
            p = p + 2
            let mut i = 0
            while i < n_arms {
                p = p + 1
                put(targets, p + 2 + cgen_read_u16(code, p), true)
                p = p + 2
                i = i + 1
            }
            if has_default {
                put(targets, p + 2 + cgen_read_u16(code, p), true)
                p = p + 2
            }
            ip = p
        } else {
            ip = ip + cgen_inst_len(fh, code, ip, f_nupvals, f_consts)
        }
    }
    targets
}

fn cgen_is_target(targets, ip) {
    match get(targets, ip) {
        Some(_) => true,
        None => false,
    }
}

fn cgen_fn_has_defer(fh, f_code, f_nupvals, f_consts) {
    let code = f_code[fh]
    let mut ip = 0
    while ip < len(code) {
        if code[ip] == lib::op_defer {
            return true
        }
        ip = ip + cgen_inst_len(fh, code, ip, f_nupvals, f_consts)
    }
    false
}

fn cgen_ls_index(file, ls_files) {
    let mut i = 0
    while i < len(ls_files) {
        if ls_files[i] == file {
            return i
        }
        i = i + 1
    }
    -1
}
