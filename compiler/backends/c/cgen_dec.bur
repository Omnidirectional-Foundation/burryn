// cgen_dec.bur — 十进制加法/uint64。
// cgen_dec.bur — decimal add/uint64.



// dec_add 逐位十进制字符串加法（常量折叠用，避免浮点误差）
// dec_add adds decimal strings digit by digit (const folding, avoids float error)
fn dec_add(a, b) {
    let mut out = []
    let mut i = str_len(a) - 1
    let mut j = str_len(b) - 1
    let mut carry = 0
    while i >= 0 || j >= 0 || carry > 0 {
        let da = if i >= 0 {
            ord(char_at(a, i)) - 48
        } else {
            0
        }
        let db = if j >= 0 {
            ord(char_at(b, j)) - 48
        } else {
            0
        }
        let s = da + db + carry
        push(out, chr(48 + s % 10))
        carry = s / 10
        i = i - 1
        j = j - 1
    }
    let mut rev = []
    let mut k = len(out) - 1
    while k >= 0 {
        push(rev, out[k])
        k = k - 1
    }
    join(rev, "")
}

// dec_uint64 把 u64 转十进制字符串 / dec_uint64 renders a u64 as decimal
fn dec_uint64(v) {
    if v >= 0 {
        str(v)
    } else {
        dec_add("9223372036854775808", str(v + 9223372036854775807 + 1))
    }
}
