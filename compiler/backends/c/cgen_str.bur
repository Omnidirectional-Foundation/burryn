// cgen_str.bur — C 字符串/浮点字面量。
// cgen_str.bur — C string/float literals.

// c_str 转义 C 字符串字面量 / c_str escapes a C string literal
fn c_str(s) {
    let mut parts = ["\""]
    let mut seg = 0
    let mut i = 0
    while i < str_len(s) {
        let o = byte_at(s, i)
        let esc = if o == 34 {
            "\\\""
        } else if o == 92 {
            "\\\\"
        } else if o >= 32 && o < 127 {
            ""
        } else {
            "\\" + str(o / 64 % 8) + str(o / 8 % 8) + str(o % 8)
        }
        if esc != "" {
            push(parts, substr(s, seg, i - seg))
            push(parts, esc)
            seg = i + 1
        }
        i = i + 1
    }
    push(parts, substr(s, seg, str_len(s) - seg))
    push(parts, "\"")
    join(parts, "")
}

// c_float 生成 C 浮点字面量 / c_float renders a C float literal
fn c_float(f) {
    // 手工拆 IEEE 754 位模式（int64 域内），避免浮点格式化误差
    // Manually decompose the IEEE 754 bit pattern (int64-safe) to dodge float formatting errors
    let bits = float_bits(f)
    let neg = bits < 0
    let low63 = if neg {
        bits + 9223372036854775807 + 1
    } else {
        bits
    }
    let exp = low63 / 4503599627370496
    let mant = low63 % 4503599627370496
    // 特殊值：无穷与 NaN
    // Specials: infinities and NaN
    if exp == 2047 {
        if mant == 0 {
            if neg {
                "-INFINITY"
            } else {
                "INFINITY"
            }
        } else {
            "NAN"
        }
    } else {
        let sign = if neg {
            "-"
        } else {
            ""
        }
        // 常规值：16 进制科学计数（C 十六进制浮点字面量）
        // Regulars: hexadecimal scientific form (C hex float literals)
        if exp == 0 && mant == 0 {
            sign + "0x0p+00"
        } else {
            let mut nibbles = []
            let mut m = mant
            let mut i = 0
            while i < 13 {
                push(nibbles, m % 16)
                m = m / 16
                i = i + 1
            }
            let mut hi = 12
            let mut first = 0
            let mut found = false
            let mut j = 0
            while j < 13 {
                if nibbles[j] != 0 && !found {
                    first = j
                    found = true
                }
                j = j + 1
            }
            let mut digits = ""
            if found {
                let mut k = 12
                while k >= first {
                    digits = digits + hex_digit(nibbles[k])
                    k = k - 1
                }
            }
            let _ = hi
            let lead = if exp == 0 {
                "0x0"
            } else {
                "0x1"
            }
            let e10 = if exp == 0 {
                -1022
            } else {
                exp - 1023
            }
            let esign = if e10 < 0 {
                "-"
            } else {
                "+"
            }
            let eabs = if e10 < 0 {
                -e10
            } else {
                e10
            }
            let edig = if eabs < 10 {
                "0" + str(eabs)
            } else {
                str(eabs)
            }
            if digits == "" {
                sign + lead + "p" + esign + edig
            } else {
                sign + lead + "." + digits + "p" + esign + edig
            }
        }
    }
}
