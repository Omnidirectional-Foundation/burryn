    let je2 = mov_rr(r10, rax) + sub_ri32(r10, 32) + test_rr(r10, r10) + je_rel32(str_len(jb2) + str_len(no2))
    let tail2 = mov_rr(rsi, r9) + add_rr(rsi, rcx) + add_ri32(rsi, 7) + mov_rm(rax, rsi, 0) + mov_ri64(r10, 255) + and_rr(rax, r10) + je2 + jb2 + no2 + yes2
    let cond2 = cmp_rr(rcx, rdx) + jle_rel32(str_len(tail2) + 5)
    let back2 = jmp_rel32(0 - (str_len(cond2) + str_len(tail2) + 5))
    let loop2 = cond2 + tail2 + back2
    let yes1 = add_ri32(rdx, 1)
    let no1 = jmp_rel32(str_len(yes1) + 5)
    let jb1 = sub_ri32(rax, 9) + sub_ri32(rax, 5) + jb_rel32(str_len(no1))
    let je1 = mov_rr(r10, rax) + sub_ri32(r10, 32) + test_rr(r10, r10) + je_rel32(str_len(jb1) + str_len(no1))
    let tail1 = read + je1 + jb1 + no1 + yes1
    let cond1 = cmp_rr(rdx, rcx) + jge_rel32(str_len(tail1) + 5)
    let back1 = jmp_rel32(0 - (str_len(cond1) + str_len(tail1) + 5))
