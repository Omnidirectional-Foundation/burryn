// x86.bur — 手写 x86-64 机器码后端：逐条 opcode 内联发射（无 runtime 依赖，静态 ELF）。
// Hand-written x86-64 backend: each opcode is inlined into raw machine code (no runtime, static ELF).
// 值 = 8B 原始 int64（无 tag，与 C runtime 的 16B tagged Value 不混用）。
// Values are 8-byte raw int64s (untagged; never mixed with the C runtime's 16-byte tagged Value).
// 寄存器约定：r15 = 值栈顶、r14 = 帧基、r13 = 跳转表、r12 = 堆指针、rbx = 全局基（ABI 级，勿改）。
// Register conventions: r15 value stack top, r14 frame base, r13 jump table, r12 heap ptr, rbx globals base (ABI-level, do not change).
import "burryn.dev/compiler/lib"

// 寄存器编号 / Register ids
pub let rax = 0
pub let rcx = 1
pub let rdx = 2
pub let rbx = 3
pub let rsp = 4
pub let rbp = 5
pub let rsi = 6
pub let rdi = 7
pub let r8 = 8
pub let r9 = 9
pub let r10 = 10
pub let r11 = 11
pub let r12 = 12
pub let r13 = 13
pub let r14 = 14
pub let r15 = 15

// arg_regs 列出 x86-64 SysV 参数寄存器（前 6 个）/
// arg_regs lists the SysV argument registers (first six)
pub fn arg_regs() {
    [rdi, rsi, rdx, rcx, r8, r9]
}

// e1 发射 1 字节 / e1 emits one byte
// Emit one byte
pub fn e1(b) {
    byte_chr(b)
}

// e2 发射 2 字节小端 / e2 emits two little-endian bytes
// Emit two bytes, little-endian
pub fn e2(w) {
    byte_chr(w % 256) + byte_chr(w / 256 % 256)
}

// e4 发射 4 字节小端 / e4 emits four little-endian bytes
// Emit four bytes, little-endian
pub fn e4(v) {
    byte_chr(v % 256) + byte_chr(v / 256 % 256) + byte_chr(v / 65536 % 256) + byte_chr(v / 16777216 % 256)
}

// e8 发射 8 字节小端 / e8 emits eight little-endian bytes
// Emit eight bytes, little-endian
pub fn e8(v) {
    e4(v % 4294967296) + e4(v / 4294967296)
}

// sb 把有符号 int8 折叠进 0..255（补码）/ sb folds a signed int8 into 0..255 (two's complement)
pub fn sb(v) {
    let m = v % 256
    if m < 0 {
        byte_chr(m + 256)
    } else {
        byte_chr(m)
    }
}

// e4s 发射有符号 4 字节 / e4s emits a signed 4-byte value
// Signed four bytes
pub fn e4s(v) {
    if v < 0 {
        e4(v + 4294967296)
    } else {
        e4(v)
    }
}

// e8s 发射有符号 8 字节 / e8s emits a signed 8-byte value
// Signed eight bytes
pub fn e8s(v) {
    if v >= 0 {
        e8(v)
    } else {
        let u = 0 - v
        let lo = u % 4294967296
        let hi = u / 4294967296 % 4294967296
        let nlo = 4294967295 - lo
        let nhi = 4294967295 - hi
        let mut flo = nlo + 1
        let mut fhi = nhi
        if flo >= 4294967296 {
            flo = flo - 4294967296
            fhi = fhi + 1
        }
        e4(flo) + e4(fhi)
    }
}

// rex_needed 判断是否需要 REX 前缀 / rex_needed tells whether a REX prefix is needed
fn rex_needed(w, r, x, b) {
    w != 0 || r >= 8 || x >= 8 || b >= 8
}

// rex 发射 REX 前缀（W/R/X/B 位）/ rex emits a REX prefix (W/R/X/B bits)
pub fn rex(w, r, x, b) {
    if !rex_needed(w, r, x, b) {
        ""
    } else {
        let mut v = 64
        if w != 0 {
            v = v + 8
        }
        if r >= 8 {
            v = v + 4
        }
        if x >= 8 {
            v = v + 2
        }
        if b >= 8 {
            v = v + 1
        }
        e1(v)
    }
}

// modrm 发射 ModRM 字节 / modrm emits a ModRM byte
pub fn modrm(mod, reg, rm) {
    e1(mod % 4 * 64 + reg % 8 * 8 + rm % 8)
}

// modrm_reg 发射寄存器寻址的 ModRM / modrm_reg emits ModRM (register addressing)
fn modrm_reg(reg, rm) {
    modrm(3, reg, rm)
}

// mov_rr 发射 mov dst, src / mov_rr emits mov dst, src
// mov_rr 发射 mov dst, src / mov_rr emits mov dst, src
pub fn mov_rr(dst, src) {
    rex(1, src, 0, dst) + e1(137) + modrm_reg(src, dst)
}

// mov_ri64 发射 movabs（64 位立即数）/
// mov_ri64 emits movabs (64-bit immediate)
// movabs 64-bit immediate
pub fn mov_ri64(dst, imm) {
    rex(1, 0, 0, dst) + e1(184 + dst % 8) + e8(imm)
}

// mov_ri32 发射 mov（32 位立即数，高位清零）/
// mov_ri32 emits mov (32-bit immediate, upper bits cleared)
// mov 32-bit immediate (zero-extends)
pub fn mov_ri32(dst, imm) {
    if dst >= 8 {
        rex(0, 0, 0, dst) + e1(184 + dst % 8) + e4(imm)
    } else {
        e1(184 + dst) + e4(imm)
    }
}

// sib_for 生成 SIB 字节 / sib_for builds a SIB byte
fn sib_for(base) {
    if base % 8 == 4 {
        byte_chr(36)
    } else {
        ""
    }
}

// mov_rm 发射内存到寄存器 / mov_rm emits memory-to-register
pub fn mov_rm(dst, base, disp) {
    if disp == 0 && base % 8 != 5 {
        rex(1, dst, 0, base) + e1(139) + modrm(0, dst, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        rex(1, dst, 0, base) + e1(139) + modrm(1, dst, base) + sib_for(base) + sb(disp)
    } else {
        rex(1, dst, 0, base) + e1(139) + modrm(2, dst, base) + sib_for(base) + e4s(disp)
    }
}

// mov_mr 发射寄存器到内存 / mov_mr emits register-to-memory
pub fn mov_mr(base, disp, src) {
    if disp == 0 && base % 8 != 5 {
        rex(1, src, 0, base) + e1(137) + modrm(0, src, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        rex(1, src, 0, base) + e1(137) + modrm(1, src, base) + sib_for(base) + sb(disp)
    } else {
        rex(1, src, 0, base) + e1(137) + modrm(2, src, base) + sib_for(base) + e4s(disp)
    }
}

// push_r 发射 push 指令 / push_r emits a push instruction
// push_r 发射 push 指令 / push_r emits a push instruction
pub fn push_r(reg) {
    rex(0, 0, 0, reg) + e1(80 + reg % 8)
}

// pop_r 发射 pop 指令 / pop_r emits a pop instruction
// pop_r 发射 pop 指令 / pop_r emits a pop instruction
pub fn pop_r(reg) {
    rex(0, 0, 0, reg) + e1(88 + reg % 8)
}

// add_rr 发射 add 指令 / add_rr emits an add instruction
// add_rr 发射 add 指令 / add_rr emits an add instruction
pub fn add_rr(dst, src) {
    rex(1, src, 0, dst) + e1(1) + modrm_reg(src, dst)
}

// sub_rr 发射 sub 指令 / sub_rr emits a sub instruction
// sub_rr 发射 sub 指令 / sub_rr emits a sub instruction
pub fn sub_rr(dst, src) {
    rex(1, src, 0, dst) + e1(41) + modrm_reg(src, dst)
}

// and_rr 发射 and 指令 / and_rr emits an and instruction
// and_rr 发射 and 指令 / and_rr emits an and instruction
pub fn and_rr(dst, src) {
    rex(1, src, 0, dst) + e1(33) + modrm_reg(src, dst)
}

// or_rr 发射 or 指令 / or_rr emits an or instruction
// or_rr 发射 or 指令 / or_rr emits an or instruction
pub fn or_rr(dst, src) {
    rex(1, src, 0, dst) + e1(9) + modrm_reg(src, dst)
}

// xor_rr 发射 xor 指令 / xor_rr emits an xor instruction
// xor_rr 发射 xor 指令 / xor_rr emits an xor instruction
pub fn xor_rr(dst, src) {
    rex(1, src, 0, dst) + e1(49) + modrm_reg(src, dst)
}

// cmp_rr 发射 cmp 指令 / cmp_rr emits a cmp instruction
// cmp_rr 发射 cmp 指令 / cmp_rr emits a cmp instruction
pub fn cmp_rr(a, b) {
    rex(1, b, 0, a) + e1(57) + modrm_reg(b, a)
}

// test_rr 发射 test 指令 / test_rr emits a test instruction
// test_rr 发射 test 指令 / test_rr emits a test instruction
pub fn test_rr(a, b) {
    rex(1, b, 0, a) + e1(133) + modrm_reg(b, a)
}

// neg_r 发射 neg 指令 / neg_r emits a neg instruction
// neg_r 发射 neg 指令 / neg_r emits a neg instruction
pub fn neg_r(reg) {
    rex(1, 0, 0, reg) + e1(247) + modrm_reg(3, reg)
}

// imul_rr 发射 imul 指令 / imul_rr emits an imul instruction
// imul_rr 发射 imul 指令 / imul_rr emits an imul instruction
pub fn imul_rr(dst, src) {
    rex(1, dst, 0, src) + e1(15) + e1(175) + modrm_reg(dst, src)
}

// add_ri32 发射 add 立即数（小值用短编码）/
// add_ri32 emits add immediate (short encoding for small values)
// add immediate (short form for small values)
pub fn add_ri32(dst, imm) {
    if imm >= -128 && imm <= 127 {
        rex(1, 0, 0, dst) + e1(131) + modrm_reg(0, dst) + sb(imm)
    } else {
        rex(1, 0, 0, dst) + e1(129) + modrm_reg(0, dst) + e4s(imm)
    }
}

// sub_ri32 发射 sub 立即数 / sub_ri32 emits sub immediate
// sub immediate
pub fn sub_ri32(dst, imm) {
    if imm >= -128 && imm <= 127 {
        rex(1, 0, 0, dst) + e1(131) + modrm_reg(5, dst) + sb(imm)
    } else {
        rex(1, 0, 0, dst) + e1(129) + modrm_reg(5, dst) + e4s(imm)
    }
}

// shl_rcl 发射按 CL 左移 / shl_rcl emits a shift-left-by-CL
pub fn shl_rcl(dst) {
    rex(1, 0, 0, dst) + e1(211) + modrm_reg(4, dst)
}

// shr_rcl 发射按 CL 逻辑右移 / shr_rcl emits a logical shift-right by CL
pub fn shr_rcl(dst) {
    rex(1, 0, 0, dst) + e1(211) + modrm_reg(5, dst)
}

// sar_rcl 发射按 CL 算术右移 / sar_rcl emits an arithmetic shift-right by CL
pub fn sar_rcl(dst) {
    rex(1, 0, 0, dst) + e1(211) + modrm_reg(7, dst)
}

// lea 发射 lea 地址计算 / lea emits lea (address computation)
pub fn lea(dst, base, disp) {
    if disp == 0 && base % 8 != 5 {
        rex(1, dst, 0, base) + e1(141) + modrm(0, dst, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        rex(1, dst, 0, base) + e1(141) + modrm(1, dst, base) + sib_for(base) + sb(disp)
    } else {
        rex(1, dst, 0, base) + e1(141) + modrm(2, dst, base) + sib_for(base) + e4s(disp)
    }
}

// ret 发射 ret 指令 / ret emits a ret instruction
// ret 发射 ret 指令 / ret emits a ret instruction
pub fn ret() {
    e1(195)
}

// call_r 发射间接调用 / call_r emits an indirect call
pub fn call_r(reg) {
    rex(0, 0, 0, reg) + e1(255) + modrm_reg(2, reg)
}

// jmp_r 发射间接跳转 / jmp_r emits an indirect jump
pub fn jmp_r(reg) {
    rex(0, 0, 0, reg) + e1(255) + modrm_reg(4, reg)
}

// jmp_rel32 发射相对跳转 / jmp_rel32 emits a relative jump
// Relative jump
pub fn jmp_rel32(off) {
    e1(233) + e4s(off)
}

// je_rel32 发射 je rel32 / je_rel32 emits je rel32
// je_rel32 发射 je rel32 / je_rel32 emits je rel32
pub fn je_rel32(off) {
    e1(15) + e1(132) + e4s(off)
}

// jne_rel32 发射 jne rel32 / jne_rel32 emits jne rel32
// jne_rel32 发射 jne rel32 / jne_rel32 emits jne rel32
pub fn jne_rel32(off) {
    e1(15) + e1(133) + e4s(off)
}

// jl_rel32 发射 jl rel32（有符号小于）/
// jl_rel32 emits jl rel32 (signed less-than)
// jl rel32 (signed less)
pub fn jl_rel32(off) {
    e1(15) + e1(140) + e4s(off)
}

// jg_rel32 发射 jg rel32（有符号大于）/
// jg_rel32 emits jg rel32 (signed greater-than)
// jg rel32 (signed greater)
pub fn jg_rel32(off) {
    e1(15) + e1(143) + e4s(off)
}

// jle_rel32 发射 jle rel32 / jle_rel32 emits jle rel32
// jle_rel32 发射 jle rel32 / jle_rel32 emits jle rel32
pub fn jle_rel32(off) {
    e1(15) + e1(142) + e4s(off)
}

// jge_rel32 发射 jge rel32（有符号大于等于）/
// jge_rel32 emits jge rel32 (signed greater-or-equal)
// jge rel32 (signed greater-or-equal)
pub fn jge_rel32(off) {
    e1(15) + e1(141) + e4s(off)
}

// ja_rel32 发射 ja rel32（无符号大于）/
// ja_rel32 emits ja rel32 (unsigned greater-than)
// ja rel32 (unsigned above)
pub fn ja_rel32(off) {
    e1(15) + e1(135) + e4s(off)
}

// jb_rel32 发射 jb rel32（无符号小于）/
// jb_rel32 emits jb rel32 (unsigned less-than)
// jb rel32 (unsigned below)
pub fn jb_rel32(off) {
    e1(15) + e1(130) + e4s(off)
}

// jae_rel32 发射 jae rel32（无符号大于等于）/
// jae_rel32 emits jae rel32 (unsigned greater-or-equal)
// jae rel32 (unsigned above-or-equal)
pub fn jae_rel32(off) {
    e1(15) + e1(131) + e4s(off)
}

// jbe_rel32 发射 jbe rel32（无符号小于等于）/
// jbe_rel32 emits jbe rel32 (unsigned less-or-equal)
// jbe rel32 (unsigned below-or-equal)
pub fn jbe_rel32(off) {
    e1(15) + e1(134) + e4s(off)
}

// call_rel32 发射相对调用 / call_rel32 emits a relative call
// Relative call
pub fn call_rel32(off) {
    e1(232) + e4s(off)
}

// prologue 发射栈帧开场 / prologue emits the stack-frame prologue
pub fn prologue(frame_size) {
    let code = push_r(rbp) + mov_rr(rbp, rsp)
    if frame_size > 0 {
        code + sub_ri32(rsp, frame_size)
    } else {
        code
    }
}

// epilogue 发射栈帧收场 / epilogue emits the stack-frame epilogue
pub fn epilogue() {
    mov_rr(rsp, rbp) + pop_r(rbp) + ret()
}

// nop 发射 nop 指令 / nop emits a nop
// nop 发射 nop 指令 / nop emits a nop
pub fn nop() {
    e1(144)
}

// int3 发射 int3：未实现 native 的 trap（parity 按 SIGTRAP skip）/
// int3 emits int3: the unimplemented-native trap (parity treats it as a SIGTRAP skip)
// int3: trap for unimplemented natives (parity skips on SIGTRAP)
pub fn int3() {
    e1(204)
}

// rep_movsb 发射 rep movsb（批量拷贝）/ rep_movsb emits rep movsb: bulk copy
pub fn rep_movsb() {
    e1(243) + e1(164)
}

// repe_cmpsb 发射 repe cmpsb（批量相等比较）/ repe_cmpsb emits repe cmpsb: bulk equality compare
pub fn repe_cmpsb() {
    e1(243) + e1(166)
}

// sete 发射 sete（按 ZF 置 0/1）/ sete emits sete (set 0/1 from flags)
pub fn sete(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(148) + modrm_reg(0, dst)
}

// setne 发射 setne 指令 / setne emits a setne instruction
// setne 发射 setne 指令 / setne emits a setne instruction
pub fn setne(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(149) + modrm_reg(0, dst)
}

// setl 发射 setl 指令 / setl emits a setl instruction
// setl 发射 setl 指令 / setl emits a setl instruction
pub fn setl(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(156) + modrm_reg(0, dst)
}

// setg 发射 setg 指令 / setg emits a setg instruction
// setg 发射 setg 指令 / setg emits a setg instruction
pub fn setg(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(159) + modrm_reg(0, dst)
}

// idiv_r 发射有符号除法（商 rax、余 rdx）/ idiv_r emits signed divide (quotient rax, remainder rdx)
pub fn idiv_r(reg) {
    rex(1, 0, 0, reg) + e1(247) + modrm_reg(7, reg)
}

// div_r 发射无符号除法 / div_r emits unsigned divide
pub fn div_r(reg) {
    rex(1, 0, 0, reg) + e1(247) + modrm_reg(6, reg)
}

// cqo 发射 cqo（rax 符号扩展进 rdx，idiv 前缀）/ cqo emits cqo: sign-extend rax into rdx (idiv prefix)
pub fn cqo() {
    e1(72) + e1(153)
}

// setge 发射 setge 指令 / setge emits a setge instruction
// setge 发射 setge 指令 / setge emits a setge instruction
pub fn setge(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(157) + modrm_reg(0, dst)
}

// setle 发射 setle 指令 / setle emits a setle instruction
// setle 发射 setle 指令 / setle emits a setle instruction
pub fn setle(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(158) + modrm_reg(0, dst)
}

// movzx_eax_al 发射 movzx（al 零扩展到 eax）/ movzx_eax_al emits movzx: zero-extend al to eax
pub fn movzx_eax_al() {
    e1(15) + e1(182) + modrm_reg(0, 0)
}

// lea_rip_rel32 发射 lea rip 相对寻址 / lea_rip_rel32 emits lea rip-relative addressing
// lea rip-relative addressing
pub fn lea_rip_rel32(dst, rel32) {
    rex(1, dst, 0, 0) + e1(141) + modrm(0, dst, 5) + e4s(rel32)
}

// vs_push 把值压入值栈（r15 为栈顶）/ vs_push pushes a value onto the value stack (r15 is the top)
pub fn vs_push(reg) {
    mov_mr(r15, 0, reg) + add_ri32(r15, 8)
}

// vs_push_zero 把 0 压入值栈 / vs_push_zero pushes zero onto the value stack
pub fn vs_push_zero() {
    e1(73) + e1(199) + modrm(0, 0, r15) + e4(0) + add_ri32(r15, 8)
}

// vs_pop_n 从值栈弹出 n 个槽 / vs_pop_n pops n slots from the value stack
pub fn vs_pop_n(n) {
    sub_ri32(r15, 8 * n)
}

// x86gen_prologue 生成函数序言：保存 caller 基、按 arity 建帧基
// x86gen_prologue emits the prologue: save the caller base, build the frame base by arity
// Function prologue: save caller base, set frame base by arity
fn x86gen_prologue(arity, _locals) {
    push_r(rbp) + mov_rr(rbp, r14) + lea(r14, r15, 0 - 8 * (arity + 1))
}

// x86gen_epilogue 生成函数尾声：返回值落栈并恢复帧
// x86gen_epilogue emits the epilogue: push the return value and restore the frame
// Function epilogue: place the return value and restore the frame
fn x86gen_epilogue() {
    mov_rm(rax, r15, 0 - 8) + mov_rr(r15, r14) + mov_mr(r15, 0, rax) + add_ri32(r15, 8) + mov_rr(r14, rbp) + pop_r(rbp) + ret()
}

// x86gen_str_native 内联 str(int)：带符号十进制，逐位除 10 + 负号
// x86gen_str_native inlines str(int): signed decimal, digit-wise /10 plus the sign
// str(int) inline: signed decimal, digit-by-digit div-10 with a minus sign
fn x86gen_str_native() {
    let loop_body = xor_rr(rdx, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 10) + div_r(rcx) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(r10, 1) + test_rr(rax, rax)
    let loop_jne = jne_rel32(0 - (str_len(loop_body) + 6))
    let neg_write = mov_ri64(rdx, 45) + mov_mr(rdi, 0, rdx) + add_ri32(rdi, 1)
    let alloc = mov_rr(rdx, r10) + add_rr(rdx, r8) + mov_rr(r11, r12) + mov_mr(r11, 0, rdx) + lea(rcx, rdx, 8) + add_rr(r12, rcx) + lea(rdi, r11, 8) + test_rr(r8, r8) + je_rel32(str_len(neg_write)) + neg_write
    let pop_body = pop_r(rax) + e1(136) + e1(7) + add_ri32(rdi, 1) + sub_ri32(r10, 1)
    let pop_jne = jne_rel32(0 - (str_len(pop_body) + 6))
    let neg_path = mov_ri64(r8, 1) + neg_r(rax)
    let head = mov_rm(rax, r15, 0 - 8) + xor_rr(r8, r8) + test_rr(rax, rax) + jge_rel32(str_len(neg_path))
    let loop_start = xor_rr(r10, r10)
    head + neg_path + loop_start + loop_body + loop_jne + alloc + pop_body + pop_jne + mov_mr(r15, 0 - 16, r11) + vs_pop_n(1)
}

// x86gen_push_native 内联 push：容量不足时翻倍增长并复制
// x86gen_push_native inlines push: double-and-copy when the capacity is short
// push inline: double capacity and copy when full
fn x86gen_push_native() {
    let growth = mov_rr(r10, rcx) + add_rr(r10, r10) + test_rr(r10, r10) + jne_rel32(4) + add_ri32(r10, 4) + mov_rr(r11, r12) + mov_rm(rsi, rax, 16) + mov_mr(rax, 8, r10) + mov_mr(rax, 16, r11) + mov_rr(rdi, r11) + mov_rr(rdx, rcx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rr(rdx, r10) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r12, rdx)
    let store = mov_rm(rcx, rax, 0) + mov_rm(r11, rax, 16) + mov_rr(rdx, rcx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r11, rdx) + mov_mr(r11, 0, r9) + mov_rm(rcx, rax, 0) + add_ri32(rcx, 1) + mov_mr(rax, 0, rcx) + xor_rr(r11, r11) + mov_mr(r15, 0 - 24, r11) + vs_pop_n(2)
