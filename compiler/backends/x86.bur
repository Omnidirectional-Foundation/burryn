                None => 0 - 1,
            }
            if dmv >= 0 && code[ip] != lib.op_no_match {
                while len(shadow) > dmv {
                    shadow_pop(shadow, 1)
                }
                while len(type_shadow) > dmv {
                    shadow_pop(type_shadow, 1)
                }
            }
            emit_inst(ip)
            ip = ip + inst_len(fh, code, ip)
        }
        // Patch every recorded jump with the real rel32.
        let mut fbytes = join(out, "")
        let mut pi = 0
        while pi < len(patches) {
            let p = patches[pi]
            let rel32_pos = p[0]
            let target_ip = p[1]
            let target_byte = match get(ip_to_byte, target_ip) {
                Some(v) => v,
                None => 0,
            }
            let rel32 = target_byte - (rel32_pos + 4)
            fbytes = substr(fbytes, 0, rel32_pos) + e4s(rel32) + substr(fbytes, rel32_pos + 4, str_len(fbytes) - rel32_pos - 4)
            pi = pi + 1
        }
        funcs_bytes = funcs_bytes + fbytes
        fh = fh + 1
    }

    // Jump table: 8-byte absolute address per function.
    let mut jt_bytes = ""
    let mut jh = 0
    while jh < nfn {
        jt_bytes = jt_bytes + e8(base_addr + 120 + const_data_len + func_offsets[jh])
        jh = jh + 1
    }
    // _start is the entry, placed last.
    let start_off = const_data_len + str_len(funcs_bytes) + str_len(jt_bytes)
    let start_bytes = x86gen_start(nfn, n_globals)
    emit_elf(const_data + funcs_bytes + jt_bytes + start_bytes, start_off)
}
