// x86gen_join_native 内联 join：字符串列表用分隔符连接
// x86gen_join_native inlines join: connect a string list with a separator
// join inline: join string lists with a separator
fn x86gen_join_native() {
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_rm(r8, r9, 0) + mov_rm(r11, r10, 0) + xor_rr(rdx, rdx) + xor_rr(rax, rax)
