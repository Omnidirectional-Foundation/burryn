    let loop_copy_body = pass2_je + pass2_no + pass2_elem + add_ri32(rax, 1)
    let back_copy = jmp_rel32(0 - (str_len(pass2_head) + str_len(loop_copy_body) + 5))
    let loop_copy = pass2_head + loop_copy_body + back_copy
    let done_len_tail = mov_mr(r15, 0 - 24, r12) + mov_rr(rdi, r12) + mov_mr(rdi, 0, rdx) + add_rr(r12, rdx) + add_ri32(r12, 8) + mov_rm(rdi, r15, 0 - 24) + add_ri32(rdi, 8) + xor_rr(rax, rax)
    let pass1_elem = mov_rr(rsi, rax) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + mov_rm(rcx, r9, 16) + add_rr(rcx, rsi) + mov_rm(rcx, rcx, 0) + mov_rm(rsi, rcx, 0) + add_rr(rdx, rsi)
    let pass1_no = add_rr(rdx, r11)
    let pass1_je = test_rr(rax, rax) + je_rel32(str_len(pass1_no))
    let pass1_head = cmp_rr(rax, r8) + jge_rel32(str_len(pass1_je) + str_len(pass1_no) + str_len(pass1_elem) + 9)
    let loop_len_body = pass1_je + pass1_no + pass1_elem + add_ri32(rax, 1)
    let back_len = jmp_rel32(0 - (str_len(pass1_head) + str_len(loop_len_body) + 5))
