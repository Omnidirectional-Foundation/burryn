// x86-64 instruction encoder (System V AMD64 ABI).
import "burryn.dev/compiler/lib"
// Emits machine code as byte strings via byte_chr; concatenation builds code blocks.

// ---- registers ----
pub let rax = 0
pub let rcx = 1
pub let rdx = 2
pub let rbx = 3
pub let rsp = 4
pub let rbp = 5
pub let rsi = 6
pub let rdi = 7
pub let r8 = 8
pub let r9 = 9
pub let r10 = 10
pub let r11 = 11
pub let r12 = 12
pub let r13 = 13
pub let r14 = 14
pub let r15 = 15

// System V AMD64 argument registers in order
pub fn arg_regs() {
    [rdi, rsi, rdx, rcx, r8, r9]
}

// ---- byte emission ----
pub fn e1(b) {
    byte_chr(b)
}

pub fn e2(w) {
    byte_chr(w % 256) + byte_chr(w / 256 % 256)
}

pub fn e4(v) {
    byte_chr(v % 256) + byte_chr(v / 256 % 256) + byte_chr(v / 65536 % 256) + byte_chr(v / 16777216 % 256)
}

pub fn e8(v) {
    e4(v % 4294967296) + e4(v / 4294967296)
}

// sb: signed int8 -> one byte (two's complement). byte_chr() traps on
// negatives, so fold into 0..255 before emitting.
pub fn sb(v) {
    let m = v % 256
    if m < 0 {
        byte_chr(m + 256)
    } else {
        byte_chr(m)
    }
}

// e4s: signed int32 -> 4 bytes (two's complement, little-endian).
pub fn e4s(v) {
    if v < 0 {
        e4(v + 4294967296)
    } else {
        e4(v)
    }
}

// e8s: signed int64 -> 8 bytes (two's complement, little-endian). Avoids
// 2^64 overflow by negating first then forming (~u + 1) per 32-bit half.
pub fn e8s(v) {
    if v >= 0 {
        e8(v)
    } else {
        let u = 0 - v
        let lo = u % 4294967296
        let hi = u / 4294967296 % 4294967296
        let nlo = 4294967295 - lo
        let nhi = 4294967295 - hi
        let mut flo = nlo + 1
        let mut fhi = nhi
        if flo >= 4294967296 {
            flo = flo - 4294967296
            fhi = fhi + 1
        }
        e4(flo) + e4(fhi)
    }
}

// ---- REX prefix ----
fn rex_needed(w, r, x, b) {
    w != 0 || r >= 8 || x >= 8 || b >= 8
}

pub fn rex(w, r, x, b) {
    if !rex_needed(w, r, x, b) {
        ""
    } else {
        let mut v = 64 // 0x40
        if w != 0 {
            v = v + 8
        }
        if r >= 8 {
            v = v + 4
        }
        if x >= 8 {
            v = v + 2
        }
        if b >= 8 {
            v = v + 1
        }
        e1(v)
    }
}

// ---- ModRM ----
pub fn modrm(mod, reg, rm) {
    e1(mod % 4 * 64 + reg % 8 * 8 + rm % 8)
}

fn modrm_reg(reg, rm) {
    modrm(3, reg, rm)
}

// ---- mov ----
pub fn mov_rr(dst, src) {
    rex(1, src, 0, dst) + e1(137) + modrm_reg(src, dst) // 0x89
}

pub fn mov_ri64(dst, imm) {
    rex(1, 0, 0, dst) + e1(184 + dst % 8) + e8(imm) // 0xB8+rd
}

pub fn mov_ri32(dst, imm) {
    if dst >= 8 {
        rex(0, 0, 0, dst) + e1(184 + dst % 8) + e4(imm)
    } else {
        e1(184 + dst) + e4(imm)
    }
}

fn sib_for(base) {
    if base % 8 == 4 {
        byte_chr(36)
    } else {
        ""
    }
}

pub fn mov_rm(dst, base, disp) {
    if disp == 0 && base % 8 != 5 {
        rex(1, dst, 0, base) + e1(139) + modrm(0, dst, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        rex(1, dst, 0, base) + e1(139) + modrm(1, dst, base) + sib_for(base) + sb(disp)
    } else {
        rex(1, dst, 0, base) + e1(139) + modrm(2, dst, base) + sib_for(base) + e4s(disp)
    }
}

pub fn mov_mr(base, disp, src) {
    if disp == 0 && base % 8 != 5 {
        rex(1, src, 0, base) + e1(137) + modrm(0, src, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        rex(1, src, 0, base) + e1(137) + modrm(1, src, base) + sib_for(base) + sb(disp)
    } else {
        rex(1, src, 0, base) + e1(137) + modrm(2, src, base) + sib_for(base) + e4s(disp)
    }
}

// ---- push / pop ----
pub fn push_r(reg) {
    rex(0, 0, 0, reg) + e1(80 + reg % 8) // 0x50+rd
}

pub fn pop_r(reg) {
    rex(0, 0, 0, reg) + e1(88 + reg % 8) // 0x58+rd
}

// ---- arithmetic ----
pub fn add_rr(dst, src) {
    rex(1, src, 0, dst) + e1(1) + modrm_reg(src, dst) // 0x01
}

pub fn sub_rr(dst, src) {
    rex(1, src, 0, dst) + e1(41) + modrm_reg(src, dst) // 0x29
}

pub fn and_rr(dst, src) {
    rex(1, src, 0, dst) + e1(33) + modrm_reg(src, dst) // 0x21
}

pub fn or_rr(dst, src) {
    rex(1, src, 0, dst) + e1(9) + modrm_reg(src, dst) // 0x09
}

pub fn xor_rr(dst, src) {
    rex(1, src, 0, dst) + e1(49) + modrm_reg(src, dst) // 0x31
}

pub fn cmp_rr(a, b) {
    rex(1, b, 0, a) + e1(57) + modrm_reg(b, a) // 0x39
}

pub fn test_rr(a, b) {
    rex(1, b, 0, a) + e1(133) + modrm_reg(b, a) // 0x85
}

pub fn neg_r(reg) {
    rex(1, 0, 0, reg) + e1(247) + modrm_reg(3, reg) // 0xF7 /3
}

pub fn imul_rr(dst, src) {
    rex(1, dst, 0, src) + e1(15) + e1(175) + modrm_reg(dst, src) // 0x0F 0xAF
}

pub fn add_ri32(dst, imm) {
    if imm >= -128 && imm <= 127 {
        rex(1, 0, 0, dst) + e1(131) + modrm_reg(0, dst) + sb(imm) // 0x83 /0
    } else {
        rex(1, 0, 0, dst) + e1(129) + modrm_reg(0, dst) + e4s(imm) // 0x81 /0
    }
}

pub fn sub_ri32(dst, imm) {
    if imm >= -128 && imm <= 127 {
        rex(1, 0, 0, dst) + e1(131) + modrm_reg(5, dst) + sb(imm) // 0x83 /5
    } else {
        rex(1, 0, 0, dst) + e1(129) + modrm_reg(5, dst) + e4s(imm) // 0x81 /5
    }
}

// ---- shifts (by CL) ----
pub fn shl_rcl(dst) {
    rex(1, 0, 0, dst) + e1(211) + modrm_reg(4, dst) // 0xD3 /4
}

pub fn shr_rcl(dst) {
    rex(1, 0, 0, dst) + e1(211) + modrm_reg(5, dst) // 0xD3 /5
}

pub fn sar_rcl(dst) {
    rex(1, 0, 0, dst) + e1(211) + modrm_reg(7, dst) // 0xD3 /7
}

// ---- lea ----
pub fn lea(dst, base, disp) {
    if disp == 0 && base % 8 != 5 {
        rex(1, dst, 0, base) + e1(141) + modrm(0, dst, base) + sib_for(base)
    } else if disp >= -128 && disp <= 127 {
        rex(1, dst, 0, base) + e1(141) + modrm(1, dst, base) + sib_for(base) + sb(disp)
    } else {
        rex(1, dst, 0, base) + e1(141) + modrm(2, dst, base) + sib_for(base) + e4s(disp)
    }
}

// ---- control flow ----
pub fn ret() {
    e1(195) // 0xC3
}

pub fn call_r(reg) {
    rex(0, 0, 0, reg) + e1(255) + modrm_reg(2, reg) // 0xFF /2
}

pub fn jmp_r(reg) {
    rex(0, 0, 0, reg) + e1(255) + modrm_reg(4, reg) // 0xFF /4
}

pub fn jmp_rel32(off) {
    e1(233) + e4s(off) // 0xE9
}

pub fn je_rel32(off) {
    e1(15) + e1(132) + e4s(off) // 0x0F 0x84
}

pub fn jne_rel32(off) {
    e1(15) + e1(133) + e4s(off) // 0x0F 0x85
}

pub fn jl_rel32(off) {
    e1(15) + e1(140) + e4s(off) // 0x0F 0x8C
}

pub fn jg_rel32(off) {
    e1(15) + e1(143) + e4s(off) // 0x0F 0x8F
}

pub fn jle_rel32(off) {
    e1(15) + e1(142) + e4s(off) // 0x0F 0x8E
}

pub fn jge_rel32(off) {
    e1(15) + e1(141) + e4s(off) // 0x0F 0x8D
}

pub fn ja_rel32(off) {
    e1(15) + e1(135) + e4s(off) // 0x0F 0x87
}

pub fn jb_rel32(off) {
    e1(15) + e1(130) + e4s(off) // 0x0F 0x82
}

pub fn jae_rel32(off) {
    e1(15) + e1(131) + e4s(off) // 0x0F 0x83
}

pub fn jbe_rel32(off) {
    e1(15) + e1(134) + e4s(off) // 0x0F 0x86
}

pub fn call_rel32(off) {
    e1(232) + e4s(off) // 0xE8
}

// ---- function prologue / epilogue ----
pub fn prologue(frame_size) {
    let code = push_r(rbp) + mov_rr(rbp, rsp)
    if frame_size > 0 {
        code + sub_ri32(rsp, frame_size)
    } else {
        code
    }
}

pub fn epilogue() {
    mov_rr(rsp, rbp) + pop_r(rbp) + ret()
}

// ---- nop / int3 ----
pub fn nop() {
    e1(144) // 0x90
}

pub fn int3() {
    e1(204) // 0xCC
}

pub fn rep_movsb() {
    e1(243) + e1(164) // F3 A4
}

pub fn repe_cmpsb() {
    e1(243) + e1(166) // F3 A6
}

// ---- setcc (set byte on condition) ----
pub fn sete(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(148) + modrm_reg(0, dst) // 0x0F 0x94
}

pub fn setne(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(149) + modrm_reg(0, dst) // 0x0F 0x95
}

pub fn setl(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(156) + modrm_reg(0, dst) // 0x0F 0x9C
}

pub fn setg(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(159) + modrm_reg(0, dst) // 0x0F 0x9F
}

// ---- idiv (signed divide rdx:rax by reg; quotient rax, remainder rdx) ----
pub fn idiv_r(reg) {
    rex(1, 0, 0, reg) + e1(247) + modrm_reg(7, reg) // 0xF7 /7
}

// ---- div (unsigned divide rdx:rax by reg; quotient rax, remainder rdx) ----
pub fn div_r(reg) {
    rex(1, 0, 0, reg) + e1(247) + modrm_reg(6, reg) // 0xF7 /6
}

pub fn cqo() {
    e1(72) + e1(153) // 0x48 0x99
}

// ---- setcc for >= and <= ----
pub fn setge(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(157) + modrm_reg(0, dst) // 0x0F 0x9D
}

pub fn setle(dst) {
    rex(0, 0, 0, dst) + e1(15) + e1(158) + modrm_reg(0, dst) // 0x0F 0x9E
}

// ---- movzx eax, al (zero-extend the low byte into rax) ----
// used after setcc to produce a clean 0/1 int64 on the value stack
pub fn movzx_eax_al() {
    e1(15) + e1(182) + modrm_reg(0, 0) // 0x0F 0xB6 /0 mod=11 r/m=al
}

// ---- lea dst, [rip + rel32] (RIP-relative) ----
// _start uses this to load the jump table base into r13. rel32 is signed,
// measured from the instruction *after* this 7-byte sequence.
pub fn lea_rip_rel32(dst, rel32) {
    rex(1, dst, 0, 0) + e1(141) + modrm(0, dst, 5) + e4s(rel32) // 0x8D /reg mod=00 r/m=101
}

// ---- value-stack helpers (r15 = top, grows up; r14 = frame base) ----
// push reg onto the value stack
pub fn vs_push(reg) {
    mov_mr(r15, 0, reg) + add_ri32(r15, 8)
}

// push 0 (unit / false / dummy callee self-slot)
pub fn vs_push_zero() {
    // mov qword [r15], 0  (49 C7 07 00 00 00 00) + add r15, 8
    e1(73) + e1(199) + modrm(0, 0, r15) + e4(0) + add_ri32(r15, 8)
}

// discard n slots from the value stack
pub fn vs_pop_n(n) {
    sub_ri32(r15, 8 * n)
}

// ================================================================
// Phase 1 native x86-64 code generator.
// Mirrors cgen.bur's structure (inst_len / jump_targets / emit_inst)
// but emits raw machine code instead of C strings. Values are raw
// int64 (8 bytes/slot, no tagging). r15 = value stack top (grows up),
// r14 = frame base, r13 = jump table base (set once by _start),
// rbp = saved caller r14, rsp = native call stack.
// ================================================================

// x86gen_prologue: save caller base, set callee base to the self slot.
// Locals live on the value stack (pushed by declarations), not in a reserved
// frame area — mirroring the C backend's `base = top - arity - 1`.
fn x86gen_prologue(arity, _locals) {
    push_r(rbp) + mov_rr(rbp, r14) + lea(r14, r15, 0 - 8 * (arity + 1))
}

// x86gen_epilogue: peek the return value, collapse the frame to the
// base, drop the result at the base slot, restore caller r14, ret.
fn x86gen_epilogue() {
    mov_rm(rax, r15, 0 - 8) + mov_rr(r15, r14) + mov_mr(r15, 0, rax) + add_ri32(r15, 8) + mov_rr(r14, rbp) + pop_r(rbp) + ret()
}

// x86gen_str_native: inline code for str(n) -> str.
// Divides n by 10 repeatedly, pushes digit bytes, then allocates and fills.
// Clobbers rax, rcx, rdx, r10, r11, rdi. Non-negative only.
fn x86gen_str_native() {
    let loop_body = xor_rr(rdx, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 10) + idiv_r(rcx) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(r10, 1) + test_rr(rax, rax)
    let loop_jne = jne_rel32(0 - (str_len(loop_body) + 6))
    let alloc = mov_rr(r11, r12) + mov_mr(r11, 0, r10) + lea(rcx, r10, 8) + add_rr(r12, rcx) + lea(rdi, r11, 8)
    let pop_body = pop_r(rax) + e1(136) + e1(7) + add_ri32(rdi, 1) + sub_ri32(r10, 1)
    let pop_jne = jne_rel32(0 - (str_len(pop_body) + 6))
    mov_rm(rax, r15, 0 - 8) + xor_rr(r10, r10) + loop_body + loop_jne + alloc + pop_body + pop_jne + mov_mr(r15, 0 - 16, r11) + vs_pop_n(1)
}

// x86gen_push_native: inline code for push(list, val).
// List header: [len][cap][elements_ptr]. Header never moves.
// Grows elements array if len==cap (doubles cap, min 4).
// Stack in: [callee, list_ptr, val] at r15-24, r15-16, r15-8. Stack out: [unit].
fn x86gen_push_native() {
    let growth = mov_rr(r10, rcx) + add_rr(r10, r10) + test_rr(r10, r10) + jne_rel32(4) + add_ri32(r10, 4) + mov_rr(r11, r12) + mov_rm(rsi, rax, 16) + mov_mr(rax, 8, r10) + mov_mr(rax, 16, r11) + mov_rr(rdi, r11) + mov_rr(rdx, rcx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rr(rdx, r10) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r12, rdx)
    let store = mov_rm(rcx, rax, 0) + mov_rm(r11, rax, 16) + mov_rr(rdx, rcx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r11, rdx) + mov_mr(r11, 0, r9) + mov_rm(rcx, rax, 0) + add_ri32(rcx, 1) + mov_mr(rax, 0, rcx) + xor_rr(r11, r11) + mov_mr(r15, 0 - 24, r11) + vs_pop_n(2)
    mov_rm(rax, r15, 0 - 16) + mov_rm(r9, r15, 0 - 8) + mov_rm(rcx, rax, 0) + mov_rm(r10, rax, 8) + cmp_rr(rcx, r10) + jne_rel32(str_len(growth)) + growth + store
}

// x86gen_pop_native: inline code for pop(list) -> element.
// Decrements len and returns the last element via elements_ptr.
// Stack in: [callee, list_ptr] at r15-16, r15-8. Stack out: [element].
fn x86gen_pop_native() {
    mov_rm(rax, r15, 0 - 8) + mov_rm(rcx, rax, 0) + sub_ri32(rcx, 1) + mov_mr(rax, 0, rcx) + mov_rm(r11, rax, 16) + mov_rr(rdx, rcx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r11, rdx) + mov_rm(r9, r11, 0) + mov_mr(r15, 0 - 16, r9) + vs_pop_n(1)
}

// x86gen_str_convert_at: inline int-to-str conversion.
// Reads int from stack at [r15+off], writes string ptr back to same slot.
// Clobbers rax,rcx,rdx,r10,r11,rdi.
fn x86gen_str_convert_at(off) {
    let div_loop = xor_rr(rdx, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 10) + idiv_r(rcx) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(r10, 1) + test_rr(rax, rax)
    let div_jne = jne_rel32(0 - (str_len(div_loop) + 6))
    let alloc = mov_rr(r11, r12) + mov_mr(r11, 0, r10) + lea(rcx, r10, 8) + add_rr(r12, rcx) + lea(rdi, r11, 8)
    let pop_loop = pop_r(rax) + e1(136) + e1(7) + add_ri32(rdi, 1) + sub_ri32(r10, 1)
    let pop_jne = jne_rel32(0 - (str_len(pop_loop) + 6))
    mov_rm(rax, r15, off) + xor_rr(r10, r10) + div_loop + div_jne + alloc + pop_loop + pop_jne + mov_mr(r15, off, r11)
}

// x86gen_bool_convert_at: inline 0/1 -> "true"/"false" string.
// Reads int at [r15+off], writes str ptr back to same slot.
// Clobbers rax, rdx, r10, r11.
fn x86gen_bool_convert_at(off) {
    let fpath = mov_rr(r11, r12) + mov_ri64(r10, 5) + mov_mr(r11, 0, r10) + mov_ri64(rdx, 435728179558) + mov_mr(r11, 8, rdx) + add_ri32(r10, 8) + add_rr(r12, r10) + mov_mr(r15, off, r11)
    let tpath = mov_rr(r11, r12) + mov_ri64(r10, 4) + mov_mr(r11, 0, r10) + mov_ri64(rdx, 1702195828) + mov_mr(r11, 8, rdx) + add_ri32(r10, 8) + add_rr(r12, r10) + mov_mr(r15, off, r11) + jmp_rel32(str_len(fpath))
    mov_rm(rax, r15, off) + test_rr(rax, rax) + je_rel32(str_len(tpath)) + tpath + fpath
}

// x86gen_unit_convert_at: inline unit -> "()" string.
// Reads int at [r15+off], writes str ptr back to same slot.
// Clobbers rax, rdx, r10, r11.
fn x86gen_unit_convert_at(off) {
    mov_rm(rax, r15, off) + mov_rr(r11, r12) + mov_ri64(r10, 2) + mov_mr(r11, 0, r10) + mov_ri64(rdx, 10536) + mov_mr(r11, 8, rdx) + add_ri32(r10, 8) + add_rr(r12, r10) + mov_mr(r15, off, r11)
}

// x86gen_ord_native: inline code for ord(str) -> leading UTF-8 code point.
// Decodes 1-4 continuation bytes per RFC 3629. String at [r15-8].
// Clobbers rax, rcx, rdx, rsi, r8, r9.
// is_unimpl_native: true for VM natives the x86 backend does not inline
// (mirrors decl_native in compiler/frontend/types.bur minus the inlined
// subset handled in op_call). Calls to these emit int3 -> SIGTRAP so the
// parity suite skips the program instead of miscompiling it.
fn is_unimpl_native(name) {
    name == "args" || name == "clock" || name == "close" || name == "exec" || name == "exec_poll" || name == "exec_start" || name == "file_exists" || name == "float_bits" || name == "gc" || name == "gc_cycles" || name == "heap_objects" || name == "net_close" || name == "net_nb" || name == "net_read" || name == "net_write" || name == "parse_float" || name == "read_dir" || name == "read_file" || name == "read_stdin" || name == "recv" || name == "sleep" || name == "stdin_nb" || name == "tcp_accept" || name == "tcp_dial" || name == "tcp_listen" || name == "to_float" || name == "trunc" || name == "type_of" || name == "write_file" || name == "yield" || name == "chan"
}

fn x86gen_ord_native() {
    let pre = mov_rm(rcx, r15, 0 - 8) + lea(rsi, rcx, 8) + xor_rr(rax, rax) + e1(172)
    let t_ascii = mov_rr(rdx, rax) + mov_ri64(r9, 128) + and_rr(rdx, r9)
    let t_2 = mov_rr(rdx, rax) + mov_ri64(r9, 224) + and_rr(rdx, r9) + mov_ri64(r9, 192) + cmp_rr(rdx, r9)
    let t_3 = mov_rr(rdx, rax) + mov_ri64(r9, 240) + and_rr(rdx, r9) + mov_ri64(r9, 224) + cmp_rr(rdx, r9)
    let dec_2 = mov_ri64(r9, 31) + and_rr(rax, r9) + mov_ri64(r8, 1)
    let dec_3 = mov_ri64(r9, 15) + and_rr(rax, r9) + mov_ri64(r8, 2)
    let dec_4 = mov_ri64(r9, 7) + and_rr(rax, r9) + mov_ri64(r8, 3)
    let cont_test = test_rr(r8, r8)
    let cont_body = mov_ri64(rcx, 6) + shl_rcl(rax) + mov_rr(r9, rax) + e1(172) + mov_ri64(rcx, 63) + and_rr(rax, rcx) + or_rr(r9, rax) + mov_rr(rax, r9) + sub_ri32(r8, 1)
    let done = mov_mr(r15, 0 - 16, rax) + vs_pop_n(1)
    let cont_back = jmp_rel32(0 - (str_len(cont_test) + 6 + str_len(cont_body) + 5))
    let cont = cont_test + je_rel32(str_len(cont_body) + 5) + cont_body + cont_back
    let try3_jne = jne_rel32(str_len(dec_2) + 5)
    let cont2_jmp = jmp_rel32(str_len(t_3) + 6 + str_len(dec_3) + 5 + str_len(dec_4))
    let try4_jne = jne_rel32(str_len(dec_3) + 5)
    let cont3_jmp = jmp_rel32(str_len(dec_4))
    let ascii_je = je_rel32(str_len(t_2) + 6 + str_len(dec_2) + 5 + str_len(t_3) + 6 + str_len(dec_3) + 5 + str_len(dec_4) + str_len(cont))
    pre + t_ascii + ascii_je + t_2 + try3_jne + dec_2 + cont2_jmp + t_3 + try4_jne + dec_3 + cont3_jmp + dec_4 + cont + done
}

// x86gen_contains_native: inline code for contains(list, x) -> bool.
// Linear scan of list elements comparing 8B values (int/ptr) to x.
// Stack in: [callee, list, x] at r15-24, r15-16, r15-8. Out: [bool].
// Clobbers rax, rcx, rdx, r8-r11.
fn x86gen_contains_native() {
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r8, r15, 0 - 8) + mov_rm(rsi, r9, 0) + mov_rm(r10, r9, 16) + xor_rr(r11, r11)
    let found = mov_ri64(rax, 1) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2)
    let notfound = mov_ri64(rax, 0) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2) + jmp_rel32(str_len(found))
    let inc = add_ri32(r11, 1)
    let access = mov_rr(rdx, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(rdx, r10) + mov_rm(rdx, rdx, 0) + cmp_rr(rdx, r8) + je_rel32(str_len(inc) + 5 + str_len(notfound))
    let test = cmp_rr(r11, rsi) + jae_rel32(str_len(access) + str_len(inc) + 5)
    let back = jmp_rel32(0 - (str_len(test) + str_len(access) + str_len(inc) + 5))
    head + test + access + inc + back + notfound + found
}

// x86gen_slice_native: inline code for slice(list, start, end) -> list.
// New list of len = end-start with elements copied from [start, end).
// Stack in: [callee, list, start, end] at r15-32, -24, -16, -8. Out: [list].
// Clobbers rax, rcx, rdx, r8-r11, rsi, rdi.
fn x86gen_slice_native() {
    mov_rm(rax, r15, 0 - 24) + mov_rm(r8, r15, 0 - 16) + mov_rm(r9, r15, 0 - 8) + sub_rr(r9, r8) + mov_rm(r10, rax, 16) + mov_rr(rdx, r8) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(rdx, r10) + mov_rr(r11, r12) + mov_mr(r11, 0, r9) + mov_mr(r11, 8, r9) + lea(r10, r11, 24) + mov_mr(r11, 16, r10) + mov_rr(rsi, rdx) + mov_rr(rdi, r10) + mov_rr(rdx, r9) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rr(rdx, r9) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_ri32(rdx, 24) + add_rr(rdx, r11) + mov_rr(r12, rdx) + mov_mr(r15, 0 - 32, r11) + vs_pop_n(3)
}

// x86gen_list_format_at: convert the list at [r15+off] to its
// "[elem, ...]" string in place (matches VM format_val). is_str selects
// str (quoted) or int element formatting at compile time; element lists
// are homogeneous. Clobbers rax, rcx, rdx, rsi, rdi, r8-r11. Uses the
// native stack for digit reversal.
fn x86gen_list_format_at(off, is_str) {
    let mb_al = e1(136) + e1(7)
    let mb = fn(c) {
        e1(198) + e1(7) + sb(c)
    }
    let h1 = mov_rm(r9, r15, off) + mov_rm(r8, r9, 0) + mov_rm(r10, r9, 16) + mov_ri64(rcx, 2) + xor_rr(r11, r11)
    let int1_loop = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
    let int1_loop_jne = jne_rel32(0 - (str_len(int1_loop) + 6))
    let int1 = mov_rr(rax, rdx) + xor_rr(rsi, rsi)
    let int1_add = add_rr(rcx, rsi) + jmp_rel32(0)
    let str1 = mov_rm(rsi, rdx, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
    let e1_load = mov_rr(rax, rcx) + mov_rr(rsi, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + add_rr(rsi, r10) + mov_rm(rdx, rsi, 0) + mov_rr(rcx, rax)
    let sep1_bytes = add_ri32(rcx, 2)
    let sep1 = test_rr(r11, r11) + je_rel32(str_len(sep1_bytes)) + sep1_bytes
    let next1_wo = add_ri32(r11, 1)
    let tail1 = if is_str {
        str1
    } else {
        int1 + int1_loop + int1_loop_jne + int1_add
    }
    let test1 = cmp_rr(r11, r8) + jae_rel32(str_len(sep1) + str_len(e1_load) + str_len(tail1) + str_len(next1_wo) + 5)
    let next1 = next1_wo + jmp_rel32(0 - (str_len(test1) + str_len(sep1) + str_len(e1_load) + str_len(tail1) + str_len(next1_wo) + 5))
    let alloc_zone = mov_rr(r9, r12) + mov_mr(r9, 0, rcx) + lea(rdi, r9, 8) + add_rr(r12, rcx) + add_ri32(r12, 8) + mb(91) + add_ri32(rdi, 1) + xor_rr(r11, r11)
    let int2_loop = xor_rr(rdx, rdx) + mov_ri64(rsi, 10) + idiv_r(rsi) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(rcx, 1) + test_rr(rax, rax)
    let int2_loop_jne = jne_rel32(0 - (str_len(int2_loop) + 6))
    let write2_body = pop_r(rax) + mb_al + add_ri32(rdi, 1) + sub_ri32(rcx, 1) + test_rr(rcx, rcx)
    let write2 = write2_body + jne_rel32(0 - (str_len(write2_body) + 6))
    let int2_zero = mb(48) + add_ri32(rdi, 1) + jmp_rel32(str_len(int2_loop) + str_len(int2_loop_jne) + str_len(write2))
    let int2 = mov_rr(rax, rdx) + xor_rr(rcx, rcx) + test_rr(rax, rax) + jne_rel32(str_len(int2_zero)) + int2_zero + int2_loop + int2_loop_jne + write2
    let str2 = mb(34) + add_ri32(rdi, 1) + mov_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rm(rcx, rdx, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
    let e2_load = mov_rr(rsi, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + add_rr(rsi, r10) + mov_rm(rdx, rsi, 0)
    let sep2_bytes = mb(44) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
    let sep2 = test_rr(r11, r11) + je_rel32(str_len(sep2_bytes)) + sep2_bytes
    let next2_wo = add_ri32(r11, 1)
    let tail2 = if is_str {
        str2
    } else {
        int2
    }
    let test2 = cmp_rr(r11, r8) + jae_rel32(str_len(sep2) + str_len(e2_load) + str_len(tail2) + str_len(next2_wo) + 5)
    let next2 = next2_wo + jmp_rel32(0 - (str_len(test2) + str_len(sep2) + str_len(e2_load) + str_len(tail2) + str_len(next2_wo) + 5))
    let endfill = mb(93) + add_ri32(rdi, 1) + mov_mr(r15, off, r9)
    h1 + test1 + sep1 + e1_load + tail1 + next1 + alloc_zone + test2 + sep2 + e2_load + tail2 + next2 + endfill
}

// x86gen_concat_native: inline code for concat(x, y) -> list.
// New list = x's elements followed by y's elements.
// Stack in: [callee, x, y] at r15-24, r15-16, r15-8. Out: [list].
// Clobbers rax, rcx, rdx, r8-r11, rsi, rdi.
fn x86gen_concat_native() {
    mov_rm(r9, r15, 0 - 16) + mov_rm(r8, r15, 0 - 8) + mov_rm(rcx, r9, 0) + mov_rm(rdx, r8, 0) + add_rr(rcx, rdx) + mov_rr(r11, r12) + mov_mr(r11, 0, rcx) + mov_mr(r11, 8, rcx) + lea(r10, r11, 24) + mov_mr(r11, 16, r10) + mov_rm(rsi, r9, 16) + mov_rr(rdi, r10) + mov_rm(rdx, r9, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rm(rsi, r8, 16) + mov_rm(rdx, r8, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rm(rax, r9, 0) + mov_rm(rdx, r8, 0) + add_rr(rax, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rax) + add_ri32(rax, 24) + add_rr(rax, r11) + mov_rr(r12, rax) + mov_mr(r15, 0 - 24, r11) + vs_pop_n(2)
}

// Stack in: [a, b]. Stack out: [0/1]. Lengths differ -> false; else
// byte-by-byte compare (repe cmpsb). Clobbers rax, rcx, rdx, r9, r10,
// rsi, rdi.
fn x86gen_eq_str() {
    let cmp_body = lea(rsi, rax, 8) + lea(rdi, rcx, 8) + mov_rr(rcx, rdx) + repe_cmpsb() + sete(r10)
    let done = mov_mr(r15, 0 - 16, r10) + vs_pop_n(1)
    mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + mov_rm(rdx, rax, 0) + mov_rm(r9, rcx, 0) + xor_rr(r10, r10) + cmp_rr(rdx, r9) + jne_rel32(str_len(cmp_body)) + cmp_body + done
}

// x86gen_join_native: inline code for join([str], sep) -> str.
// Stack in: [callee, list, sep] at r15-24, r15-16, r15-8. Out: [str].
// Pass 1 sums element lengths plus sep between elements into rdx; then a
// single str [len][bytes] is allocated and pass 2 copies elements and sep
// through rdi. r9=list, r10=sep, r8=n, r11=sn, rax=i, rdx=total/len.
fn x86gen_join_native() {
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_rm(r8, r9, 0) + mov_rm(r11, r10, 0) + xor_rr(rdx, rdx) + xor_rr(rax, rax)
    let done_copy = vs_pop_n(2)
    let pass2_elem = mov_rr(rsi, rax) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + mov_rm(rcx, r9, 16) + add_rr(rcx, rsi) + mov_rm(rcx, rcx, 0) + mov_rr(rsi, rcx) + add_ri32(rsi, 8) + mov_rm(rdx, rcx, 0) + mov_rr(rcx, rdx) + rep_movsb()
    let pass2_no = mov_rr(rsi, r10) + add_ri32(rsi, 8) + mov_rr(rcx, r11) + rep_movsb()
    let pass2_je = test_rr(rax, rax) + je_rel32(str_len(pass2_no))
    let pass2_head = cmp_rr(rax, r8) + jge_rel32(str_len(pass2_je) + str_len(pass2_no) + str_len(pass2_elem) + 9)
    let loop_copy_body = pass2_je + pass2_no + pass2_elem + add_ri32(rax, 1)
    let back_copy = jmp_rel32(0 - (str_len(pass2_head) + str_len(loop_copy_body) + 5))
    let loop_copy = pass2_head + loop_copy_body + back_copy
    let done_len_tail = mov_mr(r15, 0 - 24, r12) + mov_rr(rdi, r12) + mov_mr(rdi, 0, rdx) + add_rr(r12, rdx) + add_ri32(r12, 8) + mov_rm(rdi, r15, 0 - 24) + add_ri32(rdi, 8) + xor_rr(rax, rax)
    let pass1_elem = mov_rr(rsi, rax) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + mov_rm(rcx, r9, 16) + add_rr(rcx, rsi) + mov_rm(rcx, rcx, 0) + mov_rm(rsi, rcx, 0) + add_rr(rdx, rsi)
    let pass1_no = add_rr(rdx, r11)
    let pass1_je = test_rr(rax, rax) + je_rel32(str_len(pass1_no))
    let pass1_head = cmp_rr(rax, r8) + jge_rel32(str_len(pass1_je) + str_len(pass1_no) + str_len(pass1_elem) + 9)
    let loop_len_body = pass1_je + pass1_no + pass1_elem + add_ri32(rax, 1)
    let back_len = jmp_rel32(0 - (str_len(pass1_head) + str_len(loop_len_body) + 5))
    let loop_len = pass1_head + loop_len_body + back_len
    head + loop_len + done_len_tail + loop_copy + done_copy
}

// x86gen_trim_native: inline code for trim(s) -> str.
// Stack in: [callee, s] at r15-16, r15-8. Out: [str].
// Strips ASCII whitespace (0x20 and 0x09..0x0d) from both ends; the
// result is a freshly allocated str [len][bytes]. r9=s, r8=n, rdx=i, rcx=j.
fn x86gen_trim_native() {
    let read = mov_rr(rsi, r9) + add_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rm(rax, rsi, 0) + mov_ri64(r10, 255) + and_rr(rax, r10)
    let done = sub_rr(rcx, rdx) + mov_mr(r15, 0 - 16, r12) + mov_rr(rdi, r12) + mov_mr(rdi, 0, rcx) + mov_rr(rsi, r9) + add_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rr(rdi, r12) + add_ri32(rdi, 8) + mov_rm(rcx, r15, 0 - 16) + mov_rm(rcx, rcx, 0) + rep_movsb() + mov_rm(rcx, r15, 0 - 16) + mov_rm(rcx, rcx, 0) + add_rr(r12, rcx) + add_ri32(r12, 8) + mov_rm(rsi, r15, 0 - 16) + mov_mr(r15, 0 - 16, rsi) + vs_pop_n(1)
    let yes2 = sub_ri32(rcx, 1)
    let no2 = jmp_rel32(str_len(yes2) + 5)
    let jb2 = sub_ri32(rax, 9) + sub_ri32(rax, 5) + jb_rel32(str_len(no2))
    let je2 = mov_rr(r10, rax) + sub_ri32(r10, 32) + test_rr(r10, r10) + je_rel32(str_len(jb2) + str_len(no2))
    let tail2 = mov_rr(rsi, r9) + add_rr(rsi, rcx) + add_ri32(rsi, 7) + mov_rm(rax, rsi, 0) + mov_ri64(r10, 255) + and_rr(rax, r10) + je2 + jb2 + no2 + yes2
    let cond2 = cmp_rr(rcx, rdx) + jle_rel32(str_len(tail2) + 5)
    let back2 = jmp_rel32(0 - (str_len(cond2) + str_len(tail2) + 5))
    let loop2 = cond2 + tail2 + back2
    let yes1 = add_ri32(rdx, 1)
    let no1 = jmp_rel32(str_len(yes1) + 5)
    let jb1 = sub_ri32(rax, 9) + sub_ri32(rax, 5) + jb_rel32(str_len(no1))
    let je1 = mov_rr(r10, rax) + sub_ri32(r10, 32) + test_rr(r10, r10) + je_rel32(str_len(jb1) + str_len(no1))
    let tail1 = read + je1 + jb1 + no1 + yes1
    let cond1 = cmp_rr(rdx, rcx) + jge_rel32(str_len(tail1) + 5)
    let back1 = jmp_rel32(0 - (str_len(cond1) + str_len(tail1) + 5))
    let loop1 = cond1 + tail1 + back1
    let head = mov_rm(r9, r15, 0 - 8) + mov_rm(r8, r9, 0) + xor_rr(rdx, rdx) + mov_rr(rcx, r8)
    head + loop1 + loop2 + done
}

// x86gen_parse_int_native: inline code for parse_int(s) -> Option<int>.
// Reuses x86gen_trim_native (same [callee, s] layout) then parses a signed
// decimal with an overflow check per digit. Stack in: [callee, s] at
// r15-16, r15-8. Out: [enum] (Some [0][0][v] / None [0][1]) at r15-8.
// Clobbers rax, rcx, rdx, rsi, rdi, r8-r11.
fn x86gen_parse_int_native() {
    let trim = x86gen_trim_native()
    let head = mov_rm(r9, r15, 0 - 8) + mov_rm(r8, r9, 0) + lea(rsi, r9, 8) + mov_rr(rdi, rsi) + add_rr(rdi, r8) + mov_ri64(r11, 1) + xor_rr(r10, r10)
    let none = mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + add_ri32(r12, 16) + mov_mr(r15, 0 - 8, rcx)
    let positive = mov_rr(rax, r10) + mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 0) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 8, rcx) + jmp_rel32(str_len(none))
    let success_neg = neg_r(r10)
    let success = test_rr(r11, r11) + jge_rel32(str_len(success_neg)) + success_neg
    let accumulate = mov_rm(rax, rsi, 0) + mov_ri64(rcx, 255) + and_rr(rax, rcx) + sub_ri32(rax, 48) + mov_ri64(rcx, 10) + imul_rr(r10, rcx) + add_rr(r10, rax) + add_ri32(rsi, 1)
    let overflow_check = mov_rr(rdx, rax) + mov_rr(rax, r8) + sub_rr(rax, rdx) + xor_rr(rdx, rdx) + mov_ri64(rcx, 10) + div_r(rcx) + cmp_rr(r10, rax) + ja_rel32(str_len(accumulate) + 5 + str_len(success) + str_len(positive))
    let digit_parse = mov_rm(rax, rsi, 0) + mov_ri64(rcx, 255) + and_rr(rax, rcx) + sub_ri32(rax, 48) + mov_ri64(rcx, 9) + cmp_rr(rax, rcx) + ja_rel32(str_len(overflow_check) + str_len(accumulate) + 5 + str_len(success) + str_len(positive))
    let loop_head = cmp_rr(rsi, rdi) + jae_rel32(str_len(digit_parse) + str_len(overflow_check) + str_len(accumulate) + 5)
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(digit_parse) + str_len(overflow_check) + str_len(accumulate) + 5))
    let limit_neg = add_ri32(r8, 1)
    let limit_set = mov_ri64(r8, 9223372036854775807) + test_rr(r11, r11) + jge_rel32(str_len(limit_neg))
    let digit_check = cmp_rr(rsi, rdi) + jae_rel32(str_len(limit_set) + str_len(limit_neg) + str_len(loop_head) + str_len(digit_parse) + str_len(overflow_check) + str_len(accumulate) + 5 + str_len(success) + str_len(positive))
    let minus = mov_ri64(r11, 1) + neg_r(r11) + add_ri32(rsi, 1)
    let plus = add_ri32(rsi, 1) + jmp_rel32(str_len(minus))
    let sign_jmp = jmp_rel32(str_len(plus) + str_len(minus))
    let minus_cmp = mov_ri64(rcx, 45) + cmp_rr(rax, rcx) + je_rel32(str_len(sign_jmp) + str_len(plus))
    let sign_read = mov_rm(rax, rsi, 0) + mov_ri64(rcx, 255) + and_rr(rax, rcx) + mov_ri64(rcx, 43) + cmp_rr(rax, rcx) + je_rel32(str_len(minus_cmp) + str_len(sign_jmp))
    let empty_check = cmp_rr(rsi, rdi) + jae_rel32(str_len(sign_read) + str_len(minus_cmp) + str_len(sign_jmp) + str_len(plus) + str_len(minus) + str_len(digit_check) + str_len(limit_set) + str_len(limit_neg) + str_len(loop_head) + str_len(digit_parse) + str_len(overflow_check) + str_len(accumulate) + 5 + str_len(success) + str_len(positive))
    trim + head + empty_check + sign_read + minus_cmp + sign_jmp + plus + minus + digit_check + limit_set + limit_neg + loop_head + digit_parse + overflow_check + accumulate + back + success + positive + none
}

// x86gen_split_native: inline code for split(s, sep) -> [str].
// Stack in: [callee, s, sep] at r15-24, r15-16, r15-8. Out: [list].
// List object [len][cap][elems_ptr] with cap = n+1 preallocated; each
// element is a freshly allocated str [len][bytes]. r9=s, r10=sep, r8=n,
// r11=sn, rax=i, rdx=start; obj and w live in the arg slots r15-16 and
// r15-8, newstr is staged in the callee slot r15-24.
fn x86gen_split_native() {
    let push = mov_mr(r15, 0 - 24, r12) + mov_rr(rdi, r12) + mov_mr(rdi, 0, rcx) + mov_rr(rsi, r9) + add_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rr(rdi, r12) + add_ri32(rdi, 8) + mov_rm(rcx, r15, 0 - 24) + mov_rm(rcx, rcx, 0) + rep_movsb() + mov_rm(rcx, r15, 0 - 24) + mov_rm(rcx, rcx, 0) + add_rr(r12, rcx) + add_ri32(r12, 8) + mov_rm(rdi, r15, 0 - 8) + mov_rm(rsi, r15, 0 - 24) + mov_mr(rdi, 0, rsi) + add_ri32(rdi, 8) + mov_mr(r15, 0 - 8, rdi)
    let done = mov_rr(rcx, r8) + sub_rr(rcx, rdx) + push + mov_rm(rdi, r15, 0 - 16) + mov_rm(rsi, r15, 0 - 8) + sub_rr(rsi, rdi) + sub_ri32(rsi, 24) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shr_rcl(rsi) + mov_mr(rdi, 0, rsi) + mov_mr(r15, 0 - 24, rdi) + vs_pop_n(2)
    let matched = mov_rr(rcx, rax) + sub_rr(rcx, rdx) + push + mov_rm(r11, r10, 0) + add_rr(rax, r11) + mov_rr(rdx, rax)
    let no_match = add_ri32(rax, 1)
    let loop_tail = mov_rr(rsi, r9) + add_rr(rsi, rax) + add_ri32(rsi, 8) + mov_rr(rdi, r10) + add_ri32(rdi, 8) + mov_rr(rcx, r11) + repe_cmpsb() + je_rel32(str_len(no_match) + 5)
    let cond_ja = mov_rm(r11, r10, 0) + mov_rr(rcx, rax) + add_rr(rcx, r11) + cmp_rr(rcx, r8) + ja_rel32(str_len(loop_tail) + str_len(no_match) + 5 + str_len(matched) + 5)
    let cond_je = test_rr(r11, r11) + je_rel32(str_len(cond_ja) + str_len(loop_tail) + str_len(no_match) + 5 + str_len(matched) + 5)
    let loop_head = cond_je + cond_ja + loop_tail
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(no_match) + 5))
    let matched_back = jmp_rel32(0 - (str_len(loop_head) + str_len(no_match) + 5 + str_len(matched) + 5))
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_rm(r8, r9, 0) + mov_rm(r11, r10, 0) + mov_rr(rdi, r12) + xor_rr(rax, rax) + mov_mr(rdi, 0, rax) + mov_mr(rdi, 8, rax) + mov_mr(rdi, 16, rax) + mov_rr(rdx, r8) + add_ri32(rdx, 1) + mov_mr(rdi, 8, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_ri32(rdx, 24) + mov_rr(rax, rdi) + add_ri32(rax, 24) + mov_mr(rdi, 16, rax) + add_rr(r12, rdx) + mov_mr(r15, 0 - 16, rdi) + mov_rr(rsi, rdi) + add_ri32(rsi, 24) + mov_mr(r15, 0 - 8, rsi) + xor_rr(rax, rax) + xor_rr(rdx, rdx)
    head + loop_head + no_match + back + matched + matched_back + done
}

// x86gen_str_find_native: inline code for str_contains(s, sub) -> bool
// and str_index_of(s, sub) -> Option<int>, sharing one linear scan with
// repe cmpsb. as_option selects the enum result.
// Stack in: [callee, s, sub] at r15-24, r15-16, r15-8. Out: [bool|enum].
// Clobbers rax, rcx, rdx, rsi, rdi, r8-r11.
fn x86gen_str_find_native(as_option) {
    let some = if as_option {
        mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 0) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    } else {
        mov_ri64(rax, 1) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2)
    }
    let none = if as_option {
        mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + add_ri32(r12, 16) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2) + jmp_rel32(str_len(some))
    } else {
        mov_ri64(rax, 0) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2) + jmp_rel32(str_len(some))
    }
    let next = add_ri32(rax, 1)
    let loop_tail = mov_rr(rsi, r9) + add_rr(rsi, rax) + add_ri32(rsi, 8) + mov_rr(rdi, r10) + add_ri32(rdi, 8) + mov_rr(rcx, r11) + test_rr(rcx, rcx) + repe_cmpsb() + je_rel32(str_len(next) + 5 + str_len(none))
    let loop_head = mov_rr(rcx, rax) + add_rr(rcx, r11) + cmp_rr(rcx, r8) + ja_rel32(str_len(loop_tail) + str_len(next) + 5) + loop_tail
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(next) + 5))
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_rm(r8, r9, 0) + mov_rm(r11, r10, 0) + xor_rr(rax, rax)
    head + loop_head + next + back + none + some
}

// x86gen_map_native: inline code for map() -> map.
// Map header: [n][cap][keys_ptr][vals_ptr] (32 bytes). keys/vals are
// separate 8-byte-slot arrays (raw int or str pointer per slot); all-zero
// header = empty map. Not covered by SPEC, matches VM semantics.
// Stack in: [callee] at r15-8. Stack out: [map_ptr].
// Clobbers rdx, r11, r12.
fn x86gen_map_native() {
    mov_rr(r11, r12) + xor_rr(rdx, rdx) + mov_mr(r11, 0, rdx) + mov_mr(r11, 8, rdx) + mov_mr(r11, 16, rdx) + mov_mr(r11, 24, rdx) + add_ri32(r12, 32) + mov_mr(r15, 0 - 8, r11)
}

// x86gen_get_map_native: inline code for get(map, key) -> Option<T>.
// Linear scan over keys; key_is_str selects content compare (repe cmpsb,
// length first) over raw 8B compare. Missing key -> None ([eh][vi=1]),
// found -> Some ([eh][vi=0][val]) with val read from the parallel vals
// array. Stack in: [callee, map, key] at r15-24, r15-16, r15-8. Out: [enum].
// Clobbers rax, rcx, rdx, rsi, rdi, r8-r11.
fn x86gen_get_map_native(key_is_str) {
    let some_body = mov_rm(rax, r9, 0) + mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 0) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let none = mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + add_ri32(r12, 16) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2) + jmp_rel32(str_len(some_body))
    let advance = add_ri32(r10, 8) + add_ri32(r9, 8) + add_ri32(r11, 1)
    let access = mov_rm(rdx, r10, 0)
    let body = if key_is_str {
        let klen = mov_rm(rcx, rax, 0)
        let clen = mov_rm(rdi, rdx, 0)
        let cmpsb_je = lea(rsi, rdx, 8) + lea(rdi, rax, 8) + repe_cmpsb() + je_rel32(str_len(advance) + 5 + str_len(none))
        access + mov_rm(rax, r15, 0 - 8) + klen + clen + cmp_rr(rcx, rdi) + jne_rel32(str_len(cmpsb_je)) + cmpsb_je
    } else {
        access + mov_rm(rax, r15, 0 - 8) + cmp_rr(rdx, rax) + je_rel32(str_len(advance) + 5 + str_len(none))
    }
    let loop_head = cmp_rr(r11, r8) + jae_rel32(str_len(body) + str_len(advance) + 5)
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(body) + str_len(advance) + 5))
    let head = mov_rm(rax, r15, 0 - 16) + mov_rm(r8, rax, 0) + mov_rm(r10, rax, 16) + mov_rm(r9, rax, 24) + xor_rr(r11, r11)
    head + loop_head + body + advance + back + none + some_body
}

// x86gen_put_map_native: inline code for put(map, key, val) -> unit.
// Grows keys/vals arrays (cap*2, min 4, rep movsb copy) when len==cap,
// then linear-scans for the key: existing -> overwrite val, absent ->
// append at index len. Stack in: [callee, map, key, val] at r15-32, -24,
// -16, -8. Out: [unit]. Clobbers rax, rcx, rdx, rsi, rdi, r8-r11.
fn x86gen_put_map_native(key_is_str) {
    let done = xor_rr(rax, rax) + mov_mr(r15, 0 - 32, rax) + vs_pop_n(3)
    let found = mov_rm(rax, r15, 0 - 8) + mov_mr(r9, 0, rax)
    let not_found = mov_rm(rax, r15, 0 - 24) + mov_rm(rsi, rax, 16) + mov_rm(rdx, rax, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(rsi, rdx) + mov_rm(r8, r15, 0 - 16) + mov_mr(rsi, 0, r8) + mov_rm(r9, rax, 24) + mov_rm(rdx, rax, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r9, rdx) + mov_rm(r8, r15, 0 - 8) + mov_mr(r9, 0, r8) + mov_rm(rdx, rax, 0) + add_ri32(rdx, 1) + mov_mr(rax, 0, rdx) + jmp_rel32(str_len(found))
    let advance = add_ri32(r8, 8) + add_ri32(r9, 8) + add_ri32(r11, 1)
    let access = mov_rm(rdx, r8, 0)
    let body = if key_is_str {
        let klen = mov_rm(rcx, rax, 0)
        let clen = mov_rm(rdi, rdx, 0)
        let cmpsb_je = lea(rsi, rdx, 8) + lea(rdi, rax, 8) + repe_cmpsb() + je_rel32(str_len(advance) + 5 + str_len(not_found))
        access + mov_rm(rax, r15, 0 - 16) + klen + clen + cmp_rr(rcx, rdi) + jne_rel32(str_len(cmpsb_je)) + cmpsb_je
    } else {
        access + mov_rm(rax, r15, 0 - 16) + cmp_rr(rdx, rax) + je_rel32(str_len(advance) + 5 + str_len(not_found))
    }
    let loop_head = cmp_rr(r11, r10) + jae_rel32(str_len(body) + str_len(advance) + 5)
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(body) + str_len(advance) + 5))
    let post_head = mov_rm(r10, rax, 0) + mov_rm(r8, rax, 16) + mov_rm(r9, rax, 24) + xor_rr(r11, r11)
    let g_min = add_ri32(r10, 4)
    let g_keys = mov_rr(r11, r12) + mov_rm(rsi, rax, 16) + mov_rr(rdi, r11) + mov_rm(rdx, rax, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rr(rdx, r10) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r12, rdx)
    let g_vals = mov_rm(rsi, rax, 24) + mov_rr(rdi, r12) + mov_rr(r9, r12) + mov_rm(rdx, rax, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rr(rdx, r10) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r12, rdx)
    let g_hdr = mov_mr(rax, 8, r10) + mov_mr(rax, 16, r11) + mov_mr(rax, 24, r9)
    let growth = mov_rr(r10, rcx) + add_rr(r10, r10) + test_rr(r10, r10) + jne_rel32(str_len(g_min)) + g_min + g_keys + g_vals + g_hdr
    let head1 = mov_rm(rax, r15, 0 - 24) + mov_rm(rcx, rax, 0) + mov_rm(rdx, rax, 8) + cmp_rr(rcx, rdx) + jne_rel32(str_len(growth))
    head1 + growth + post_head + loop_head + body + advance + back + not_found + found + done
}

// x86gen_delete_map_native: inline code for delete(map, key) -> unit.
// Linear-scans for the key; on hit shifts every later entry down by one
// (memmove-style forward copy) in both arrays and decrements len. Absent
// key is a no-op. Stack in: [callee, map, key] at r15-24, r15-16, r15-8.
// Out: [unit]. Clobbers rax, rcx, rdx, rsi, rdi, r8-r11.
fn x86gen_delete_map_native(key_is_str) {
    let finish = xor_rr(rax, rax) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2)
    let kshift = mov_rr(rsi, r8) + add_ri32(rsi, 8) + mov_rr(rdi, r8) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb()
    let keys_block = mov_rr(rdx, r10) + sub_rr(rdx, r11) + sub_ri32(rdx, 1) + test_rr(rdx, rdx) + jle_rel32(str_len(kshift)) + kshift
    let vshift = mov_rr(rsi, r9) + add_ri32(rsi, 8) + mov_rr(rdi, r9) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb()
    let vals_block = mov_rr(rdx, r10) + sub_rr(rdx, r11) + sub_ri32(rdx, 1) + test_rr(rdx, rdx) + jle_rel32(str_len(vshift)) + vshift
    let len_dec = mov_rm(rax, r15, 0 - 16) + sub_ri32(r10, 1) + mov_mr(rax, 0, r10)
    let found_body = keys_block + vals_block + len_dec
    let not_found = jmp_rel32(str_len(found_body))
    let advance = add_ri32(r8, 8) + add_ri32(r9, 8) + add_ri32(r11, 1)
    let access = mov_rm(rdx, r8, 0)
    let body = if key_is_str {
        let klen = mov_rm(rcx, rax, 0)
        let clen = mov_rm(rdi, rdx, 0)
        let cmpsb_je = lea(rsi, rdx, 8) + lea(rdi, rax, 8) + repe_cmpsb() + je_rel32(str_len(advance) + 5 + str_len(not_found))
        access + mov_rm(rax, r15, 0 - 8) + klen + clen + cmp_rr(rcx, rdi) + jne_rel32(str_len(cmpsb_je)) + cmpsb_je
    } else {
        access + mov_rm(rax, r15, 0 - 8) + cmp_rr(rdx, rax) + je_rel32(str_len(advance) + 5 + str_len(not_found))
    }
    let loop_head = cmp_rr(r11, r10) + jae_rel32(str_len(body) + str_len(advance) + 5)
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(body) + str_len(advance) + 5))
    let head = mov_rm(rax, r15, 0 - 16) + mov_rm(r10, rax, 0) + mov_rm(r8, rax, 16) + mov_rm(r9, rax, 24) + xor_rr(r11, r11)
    head + loop_head + body + advance + back + not_found + found_body + finish
}

// x86gen_keys_map_native: inline code for keys(map) -> [T].
// New list [len][len][elems_ptr] (cap = len) filled by copying the raw
// 8B key slots. Stack in: [callee, map] at r15-16, r15-8. Out: [list].
// Clobbers rax, rcx, rdx, rsi, rdi, r9-r12.
fn x86gen_keys_map_native() {
    let tail = mov_rm(rdx, r11, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_ri32(rdx, 24) + add_rr(r12, rdx) + mov_mr(r15, 0 - 16, r11) + vs_pop_n(1)
    mov_rm(rax, r15, 0 - 8) + mov_rm(rcx, rax, 0) + mov_rr(r11, r12) + mov_mr(r11, 0, rcx) + mov_mr(r11, 8, rcx) + lea(r10, r11, 24) + mov_mr(r11, 16, r10) + mov_rm(rsi, rax, 16) + mov_rr(rdi, r10) + mov_rr(rdx, rcx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + tail
}

// x86gen_map_format_at: convert the map at [r15+off] to its "{k: v, ...}"
// string in place (matches VM format_val; str keys/vals quoted via the
// list formatter's no-escape-expansion convention, ints decimal).
// key_is_str / val_is_str are compile-time flags. Pass 1 sums the length
// into rcx, pass 2 writes through rdi. Clobbers rax, rcx, rdx, rsi, rdi,
// r8-r11. Uses the native stack for digit reversal and the result ptr.
fn x86gen_map_format_at(off, key_is_str, val_is_str) {
    let mb_al = e1(136) + e1(7)
    let mb = fn(c) {
        e1(198) + e1(7) + sb(c)
    }
    let sep1_bytes = add_ri32(rcx, 2)
    let sep1 = test_rr(r11, r11) + je_rel32(str_len(sep1_bytes)) + sep1_bytes
    let key_len = if key_is_str {
        mov_rm(rax, r10, 0) + mov_rm(rsi, rax, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
    } else {
        let dl = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
        let dl_jne = jne_rel32(0 - (str_len(dl) + 6))
        mov_rm(rax, r10, 0) + xor_rr(rsi, rsi) + dl + dl_jne + add_rr(rcx, rsi)
    }
    let colon1 = add_ri32(rcx, 2)
    let val_len = if val_is_str {
        mov_rm(rax, r9, 0) + mov_rm(rsi, rax, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
    } else {
        let dl = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
        let dl_jne = jne_rel32(0 - (str_len(dl) + 6))
        mov_rm(rax, r9, 0) + xor_rr(rsi, rsi) + dl + dl_jne + add_rr(rcx, rsi)
    }
    let advance1 = add_ri32(r11, 1) + add_ri32(r10, 8) + add_ri32(r9, 8)
    let loop1_test = cmp_rr(r11, r8) + jae_rel32(str_len(sep1) + str_len(key_len) + str_len(colon1) + str_len(val_len) + str_len(advance1) + 5)
    let back1 = jmp_rel32(0 - (str_len(loop1_test) + str_len(sep1) + str_len(key_len) + str_len(colon1) + str_len(val_len) + str_len(advance1) + 5))
    let loop1 = loop1_test + sep1 + key_len + colon1 + val_len + advance1 + back1
    let h1 = mov_rm(r9, r15, off) + mov_rm(r8, r9, 0) + mov_rm(r10, r9, 16) + mov_rm(r9, r9, 24) + mov_ri64(rcx, 2) + xor_rr(r11, r11)
    let int2_loop = xor_rr(rdx, rdx) + mov_ri64(rsi, 10) + idiv_r(rsi) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(rcx, 1) + test_rr(rax, rax)
    let int2_loop_jne = jne_rel32(0 - (str_len(int2_loop) + 6))
    let write2_body = pop_r(rax) + mb_al + add_ri32(rdi, 1) + sub_ri32(rcx, 1) + test_rr(rcx, rcx)
    let write2 = write2_body + jne_rel32(0 - (str_len(write2_body) + 6))
    let int2_zero = mb(48) + add_ri32(rdi, 1) + jmp_rel32(str_len(int2_loop) + str_len(int2_loop_jne) + str_len(write2))
    let int_write = mov_rr(rax, rdx) + xor_rr(rcx, rcx) + test_rr(rax, rax) + jne_rel32(str_len(int2_zero)) + int2_zero + int2_loop + int2_loop_jne + write2
    let key_write = if key_is_str {
        let kaddr = mov_rr(rdx, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(rdx, r10) + mov_rm(rax, rdx, 0)
        kaddr + mb(34) + add_ri32(rdi, 1) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
    } else {
        let kaddr = mov_rr(rdx, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(rdx, r10) + mov_rm(rdx, rdx, 0)
        kaddr + int_write
    }
    let colon2 = mb(58) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
    let val_write = if val_is_str {
        let vaddr = mov_rr(rdx, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rm(rcx, r15, off) + mov_rm(rcx, rcx, 24) + add_rr(rdx, rcx) + mov_rm(rax, rdx, 0)
        vaddr + mb(34) + add_ri32(rdi, 1) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
    } else {
        let vaddr = mov_rr(rdx, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rm(rcx, r15, off) + mov_rm(rcx, rcx, 24) + add_rr(rdx, rcx) + mov_rm(rdx, rdx, 0)
        vaddr + int_write
    }
    let sep2_bytes = mb(44) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
    let sep2 = test_rr(r11, r11) + je_rel32(str_len(sep2_bytes)) + sep2_bytes
    let advance2 = add_ri32(r11, 1)
    let loop2_test = cmp_rr(r11, r8) + jae_rel32(str_len(sep2) + str_len(key_write) + str_len(colon2) + str_len(val_write) + str_len(advance2) + 5)
    let back2 = jmp_rel32(0 - (str_len(loop2_test) + str_len(sep2) + str_len(key_write) + str_len(colon2) + str_len(val_write) + str_len(advance2) + 5))
    let loop2 = loop2_test + sep2 + key_write + colon2 + val_write + advance2 + back2
    let alloc_zone = mov_rr(r9, r12) + mov_mr(r9, 0, rcx) + lea(rdi, r9, 8) + add_rr(r12, rcx) + add_ri32(r12, 8) + push_r(r9) + mb(123) + add_ri32(rdi, 1) + xor_rr(r11, r11)
    let reload2 = mov_rm(r10, r15, off) + mov_rm(r8, r10, 0) + mov_rm(r10, r10, 16)
    let endfill = mb(125) + add_ri32(rdi, 1) + pop_r(r9) + mov_mr(r15, off, r9)
    h1 + loop1 + alloc_zone + reload2 + loop2 + endfill
}

// x86gen_record_format_at: convert the record at [r15+off] to its
// "record { f: v, ... }" string in place (matches VM format_val quote=true:
// str fields wrapped in double quotes, int fields decimal; field names are
// compile-time). Pass 1 sums the length into rcx, pass 2 writes through rdi.
// Record layout: [8B n][8B names_enc_off][field0]..[fieldN-1]. Field values
// are str pointers (len at [s], bytes at [s+8]) or raw int64. Clobbers
// rax, rcx, rdx, rsi, rdi, r8-r11.
fn x86gen_record_format_at(off, names, ftypes) {
    let mb_al = e1(136) + e1(7)
    let mb = fn(c) {
        e1(198) + e1(7) + sb(c)
    }
    let int2_loop = xor_rr(rdx, rdx) + mov_ri64(rsi, 10) + idiv_r(rsi) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(rcx, 1) + test_rr(rax, rax)
    let int2_loop_jne = jne_rel32(0 - (str_len(int2_loop) + 6))
    let write2_body = pop_r(rax) + mb_al + add_ri32(rdi, 1) + sub_ri32(rcx, 1) + test_rr(rcx, rcx)
    let write2 = write2_body + jne_rel32(0 - (str_len(write2_body) + 6))
    let int2_zero = mb(48) + add_ri32(rdi, 1) + jmp_rel32(str_len(int2_loop) + str_len(int2_loop_jne) + str_len(write2))
    let int_write = mov_rr(rax, rdx) + xor_rr(rcx, rcx) + test_rr(rax, rax) + jne_rel32(str_len(int2_zero)) + int2_zero + int2_loop + int2_loop_jne + write2
    // pass 1: total length into rcx (prefix "record { " is 9 bytes)
    let mut p1 = mov_rm(r10, r15, off) + lea(r10, r10, 16) + mov_ri64(rcx, 9)
    let mut p1f = ""
    let mut pi = 0
    while pi < len(names) {
        if pi > 0 {
            p1f = p1f + add_ri32(rcx, 2)
        }
        p1f = p1f + add_ri32(rcx, str_len(names[pi]) + 2)
        if ftypes[pi] == "str" {
            p1f = p1f + mov_rm(rax, r10, 0) + mov_rm(rsi, rax, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
        } else {
            let dl = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
            let dl_jne = jne_rel32(0 - (str_len(dl) + 6))
            p1f = p1f + mov_rm(rax, r10, 0) + xor_rr(rsi, rsi) + dl + dl_jne + add_rr(rcx, rsi)
        }
        p1f = p1f + add_ri32(r10, 8)
        pi = pi + 1
    }
    // suffix " }" is 2 bytes
    p1f = p1f + add_ri32(rcx, 2)
    // allocate the result string on the heap
    let alloc = mov_rr(r9, r12) + mov_mr(r9, 0, rcx) + lea(rdi, r9, 8) + add_rr(r12, rcx) + add_ri32(r12, 8) + push_r(r9)
    // pass 2: write through rdi, r10 walks the field slots
    let p2h = mov_rm(r10, r15, off) + lea(r10, r10, 16)
    let mut p2f = ""
    let pre = "record " + chr(123) + " "
    let mut pb = 0
    while pb < str_len(pre) {
        p2f = p2f + mb(byte_at(pre, pb)) + add_ri32(rdi, 1)
        pb = pb + 1
    }
    let mut qi = 0
    while qi < len(names) {
        if qi > 0 {
            p2f = p2f + mb(44) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
        }
        let mut nb = 0
        while nb < str_len(names[qi]) {
            p2f = p2f + mb(byte_at(names[qi], nb)) + add_ri32(rdi, 1)
            nb = nb + 1
        }
        p2f = p2f + mb(58) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
        if ftypes[qi] == "str" {
            p2f = p2f + mov_rm(rax, r10, 0) + mb(34) + add_ri32(rdi, 1) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
        } else {
            p2f = p2f + mov_rm(rdx, r10, 0) + int_write
        }
        p2f = p2f + add_ri32(r10, 8)
        qi = qi + 1
    }
    p2f = p2f + mb(32) + add_ri32(rdi, 1) + mb(125) + add_ri32(rdi, 1)
    let p2t = pop_r(r9) + mov_mr(r15, off, r9)
    p1 + p1f + alloc + p2h + p2f + p2t
}

// x86gen_record_eq: deep-compare the two records at [r15-16] and [r15-8]
// (matches VM eq_val for ot_record: equal field count and per-field deep
// equality). Str fields compare length + bytes; other fields raw int64.
// Result bool written to [r15-16], one slot popped. Clobbers rax, rcx,
// rdx, rsi, rdi, r8-r11. r11 accumulates the per-field AND.
fn x86gen_record_eq(ftypes) {
    let mut body = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_ri64(r11, 1)
    body = body + mov_rm(rax, r9, 0) + mov_rm(rcx, r10, 0) + xor_rr(rdx, rdx) + cmp_rr(rax, rcx) + sete(rdx) + and_rr(r11, rdx)
    let mut fi = 0
    while fi < len(ftypes) {
        if ftypes[fi] == "str" {
            let sbody = lea(rsi, rsi, 8) + lea(rdi, rdi, 8) + mov_rr(rcx, rdx) + repe_cmpsb() + sete(rax)
            body = body + mov_rm(rsi, r9, 16 + 8 * fi) + mov_rm(rdi, r10, 16 + 8 * fi) + mov_rm(rdx, rsi, 0) + mov_rm(r8, rdi, 0) + xor_rr(rax, rax) + cmp_rr(rdx, r8) + jne_rel32(str_len(sbody)) + sbody + and_rr(r11, rax)
        } else {
            body = body + mov_rm(rax, r9, 16 + 8 * fi) + mov_rm(rcx, r10, 16 + 8 * fi) + xor_rr(rdx, rdx) + cmp_rr(rax, rcx) + sete(rdx) + and_rr(r11, rdx)
        }
        fi = fi + 1
    }
    let done = mov_mr(r15, 0 - 16, r11) + vs_pop_n(1)
    body + done
}

// x86gen_range_native: inline code for range(start, end) -> [int].
// Allocates a list [start, start+1, ..., end-1] on the heap.
// Stack in: [callee, start, end] at r15-24, r15-16, r15-8. Stack out: [list_ptr].
fn x86gen_range_native() {
    let fill_loop = mov_mr(rdi, 0, rax) + add_ri32(rdi, 8) + add_ri32(rax, 1) + sub_ri32(r9, 1)
    let fill_jne = jne_rel32(0 - (str_len(fill_loop) + 6))
    let fill_all = fill_loop + fill_jne
    mov_rm(r8, r15, 0 - 16) + mov_rm(r9, r15, 0 - 8) + mov_rr(rax, r9) + sub_rr(rax, r8) + mov_rr(rcx, rax) + mov_rr(r11, r12) + mov_mr(r11, 0, rcx) + mov_mr(r11, 8, rcx) + lea(r10, r11, 24) + mov_mr(r11, 16, r10) + test_rr(rcx, rcx) + je_rel32(str_len(fill_all)) + mov_rr(rdi, r10) + mov_rr(rax, r8) + mov_rr(r9, rcx) + fill_all + mov_rr(r10, rcx) + mov_ri32(rcx, 3) + shl_rcl(r10) + add_ri32(r10, 24) + add_rr(r10, r11) + mov_rr(r12, r10) + vs_pop_n(3) + vs_push(r11)
}

// x86gen_start: program entry. nfn = number of functions.
// Layout: [funcs][jumptable 8*nfn][_start]. The lea reaches back past
// itself (7 bytes) and past the jump table (8*nfn) to the table base.
fn x86gen_start(nfn, n_globals) {
    // lea must be first: its RIP-relative offset assumes position 0 in _start
    lea_rip_rel32(r13, 0 - 8 * nfn - 7) + mov_ri64(rdi, 0) + mov_ri64(rsi, 16777216) + mov_ri64(rdx, 3) + mov_ri64(r10, 34) + mov_ri64(r8, 0) + mov_ri64(r9, 0) + sys_mov_rax(9) + syscall() + mov_rr(r12, rax) + mov_rr(rbx, r12) + add_ri32(r12, 8 * n_globals) + mov_rr(r15, rsp) + sub_ri32(r15, 1048576) + mov_rr(r14, r15) + vs_push_zero() + mov_rm(rax, r13, 0) + call_r(rax) + xor_rr(rdi, rdi) + sys_mov_rax(60) + syscall()
    // mmap(0, 16MB, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, 0, 0) -> r12

    // globals array: rbx = heap base, bump r12 past it (zero-filled by mmap)
}

// x86gen_program_to_buf: compile a program to a self-contained ELF64
// static executable (byte string). Takes the 10 Compiled-variant
// fields; no line tables (Phase 1 has no source debug info).
pub fn x86gen_program_to_buf(f_name, _f_file, f_arity, f_nupvals, f_code, _f_spans, f_consts, _en_qual, _en_vnames, _en_varities) {
    fn read_u16(code, at) {
        code[at] * 256 + code[at + 1]
    }
    fn const_str(fh, idx) {
        match f_consts[fh][idx] {
            lib.CVal.CStr(s) => s,
            _ => "",
        }
    }
    fn fn_const(fh, idx) {
        match f_consts[fh][idx] {
            lib.CVal.CFn(sub) => sub,
            _ => 0,
        }
    }
    // inst_len: bytecode length of the instruction at ip (copied from
    // cgen.bur; needed to walk the stream correctly even for opcodes
    // Phase 1 never emits).
    fn inst_len(fh, code, ip) {
        let op = code[ip]
        if op == lib.op_const || op == lib.op_get_local || op == lib.op_set_local || op == lib.op_get_global || op == lib.op_def_global || op == lib.op_set_global || op == lib.op_get_upval || op == lib.op_set_upval || op == lib.op_jump || op == lib.op_jump_if_false || op == lib.op_jump_if_true || op == lib.op_jump_if_false_pop || op == lib.op_loop || op == lib.op_list || op == lib.op_chan_next || op == lib.op_get_field_name {
            3
        } else if op == lib.op_pop_n || op == lib.op_call || op == lib.op_spawn || op == lib.op_end_block || op == lib.op_test_variant || op == lib.op_get_field {
            2
        } else if op == lib.op_record || op == lib.op_record_update {
            4
        } else if op == lib.op_closure {
            3 + f_nupvals[fn_const(fh, read_u16(code, ip + 1))] * 3
        } else if op == lib.op_select {
            let n_arms = code[ip + 1]
            let has_default = code[ip + 2] != 0
            3 + n_arms * 3 + (if has_default {
                2
            } else {
                0
            })
        } else {
            1
        }
    }
    // jump_targets: collect the set of IPs that are jump destinations
    // (copied from cgen.bur; used only for labels, which x86 does not
    // need — kept for parity / future use).
    fn jump_targets(fh) {
        let code = f_code[fh]
        let mut targets = map()
        let mut ip = 0
        while ip < len(code) {
            let op = code[ip]
            if op == lib.op_jump || op == lib.op_jump_if_false || op == lib.op_jump_if_true || op == lib.op_jump_if_false_pop {
                put(targets, ip + 3 + read_u16(code, ip + 1), true)
                ip = ip + 3
            } else if op == lib.op_loop {
                put(targets, ip + 3 - read_u16(code, ip + 1), true)
                ip = ip + 3
            } else if op == lib.op_chan_next {
                put(targets, ip + 3 + read_u16(code, ip + 1), true)
                ip = ip + 3
            } else if op == lib.op_select {
                let mut p = ip + 1
                let n_arms = code[p]
                let has_default = code[p + 1] != 0
                p = p + 2
                let mut i = 0
                while i < n_arms {
                    p = p + 1
                    put(targets, p + 2 + read_u16(code, p), true)
                    p = p + 2
                    i = i + 1
                }
                if has_default {
                    put(targets, p + 2 + read_u16(code, p), true)
                    p = p + 2
                }
                ip = p
            } else {
                ip = ip + inst_len(fh, code, ip)
            }
        }
        targets
    }
    // count_locals: max local slot referenced (+1) for frame sizing.
    fn count_locals(fh) {
        let code = f_code[fh]
        let mut max_slot = f_arity[fh]
        let mut ip = 0
        while ip < len(code) {
            let op = code[ip]
            if op == lib.op_get_local || op == lib.op_set_local {
                let slot = read_u16(code, ip + 1)
                if slot > max_slot {
                    max_slot = slot
                }
            }
            ip = ip + inst_len(fh, code, ip)
        }
        max_slot + 1
    }
    // find_fn_by_name: linear-search the function arena for a name.
    fn find_fn_by_name(name) {
        let mut i = 0
        while i < len(f_name) {
            if f_name[i] == name {
                return i
            }
            i = i + 1
        }
        0 - 1
    }
    // shadow_pop: remove the last n entries from the shadow list.
    fn shadow_pop(mut lst, n) {
        let mut k = 0
        while k < n && len(lst) > 0 {
            pop(lst)
            k = k + 1
        }
    }
    // ---- map/list type helpers (shared by the prescan fixpoint and emit).
    // Type strings: "int" "str" "bool" "unit" "list" "list-str" "list-int"
    // "map" "map-str" "map-int" "map-str-int" "map-str-str" "map-int-int"
    // "map-int-str" "enum" "record" "" (unknown). Higher specificity wins
    // when merging (e.g. "map-str-int" beats "map" at a call site).
    fn type_specificity(t) {
        if t == "" {
            0
        } else if t == "map" {
            1
        } else if t == "map-str" || t == "map-int" {
            2
        } else if str_len(t) > 4 && substr(t, 0, 4) == "map-" {
            3
        } else {
            4
        }
    }
    fn is_more_specific(a, b) {
        type_specificity(a) > type_specificity(b)
    }
    fn is_map_type(t) {
        str_len(t) >= 3 && substr(t, 0, 3) == "map"
    }
    fn map_key_type(t) {
        if t == "map-str" || t == "map-str-int" || t == "map-str-str" {
            "str"
        } else if t == "map-int" || t == "map-int-str" || t == "map-int-int" {
            "int"
        } else {
            ""
        }
    }
    fn map_val_type(t) {
        if t == "map-str-int" || t == "map-int-int" {
            "int"
        } else if t == "map-str-str" || t == "map-int-str" {
            "str"
        } else {
            ""
        }
    }
    fn refine_map_type(k, v) {
        if k == "" {
            "map"
        } else if v == "" {
            "map-" + k
        } else {
            "map-" + k + "-" + v
        }
    }
    fn refine_map_arg(arg_t, k, v) {
        if arg_t == "" || is_map_type(arg_t) {
            let cur_k = map_key_type(arg_t)
            let cur_v = map_val_type(arg_t)
            let new_k = if k != "" {
                k
            } else {
                cur_k
            }
            let new_v = if v != "" {
                v
            } else {
                cur_v
            }
            refine_map_type(new_k, new_v)
        } else {
            arg_t
        }
    }
    // Records track their field schema ("record:<enc>") so field access,
    // formatting and equality can resolve per-field types. "record" alone
    // means the schema is unknown (e.g. a cross-function opaque record).
    fn is_record_type(t) {
        t == "record" || str_len(t) >= 7 && substr(t, 0, 7) == "record:"
    }
    fn record_schema(t) {
        if str_len(t) >= 7 && substr(t, 0, 7) == "record:" {
            substr(t, 7, str_len(t) - 7)
        } else {
            ""
        }
    }
    // merge_type: combine a known type into an existing slot type, keeping
    // the most specific information (maps refine; others just replace).
    fn merge_type(cur, new) {
        if cur == "" {
            new
        } else if new == "" {
            cur
        } else if is_map_type(cur) || is_map_type(new) {
            refine_map_arg(cur, map_key_type(new), map_val_type(new))
        } else {
            new
        }
    }
    // merge_pos: slot type tracking for a stack position. The position's
    // current value may have changed type (e.g. a popped call result left
    // "unit" behind), so only keep the old type when the new one is the same
    // generic map and the old one is a refined version of it.
    fn merge_pos(pcur, pnew) {
        if pcur == "" || pnew == pcur {
            pnew
        } else if is_map_type(pcur) && is_map_type(pnew) {
            refine_map_arg(pcur, map_key_type(pnew), map_val_type(pnew))
        } else {
            pnew
        }
    }

    let nfn = len(f_name)
    // Collect address-taken constants into a data section emitted before the
    // code, so addresses are known during codegen (no patching). Strings are
    // stored as [8-byte length][content bytes], padded to 8-byte alignment;
    // enum metadata/constructors use the raw layouts from SPEC §6.7.
    let mut const_data = ""
    let mut const_slot_map = map()
    let mut enum_const_map = map()
    fn const_slot_key(f, i) {
        f * 100000 + i
    }
    fn enum_const_key(cv) {
        match cv {
            lib.CVal.CEnumType(eh) => "e:" + str(eh),
            lib.CVal.CSingleton(eh, vi) => "s:" + str(eh) + ":" + str(vi),
            lib.CVal.CCtor(eh, vi) => "c:" + str(eh) + ":" + str(vi),
            _ => "",
        }
    }
    fn enum_const_bytes(cv) {
        match cv {
            lib.CVal.CEnumType(eh) => e8(eh),
            lib.CVal.CSingleton(eh, vi) => e8(eh) + e8(vi),
            lib.CVal.CCtor(eh, vi) => e8s(0 - 1) + e8(eh) + e8(vi),
            _ => "",
        }
    }
    let mut sf = 0
    while sf < nfn {
        let consts = f_consts[sf]
        let mut ci = 0
        while ci < len(consts) {
            match consts[ci] {
                lib.CVal.CStr(s) => {
                    let key = const_slot_key(sf, ci)
                    let dup = match get(const_slot_map, key) {
                        Some(_) => true,
                        None => false,
                    }
                    if !dup {
                        put(const_slot_map, key, str_len(const_data))
                        const_data = const_data + e8(str_len(s)) + s
                        while str_len(const_data) % 8 != 0 {
                            const_data = const_data + byte_chr(0)
                        }
                    }
                },
                lib.CVal.CEnumType(_) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                lib.CVal.CSingleton(_, _) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                lib.CVal.CCtor(_, _) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                _ => {},
            }
            ci = ci + 1
        }
        sf = sf + 1
    }
    let _ = str_len(const_data)
    // Pre-scan for record names_enc strings: collect the subset of CStr
    // constants that are referenced by RECORD / RECORD_UPDATE opcodes.
    // Each names_enc encodes field names separated by '\n'.
    let mut record_encs = [] // parallel lists: names_enc string + its const_data offset
    let mut record_offs = []
    fn add_record_enc(enc) {
        let mut i = 0
        while i < len(record_encs) {
            if record_encs[i] == enc {
                return
            }
            i = i + 1
        }
        push(record_encs, enc)
        push(record_offs, str_len(const_data))
        const_data = const_data + enc
        while str_len(const_data) % 8 != 0 {
            const_data = const_data + byte_chr(0)
        }
    }
    let mut rf = 0
    while rf < nfn {
        let rcode = f_code[rf]
        let mut rip = 0
        while rip < len(rcode) {
            let rop = rcode[rip]
            if rop == lib.op_record || rop == lib.op_record_update {
                let cidx = read_u16(rcode, rip + 2)
                let enc = const_str(rf, cidx)
                if str_len(enc) > 0 {
                    add_record_enc(enc)
                }
            }
            rip = rip + inst_len(rf, rcode, rip)
        }
        rf = rf + 1
    }
    // enc -> [field type strings] in field order, populated at RECORD
    // construction (both the prescan and the emit passes).
    let mut record_field_types = map()
    // enc_names: split a names_enc ("f1\nf2\n") into the field name list.
    fn enc_names(enc) {
        let mut names = []
        let mut pos = 0
        while pos < str_len(enc) {
            let rest = substr(enc, pos, str_len(enc) - pos)
            match str_index_of(rest, "\n") {
                None => {
                    if str_len(rest) > 0 {
                        push(names, rest)
                    }
                    pos = str_len(enc)
                },
                Some(nl) => {
                    if nl > 0 {
                        push(names, substr(enc, pos, nl))
                    }
                    pos = pos + nl + 1
                },
            }
        }
        names
    }
    let const_data_len = str_len(const_data)
    fn find_field_in_enc(enc, fname) {
        let mut i = 0
        let mut pos = 0
        while pos < str_len(enc) {
            let rest = substr(enc, pos, str_len(enc) - pos)
            match str_index_of(rest, "\n") {
                None => {
                    if rest == fname {
                        return i
                    }
                    pos = str_len(enc)
                },
                Some(nl) => {
                    let field = substr(enc, pos, nl)
                    if field == fname {
                        return i
                    }
                    pos = pos + nl + 1
                },
            }
            i = i + 1
        }
        0 - 1
    }
    fn const_addr(f, i) {
        match get(const_slot_map, const_slot_key(f, i)) {
            Some(off) => base_addr + 120 + off,
            None => 0,
        }
    }
    // Pre-scan: collect global variable names and assign slots.
    let mut globals_map = map()
    let mut n_globals = 0
    let mut gf = 0
    while gf < nfn {
        let gcode = f_code[gf]
        let mut gip = 0
        while gip < len(gcode) {
            let gop = gcode[gip]
            if gop == lib.op_def_global {
                let gidx = read_u16(gcode, gip + 1)
                let gname = const_str(gf, gidx)
                let exists = match get(globals_map, gname) {
                    Some(_) => true,
                    None => false,
                }
                if !exists {
                    put(globals_map, gname, n_globals)
                    n_globals = n_globals + 1
                }
            }
            gip = gip + inst_len(gf, gcode, gip)
        }
        gf = gf + 1
    }
    // Pre-scan all functions to determine return types (reversed: callees
    // first) and cross-function parameter types. Parameter types are merged
    // forward at call sites and seeded back into caller locals over 4
    // fixpoint rounds, so map types (map -> map-str -> map-str-int) converge
    // even when a callee refines its own params after the caller runs.
    let mut fn_ret_type = []
    let mut rhAlloc = 0
    while rhAlloc < nfn {
        push(fn_ret_type, "")
        rhAlloc = rhAlloc + 1
    }
    let mut fn_param_types = []
    let mut phAlloc = 0
    while phAlloc < nfn {
        let mut plist = []
        let mut piAlloc = 0
        while piAlloc < f_arity[phAlloc] {
            push(plist, "")
            piAlloc = piAlloc + 1
        }
        push(fn_param_types, plist)
        phAlloc = phAlloc + 1
    }
    let mut p_depth_maps = []
    let mut round = 0
    while round < 4 {
        let mut pti = nfn
        p_depth_maps = []
        while pti > 0 {
            let ptfh = pti - 1
            let pcode = f_code[ptfh]
            let mut pshadow_ps = []
            let mut ptshadow_ps = []
            let mut ppos_types = []
            let pa_ps = f_arity[ptfh]
            let mut pseed = 0
            while pseed < pa_ps + 1 {
                push(pshadow_ps, "")
                push(ptshadow_ps, "")
                push(ppos_types, "")
                pseed = pseed + 1
            }
            // seed param slots from the converged cross-function table
            let mut pp = 1
            while pp < pa_ps + 1 {
                if pp - 1 < len(fn_param_types[ptfh]) {
                    ppos_types[pp] = fn_param_types[ptfh][pp - 1]
                }
                pp = pp + 1
            }
            let mut p_depth_at = map()
            let mut pit = 0
            while pit < len(pcode) {
                let pal = match get(p_depth_at, pit) {
                    Some(pd) => pd,
                    None => 0 - 1,
                }
                if pal >= 0 && pcode[pit] != lib.op_no_match {
                    while len(pshadow_ps) > pal {
                        shadow_pop(pshadow_ps, 1)
                    }
                    while len(ptshadow_ps) > pal {
                        shadow_pop(ptshadow_ps, 1)
                    }
                }
                let pop = pcode[pit]
                if pop == lib.op_return {
                    if len(ptshadow_ps) > 0 {
                        fn_ret_type[ptfh] = ptshadow_ps[len(ptshadow_ps) - 1]
                    }
                } else if pop == lib.op_const {
                    let pval = f_consts[ptfh][read_u16(pcode, pit + 1)]
                    push(pshadow_ps, "")
                    match pval {
                        lib.CVal.CStr(_) => {
                            push(ptshadow_ps, "str")
                        },
                        _ => {
                            push(ptshadow_ps, "int")
                        },
                    }
                } else if pop == lib.op_get_local {
                    let pslot = read_u16(pcode, pit + 1)
                    if pslot == 0 {
                        push(pshadow_ps, f_name[ptfh])
                        push(ptshadow_ps, "")
                    } else {
                        push(pshadow_ps, "slot:" + str(pslot))
                        let pstype = if pslot < len(ppos_types) {
                            ppos_types[pslot]
                        } else {
                            "int"
                        }
                        push(ptshadow_ps, pstype)
                    }
                } else if pop == lib.op_set_local {
                    let pslot = read_u16(pcode, pit + 1)
                    if pslot > 0 && len(ptshadow_ps) > 0 {
                        if len(ppos_types) <= pslot {
                            push(ppos_types, "")
                        }
                        ppos_types[pslot] = ptshadow_ps[len(ptshadow_ps) - 1]
                    }
                } else if pop == lib.op_get_global {
                    let pidx = read_u16(pcode, pit + 1)
                    let pname = const_str(ptfh, pidx)
                    push(pshadow_ps, pname)
                    push(ptshadow_ps, "int")
                } else if pop == lib.op_set_global {} else if pop == lib.op_def_global {
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                } else if pop == lib.op_pop {
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                } else if pop == lib.op_pop_n {
                    shadow_pop(pshadow_ps, pcode[pit + 1])
                    shadow_pop(ptshadow_ps, pcode[pit + 1])
                } else if pop == lib.op_end_block {
                    let pn_eb = pcode[pit + 1]
                    let presult = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        "int"
                    }
                    let presname = if len(pshadow_ps) > 0 {
                        pshadow_ps[len(pshadow_ps) - 1]
                    } else {
                        ""
                    }
                    shadow_pop(pshadow_ps, pn_eb + 1)
                    shadow_pop(ptshadow_ps, pn_eb + 1)
                    push(pshadow_ps, presname)
                    push(ptshadow_ps, presult)
                } else if pop == lib.op_call {
                    let pn = pcode[pit + 1]
                    let pcallee = if len(pshadow_ps) > pn {
                        pshadow_ps[len(pshadow_ps) - pn - 1]
                    } else {
                        ""
                    }
                    // capture arg types and arg shadows before popping
                    let mut p_arg_t = []
                    let mut p_arg_s = []
                    let mut pca = 0
                    while pca < pn {
                        push(p_arg_t, ptshadow_ps[len(ptshadow_ps) - pn + pca])
                        push(p_arg_s, pshadow_ps[len(pshadow_ps) - pn + pca])
                        pca = pca + 1
                    }
                    shadow_pop(pshadow_ps, pn + 1)
                    shadow_pop(ptshadow_ps, pn + 1)
                    if pcallee == "ctor" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "enum")
                    } else if pcallee == "substr" || pcallee == "chr" || pcallee == "char_at" || pcallee == "byte_chr" || pcallee == "str" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "str")
                    } else if pcallee == "range" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "list-int")
                    } else if pcallee == "map" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "map")
                    } else if pcallee == "keys" {
                        let mk = if pn >= 1 {
                            map_key_type(p_arg_t[0])
                        } else {
                            ""
                        }
                        push(pshadow_ps, "")
                        if mk == "str" {
                            push(ptshadow_ps, "list-str")
                        } else {
                            push(ptshadow_ps, "list-int")
                        }
                    } else if pcallee == "put" || pcallee == "get" || pcallee == "delete" {
                        // refine the map argument from its key (and val for put)
                        let mt = if pn >= 1 {
                            p_arg_t[0]
                        } else {
                            ""
                        }
                        let kt = if pn >= 2 {
                            p_arg_t[1]
                        } else {
                            ""
                        }
                        let vt = if pcallee == "put" && pn >= 3 {
                            p_arg_t[2]
                        } else {
                            ""
                        }
                        let refined = if pcallee == "put" {
                            refine_map_arg(mt, kt, vt)
                        } else {
                            refine_map_arg(mt, kt, "")
                        }
                        let mslot = if pn >= 1 {
                            p_arg_s[0]
                        } else {
                            ""
                        }
                        if str_len(mslot) > 5 && substr(mslot, 0, 5) == "slot:" {
                            match parse_int(substr(mslot, 5, str_len(mslot) - 5)) {
                                Some(sn) => {
                                    if sn > 0 {
                                        if len(ppos_types) <= sn {
                                            while len(ppos_types) <= sn {
                                                push(ppos_types, "")
                                            }
                                        }
                                        ppos_types[sn] = merge_type(ppos_types[sn], refined)
                                        if sn <= pa_ps {
                                            fn_param_types[ptfh][sn - 1] = merge_type(fn_param_types[ptfh][sn - 1], refined)
                                        }
                                    }
                                },
                                None => {},
                            }
                        }
                        push(pshadow_ps, "")
                        if pcallee == "get" {
                            push(ptshadow_ps, "enum")
                        } else {
                            push(ptshadow_ps, "unit")
                        }
                    } else if pcallee == "split" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "list-str")
                    } else if pcallee == "concat" || pcallee == "slice" {
                        let clt = if pn >= 1 {
                            p_arg_t[0]
                        } else {
                            "list"
                        }
                        push(pshadow_ps, "")
                        push(ptshadow_ps, clt)
                    } else {
                        let phandle = find_fn_by_name(pcallee)
                        if phandle >= 0 {
                            // forward: merge call-site arg types into callee params
                            let mut pff = 0
                            while pff < pn && pff < len(fn_param_types[phandle]) {
                                fn_param_types[phandle][pff] = merge_type(fn_param_types[phandle][pff], p_arg_t[pff])
                                pff = pff + 1
                            }
                            // backward: refine caller slots from callee params
                            let mut pbb = 0
                            while pbb < pn && pbb < len(fn_param_types[phandle]) {
                                let bslot = p_arg_s[pbb]
                                let ctype = fn_param_types[phandle][pbb]
                                if str_len(bslot) > 5 && substr(bslot, 0, 5) == "slot:" {
                                    match parse_int(substr(bslot, 5, str_len(bslot) - 5)) {
                                        Some(sn) => {
                                            if sn > 0 {
                                                if len(ppos_types) <= sn {
                                                    while len(ppos_types) <= sn {
                                                        push(ppos_types, "")
                                                    }
                                                }
                                                ppos_types[sn] = merge_type(ppos_types[sn], ctype)
                                            }
                                        },
                                        None => {},
                                    }
                                }
                                pbb = pbb + 1
                            }
                            if fn_ret_type[phandle] != "" {
                                push(pshadow_ps, "")
                                push(ptshadow_ps, fn_ret_type[phandle])
                            } else {
                                push(pshadow_ps, "")
                                push(ptshadow_ps, "int")
                            }
                        } else {
                            push(pshadow_ps, "")
                            push(ptshadow_ps, "int")
                        }
                    }
                } else if pop == lib.op_closure {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "")
                } else if pop == lib.op_get_upval {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "")
                } else if pop == lib.op_jump {
                    put(p_depth_at, pit + 3 + read_u16(pcode, pit + 1), len(pshadow_ps))
                } else if pop == lib.op_loop {
                    put(p_depth_at, pit + 3 - read_u16(pcode, pit + 1), len(pshadow_ps))
                } else if pop == lib.op_jump_if_false || pop == lib.op_jump_if_true {
                    put(p_depth_at, pit + 3 + read_u16(pcode, pit + 1), len(pshadow_ps))
                } else if pop == lib.op_jump_if_false_pop {
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                    put(p_depth_at, pit + 3 + read_u16(pcode, pit + 1), len(pshadow_ps))
                } else if pop == lib.op_chan_next {
                    put(p_depth_at, pit + 3 + read_u16(pcode, pit + 1), len(pshadow_ps) - 1)
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "int")
                } else if pop == lib.op_neg {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "int")
                } else if pop == lib.op_not {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "bool")
                } else if pop == lib.op_true {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "bool")
                } else if pop == lib.op_false {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "bool")
                } else if pop == lib.op_unit {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "unit")
                } else if pop == lib.op_eq || pop == lib.op_neq || pop == lib.op_gt || pop == lib.op_gt_eq || pop == lib.op_lt || pop == lib.op_lt_eq {
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "bool")
                } else if pop == lib.op_add {
                    let add_last = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    let add_prev = if len(ptshadow_ps) > 1 {
                        ptshadow_ps[len(ptshadow_ps) - 2]
                    } else {
                        ""
                    }
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    if add_last == "str" || add_prev == "str" {
                        push(ptshadow_ps, "str")
                    } else {
                        push(ptshadow_ps, "int")
                    }
                } else if pop == lib.op_sub || pop == lib.op_mul || pop == lib.op_div || pop == lib.op_mod {
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "int")
                } else if pop == lib.op_list {
                    let plen = read_u16(pcode, pit + 1)
                    let pelt = if plen > 0 && len(ptshadow_ps) >= 1 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    shadow_pop(pshadow_ps, plen)
                    shadow_pop(ptshadow_ps, plen)
                    push(pshadow_ps, "")
                    if pelt == "str" {
                        push(ptshadow_ps, "list-str")
                    } else {
                        push(ptshadow_ps, "list-int")
                    }
                } else if pop == lib.op_index_get {
                    let plt = if len(ptshadow_ps) >= 2 {
                        ptshadow_ps[len(ptshadow_ps) - 2]
                    } else {
                        ""
                    }
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    if plt == "list-str" || plt == "str" {
                        push(ptshadow_ps, "str")
                    } else {
                        push(ptshadow_ps, "int")
                    }
                } else if pop == lib.op_index_set {
                    shadow_pop(pshadow_ps, 3)
                    shadow_pop(ptshadow_ps, 3)
                } else if pop == lib.op_len {
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "int")
                } else if pop == lib.op_record {
                    let prec_n = pcode[pit + 1]
                    let prec_cidx = read_u16(pcode, pit + 2)
                    let prec_enc = const_str(ptfh, prec_cidx)
                    let mut prec_ft = []
                    let mut prec_i = 0
                    while prec_i < prec_n {
                        push(prec_ft, ptshadow_ps[len(ptshadow_ps) - prec_n + prec_i])
                        prec_i = prec_i + 1
                    }
                    put(record_field_types, prec_enc, prec_ft)
                    shadow_pop(pshadow_ps, prec_n)
                    shadow_pop(ptshadow_ps, prec_n)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "record:" + prec_enc)
                } else if pop == lib.op_test_variant {
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "int")
                } else if pop == lib.op_no_match {
                    // Never executes at runtime (exhaustive matches); keep it
                    // fully inert: no depth restore above, no stack effect, no
                    // type merge below, so the linear walk carries the last
                    // arm's block value type through to the match-end merge.
                } else if pop == lib.op_get_field_name || pop == lib.op_get_field {
                    let pg_rt = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    let mut pg_field_t = "int"
                    if is_record_type(pg_rt) {
                        let pg_schema = record_schema(pg_rt)
                        let mut pg_idx = -1
                        if pop == lib.op_get_field_name {
                            let pg_cidx = read_u16(pcode, pit + 1)
                            let pg_name = const_str(ptfh, pg_cidx)
                            let mut pg_ei = 0
                            while pg_ei < len(record_encs) && pg_idx < 0 {
                                pg_idx = find_field_in_enc(record_encs[pg_ei], pg_name)
                                pg_ei = pg_ei + 1
                            }
                        } else {
                            pg_idx = pcode[pit + 1]
                        }
                        match get(record_field_types, pg_schema) {
                            Some(pg_ft) => {
                                if pg_idx >= 0 && pg_idx < len(pg_ft) {
                                    if pg_ft[pg_idx] == "str" {
                                        pg_field_t = "str"
                                    }
                                }
                            },
                            None => {},
                        }
                    }
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, pg_field_t)
                } else if pop == lib.op_record_update {
                    let pu_cidx = read_u16(pcode, pit + 2)
                    let pu_enc = const_str(ptfh, pu_cidx)
                    let pu_base = if len(ptshadow_ps) > pcode[pit + 1] {
                        ptshadow_ps[len(ptshadow_ps) - pcode[pit + 1] - 1]
                    } else {
                        "record"
                    }
                    shadow_pop(pshadow_ps, pcode[pit + 1] + 1)
                    shadow_pop(ptshadow_ps, pcode[pit + 1] + 1)
                    push(pshadow_ps, "")
                    if is_record_type(pu_base) {
                        push(ptshadow_ps, pu_base)
                    } else {
                        push(ptshadow_ps, "record:" + pu_enc)
                    }
                } else if pop == lib.op_spawn || pop == lib.op_select {
                    // conservative: assume these don't affect return type
                }
                if pop != lib.op_no_match && len(ptshadow_ps) > 0 {
                    let pdepth = len(ptshadow_ps) - 1
                    while len(ppos_types) <= pdepth {
                        push(ppos_types, "")
                    }
                    ppos_types[pdepth] = merge_pos(ppos_types[pdepth], ptshadow_ps[len(ptshadow_ps) - 1])
                }
                pit = pit + inst_len(ptfh, pcode, pit)
            }
            push(p_depth_maps, p_depth_at)
            pti = pti - 1
        }
        round = round + 1
    }

    let mut funcs_bytes = ""
    let mut func_offsets = []
    let mut fh = 0
    while fh < nfn {
        push(func_offsets, str_len(funcs_bytes))
        let code = f_code[fh]
        let arity = f_arity[fh]
        let locals = count_locals(fh)

        // Per-function mutable state captured by emit_inst.
        let mut out = []
        let mut patches = []
        let mut shadow = []
        let mut type_shadow = []
        let mut global_type = map()
        let mut pos_types = []
        let mut seed = 0
        while seed < arity + 1 {
            push(shadow, "")
            push(type_shadow, "")
            push(pos_types, "")
            seed = seed + 1
        }
        // seed param slots from the converged cross-function table so map
        // natives see refined map types inside the callee body
        let mut pseed_e = 1
        while pseed_e < arity + 1 {
            if pseed_e - 1 < len(fn_param_types[fh]) {
                pos_types[pseed_e] = fn_param_types[fh][pseed_e - 1]
            }
            pseed_e = pseed_e + 1
        }
        let mut ip_to_byte = map()
        fn w(s) {
            push(out, s)
        }
        fn cur_byte() {
            str_len(join(out, ""))
        }

        fn emit_inst(ip) {
            let op = code[ip]
            if op == lib.op_const {
                let idx = read_u16(code, ip + 1)
                match f_consts[fh][idx] {
                    lib.CVal.CInt(v) => w(rex(1, 0, 0, rax) + e1(184) + e8s(v) + vs_push(rax)),
                    lib.CVal.CStr(_) => w(mov_ri64(rax, const_addr(fh, idx)) + vs_push(rax)),
                    lib.CVal.CEnumType(_) => w(mov_ri64(rax, const_addr(fh, idx)) + vs_push(rax)),
                    lib.CVal.CSingleton(_, _) => w(mov_ri64(rax, const_addr(fh, idx)) + vs_push(rax)),
                    lib.CVal.CCtor(_, _) => w(mov_ri64(rax, const_addr(fh, idx)) + vs_push(rax)),
                    _ => w(int3()),
                }
                match f_consts[fh][idx] {
                    lib.CVal.CStr(_) => {
                        push(shadow, "str")
                        push(type_shadow, "str")
                    },
                    lib.CVal.CEnumType(_) => {
                        push(shadow, "enumtype")
                        push(type_shadow, "enumtype")
                    },
                    lib.CVal.CSingleton(_, _) => {
                        push(shadow, "enum")
                        push(type_shadow, "enum")
                    },
                    lib.CVal.CCtor(_, _) => {
                        push(shadow, "ctor")
                        push(type_shadow, "ctor")
                    },
                    _ => {
                        push(shadow, "")
                        push(type_shadow, "int")
                    },
                }
            } else if op == lib.op_unit {
                w(vs_push_zero())
                push(shadow, "")
                push(type_shadow, "unit")
            } else if op == lib.op_true {
                w(e1(73) + e1(199) + modrm(0, 0, r15) + e4(1) + add_ri32(r15, 8))
                push(shadow, "")
                push(type_shadow, "bool")
            } else if op == lib.op_false {
                w(vs_push_zero())
                push(shadow, "")
                push(type_shadow, "bool")
