// is_unimpl_native 判断 native 是否未实现（发射 int3）/ is_unimpl_native tells whether a native is unimplemented (emits int3)
fn is_unimpl_native(name) {
    name == "args" || name == "clock" || name == "close" || name == "exec" || name == "exec_poll" || name == "exec_start" || name == "file_exists" || name == "float_bits" || name == "gc" || name == "gc_cycles" || name == "heap_objects" || name == "net_close" || name == "net_nb" || name == "net_read" || name == "net_write" || name == "parse_float" || name == "read_dir" || name == "read_file" || name == "read_stdin" || name == "recv" || name == "sleep" || name == "stdin_nb" || name == "tcp_accept" || name == "tcp_dial" || name == "tcp_listen" || name == "to_float" || name == "trunc" || name == "type_of" || name == "write_file" || name == "yield" || name == "chan"
}

// x86gen_ord_native 内联 ord：解码首码点（1-4 字节 UTF-8）/
// x86gen_ord_native inlines ord: decode the first codepoint (1-4 byte UTF-8)
// ord inline: decode the first code point (1-4 byte UTF-8)
fn x86gen_ord_native() {
    let pre = mov_rm(rcx, r15, 0 - 8) + lea(rsi, rcx, 8) + xor_rr(rax, rax) + e1(172)
    let t_ascii = mov_rr(rdx, rax) + mov_ri64(r9, 128) + and_rr(rdx, r9)
    let t_2 = mov_rr(rdx, rax) + mov_ri64(r9, 224) + and_rr(rdx, r9) + mov_ri64(r9, 192) + cmp_rr(rdx, r9)
    let t_3 = mov_rr(rdx, rax) + mov_ri64(r9, 240) + and_rr(rdx, r9) + mov_ri64(r9, 224) + cmp_rr(rdx, r9)
    let dec_2 = mov_ri64(r9, 31) + and_rr(rax, r9) + mov_ri64(r8, 1)
    let dec_3 = mov_ri64(r9, 15) + and_rr(rax, r9) + mov_ri64(r8, 2)
    let dec_4 = mov_ri64(r9, 7) + and_rr(rax, r9) + mov_ri64(r8, 3)
    let cont_test = test_rr(r8, r8)
    let cont_body = mov_ri64(rcx, 6) + shl_rcl(rax) + mov_rr(r9, rax) + e1(172) + mov_ri64(rcx, 63) + and_rr(rax, rcx) + or_rr(r9, rax) + mov_rr(rax, r9) + sub_ri32(r8, 1)
    let done = mov_mr(r15, 0 - 16, rax) + vs_pop_n(1)
    let cont_back = jmp_rel32(0 - (str_len(cont_test) + 6 + str_len(cont_body) + 5))
    let cont = cont_test + je_rel32(str_len(cont_body) + 5) + cont_body + cont_back
    let try3_jne = jne_rel32(str_len(dec_2) + 5)
    let cont2_jmp = jmp_rel32(str_len(t_3) + 6 + str_len(dec_3) + 5 + str_len(dec_4))
    let try4_jne = jne_rel32(str_len(dec_3) + 5)
    let cont3_jmp = jmp_rel32(str_len(dec_4))
    let ascii_je = je_rel32(str_len(t_2) + 6 + str_len(dec_2) + 5 + str_len(t_3) + 6 + str_len(dec_3) + 5 + str_len(dec_4) + str_len(cont))
    pre + t_ascii + ascii_je + t_2 + try3_jne + dec_2 + cont2_jmp + t_3 + try4_jne + dec_3 + cont3_jmp + dec_4 + cont + done
}

// x86gen_chr_native 内联 chr：UTF-8 编码（1-4 字节码点分派）/
// x86gen_chr_native inlines chr: UTF-8 encoding (1-4 byte codepoint dispatch)
