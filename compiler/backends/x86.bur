// x86gen_net_write_native 内联 net_write：循环 write syscall 直到写完，返回 Result<unit, str>
// x86gen_net_write_native inlines net_write: looping write syscalls until done, returning Result<unit, str>
fn x86gen_net_write_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 16, rdx) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let fail = err_str + err_inst
    let done = ok_inst + jmp_rel32(str_len(fail))
    let w1 = mov_rr(rdx, r10) + neg_r(rdx) + mov_rm(rax, r9, 0) + add_rr(rdx, rax) + mov_rr(rdi, r11) + mov_rr(rsi, r9) + add_rr(rsi, r10) + add_ri32(rsi, 8) + sys_mov_rax(1) + syscall() + test_rr(rax, rax)
    let w3 = add_rr(r10, rax)
    let w2 = jle_rel32(str_len(w3) + 5 + str_len(done) + str_len(fail))
    let loop_check = mov_rm(rdx, r9, 0) + cmp_rr(r10, rdx) + jae_rel32(str_len(w1) + str_len(w2) + str_len(w3) + 5)
    let j_back = jmp_rel32(0 - (str_len(loop_check) + str_len(w1) + str_len(w2) + str_len(w3)))
    let head = mov_rm(r9, r15, 0 - 8) + mov_rm(r11, r15, 0 - 16) + xor_rr(r10, r10) + jmp_rel32(str_len(done))
    head + loop_check + w1 + w2 + w3 + j_back + done + fail
}

