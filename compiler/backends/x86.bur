// x86gen_read_dir_native 内联 read_dir：open/getdents64/close syscall + 名字排序，返回 Result<[str], str>
// x86gen_read_dir_native inlines read_dir: open/getdents64/close syscalls with name sorting, returning Result<[str], str>
// read_dir inline: getdents64 syscalls into a sorted name list
fn x86gen_read_dir_native() {
    // 固定 os error 错误串 + 枚举包装
    // fixed os error string plus enum wrapping
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 16, rcx) + vs_pop_n(1)
    let fail = err_str + err_inst
    // Ok 结果：list 对象在 r11
    // Ok result: list object in r11
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r11) + add_ri32(r12, 24) + mov_mr(r15, 0 - 16, rcx) + vs_pop_n(1)
    let close = sys_mov_rax(3) + syscall()
    // 子序列：is_dotdot（rcx=名字指针 → r9=布尔）、strcmp_lt（rsi/rdi → r8=a<b）、strlen（rcx → rdx=长度）
    // sub-sequences: is_dotdot, strcmp_lt, strlen
    let mov_r9_1 = mov_ri64(r9, 1)
    let is_dotdot = e1(138) + e1(1) + e1(60) + e1(46) + jne_rel32(30) + e1(128) + e1(121) + e1(1) + e1(0) + je_rel32(28) + e1(128) + e1(121) + e1(1) + e1(46) + jne_rel32(10) + e1(128) + e1(121) + e1(2) + e1(0) + je_rel32(8) + xor_rr(r9, r9) + jmp_rel32(str_len(mov_r9_1)) + mov_r9_1
    let setb_r8 = rex(0, 0, 0, r8) + e1(15) + e1(146) + modrm_reg(0, r8)
    let xor_r8 = xor_rr(r8, r8)
    let strcmp_tail = setb_r8 + jmp_rel32(str_len(xor_r8)) + xor_r8
    let movzx_al = movzx_eax_al()
    let test_rax = test_rr(rax, rax)
    let strcmp_head = e1(172) + e1(174) + jne_rel32(str_len(movzx_al) + str_len(test_rax) + 11) + movzx_al + test_rax + je_rel32(5)
    let strcmp_loop = strcmp_head + jmp_rel32(0 - (str_len(strcmp_head) + 5)) + strcmp_tail
    let add_rdx = add_ri32(rdx, 1)
    let strlen_head = mov_rr(rdi, rcx) + xor_rr(rax, rax) + xor_rr(rdx, rdx)
    let strlen_body = e1(174) + je_rel32(str_len(add_rdx) + 5) + add_rdx
    let strlen_loop = strlen_head + strlen_body + jmp_rel32(0 - (str_len(strlen_body) + 5))
    // getdents64 调用：fd=r8, 缓冲=rsp, 8192 字节
    // getdents64 call: fd=r8, buffer=rsp, 8192 bytes
    let getd = mov_rr(rdi, r8) + mov_rr(rsi, rsp) + sys_mov_rdx(8192) + sys_mov_rax(217) + syscall()
    // 地址计算：rax = names 数组基址 + idx*8（idx 槽 [r15-32]，基址槽 [r15-24]）
    // address calc: rax = names base + idx*8
    let addr_idx = mov_rm(rax, r15, 0 - 32) + mov_ri32(rcx, 3) + shl_rcl(rax) + mov_rm(r9, r15, 0 - 24) + add_rr(rax, r9)
    // 收集：单 pass 读目录，非点名字按 strcmp 顺序收集
    // collect: single pass over the directory, gathering non-dot names
    let collect_seq = mov_mr(r15, 0 - 64, rsi) + strlen_loop + mov_rr(r11, r12) + mov_mr(r11, 0, rdx) + lea(rdi, r11, 8) + mov_rr(rsi, rcx) + mov_rr(rcx, rdx) + rep_movsb() + xor_rr(rax, rax) + e1(170) + add_rr(r12, rdx) + add_ri32(r12, 9) + mov_rm(rsi, r15, 0 - 64) + addr_idx + mov_mr(rax, 0, r11) + mov_rm(rax, r15, 0 - 32) + add_ri32(rax, 1) + mov_mr(r15, 0 - 32, rax)
    let inner_tail = mov_rm(rdx, r15, 0 - 40) + add_rr(rsi, rdx)
    let inner_work = mov_rr(rcx, rsp) + add_rr(rcx, rsi) + add_ri32(rcx, 19) + mov_rr(rax, rsp) + add_rr(rax, rsi) + add_ri32(rax, 16) + mov_rm(rdx, rax, 0) + mov_ri64(r9, 65535) + and_rr(rdx, r9) + mov_mr(r15, 0 - 40, rdx) + is_dotdot + test_rr(r9, r9) + jne_rel32(str_len(collect_seq)) + collect_seq + inner_tail
    let inner_cond = mov_rm(rdx, r15, 0 - 16) + cmp_rr(rsi, rdx) + jge_rel32(str_len(inner_work) + 5)
    let inner_loop = inner_cond + inner_work + jmp_rel32(0 - (str_len(inner_cond) + str_len(inner_work) + 5))
    let collect_body = mov_mr(r15, 0 - 16, rax) + xor_rr(rsi, rsi) + inner_loop
    let collect_head = getd + test_rr(rax, rax) + jle_rel32(str_len(collect_body) + 5)
    let collect_loop = collect_head + collect_body + jmp_rel32(0 - (str_len(collect_head) + str_len(collect_body) + 5))
    // 选择排序：names[0..count) 按 strcmp 升序，count=r10，槽 i=[r15-32] min=[r15-40] j=[r15-16]
    // selection sort over names[0..count), count=r10
    let min_store = mov_rm(rax, r15, 0 - 16) + mov_mr(r15, 0 - 40, rax)
    let addr_min = mov_rm(rax, r15, 0 - 40) + mov_ri32(rcx, 3) + shl_rcl(rax) + mov_rm(r9, r15, 0 - 24) + add_rr(rax, r9)
    let cmp_j = mov_rm(rax, r15, 0 - 16) + mov_ri32(rcx, 3) + shl_rcl(rax) + mov_rm(r9, r15, 0 - 24) + add_rr(rax, r9) + mov_rm(r9, rax, 0) + lea(rsi, r9, 8) + addr_min + mov_rm(r9, rax, 0) + lea(rdi, r9, 8) + strcmp_loop + test_rr(r8, r8) + je_rel32(str_len(min_store)) + min_store
    let addr_idx_keep_r9 = mov_rm(rax, r15, 0 - 32) + mov_ri32(rcx, 3) + shl_rcl(rax) + mov_rm(rcx, r15, 0 - 24) + add_rr(rax, rcx)
    let swap_seq = addr_idx + mov_rm(r9, rax, 0) + mov_rm(rax, r15, 0 - 40) + mov_ri32(rcx, 3) + shl_rcl(rax) + mov_rm(rdx, r15, 0 - 24) + add_rr(rax, rdx) + mov_rm(rdx, rax, 0) + addr_idx_keep_r9 + mov_mr(rax, 0, rdx) + mov_rm(rax, r15, 0 - 40) + mov_ri32(rcx, 3) + shl_rcl(rax) + mov_rm(rdx, r15, 0 - 24) + add_rr(rax, rdx) + mov_mr(rax, 0, r9)
    let j_work = cmp_j + mov_rm(rax, r15, 0 - 16) + add_ri32(rax, 1) + mov_mr(r15, 0 - 16, rax)
    let j_cond = mov_rm(rdx, r15, 0 - 16) + cmp_rr(rdx, r10) + jge_rel32(str_len(j_work) + 5)
    let j_loop = j_cond + j_work + jmp_rel32(0 - (str_len(j_cond) + str_len(j_work) + 5))
    let i_work = mov_mr(r15, 0 - 40, rax) + add_ri32(rax, 1) + mov_mr(r15, 0 - 16, rax) + j_loop + swap_seq + mov_rm(rax, r15, 0 - 32) + add_ri32(rax, 1) + mov_mr(r15, 0 - 32, rax)
    let i_cond = mov_rm(rax, r15, 0 - 32) + cmp_rr(rax, r10) + jge_rel32(str_len(i_work) + 5)
    let outer_loop = i_cond + i_work + jmp_rel32(0 - (str_len(i_cond) + str_len(i_work) + 5))
    // 构建 list：把名字 NUL 缓冲拷贝成 str 对象
    // build: copy each name NUL buffer into a str object
    let build_work = addr_idx + mov_mr(r15, 0 - 16, rax) + mov_rm(r9, rax, 0) + mov_rm(rdx, r9, 0) + mov_rr(r11, r12) + mov_mr(r11, 0, rdx) + lea(rdi, r11, 8) + lea(rsi, r9, 8) + mov_rr(rcx, rdx) + rep_movsb() + add_rr(r12, rdx) + add_ri32(r12, 8) + mov_rm(r9, r15, 0 - 40) + mov_rm(r9, r9, 16) + mov_rm(rax, r15, 0 - 32) + mov_ri32(rcx, 3) + shl_rcl(rax) + add_rr(r9, rax) + mov_mr(r9, 0, r11) + mov_rm(rax, r15, 0 - 32) + add_ri32(rax, 1) + mov_mr(r15, 0 - 32, rax)
    let build_cond = mov_rm(rax, r15, 0 - 32) + cmp_rr(rax, r10) + jge_rel32(str_len(build_work) + 5)
    let build_loop = build_cond + build_work + jmp_rel32(0 - (str_len(build_cond) + str_len(build_work) + 5))
    // 主流程拼装
    // main assembly
    let list_alloc = mov_rr(r11, r12) + mov_mr(r11, 0, r10) + mov_mr(r11, 8, r10) + lea(r9, r11, 24) + mov_mr(r11, 16, r9) + add_ri32(r12, 24) + mov_mr(r15, 0 - 40, r11) + mov_rr(rax, r10) + mov_ri32(rcx, 3) + shl_rcl(rax) + add_rr(r12, rax) + xor_rr(rax, rax) + mov_mr(r15, 0 - 32, rax)
    let empty_ok = mov_rr(r11, r12) + xor_rr(rax, rax) + mov_mr(r11, 0, rax) + mov_mr(r11, 8, rax) + lea(r9, r11, 24) + mov_mr(r11, 16, r9) + add_ri32(r12, 24) + ok_inst + jmp_rel32(str_len(fail))
    let build_tail = mov_rm(r11, r15, 0 - 40) + ok_inst + jmp_rel32(str_len(empty_ok) + str_len(fail))
    let main_done = close + add_ri32(rsp, 8192) + mov_rm(r10, r15, 0 - 32) + xor_rr(rax, rax) + mov_mr(r15, 0 - 32, rax) + test_rr(r10, r10) + je_rel32(str_len(list_alloc) + str_len(build_loop) + str_len(build_tail)) + outer_loop + list_alloc + build_loop + build_tail
    let names_alloc = mov_rr(r9, r12) + mov_mr(r15, 0 - 24, r9) + add_ri32(r12, 16384) + xor_rr(rax, rax) + mov_mr(r15, 0 - 32, rax)
    let main_tail = sub_ri32(rsp, 8192) + names_alloc + collect_loop + main_done + empty_ok
    let open_fail = test_rr(rax, rax) + jl_rel32(str_len(main_tail))
    let head = x86gen_nul_path_at(0 - 8) + mov_rr(rdi, r11) + xor_rr(rsi, rsi) + xor_rr(rdx, rdx) + sys_mov_rax(2) + syscall() + mov_rr(r8, rax) + open_fail + main_tail + fail
    head
}

// proc 结构堆布局 / proc struct heap layout: pid, outfd, errfd, failfd, ob_len, eb_len, ob[8192], eb[8192], child_err, have_err, code, complete, consumed
// 默认 PATH 常量（无 PATH 环境变量时）/"PATH" 缺席时回退的默认 PATH
let proc_pid = 0
let proc_outfd = 8
let proc_errfd = 16
let proc_failfd = 24
let proc_ob_len = 32
let proc_eb_len = 40
let proc_ob = 48
let proc_eb = 8240
let proc_child_err = 16432
let proc_have_err = 16440
let proc_code = 16448
let proc_complete = 16456
let proc_consumed = 16464
let proc_size = 16472
let pipe2_nonblock_cloexec = 526336

// x86gen_tuple_format_at 生成 tuple 格式化：(e0, e1, ...)，元素按静态类型展开
// x86gen_tuple_format_at emits tuple formatting: (e0, e1, ...), elements expanded from static types
// tuple formatting: (e0, e1, ...) with per-element static types
fn x86gen_tuple_format_at(off, types) {
    let mb_al = e1(136) + e1(7)
    let mb = fn(c) {
        e1(198) + e1(7) + sb(c)
    }
    let mut l1 = mov_rm(r9, r15, off) + mov_rr(r10, r9) + mov_ri64(rcx, 2)
    let mut i = 0
    while i < len(types) {
        if i > 0 {
            l1 = l1 + add_ri32(rcx, 2)
        }
        let t = types[i]
        if t == "str" {
            l1 = l1 + mov_rm(rax, r10, 8 + 8 * i) + mov_rm(rsi, rax, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
        } else {
            let dl = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
            let dl_jne = jne_rel32(0 - (str_len(dl) + 6))
            l1 = l1 + mov_rm(rax, r10, 8 + 8 * i) + xor_rr(rsi, rsi) + dl + dl_jne + add_rr(rcx, rsi)
        }
        i = i + 1
    }
    let alloc = mov_rr(r9, r12) + mov_mr(r9, 0, rcx) + lea(rdi, r9, 8) + add_rr(r12, rcx) + add_ri32(r12, 8) + mb(40) + add_ri32(rdi, 1)
    let mut l2 = ""
    let mut j = 0
    while j < len(types) {
        if j > 0 {
            l2 = l2 + mb(44) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
        }
        let t2 = types[j]
        if t2 == "str" {
            l2 = l2 + mov_rm(rax, r10, 8 + 8 * j) + mb(34) + add_ri32(rdi, 1) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
        } else {
            let int2_loop = xor_rr(rdx, rdx) + mov_ri64(rsi, 10) + idiv_r(rsi) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(rcx, 1) + test_rr(rax, rax)
            let int2_loop_jne = jne_rel32(0 - (str_len(int2_loop) + 6))
            let write2_body = pop_r(rax) + mb_al + add_ri32(rdi, 1) + sub_ri32(rcx, 1) + test_rr(rcx, rcx)
            let write2 = write2_body + jne_rel32(0 - (str_len(write2_body) + 6))
            let int2_zero = mb(48) + add_ri32(rdi, 1) + jmp_rel32(str_len(int2_loop) + str_len(int2_loop_jne) + str_len(write2))
            l2 = l2 + mov_rm(rax, r10, 8 + 8 * j) + xor_rr(rcx, rcx) + test_rr(rax, rax) + jne_rel32(str_len(int2_zero)) + int2_zero + int2_loop + int2_loop_jne + write2
        }
        j = j + 1
    }
    l2 = l2 + mb(41) + add_ri32(rdi, 1)
    l1 + alloc + l2 + mov_mr(r15, off, r9)
}

// x86gen_defer_loop 生成函数返回时的 defer 链执行（LIFO，闭包无参调用，链头在 [rsp]）/
// x86gen_defer_loop emits the defer-chain execution at function return (LIFO, zero-arg closure calls, head at [rsp])
fn x86gen_defer_loop() {
    let body = mov_rm(r8, rax, 0) + mov_rm(r9, rax, 8) + mov_mr(rsp, 0, r8) + mov_mr(r15, 0, r9) + add_ri32(r15, 8) + mov_rm(rcx, r15, 0 - 8) + mov_rm(rax, rcx, 0) + mov_ri32(rcx, 3) + shl_rcl(rax) + add_rr(rax, r13) + mov_rm(rax, rax, 0) + call_r(rax)
    let loop_head = mov_rm(rax, rsp, 0) + test_rr(rax, rax) + je_rel32(str_len(body) + 5)
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(body) + 5))
    loop_head + body + back
}

// x86gen_err_inst 构造 Err("os error") 实例（rax 返回）/
// x86gen_err_inst builds an Err("os error") instance (returned in rax)
fn x86gen_err_inst() {
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_rr(rax, rcx)
    err_str + err_inst
}

// x86gen_exec_spawn_native 内联 spawn：pipe2×3 + fork，子进程 execvp PATH 解析，父进程建 proc 结构
// x86gen_exec_spawn_native inlines spawn: three pipe2 plus fork, child-side execvp PATH resolution, parent builds the proc struct
// exec spawn inline: pipe2 x3 + fork + child execvp PATH walk
// 输入：[r15-8] = cmd str, [r15-16] = args list；输出：rax = proc 指针（失败 -1）
fn x86gen_exec_spawn_native() {
    // c1 关闭 [rsp+off] 的 fd（pipe2 写 4 字节 int 槽）/ c1 closes the fd at [rsp+off] (pipe2 writes 4-byte int slots)
    let c1 = fn(off) {
        mov_rm32(rdi, rsp, off) + sys_mov_rax(3) + syscall()
    }
    // copy_one：rcx = 源 str，堆上建 NUL 结尾副本，rdx 返回指针（破坏 rcx/rdx/rsi/rdi/r9）
    // copy_one: rcx = source str, builds a NUL-terminated heap copy, rdx returns the pointer (clobbers rcx/rdx/rsi/rdi/r9)
    fn copy_one() {
        let copy = mov_rm(r9, rcx, 0) + mov_rr(rdx, r12) + lea(rsi, rcx, 8) + mov_rr(rdi, rdx) + mov_rr(rcx, r9) + rep_movsb()
        let nul = xor_rr(rax, rax) + e1(136) + e1(7) + add_rr(r12, r9) + add_ri32(r12, 1)
        copy + nul
    }
    // 默认 PATH 缓冲 / the default PATH buffer
    let def_path = "/usr/local/bin:/usr/bin:/bin"
    let mut defb = mov_rr(r8, r12) + add_ri32(r12, 24) + mov_rr(rdi, r8)
    let mut di = 0
    while di < 23 {
        defb = defb + mov_ri64(rax, byte_at(def_path, di)) + e1(136) + e1(7) + add_ri32(rdi, 1)
        di = di + 1
    }
    defb = defb + xor_rr(rax, rax) + e1(136) + e1(7) + mov_mr(rsp, 48, r8)
    // argv 数组（堆，r11）+ 各参数 NUL 副本 / the argv array on the heap (r11) plus per-arg NUL copies
    let argv_alloc = mov_rm(r8, r15, 0 - 8) + mov_rm(r10, r8, 0) + mov_mr(rsp, 40, r10) + add_ri32(r10, 2) + mov_rr(r11, r12) + mov_rr(rdx, r10) + mov_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r12, rdx) + mov_mr(rsp, 32, r11)
    let cmd_copy = mov_rm(rcx, r15, 0 - 16) + copy_one() + mov_mr(r11, 0, rdx)
    let body = mov_rm(rsi, r8, 16) + mov_rr(rax, r10) + mov_ri32(rcx, 3) + shl_rcl(rax) + add_rr(rsi, rax) + mov_rm(rcx, rsi, 0) + copy_one() + mov_rr(rcx, r10) + add_ri32(rcx, 1) + mov_rr(rax, rcx) + mov_ri32(rcx, 3) + shl_rcl(rax) + add_rr(rax, r11) + mov_mr(rax, 0, rdx) + add_ri32(r10, 1)
    let cond = mov_rm(r9, rsp, 40) + cmp_rr(r10, r9) + jge_rel32(str_len(body) + 5)
    let back = jmp_rel32(0 - (str_len(cond) + str_len(body) + 5))
    let argv_loop = xor_rr(r10, r10) + cond + body + back
    let null_tail = mov_rm(r9, rsp, 40) + add_ri32(r9, 1) + mov_rr(rax, r9) + mov_ri32(rcx, 3) + shl_rcl(rax) + add_rr(rax, r11) + xor_rr(rdx, rdx) + mov_mr(rax, 0, rdx)
    // pipe2×3（O_NONBLOCK|O_CLOEXEC）；失败链在 fork 后（f1→f2→f3 逐级关闭），成功跳过
    // three pipe2 calls (O_NONBLOCK|O_CLOEXEC); the failure chain sits after fork_seq, success skips it
    let pipe1 = mov_rr(rdi, rsp) + mov_ri64(rsi, pipe2_nonblock_cloexec) + sys_mov_rax(293) + syscall()
    let pipe2 = lea(rdi, rsp, 8) + mov_ri64(rsi, pipe2_nonblock_cloexec) + sys_mov_rax(293) + syscall()
    let pipe3 = lea(rdi, rsp, 16) + mov_ri64(rsi, pipe2_nonblock_cloexec) + sys_mov_rax(293) + syscall()
    // envp 指针：[rbx-8] = 启动栈，envp = orig + 8*(argc+1)（跳过 argv 的 NULL 结尾）/
    // envp from the startup stack: envp = orig + 8*(argc+1) (past the argv NULL terminator)
    let envp_load = mov_rm(rdx, rbx, 0 - 8) + mov_rm(rcx, rdx, 0) + mov_rr(rax, rcx) + mov_ri32(rcx, 3) + shl_rcl(rax) + add_rr(rdx, rax) + add_ri32(rdx, 16)
    // 失败路径：errno 写 [rsp+88]（4 字节）后写 failp[1] 并 _exit(127)
    // failure path: write errno (4 bytes at [rsp+88]) to failp[1], then _exit(127)
    let fail_write = mov_rm32(rdi, rsp, 20) + lea(rsi, rsp, 60) + sys_mov_rdx(4) + sys_mov_rax(1) + syscall() + sys_mov_rdi(127) + sys_mov_rax(60) + syscall()
    // PATH 环境扫描（"PATH=" 前缀）/ scan the environment for a "PATH=" entry
    let found_seq = lea(r9, r9, 5) + mov_mr(rsp, 48, r9)
    let env_adv = add_ri32(rsi, 8)
    let default_seq = mov_rm(r9, rsp, 48)
    let b5 = rex(0, 0, 0, r9) + e1(128) + e1(121) + e1(4) + e1(61) + jne_rel32(str_len(found_seq))
    let b4 = rex(0, 0, 0, r9) + e1(128) + e1(121) + e1(3) + e1(72) + jne_rel32(str_len(b5) + str_len(found_seq))
    let b3 = rex(0, 0, 0, r9) + e1(128) + e1(121) + e1(2) + e1(84) + jne_rel32(str_len(b4) + str_len(b5) + str_len(found_seq))
    let b2 = rex(0, 0, 0, r9) + e1(128) + e1(121) + e1(1) + e1(65) + jne_rel32(str_len(b3) + str_len(b4) + str_len(b5) + str_len(found_seq))
    let b1 = rex(0, 0, 0, r9) + e1(128) + e1(57) + e1(80) + jne_rel32(str_len(b2) + str_len(b3) + str_len(b4) + str_len(b5) + str_len(found_seq))
    let env_loop_head = mov_rm(r9, rsi, 0) + test_rr(r9, r9) + je_rel32(str_len(b1) + str_len(b2) + str_len(b3) + str_len(b4) + str_len(b5) + str_len(found_seq) + str_len(env_adv) + 5)
    let env_loop_back = jmp_rel32(0 - (str_len(env_loop_head) + str_len(b1) + str_len(b2) + str_len(b3) + str_len(b4) + str_len(b5) + str_len(found_seq) + str_len(env_adv) + 5))
    let env_scan = envp_load + mov_rr(rsi, rdx) + env_loop_head + b1 + b2 + b3 + b4 + b5 + found_seq + env_adv + env_loop_back + default_seq
    // strlen：rdi = 串指针，rdx = 长度 / strlen over a NUL-terminated buffer
    let strlen_add = add_ri32(rdx, 1)
    let strlen_head = mov_rr(rdi, r9) + xor_rr(rax, rax) + xor_rr(rdx, rdx)
    let strlen_body = e1(174) + je_rel32(str_len(strlen_add) + 5) + strlen_add
    let strlen_loop = strlen_head + strlen_body + jmp_rel32(0 - (str_len(strlen_body) + 5))
    let cmd_len_seq = mov_rm(r11, rsp, 32) + mov_rm(r9, r11, 0) + xor_rr(r8, r8) + strlen_loop + mov_rr(r10, rdx)
    // 候选路径构建：dir + "/" + cmd + NUL / candidate path build: dir + "/" + cmd + NUL
    let dir_len = mov_rr(rcx, rdi) + sub_rr(rcx, rsi) + sub_ri32(rcx, 1) + sub_rr(rcx, r8)
    let cand_base = mov_rr(rdx, r12)
    let src_tmp = mov_rr(rax, rsi) + add_rr(rax, r8)
    let r8_next = mov_rr(r8, rdi) + sub_rr(r8, rsi)
    let src = mov_rr(rsi, rax)
    let bump = mov_rr(rax, rcx) + add_rr(rax, r10) + add_ri32(rax, 2) + add_rr(r12, rax)
    let dst = mov_rr(rdi, rdx)
    let copy_dir = rep_movsb()
    let slash = mov_ri64(rax, 47) + e1(136) + e1(7) + add_ri32(rdi, 1)
    let copy_cmd = mov_rr(rsi, r9) + mov_rr(rcx, r10) + rep_movsb()
    let nul = xor_rr(rax, rax) + e1(136) + e1(7) + add_ri32(rdi, 1)
    let save_cand = mov_mr(rsp, 64, rdx)
    let exec_seq = envp_load + mov_rm(rdi, rsp, 64) + mov_rm(rsi, rsp, 32) + sys_mov_rax(59) + syscall()
    let flag_set = mov_ri64(rax, 1) + mov_mr(rsp, 56, rax)
    let eacces = mov_ri64(r9, 0 - 13) + cmp_rr(rax, r9) + jne_rel32(str_len(flag_set)) + flag_set
    let seg_end_body = dir_len + cand_base + src_tmp + r8_next + src + bump + dst + copy_dir + slash + copy_cmd + nul + save_cand + exec_seq + eacces
    let seg_end_len = str_len(seg_end_body) + 5
    // 段扫描：al=58(':')，scasb 终止判定；rdi 指向终止符后 / segment scan with scasb against ':', rdi ends past the terminator
    let nul_chk = e1(128) + e1(127) + sb(0 - 1) + e1(0) + je_rel32(5 + seg_end_len)
    let seg_body = e1(174) + je_rel32(str_len(nul_chk) + 5) + nul_chk
    let scan_back = jmp_rel32(0 - (str_len(seg_body) + 5))
    let seg_head = mov_rm(rsi, rsp, 48) + mov_rm(r11, rsp, 32) + mov_rm(r9, r11, 0) + mov_ri64(rax, 58) + mov_rr(rdi, rsi) + add_rr(rdi, r8)
    let seg_back = jmp_rel32(0 - (str_len(seg_head) + str_len(seg_body) + 5 + str_len(seg_end_body) + 5))
    let seg_end = seg_end_body + seg_back
    // 路径走到头：无 EACCES 记忆 → ENOENT(2)，有 → EACCES(13) / end of PATH: EACCES remembered -> 13, else ENOENT(2)
    let set13 = mov_ri64(rax, 13)
    let path_end = mov_ri64(rax, 2) + mov_rm(rdx, rsp, 56) + test_rr(rdx, rdx) + je_rel32(str_len(set13) + 5) + set13 + mov_mr(rsp, 60, rax)
    let walk = cmd_len_seq + env_scan + seg_head + seg_body + scan_back + seg_end + path_end
    // 直接 execve（含 '/'）失败：写 errno 后走 fail_write / direct execve (cmd contains '/') failure: write errno, then fail_write
    let direct = envp_load + mov_rm(r11, rsp, 32) + mov_rm(rdi, r11, 0) + mov_rm(rsi, rsp, 32) + sys_mov_rax(59) + syscall() + neg_r(rax) + mov_mr(rsp, 60, rax) + jmp_rel32(str_len(walk))
    // 斜杠扫描：'/' → 直接 execve；NUL → PATH 走查 / slash scan: '/' -> direct execve, NUL -> PATH walk
    let nul_je = e1(132) + e1(192) + je_rel32(5 + str_len(direct))
    let slash_body = e1(172) + e1(60) + e1(47) + je_rel32(str_len(nul_je) + 5) + nul_je
    let slash_head = mov_rm(r11, rsp, 32) + mov_rm(rsi, r11, 0)
    let slash_back = jmp_rel32(0 - (str_len(slash_body) + 5))
    // 子进程：dup2 到 1/2，关读端与写端（留 failp[1]），PATH 解析后 execve / child: dup2 to 1/2, close read/write ends (keep failp[1]), PATH-resolve then execve
    let dup1 = mov_rm32(rdi, rsp, 4) + mov_ri64(rsi, 1) + sys_mov_rax(33) + syscall()
    let dup2 = mov_rm32(rdi, rsp, 12) + mov_ri64(rsi, 2) + sys_mov_rax(33) + syscall()
    let child_closes = c1(0) + c1(4) + c1(8) + c1(12) + c1(16)
    let child_seq = dup1 + dup2 + child_closes + slash_head + slash_body + slash_back + direct + walk + fail_write
    // 父进程：关写端，建 proc 结构（失败关读端）/ parent: close write ends, build the proc struct (on failure close read ends)
    let parent_ok = mov_rr(r9, r12) + add_ri32(r12, proc_size) + mov_rm(rax, rsp, 24) + mov_mr(r9, proc_pid, rax) + mov_rm32(rax, rsp, 0) + mov_mr(r9, proc_outfd, rax) + mov_rm32(rax, rsp, 8) + mov_mr(r9, proc_errfd, rax) + mov_rm32(rax, rsp, 16) + mov_mr(r9, proc_failfd, rax) + xor_rr(rax, rax) + mov_mr(r9, proc_ob_len, rax) + mov_mr(r9, proc_eb_len, rax) + mov_mr(r9, proc_child_err, rax) + mov_mr(r9, proc_have_err, rax) + mov_mr(r9, proc_code, rax) + mov_mr(r9, proc_complete, rax) + mov_mr(r9, proc_consumed, rax) + mov_rr(rax, r9)
    let fork_fail = c1(0) + c1(8) + c1(16) + mov_ri64(rax, 0 - 1)
    let parent_seq = mov_mr(rsp, 24, rax) + c1(4) + c1(12) + c1(20) + test_rr(rax, rax) + jl_rel32(str_len(parent_ok) + 5) + parent_ok + jmp_rel32(str_len(fork_fail)) + fork_fail
    let done_seq = add_ri32(rsp, 80)
    let fork_seq = sys_mov_rax(57) + syscall() + test_rr(rax, rax) + jne_rel32(str_len(child_seq)) + child_seq + parent_seq + done_seq
    // 管道失败链：f3 跳过整个 fork 直接回收栈 / pipe failure chain: f3 skips the whole fork and restores the stack
    let f3 = c1(0) + c1(4) + c1(8) + c1(12) + c1(16) + c1(20) + mov_ri64(rax, 0 - 1) + jmp_rel32(str_len(fork_seq) - str_len(done_seq))
    let f2 = c1(0) + c1(4) + c1(8) + c1(12) + f3
    let f1 = c1(0) + c1(4) + f2
    let skip_fail = jmp_rel32(str_len(f1) + str_len(f2) + str_len(f3))
    let p3_fail = test_rr(rax, rax) + jl_rel32(5 + str_len(f1) + str_len(f2))
    let p2_fail = test_rr(rax, rax) + jl_rel32(str_len(pipe3) + 9 + 5 + str_len(f1))
    let p1_fail = test_rr(rax, rax) + jl_rel32(str_len(pipe2) + 9 + str_len(pipe3) + 9 + 5)
    let pipes = pipe1 + p1_fail + pipe2 + p2_fail + pipe3 + p3_fail + skip_fail + f1 + f2 + f3
    sub_ri32(rsp, 80) + defb + argv_alloc + cmd_copy + argv_loop + null_tail + pipes + fork_seq
}

// x86gen_proc_pump 内联排空：failfd/outfd/errfd 非阻塞读，双管 EOF 后 wait4 收尸
// x86gen_proc_pump inlines draining: non-blocking reads of failfd/outfd/errfd, wait4 once both pipes hit EOF
// proc pump inline: r9 = proc 基址（全程保留）
fn x86gen_proc_pump() {
    // 单管排空：读到 EAGAIN 或 EOF；缓冲满则丢弃续读以推进 EOF
    // drain one pipe: read until EAGAIN or EOF; when the buffer is full, keep draining to reach EOF
    fn drain_fd(fd_off, len_off, buf_off) {
        let cap = mov_ri64(r10, 8192) + mov_rm(rdx, r9, len_off) + sub_rr(r10, rdx)
        let discard = mov_rr(rsi, rsp) + mov_ri64(rdx, 8192) + xor_rr(r10, r10)
        let append = lea(rsi, r9, buf_off) + add_rr(rsi, rdx) + mov_rr(rdx, r10)
        let cap_branch = test_rr(r10, r10) + jle_rel32(str_len(append) + 5) + append + jmp_rel32(str_len(discard)) + discard
        let read = mov_rr(rdi, r8) + xor_rr(rax, rax) + syscall()
        let append_seq = mov_rm(rdx, r9, len_off) + add_rr(rdx, rax) + mov_mr(r9, len_off, rdx)
        let append_result = test_rr(r10, r10) + jle_rel32(str_len(append_seq)) + append_seq
        let eof = mov_rr(rdi, r8) + sys_mov_rax(3) + syscall() + mov_ri64(rax, 0 - 1) + mov_mr(r9, fd_off, rax)
        let dispatch = test_rr(rax, rax) + jg_rel32(6 + 5) + je_rel32(5 + str_len(append_result) + 5) + jmp_rel32(str_len(append_result) + 5 + str_len(eof))
        let back = jmp_rel32(0 - (str_len(cap) + str_len(cap_branch) + str_len(read) + 20 + str_len(append_result) + 5))
        let head = mov_rm(r8, r9, fd_off) + test_rr(r8, r8) + jl_rel32(str_len(cap) + str_len(cap_branch) + str_len(read) + 20 + str_len(append_result) + 5 + str_len(eof))
        head + cap + cap_branch + read + dispatch + append_result + back + eof
    }
    // wait4 状态换算：正常退出 code = (st>>8)&0xff，信号退出 code = 128 + termsig
    // wait4 status: normal exit code = (st>>8)&0xff, signaled code = 128 + termsig
    let store = mov_mr(r9, proc_code, rax) + mov_ri64(rax, 1) + mov_mr(r9, proc_complete, rax)
    let exited = mov_rr(rax, rcx) + mov_ri32(rcx, 8) + shr_rcl(rax) + mov_ri64(r8, 255) + and_rr(rax, r8)
    let signaled = mov_rr(rax, rdx) + add_ri32(rax, 128)
    let code_seq = test_rr(rdx, rdx) + je_rel32(str_len(signaled) + 5) + signaled + jmp_rel32(str_len(exited)) + exited + store
    let hav = mov_ri64(rax, 1) + mov_mr(r9, proc_have_err, rax)
    let failfd_close = mov_rm(rdi, r9, proc_failfd) + sys_mov_rax(3) + syscall() + mov_ri64(rax, 0 - 1) + mov_mr(r9, proc_failfd, rax)
    // 双管 EOF 后：终读 failfd（exec 成功时 CLOEXEC 已关），wait4 收尸
    // after both pipes EOF: final failfd read (CLOEXEC closed it on exec success), then wait4
    let wait_block = mov_rm(rdi, r9, proc_failfd) + lea(rsi, r9, proc_child_err) + sys_mov_rdx(4) + xor_rr(rax, rax) + syscall() + mov_ri64(rdx, 4) + cmp_rr(rax, rdx) + jne_rel32(str_len(hav)) + hav + failfd_close + sub_ri32(rsp, 16) + mov_rm(rdi, r9, proc_pid) + mov_rr(rsi, rsp) + xor_rr(rdx, rdx) + mov_ri64(r10, 0) + sys_mov_rax(61) + syscall() + mov_rm(rdx, rsp, 0) + mov_rr(rcx, rdx) + mov_ri64(rax, 127) + and_rr(rdx, rax) + code_seq + add_ri32(rsp, 16)
    let out_drain = drain_fd(proc_outfd, proc_ob_len, proc_ob)
    let err_drain = drain_fd(proc_errfd, proc_eb_len, proc_eb)
    let err_check = mov_rm(r8, r9, proc_errfd) + test_rr(r8, r8) + jge_rel32(str_len(wait_block))
    let out_check = mov_rm(r8, r9, proc_outfd) + test_rr(r8, r8) + jge_rel32(str_len(err_check) + str_len(wait_block))
    let failfd_read = mov_rm(rdi, r9, proc_failfd) + lea(rsi, r9, proc_child_err) + sys_mov_rdx(4) + xor_rr(rax, rax) + syscall()
    let failfd_drain = failfd_read + mov_ri64(rdx, 4) + cmp_rr(rax, rdx) + jne_rel32(str_len(hav)) + hav + test_rr(rax, rax) + jl_rel32(str_len(failfd_close)) + failfd_close
    let failfd_head = mov_rm(r8, r9, proc_failfd) + test_rr(r8, r8) + jl_rel32(str_len(failfd_drain))
    sub_ri32(rsp, 8192) + failfd_head + failfd_drain + out_drain + err_drain + out_check + err_check + wait_block + add_ri32(rsp, 8192)
}

// x86gen_proc_result_inst 从 proc 构造 Result 实例（rax 返回，置 consumed）/
// x86gen_proc_result_inst builds the Result instance from a proc (returned in rax, marks consumed)
fn x86gen_proc_result_inst() {
    let ob_str = mov_rm(r10, r9, proc_ob_len) + mov_rr(r11, r12) + mov_mr(r11, 0, r10) + lea(rsi, r9, proc_ob) + lea(rdi, r11, 8) + mov_rr(rcx, r10) + rep_movsb() + add_rr(r12, r10) + add_ri32(r12, 8)
    let eb_str = mov_rm(r10, r9, proc_eb_len) + mov_rr(r8, r12) + mov_mr(r8, 0, r10) + lea(rsi, r9, proc_eb) + lea(rdi, r8, 8) + mov_rr(rcx, r10) + rep_movsb() + add_rr(r12, r10) + add_ri32(r12, 8)
    let out_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 2) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_rm(rax, r9, proc_code) + mov_mr(rcx, 16, rax) + mov_mr(rcx, 24, r11) + mov_mr(rcx, 32, r8) + add_ri32(r12, 40)
    let ok_inst = mov_rr(rax, r12) + mov_ri64(rdx, 1) + mov_mr(rax, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rax, 8, rdx) + mov_mr(rax, 16, rcx) + add_ri32(r12, 24)
    let ok_path = ob_str + eb_str + out_inst + ok_inst
    let err_path = x86gen_err_inst()
    let cons = mov_ri64(rdx, 1) + mov_mr(r9, proc_consumed, rdx)
    let branch = mov_rm(r8, r9, proc_have_err) + test_rr(r8, r8) + je_rel32(str_len(err_path) + 5) + err_path + jmp_rel32(str_len(ok_path)) + ok_path + cons
    branch
}

// x86gen_exec_native 内联 exec：spawn + 同步排空循环 / x86gen_exec_native inlines exec: spawn plus a synchronous drain loop
// exec inline: spawn, drain to completion, build the Result
fn x86gen_exec_native() {
    let spawn_seq = x86gen_exec_spawn_native()
    let pump = x86gen_proc_pump()
    let result = x86gen_proc_result_inst()
    let err = x86gen_err_inst()
    let store = mov_mr(r15, 0 - 24, rax) + vs_pop_n(2)
    let err_tail = err + store
    let done_seq = result + jmp_rel32(str_len(err))
    // 1ms 休眠（近似 poll 阻塞等待子进程）/ 1ms sleep (approximating a blocking poll on the child)
    let ns = sub_ri32(rsp, 16) + mov_ri64(rdx, 0) + mov_mr(rsp, 0, rdx) + mov_ri64(rdx, 1000000) + mov_mr(rsp, 8, rdx) + mov_rr(rdi, rsp) + xor_rr(rsi, rsi) + sys_mov_rax(35) + syscall() + add_ri32(rsp, 16)
    let loop_head = mov_rm(rax, r9, proc_complete) + test_rr(rax, rax) + jne_rel32(str_len(pump) + str_len(ns) + 5)
    let loop_back = jmp_rel32(0 - (str_len(loop_head) + str_len(pump) + str_len(ns) + 5))
    let fail_test = test_rr(rax, rax) + jl_rel32(str_len(mov_rr(r9, rax)) + str_len(loop_head) + str_len(pump) + str_len(ns) + 5 + str_len(done_seq))
    spawn_seq + fail_test + mov_rr(r9, rax) + loop_head + pump + ns + loop_back + done_seq + err_tail
}

// x86gen_exec_start_native 内联 exec_start：spawn → Ok(handle) / x86gen_exec_start_native inlines exec_start: spawn into Ok(handle)
// exec_start inline: spawn, return Ok(handle)
fn x86gen_exec_start_native() {
    let spawn_seq = x86gen_exec_spawn_native()
    let err = x86gen_err_inst()
    let store = mov_mr(r15, 0 - 24, rax) + vs_pop_n(2)
    let err_tail = err + store
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_rr(rax, rcx)
    let ok_tail = ok_inst + jmp_rel32(str_len(err))
    spawn_seq + test_rr(rax, rax) + jl_rel32(str_len(ok_inst) + 5) + ok_tail + err_tail
}

// x86gen_exec_poll_native 内联 exec_poll：单次排空，未完成 → None，完成 → Some(Result) /
// x86gen_exec_poll_native inlines exec_poll: one drain, None when incomplete, Some(Result) when complete
// exec_poll inline: single pump, None or Some(Result); invalid or consumed handle exits 4
fn x86gen_exec_poll_native() {
    let invalid = sys_mov_rdi(4) + sys_mov_rax(60) + syscall()
    let pump = x86gen_proc_pump()
    let result = x86gen_proc_result_inst()
    let some_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_rr(rax, rcx)
    let none_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + add_ri32(r12, 16) + mov_rr(rax, rcx)
    let store = mov_mr(r15, 0 - 16, rax) + vs_pop_n(1)
    let none_tail = none_inst + store + jmp_rel32(str_len(invalid))
    let some_tail = result + some_inst + jmp_rel32(str_len(none_inst))
    let comp_check = mov_rm(rax, r9, proc_complete) + test_rr(rax, rax) + je_rel32(str_len(some_tail))
    let setup = mov_rr(r9, rax)
    let consumed = mov_rm(rdx, rax, proc_consumed) + test_rr(rdx, rdx) + jne_rel32(str_len(setup) + str_len(pump) + str_len(comp_check) + str_len(some_tail) + str_len(none_tail))
    let head = mov_rm(rax, r15, 0 - 8) + test_rr(rax, rax) + jle_rel32(str_len(consumed) + str_len(setup) + str_len(pump) + str_len(comp_check) + str_len(some_tail) + str_len(none_tail) + str_len(invalid))
    head + consumed + setup + pump + comp_check + some_tail + none_tail + invalid
}

// x86gen_get_map_native 内联 get：按键查 map / x86gen_get_map_native inlines get: look up a map key
// get inline: lookup by key
fn x86gen_get_map_native(key_is_str) {
    let some_body = mov_rm(rax, r9, 0) + mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 0) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let none = mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + add_ri32(r12, 16) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2) + jmp_rel32(str_len(some_body))
    let advance = add_ri32(r10, 8) + add_ri32(r9, 8) + add_ri32(r11, 1)
    let access = mov_rm(rdx, r10, 0)
    let body = if key_is_str {
        let klen = mov_rm(rcx, rax, 0)
        let clen = mov_rm(rdi, rdx, 0)
        let cmpsb_je = lea(rsi, rdx, 8) + lea(rdi, rax, 8) + repe_cmpsb() + je_rel32(str_len(advance) + 5 + str_len(none))
        access + mov_rm(rax, r15, 0 - 8) + klen + clen + cmp_rr(rcx, rdi) + jne_rel32(str_len(cmpsb_je)) + cmpsb_je
    } else {
        access + mov_rm(rax, r15, 0 - 8) + cmp_rr(rdx, rax) + je_rel32(str_len(advance) + 5 + str_len(none))
    }
    let loop_head = cmp_rr(r11, r8) + jae_rel32(str_len(body) + str_len(advance) + 5)
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(body) + str_len(advance) + 5))
    let head = mov_rm(rax, r15, 0 - 16) + mov_rm(r8, rax, 0) + mov_rm(r10, rax, 16) + mov_rm(r9, rax, 24) + xor_rr(r11, r11)
    head + loop_head + body + advance + back + none + some_body
}

// x86gen_put_map_native 内联 put：插入或更新键 / x86gen_put_map_native inlines put: insert or update a key
// put inline: insert or update a key
fn x86gen_put_map_native(key_is_str) {
    let done = xor_rr(rax, rax) + mov_mr(r15, 0 - 32, rax) + vs_pop_n(3)
    let found = mov_rm(rax, r15, 0 - 8) + mov_mr(r9, 0, rax)
    let not_found = mov_rm(rax, r15, 0 - 24) + mov_rm(rsi, rax, 16) + mov_rm(rdx, rax, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(rsi, rdx) + mov_rm(r8, r15, 0 - 16) + mov_mr(rsi, 0, r8) + mov_rm(r9, rax, 24) + mov_rm(rdx, rax, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r9, rdx) + mov_rm(r8, r15, 0 - 8) + mov_mr(r9, 0, r8) + mov_rm(rdx, rax, 0) + add_ri32(rdx, 1) + mov_mr(rax, 0, rdx) + jmp_rel32(str_len(found))
    let advance = add_ri32(r8, 8) + add_ri32(r9, 8) + add_ri32(r11, 1)
    let access = mov_rm(rdx, r8, 0)
    let body = if key_is_str {
        let klen = mov_rm(rcx, rax, 0)
        let clen = mov_rm(rdi, rdx, 0)
        let cmpsb_je = lea(rsi, rdx, 8) + lea(rdi, rax, 8) + repe_cmpsb() + je_rel32(str_len(advance) + 5 + str_len(not_found))
        access + mov_rm(rax, r15, 0 - 16) + klen + clen + cmp_rr(rcx, rdi) + jne_rel32(str_len(cmpsb_je)) + cmpsb_je
    } else {
        access + mov_rm(rax, r15, 0 - 16) + cmp_rr(rdx, rax) + je_rel32(str_len(advance) + 5 + str_len(not_found))
    }
    let loop_head = cmp_rr(r11, r10) + jae_rel32(str_len(body) + str_len(advance) + 5)
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(body) + str_len(advance) + 5))
    let post_head = mov_rm(r10, rax, 0) + mov_rm(r8, rax, 16) + mov_rm(r9, rax, 24) + xor_rr(r11, r11)
    let g_min = add_ri32(r10, 4)
    let g_keys = mov_rr(r11, r12) + mov_rm(rsi, rax, 16) + mov_rr(rdi, r11) + mov_rm(rdx, rax, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rr(rdx, r10) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r12, rdx)
    let g_vals = mov_rm(rsi, rax, 24) + mov_rr(rdi, r12) + mov_rr(r9, r12) + mov_rm(rdx, rax, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + mov_rr(rdx, r10) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(r12, rdx)
    let g_hdr = mov_mr(rax, 8, r10) + mov_mr(rax, 16, r11) + mov_mr(rax, 24, r9)
    let growth = mov_rr(r10, rcx) + add_rr(r10, r10) + test_rr(r10, r10) + jne_rel32(str_len(g_min)) + g_min + g_keys + g_vals + g_hdr
    let head1 = mov_rm(rax, r15, 0 - 24) + mov_rm(rcx, rax, 0) + mov_rm(rdx, rax, 8) + cmp_rr(rcx, rdx) + jne_rel32(str_len(growth))
    head1 + growth + post_head + loop_head + body + advance + back + not_found + found + done
}

// x86gen_delete_map_native 内联 delete：删除键 / x86gen_delete_map_native inlines delete: remove a key
// delete inline: remove a key
fn x86gen_delete_map_native(key_is_str) {
    let finish = xor_rr(rax, rax) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2)
    let kshift = mov_rr(rsi, r8) + add_ri32(rsi, 8) + mov_rr(rdi, r8) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb()
    let keys_block = mov_rr(rdx, r10) + sub_rr(rdx, r11) + sub_ri32(rdx, 1) + test_rr(rdx, rdx) + jle_rel32(str_len(kshift)) + kshift
    let vshift = mov_rr(rsi, r9) + add_ri32(rsi, 8) + mov_rr(rdi, r9) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb()
    let vals_block = mov_rr(rdx, r10) + sub_rr(rdx, r11) + sub_ri32(rdx, 1) + test_rr(rdx, rdx) + jle_rel32(str_len(vshift)) + vshift
    let len_dec = mov_rm(rax, r15, 0 - 16) + sub_ri32(r10, 1) + mov_mr(rax, 0, r10)
    let found_body = keys_block + vals_block + len_dec
    let not_found = jmp_rel32(str_len(found_body))
    let advance = add_ri32(r8, 8) + add_ri32(r9, 8) + add_ri32(r11, 1)
    let access = mov_rm(rdx, r8, 0)
    let body = if key_is_str {
        let klen = mov_rm(rcx, rax, 0)
        let clen = mov_rm(rdi, rdx, 0)
        let cmpsb_je = lea(rsi, rdx, 8) + lea(rdi, rax, 8) + repe_cmpsb() + je_rel32(str_len(advance) + 5 + str_len(not_found))
        access + mov_rm(rax, r15, 0 - 8) + klen + clen + cmp_rr(rcx, rdi) + jne_rel32(str_len(cmpsb_je)) + cmpsb_je
    } else {
        access + mov_rm(rax, r15, 0 - 8) + cmp_rr(rdx, rax) + je_rel32(str_len(advance) + 5 + str_len(not_found))
    }
    let loop_head = cmp_rr(r11, r10) + jae_rel32(str_len(body) + str_len(advance) + 5)
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(body) + str_len(advance) + 5))
    let head = mov_rm(rax, r15, 0 - 16) + mov_rm(r10, rax, 0) + mov_rm(r8, rax, 16) + mov_rm(r9, rax, 24) + xor_rr(r11, r11)
    head + loop_head + body + advance + back + not_found + found_body + finish
}

// x86gen_keys_map_native 内联 keys：键列表 / x86gen_keys_map_native inlines keys: the key list
// keys inline: list of keys
fn x86gen_keys_map_native() {
    let tail = mov_rm(rdx, r11, 0) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_ri32(rdx, 24) + add_rr(r12, rdx) + mov_mr(r15, 0 - 16, r11) + vs_pop_n(1)
    mov_rm(rax, r15, 0 - 8) + mov_rm(rcx, rax, 0) + mov_rr(r11, r12) + mov_mr(r11, 0, rcx) + mov_mr(r11, 8, rcx) + lea(r10, r11, 24) + mov_mr(r11, 16, r10) + mov_rm(rsi, rax, 16) + mov_rr(rdi, r10) + mov_rr(rdx, rcx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rr(rcx, rdx) + rep_movsb() + tail
}

// x86gen_map_format_at 生成 map 格式化（插入序输出）/
// x86gen_map_format_at emits map formatting (insertion-order output)
// Map formatting (insertion order)
fn x86gen_map_format_at(off, key_is_str, val_is_str) {
    let mb_al = e1(136) + e1(7)
    let mb = fn(c) {
        e1(198) + e1(7) + sb(c)
    }
    let sep1_bytes = add_ri32(rcx, 2)
    let sep1 = test_rr(r11, r11) + je_rel32(str_len(sep1_bytes)) + sep1_bytes
    let key_len = if key_is_str {
        mov_rm(rax, r10, 0) + mov_rm(rsi, rax, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
    } else {
        let dl = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
        let dl_jne = jne_rel32(0 - (str_len(dl) + 6))
        mov_rm(rax, r10, 0) + xor_rr(rsi, rsi) + dl + dl_jne + add_rr(rcx, rsi)
    }
    let colon1 = add_ri32(rcx, 2)
    let val_len = if val_is_str {
        mov_rm(rax, r9, 0) + mov_rm(rsi, rax, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
    } else {
        let dl = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
        let dl_jne = jne_rel32(0 - (str_len(dl) + 6))
        mov_rm(rax, r9, 0) + xor_rr(rsi, rsi) + dl + dl_jne + add_rr(rcx, rsi)
    }
    let advance1 = add_ri32(r11, 1) + add_ri32(r10, 8) + add_ri32(r9, 8)
    let loop1_test = cmp_rr(r11, r8) + jae_rel32(str_len(sep1) + str_len(key_len) + str_len(colon1) + str_len(val_len) + str_len(advance1) + 5)
    let back1 = jmp_rel32(0 - (str_len(loop1_test) + str_len(sep1) + str_len(key_len) + str_len(colon1) + str_len(val_len) + str_len(advance1) + 5))
    let loop1 = loop1_test + sep1 + key_len + colon1 + val_len + advance1 + back1
    let h1 = mov_rm(r9, r15, off) + mov_rm(r8, r9, 0) + mov_rm(r10, r9, 16) + mov_rm(r9, r9, 24) + mov_ri64(rcx, 2) + xor_rr(r11, r11)
    let int2_loop = xor_rr(rdx, rdx) + mov_ri64(rsi, 10) + idiv_r(rsi) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(rcx, 1) + test_rr(rax, rax)
    let int2_loop_jne = jne_rel32(0 - (str_len(int2_loop) + 6))
    let write2_body = pop_r(rax) + mb_al + add_ri32(rdi, 1) + sub_ri32(rcx, 1) + test_rr(rcx, rcx)
    let write2 = write2_body + jne_rel32(0 - (str_len(write2_body) + 6))
    let int2_zero = mb(48) + add_ri32(rdi, 1) + jmp_rel32(str_len(int2_loop) + str_len(int2_loop_jne) + str_len(write2))
    let int_write = mov_rr(rax, rdx) + xor_rr(rcx, rcx) + test_rr(rax, rax) + jne_rel32(str_len(int2_zero)) + int2_zero + int2_loop + int2_loop_jne + write2
    let key_write = if key_is_str {
        let kaddr = mov_rr(rdx, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(rdx, r10) + mov_rm(rax, rdx, 0)
        kaddr + mb(34) + add_ri32(rdi, 1) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
    } else {
        let kaddr = mov_rr(rdx, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_rr(rdx, r10) + mov_rm(rdx, rdx, 0)
        kaddr + int_write
    }
    let colon2 = mb(58) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
    let val_write = if val_is_str {
        let vaddr = mov_rr(rdx, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rm(rcx, r15, off) + mov_rm(rcx, rcx, 24) + add_rr(rdx, rcx) + mov_rm(rax, rdx, 0)
        vaddr + mb(34) + add_ri32(rdi, 1) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
    } else {
        let vaddr = mov_rr(rdx, r11) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + mov_rm(rcx, r15, off) + mov_rm(rcx, rcx, 24) + add_rr(rdx, rcx) + mov_rm(rdx, rdx, 0)
        vaddr + int_write
    }
    let sep2_bytes = mb(44) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
    let sep2 = test_rr(r11, r11) + je_rel32(str_len(sep2_bytes)) + sep2_bytes
    let advance2 = add_ri32(r11, 1)
    let loop2_test = cmp_rr(r11, r8) + jae_rel32(str_len(sep2) + str_len(key_write) + str_len(colon2) + str_len(val_write) + str_len(advance2) + 5)
    let back2 = jmp_rel32(0 - (str_len(loop2_test) + str_len(sep2) + str_len(key_write) + str_len(colon2) + str_len(val_write) + str_len(advance2) + 5))
    let loop2 = loop2_test + sep2 + key_write + colon2 + val_write + advance2 + back2
    let alloc_zone = mov_rr(r9, r12) + mov_mr(r9, 0, rcx) + lea(rdi, r9, 8) + add_rr(r12, rcx) + add_ri32(r12, 8) + push_r(r9) + mb(123) + add_ri32(rdi, 1) + xor_rr(r11, r11)
    let reload2 = mov_rm(r10, r15, off) + mov_rm(r8, r10, 0) + mov_rm(r10, r10, 16)
    let endfill = mb(125) + add_ri32(rdi, 1) + pop_r(r9) + mov_mr(r15, off, r9)
    h1 + loop1 + alloc_zone + reload2 + loop2 + endfill
}

// x86gen_record_format_at 生成 record 格式化：字段名 + 值
// x86gen_record_format_at emits record formatting: field names plus values
// Record formatting: field names and values
fn x86gen_record_format_at(off, names, ftypes) {
    let mb_al = e1(136) + e1(7)
    let mb = fn(c) {
        e1(198) + e1(7) + sb(c)
    }
    let int2_loop = xor_rr(rdx, rdx) + mov_ri64(rsi, 10) + idiv_r(rsi) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(rcx, 1) + test_rr(rax, rax)
    let int2_loop_jne = jne_rel32(0 - (str_len(int2_loop) + 6))
    let write2_body = pop_r(rax) + mb_al + add_ri32(rdi, 1) + sub_ri32(rcx, 1) + test_rr(rcx, rcx)
    let write2 = write2_body + jne_rel32(0 - (str_len(write2_body) + 6))
    let int2_zero = mb(48) + add_ri32(rdi, 1) + jmp_rel32(str_len(int2_loop) + str_len(int2_loop_jne) + str_len(write2))
    let int_write = mov_rr(rax, rdx) + xor_rr(rcx, rcx) + test_rr(rax, rax) + jne_rel32(str_len(int2_zero)) + int2_zero + int2_loop + int2_loop_jne + write2
    let mut p1 = mov_rm(r10, r15, off) + lea(r10, r10, 16) + mov_ri64(rcx, 9)
    let mut p1f = ""
    let mut pi = 0
    while pi < len(names) {
        if pi > 0 {
            p1f = p1f + add_ri32(rcx, 2)
        }
        p1f = p1f + add_ri32(rcx, str_len(names[pi]) + 2)
        if ftypes[pi] == "str" {
            p1f = p1f + mov_rm(rax, r10, 0) + mov_rm(rsi, rax, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
        } else {
            let dl = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
            let dl_jne = jne_rel32(0 - (str_len(dl) + 6))
            p1f = p1f + mov_rm(rax, r10, 0) + xor_rr(rsi, rsi) + dl + dl_jne + add_rr(rcx, rsi)
        }
        p1f = p1f + add_ri32(r10, 8)
        pi = pi + 1
    }
    p1f = p1f + add_ri32(rcx, 2)
    let alloc = mov_rr(r9, r12) + mov_mr(r9, 0, rcx) + lea(rdi, r9, 8) + add_rr(r12, rcx) + add_ri32(r12, 8) + push_r(r9)
    let p2h = mov_rm(r10, r15, off) + lea(r10, r10, 16)
    let mut p2f = ""
    let pre = "record " + chr(123) + " "
    let mut pb = 0
    while pb < str_len(pre) {
        p2f = p2f + mb(byte_at(pre, pb)) + add_ri32(rdi, 1)
        pb = pb + 1
    }
    let mut qi = 0
    while qi < len(names) {
        if qi > 0 {
            p2f = p2f + mb(44) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
        }
        let mut nb = 0
        while nb < str_len(names[qi]) {
            p2f = p2f + mb(byte_at(names[qi], nb)) + add_ri32(rdi, 1)
            nb = nb + 1
        }
        p2f = p2f + mb(58) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
        if ftypes[qi] == "str" {
            p2f = p2f + mov_rm(rax, r10, 0) + mb(34) + add_ri32(rdi, 1) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
        } else {
            p2f = p2f + mov_rm(rdx, r10, 0) + int_write
        }
        p2f = p2f + add_ri32(r10, 8)
        qi = qi + 1
    }
    p2f = p2f + mb(32) + add_ri32(rdi, 1) + mb(125) + add_ri32(rdi, 1)
    let p2t = pop_r(r9) + mov_mr(r15, off, r9)
    p1 + p1f + alloc + p2h + p2f + p2t
}

// x86gen_record_eq 生成 record 相等：逐字段比较
// x86gen_record_eq emits record equality: field-by-field comparison
// Record equality: field-by-field compare
fn x86gen_record_eq(ftypes) {
    let mut body = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_ri64(r11, 1)
    body = body + mov_rm(rax, r9, 0) + mov_rm(rcx, r10, 0) + xor_rr(rdx, rdx) + cmp_rr(rax, rcx) + sete(rdx) + and_rr(r11, rdx)
    let mut fi = 0
    while fi < len(ftypes) {
        if ftypes[fi] == "str" {
            let sbody = lea(rsi, rsi, 8) + lea(rdi, rdi, 8) + mov_rr(rcx, rdx) + repe_cmpsb() + sete(rax)
            body = body + mov_rm(rsi, r9, 16 + 8 * fi) + mov_rm(rdi, r10, 16 + 8 * fi) + mov_rm(rdx, rsi, 0) + mov_rm(r8, rdi, 0) + xor_rr(rax, rax) + cmp_rr(rdx, r8) + jne_rel32(str_len(sbody)) + sbody + and_rr(r11, rax)
        } else {
            body = body + mov_rm(rax, r9, 16 + 8 * fi) + mov_rm(rcx, r10, 16 + 8 * fi) + xor_rr(rdx, rdx) + cmp_rr(rax, rcx) + sete(rdx) + and_rr(r11, rdx)
        }
        fi = fi + 1
    }
    let done = mov_mr(r15, 0 - 16, r11) + vs_pop_n(1)
    body + done
}

// x86gen_range_native 内联 range：整数区间列表 / x86gen_range_native inlines range: an integer interval list
// range inline: integer interval list
fn x86gen_range_native() {
    let fill_loop = mov_mr(rdi, 0, rax) + add_ri32(rdi, 8) + add_ri32(rax, 1) + sub_ri32(r9, 1)
    let fill_jne = jne_rel32(0 - (str_len(fill_loop) + 6))
    let fill_all = fill_loop + fill_jne
    mov_rm(r8, r15, 0 - 16) + mov_rm(r9, r15, 0 - 8) + mov_rr(rax, r9) + sub_rr(rax, r8) + mov_rr(rcx, rax) + mov_rr(r11, r12) + mov_mr(r11, 0, rcx) + mov_mr(r11, 8, rcx) + lea(r10, r11, 24) + mov_mr(r11, 16, r10) + test_rr(rcx, rcx) + je_rel32(str_len(fill_all)) + mov_rr(rdi, r10) + mov_rr(rax, r8) + mov_rr(r9, rcx) + fill_all + mov_rr(r10, rcx) + mov_ri32(rcx, 3) + shl_rcl(r10) + add_ri32(r10, 24) + add_rr(r10, r11) + mov_rr(r12, r10) + vs_pop_n(3) + vs_push(r11)
}

// x86gen_start 生成 _start：mmap 堆 + 设置寄存器约定 + 调 main
// x86gen_start emits _start: mmap the heap, set the register conventions, call main
// _start: mmap the heap, set register conventions, call main
// x86gen_start 生成 _start：mmap 堆 + 设置寄存器约定 + 调 main
// x86gen_start emits _start: mmap the heap, set the register conventions, call main
// _start: mmap the heap, set register conventions, call main
fn x86gen_start(nfn, n_globals) {
    lea_rip_rel32(r13, 0 - 8 * nfn - 7) + mov_ri64(rdi, 0) + mov_ri64(rsi, 16777216) + mov_ri64(rdx, 3) + mov_ri64(r10, 34) + mov_ri64(r8, 0) + mov_ri64(r9, 0) + sys_mov_rax(9) + syscall() + mov_rr(r12, rax) + mov_rr(r11, rsp) + mov_mr(r12, 0, r11) + add_ri32(r12, 8) + mov_rr(rbx, r12) + add_ri32(r12, 8 * n_globals + 4096) + mov_rr(r15, rsp) + sub_ri32(r15, 1048576) + mov_rr(r14, r15) + vs_push_zero() + mov_rm(rax, r13, 0) + call_r(rax) + xor_rr(rdi, rdi) + sys_mov_rax(60) + syscall()
}

// x86gen_program_to_buf 是 x86 后端入口：字节码表 → x86-64 ELF 二进制字节
// x86gen_program_to_buf is the x86 backend entry: bytecode tables to x86-64 ELF binary bytes
// Entry: bytecode tables to x86-64 ELF binary bytes
pub fn x86gen_program_to_buf(f_name, _f_file, f_arity, f_nupvals, f_code, _f_spans, f_consts, en_qual, en_vnames, _en_varities) {
    // read_u16 读 u16 操作数 / read_u16 reads a u16 operand
    // Read a u16 operand
    fn read_u16(code, at) {
        code[at] * 256 + code[at + 1]
    }
    // const_str 生成字符串常量字节 / const_str builds string constant bytes
    fn const_str(fh, idx) {
        match f_consts[fh][idx] {
            lib::CVal::CStr(s) => s,
            _ => "",
        }
    }
    // fn_const 生成函数常量字节 / fn_const builds function constant bytes
    fn fn_const(fh, idx) {
        match f_consts[fh][idx] {
            lib::CVal::CFn(sub) => sub,
            _ => 0,
        }
    }
    // inst_len 取指令长度 / inst_len returns the instruction length
    fn inst_len(fh, code, ip) {
        let op = code[ip]
        if op == lib::op_const || op == lib::op_get_local || op == lib::op_set_local || op == lib::op_get_global || op == lib::op_def_global || op == lib::op_set_global || op == lib::op_get_upval || op == lib::op_set_upval || op == lib::op_jump || op == lib::op_jump_if_false || op == lib::op_jump_if_true || op == lib::op_jump_if_false_pop || op == lib::op_loop || op == lib::op_list || op == lib::op_chan_next || op == lib::op_get_field_name {
            3
        } else if op == lib::op_pop_n || op == lib::op_call || op == lib::op_spawn || op == lib::op_end_block || op == lib::op_test_variant || op == lib::op_get_field || op == lib::op_tuple {
            2
        } else if op == lib::op_record || op == lib::op_record_update {
            4
        } else if op == lib::op_closure {
            3 + f_nupvals[fn_const(fh, read_u16(code, ip + 1))] * 3
        } else if op == lib::op_select {
            let n_arms = code[ip + 1]
            let has_default = code[ip + 2] != 0
            3 + n_arms * 3 + (if has_default {
                2
            } else {
                0
            })
        } else {
            1
        }
    }
    // jump_targets 构建跳转目标表 / jump_targets builds the jump target table
    fn jump_targets(fh) {
        let code = f_code[fh]
        let mut targets = map()
        let mut ip = 0
        while ip < len(code) {
            let op = code[ip]
            if op == lib::op_jump || op == lib::op_jump_if_false || op == lib::op_jump_if_true || op == lib::op_jump_if_false_pop {
                put(targets, ip + 3 + read_u16(code, ip + 1), true)
                ip = ip + 3
            } else if op == lib::op_loop {
                put(targets, ip + 3 - read_u16(code, ip + 1), true)
                ip = ip + 3
            } else if op == lib::op_chan_next {
                put(targets, ip + 3 + read_u16(code, ip + 1), true)
                ip = ip + 3
            } else if op == lib::op_select {
                let mut p = ip + 1
                let n_arms = code[p]
                let has_default = code[p + 1] != 0
                p = p + 2
                let mut i = 0
                while i < n_arms {
                    p = p + 1
                    put(targets, p + 2 + read_u16(code, p), true)
                    p = p + 2
                    i = i + 1
                }
                if has_default {
                    put(targets, p + 2 + read_u16(code, p), true)
                    p = p + 2
                }
                ip = p
            } else {
                ip = ip + inst_len(fh, code, ip)
            }
        }
        targets
    }
    // count_locals 统计局部变量数 / count_locals counts locals
    fn count_locals(fh) {
        let code = f_code[fh]
        let mut max_slot = f_arity[fh]
        let mut ip = 0
        while ip < len(code) {
            let op = code[ip]
            if op == lib::op_get_local || op == lib::op_set_local {
                let slot = read_u16(code, ip + 1)
                if slot > max_slot {
                    max_slot = slot
                }
            }
            ip = ip + inst_len(fh, code, ip)
        }
        max_slot + 1
    }
    // find_fn_by_name 按名字查找函数 / find_fn_by_name finds a function by name
    fn find_fn_by_name(name) {
        let mut i = 0
        while i < len(f_name) {
            if f_name[i] == name {
                return i
            }
            i = i + 1
        }
        0 - 1
    }
    // shadow_pop 弹出影子栈 n 项 / shadow_pop pops n entries from the shadow stack
    fn shadow_pop(mut lst, n) {
        let mut k = 0
        while k < n && len(lst) > 0 {
            pop(lst)
            k = k + 1
        }
    }
    // type_specificity 类型特异度（重载选择）/ type_specificity scores a type (overload selection)
    fn type_specificity(t) {
        if t == "" {
            0
        } else if t == "map" {
            1
        } else if t == "map-str" || t == "map-int" {
            2
        } else if str_len(t) > 4 && substr(t, 0, 4) == "map-" {
            3
        } else {
            4
        }
    }
    // is_more_specific 判断是否更特异 / is_more_specific tells whether a is more specific
    fn is_more_specific(a, b) {
        type_specificity(a) > type_specificity(b)
    }
    // is_map_type 判断是否为 map 类型 / is_map_type tells whether t is a map type
    fn is_map_type(t) {
        str_len(t) >= 3 && substr(t, 0, 3) == "map"
    }
    // map_key_type 取 map 键类型 / map_key_type extracts the map key type
    fn map_key_type(t) {
        if t == "map-str" || t == "map-str-int" || t == "map-str-str" {
            "str"
        } else if t == "map-int" || t == "map-int-str" || t == "map-int-int" {
            "int"
        } else {
            ""
        }
    }
    // map_val_type 取 map 值类型 / map_val_type extracts the map value type
    fn map_val_type(t) {
        if t == "map-str-int" || t == "map-int-int" {
            "int"
        } else if t == "map-str-str" || t == "map-int-str" {
            "str"
        } else {
            ""
        }
    }
    // refine_map_type 细化 map 类型 / refine_map_type refines a map type
    fn refine_map_type(k, v) {
        if k == "" {
            "map"
        } else if v == "" {
            "map-" + k
        } else {
            "map-" + k + "-" + v
        }
    }
    // refine_map_arg 细化 map 实参 / refine_map_arg refines a map argument
    fn refine_map_arg(arg_t, k, v) {
        if arg_t == "" || is_map_type(arg_t) {
            let cur_k = map_key_type(arg_t)
            let cur_v = map_val_type(arg_t)
            let new_k = if k != "" {
                k
            } else {
                cur_k
            }
            let new_v = if v != "" {
                v
            } else {
                cur_v
            }
            refine_map_type(new_k, new_v)
        } else {
            arg_t
        }
    }
    // is_record_type 判断是否为 record 类型 / is_record_type tells whether t is a record type
    fn is_record_type(t) {
        t == "record" || str_len(t) >= 7 && substr(t, 0, 7) == "record:"
    }
    // record_schema 取 record 字段 schema / record_schema fetches a record's field schema
    fn record_schema(t) {
        if str_len(t) >= 7 && substr(t, 0, 7) == "record:" {
            substr(t, 7, str_len(t) - 7)
        } else {
            ""
        }
    }
    // merge_type 合并类型跟踪 / merge_type merges type tracking
    fn merge_type(cur, new) {
        if cur == "" {
            new
        } else if new == "" {
            cur
        } else if is_map_type(cur) || is_map_type(new) {
            refine_map_arg(cur, map_key_type(new), map_val_type(new))
        } else {
            new
        }
    }
    // merge_pos 合并位置类型 / merge_pos merges positional types
    fn merge_pos(pcur, pnew) {
        if pcur == "" || pnew == pcur {
            pnew
        } else if is_map_type(pcur) && is_map_type(pnew) {
            refine_map_arg(pcur, map_key_type(pnew), map_val_type(pnew))
        } else if pnew == "" {
            pcur
        } else {
            pnew
        }
    }

    let nfn = len(f_name)
    let mut const_data = ""
    let mut const_slot_map = map()
    let mut enum_const_map = map()
    // const_slot_key 生成常量槽键 / const_slot_key keys a constant slot
    fn const_slot_key(f, i) {
        f * 100000 + i
    }
    // enum_const_key 生成枚举常量键 / enum_const_key keys an enum constant
    fn enum_const_key(cv) {
        match cv {
            lib::CVal::CEnumType(eh) => "e:" + str(eh),
            lib::CVal::CSingleton(eh, vi) => "s:" + str(eh) + ":" + str(vi),
            lib::CVal::CCtor(eh, vi) => "c:" + str(eh) + ":" + str(vi),
            _ => "",
        }
    }
    // enum_const_bytes 生成枚举常量字节 / enum_const_bytes builds enum constant bytes
    fn enum_const_bytes(cv) {
        match cv {
            lib::CVal::CEnumType(eh) => e8(eh),
            lib::CVal::CSingleton(eh, vi) => e8(eh) + e8(vi),
            lib::CVal::CCtor(eh, vi) => e8s(0 - 1) + e8(eh) + e8(vi),
            _ => "",
        }
    }
    let mut sf = 0
    while sf < nfn {
        let consts = f_consts[sf]
        let mut ci = 0
        while ci < len(consts) {
            match consts[ci] {
                lib::CVal::CStr(s) => {
                    let key = const_slot_key(sf, ci)
                    let dup = match get(const_slot_map, key) {
                        Some(_) => true,
                        None => false,
                    }
                    if !dup {
                        put(const_slot_map, key, str_len(const_data))
                        const_data = const_data + e8(str_len(s)) + s
                        while str_len(const_data) % 8 != 0 {
                            const_data = const_data + byte_chr(0)
                        }
                    }
                },
                lib::CVal::CEnumType(_) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                lib::CVal::CSingleton(_, _) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                lib::CVal::CCtor(_, _) => {
                    let ek = enum_const_key(consts[ci])
                    match get(enum_const_map, ek) {
                        Some(off) => put(const_slot_map, const_slot_key(sf, ci), off),
                        None => {
                            let off = str_len(const_data)
                            put(enum_const_map, ek, off)
                            put(const_slot_map, const_slot_key(sf, ci), off)
                            const_data = const_data + enum_const_bytes(consts[ci])
                        },
                    }
                },
                _ => {},
            }
            ci = ci + 1
        }
        sf = sf + 1
    }
    let _ = str_len(const_data)
    let mut record_encs = []
    let mut record_offs = []
    // add_record_enc 注册 record 编码 / add_record_enc registers a record encoding
    fn add_record_enc(enc) {
        let mut i = 0
        while i < len(record_encs) {
            if record_encs[i] == enc {
                return
            }
            i = i + 1
        }
        push(record_encs, enc)
        push(record_offs, str_len(const_data))
        const_data = const_data + enc
        while str_len(const_data) % 8 != 0 {
            const_data = const_data + byte_chr(0)
        }
    }
    let mut rf = 0
    while rf < nfn {
        let rcode = f_code[rf]
        let mut rip = 0
        while rip < len(rcode) {
            let rop = rcode[rip]
            if rop == lib::op_record || rop == lib::op_record_update {
                let cidx = read_u16(rcode, rip + 2)
                let enc = const_str(rf, cidx)
                if str_len(enc) > 0 {
                    add_record_enc(enc)
                }
            }
            rip = rip + inst_len(rf, rcode, rip)
        }
        rf = rf + 1
    }
    let mut record_field_types = map()
    // enum_field_types 枚举 payload 字段类型表 / enum_field_types holds enum payload field types
    // key = "enum:<qual>|variant0,f0,f1;variant1,f0" (variant 分隔 ";", 字段分隔 ",")
    let mut enum_field_types = map()
    // enum_variant_types 用户枚举 variant 字段类型（key = "v:<eh>:<vi>"）/
    // enum_variant_types holds user enum variant field types (key = "v:<eh>:<vi>")
    let mut enum_variant_types = map()
    // enum_variant_fields 取用户枚举某 variant 字段类型 / enum_variant_fields fetches a user enum variant's field types
    fn enum_variant_fields(eh, vidx) {
        match get(enum_variant_types, "v:" + str(eh) + ":" + str(vidx)) {
            Some(vf) => vf,
            None => [],
        }
    }
    // enum_field_key 生成枚举字段类型表 key / enum_field_key builds an enum field-type table key
    fn enum_field_key(qual, vts) {
        let mut key = "enum:" + qual
        let mut vi = 0
        while vi < len(vts) {
            key = key + "|"
            let fts = vts[vi]
            let mut fi = 0
            while fi < len(fts) {
                if fi > 0 {
                    key = key + ","
                }
                key = key + fts[fi]
                fi = fi + 1
            }
            vi = vi + 1
        }
        key
    }
    // enum_fields_for_variant 取某 variant 的字段类型 / enum_fields_for_variant fetches a variant's field types
    fn enum_fields_for_variant(enc, vidx) {
        match get(enum_field_types, enc) {
            Some(vts) => {
                if vidx >= 0 && vidx < len(vts) {
                    vts[vidx]
                } else {
                    []
                }
            },
            None => [],
        }
    }
    // is_enum_enc 判断是否为枚举编码 / is_enum_enc tells whether t is an enum encoding
    fn is_enum_enc(t) {
        str_len(t) >= 5 && substr(t, 0, 5) == "enum:"
    }
    // enum_fields_resolve 从枚举编码解析 variant 字段类型（先全表后用户 variant 表）/
    // enum_fields_resolve resolves a variant's field types (full table first, then the user variant table)
    fn enum_fields_resolve(enc, vidx) {
        let full = enum_fields_for_variant(enc, vidx)
        if len(full) > 0 {
            full
        } else if str_len(enc) > 6 && substr(enc, 0, 6) == "enum:e" {
            let eh_s = substr(enc, 6, str_len(enc) - 6)
            match parse_int(eh_s) {
                Some(eh_v) => enum_variant_fields(eh_v, vidx),
                None => [],
            }
        } else {
            []
        }
    }
    // enum_variant_name 取用户枚举 variant 名 / enum_variant_name fetches a user enum variant name
    fn enum_variant_name(eh, vidx) {
        if eh >= 0 && eh < len(en_vnames) && vidx >= 0 && vidx < len(en_vnames[eh]) {
            en_vnames[eh][vidx]
        } else {
            "?" + str(vidx)
        }
    }
    // x86gen_enum_format_at 生成枚举格式化：variant 名 + 字段（str 加引号）
    // x86gen_enum_format_at emits enum formatting: variant name plus fields (str quoted)
    fn x86gen_enum_format_at(off, eh, vts) {
        let f2s_h = find_fn_by_name("format_float")
        let mb_al = e1(136) + e1(7)
        let mb = fn(c) {
            e1(198) + e1(7) + sb(c)
        }
        let int2_loop = xor_rr(rdx, rdx) + mov_ri64(rsi, 10) + idiv_r(rsi) + add_ri32(rdx, 48) + push_r(rdx) + add_ri32(rcx, 1) + test_rr(rax, rax)
        let int2_loop_jne = jne_rel32(0 - (str_len(int2_loop) + 6))
        let write2_body = pop_r(rax) + mb_al + add_ri32(rdi, 1) + sub_ri32(rcx, 1) + test_rr(rcx, rcx)
        let write2 = write2_body + jne_rel32(0 - (str_len(write2_body) + 6))
        let int2_zero = mb(48) + add_ri32(rdi, 1) + jmp_rel32(str_len(int2_loop) + str_len(int2_loop_jne) + str_len(write2))
        let int_write = mov_rr(rax, rdx) + xor_rr(rcx, rcx) + test_rr(rax, rax) + jne_rel32(str_len(int2_zero)) + int2_zero + int2_loop + int2_loop_jne + write2
        // pass 1: 按运行时 variant 索引计算长度（每个 variant 独立块 + 分发链）
        // pass 1: compute the length for the runtime variant index (per-variant blocks plus a dispatch chain)
        let mut lblocks = []
        let mut vi1 = 0
        while vi1 < len(vts) {
            let vname = enum_variant_name(eh, vi1)
            let fts = vts[vi1]
            let mut lb = mov_rm(r10, r15, off) + lea(r10, r10, 16)
            if len(fts) == 0 {
                lb = lb + mov_ri64(rcx, str_len(vname))
            } else {
                lb = lb + mov_ri64(rcx, 2 + str_len(vname))
            }
            let mut fi1 = 0
            while fi1 < len(fts) {
                if fi1 > 0 {
                    lb = lb + add_ri32(rcx, 2)
                }
                if fts[fi1] == "str" {
                    lb = lb + mov_rm(rax, r10, 0) + mov_rm(rsi, rax, 0) + add_rr(rcx, rsi) + add_ri32(rcx, 2)
                } else if fts[fi1] == "float" {
                    // float 字段长度 = 调用注入的 format_float(bits) 所得 str 的长度；保存 r10/r11/rcx 现场
                    // float field length comes from the injected format_float(bits) result; preserve r10/r11/rcx
                    lb = lb + push_r(r10) + push_r(r11) + push_r(rcx) + mov_rm(rax, r10, 0) + mov_rm(rax, rax, 0) + vs_push_zero() + vs_push(rax) + mov_rm(rax, r13, 8 * f2s_h) + call_r(rax) + mov_rm(rax, r15, 0 - 8) + mov_rm(rsi, rax, 0) + sub_ri32(r15, 8) + pop_r(rcx) + pop_r(r11) + pop_r(r10) + add_rr(rcx, rsi)
                } else {
                    let dl = xor_rr(rdx, rdx) + mov_ri64(rdi, 10) + idiv_r(rdi) + add_ri32(rsi, 1) + test_rr(rax, rax)
                    let dl_jne = jne_rel32(0 - (str_len(dl) + 6))
                    lb = lb + mov_rm(rax, r10, 0) + xor_rr(rsi, rsi) + dl + dl_jne + add_rr(rcx, rsi)
                }
                lb = lb + add_ri32(r10, 8)
                fi1 = fi1 + 1
            }
            push(lblocks, lb)
            vi1 = vi1 + 1
        }
        // 长度分发链：每块 = [jne skip][lb][jmp end]；alloc 跟在最后块后
        // length dispatch: each block = [jne skip][lb][jmp end]; alloc follows the last block
        let mut lchain = ""
        let mut li = 0
        while li < len(lblocks) {
            let mut ltail = 0
            let mut lj = li + 1
            while lj < len(lblocks) {
                ltail = ltail + 10 + 3 + 6 + str_len(lblocks[lj]) + 5
                lj = lj + 1
            }
            lchain = lchain + mov_ri64(rdx, li) + cmp_rr(r11, rdx) + jne_rel32(str_len(lblocks[li]) + 5) + lblocks[li] + jmp_rel32(ltail)
            li = li + 1
        }
        // 分配缓冲
        // allocate the buffer
        let alloc = mov_rr(r9, r12) + mov_mr(r9, 0, rcx) + lea(rdi, r9, 8) + add_rr(r12, rcx) + add_ri32(r12, 8) + push_r(r9)
        // pass 2: 按运行时 variant 索引写对应文本
        // pass 2: write the text for the runtime variant index
        let mut p2 = ""
        let mut wblocks = []
        let mut vi2 = 0
        while vi2 < len(vts) {
            let vname = enum_variant_name(eh, vi2)
            let fts = vts[vi2]
            let mut wb = ""
            let mut nb2 = 0
            while nb2 < str_len(vname) {
                wb = wb + mb(byte_at(vname, nb2)) + add_ri32(rdi, 1)
                nb2 = nb2 + 1
            }
            wb = wb + mb(40) + add_ri32(rdi, 1)
            let mut fi2 = 0
            while fi2 < len(fts) {
                if fi2 > 0 {
                    wb = wb + mb(44) + add_ri32(rdi, 1) + mb(32) + add_ri32(rdi, 1)
                }
                if fts[fi2] == "str" {
                    wb = wb + mov_rm(rax, r10, 0) + mb(34) + add_ri32(rdi, 1) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + rep_movsb() + mb(34) + add_ri32(rdi, 1)
                } else if fts[fi2] == "float" {
                    // float 字段：调用 format_float(bits) 得 str，拷入输出缓冲；保存 r10/r11/rdi 现场
                    // float field: call format_float(bits), copy the str into the output buffer; preserve r10/r11/rdi
                    wb = wb + push_r(r10) + push_r(r11) + push_r(rdi) + mov_rm(rax, r10, 0) + mov_rm(rax, rax, 0) + vs_push_zero() + vs_push(rax) + mov_rm(rax, r13, 8 * f2s_h) + call_r(rax) + mov_rm(rax, r15, 0 - 8) + lea(rsi, rax, 8) + mov_rm(rcx, rax, 0) + sub_ri32(r15, 8) + pop_r(rdi) + pop_r(r11) + pop_r(r10) + rep_movsb()
                } else {
                    wb = wb + mov_rm(rdx, r10, 0) + int_write
                }
                wb = wb + add_ri32(r10, 8)
                fi2 = fi2 + 1
            }
            wb = wb + mb(41) + add_ri32(rdi, 1)
            if len(fts) == 0 {
                wb = wb + sub_ri32(rdi, 2)
            }
            push(wblocks, wb)
            vi2 = vi2 + 1
        }
        // 拼接：variant 索引分发（[jne skip][block][jmp end][skip:] 链）
        // dispatch on the variant index ([jne skip][block][jmp end][skip:] chain)
        let load_v = mov_rm(rax, r15, off) + mov_rm(r11, rax, 8)
        let mut wchain = ""
        let mut wi = 0
        while wi < len(wblocks) {
            // 计算本块之后所有后续块的完整长度（每个后续块 = mov(10) + cmp(3) + jne(6) + block + jmp(5)）
            // tail length after this block: each later block contributes mov(10) + cmp(3) + jne(6) + block + jmp(5)
            let mut wtail = 0
            let mut wj = wi + 1
            while wj < len(wblocks) {
                wtail = wtail + 10 + 3 + 6 + str_len(wblocks[wj]) + 5
                wj = wj + 1
            }
            wchain = wchain + mov_ri64(rdx, wi) + cmp_rr(r11, rdx) + jne_rel32(str_len(wblocks[wi]) + 5) + wblocks[wi] + jmp_rel32(wtail)
            wi = wi + 1
        }
        let p2h = mov_rm(r10, r15, off) + lea(r10, r10, 16)
        let p2t = pop_r(r9) + mov_mr(r15, off, r9)
        load_v + lchain + alloc + p2h + wchain + p2t
    }
    // enum_qual 取枚举编码名 / enum_qual extracts the qualifier of an enum encoding
    fn enum_qual(t) {
        let bar = match str_index_of(t, "|") {
            Some(b) => b,
            None => str_len(t),
        }
        if bar > 5 {
            substr(t, 5, bar - 5)
        } else {
            ""
        }
    }
    // enum_qual_to_eh 从 qualifier 名查枚举 handle / enum_qual_to_eh looks up an enum handle by qualifier
    fn enum_qual_to_eh(qual) {
        let mut qei = 0
        while qei < len(en_qual) {
            if en_qual[qei] == qual {
                return qei
            }
            qei = qei + 1
        }
        0 - 1
    }
    // x86gen_float_to_str_at 生成 float→str 转换（调用注入的 format_float），作用于 [r15+off] 的 float 盒
    // x86gen_float_to_str_at emits float-to-str by calling the injected format_float (operates on the box at [r15+off])
    // 调用约定：压 fn_ref+bits 两槽后 call，返回后 r15 少 8、返回值在原 fn_ref 槽（新 [r15-8]）；写回 [r15+off] 并恢复 r15
    // call convention: push fn_ref+bits, call; r15 drops by 8 and the result sits at the former fn_ref slot (new [r15-8]);
    // write it back to [r15+off] and restore r15
    fn x86gen_float_to_str_at(off) {
        let ff_h = find_fn_by_name("format_float")
        let f2s_call = mov_rm(rax, r15, off) + mov_rm(rax, rax, 0) + vs_push_zero() + vs_push(rax) + mov_rm(rax, r13, 8 * ff_h) + call_r(rax)
        let f2s_fin = mov_rm(rax, r15, 0 - 8) + mov_mr(r15, off - 8, rax) + sub_ri32(r15, 8)
        f2s_call + f2s_fin
    }
    // enum_format_for_enc 为任意枚举编码生成格式化 / enum_format_for_enc emits formatting for any enum encoding
    fn enum_format_for_enc(off, enc) {
        let feh = if str_len(enc) > 6 && substr(enc, 0, 6) == "enum:e" {
            match parse_int(substr(enc, 6, str_len(enc) - 6)) {
                Some(fehv) => fehv,
                None => 0,
            }
        } else {
            enum_qual_to_eh(enum_qual(enc))
        }
        let mut fvts = []
        let mut fvi = 0
        let mut fmax = 0
        if feh >= 0 && feh < len(en_vnames) {
            fmax = len(en_vnames[feh])
        }
        while fvi < fmax {
            push(fvts, enum_fields_resolve(enc, fvi))
            fvi = fvi + 1
        }
        x86gen_enum_format_at(off, feh, fvts)
    }
    // reg_enum_type 注册枚举实例类型 / reg_enum_type registers an enum instance type
    // qual = 枚举限定名, vts = 各 variant 字段类型列表; 返回编码字符串
    fn reg_enum_type(qual, vts) {
        let key = enum_field_key(qual, vts)
        put(enum_field_types, key, vts)
        key
    }
    // enum_payload_enc 生成内置枚举 payload 编码 / enum_payload_enc builds a builtin enum payload encoding
    fn enum_payload_enc(qual, payloads) {
        reg_enum_type(qual, payloads)
    }
    // exec 系列返回类型编码 / exec-family return type encodings
    let out_enc = enum_payload_enc("Output", [["int", "str", "str"]])
    let res_out_enc = enum_payload_enc("Result", [[out_enc], ["str"]])
    let res_int_enc = enum_payload_enc("Result", [["int"], ["str"]])
    let opt_res_enc = enum_payload_enc("Option", [[res_out_enc], []])
    // enum_eq_enc 解析枚举操作数的有效编码（enum:e<eh> 经注册表反查）/
    // enum_eq_enc resolves an enum operand's effective encoding ("enum:e<eh>" looks up the registry)
    fn enum_eq_enc(t) {
        if str_len(t) > 6 && substr(t, 0, 6) == "enum:e" {
            let eh_v = match parse_int(substr(t, 6, str_len(t) - 6)) {
                Some(ehv) => ehv,
                None => 0 - 1,
            }
            let qual_v = if eh_v >= 0 && eh_v < len(en_qual) {
                en_qual[eh_v]
            } else {
                ""
            }
            let mut found = ""
            let klist = keys(enum_field_types)
            let mut ki = 0
            while ki < len(klist) {
                if enum_qual(klist[ki]) == qual_v {
                    found = klist[ki]
                }
                ki = ki + 1
            }
            found
        } else if is_enum_enc(t) {
            t
        } else {
            ""
        }
    }
    // x86gen_enum_cmp_fields 比较两个枚举实例（r9/r10 = 实例基址，r11 = 累加器）/
    // x86gen_enum_cmp_fields compares two enum instances (r9/r10 = instance bases, r11 = accumulator)
    fn x86gen_enum_cmp_fields(enc) {
        let mut seq = mov_rm(rax, r9, 0) + mov_rm(rcx, r10, 0) + xor_rr(rdx, rdx) + cmp_rr(rax, rcx) + sete(rdx) + and_rr(r11, rdx)
        seq = seq + mov_rm(rax, r9, 8) + mov_rm(rcx, r10, 8) + xor_rr(rdx, rdx) + cmp_rr(rax, rcx) + sete(rdx) + and_rr(r11, rdx)
        let feh = enum_qual_to_eh(enum_qual(enc))
        let mut nv = 0
        if feh >= 0 && feh < len(en_vnames) {
            nv = len(en_vnames[feh])
        }
        let mut blocks = []
        while len(blocks) < nv {
            let fts = enum_fields_resolve(enc, len(blocks))
            let mut blk = ""
            let mut fi = 0
            while fi < len(fts) {
                if fts[fi] == "str" {
                    let sbody = lea(rsi, rsi, 8) + lea(rdi, rdi, 8) + mov_rr(rcx, rdx) + repe_cmpsb() + sete(rax)
                    blk = blk + mov_rm(rsi, r9, 16 + 8 * fi) + mov_rm(rdi, r10, 16 + 8 * fi) + mov_rm(rdx, rsi, 0) + mov_rm(r8, rdi, 0) + xor_rr(rax, rax) + cmp_rr(rdx, r8) + jne_rel32(str_len(sbody)) + sbody + and_rr(r11, rax)
                } else if is_enum_enc(fts[fi]) {
                    blk = blk + push_r(r9) + push_r(r10) + mov_rm(r9, r9, 16 + 8 * fi) + mov_rm(r10, r10, 16 + 8 * fi) + x86gen_enum_cmp_fields(fts[fi]) + pop_r(r10) + pop_r(r9)
                } else {
                    blk = blk + mov_rm(rax, r9, 16 + 8 * fi) + mov_rm(rcx, r10, 16 + 8 * fi) + xor_rr(rdx, rdx) + cmp_rr(rax, rcx) + sete(rdx) + and_rr(r11, rdx)
                }
                fi = fi + 1
            }
            // 变体不匹配（r11 已清零）时跳过字段比较，避免读另一实例的无字段垃圾
            // when the variants differ (r11 already cleared), skip the field compares to avoid reading the other instance's absent fields
            blk = test_rr(r11, r11) + je_rel32(str_len(blk)) + blk
            push(blocks, blk)
        }
        let mut chain = ""
        let mut bi = 0
        while bi < len(blocks) {
            let mut btail = 0
            let mut bj = bi + 1
            while bj < len(blocks) {
                btail = btail + 10 + 3 + 6 + str_len(blocks[bj]) + 5
                bj = bj + 1
            }
            chain = chain + mov_ri64(rdx, bi) + cmp_rr(rax, rdx) + jne_rel32(str_len(blocks[bi]) + 5) + blocks[bi] + jmp_rel32(btail)
            bi = bi + 1
        }
        seq + chain
    }
    // x86gen_enum_eq_at 生成枚举相等（操作数 [r15-16]/[r15-8]，结果回写 [r15-16] 并弹 1）/
    // x86gen_enum_eq_at emits enum equality (operands at [r15-16]/[r15-8], result at [r15-16], pops 1)
    fn x86gen_enum_eq_at(enc) {
        let mut body = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_ri64(r11, 1)
        body = body + x86gen_enum_cmp_fields(enc) + mov_mr(r15, 0 - 16, r11) + vs_pop_n(1)
        body
    }
    // enc_names 取编码字段名 / enc_names lists the encoded field names
    fn enc_names(enc) {
        let mut names = []
        let mut pos = 0
        while pos < str_len(enc) {
            let rest = substr(enc, pos, str_len(enc) - pos)
            match str_index_of(rest, "\n") {
                None => {
                    if str_len(rest) > 0 {
                        push(names, rest)
                    }
                    pos = str_len(enc)
                },
                Some(nl) => {
                    if nl > 0 {
                        push(names, substr(enc, pos, nl))
                    }
                    pos = pos + nl + 1
                },
            }
        }
        names
    }
    let const_data_len = str_len(const_data)
    // find_field_in_enc 在编码中查找字段 / find_field_in_enc finds a field in an encoding
    fn find_field_in_enc(enc, fname) {
        let mut i = 0
        let mut pos = 0
        while pos < str_len(enc) {
            let rest = substr(enc, pos, str_len(enc) - pos)
            match str_index_of(rest, "\n") {
                None => {
                    if rest == fname {
                        return i
                    }
                    pos = str_len(enc)
                },
                Some(nl) => {
                    let field = substr(enc, pos, nl)
                    if field == fname {
                        return i
                    }
                    pos = pos + nl + 1
                },
            }
            i = i + 1
        }
        0 - 1
    }
    // const_addr 取常量地址 / const_addr returns a constant's address
    fn const_addr(f, i) {
        match get(const_slot_map, const_slot_key(f, i)) {
            Some(off) => base_addr + 120 + off,
            None => 0,
        }
    }
    let mut globals_map = map()
    let mut n_globals = 0
    let mut gf = 0
    while gf < nfn {
        let gcode = f_code[gf]
        let mut gip = 0
        while gip < len(gcode) {
            let gop = gcode[gip]
            if gop == lib::op_def_global {
                let gidx = read_u16(gcode, gip + 1)
                let gname = const_str(gf, gidx)
                let exists = match get(globals_map, gname) {
                    Some(_) => true,
                    None => false,
                }
                if !exists {
                    put(globals_map, gname, n_globals)
                    n_globals = n_globals + 1
                }
            }
            gip = gip + inst_len(gf, gcode, gip)
        }
        gf = gf + 1
    }
    let mut fn_ret_type = []
    let mut rhAlloc = 0
    while rhAlloc < nfn {
        push(fn_ret_type, "")
        rhAlloc = rhAlloc + 1
    }
    let mut fn_param_types = []
    let mut phAlloc = 0
    while phAlloc < nfn {
        let mut plist = []
        let mut piAlloc = 0
        while piAlloc < f_arity[phAlloc] {
            push(plist, "")
            piAlloc = piAlloc + 1
        }
        push(fn_param_types, plist)
        phAlloc = phAlloc + 1
    }
    let mut p_depth_maps = []
    let mut pglobal_type = map()
    let mut round = 0
    while round < 4 {
        let mut pti = nfn
        p_depth_maps = []
        while pti > 0 {
            let ptfh = pti - 1
            let pcode = f_code[ptfh]
            let mut pshadow_ps = []
            let mut ptshadow_ps = []
            let mut ppos_types = []
            let mut ppos_auth = []
            let mut pcur_variant = -1
            let pa_ps = f_arity[ptfh]
            let mut pseed = 0
            while pseed < pa_ps + 1 {
                push(pshadow_ps, "")
                push(ptshadow_ps, "")
                push(ppos_types, "")
                push(ppos_auth, false)
                pseed = pseed + 1
            }
            let mut pp = 1
            while pp < pa_ps + 1 {
                if pp - 1 < len(fn_param_types[ptfh]) {
                    ppos_types[pp] = fn_param_types[ptfh][pp - 1]
                }
                pp = pp + 1
            }
            let mut p_depth_at = map()
            let mut pit = 0
            while pit < len(pcode) {
                let pal = match get(p_depth_at, pit) {
                    Some(pd) => pd,
                    None => 0 - 1,
                }
                if pal >= 0 && pcode[pit] != lib::op_no_match {
                    while len(pshadow_ps) > pal {
                        shadow_pop(pshadow_ps, 1)
                    }
                    while len(ptshadow_ps) > pal {
                        shadow_pop(ptshadow_ps, 1)
                    }
                }
                let pop = pcode[pit]
                if pop == lib::op_return {
                    if len(ptshadow_ps) > 0 {
                        fn_ret_type[ptfh] = ptshadow_ps[len(ptshadow_ps) - 1]
                    }
                } else if pop == lib::op_const {
                    let pval = f_consts[ptfh][read_u16(pcode, pit + 1)]
                    match pval {
                        lib::CVal::CStr(_) => {
                            push(pshadow_ps, "")
                            push(ptshadow_ps, "str")
                        },
                        lib::CVal::CSingleton(peh, pvi) => {
                            push(pshadow_ps, "ctor:" + str(peh) + ":" + str(pvi))
                            push(ptshadow_ps, "enum:e" + str(peh))
                        },
                        lib::CVal::CCtor(peh, pvi) => {
                            push(pshadow_ps, "ctor:" + str(peh) + ":" + str(pvi))
                            push(ptshadow_ps, "enum")
                        },
                        _ => {
                            push(pshadow_ps, "")
                            push(ptshadow_ps, "int")
                        },
                    }
                } else if pop == lib::op_get_local {
                    let pslot = read_u16(pcode, pit + 1)
                    if pslot == 0 {
                        push(pshadow_ps, f_name[ptfh])
                        push(ptshadow_ps, "")
                    } else {
                        push(pshadow_ps, "slot:" + str(pslot))
                        // 未初始化的 local（如 match 的 (match) 临时）采用当前栈顶类型并回写
                        // an uninitialized local (e.g. a match's (match) temp) takes the current stack-top type and writes it back
                        let mut pstype = "int"
                        if pslot < len(ppos_types) && str_len(ppos_types[pslot]) > 0 {
                            pstype = ppos_types[pslot]
                        } else if len(ptshadow_ps) > 0 {
                            pstype = ptshadow_ps[len(ptshadow_ps) - 1]
                            if pslot >= len(ppos_types) {
                                while len(ppos_types) <= pslot {
                                    push(ppos_types, "")
                                }
                            }
                            ppos_types[pslot] = pstype
                        }
                        push(ptshadow_ps, pstype)
                    }
                } else if pop == lib::op_set_local {
                    let pslot = read_u16(pcode, pit + 1)
                    if pslot > 0 && len(ptshadow_ps) > 0 {
                        if len(ppos_types) <= pslot {
                            push(ppos_types, "")
                        }
                        ppos_types[pslot] = ptshadow_ps[len(ptshadow_ps) - 1]
                        if len(ppos_auth) <= pslot {
                            while len(ppos_auth) <= pslot {
                                push(ppos_auth, false)
                            }
                        }
                        ppos_auth[pslot] = true
                    }
                } else if pop == lib::op_get_global {
                    let pidx = read_u16(pcode, pit + 1)
                    let pname = const_str(ptfh, pidx)
                    push(pshadow_ps, pname)
                    let pgtype = match get(pglobal_type, pname) {
                        Some(pt) => pt,
                        None => "int",
                    }
                    push(ptshadow_ps, pgtype)
                } else if pop == lib::op_set_global {} else if pop == lib::op_def_global {
                    let pdt = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    let pdidx = read_u16(pcode, pit + 1)
                    let pdname = const_str(ptfh, pdidx)
                    put(pglobal_type, pdname, pdt)
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                } else if pop == lib::op_pop {
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                } else if pop == lib::op_pop_n {
                    shadow_pop(pshadow_ps, pcode[pit + 1])
                    shadow_pop(ptshadow_ps, pcode[pit + 1])
                } else if pop == lib::op_end_block {
                    let pn_eb = pcode[pit + 1]
                    let presult = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        "int"
                    }
                    let presname = if len(pshadow_ps) > 0 {
                        pshadow_ps[len(pshadow_ps) - 1]
                    } else {
                        ""
                    }
                    shadow_pop(pshadow_ps, pn_eb + 1)
                    shadow_pop(ptshadow_ps, pn_eb + 1)
                    push(pshadow_ps, presname)
                    push(ptshadow_ps, presult)
                } else if pop == lib::op_call {
                    let pn = pcode[pit + 1]
                    let pcallee = if len(pshadow_ps) > pn {
                        pshadow_ps[len(pshadow_ps) - pn - 1]
                    } else {
                        ""
                    }
                    let mut p_arg_t = []
                    let mut p_arg_s = []
                    let mut pca = 0
                    while pca < pn {
                        push(p_arg_t, ptshadow_ps[len(ptshadow_ps) - pn + pca])
                        push(p_arg_s, pshadow_ps[len(pshadow_ps) - pn + pca])
                        pca = pca + 1
                    }
                    shadow_pop(pshadow_ps, pn + 1)
                    shadow_pop(ptshadow_ps, pn + 1)
                    if str_len(pcallee) > 5 && substr(pcallee, 0, 5) == "ctor:" {
                        // 预扫 ctor：按 eh:vi 注册字段类型 / pre-scan ctor: register field types by eh:vi
                        let pctor_rest = substr(pcallee, 5, str_len(pcallee) - 5)
                        let pctor_eh = match str_index_of(pctor_rest, ":") {
                            Some(pcei) => match parse_int(substr(pctor_rest, 0, pcei)) {
                                Some(pcev) => pcev,
                                None => 0,
                            },
                            None => 0,
                        }
                        let pctor_vi = match str_index_of(pctor_rest, ":") {
                            Some(pcei) => match parse_int(substr(pctor_rest, pcei + 1, str_len(pctor_rest) - pcei - 1)) {
                                Some(pciv) => pciv,
                                None => 0,
                            },
                            None => 0,
                        }
                        put(enum_variant_types, "v:" + str(pctor_eh) + ":" + str(pctor_vi), p_arg_t)
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "enum:e" + str(pctor_eh))
                    } else if pcallee == "substr" || pcallee == "chr" || pcallee == "char_at" || pcallee == "byte_chr" || pcallee == "str" || pcallee == "type_of" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "str")
                    } else if pcallee == "range" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "list-int")
                    } else if pcallee == "map" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "map")
                    } else if pcallee == "keys" {
                        let mk = if pn >= 1 {
                            map_key_type(p_arg_t[0])
                        } else {
                            ""
                        }
                        push(pshadow_ps, "")
                        if mk == "str" {
                            push(ptshadow_ps, "list-str")
                        } else {
                            push(ptshadow_ps, "list-int")
                        }
                    } else if pcallee == "put" || pcallee == "get" || pcallee == "delete" {
                        let mt = if pn >= 1 {
                            p_arg_t[0]
                        } else {
                            ""
                        }
                        let kt = if pn >= 2 {
                            p_arg_t[1]
                        } else {
                            ""
                        }
                        let vt = if pcallee == "put" && pn >= 3 {
                            p_arg_t[2]
                        } else {
                            ""
                        }
                        let refined = if pcallee == "put" {
                            refine_map_arg(mt, kt, vt)
                        } else {
                            refine_map_arg(mt, kt, "")
                        }
                        let mslot = if pn >= 1 {
                            p_arg_s[0]
                        } else {
                            ""
                        }
                        if str_len(mslot) > 5 && substr(mslot, 0, 5) == "slot:" {
                            match parse_int(substr(mslot, 5, str_len(mslot) - 5)) {
                                Some(sn) => {
                                    if sn > 0 {
                                        if len(ppos_types) <= sn {
                                            while len(ppos_types) <= sn {
                                                push(ppos_types, "")
                                            }
                                        }
                                        ppos_types[sn] = merge_type(ppos_types[sn], refined)
                                        if sn <= pa_ps {
                                            fn_param_types[ptfh][sn - 1] = merge_type(fn_param_types[ptfh][sn - 1], refined)
                                        }
                                    }
                                },
                                None => {},
                            }
                        } else if str_len(mslot) > 0 {
                            let pg_cur = match get(pglobal_type, mslot) {
                                Some(pgt) => pgt,
                                None => "",
                            }
                            put(pglobal_type, mslot, merge_type(pg_cur, refined))
                        }
                        push(pshadow_ps, "")
                        if pcallee == "get" {
                            let pv_kind = map_val_type(mt)
                            if pv_kind == "" {
                                push(ptshadow_ps, "enum")
                            } else {
                                push(ptshadow_ps, enum_payload_enc("Option", [[pv_kind]]))
                            }
                        } else {
                            push(ptshadow_ps, "unit")
                        }
                    } else if pcallee == "tcp_listen" || pcallee == "tcp_accept" || pcallee == "tcp_dial" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, enum_payload_enc("Result", [["int"], ["str"]]))
                    } else if pcallee == "net_read" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, enum_payload_enc("Result", [["str"], ["str"]]))
                    } else if pcallee == "net_write" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, enum_payload_enc("Result", [["unit"], ["str"]]))
                    } else if pcallee == "net_close" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "unit")
                    } else if pcallee == "read_file" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, enum_payload_enc("Result", [["str"], ["str"]]))
                    } else if pcallee == "stdin_nb" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, enum_payload_enc("Result", [["str"], ["str"]]))
                    } else if pcallee == "write_file" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, enum_payload_enc("Result", [["unit"], ["str"]]))
                    } else if pcallee == "read_dir" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, enum_payload_enc("Result", [["list-str"], ["str"]]))
                    } else if pcallee == "exec" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, res_out_enc)
                    } else if pcallee == "exec_start" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, res_int_enc)
                    } else if pcallee == "exec_poll" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, opt_res_enc)
                    } else if pcallee == "str_index_of" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, enum_payload_enc("Option", [["int"]]))
                    } else if pcallee == "parse_int" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, enum_payload_enc("Option", [["int"]]))
                    } else if pcallee == "split" {
                        push(pshadow_ps, "")
                        push(ptshadow_ps, "list-str")
                    } else if pcallee == "concat" || pcallee == "slice" {
                        let clt = if pn >= 1 {
                            p_arg_t[0]
                        } else {
                            "list"
                        }
                        push(pshadow_ps, "")
                        push(ptshadow_ps, clt)
                    } else {
                        let phandle = find_fn_by_name(pcallee)
                        if phandle >= 0 {
                            let mut pff = 0
                            while pff < pn && pff < len(fn_param_types[phandle]) {
                                fn_param_types[phandle][pff] = merge_type(fn_param_types[phandle][pff], p_arg_t[pff])
                                pff = pff + 1
                            }
                            let mut pbb = 0
                            while pbb < pn && pbb < len(fn_param_types[phandle]) {
                                let bslot = p_arg_s[pbb]
                                let ctype = fn_param_types[phandle][pbb]
                                if str_len(bslot) > 5 && substr(bslot, 0, 5) == "slot:" {
                                    match parse_int(substr(bslot, 5, str_len(bslot) - 5)) {
                                        Some(sn) => {
                                            if sn > 0 {
                                                if len(ppos_types) <= sn {
                                                    while len(ppos_types) <= sn {
                                                        push(ppos_types, "")
                                                    }
                                                }
                                                ppos_types[sn] = merge_type(ppos_types[sn], ctype)
                                            }
                                        },
                                        None => {},
                                    }
                                }
                                pbb = pbb + 1
                            }
                            if fn_ret_type[phandle] != "" {
                                push(pshadow_ps, "")
                                push(ptshadow_ps, fn_ret_type[phandle])
                            } else {
                                push(pshadow_ps, "")
                                push(ptshadow_ps, "int")
                            }
                        } else {
                            push(pshadow_ps, "")
                            push(ptshadow_ps, "int")
                        }
                    }
                } else if pop == lib::op_closure {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "")
                } else if pop == lib::op_get_upval {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "")
                } else if pop == lib::op_jump {
                    put(p_depth_at, pit + 3 + read_u16(pcode, pit + 1), len(pshadow_ps))
                } else if pop == lib::op_loop {
                    put(p_depth_at, pit + 3 - read_u16(pcode, pit + 1), len(pshadow_ps))
                } else if pop == lib::op_jump_if_false || pop == lib::op_jump_if_true {
                    put(p_depth_at, pit + 3 + read_u16(pcode, pit + 1), len(pshadow_ps))
                } else if pop == lib::op_jump_if_false_pop {
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                    put(p_depth_at, pit + 3 + read_u16(pcode, pit + 1), len(pshadow_ps))
                } else if pop == lib::op_chan_next {
                    put(p_depth_at, pit + 3 + read_u16(pcode, pit + 1), len(pshadow_ps) - 1)
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "int")
                } else if pop == lib::op_neg {
                    let neg_last = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    push(pshadow_ps, "")
                    if neg_last == "float" {
                        push(ptshadow_ps, "float")
                    } else {
                        push(ptshadow_ps, "int")
                    }
                } else if pop == lib::op_not {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "bool")
                } else if pop == lib::op_true {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "bool")
                } else if pop == lib::op_false {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "bool")
                } else if pop == lib::op_unit {
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "unit")
                } else if pop == lib::op_eq || pop == lib::op_neq || pop == lib::op_gt || pop == lib::op_gt_eq || pop == lib::op_lt || pop == lib::op_lt_eq {
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "bool")
                } else if pop == lib::op_add {
                    let add_last = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    let add_prev = if len(ptshadow_ps) > 1 {
                        ptshadow_ps[len(ptshadow_ps) - 2]
                    } else {
                        ""
                    }
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    if add_last == "str" || add_prev == "str" {
                        push(ptshadow_ps, "str")
                    } else if add_last == "float" || add_prev == "float" {
                        push(ptshadow_ps, "float")
                    } else {
                        push(ptshadow_ps, "int")
                    }
                } else if pop == lib::op_sub || pop == lib::op_mul || pop == lib::op_div || pop == lib::op_mod {
                    let sub_last = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    let sub_prev = if len(ptshadow_ps) > 1 {
                        ptshadow_ps[len(ptshadow_ps) - 2]
                    } else {
                        ""
                    }
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    if pop != lib::op_mod && (sub_last == "float" || sub_prev == "float") {
                        push(ptshadow_ps, "float")
                    } else {
                        push(ptshadow_ps, "int")
                    }
                } else if pop == lib::op_list {
                    let plen = read_u16(pcode, pit + 1)
                    let pelt = if plen > 0 && len(ptshadow_ps) >= 1 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    shadow_pop(pshadow_ps, plen)
                    shadow_pop(ptshadow_ps, plen)
                    push(pshadow_ps, "")
                    if pelt == "str" {
                        push(ptshadow_ps, "list-str")
                    } else {
                        push(ptshadow_ps, "list-int")
                    }
                } else if pop == lib::op_index_get {
                    let plt = if len(ptshadow_ps) >= 2 {
                        ptshadow_ps[len(ptshadow_ps) - 2]
                    } else {
                        ""
                    }
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    if plt == "list-str" || plt == "str" {
                        push(ptshadow_ps, "str")
                    } else if str_len(plt) > 4 && substr(plt, 0, 4) == "tup:" {
                        let mut pel_t = "int"
                        let ppt = if pit >= 3 {
                            pcode[pit - 3]
                        } else {
                            255
                        }
                        if ppt == lib::op_const {
                            let ppidx = read_u16(pcode, pit - 2)
                            match f_consts[ptfh][ppidx] {
                                lib::CVal::CInt(ppv) => {
                                    let pelems = split(substr(plt, 4, str_len(plt) - 4), "\n")
                                    if ppv >= 0 && ppv < len(pelems) {
                                        pel_t = pelems[ppv]
                                    }
                                },
                                _ => {},
                            }
                        }
                        push(ptshadow_ps, pel_t)
                    } else {
                        push(ptshadow_ps, "int")
                    }
                } else if pop == lib::op_index_set {
                    shadow_pop(pshadow_ps, 3)
                    shadow_pop(ptshadow_ps, 3)
                } else if pop == lib::op_len {
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "int")
                } else if pop == lib::op_tuple {
                    let ptup_n = pcode[pit + 1]
                    let mut ptup_ts = []
                    let mut ptup_i = 0
                    while ptup_i < ptup_n {
                        if len(ptshadow_ps) >= ptup_n - ptup_i {
                            push(ptup_ts, ptshadow_ps[len(ptshadow_ps) - ptup_n + ptup_i])
                        } else {
                            push(ptup_ts, "int")
                        }
                        ptup_i = ptup_i + 1
                    }
                    shadow_pop(pshadow_ps, ptup_n)
                    shadow_pop(ptshadow_ps, ptup_n)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "tup:" + join(ptup_ts, "\n"))
                } else if pop == lib::op_record {
                    let prec_n = pcode[pit + 1]
                    let prec_cidx = read_u16(pcode, pit + 2)
                    let prec_enc = const_str(ptfh, prec_cidx)
                    let mut prec_ft = []
                    let mut prec_i = 0
                    while prec_i < prec_n {
                        push(prec_ft, ptshadow_ps[len(ptshadow_ps) - prec_n + prec_i])
                        prec_i = prec_i + 1
                    }
                    put(record_field_types, prec_enc, prec_ft)
                    shadow_pop(pshadow_ps, prec_n)
                    shadow_pop(ptshadow_ps, prec_n)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "record:" + prec_enc)
                } else if pop == lib::op_test_variant {
                    pcur_variant = pcode[pit + 1]
                    shadow_pop(pshadow_ps, 2)
                    shadow_pop(ptshadow_ps, 2)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, "int")
                } else if pop == lib::op_no_match {} else if pop == lib::op_try {
                    let pt_t = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    let pt_payload = if is_enum_enc(pt_t) {
                        let pt_var = enum_fields_resolve(pt_t, 0)
                        if len(pt_var) > 0 {
                            pt_var[0]
                        } else {
                            "int"
                        }
                    } else {
                        "int"
                    }
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, pt_payload)
                } else if pop == lib::op_get_field_name || pop == lib::op_get_field {
                    let pg_rt = if len(ptshadow_ps) > 0 {
                        ptshadow_ps[len(ptshadow_ps) - 1]
                    } else {
                        ""
                    }
                    let mut pg_field_t = "int"
                    if is_record_type(pg_rt) {
                        let pg_schema = record_schema(pg_rt)
                        let mut pg_idx = -1
                        if pop == lib::op_get_field_name {
                            let pg_cidx = read_u16(pcode, pit + 1)
                            let pg_name = const_str(ptfh, pg_cidx)
                            let mut pg_ei = 0
                            while pg_ei < len(record_encs) && pg_idx < 0 {
                                pg_idx = find_field_in_enc(record_encs[pg_ei], pg_name)
                                pg_ei = pg_ei + 1
                            }
                        } else {
                            pg_idx = pcode[pit + 1]
                        }
                        match get(record_field_types, pg_schema) {
                            Some(pg_ft) => {
                                if pg_idx >= 0 && pg_idx < len(pg_ft) {
                                    if pg_ft[pg_idx] == "str" {
                                        pg_field_t = "str"
                                    }
                                }
                            },
                            None => {},
                        }
                    } else if is_enum_enc(pg_rt) {
                        let pg_var = enum_fields_resolve(pg_rt, pcur_variant)
                        let pg_fidx = pcode[pit + 1]
                        if pg_fidx < len(pg_var) {
                            pg_field_t = pg_var[pg_fidx]
                        }
                    }
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                    push(pshadow_ps, "")
                    push(ptshadow_ps, pg_field_t)
                } else if pop == lib::op_record_update {
                    let pu_cidx = read_u16(pcode, pit + 2)
                    let pu_enc = const_str(ptfh, pu_cidx)
                    let pu_base = if len(ptshadow_ps) > pcode[pit + 1] {
                        ptshadow_ps[len(ptshadow_ps) - pcode[pit + 1] - 1]
                    } else {
                        "record"
                    }
                    shadow_pop(pshadow_ps, pcode[pit + 1] + 1)
                    shadow_pop(ptshadow_ps, pcode[pit + 1] + 1)
                    push(pshadow_ps, "")
                    if is_record_type(pu_base) {
                        push(ptshadow_ps, pu_base)
                    } else {
                        push(ptshadow_ps, "record:" + pu_enc)
                    }
                } else if pop == lib::op_defer {
                    shadow_pop(pshadow_ps, 1)
                    shadow_pop(ptshadow_ps, 1)
                } else if pop == lib::op_spawn || pop == lib::op_select {}
                if pop != lib::op_no_match && len(ptshadow_ps) > 0 {
                    let pdepth = len(ptshadow_ps) - 1
                    if pdepth < len(ppos_auth) && ppos_auth[pdepth] {
                        // 已由 set_local 权威设置，跳过栈顶启发式写入
                        // skip the stack-top heuristic write for slots set authoritatively by set_local
                    } else {
                        while len(ppos_types) <= pdepth {
                            push(ppos_types, "")
                        }
                        ppos_types[pdepth] = merge_pos(ppos_types[pdepth], ptshadow_ps[len(ptshadow_ps) - 1])
                    }
                }
                pit = pit + inst_len(ptfh, pcode, pit)
            }
            push(p_depth_maps, p_depth_at)
            pti = pti - 1
        }
        round = round + 1
    }

    let mut funcs_bytes = ""
    let mut func_offsets = []
    let mut fh = 0
    while fh < nfn {
        push(func_offsets, str_len(funcs_bytes))
        let code = f_code[fh]
        let arity = f_arity[fh]
        let locals = count_locals(fh)

        let mut out = []
        let mut patches = []
        let mut shadow = []
        let mut type_shadow = []
        let mut cur_variant = -1
        let mut global_type = map()
        let mut pos_types = []
        let mut pos_auth = []
        let mut seed = 0
        while seed < arity + 1 {
            push(shadow, "")
            push(type_shadow, "")
            push(pos_types, "")
            push(pos_auth, false)
            seed = seed + 1
        }
        let mut pseed_e = 1
        while pseed_e < arity + 1 {
            if pseed_e - 1 < len(fn_param_types[fh]) {
                pos_types[pseed_e] = fn_param_types[fh][pseed_e - 1]
            }
            // 参数槽的值在调用帧里（无 set_local）：标记权威
            // parameter slots hold values in the call frame (no set_local): mark them authoritative
            pos_auth[pseed_e] = true
            pseed_e = pseed_e + 1
        }
        let mut ip_to_byte = map()
        // w 追加字节 / w appends bytes
        // Append bytes
        fn w(s) {
            push(out, s)
        }
        // cur_byte 取当前字节位置 / cur_byte returns the current byte position
        // Current byte position
        fn cur_byte() {
            str_len(join(out, ""))
        }

        // emit_inst 发射单条指令 / emit_inst emits one instruction
        // Emit one instruction
        fn emit_inst(ip) {
            let op = code[ip]
            // 常量加载：int 立即数直接发射，其余走常量区指针
            // Constant load: int immediates inline; everything else via constant-area pointers
            if op == lib::op_const {
                let idx = read_u16(code, ip + 1)
                match f_consts[fh][idx] {
                    lib::CVal::CInt(v) => w(rex(1, 0, 0, rax) + e1(184) + e8s(v) + vs_push(rax)),
                    lib::CVal::CStr(_) => w(mov_ri64(rax, const_addr(fh, idx)) + vs_push(rax)),
                    lib::CVal::CEnumType(_) => w(mov_ri64(rax, const_addr(fh, idx)) + vs_push(rax)),
                    lib::CVal::CSingleton(_, _) => w(mov_ri64(rax, const_addr(fh, idx)) + vs_push(rax)),
                    lib::CVal::CCtor(_, _) => w(mov_ri64(rax, const_addr(fh, idx)) + vs_push(rax)),
                    lib::CVal::CFloat(fl) => w(x86gen_float_const(float_bits(fl))),
                    _ => w(int3()),
                }
                match f_consts[fh][idx] {
                    lib::CVal::CStr(_) => {
                        push(shadow, "str")
                        push(type_shadow, "str")
                    },
                    lib::CVal::CEnumType(_) => {
                        push(shadow, "enumtype")
                        push(type_shadow, "enumtype")
                    },
                    lib::CVal::CSingleton(seh, svi) => {
                        push(shadow, "ctor:" + str(seh) + ":" + str(svi))
                        push(type_shadow, "enum:e" + str(seh))
                    },
                    lib::CVal::CCtor(ceh, cvi) => {
                        push(shadow, "ctor:" + str(ceh) + ":" + str(cvi))
                        push(type_shadow, "ctor")
                    },
                    lib::CVal::CFloat(_) => {
                        push(shadow, "float")
                        push(type_shadow, "float")
                    },
                    _ => {
                        push(shadow, "")
                        push(type_shadow, "int")
                    },
                }
            } else if op == lib::op_unit {
                w(vs_push_zero())
                push(shadow, "")
                push(type_shadow, "unit")
            } else if op == lib::op_true {
                w(e1(73) + e1(199) + modrm(0, 0, r15) + e4(1) + add_ri32(r15, 8))
                push(shadow, "")
                push(type_shadow, "bool")
            } else if op == lib::op_false {
                w(vs_push_zero())
                push(shadow, "")
                push(type_shadow, "bool")
            } else if op == lib::op_pop {
                w(vs_pop_n(1))
                shadow_pop(shadow, 1)
                shadow_pop(type_shadow, 1)
            } else if op == lib::op_pop_n {
                let n = code[ip + 1]
                w(vs_pop_n(n))
                shadow_pop(shadow, n)
                shadow_pop(type_shadow, n)
            } else if op == lib::op_end_block {
                let n = code[ip + 1]
                w(mov_rm(rax, r15, 0 - 8) + sub_ri32(r15, 8 * (n + 1)) + mov_mr(r15, 0, rax) + add_ri32(r15, 8))
                let res_name = if len(shadow) > 0 {
                    shadow[len(shadow) - 1]
                } else {
                    ""
                }
                let res_type = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    "int"
                }
                shadow_pop(shadow, n + 1)
                shadow_pop(type_shadow, n + 1)
                push(shadow, res_name)
                push(type_shadow, res_type)
            } else if op == lib::op_get_local {
                let slot = read_u16(code, ip + 1)
                if slot == 0 {
                    w(vs_push_zero())
                    push(shadow, f_name[fh])
                    push(type_shadow, "")
                } else {
                    // 未初始化的 local（如 match 的 (match) 临时）采用当前栈顶类型并回写
                    // an uninitialized local (e.g. a match's (match) temp) takes the current stack-top type and writes it back
                    let mut stype = "int"
                    if slot < len(pos_types) && str_len(pos_types[slot]) > 0 {
                        stype = pos_types[slot]
                    } else if len(type_shadow) > 0 {
                        stype = type_shadow[len(type_shadow) - 1]
                        if slot >= len(pos_types) {
                            while len(pos_types) <= slot {
                                push(pos_types, "")
                            }
                        }
                        pos_types[slot] = stype
                    }
                    w(mov_rm(rax, r14, 8 * slot) + vs_push(rax))
                    push(shadow, "slot:" + str(slot))
                    push(type_shadow, stype)
                }
            } else if op == lib::op_set_local {
                let slot = read_u16(code, ip + 1)
                if slot > 0 && len(type_shadow) > 0 {
                    if len(pos_types) <= slot {
                        push(pos_types, "")
                    }
                    pos_types[slot] = type_shadow[len(type_shadow) - 1]
                    if len(pos_auth) <= slot {
                        while len(pos_auth) <= slot {
                            push(pos_auth, false)
                        }
                    }
                    pos_auth[slot] = true
                }
                w(mov_rm(rax, r15, 0 - 8) + mov_mr(r14, 8 * slot, rax))
            } else if op == lib::op_get_global {
                let idx = read_u16(code, ip + 1)
                let name = const_str(fh, idx)
                match get(globals_map, name) {
                    Some(slot) => w(mov_rm(rax, rbx, 8 * slot) + vs_push(rax)),
                    None => w(vs_push_zero()),
                }
                push(shadow, name)
                let gtype = match get(global_type, name) {
                    Some(t) => t,
                    None => "",
                }
                push(type_shadow, gtype)
            } else if op == lib::op_def_global {
                let idx = read_u16(code, ip + 1)
                let name = const_str(fh, idx)
                let slot = match get(globals_map, name) {
                    Some(s) => s,
                    None => 0,
                }
                let gtype = match len(type_shadow) {
                    0 => "",
                    _ => type_shadow[len(type_shadow) - 1],
                }
                put(global_type, name, gtype)
                w(mov_rm(rax, r15, 0 - 8) + mov_mr(rbx, 8 * slot, rax) + vs_pop_n(1))
                shadow_pop(shadow, 1)
                shadow_pop(type_shadow, 1)
            } else if op == lib::op_set_global {
                let idx = read_u16(code, ip + 1)
                let name = const_str(fh, idx)
                let slot = match get(globals_map, name) {
                    Some(s) => s,
                    None => 0,
                }
                w(mov_rm(rax, r15, 0 - 8) + mov_mr(rbx, 8 * slot, rax))
            } else if op == lib::op_eq {
                let sa_eq = if len(type_shadow) > 1 {
                    type_shadow[len(type_shadow) - 2]
                } else {
                    ""
                }
                let sb_eq = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    ""
                }
                if sa_eq == "str" && sb_eq == "str" {
                    w(x86gen_eq_str())
                } else if is_record_type(sa_eq) && is_record_type(sb_eq) {
                    let rq_schema = if str_len(record_schema(sa_eq)) > 0 {
                        record_schema(sa_eq)
                    } else {
                        record_schema(sb_eq)
                    }
                    match get(record_field_types, rq_schema) {
                        Some(ft) => w(x86gen_record_eq(ft)),
                        None => w(x86gen_record_eq([])),
                    }
                } else if is_enum_enc(sa_eq) && is_enum_enc(sb_eq) {
                    let eq_enc1 = enum_eq_enc(sa_eq)
                    let eq_enc2 = if str_len(eq_enc1) > 0 {
                        eq_enc1
                    } else {
                        enum_eq_enc(sb_eq)
                    }
                    w(x86gen_enum_eq_at(eq_enc2))
                } else if sa_eq == "float" && sb_eq == "float" {
                    w(x86gen_float_cmp("eq"))
                } else {
                    w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + sete(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
                }
                shadow_pop(shadow, 2)
                shadow_pop(type_shadow, 2)
                push(shadow, "")
                push(type_shadow, "bool")
            } else if op == lib::op_neq {
                let sa_neq = if len(type_shadow) > 1 {
                    type_shadow[len(type_shadow) - 2]
                } else {
                    ""
                }
                let sb_neq = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    ""
                }
                if sa_neq == "str" && sb_neq == "str" {
                    let cmp_body_neq = lea(rsi, rax, 8) + lea(rdi, rcx, 8) + mov_rr(rcx, rdx) + repe_cmpsb() + setne(r10)
                    w(mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + mov_rm(rdx, rax, 0) + mov_rm(r9, rcx, 0) + xor_rr(r10, r10) + cmp_rr(rdx, r9) + jne_rel32(str_len(cmp_body_neq)) + cmp_body_neq + mov_mr(r15, 0 - 16, r10) + vs_pop_n(1))
                } else if is_record_type(sa_neq) && is_record_type(sb_neq) {
                    let rn_schema = if str_len(record_schema(sa_neq)) > 0 {
                        record_schema(sa_neq)
                    } else {
                        record_schema(sb_neq)
                    }
                    match get(record_field_types, rn_schema) {
                        Some(ft) => w(x86gen_record_eq(ft) + mov_rm(rax, r15, 0 - 8) + test_rr(rax, rax) + sete(r8) + mov_mr(r15, 0 - 8, r8)),
                        None => w(x86gen_record_eq([]) + mov_rm(rax, r15, 0 - 8) + test_rr(rax, rax) + sete(r8) + mov_mr(r15, 0 - 8, r8)),
                    }
                } else if is_enum_enc(sa_neq) && is_enum_enc(sb_neq) {
                    let neq_enc1 = enum_eq_enc(sa_neq)
                    let neq_enc2 = if str_len(neq_enc1) > 0 {
                        neq_enc1
                    } else {
                        enum_eq_enc(sb_neq)
                    }
                    w(x86gen_enum_eq_at(neq_enc2) + mov_rm(rax, r15, 0 - 8) + test_rr(rax, rax) + sete(r8) + mov_mr(r15, 0 - 8, r8))
                } else if sa_neq == "float" && sb_neq == "float" {
                    w(x86gen_float_cmp("neq"))
                } else {
                    w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setne(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
                }
                shadow_pop(shadow, 2)
                shadow_pop(type_shadow, 2)
                push(shadow, "")
                push(type_shadow, "bool")
            } else if op == lib::op_gt {
                let s_gt = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    ""
                }
                if s_gt == "float" {
                    w(x86gen_float_cmp("gt"))
                } else {
                    w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setg(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
                }
                shadow_pop(shadow, 2)
                shadow_pop(type_shadow, 2)
                push(shadow, "")
                push(type_shadow, "bool")
            } else if op == lib::op_gt_eq {
                let s_ge = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    ""
                }
                if s_ge == "float" {
                    w(x86gen_float_cmp("ge"))
                } else {
                    w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setge(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
                }
                shadow_pop(shadow, 2)
                shadow_pop(type_shadow, 2)
                push(shadow, "")
                push(type_shadow, "bool")
            } else if op == lib::op_lt {
                let s_lt = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    ""
                }
                if s_lt == "float" {
                    w(x86gen_float_cmp("lt"))
                } else {
                    w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setl(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
                }
                shadow_pop(shadow, 2)
                shadow_pop(type_shadow, 2)
                push(shadow, "")
                push(type_shadow, "bool")
            } else if op == lib::op_lt_eq {
                let s_le = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    ""
                }
                if s_le == "float" {
                    w(x86gen_float_cmp("le"))
                } else {
                    w(xor_rr(rdx, rdx) + mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + cmp_rr(rax, rcx) + setle(rdx) + mov_mr(r15, 0 - 16, rdx) + vs_pop_n(1))
                }
                shadow_pop(shadow, 2)
                shadow_pop(type_shadow, 2)
                push(shadow, "")
                push(type_shadow, "bool")
            } else if op == lib::op_add {
                let sa = type_shadow[len(type_shadow) - 2]
                let sb = type_shadow[len(type_shadow) - 1]
                if sa == "str" || sb == "str" {
                    w(mov_rm(rax, r15, 0 - 16) + mov_rm(r9, r15, 0 - 8) + mov_rm(rdx, rax, 0) + mov_rm(r10, r9, 0) + mov_rr(r11, r12) + mov_rr(rcx, rdx) + add_rr(rcx, r10) + mov_mr(r11, 0, rcx) + add_ri32(rcx, 8) + add_rr(r12, rcx) + lea(rsi, rax, 8) + lea(rdi, r11, 8) + mov_rr(rcx, rdx) + rep_movsb() + lea(rsi, r9, 8) + lea(rdi, r11, 8) + add_rr(rdi, rdx) + mov_rr(rcx, r10) + rep_movsb() + mov_mr(r15, 0 - 16, r11) + vs_pop_n(1))
                    shadow_pop(shadow, 2)
                    shadow_pop(type_shadow, 2)
                    push(shadow, "str")
                    push(type_shadow, "str")
                } else if sa == "float" && sb == "float" {
                    w(x86gen_float_binop("add"))
                    shadow_pop(shadow, 2)
                    shadow_pop(type_shadow, 2)
                    push(shadow, "float")
                    push(type_shadow, "float")
                } else {
                    w(mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + add_rr(rax, rcx) + mov_mr(r15, 0 - 16, rax) + vs_pop_n(1))
                    shadow_pop(shadow, 2)
                    shadow_pop(type_shadow, 2)
                    push(shadow, "")
                    push(type_shadow, "int")
                }
            } else if op == lib::op_sub {
                let s_sub = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    ""
                }
                if s_sub == "float" {
                    w(x86gen_float_binop("sub"))
                    shadow_pop(shadow, 2)
                    shadow_pop(type_shadow, 2)
                    push(shadow, "float")
                    push(type_shadow, "float")
                } else {
                    w(mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + sub_rr(rax, rcx) + mov_mr(r15, 0 - 16, rax) + vs_pop_n(1))
                    shadow_pop(shadow, 2)
                    shadow_pop(type_shadow, 2)
                    push(shadow, "")
                    push(type_shadow, "int")
                }
            } else if op == lib::op_mul {
                let s_mul = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    ""
                }
                if s_mul == "float" {
                    w(x86gen_float_binop("mul"))
                    shadow_pop(shadow, 2)
                    shadow_pop(type_shadow, 2)
                    push(shadow, "float")
                    push(type_shadow, "float")
                } else {
                    w(mov_rm(rax, r15, 0 - 16) + mov_rm(rcx, r15, 0 - 8) + imul_rr(rax, rcx) + mov_mr(r15, 0 - 16, rax) + vs_pop_n(1))
                    shadow_pop(shadow, 2)
                    shadow_pop(type_shadow, 2)
                    push(shadow, "")
                    push(type_shadow, "int")
                }
            } else if op == lib::op_div {
                let s_div = if len(type_shadow) > 0 {
                    type_shadow[len(type_shadow) - 1]
                } else {
                    ""
                }
                if s_div == "float" {
                    w(x86gen_float_binop("div"))
                    shadow_pop(shadow, 2)
                    shadow_pop(type_shadow, 2)
                    push(shadow, "float")
