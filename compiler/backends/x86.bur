// x86gen_parse_int_native 内联 parse_int：带符号十进制扫描 + 逐位溢出检查
// x86gen_parse_int_native inlines parse_int: signed decimal scan with digit-wise overflow checks
// parse_int inline: signed decimal scan with per-digit overflow checks
fn x86gen_parse_int_native() {
    let trim = x86gen_trim_native()
    let head = mov_rm(r9, r15, 0 - 8) + mov_rm(r8, r9, 0) + lea(rsi, r9, 8) + mov_rr(rdi, rsi) + add_rr(rdi, r8) + mov_ri64(r11, 1) + xor_rr(r10, r10)
    let none = mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + add_ri32(r12, 16) + mov_mr(r15, 0 - 8, rcx)
    let positive = mov_rr(rax, r10) + mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 0) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 8, rcx) + jmp_rel32(str_len(none))
    let success_neg = neg_r(r10)
    let success = test_rr(r11, r11) + jge_rel32(str_len(success_neg)) + success_neg
    let accumulate = mov_rm(rax, rsi, 0) + mov_ri64(rcx, 255) + and_rr(rax, rcx) + sub_ri32(rax, 48) + mov_ri64(rcx, 10) + imul_rr(r10, rcx) + add_rr(r10, rax) + add_ri32(rsi, 1)
    let overflow_check = mov_rr(rdx, rax) + mov_rr(rax, r8) + sub_rr(rax, rdx) + xor_rr(rdx, rdx) + mov_ri64(rcx, 10) + div_r(rcx) + cmp_rr(r10, rax) + ja_rel32(str_len(accumulate) + 5 + str_len(success) + str_len(positive))
    let digit_parse = mov_rm(rax, rsi, 0) + mov_ri64(rcx, 255) + and_rr(rax, rcx) + sub_ri32(rax, 48) + mov_ri64(rcx, 9) + cmp_rr(rax, rcx) + ja_rel32(str_len(overflow_check) + str_len(accumulate) + 5 + str_len(success) + str_len(positive))
    let loop_head = cmp_rr(rsi, rdi) + jae_rel32(str_len(digit_parse) + str_len(overflow_check) + str_len(accumulate) + 5)
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(digit_parse) + str_len(overflow_check) + str_len(accumulate) + 5))
    let limit_neg = add_ri32(r8, 1)
    let limit_set = mov_ri64(r8, 9223372036854775807) + test_rr(r11, r11) + jge_rel32(str_len(limit_neg))
    let digit_check = cmp_rr(rsi, rdi) + jae_rel32(str_len(limit_set) + str_len(limit_neg) + str_len(loop_head) + str_len(digit_parse) + str_len(overflow_check) + str_len(accumulate) + 5 + str_len(success) + str_len(positive))
    let minus = mov_ri64(r11, 1) + neg_r(r11) + add_ri32(rsi, 1)
    let plus = add_ri32(rsi, 1) + jmp_rel32(str_len(minus))
    let sign_jmp = jmp_rel32(str_len(plus) + str_len(minus))
    let minus_cmp = mov_ri64(rcx, 45) + cmp_rr(rax, rcx) + je_rel32(str_len(sign_jmp) + str_len(plus))
    let sign_read = mov_rm(rax, rsi, 0) + mov_ri64(rcx, 255) + and_rr(rax, rcx) + mov_ri64(rcx, 43) + cmp_rr(rax, rcx) + je_rel32(str_len(minus_cmp) + str_len(sign_jmp))
    let empty_check = cmp_rr(rsi, rdi) + jae_rel32(str_len(sign_read) + str_len(minus_cmp) + str_len(sign_jmp) + str_len(plus) + str_len(minus) + str_len(digit_check) + str_len(limit_set) + str_len(limit_neg) + str_len(loop_head) + str_len(digit_parse) + str_len(overflow_check) + str_len(accumulate) + 5 + str_len(success) + str_len(positive))
    trim + head + empty_check + sign_read + minus_cmp + sign_jmp + plus + minus + digit_check + limit_set + limit_neg + loop_head + digit_parse + overflow_check + accumulate + back + success + positive + none
}

// x86gen_split_native 内联 split：按分隔符拆分 / x86gen_split_native inlines split: divide by a separator
// split inline: split on a separator
fn x86gen_split_native() {
    let push = mov_mr(r15, 0 - 24, r12) + mov_rr(rdi, r12) + mov_mr(rdi, 0, rcx) + mov_rr(rsi, r9) + add_rr(rsi, rdx) + add_ri32(rsi, 8) + mov_rr(rdi, r12) + add_ri32(rdi, 8) + mov_rm(rcx, r15, 0 - 24) + mov_rm(rcx, rcx, 0) + rep_movsb() + mov_rm(rcx, r15, 0 - 24) + mov_rm(rcx, rcx, 0) + add_rr(r12, rcx) + add_ri32(r12, 8) + mov_rm(rdi, r15, 0 - 8) + mov_rm(rsi, r15, 0 - 24) + mov_mr(rdi, 0, rsi) + add_ri32(rdi, 8) + mov_mr(r15, 0 - 8, rdi)
    let done = mov_rr(rcx, r8) + sub_rr(rcx, rdx) + push + mov_rm(rdi, r15, 0 - 16) + mov_rm(rsi, r15, 0 - 8) + sub_rr(rsi, rdi) + sub_ri32(rsi, 24) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shr_rcl(rsi) + mov_mr(rdi, 0, rsi) + mov_mr(r15, 0 - 24, rdi) + vs_pop_n(2)
    let matched = mov_rr(rcx, rax) + sub_rr(rcx, rdx) + push + mov_rm(r11, r10, 0) + add_rr(rax, r11) + mov_rr(rdx, rax)
    let no_match = add_ri32(rax, 1)
    let loop_tail = mov_rr(rsi, r9) + add_rr(rsi, rax) + add_ri32(rsi, 8) + mov_rr(rdi, r10) + add_ri32(rdi, 8) + mov_rr(rcx, r11) + repe_cmpsb() + je_rel32(str_len(no_match) + 5)
    let cond_ja = mov_rm(r11, r10, 0) + mov_rr(rcx, rax) + add_rr(rcx, r11) + cmp_rr(rcx, r8) + ja_rel32(str_len(loop_tail) + str_len(no_match) + 5 + str_len(matched) + 5)
    let cond_je = test_rr(r11, r11) + je_rel32(str_len(cond_ja) + str_len(loop_tail) + str_len(no_match) + 5 + str_len(matched) + 5)
    let loop_head = cond_je + cond_ja + loop_tail
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(no_match) + 5))
    let matched_back = jmp_rel32(0 - (str_len(loop_head) + str_len(no_match) + 5 + str_len(matched) + 5))
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_rm(r8, r9, 0) + mov_rm(r11, r10, 0) + mov_rr(rdi, r12) + xor_rr(rax, rax) + mov_mr(rdi, 0, rax) + mov_mr(rdi, 8, rax) + mov_mr(rdi, 16, rax) + mov_rr(rdx, r8) + add_ri32(rdx, 1) + mov_mr(rdi, 8, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rdx) + add_ri32(rdx, 24) + mov_rr(rax, rdi) + add_ri32(rax, 24) + mov_mr(rdi, 16, rax) + add_rr(r12, rdx) + mov_mr(r15, 0 - 16, rdi) + mov_rr(rsi, rdi) + add_ri32(rsi, 24) + mov_mr(r15, 0 - 8, rsi) + xor_rr(rax, rax) + xor_rr(rdx, rdx)
    head + loop_head + no_match + back + matched + matched_back + done
}

// x86gen_str_find_native 内联 str_contains/str_index_of：子串查找
// x86gen_str_find_native inlines str_contains/str_index_of: substring search
// str_contains/str_index_of inline: substring search
fn x86gen_str_find_native(as_option) {
    let some = if as_option {
        mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 0) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    } else {
        mov_ri64(rax, 1) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2)
    }
    let none = if as_option {
        mov_rr(rcx, r12) + mov_ri64(rdx, 0) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + add_ri32(r12, 16) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2) + jmp_rel32(str_len(some))
    } else {
        mov_ri64(rax, 0) + mov_mr(r15, 0 - 24, rax) + vs_pop_n(2) + jmp_rel32(str_len(some))
    }
    let next = add_ri32(rax, 1)
    let loop_tail = mov_rr(rsi, r9) + add_rr(rsi, rax) + add_ri32(rsi, 8) + mov_rr(rdi, r10) + add_ri32(rdi, 8) + mov_rr(rcx, r11) + test_rr(rcx, rcx) + repe_cmpsb() + je_rel32(str_len(next) + 5 + str_len(none))
    let loop_head = mov_rr(rcx, rax) + add_rr(rcx, r11) + cmp_rr(rcx, r8) + ja_rel32(str_len(loop_tail) + str_len(next) + 5) + loop_tail
    let back = jmp_rel32(0 - (str_len(loop_head) + str_len(next) + 5))
    let head = mov_rm(r9, r15, 0 - 16) + mov_rm(r10, r15, 0 - 8) + mov_rm(r8, r9, 0) + mov_rm(r11, r10, 0) + xor_rr(rax, rax)
    head + loop_head + next + back + none + some
}

// x86gen_map_native 内联 map()：空 map / x86gen_map_native inlines map(): an empty map
// map() inline: empty map
fn x86gen_map_native() {
    mov_rr(r11, r12) + xor_rr(rdx, rdx) + mov_mr(r11, 0, rdx) + mov_mr(r11, 8, rdx) + mov_mr(r11, 16, rdx) + mov_mr(r11, 24, rdx) + add_ri32(r12, 32) + mov_mr(r15, 0 - 8, r11)
}

// x86gen_args_native 内联 args：读启动栈 argv，构造 str 列表（排除 argv[0]）
// x86gen_args_native inlines args: read argv from the startup stack, build a string list (excluding argv[0])
// args inline: read argv from the startup stack (excluding argv[0])
fn x86gen_args_native() {
    let head = mov_rm(rax, rbx, 0 - 8) + mov_rm(r8, rax, 0) + sub_ri32(r8, 1) + mov_rr(r11, r12) + mov_mr(r11, 0, r8) + mov_mr(r11, 8, r8) + lea(r10, r11, 24) + mov_mr(r11, 16, r10) + mov_rr(rcx, r8) + xor_rr(r9, r9) + add_ri32(r9, 3) + shl_rcl(rcx) + add_ri32(rcx, 24) + add_rr(r12, rcx) + xor_rr(rdx, rdx)
    let load = mov_rr(rsi, rdx) + xor_rr(rcx, rcx) + add_ri32(rcx, 3) + shl_rcl(rsi) + add_rr(rsi, rax) + add_ri32(rsi, 16) + mov_rm(rsi, rsi, 0)
    let sl_test = e1(128) + e1(62) + e1(0)
    let sl_yes = add_ri32(rsi, 1) + add_ri32(r9, 1)
    let sl_je = je_rel32(str_len(sl_yes) + 5)
    let sl_loop = sl_test + sl_je + sl_yes + jmp_rel32(0 - (str_len(sl_test) + str_len(sl_je) + str_len(sl_yes) + 5))
    let mkstr = sub_rr(rsi, r9) + mov_rr(rcx, r12) + mov_mr(rcx, 0, r9) + lea(rdi, rcx, 8) + add_rr(r12, r9) + add_ri32(r12, 8) + mov_mr(r10, 0, rcx) + add_ri32(r10, 8) + mov_rr(rcx, r9) + rep_movsb()
    let body = load + xor_rr(r9, r9) + sl_loop + mkstr + add_ri32(rdx, 1)
    let test = cmp_rr(rdx, r8) + jae_rel32(str_len(body) + 5)
    let back = jmp_rel32(0 - (str_len(test) + str_len(body) + 5))
    head + test + body + back + mov_mr(r15, 0 - 8, r11)
}

// x86gen_nul_path_at 拷贝 [r15+off] 的 str 到 bump 分配缓冲并补 NUL，r11 返回路径指针
// x86gen_nul_path_at copies the str at [r15+off] to a bump-allocated buffer with a NUL; r11 holds the path
// NUL-terminated path copy at [r15+off]; r11 returns the path pointer
fn x86gen_nul_path_at(off) {
    let nul_write = xor_rr(rax, rax) + e1(136) + e1(7) + add_rr(r12, r10) + add_ri32(r12, 1)
    let copy = mov_rm(r10, r9, 0) + mov_rr(r11, r12) + lea(rsi, r9, 8) + mov_rr(rdi, r11) + mov_rr(rcx, r10) + rep_movsb()
    mov_rm(r9, r15, off) + copy + nul_write
}

// x86gen_str_const_at 在堆上构造编译期字符串并写回 [r15+off] /
// x86gen_str_const_at builds a compile-time string on the heap and stores it at [r15+off]
fn x86gen_str_const_at(off, s) {
    let mut store = mov_rr(r11, r12) + mov_ri64(r9, str_len(s)) + mov_mr(r11, 0, r9) + lea(rdi, r11, 8)
    let mut ci = 0
    while ci < str_len(s) {
        store = store + mov_ri64(r10, byte_at(s, ci)) + mov_mr(rdi, 0, r10) + add_ri32(rdi, 1)
        ci = ci + 1
    }
    store = store + add_rr(r12, r9) + add_ri32(r12, 8) + mov_mr(r15, off, r11)
    store
}

// x86gen_file_exists_native 内联 file_exists：stat syscall，返回 bool
// x86gen_file_exists_native inlines file_exists: the stat syscall, returning a bool
// file_exists inline: stat syscall returning a bool
fn x86gen_file_exists_native() {
    let not_found = mov_ri64(rax, 0) + mov_mr(r15, 0 - 16, rax) + vs_pop_n(1)
    let found = mov_ri64(rax, 1) + mov_mr(r15, 0 - 16, rax) + vs_pop_n(1) + jmp_rel32(str_len(not_found))
    let head = x86gen_nul_path_at(0 - 8) + mov_rr(rdi, r11) + sub_ri32(rsp, 144) + mov_rr(rsi, rsp) + sys_mov_rax(4) + syscall() + add_ri32(rsp, 144)
    head + test_rr(rax, rax) + jne_rel32(str_len(found)) + found + not_found
}

// x86gen_read_file_native 内联 read_file：open/fstat/read/close syscall，返回 Result<str, str>
// x86gen_read_file_native inlines read_file: open/fstat/read/close syscalls, returning Result<str, str>
// read_file inline: open/fstat/read/close syscalls into Result<str, str>
fn x86gen_read_file_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 16, rcx) + vs_pop_n(1)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 16, rcx) + vs_pop_n(1)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let empty_str = mov_rr(r8, r12) + xor_rr(rdx, rdx) + mov_mr(r8, 0, rdx) + add_ri32(r12, 8) + mov_rr(rax, r8)
    let alloc = mov_rr(r8, r12) + mov_mr(r8, 0, r10) + lea(rax, r8, 8) + add_rr(r12, r10) + add_ri32(r12, 8)
    let fail1 = err_str + err_inst
    let fail2 = sys_mov_rax(3) + syscall() + err_str + err_inst
    let empty_path = sys_mov_rax(3) + syscall() + add_ri32(rsp, 144) + empty_str + ok_inst + jmp_rel32(str_len(fail2) + str_len(fail1))
    let read_seq = mov_rr(rsi, r8) + add_ri32(rsi, 8) + mov_rr(rdx, r10) + sys_mov_rax(0) + syscall() + mov_rr(rax, r8) + sys_mov_rax(3) + syscall() + add_ri32(rsp, 144) + mov_rr(rax, r8) + ok_inst + jmp_rel32(str_len(empty_path) + str_len(fail2) + str_len(fail1))
    let fstat_ok = mov_rm(r10, rsp, 48) + xor_rr(r9, r9) + cmp_rr(r10, r9) + jle_rel32(str_len(alloc) + str_len(read_seq)) + alloc + read_seq + empty_path
    let fstat_seq = mov_rr(rdi, rax) + sub_ri32(rsp, 144) + mov_rr(rsi, rsp) + sys_mov_rax(5) + syscall() + test_rr(rax, rax) + jl_rel32(str_len(fstat_ok)) + fstat_ok + fail2
    let open_fail = test_rr(rax, rax) + jl_rel32(str_len(fstat_seq)) + fstat_seq + fail1
    let head = x86gen_nul_path_at(0 - 8) + mov_rr(rdi, r11) + xor_rr(rsi, rsi) + xor_rr(rdx, rdx) + sys_mov_rax(2) + syscall() + open_fail
    head
}

// x86gen_write_file_native 内联 write_file：open/write/close syscall，返回 Result<unit, str>
// x86gen_write_file_native inlines write_file: open/write/close syscalls, returning Result<unit, str>
// write_file inline: open/write/close syscalls into Result<unit, str>
fn x86gen_write_file_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rdx) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let fail = err_str + err_inst
    let write_seq = mov_rm(r9, r15, 0 - 8) + mov_rr(rsi, r9) + add_ri32(rsi, 8) + mov_rm(rdx, r9, 0) + mov_rr(rdi, r8) + sys_mov_rax(1) + syscall() + sys_mov_rax(3) + syscall() + ok_inst + jmp_rel32(str_len(fail))
    let open_fail = test_rr(rax, rax) + jl_rel32(str_len(write_seq)) + write_seq + fail
    let head = x86gen_nul_path_at(0 - 16) + mov_rr(rdi, r11) + sys_mov_rsi(577) + sys_mov_rdx(420) + sys_mov_rax(2) + syscall() + mov_rr(r8, rax) + open_fail
    head
}

// x86gen_sleep_native 内联 sleep：nanosleep syscall，毫秒精度
// x86gen_sleep_native inlines sleep: the nanosleep syscall, millisecond precision
// sleep inline: nanosleep syscall with millisecond precision
fn x86gen_sleep_native() {
    let unit_ret = xor_rr(rax, rax) + mov_mr(r15, 0 - 16, rax) + vs_pop_n(1)
    let timespec = sub_ri32(rsp, 16) + mov_rr(rax, r9) + xor_rr(rdx, rdx) + mov_ri64(rcx, 1000) + div_r(rcx) + mov_mr(rsp, 0, rax) + mov_ri64(rcx, 1000000) + imul_rr(rdx, rcx) + mov_mr(rsp, 8, rdx) + mov_rr(rdi, rsp) + xor_rr(rsi, rsi) + sys_mov_rax(35) + syscall() + add_ri32(rsp, 16)
    let head = mov_rm(r9, r15, 0 - 8) + test_rr(r9, r9) + jle_rel32(str_len(timespec)) + timespec + unit_ret
    head
}

// x86gen_read_stdin_native 内联 read_stdin：read syscall，同步阻塞读 stdin 为 str
// x86gen_read_stdin_native inlines read_stdin: a synchronous read syscall into a str
// read_stdin inline: synchronous read of stdin into a str
fn x86gen_read_stdin_native() {
    let empty_str = mov_rr(r8, r12) + xor_rr(rdx, rdx) + mov_mr(r8, 0, rdx) + add_ri32(r12, 8) + mov_mr(r15, 0 - 16, r8) + vs_pop_n(1)
    let read_seq = mov_rr(r8, r12) + xor_rr(rdx, rdx) + mov_mr(r8, 0, rdx) + lea(rsi, r8, 8) + mov_rr(rdx, r9) + xor_rr(rdi, rdi) + sys_mov_rax(0) + syscall() + mov_mr(r8, 0, rax) + add_ri32(r12, 8) + add_rr(r12, rax) + mov_mr(r15, 0 - 16, r8) + vs_pop_n(1)
    let skip = jmp_rel32(str_len(empty_str))
    let head = mov_rm(r9, r15, 0 - 8) + test_rr(r9, r9) + jle_rel32(str_len(read_seq + skip)) + read_seq + skip + empty_str
    head
}

// x86gen_stdin_nb_native 内联 stdin_nb：fcntl 非阻塞 + 单次 read，返回 Result<str, str>
// x86gen_stdin_nb_native inlines stdin_nb: fcntl non-blocking plus a single read into Result<str, str>
// stdin_nb inline: fcntl non-blocking plus a single read into Result<str, str>
fn x86gen_stdin_nb_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 16, rcx) + vs_pop_n(1)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 16, rcx) + vs_pop_n(1)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let eagain_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 7955997313370251103) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let empty_str = mov_rr(r8, r12) + xor_rr(rdx, rdx) + mov_mr(r8, 0, rdx) + add_ri32(r12, 8)
    let empty_ok = empty_str + ok_inst
    let tail = add_rr(rsp, r9) + err_str + err_inst + jmp_rel32(str_len(empty_ok))
    let eagain_tail = add_rr(rsp, r9) + eagain_str + err_inst + jmp_rel32(str_len(tail) + str_len(empty_ok))
    let ok_tail = add_rr(rsp, r9) + ok_inst + jmp_rel32(str_len(eagain_tail) + str_len(tail) + str_len(empty_ok))
    let make_str = mov_rr(r8, r12) + mov_mr(r8, 0, rax) + mov_rr(rsi, rsp) + lea(rdi, r8, 8) + mov_rr(rcx, rax) + rep_movsb() + add_ri32(r12, 8) + add_rr(r12, rax)
    let errno_seq = mov_ri64(rdx, 11) + cmp_rr(rax, rdx) + je_rel32(str_len(mov_ri64(rdx, 4)) + str_len(cmp_rr(rax, rdx)) + str_len(je_rel32(0)) + str_len(jmp_rel32(0)) + str_len(make_str) + str_len(ok_tail)) + mov_ri64(rdx, 4) + cmp_rr(rax, rdx) + je_rel32(str_len(jmp_rel32(0)) + str_len(make_str) + str_len(ok_tail)) + jmp_rel32(str_len(make_str) + str_len(ok_tail) + str_len(eagain_tail))
    let read_seq = sub_rr(rsp, r9) + xor_rr(rdi, rdi) + mov_rr(rsi, rsp) + mov_rr(rdx, r9) + sys_mov_rax(0) + syscall() + test_rr(rax, rax) + jge_rel32(str_len(neg_r(rax)) + str_len(errno_seq)) + neg_r(rax) + errno_seq
    let read_path = read_seq + make_str + ok_tail + eagain_tail + tail
    let set_nonblock = xor_rr(rdi, rdi) + mov_ri64(rsi, 3) + xor_rr(rdx, rdx) + sys_mov_rax(72) + syscall() + mov_rr(r8, rax) + mov_ri64(rdx, 2048) + or_rr(rdx, r8) + xor_rr(rdi, rdi) + mov_ri64(rsi, 4) + sys_mov_rax(72) + syscall()
    let head = mov_rm(r9, r15, 0 - 8) + test_rr(r9, r9) + jle_rel32(str_len(set_nonblock) + str_len(read_path)) + set_nonblock + read_path + empty_ok
    head
}

// x86gen_parse_ip_at 解析 [r15+off] 的 str 为 IPv4 四字节（内存序）到 [rsp+0..3]
// 成功 rax=0，失败 rax=-1。寄存器：rsi 字符指针、rdi 结束、r8 移位数(0/8/16/24)、r9 累加、r10 段值、r11 段位数
// x86gen_parse_ip_at parses the str at [r15+off] as four IPv4 bytes (memory order) into [rsp]
// Returns rax=0 on success, rax=-1 on failure
fn x86gen_parse_ip_at(off) {
    let fail = mov_ri64(rax, -1)
    let s0 = xor_rr(r10, r10) + xor_rr(r11, r11)
    let d1cmp = cmp_rr(rsi, rdi)
    let d2a1 = mov_rm(rax, rsi, 0) + mov_ri64(rcx, 255) + and_rr(rax, rcx) + mov_ri64(rcx, 48) + cmp_rr(rax, rcx)
    let d2b1 = sub_ri32(rax, 48) + mov_ri64(rcx, 9) + cmp_rr(rax, rcx)
    let d3a = mov_ri64(rcx, 10) + imul_rr(r10, rcx) + add_rr(r10, rax) + add_ri32(r11, 1) + mov_ri64(rcx, 3) + cmp_rr(r11, rcx)
    let d4add = add_ri32(rsi, 1)
    let s1t = test_rr(r11, r11)
    let s2 = mov_ri64(rcx, 255) + cmp_rr(r10, rcx)
    let s3a = mov_rr(rcx, r8) + mov_rr(rax, r10) + shl_rcl(rax) + or_rr(r9, rax) + add_ri32(r8, 8)
    let s3cmp = cmp_rr(rsi, rdi)
    let s4a1 = mov_rm(rax, rsi, 0) + mov_ri64(rcx, 255) + and_rr(rax, rcx) + mov_ri64(rcx, 46) + cmp_rr(rax, rcx)
    let s4b1 = add_ri32(rsi, 1) + mov_ri64(rcx, 32) + cmp_rr(r8, rcx)
    let f1succ = mov_mr(rsp, 0, r9) + xor_rr(rax, rax) + jmp_rel32(str_len(fail))
    let f1jne = mov_ri64(rcx, 32) + cmp_rr(r8, rcx) + jne_rel32(str_len(f1succ))
    let d1jae = jae_rel32(str_len(d2a1) + 6 + str_len(d2b1) + 6 + str_len(d3a) + 6 + str_len(d4add) + 5)
    let d2ajl = jl_rel32(str_len(d2b1) + 6 + str_len(d3a) + 6 + str_len(d4add) + 5)
    let d2bja = ja_rel32(str_len(d3a) + 6 + str_len(d4add) + 5)
    let d4jmp = jmp_rel32(0 - (str_len(d1cmp) + 6 + str_len(d2a1) + 6 + str_len(d2b1) + 6 + str_len(d3a) + 6 + str_len(d4add) + 5))
    let s1je = je_rel32(str_len(s2) + 6 + str_len(s3a) + str_len(s3cmp) + 6 + str_len(s4a1) + 6 + str_len(s4b1) + 6 + 5 + str_len(f1jne) + str_len(f1succ))
    let s2ja = ja_rel32(str_len(s3a) + str_len(s3cmp) + 6 + str_len(s4a1) + 6 + str_len(s4b1) + 6 + 5 + str_len(f1jne) + str_len(f1succ))
    let s3je = je_rel32(str_len(s4a1) + 6 + str_len(s4b1) + 6 + 5)
    let s4ajne = jne_rel32(str_len(s4b1) + 6 + 5 + str_len(f1jne) + str_len(f1succ))
    let s4bjae = jae_rel32(5 + str_len(f1jne) + str_len(f1succ))
    let s5jmp = jmp_rel32(0 - (str_len(s0) + str_len(d1cmp) + 6 + str_len(d2a1) + 6 + str_len(d2b1) + 6 + str_len(d3a) + 6 + str_len(d4add) + 5 + str_len(s1t) + 6 + str_len(s2) + 6 + str_len(s3a) + str_len(s3cmp) + 6 + str_len(s4a1) + 6 + str_len(s4b1) + 6 + 5))
    let d3ja = ja_rel32(str_len(d4add) + 5 + str_len(s1t) + 6 + str_len(s2) + 6 + str_len(s3a) + str_len(s3cmp) + 6 + str_len(s4a1) + 6 + str_len(s4b1) + 6 + 5 + str_len(f1jne) + str_len(f1succ))
    let head = mov_rm(r9, r15, off) + mov_rr(rsi, r9) + add_ri32(rsi, 8) + mov_rm(rdi, r9, 0) + add_rr(rdi, rsi) + xor_rr(r8, r8) + xor_rr(r9, r9) + s0 + d1cmp + d1jae + d2a1 + d2ajl + d2b1 + d2bja + d3a + d3ja + d4add + d4jmp + s1t + s1je + s2 + s2ja + s3a + s3cmp + s3je + s4a1 + s4ajne + s4b1 + s4bjae + s5jmp + f1jne + f1succ + fail
    head
}

// x86gen_sockaddr_at 构建 sockaddr_in（AF_INET）到 [rsp+16..31]：r9 = port、[rsp+0..3] = IP 四字节
// x86gen_sockaddr_at builds an AF_INET sockaddr_in at [rsp+16..31]: r9 = port, [rsp+0..3] = four IP bytes
fn x86gen_sockaddr_at() {
    let f1 = mov_ri64(rax, 2) + mov_mr(rsp, 16, rax)
    let f2 = mov_rr(rax, r9) + mov_ri64(rcx, 8) + mov_rr(rdx, rax) + shr_rcl(rdx) + mov_ri64(rcx, 255) + and_rr(rdx, rcx) + and_rr(rax, rcx) + mov_ri64(rcx, 8) + shl_rcl(rdx) + or_rr(rax, rdx) + mov_mr(rsp, 18, rax)
    let f3 = mov_rm(rax, rsp, 0) + mov_mr(rsp, 20, rax)
    let f4 = xor_rr(rax, rax) + mov_mr(rsp, 24, rax)
    f1 + f2 + f3 + f4
}

// x86gen_tcp_listen_native 内联 tcp_listen：socket/bind/listen syscalls，返回 Result<int, str>
// x86gen_tcp_listen_native inlines tcp_listen: socket/bind/listen syscalls, returning Result<int, str>
fn x86gen_tcp_listen_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let fail = err_str + err_inst + add_ri32(rsp, 32)
    let fail_close = mov_rr(rdi, r9) + sys_mov_rax(3) + syscall() + fail
    let listen_ok = mov_rr(rax, r9) + ok_inst + add_ri32(rsp, 32) + jmp_rel32(str_len(fail_close))
    let listen_fail = test_rr(rax, rax) + jl_rel32(str_len(listen_ok))
    let listen_seq = mov_rr(rdi, r9) + mov_ri64(rsi, 128) + sys_mov_rax(50) + syscall()
    let bind_seq = mov_rr(rdi, r9) + lea(rsi, rsp, 16) + mov_ri64(rdx, 16) + sys_mov_rax(49) + syscall() + test_rr(rax, rax) + jl_rel32(str_len(listen_seq) + str_len(listen_fail) + str_len(listen_ok))
    let reuse_seq = mov_ri64(rax, 1) + mov_mr(rsp, 4, rax) + mov_rr(rdi, r9) + mov_ri64(rsi, 1) + mov_ri64(rdx, 2) + lea(r10, rsp, 4) + mov_ri64(r8, 4) + sys_mov_rax(54) + syscall()
    let socket_seq = mov_ri64(rdi, 2) + mov_ri64(rsi, 1) + xor_rr(rdx, rdx) + sys_mov_rax(41) + syscall() + mov_rr(r9, rax) + test_rr(rax, rax) + jl_rel32(str_len(reuse_seq) + str_len(bind_seq) + str_len(listen_seq) + str_len(listen_fail) + str_len(listen_ok))
    let sockaddr = x86gen_sockaddr_at()
    let ip_fail = test_rr(rax, rax) + jne_rel32(str_len(mov_rm(r9, r15, 0 - 8)) + str_len(sockaddr) + str_len(socket_seq) + str_len(reuse_seq) + str_len(bind_seq) + str_len(listen_seq) + str_len(listen_fail) + str_len(listen_ok))
    let head = sub_ri32(rsp, 32) + x86gen_parse_ip_at(0 - 16) + ip_fail + mov_rm(r9, r15, 0 - 8)
    head + sockaddr + socket_seq + reuse_seq + bind_seq + listen_seq + listen_fail + listen_ok + fail_close
}

// x86gen_tcp_accept_native 内联 tcp_accept：阻塞式 accept syscall，返回 Result<int, str>
// x86gen_tcp_accept_native inlines tcp_accept: a blocking accept syscall, returning Result<int, str>
fn x86gen_tcp_accept_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 8, rcx) + vs_pop_n(1)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 8, rcx) + vs_pop_n(1)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let fail = err_str + err_inst
    let ok_path = ok_inst + jmp_rel32(str_len(fail))
    let accept_seq = mov_rm(rdi, r15, 0 - 8) + xor_rr(rsi, rsi) + xor_rr(rdx, rdx) + sys_mov_rax(43) + syscall() + test_rr(rax, rax) + jl_rel32(str_len(ok_path) + str_len(fail))
    accept_seq + ok_path + fail
}

// x86gen_tcp_dial_native 内联 tcp_dial：socket/connect syscalls，返回 Result<int, str>
// x86gen_tcp_dial_native inlines tcp_dial: socket/connect syscalls, returning Result<int, str>
fn x86gen_tcp_dial_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let fail = err_str + err_inst + add_ri32(rsp, 32)
    let fail_close = mov_rr(rdi, r9) + sys_mov_rax(3) + syscall() + fail
    let connect_ok = mov_rr(rax, r9) + ok_inst + add_ri32(rsp, 32) + jmp_rel32(str_len(fail_close))
    let connect_fail = test_rr(rax, rax) + jl_rel32(str_len(connect_ok))
    let connect_seq = mov_rr(rdi, r9) + lea(rsi, rsp, 16) + mov_ri64(rdx, 16) + sys_mov_rax(42) + syscall()
    let socket_seq = mov_ri64(rdi, 2) + mov_ri64(rsi, 1) + xor_rr(rdx, rdx) + sys_mov_rax(41) + syscall() + mov_rr(r9, rax) + test_rr(rax, rax) + jl_rel32(str_len(connect_seq) + str_len(connect_fail) + str_len(connect_ok))
    let sockaddr = x86gen_sockaddr_at()
    let ip_fail = test_rr(rax, rax) + jne_rel32(str_len(mov_rm(r9, r15, 0 - 8)) + str_len(sockaddr) + str_len(socket_seq) + str_len(connect_seq) + str_len(connect_fail) + str_len(connect_ok))
    let head = sub_ri32(rsp, 32) + x86gen_parse_ip_at(0 - 16) + ip_fail + mov_rm(r9, r15, 0 - 8)
    head + sockaddr + socket_seq + connect_seq + connect_fail + connect_ok + fail_close
}

// x86gen_net_read_native 内联 net_read：read syscall 进新 str，返回 Result<str, str>
// x86gen_net_read_native inlines net_read: a read syscall into a fresh str, returning Result<str, str>
fn x86gen_net_read_native() {
    let ok_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + xor_rr(rdx, rdx) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, rax) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_inst = mov_rr(rcx, r12) + mov_ri64(rdx, 1) + mov_mr(rcx, 0, rdx) + mov_ri64(rdx, 1) + mov_mr(rcx, 8, rdx) + mov_mr(rcx, 16, r8) + add_ri32(r12, 24) + mov_mr(r15, 0 - 24, rcx) + vs_pop_n(2)
    let err_str = mov_rr(r8, r12) + mov_ri64(r10, 8) + mov_mr(r8, 0, r10) + mov_ri64(rdx, 8245935278387131247) + mov_mr(r8, 8, rdx) + add_ri32(r12, 16)
    let fail = err_str + err_inst
    let ok_path = mov_mr(r8, 0, rax) + mov_rr(rax, r8) + ok_inst + jmp_rel32(str_len(fail))
    let read_seq = mov_rm(rdi, r15, 0 - 16) + mov_rr(rdx, r10) + sys_mov_rax(0) + syscall() + test_rr(rax, rax) + jl_rel32(str_len(ok_path) + str_len(fail)) + ok_path
    let alloc_seq = mov_rr(r10, r11) + mov_rr(r8, r12) + mov_mr(r8, 0, r10) + lea(rsi, r8, 8) + add_rr(r12, r10) + add_ri32(r12, 8)
    let empty_ok = mov_rr(r8, r12) + xor_rr(rdx, rdx) + mov_mr(r8, 0, rdx) + add_ri32(r12, 8) + mov_rr(rax, r8) + ok_inst + jmp_rel32(str_len(alloc_seq) + str_len(read_seq) + str_len(ok_path) + str_len(fail))
    let max_seq = mov_rm(r11, r15, 0 - 8) + test_rr(r11, r11) + jl_rel32(str_len(empty_ok) + str_len(alloc_seq) + str_len(read_seq) + str_len(ok_path) + str_len(fail)) + je_rel32(str_len(empty_ok))
    max_seq + empty_ok + alloc_seq + read_seq + ok_path + fail
