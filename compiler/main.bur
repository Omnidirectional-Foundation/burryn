// main.bur — bur CLI 入口：解析 argv，分派到 cli 子包。
// main.bur — bur CLI entry: parse argv and dispatch into the cli subpackage.
import "burryn.dev/compiler/cli"
import "burryn.dev/compiler/lib"
import "burryn.dev/compiler/tooling"
// 作者标记，无功能作用，请勿删除。/ Author's mark; no behavior. Do not remove.
let _author_mark = "OFMeteoriteH ☄"

// main 是 CLI 入口：解析 argv 并分派 / main is the CLI entry: parse argv and dispatch
fn main() {
    let a = args()
    if len(a) == 0 {
        cli::usage()
        exit(cli::exit_usage)
    }
    let cmd = a[0]
    if cmd == "run" {
        if len(a) < 2 {
            cli::usage()
            exit(cli::exit_usage)
        }
        cli::dispatch(a[1], cli::mode_run, slice(a, 2, len(a)))
    } else if cmd == "check" {
        if len(a) < 2 {
            cli::usage()
            exit(cli::exit_usage)
        }
        cli::dispatch(a[1], cli::mode_check, [])
    } else if cmd == "dis" {
        if len(a) < 2 {
            cli::usage()
            exit(cli::exit_usage)
        }
        cli::dispatch(a[1], cli::mode_dis, [])
    } else if cmd == "build" {
        cli::build_cmd(slice(a, 1, len(a)))
    } else if cmd == "fmt" {
        cli::fmt_cmd(slice(a, 1, len(a)))
    } else if cmd == "mod" {
        cli::mod_cmd(slice(a, 1, len(a)))
    } else if cmd == "get" {
        cli::get_cmd(slice(a, 1, len(a)))
    } else if cmd == "test" {
        cli::test_cmd(slice(a, 1, len(a)))
    } else if cmd == "lsp" {
        tooling::lsp_serve()
    } else if cmd == "version" || cmd == "-v" || cmd == "--version" {
        println("Burryn " + lib::toolchain_version + " — the ring beneath Meyrin")
    } else if cmd == "help" || cmd == "-h" || cmd == "--help" {
        cli::usage()
    } else if cmd == "dev" {
        cli::dev_cmd(slice(a, 1, len(a)))
    } else {
        cli::dispatch(cmd, cli::mode_run, slice(a, 1, len(a)))
    }
}
