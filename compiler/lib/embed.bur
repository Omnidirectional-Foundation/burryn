// embed.bur — std 嵌入表：读取 std/ 源码序列化进 std_embed.bur，并提供查表入口。
// The std embed table: serializes std/ sources into std_embed.bur and reads them back.

// embed_std 生成 std_embed.bur（std/ 源码序列化）
// embed_std generates std_embed.bur (serialized std/ sources)
pub fn embed_std(root) {
    let std_dir = root + "/std"
    let out_path = root + "/compiler/lib/std_embed.bur"
    let sep = chr(31)
    match read_dir(std_dir) {
        Ok(entries) => {
            let collected = collect_std_modules(std_dir, entries)
            match collected {
                Ok(triples) => {
                    let paths = triples[0]
                    let file_rels = triples[1]
                    let contents = triples[2]
                    let generated = render_embed(paths, file_rels, contents, sep)
                    match write_file(out_path, generated) {
                        Ok(_) => Ok(""),
                        Err(msg) => Err("cannot write " + out_path + ": " + msg),
                    }
                },
                Err(msg) => Err(msg),
            }
        },
        Err(msg) => Err("cannot read " + std_dir + ": " + msg),
    }
}

// escape_lit 字符串转义（嵌入表用）/ escape_lit escapes a string (embed table)
fn escape_lit(s) {
    let mut out = ""
    let mut i = 0
    while i < str_len(s) {
        let c = substr(s, i, 1)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\"" {
            out = out + "\\\""
        } else if c == chr(10) {
            out = out + "\\n"
        } else if c == chr(9) {
            out = out + "\\t"
        } else if c == chr(13) {
            out = out + "\" + chr(13) + \""
        } else if c == chr(31) {
            out = out + "\" + chr(31) + \""
        } else if c == chr(123) {
            out = out + "\" + chr(123) + \""
        } else {
            out = out + c
        }
        i = i + 1
    }
    out
}

// render_embed 渲染嵌入表 / render_embed renders the embed table
fn render_embed(paths, file_rels, contents, sep) {
    let mut out = "// AUTO-GENERATED by `bur dev embed-std`. Do not edit by hand.\n"
    out = out + "// Std source table consumed by the module loader (module.bur).\n"
    out = out + "// Re-generate after any change under repo-root/std/ and cmp to detect drift.\n\n"

    out = out + "// std_embed_files 返回 import 路径到 sep 连接的文件列表的映射\n"
    out = out + "pub fn std_embed_files() " + chr(123) + "\n"
    out = out + "    let mut fs = map()\n"
    let per_mod = group_by_path(paths, file_rels, sep)
    let mut i = 0
    while i < len(per_mod) {
        let entry = per_mod[i]
        out = out + "    put(fs, \"" + escape_lit(entry[0]) + "\", \"" + escape_lit(entry[1]) + "\")\n"
        i = i + 1
    }
    out = out + "    fs\n"
    out = out + "}\n\n"

    out = out + "// std_embed_contents 返回 (path + chr(31) + rel) 到源码文本的映射\n"
    out = out + "pub fn std_embed_contents() " + chr(123) + "\n"
    out = out + "    let mut cs = map()\n"
    i = 0
    while i < len(paths) {
        let key = paths[i] + sep + file_rels[i]
        out = out + "    put(cs, \"" + escape_lit(key) + "\", \"" + escape_lit(contents[i]) + "\")\n"
        i = i + 1
    }
    out = out + "    cs\n"
    out = out + "}\n\n"

    out = out + "// std_embed_get returns the embedded source text for (path, rel),\n"
    out = out + "// or None if the pair is not in the table.\n"
    out = out + "pub fn std_embed_get(path, rel) " + chr(123) + "\n"
    out = out + "    get(std_embed_contents(), path + chr(31) + rel)\n"
    out = out + "}\n"
    out
}

// group_by_path 按路径分组 / group_by_path groups by path
fn group_by_path(paths, file_rels, sep) {
    let mut out = []
    let mut cur_path = ""
    let mut cur_joined = ""
    let mut i = 0
    while i < len(paths) {
        let p = paths[i]
        let f = file_rels[i]
        if p != cur_path {
            if cur_path != "" {
                push(out, [cur_path, cur_joined])
            }
            cur_path = p
            cur_joined = f
        } else {
            cur_joined = cur_joined + sep + f
        }
        i = i + 1
    }
    if cur_path != "" {
        push(out, [cur_path, cur_joined])
    }
    out
}

// collect_std_modules 收集 std 模块（目录级）/ collect_std_modules collects std modules (directory level)
fn collect_std_modules(std_dir, entries) {
    let mut paths = []
    let mut file_rels = []
    let mut contents = []
    for e in entries {
        if str_has_prefix(e, ".") {} else {
            let mod_dir = std_dir + "/" + e
            let is_dir = match read_dir(mod_dir) {
                Ok(_) => true,
                Err(_) => false,
            }
            if !is_dir {} else {
                let mod_file = mod_dir + "/bur.mod"
                match read_file(mod_file) {
                    Ok(mod_text) => {
                        let mod_path = parse_module_path(mod_text)
                        if mod_path == "" {
                            return Err(mod_file + ": no `module` directive")
                        }
                        match scan_std_module_files(mod_dir) {
                            Ok(rels) => {
                                for rel in rels {
                                    let full = if rel == "bur.mod" {
                                        mod_file
                                    } else {
                                        mod_dir + "/" + rel
                                    }
                                    match read_file(full) {
                                        Ok(text) => {
                                            push(paths, mod_path)
                                            push(file_rels, rel)
                                            push(contents, text)
                                        },
                                        Err(msg) => {
                                            return Err("cannot read " + full + ": " + msg)
                                        },
                                    }
                                }
                            },
                            Err(msg) => {
                                return Err(msg)
                            },
                        }
                    },
                    Err(msg) => {
                        return Err("cannot read " + mod_file + ": " + msg)
                    },
                }
            }
        }
    }
    Ok([paths, file_rels, contents])
}

// scan_std_module_files 扫描模块文件 / scan_std_module_files scans module files
fn scan_std_module_files(mod_dir) {
    let mut rels = []
    match walk_bur_files(mod_dir, "", rels) {
        Ok(_) => Ok(sort_strs_ins(rels)),
        Err(msg) => Err(msg),
    }
}

// parse_module_path 解析模块路径 / parse_module_path parses a module path
fn parse_module_path(text) {
    let mut out = ""
    for line in split(text, chr(10)) {
        let t = trim(line)
        if str_has_prefix(t, "module ") && out == "" {
            out = trim(substr(t, 7, str_len(t) - 7))
        }
    }
    out
}

// sort_strs_ins 大小写不敏感排序 / sort_strs_ins sorts case-insensitively
fn sort_strs_ins(xs) {
    let mut out = []
    let mut i = 0
    while i < len(xs) {
        let x = xs[i]
        let mut j = 0
        while j < len(out) && out[j] < x {
            j = j + 1
        }
        out = concat(concat(slice(out, 0, j), [x]), slice(out, j, len(out)))
        i = i + 1
    }
    out
}

// walk_bur_files 递归收集 .bur 文件 / walk_bur_files recursively collects .bur files
fn walk_bur_files(base, rel, mut acc) {
    let here = if rel == "" {
        base
    } else {
        base + "/" + rel
    }
    match read_dir(here) {
        Ok(entries) => {
            if rel == "" {
                push(acc, "bur.mod")
            }
            for e in entries {
                if str_has_prefix(e, ".") {} else {
                    let child_rel = if rel == "" {
                        e
                    } else {
                        rel + "/" + e
                    }
                    let full = here + "/" + e
                    let is_dir = match read_dir(full) {
                        Ok(_) => true,
                        Err(_) => false,
                    }
                    if !is_dir {
                        if is_bur_file(e) {
                            push(acc, child_rel)
                        }
                    } else {
                        match walk_bur_files(base, child_rel, acc) {
                            Ok(_) => {},
                            Err(msg) => {
                                return Err(msg)
                            },
                        }
                    }
                }
            }
            Ok("")
        },
        Err(msg) => Err("cannot read dir " + here + ": " + msg),
    }
}

// is_bur_file 判断是否为 .bur 文件 / is_bur_file tells whether a name is a .bur file
fn is_bur_file(name) {
    let n = str_len(name)
    if n < 4 || substr(name, n - 4, 4) != ".bur" {
        false
    } else if n >= 9 && substr(name, n - 9, 9) == "_test.bur" {
        false
    } else {
        true
    }
}

// std_embed_get returns the embedded source text for (path, rel),
// or None if the pair is not in the table.
pub fn std_embed_get(path, rel) {
    get(std_embed_contents(), path + chr(31) + rel)
}
