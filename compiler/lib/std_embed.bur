// std_embed_files 返回 import 路径到 sep 连接的文件列表的映射
pub fn std_embed_files() {
    let mut fs = map()
    put(fs, "std/cli", "bur.mod" + chr(31) + "cli.bur")
    put(fs, "std/crypto", "bur.mod" + chr(31) + "crypto.bur")
    put(fs, "std/encoding", "bur.mod" + chr(31) + "encoding.bur")
    put(fs, "std/json", "bur.mod" + chr(31) + "json.bur")
    put(fs, "std/log", "bur.mod" + chr(31) + "log.bur")
    put(fs, "std/net", "bur.mod" + chr(31) + "net.bur")
    put(fs, "std/path", "bur.mod" + chr(31) + "path.bur")
    put(fs, "std/testing", "bur.mod" + chr(31) + "testing.bur")
    fs
}

// std_embed_contents 返回 (path + chr(31) + rel) 到源码文本的映射
pub fn std_embed_contents() {
    let mut cs = map()
    put(cs, "std/cli" + chr(31) + "bur.mod", "module std/cli\n")
    put(cs, "std/cli" + chr(31) + "cli.bur", "// std/cli — 最小命令行参数解析（纯 Burryn，复用 args()）。\n// Minimal command-line flag parsing (pure Burryn, reuses args()).\n// --name value 或 --name=value；布尔旗标按出现与否判断。\n// Flags use --name value or --name=value; booleans are presence-based.\n\n// has_flag 判断旗标是否出现 / has_flag tells whether a flag is present\npub fn has_flag(argv, name) " + chr(123) + "\n    let target = \"--\" + name\n    let mut i = 0\n    while i < len(argv) " + chr(123) + "\n        let a = argv[i]\n        if a == target || str_index_of(a, target + \"=\") == Some(0) " + chr(123) + "\n            return true\n        }\n        i = i + 1\n    }\n    false\n}\n\n// get_flag 取旗标值（--name value 或 --name=value）\n// get_flag reads a flag value (--name value or --name=value)\n// Flag value (--name value or --name=value)\npub fn get_flag(argv, name) " + chr(123) + "\n    let target = \"--\" + name\n    let eq_prefix = target + \"=\"\n    let mut i = 0\n    while i < len(argv) " + chr(123) + "\n        let a = argv[i]\n        if str_index_of(a, eq_prefix) == Some(0) " + chr(123) + "\n            return Some(substr(a, str_len(eq_prefix), str_len(a) - str_len(eq_prefix)))\n        }\n        if a == target && i + 1 < len(argv) " + chr(123) + "\n            return Some(argv[i + 1])\n        }\n        i = i + 1\n    }\n    None\n}\n\n// positionals 取非旗标参数 / positionals collects non-flag arguments\n// Non-flag arguments\npub fn positionals(argv) " + chr(123) + "\n    let mut out = []\n    let mut i = 0\n    while i < len(argv) " + chr(123) + "\n        let a = argv[i]\n        if str_len(a) > 0 && byte_at(a, 0) == 45 " + chr(123) + "} else " + chr(123) + "\n            push(out, a)\n        }\n        i = i + 1\n    }\n    out\n}\n")
    put(cs, "std/crypto" + chr(31) + "bur.mod", "module std/crypto\n")
    put(cs, "std/crypto" + chr(31) + "crypto.bur", "// std/crypto — SHA-256 与十六进制摘要（纯 Burryn，零新 native）。\n// SHA-256 and hex digests (pure Burryn, zero new natives).\n// str 是文本不是字节串（chr 对 ≥ 0x80 的码点写 UTF-8 序列），因此摘要与消息\n// 内部全程用 [int] 字节表承载；输入按其 UTF-8 字节序列做哈希。语言表层没有\n// 位运算算子，32 位域用算术模拟：移位走 p2 幂表、AND 逐比特循环，值恒在\n// [0, 2^32) 内保持正数；规格见 FIPS 180-4。\n// A str is text, not bytes (chr writes UTF-8 sequences for codepoints >=\n// 0x80), so both message and digest travel as [int] byte lists; the input is\n// hashed as its UTF-8 byte sequence. The language surface has no bitwise\n// operators, so the 32-bit domain is emulated arithmetically: shifts through\n// the p2 power-of-two table, AND via a per-bit loop, values always kept in\n// [0, 2^32) and positive; see FIPS 180-4.\n\nlet h_init = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]\n\nlet k_round = [\n    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,\n    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,\n    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,\n    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,\n    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,\n    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,\n    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,\n    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,\n    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,\n    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,\n    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,\n]\n\n// p2 2 的幂表，p2[i] = 2^i（rotr 与组字共用） / p2 holds powers of two, p2[i] = 2^i (shared by rotr and word packing)\nlet p2 = [\n    1, 2, 4, 8, 16, 32, 64, 128,\n    256, 512, 1024, 2048, 4096, 8192, 16384, 32768,\n    65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608,\n    16777216, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824, 2147483648,\n]\n\n// band32 逐位与：低位起逐比特提取 / band32 computes bitwise AND by extracting bits from the low end\nfn band32(xa, xb) " + chr(123) + "\n    let mut a = xa\n    let mut b = xb\n    let mut out = 0\n    let mut bit = 1\n    let mut i = 0\n    while i < 32 " + chr(123) + "\n        if a % 2 == 1 && b % 2 == 1 " + chr(123) + "\n            out = out + bit\n        }\n        a = a / 2\n        b = b / 2\n        bit = bit * 2\n        i = i + 1\n    }\n    out\n}\n\n// bxor32 异或恒等式 a + b - 2(a & b) / bxor32 applies the identity a + b - 2(a & b)\nfn bxor32(xa, xb) " + chr(123) + "\n    (xa + xb) - 2 * band32(xa, xb)\n}\n\n// rotr32 循环右移：拆高低两半在 32 位域内拼回 / rotr32 rotates right: recombine the two halves within 32 bits\nfn rotr32(x, n) " + chr(123) + "\n    x / p2[n] + (x % p2[n]) * p2[32 - n]\n}\n\n// sha256 计算 32 字节摘要，返回 0-255 的 int 表 / sha256 computes the 32-byte digest as ints in 0-255\npub fn sha256(data) " + chr(123) + "\n    let n = str_len(data)\n    let mut bytes = []\n    let mut i = 0\n    while i < n " + chr(123) + "\n        push(bytes, byte_at(data, i))\n        i = i + 1\n    }\n    // 填充：0x80、零字节补到模 64 余 56、8 字节大端位长 / padding: 0x80, zero bytes to 56 mod 64, the 8-byte big-endian bit length\n    push(bytes, 128)\n    let r = (n + 1) % 64\n    let zeros = if r <= 56 " + chr(123) + "\n        56 - r\n    } else " + chr(123) + "\n        120 - r\n    }\n    let mut zi = 0\n    while zi < zeros " + chr(123) + "\n        push(bytes, 0)\n        zi = zi + 1\n    }\n    let mut v = n * 8\n    let mut lb = []\n    let mut bi = 0\n    while bi < 8 " + chr(123) + "\n        push(lb, v % 256)\n        v = v / 256\n        bi = bi + 1\n    }\n    let mut li = 7\n    while li >= 0 " + chr(123) + "\n        push(bytes, lb[li])\n        li = li - 1\n    }\n    let mut hs = []\n    for h0 in h_init " + chr(123) + "\n        push(hs, h0)\n    }\n    let nblocks = len(bytes) / 64\n    let mut blk = 0\n    while blk < nblocks " + chr(123) + "\n        // 消息表：前 16 字按大端组字，其余按公式扩展 / schedule: first 16 words packed big-endian, the rest expanded\n        let base = blk * 64\n        let mut w = []\n        let mut t = 0\n        while t < 16 " + chr(123) + "\n            let off = base + t * 4\n            push(w, bytes[off] * p2[24] + bytes[off + 1] * p2[16] + bytes[off + 2] * p2[8] + bytes[off + 3])\n            t = t + 1\n        }\n        while t < 64 " + chr(123) + "\n            let s0 = bxor32(bxor32(rotr32(w[t - 15], 7), rotr32(w[t - 15], 18)), w[t - 15] / 8)\n            let s1 = bxor32(bxor32(rotr32(w[t - 2], 17), rotr32(w[t - 2], 19)), w[t - 2] / 1024)\n            push(w, (w[t - 16] + s0 + w[t - 7] + s1) % 4294967296)\n            t = t + 1\n        }\n        let mut a = hs[0]\n        let mut b = hs[1]\n        let mut c = hs[2]\n        let mut d = hs[3]\n        let mut e = hs[4]\n        let mut f = hs[5]\n        let mut g = hs[6]\n        let mut hh = hs[7]\n        let mut rj = 0\n        while rj < 64 " + chr(123) + "\n            let s1 = bxor32(bxor32(rotr32(e, 6), rotr32(e, 11)), rotr32(e, 25))\n            let ch = bxor32(band32(e, f), band32(4294967295 - e, g))\n            let t1 = (hh + s1 + ch + k_round[rj] + w[rj]) % 4294967296\n            let s0 = bxor32(bxor32(rotr32(a, 2), rotr32(a, 13)), rotr32(a, 22))\n            let maj = bxor32(bxor32(band32(a, b), band32(a, c)), band32(b, c))\n            let t2 = (s0 + maj) % 4294967296\n            hh = g\n            g = f\n            f = e\n            e = (d + t1) % 4294967296\n            d = c\n            c = b\n            b = a\n            a = (t1 + t2) % 4294967296\n            rj = rj + 1\n        }\n        hs[0] = (hs[0] + a) % 4294967296\n        hs[1] = (hs[1] + b) % 4294967296\n        hs[2] = (hs[2] + c) % 4294967296\n        hs[3] = (hs[3] + d) % 4294967296\n        hs[4] = (hs[4] + e) % 4294967296\n        hs[5] = (hs[5] + f) % 4294967296\n        hs[6] = (hs[6] + g) % 4294967296\n        hs[7] = (hs[7] + hh) % 4294967296\n        blk = blk + 1\n    }\n    // 8 个 32 位字串成 32 字节大端 / serialize the 8 words into 32 big-endian bytes\n    let mut out = []\n    for hv in hs " + chr(123) + "\n        push(out, hv / p2[24] % 256)\n        push(out, hv / p2[16] % 256)\n        push(out, hv / p2[8] % 256)\n        push(out, hv % 256)\n    }\n    out\n}\n\n// sha256_hex 摘要的小写十六进制串 / sha256_hex returns the digest as lowercase hex\npub fn sha256_hex(data) " + chr(123) + "\n    let d = sha256(data)\n    let digits = \"0123456789abcdef\"\n    let mut out = \"\"\n    for b in d " + chr(123) + "\n        out = out + substr(digits, b / 16, 1) + substr(digits, b % 16, 1)\n    }\n    out\n}\n")
    put(cs, "std/encoding" + chr(31) + "bur.mod", "module std/encoding\n")
    put(cs, "std/encoding" + chr(31) + "encoding.bur", "// std/encoding — base64、hex 与百分号编码（纯 Burryn，零新 native）。\n// base64, hex, and percent-encoding (pure Burryn, zero new natives).\n\nlet b64_alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n\n// b64_val 取 base64 字符值 / b64_val decodes a base64 character value\n// Base64 character value\nfn b64_val(c) " + chr(123) + "\n    if c >= 65 && c <= 90 " + chr(123) + "\n        c - 65\n    } else if c >= 97 && c <= 122 " + chr(123) + "\n        c - 97 + 26\n    } else if c >= 48 && c <= 57 " + chr(123) + "\n        c - 48 + 52\n    } else if c == 43 " + chr(123) + "\n        62\n    } else if c == 47 " + chr(123) + "\n        63\n    } else " + chr(123) + "\n        -1\n    }\n}\n\n// base64_encode 做 base64 编码 / base64_encode encodes to base64\n// Base64 encode\npub fn base64_encode(data) " + chr(123) + "\n    let mut out = \"\"\n    let n = str_len(data)\n    let mut i = 0\n    while i + 2 < n " + chr(123) + "\n        let b0 = byte_at(data, i)\n        let b1 = byte_at(data, i + 1)\n        let b2 = byte_at(data, i + 2)\n        out = out + substr(b64_alphabet, b0 / 4, 1)\n        out = out + substr(b64_alphabet, b0 % 4 * 16 + b1 / 16, 1)\n        out = out + substr(b64_alphabet, b1 % 16 * 4 + b2 / 64, 1)\n        out = out + substr(b64_alphabet, b2 % 64, 1)\n        i = i + 3\n    }\n    if i + 1 == n " + chr(123) + "\n        let b0 = byte_at(data, i)\n        out = out + substr(b64_alphabet, b0 / 4, 1)\n        out = out + substr(b64_alphabet, b0 % 4 * 16, 1)\n        out = out + \"==\"\n    } else if i + 2 == n " + chr(123) + "\n        let b0 = byte_at(data, i)\n        let b1 = byte_at(data, i + 1)\n        out = out + substr(b64_alphabet, b0 / 4, 1)\n        out = out + substr(b64_alphabet, b0 % 4 * 16 + b1 / 16, 1)\n        out = out + substr(b64_alphabet, b1 % 16 * 4, 1)\n        out = out + \"=\"\n    }\n    out\n}\n\n// base64_decode 做 base64 解码（校验填充）/ base64_decode decodes base64 (validates padding)\n// Base64 decode (padding checked)\npub fn base64_decode(s) " + chr(123) + "\n    let n = str_len(s)\n    if n % 4 != 0 " + chr(123) + "\n        return Err(\"base64: input length is not a multiple of 4\")\n    }\n    let mut out = \"\"\n    let mut i = 0\n    while i < n " + chr(123) + "\n        let c0 = byte_at(s, i)\n        let c1 = byte_at(s, i + 1)\n        let c2 = byte_at(s, i + 2)\n        let c3 = byte_at(s, i + 3)\n        let v0 = b64_val(c0)\n        let v1 = b64_val(c1)\n        if v0 < 0 || v1 < 0 " + chr(123) + "\n            return Err(\"base64: invalid character at byte \" + str(i))\n        }\n        out = out + byte_chr(v0 * 4 + v1 / 16)\n        if c2 == 61 " + chr(123) + "\n            if c3 != 61 " + chr(123) + "\n                return Err(\"base64: invalid padding at byte \" + str(i + 2))\n            }\n            if i + 4 != n " + chr(123) + "\n                return Err(\"base64: padding before end of input\")\n            }\n        } else " + chr(123) + "\n            let v2 = b64_val(c2)\n            if v2 < 0 " + chr(123) + "\n                return Err(\"base64: invalid character at byte \" + str(i + 2))\n            }\n            out = out + byte_chr(v1 % 16 * 16 + v2 / 4)\n            if c3 == 61 " + chr(123) + "\n                if i + 4 != n " + chr(123) + "\n                    return Err(\"base64: padding before end of input\")\n                }\n            } else " + chr(123) + "\n                let v3 = b64_val(c3)\n                if v3 < 0 " + chr(123) + "\n                    return Err(\"base64: invalid character at byte \" + str(i + 3))\n                }\n                out = out + byte_chr(v2 % 4 * 64 + v3)\n            }\n        }\n        i = i + 4\n    }\n    Ok(out)\n}\n\n// hex_char 把字节转 16 进制字符 / hex_char renders a byte as a hex character\n// Hex character\nfn hex_char(b) " + chr(123) + "\n    if b < 10 " + chr(123) + "\n        chr(48 + b)\n    } else " + chr(123) + "\n        chr(87 + b)\n    }\n}\n\n// hex_val 把 16 进制字符转值 / hex_val decodes a hex character\n// Hex value\nfn hex_val(c) " + chr(123) + "\n    if c >= 48 && c <= 57 " + chr(123) + "\n        c - 48\n    } else if c >= 97 && c <= 102 " + chr(123) + "\n        c - 97 + 10\n    } else if c >= 65 && c <= 70 " + chr(123) + "\n        c - 65 + 10\n    } else " + chr(123) + "\n        -1\n    }\n}\n\n// hex_encode 做 hex 编码 / hex_encode encodes to hex\n// Hex encode\npub fn hex_encode(data) " + chr(123) + "\n    let mut out = \"\"\n    let mut i = 0\n    while i < str_len(data) " + chr(123) + "\n        let b = byte_at(data, i)\n        out = out + hex_char(b / 16) + hex_char(b % 16)\n        i = i + 1\n    }\n    out\n}\n\n// hex_decode 做 hex 解码 / hex_decode decodes hex\n// Hex decode\npub fn hex_decode(s) " + chr(123) + "\n    let n = str_len(s)\n    if n % 2 != 0 " + chr(123) + "\n        return Err(\"hex: odd-length input\")\n    }\n    let mut out = \"\"\n    let mut i = 0\n    while i < n " + chr(123) + "\n        let hi = hex_val(byte_at(s, i))\n        let lo = hex_val(byte_at(s, i + 1))\n        if hi < 0 || lo < 0 " + chr(123) + "\n            return Err(\"hex: invalid character at byte \" + str(i))\n        }\n        out = out + byte_chr(hi * 16 + lo)\n        i = i + 2\n    }\n    Ok(out)\n}\n\n// is_unreserved 判断是否不转义字符 / is_unreserved tells whether a byte is unreserved\n// Is an unreserved character\nfn is_unreserved(b) " + chr(123) + "\n    b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 45 || b == 95 || b == 46 || b == 126\n}\n\n// url_encode 做百分号编码 / url_encode percent-encodes\n// Percent-encode\npub fn url_encode(s) " + chr(123) + "\n    let mut out = \"\"\n    let mut i = 0\n    while i < str_len(s) " + chr(123) + "\n        let b = byte_at(s, i)\n        if is_unreserved(b) " + chr(123) + "\n            out = out + substr(s, i, 1)\n        } else " + chr(123) + "\n            out = out + \"%\" + hex_char(b / 16) + hex_char(b % 16)\n        }\n        i = i + 1\n    }\n    out\n}\n\n// url_decode 做百分号解码 / url_decode percent-decodes\n// Percent-decode\npub fn url_decode(s) " + chr(123) + "\n    let mut out = \"\"\n    let n = str_len(s)\n    let mut i = 0\n    while i < n " + chr(123) + "\n        let b = byte_at(s, i)\n        if b == 37 " + chr(123) + "\n            if i + 2 >= n " + chr(123) + "\n                return Err(\"url: incomplete percent-encoding at byte \" + str(i))\n            }\n            let hi = hex_val(byte_at(s, i + 1))\n            let lo = hex_val(byte_at(s, i + 2))\n            if hi < 0 || lo < 0 " + chr(123) + "\n                return Err(\"url: invalid percent-encoding at byte \" + str(i))\n            }\n            out = out + byte_chr(hi * 16 + lo)\n            i = i + 3\n        } else " + chr(123) + "\n            out = out + substr(s, i, 1)\n            i = i + 1\n        }\n    }\n    Ok(out)\n}\n")
    put(cs, "std/json" + chr(31) + "bur.mod", "module std/json\n")
    put(cs, "std/json" + chr(31) + "json.bur", "// std/json — 确定性 JSON 解析与渲染。\n// Deterministic JSON parsing and rendering.\n// JSON 字符串与解析偏移按 UTF-8 字节计，与语言的字符串索引规则一致。\n// JSON strings and parser offsets are measured in UTF-8 bytes, matching native string indexing.\npub enum Json " + chr(123) + "\n    JNull,\n    JBool(bool),\n    JInt(int),\n    JFloat(float),\n    JStr(str),\n    JArr([Json]),\n    JObj([str], [Json]),\n}\n\n// 解析中间结果：值 + 消费位置\n// Parse intermediate: value plus consumed position\nenum Parsed " + chr(123) + "\n    PValue(Json, int),\n}\n\n// 字符串解析中间结果\n// String parse intermediate\nenum ParsedStr " + chr(123) + "\n    PString(str, int),\n}\n\n// json_err 构造带字节偏移的错误消息 / json_err builds an error message with a byte offset\n// Error message with a byte offset\nfn json_err(pos, msg) " + chr(123) + "\n    \"json: byte \" + str(pos) + \": \" + msg\n}\n\n// skip_ws 跳过空白 / skip_ws skips whitespace\n// Skip whitespace\nfn skip_ws(s, mut pos) " + chr(123) + "\n    while pos < str_len(s) " + chr(123) + "\n        let b = byte_at(s, pos)\n        if b == 32 || b == 9 || b == 10 || b == 13 " + chr(123) + "\n            pos = pos + 1\n        } else " + chr(123) + "\n            return pos\n        }\n    }\n    pos\n}\n\n// has_at 判断位置处是否匹配字面量 / has_at tells whether a literal matches at the position\n// Does the literal match at pos\nfn has_at(s, pos, want) " + chr(123) + "\n    let n = str_len(want)\n    pos >= 0 && pos + n <= str_len(s) && substr(s, pos, n) == want\n}\n\n// hex_value 取 16 进制数字值 / hex_value decodes a hex digit\n// Hex digit value\nfn hex_value(b) " + chr(123) + "\n    if b >= 48 && b <= 57 " + chr(123) + "\n        b - 48\n    } else if b >= 65 && b <= 70 " + chr(123) + "\n        b - 65 + 10\n    } else if b >= 97 && b <= 102 " + chr(123) + "\n        b - 97 + 10\n    } else " + chr(123) + "\n        -1\n    }\n}\n\n// hex4 解析 \\uXXXX 转义 / hex4 parses a \\uXXXX escape\n// Parse a \\uXXXX escape\nfn hex4(s, pos) " + chr(123) + "\n    if pos + 4 > str_len(s) " + chr(123) + "\n        None\n    } else " + chr(123) + "\n        let a = hex_value(byte_at(s, pos))\n        let b = hex_value(byte_at(s, pos + 1))\n        let c = hex_value(byte_at(s, pos + 2))\n        let d = hex_value(byte_at(s, pos + 3))\n        if a < 0 || b < 0 || c < 0 || d < 0 " + chr(123) + "\n            None\n        } else " + chr(123) + "\n            Some(a * 4096 + b * 256 + c * 16 + d)\n        }\n    }\n}\n\n// parse_string 解析字符串：转义 + 代理对\n// parse_string parses a string: escapes plus surrogate pairs\n// String parsing: escapes and surrogate pairs\nfn parse_string(s, mut pos) " + chr(123) + "\n    let mut out = \"\"\n    pos = pos + 1\n    while pos < str_len(s) " + chr(123) + "\n        let b = byte_at(s, pos)\n        if b == 34 " + chr(123) + "\n            return Ok(PString(out, pos + 1))\n        }\n        if b < 32 " + chr(123) + "\n            return Err(json_err(pos, \"unescaped control byte in string\"))\n        }\n        if b != 92 " + chr(123) + "\n            out = out + substr(s, pos, 1)\n            pos = pos + 1\n        } else " + chr(123) + "\n            if pos + 1 >= str_len(s) " + chr(123) + "\n                return Err(json_err(pos, \"unfinished string escape\"))\n            }\n            let esc = byte_at(s, pos + 1)\n            if esc == 34 " + chr(123) + "\n                out = out + \"\\\"\"\n                pos = pos + 2\n            } else if esc == 92 " + chr(123) + "\n                out = out + \"\\\\\"\n                pos = pos + 2\n            } else if esc == 47 " + chr(123) + "\n                out = out + \"/\"\n                pos = pos + 2\n            } else if esc == 98 " + chr(123) + "\n                out = out + chr(8)\n                pos = pos + 2\n            } else if esc == 102 " + chr(123) + "\n                out = out + chr(12)\n                pos = pos + 2\n            } else if esc == 110 " + chr(123) + "\n                out = out + \"\\n\"\n                pos = pos + 2\n            } else if esc == 114 " + chr(123) + "\n                out = out + chr(13)\n                pos = pos + 2\n            } else if esc == 116 " + chr(123) + "\n                out = out + \"\\t\"\n                pos = pos + 2\n            } else if esc == 117 " + chr(123) + "\n                match hex4(s, pos + 2) " + chr(123) + "\n                    None => " + chr(123) + "\n                        return Err(json_err(pos, \"invalid unicode escape\"))\n                    },\n                    Some(code) => " + chr(123) + "\n                        if code >= 55296 && code <= 56319 " + chr(123) + "\n                            let next = pos + 6\n                            if next + 2 > str_len(s) || byte_at(s, next) != 92 || byte_at(s, next + 1) != 117 " + chr(123) + "\n                                return Err(json_err(pos, \"high surrogate needs a low surrogate\"))\n                            }\n                            match hex4(s, next + 2) " + chr(123) + "\n                                Some(low) => " + chr(123) + "\n                                    if low < 56320 || low > 57343 " + chr(123) + "\n                                        return Err(json_err(next, \"high surrogate needs a low surrogate\"))\n                                    }\n                                    out = out + chr(65536 + (code - 55296) * 1024 + low - 56320)\n                                    pos = next + 6\n                                },\n                                None => " + chr(123) + "\n                                    return Err(json_err(next, \"invalid unicode escape\"))\n                                },\n                            }\n                        } else if code >= 56320 && code <= 57343 " + chr(123) + "\n                            return Err(json_err(pos, \"low surrogate has no high surrogate\"))\n                        } else " + chr(123) + "\n                            out = out + chr(code)\n                            pos = pos + 6\n                        }\n                    },\n                }\n            } else " + chr(123) + "\n                return Err(json_err(pos, \"invalid string escape\"))\n            }\n        }\n    }\n    Err(json_err(pos, \"unterminated string\"))\n}\n\n// is_digit 判断是否数字 / is_digit tells whether a byte is a digit\n// Is a digit\nfn is_digit(b) " + chr(123) + "\n    b >= 48 && b <= 57\n}\n\n// parse_number 解析数字：int/float、前导零检查、指数\n// parse_number parses a number: int/float, leading-zero check, exponents\n// Number parsing: int/float, leading-zero check, exponents\nfn parse_number(s, mut pos) " + chr(123) + "\n    let start = pos\n    if byte_at(s, pos) == 45 " + chr(123) + "\n        pos = pos + 1\n        if pos >= str_len(s) " + chr(123) + "\n            return Err(json_err(pos, \"expected digit after minus\"))\n        }\n    }\n    if byte_at(s, pos) == 48 " + chr(123) + "\n        pos = pos + 1\n        if pos < str_len(s) && is_digit(byte_at(s, pos)) " + chr(123) + "\n            return Err(json_err(pos, \"leading zero in number\"))\n        }\n    } else if is_digit(byte_at(s, pos)) " + chr(123) + "\n        while pos < str_len(s) && is_digit(byte_at(s, pos)) " + chr(123) + "\n            pos = pos + 1\n        }\n    } else " + chr(123) + "\n        return Err(json_err(pos, \"expected digit\"))\n    }\n    let mut is_float = false\n    if pos < str_len(s) && byte_at(s, pos) == 46 " + chr(123) + "\n        is_float = true\n        pos = pos + 1\n        let frac_start = pos\n        while pos < str_len(s) && is_digit(byte_at(s, pos)) " + chr(123) + "\n            pos = pos + 1\n        }\n        if pos == frac_start " + chr(123) + "\n            return Err(json_err(pos, \"expected digit after decimal point\"))\n        }\n    }\n    if pos < str_len(s) && (byte_at(s, pos) == 69 || byte_at(s, pos) == 101) " + chr(123) + "\n        is_float = true\n        pos = pos + 1\n        if pos < str_len(s) && (byte_at(s, pos) == 43 || byte_at(s, pos) == 45) " + chr(123) + "\n            pos = pos + 1\n        }\n        let exp_start = pos\n        while pos < str_len(s) && is_digit(byte_at(s, pos)) " + chr(123) + "\n            pos = pos + 1\n        }\n        if pos == exp_start " + chr(123) + "\n            return Err(json_err(pos, \"expected exponent digits\"))\n        }\n    }\n    let raw = substr(s, start, pos - start)\n    if !is_float " + chr(123) + "\n        match parse_int(raw) " + chr(123) + "\n            Some(n) => " + chr(123) + "\n                return Ok(PValue(JInt(n), pos))\n            },\n            None => " + chr(123) + "},\n        }\n    }\n    match parse_float(raw) " + chr(123) + "\n        Some(f) => " + chr(123) + "\n            if f - f != 0.0 " + chr(123) + "\n                Err(json_err(start, \"number is outside the finite f64 range\"))\n            } else " + chr(123) + "\n                Ok(PValue(JFloat(f), pos))\n            }\n        },\n        None => Err(json_err(start, \"invalid number\")),\n    }\n}\n\n// parse_array 解析数组 / parse_array parses an array\n// Array parsing\nfn parse_array(s, mut pos) " + chr(123) + "\n    let mut vals = []\n    pos = skip_ws(s, pos + 1)\n    if pos < str_len(s) && byte_at(s, pos) == 93 " + chr(123) + "\n        return Ok(PValue(JArr(vals), pos + 1))\n    }\n    while true " + chr(123) + "\n        let parsed = parse_value(s, pos)?\n        match parsed " + chr(123) + "\n            PValue(value, next) => " + chr(123) + "\n                push(vals, value)\n                pos = skip_ws(s, next)\n            },\n        }\n        if pos >= str_len(s) " + chr(123) + "\n            return Err(json_err(pos, \"unterminated array\"))\n        }\n        if byte_at(s, pos) == 93 " + chr(123) + "\n            return Ok(PValue(JArr(vals), pos + 1))\n        }\n        if byte_at(s, pos) != 44 " + chr(123) + "\n            return Err(json_err(pos, \"expected comma or closing bracket\"))\n        }\n        pos = skip_ws(s, pos + 1)\n        if pos < str_len(s) && byte_at(s, pos) == 93 " + chr(123) + "\n            return Err(json_err(pos, \"trailing comma in array\"))\n        }\n    }\n    Err(\"\")\n}\n\n// parse_object 解析对象：键值对，禁止尾逗号\n// parse_object parses an object: key-value pairs, no trailing commas\n// Object parsing: key-value pairs, no trailing comma\nfn parse_object(s, mut pos) " + chr(123) + "\n    let mut keys = []\n    let mut vals = []\n    pos = skip_ws(s, pos + 1)\n    if pos < str_len(s) && byte_at(s, pos) == 125 " + chr(123) + "\n        return Ok(PValue(JObj(keys, vals), pos + 1))\n    }\n    while true " + chr(123) + "\n        if pos >= str_len(s) || byte_at(s, pos) != 34 " + chr(123) + "\n            return Err(json_err(pos, \"expected object key string\"))\n        }\n        let parsed_key = parse_string(s, pos)?\n        let key = match parsed_key " + chr(123) + "\n            PString(text, next) => " + chr(123) + "\n                pos = skip_ws(s, next)\n                text\n            },\n        }\n        if pos >= str_len(s) || byte_at(s, pos) != 58 " + chr(123) + "\n            return Err(json_err(pos, \"expected colon after object key\"))\n        }\n        pos = skip_ws(s, pos + 1)\n        let parsed_value = parse_value(s, pos)?\n        match parsed_value " + chr(123) + "\n            PValue(value, next) => " + chr(123) + "\n                push(keys, key)\n                push(vals, value)\n                pos = skip_ws(s, next)\n            },\n        }\n        if pos >= str_len(s) " + chr(123) + "\n            return Err(json_err(pos, \"unterminated object\"))\n        }\n        if byte_at(s, pos) == 125 " + chr(123) + "\n            return Ok(PValue(JObj(keys, vals), pos + 1))\n        }\n        if byte_at(s, pos) != 44 " + chr(123) + "\n            return Err(json_err(pos, \"expected comma or closing brace\"))\n        }\n        pos = skip_ws(s, pos + 1)\n        if pos < str_len(s) && byte_at(s, pos) == 125 " + chr(123) + "\n            return Err(json_err(pos, \"trailing comma in object\"))\n        }\n    }\n    Err(\"\")\n}\n\n// parse_value 做值分派：字面量/数字/数组/对象\n// parse_value dispatches on values: literal/number/array/object\n// Value dispatch: literals, numbers, arrays, objects\nfn parse_value(s, pos0) " + chr(123) + "\n    let pos = skip_ws(s, pos0)\n    if pos >= str_len(s) " + chr(123) + "\n        return Err(json_err(pos, \"expected JSON value\"))\n    }\n    let b = byte_at(s, pos)\n    if b == 34 " + chr(123) + "\n        let parsed = parse_string(s, pos)?\n        match parsed " + chr(123) + "\n            PString(text, next) => Ok(PValue(JStr(text), next)),\n        }\n    } else if b == 91 " + chr(123) + "\n        parse_array(s, pos)\n    } else if b == 123 " + chr(123) + "\n        parse_object(s, pos)\n    } else if has_at(s, pos, \"true\") " + chr(123) + "\n        Ok(PValue(JBool(true), pos + 4))\n    } else if has_at(s, pos, \"false\") " + chr(123) + "\n        Ok(PValue(JBool(false), pos + 5))\n    } else if has_at(s, pos, \"null\") " + chr(123) + "\n        Ok(PValue(JNull, pos + 4))\n    } else if b == 45 || is_digit(b) " + chr(123) + "\n        parse_number(s, pos)\n    } else " + chr(123) + "\n        Err(json_err(pos, \"expected JSON value\"))\n    }\n}\n\n// parse 是 JSON 解析入口（余留输入报错） / parse is the JSON entry (leftover input is an error)\n// Parse entry (rejects trailing input)\npub fn parse(s) " + chr(123) + "\n    let parsed = parse_value(s, 0)?\n    match parsed " + chr(123) + "\n        PValue(value, pos) => " + chr(123) + "\n            let end = skip_ws(s, pos)\n            if end == str_len(s) " + chr(123) + "\n                Ok(value)\n            } else " + chr(123) + "\n                Err(json_err(end, \"unexpected trailing input\"))\n            }\n        },\n    }\n}\n\n// hex_digit 把数字转 16 进制字符 / hex_digit renders a digit as a hex character\n// Hex digit character\nfn hex_digit(n) " + chr(123) + "\n    if n < 10 " + chr(123) + "\n        chr(48 + n)\n    } else " + chr(123) + "\n        chr(65 + n - 10)\n    }\n}\n\n// quote 渲染字符串转义 / quote renders a string with escapes\n// String escaping for rendering\nfn quote(s) " + chr(123) + "\n    let mut out = \"\\\"\"\n    let mut i = 0\n    while i < str_len(s) " + chr(123) + "\n        let b = byte_at(s, i)\n        if b == 34 " + chr(123) + "\n            out = out + \"\\\\\\\"\"\n        } else if b == 92 " + chr(123) + "\n            out = out + \"\\\\\\\\\"\n        } else if b == 8 " + chr(123) + "\n            out = out + \"\\\\b\"\n        } else if b == 12 " + chr(123) + "\n            out = out + \"\\\\f\"\n        } else if b == 10 " + chr(123) + "\n            out = out + \"\\\\n\"\n        } else if b == 13 " + chr(123) + "\n            out = out + \"\\\\r\"\n        } else if b == 9 " + chr(123) + "\n            out = out + \"\\\\t\"\n        } else if b < 32 " + chr(123) + "\n            out = out + \"\\\\u00\" + hex_digit(b / 16) + hex_digit(b % 16)\n        } else " + chr(123) + "\n            out = out + substr(s, i, 1)\n        }\n        i = i + 1\n    }\n    out + \"\\\"\"\n}\n\n// spaces 生成 n 个空格 / spaces produces n spaces\n// n spaces\nfn spaces(n) " + chr(123) + "\n    let mut out = \"\"\n    let mut i = 0\n    while i < n " + chr(123) + "\n        out = out + \" \"\n        i = i + 1\n    }\n    out\n}\n\n// float_text 渲染浮点（拒绝非有限值） / float_text renders a float (non-finite values rejected)\n// Float rendering (rejects non-finite)\nfn float_text(f) " + chr(123) + "\n    if f - f != 0.0 " + chr(123) + "\n        assert(false, \"json: cannot render non-finite float\")\n        \"\"\n    } else " + chr(123) + "\n        str(f)\n    }\n}\n\n// render_array 渲染数组（紧凑或缩进） / render_array renders an array (compact or indented)\n// Array rendering (compact or indented)\nfn render_array(vals, indent, depth) " + chr(123) + "\n    if len(vals) == 0 " + chr(123) + "\n        \"[]\"\n    } else if indent <= 0 " + chr(123) + "\n        let mut parts = []\n        for value in vals " + chr(123) + "\n            push(parts, render_inner(value, indent, depth + 1))\n        }\n        \"[\" + join(parts, \",\") + \"]\"\n    } else " + chr(123) + "\n        let mut parts = []\n        for value in vals " + chr(123) + "\n            push(parts, spaces((depth + 1) * indent) + render_inner(value, indent, depth + 1))\n        }\n        \"[\\n\" + join(parts, \",\\n\") + \"\\n\" + spaces(depth * indent) + \"]\"\n    }\n}\n\n// render_object 渲染对象 / render_object renders an object\n// Object rendering\nfn render_object(keys, vals, indent, depth) " + chr(123) + "\n    if len(keys) != len(vals) " + chr(123) + "\n        assert(false, \"json: object keys and values must have equal length\")\n        \"\"\n    } else if len(keys) == 0 " + chr(123) + "\n        \"" + chr(123) + "" + chr(123) + "}\"\n    } else if indent <= 0 " + chr(123) + "\n        let mut parts = []\n        let mut i = 0\n        while i < len(keys) " + chr(123) + "\n            push(parts, quote(keys[i]) + \":\" + render_inner(vals[i], indent, depth + 1))\n            i = i + 1\n        }\n        \"" + chr(123) + "" + chr(123) + "\" + join(parts, \",\") + \"}\"\n    } else " + chr(123) + "\n        let mut parts = []\n        let mut i = 0\n        while i < len(keys) " + chr(123) + "\n            push(parts, spaces((depth + 1) * indent) + quote(keys[i]) + \": \" + render_inner(vals[i], indent, depth + 1))\n            i = i + 1\n        }\n        \"" + chr(123) + "" + chr(123) + "\\n\" + join(parts, \",\\n\") + \"\\n\" + spaces(depth * indent) + \"}\"\n    }\n}\n\n// render_inner 做值渲染分派 / render_inner dispatches value rendering\n// Value rendering dispatch\nfn render_inner(v, indent, depth) " + chr(123) + "\n    match v " + chr(123) + "\n        JNull => \"null\",\n        JBool(b) => if b " + chr(123) + "\n            \"true\"\n        } else " + chr(123) + "\n            \"false\"\n        },\n        JInt(n) => str(n),\n        JFloat(f) => float_text(f),\n        JStr(s) => quote(s),\n        JArr(vals) => render_array(vals, indent, depth),\n        JObj(keys, vals) => render_object(keys, vals, indent, depth),\n    }\n}\n\n// render 是紧凑渲染入口 / render is the compact rendering entry\n// Compact render entry\npub fn render(v) " + chr(123) + "\n    render_inner(v, 0, 0)\n}\n\n// pretty 是缩进渲染入口 / pretty is the indented rendering entry\n// Indented render entry\npub fn pretty(v, indent) " + chr(123) + "\n    render_inner(v, indent, 0)\n}\n\n// get 按键查值（保源顺序与重复键） / get looks up a value by key (keeps source order and duplicate keys)\n// Lookup by key (preserves source order and duplicate keys)\npub fn get(keys, vals, key) " + chr(123) + "\n    let mut i = 0\n    while i < len(keys) && i < len(vals) " + chr(123) + "\n        if keys[i] == key " + chr(123) + "\n            return Some(vals[i])\n        }\n        i = i + 1\n    }\n    None\n}\n")
    put(cs, "std/log" + chr(31) + "bur.mod", "module std/log\n")
    put(cs, "std/log" + chr(31) + "log.bur", "// log.bur — 分级日志：级别常量、门槛过滤与 stderr 输出（纯 Burryn）。\n// Leveled logging: level constants, threshold gating, stderr output.\n\npub let level_debug = 0\npub let level_info = 1\npub let level_warn = 2\npub let level_error = 3\npub let level_off = 4\n\n// min_level 是当前门槛；包级 let 只收常量表达式，字面量须与 level_info 同值\n// min_level is the current threshold; package-level lets take constant\n// expressions, so the literal must match level_info\nlet mut min_level = 1\n\n// set_level 设置输出门槛 / set_level sets the output threshold\n// 包内无 callsite，参数须显式钉型才过深 mut 流规则\n// no in-package callsite pins the parameter, so annotate it for the deep-mut\n// flow rule\npub fn set_level(lvl: int) " + chr(123) + "\n    min_level = lvl\n}\n\n// get_level 读当前门槛 / get_level reads the current threshold\npub fn get_level() " + chr(123) + "\n    min_level\n}\n\n// enabled 判断该级别是否过门槛 / enabled tells whether a level passes the threshold\npub fn enabled(lvl) " + chr(123) + "\n    lvl >= min_level\n}\n\n// format_line 渲染单行日志（纯函数，可测） / format_line renders one log line (pure, testable)\npub fn format_line(lvl, msg) " + chr(123) + "\n    let mut tag = \"[log]\"\n    if lvl == level_debug " + chr(123) + "\n        tag = \"[debug]\"\n    } else if lvl == level_info " + chr(123) + "\n        tag = \"[info]\"\n    } else if lvl == level_warn " + chr(123) + "\n        tag = \"[warn]\"\n    } else if lvl == level_error " + chr(123) + "\n        tag = \"[error]\"\n    }\n    tag + \" \" + msg\n}\n\n// log 过门槛则写 stderr / log writes to stderr when the level passes\npub fn log(lvl, msg) " + chr(123) + "\n    if enabled(lvl) " + chr(123) + "\n        eprintln(format_line(lvl, msg))\n    }\n}\n\n// debug 记 debug 级 / debug logs at the debug level\npub fn debug(msg) " + chr(123) + "\n    log(level_debug, msg)\n}\n\n// info 记 info 级 / info logs at the info level\npub fn info(msg) " + chr(123) + "\n    log(level_info, msg)\n}\n\n// warn 记 warn 级 / warn logs at the warn level\npub fn warn(msg) " + chr(123) + "\n    log(level_warn, msg)\n}\n\n// error 记 error 级 / error logs at the error level\npub fn error(msg) " + chr(123) + "\n    log(level_error, msg)\n}\n")
    put(cs, "std/net" + chr(31) + "bur.mod", "module std/net\n")
    put(cs, "std/net" + chr(31) + "net.bur", "// std/net — 基于 net native 的最小 TCP 辅助（S7.7）。\n// Minimal TCP helpers over the net natives (S7.7).\n\n// read_all 读满全部数据 / read_all reads all data\npub fn read_all(h) " + chr(123) + "\n    let mut out = \"\"\n    let mut going = true\n    while going " + chr(123) + "\n        match net_read(h, 4096) " + chr(123) + "\n            Ok(chunk) => " + chr(123) + "\n                if str_len(chunk) == 0 " + chr(123) + "\n                    going = false\n                } else " + chr(123) + "\n                    out = out + chunk\n                }\n            },\n            Err(e) => " + chr(123) + "\n                return Err(e)\n            },\n        }\n    }\n    Ok(out)\n}\n\n// write_line 写一行（带换行）/ write_line writes a line (with a newline)\n// Write a line (with newline)\npub fn write_line(h, s) " + chr(123) + "\n    net_write(h, s + \"\\n\")\n}\n")
    put(cs, "std/path" + chr(31) + "bur.mod", "module std/path\n")
    put(cs, "std/path" + chr(31) + "path.bur", "// std/path — POSIX 路径操作（纯 Burryn，仅字符串运算）。\n// POSIX path manipulation (pure Burryn, string operations only).\n\n// slash_join 用 / 拼接段 / slash_join joins segments with '/'\nfn slash_join(parts) " + chr(123) + "\n    let mut out = \"\"\n    let mut i = 0\n    while i < len(parts) " + chr(123) + "\n        if i > 0 " + chr(123) + "\n            out = out + \"/\"\n        }\n        out = out + parts[i]\n        i = i + 1\n    }\n    out\n}\n\n// is_abs 判断是否绝对路径 / is_abs tells whether a path is absolute\n// Is the path absolute\npub fn is_abs(p) " + chr(123) + "\n    str_len(p) > 0 && byte_at(p, 0) == 47\n}\n\n// clean 规范化路径（消除 . 与 ..） / clean normalizes a path (resolves . and ..)\n// Clean (resolve . and ..)\npub fn clean(p) " + chr(123) + "\n    if str_len(p) == 0 " + chr(123) + "\n        return \".\"\n    }\n    let rooted = byte_at(p, 0) == 47\n    let parts = split(p, \"/\")\n    let mut out = []\n    for seg in parts " + chr(123) + "\n        if seg == \"\" || seg == \".\" " + chr(123) + "} else if seg == \"..\" " + chr(123) + "\n            let n = len(out)\n            if n > 0 && out[n - 1] != \"..\" " + chr(123) + "\n                let _ = pop(out)\n            } else if !rooted " + chr(123) + "\n                push(out, \"..\")\n            }\n        } else " + chr(123) + "\n            push(out, seg)\n        }\n    }\n    let mut result = slash_join(out)\n    if rooted " + chr(123) + "\n        result = \"/\" + result\n    }\n    if str_len(result) == 0 " + chr(123) + "\n        \".\"\n    } else " + chr(123) + "\n        result\n    }\n}\n\n// join 拼接并规范化 / join concatenates and normalizes\n// Join and clean\npub fn join(parts) " + chr(123) + "\n    let mut filtered = []\n    for p in parts " + chr(123) + "\n        if str_len(p) > 0 " + chr(123) + "\n            push(filtered, p)\n        }\n    }\n    if len(filtered) == 0 " + chr(123) + "\n        \"\"\n    } else " + chr(123) + "\n        clean(slash_join(filtered))\n    }\n}\n\n// base 取末段（文件名）/ base returns the last segment (file name)\n// Last segment (file name)\npub fn base(p) " + chr(123) + "\n    if str_len(p) == 0 " + chr(123) + "\n        return \".\"\n    }\n    let cleaned = clean(p)\n    if cleaned == \"/\" " + chr(123) + "\n        return \"/\"\n    }\n    let parts = split(cleaned, \"/\")\n    let n = len(parts)\n    if n == 0 " + chr(123) + "\n        \".\"\n    } else " + chr(123) + "\n        parts[n - 1]\n    }\n}\n\n// dir 取目录部分 / dir returns the directory part\n// Directory part\npub fn dir(p) " + chr(123) + "\n    if str_len(p) == 0 " + chr(123) + "\n        return \".\"\n    }\n    let cleaned = clean(p)\n    if cleaned == \"/\" " + chr(123) + "\n        return \"/\"\n    }\n    let mut last_slash = -1\n    let mut i = 0\n    while i < str_len(cleaned) " + chr(123) + "\n        if byte_at(cleaned, i) == 47 " + chr(123) + "\n            last_slash = i\n        }\n        i = i + 1\n    }\n    if last_slash < 0 " + chr(123) + "\n        \".\"\n    } else if last_slash == 0 " + chr(123) + "\n        \"/\"\n    } else " + chr(123) + "\n        substr(cleaned, 0, last_slash)\n    }\n}\n\n// ext 取扩展名（含点）/ ext returns the extension (with the dot)\n// Extension (with dot)\npub fn ext(p) " + chr(123) + "\n    let b = base(p)\n    let mut i = str_len(b) - 1\n    while i > 0 " + chr(123) + "\n        if byte_at(b, i) == 46 " + chr(123) + "\n            return substr(b, i, str_len(b) - i)\n        }\n        i = i - 1\n    }\n    \"\"\n}\n")
    put(cs, "std/testing" + chr(31) + "bur.mod", "module std/testing\n")
    put(cs, "std/testing" + chr(31) + "testing.bur", "// std/testing — `bur test` 的最小断言辅助（S6.6）。\n// Minimal assertion helpers for bur test (S6.6).\n\n// assert_eq 断言相等 / assert_eq asserts equality\npub fn assert_eq(got, want) " + chr(123) + "\n    assert(got == want, \"assert_eq failed: got \" + str(got) + \", want \" + str(want))\n}\n\n// assert_ok 断言 Ok / assert_ok asserts an Ok result\n// Assert Ok\npub fn assert_ok(result) " + chr(123) + "\n    match result " + chr(123) + "\n        Ok(_) => " + chr(123) + "},\n        Err(err) => assert(false, \"assert_ok failed: got Err(\" + str(err) + \")\"),\n    }\n}\n\n// assert_err 断言 Err / assert_err asserts an Err result\n// Assert Err\npub fn assert_err(result) " + chr(123) + "\n    match result " + chr(123) + "\n        Err(_) => " + chr(123) + "},\n        Ok(value) => assert(false, \"assert_err failed: got Ok(\" + str(value) + \")\"),\n    }\n}\n")
    cs
}
