// float_rt.bur — dtoa/strtod 大整数核心，VM 对拍 glibc
// bigint = list of limbs, base 2^30, little-endian, frt_NL limbs
// 注意：Burryn 无位运算操作符，全部用 + - * / % 表达
// 本文件整份源码被 cli/build.bur 的 compile_file_to_x86 逐字注入到每个 x86 目标程序前，
// 因此只能引用自身声明——引用 lib 其余部分或别的包会让被编译程序找不到名字。
// x86 后端还按名字查 frt_format_float / frt_parse_float_bits 的函数句柄（emit.bur、x86.bur），
// 两者无 Burryn 调用点但不是死代码。
// compile_file_to_x86 in cli/build.bur injects this whole file verbatim ahead of every
// x86 target program, so it may reference only its own declarations: anything from the
// rest of lib or another package would be an unresolved name in the compiled program.
// The x86 backend also looks up frt_format_float and frt_parse_float_bits by name
// (emit.bur, x86.bur); neither has a Burryn call site and neither is dead.
let frt_NL = 56
let frt_BASE = 1073741824
let frt_TWO_52 = 4503599627370496
let frt_INF_BITS = 9218868437227405312
let frt_SIGN_BIT = 0 - 9223372036854775807 - 1

fn frt_bi_zero() {
    let mut a = []
    let mut i = 0
    while i < frt_NL {
        push(a, 0)
        i = i + 1
    }
    a
}

fn frt_bi_copy(a) {
    let mut c = frt_bi_zero()
    let mut i = 0
    while i < frt_NL {
        c[i] = a[i]
        i = i + 1
    }
    c
}

fn frt_bi_set_u64(mut a, v) {
    let mut i = 0
    while i < frt_NL {
        a[i] = 0
        i = i + 1
    }
    a[0] = v % frt_BASE
    if v >= frt_BASE {
        a[1] = v / frt_BASE
    }
    a
}

fn frt_bi_cmp(a, b) {
    let mut i = frt_NL - 1
    while i >= 0 {
        if a[i] != b[i] {
            if a[i] > b[i] {
                return 1
            } else {
                return 0 - 1
            }
        }
        i = i - 1
    }
    0
}

fn frt_bi_is_zero(a) {
    let mut i = 0
    while i < frt_NL {
        if a[i] != 0 {
            return 0
        }
        i = i + 1
    }
    1
}

fn frt_bi_bitlen(a) {
    let mut i = frt_NL - 1
    while i >= 0 {
        if a[i] != 0 {
            let mut b = i * 30
            let mut v = a[i]
            while v > 0 {
                v = v / 2
                b = b + 1
            }
            return b
        }
        i = i - 1
    }
    0
}

fn frt_bi_shl1(mut a) {
    let mut carry = 0
    let mut i = 0
    while i < frt_NL {
        let mut v = a[i] * 2 + carry
        if v >= frt_BASE {
            v = v - frt_BASE
            carry = 1
        } else {
            carry = 0
        }
        a[i] = v
        i = i + 1
    }
    a
}

fn frt_bi_shl_bits(mut a, k) {
    let ls = k / 30
    let bs = k % 30
    if ls > 0 {
        let mut i = frt_NL - 1
        while i >= ls {
            a[i] = a[i - ls]
            i = i - 1
        }
        let mut j = 0
        while j < ls {
            a[j] = 0
            j = j + 1
        }
    }
    if bs > 0 {
        let mut p = 1
        let mut j = 0
        while j < bs {
            p = p * 2
            j = j + 1
        }
        let mut q = 1
        let mut j2 = 0
        while j2 < 30 - bs {
            q = q * 2
            j2 = j2 + 1
        }
        let mut carry = 0
        let mut i = 0
        while i < frt_NL {
            let old = a[i]
            a[i] = (old * p + carry) % frt_BASE
            carry = old / q
            i = i + 1
        }
    }
    {}
}

fn frt_bi_shr_bits(mut a, k) {
    let ls = k / 30
    let bs = k % 30
    if ls > 0 {
        let mut i = 0
        while i < frt_NL - ls {
            a[i] = a[i + ls]
            i = i + 1
        }
        let mut j = frt_NL - ls
        while j < frt_NL {
            a[j] = 0
            j = j + 1
        }
    }
    if bs > 0 {
        let mut p = 1
        let mut j = 0
        while j < bs {
            p = p * 2
            j = j + 1
        }
        let mut q = 1
        let mut j2 = 0
        while j2 < 30 - bs {
            q = q * 2
            j2 = j2 + 1
        }
        let mut carry = 0
        let mut i = frt_NL - 1
        while i >= 0 {
            let old = a[i]
            a[i] = old / p + carry
            carry = old % p * q
            i = i - 1
        }
    }
    {}
}

fn frt_bi_add_small(mut a, v) {
    a[0] = a[0] + v
    let mut i = 0
    while i < frt_NL - 1 && a[i] >= frt_BASE {
        a[i] = a[i] - frt_BASE
        i = i + 1
        a[i] = a[i] + 1
    }
    a
}

fn frt_bi_sub(mut a, b) {
    let mut borrow = 0
    let mut i = 0
    while i < frt_NL {
        let mut v = a[i] - b[i] - borrow
        if v < 0 {
            v = v + frt_BASE
            borrow = 1
        } else {
            borrow = 0
        }
        a[i] = v
        i = i + 1
    }
    a
}

fn frt_bi_mul_small(mut a, small) {
    let mut carry = 0
    let mut i = 0
    while i < frt_NL {
        let v = a[i] * small + carry
        a[i] = v % frt_BASE
        carry = v / frt_BASE
        i = i + 1
    }
    a
}

fn frt_bi_bit(a, i) {
    let limb = i / 30
    let bit = i % 30
    let mut p = 1
    let mut j = 0
    while j < bit {
        p = p * 2
        j = j + 1
    }
    let v = a[limb] / p
    v % 2
}

fn frt_bi_has_low_bits(a, n) {
    let mut i = 0
    while i < n {
        if frt_bi_bit(a, i) == 1 {
            return 1
        }
        i = i + 1
    }
    0
}

fn frt_bi_set_bit(mut a, i) {
    let limb = i / 30
    let bit = i % 30
    let mut p = 1
    let mut j = 0
    while j < bit {
        p = p * 2
        j = j + 1
    }
    a[limb] = a[limb] + p
}

// q = num // den（就地写 q），返回余数 r
fn frt_bi_divmod(num, den, mut q) {
    let mut i = 0
    while i < frt_NL {
        q[i] = 0
        i = i + 1
    }
    let mut r = frt_bi_zero()
    let mut b = frt_bi_bitlen(num) - 1
    while b >= 0 {
        frt_bi_shl1(r)
        let bitv = frt_bi_bit(num, b)
        if bitv == 1 {
            r[0] = r[0] + 1
        }
        if frt_bi_cmp(r, den) >= 0 {
            frt_bi_sub(r, den)
            frt_bi_set_bit(q, b)
        }
        b = b - 1
    }
    r
}

fn frt_bi_pow10(k) {
    let mut a = frt_bi_zero()
    a[0] = 1
    let mut i = 0
    while i < k {
        frt_bi_mul_small(a, 10)
        i = i + 1
    }
    a
}

fn frt_bi_to_u64(a) {
    a[0] + a[1] * frt_BASE
}

fn frt_parse_float_bits(s) {
    let mut i = 0
    let mut j = str_len(s)
    while i < j && frt_is_space(char_at(s, i)) == 1 {
        i = i + 1
    }
    while j > i && frt_is_space(char_at(s, j - 1)) == 1 {
        j = j - 1
    }
    if j - i == 0 || j - i >= 128 {
        return [0, 0]
    }
    let body = substr(s, i, j - i)
    let n = str_len(body)
    let mut p = 0
    let mut neg = 0
    let c0 = char_at(body, 0)
    if c0 == "+" {
        p = 1
    } else {
        if c0 == "-" {
            p = 1
            neg = 1
        }
    }
    if p >= n {
        return [0, 0]
    }
    let rest = substr(body, p, n - p)
    let lr = frt_lower(rest)
    if lr == "inf" || lr == "infinity" {
        if neg == 1 {
            return [1, frt_INF_BITS + frt_SIGN_BIT]
        }
        return [1, frt_INF_BITS]
    }
    if str_len(lr) >= 3 && substr(lr, 0, 3) == "nan" {
        return [1, frt_INF_BITS + frt_TWO_52]
    }
    if str_len(rest) >= 2 && char_at(rest, 0) == "0" && (char_at(rest, 1) == "x" || char_at(rest, 1) == "X") {
        return frt_parse_hex(rest, neg)
    }
    let mut digs = ""
    let mut frac = ""
    let mut q2 = 0
    while q2 < n - p && frt_is_digit(char_at(rest, q2)) == 1 {
        digs = digs + char_at(rest, q2)
        q2 = q2 + 1
    }
    if q2 < n - p && char_at(rest, q2) == "." {
        q2 = q2 + 1
        while q2 < n - p && frt_is_digit(char_at(rest, q2)) == 1 {
            frac = frac + char_at(rest, q2)
            q2 = q2 + 1
        }
    }
    if str_len(digs) == 0 && str_len(frac) == 0 {
        return [0, 0]
    }
    let mut eexp = 0
    if q2 < n - p && (char_at(rest, q2) == "e" || char_at(rest, q2) == "E") {
        q2 = q2 + 1
        let mut es = 1
        if q2 < n - p && char_at(rest, q2) == "+" {
            q2 = q2 + 1
        } else {
            if q2 < n - p && char_at(rest, q2) == "-" {
                es = 0 - 1
                q2 = q2 + 1
            }
        }
        if q2 >= n - p || frt_is_digit(char_at(rest, q2)) == 0 {
            return [0, 0]
        }
        while q2 < n - p && frt_is_digit(char_at(rest, q2)) == 1 {
            eexp = eexp * 10 + (ord(char_at(rest, q2)) - 48)
            q2 = q2 + 1
        }
        eexp = eexp * es
    }
    if q2 < n - p {
        return [0, 0]
    }
    let all = digs + frac
    let al = str_len(all)
    let mut k = 0
    while k < al && char_at(all, k) == "0" {
        k = k + 1
    }
    if k == al {
        if neg == 1 {
            return [1, frt_SIGN_BIT]
        }
        return [1, 0]
    }
    let dstr = substr(all, k, al - k)
    let mut D = frt_bi_zero()
    let mut i2 = 0
    while i2 < str_len(dstr) {
        let d = ord(char_at(dstr, i2)) - 48
        frt_bi_mul_small(D, 10)
        frt_bi_add_small(D, d)
        i2 = i2 + 1
    }
    let E = eexp - str_len(frac)
    let mut out_ok = 0
    let mut out_bits = 0
    if E >= 0 {
        if E > 320 {
            out_ok = 1
            out_bits = frt_INF_BITS
        } else {
            let mut i3 = 0
            while i3 < E {
                frt_bi_mul_small(D, 10)
                i3 = i3 + 1
            }
            let num = D
            let mut den = frt_bi_set_u64(frt_bi_zero(), 1)
            let bits = frt_bi_rational_to_bits(num, den)
            out_ok = 1
            out_bits = bits
        }
    } else {
        let nE = 0 - E
        if nE > 450 {
            out_ok = 1
        } else {
            let num = D
            let mut den = frt_bi_pow10(nE)
            let bits = frt_bi_rational_to_bits(num, den)
            out_ok = 1
            out_bits = bits
        }
    }
    if neg == 1 {
        out_bits = out_bits + frt_SIGN_BIT
    }
    [out_ok, out_bits]
}

fn frt_parse_hex(rest, neg) {
    let n = str_len(rest)
    let mut j = 2
    let mut hd = ""
    let mut hf = ""
    while j < n && frt_is_hexdigit(char_at(rest, j)) == 1 {
        hd = hd + char_at(rest, j)
        j = j + 1
    }
    if j < n && char_at(rest, j) == "." {
        j = j + 1
        while j < n && frt_is_hexdigit(char_at(rest, j)) == 1 {
            hf = hf + char_at(rest, j)
            j = j + 1
        }
    }
    if str_len(hd) == 0 && str_len(hf) == 0 {
        return [0, 0]
    }
    let mut pexp = 0
    if j < n && (char_at(rest, j) == "p" || char_at(rest, j) == "P") {
        j = j + 1
        let mut ps = 1
        if j < n && char_at(rest, j) == "+" {
            j = j + 1
        } else {
            if j < n && char_at(rest, j) == "-" {
                ps = 0 - 1
                j = j + 1
            }
        }
        if j >= n || frt_is_digit(char_at(rest, j)) == 0 {
            return [0, 0]
        }
        while j < n && frt_is_digit(char_at(rest, j)) == 1 {
            pexp = pexp * 10 + (ord(char_at(rest, j)) - 48)
            j = j + 1
        }
        pexp = pexp * ps
    }
    if j < n {
        return [0, 0]
    }
    let all = hd + hf
    let al = str_len(all)
    let mut k = 0
    while k < al && char_at(all, k) == "0" {
        k = k + 1
    }
    if k == al {
        if neg == 1 {
            return [1, frt_SIGN_BIT]
        }
        return [1, 0]
    }
    let hstr = substr(all, k, al - k)
    let mut H = frt_bi_zero()
    let mut i = 0
    while i < str_len(hstr) {
        let c = char_at(hstr, i)
        let mut dv = 0
        if frt_is_digit(c) == 1 {
            dv = ord(c) - 48
        } else {
            let o = ord(c)
            if o >= 97 {
                dv = o - 87
            } else {
                dv = o - 55
            }
        }
        frt_bi_mul_small(H, 16)
        frt_bi_add_small(H, dv)
        i = i + 1
    }
    let E2 = pexp - 4 * str_len(hf)
    let mut num = H
    let mut out_ok = 0
    let mut out_bits = 0
    if E2 >= 0 {
        if E2 >= 1024 {
            out_ok = 1
            out_bits = frt_INF_BITS
        } else {
            frt_bi_shl_bits(num, E2)
            let mut den = frt_bi_set_u64(frt_bi_zero(), 1)
            let bits = frt_bi_rational_to_bits(num, den)
            out_ok = 1
            out_bits = bits
        }
    } else {
        let nE2 = 0 - E2
        if nE2 > 1600 {
            out_ok = 1
        } else {
            let mut den = frt_bi_set_u64(frt_bi_zero(), 1)
            frt_bi_shl_bits(den, nE2)
            let bits = frt_bi_rational_to_bits(num, den)
            out_ok = 1
            out_bits = bits
        }
    }
    if neg == 1 {
        out_bits = out_bits + frt_SIGN_BIT
    }
    [out_ok, out_bits]
}

// ---- 字符工具 ----
fn frt_is_space(c) {
    let o = ord(c)
    if o == 32 || o == 9 || o == 10 || o == 13 {
        return 1
    }
    0
}

fn frt_is_digit(c) {
    let o = ord(c)
    if o >= 48 && o <= 57 {
        return 1
    }
    0
}

fn frt_is_hexdigit(c) {
    let o = ord(c)
    if o >= 48 && o <= 57 {
        return 1
    }
    if o >= 97 && o <= 102 {
        return 1
    }
    if o >= 65 && o <= 70 {
        return 1
    }
    0
}

fn frt_lower(s) {
    let n = str_len(s)
    let mut out = ""
    let mut i = 0
    while i < n {
        let o = ord(char_at(s, i))
        if o >= 65 && o <= 90 {
            out = out + chr(o + 32)
        } else {
            out = out + char_at(s, i)
        }
        i = i + 1
    }
    out
}

// ---- dtoa：double bits → 字符串 ----
fn frt_assemble(digits, exp10, p, neg) {
    let mut out = ""
    if exp10 < 0 - 4 || exp10 >= p {
        out = char_at(digits, 0)
        let frac = frt_rstrip_zeros(substr(digits, 1, p - 1))
        if str_len(frac) > 0 {
            out = out + "." + frac
        }
        out = out + "e"
        let mut ee = exp10
        if ee >= 0 {
            out = out + "+"
        } else {
            out = out + "-"
            ee = 0 - ee
        }
        if ee < 10 {
            out = out + "0"
        }
        out = out + frt_i64_decstr(ee)
    } else {
        if exp10 >= 0 {
            let intpart = substr(digits, 0, exp10 + 1)
            let frac = frt_rstrip_zeros(substr(digits, exp10 + 1, p - exp10 - 1))
            out = intpart
            if str_len(frac) > 0 {
                out = out + "." + frac
            }
        } else {
            out = "0"
            let frac = frt_rstrip_zeros(frt_zeros(0 - exp10 - 1) + digits)
            if str_len(frac) > 0 {
                out = out + "." + frac
            }
        }
    }
    if neg == 1 {
        out = "-" + out
    }
    out
}

fn frt_pow10_int(k) {
    let mut v = 1
    let mut i = 0
    while i < k {
        v = v * 10
        i = i + 1
    }
    v
}

fn frt_i64_decstr(v) {
    if v == 0 {
        return "0"
    }
    let mut s = ""
    let mut x = v
    while x > 0 {
        s = chr(48 + x % 10) + s
        x = x / 10
    }
    s
}

fn frt_zeros(n) {
    let mut s = ""
    let mut i = 0
    while i < n {
        s = s + "0"
        i = i + 1
    }
    s
}

fn frt_rstrip_zeros(s) {
    let mut n = str_len(s)
    while n > 0 && char_at(s, n - 1) == "0" {
        n = n - 1
    }
    substr(s, 0, n)
}

// ---- 十进制度量 ----

// 比较 10^k 与 m*2^e：返回 frt_bi_cmp 语义（-1/0/1）
fn frt_pow10_vs(m, e, k) {
    let mut res = 0
    if k >= 0 {
        let mut p = frt_bi_pow10(k)
        if e >= 0 {
            let mut v = frt_bi_set_u64(frt_bi_zero(), m)
            frt_bi_shl_bits(v, e)
            res = frt_bi_cmp(p, v)
        } else {
            frt_bi_shl_bits(p, 0 - e)
            let mut v = frt_bi_set_u64(frt_bi_zero(), m)
            res = frt_bi_cmp(p, v)
        }
    } else {
        let nk = 0 - k
        if e >= 0 {
            let mut v = frt_bi_set_u64(frt_bi_zero(), m)
            let mut i = 0
            while i < nk {
                frt_bi_mul_small(v, 10)
                i = i + 1
            }
            frt_bi_shl_bits(v, e)
            res = frt_bi_cmp(frt_bi_set_u64(frt_bi_zero(), 1), v)
        } else {
            let mut v = frt_bi_set_u64(frt_bi_zero(), m)
            let mut i = 0
            while i < nk {
                frt_bi_mul_small(v, 10)
                i = i + 1
            }
            let mut d = frt_bi_set_u64(frt_bi_zero(), 1)
            frt_bi_shl_bits(d, 0 - e)
            res = frt_bi_cmp(d, v)
        }
    }
    res
}

fn frt_exp10_of(m, e) {
    let mut bl = 0
    let mut v = m
    while v > 0 {
        v = v / 2
        bl = bl + 1
    }
    let mut exp10 = (bl + e - 1) * 30103 / 100000
    while frt_pow10_vs(m, e, exp10) == 1 {
        exp10 = exp10 - 1
    }
    while frt_pow10_vs(m, e, exp10 + 1) == 0 - 1 {
        exp10 = exp10 + 1
    }
    exp10
}

// ---- 有理数 → double bits（单次四舍五入，含次正规数）----
fn frt_bi_rational_to_bits(num, den) {
    if frt_bi_is_zero(num) == 1 {
        return 0
    }
    let Ln = frt_bi_bitlen(num)
    let Ld = frt_bi_bitlen(den)
    let mut sh = 55 + Ld - Ln
    let mut num2 = frt_bi_copy(num)
    let mut den2 = frt_bi_copy(den)
    if sh > 0 {
        frt_bi_shl_bits(num2, sh)
        {}
    } else {
        if sh < 0 {
            frt_bi_shl_bits(den2, 0 - sh)
            {}
        }
    }
    let mut q = frt_bi_zero()
    let r = frt_bi_divmod(num2, den2, q)
    let bl = frt_bi_bitlen(q)
    let e2 = bl - 1 - sh
    if e2 >= 1024 {
        return frt_INF_BITS
    }
    let mut target_bits = 53
    let mut target_exp = e2 - 52
    if e2 < 0 - 1022 {
        if e2 + 1075 <= 0 {
            let mut nb = frt_bi_copy(num)
            frt_bi_shl_bits(nb, 1075)
            if frt_bi_cmp(nb, den) > 0 {
                return 1
            }
            return 0
        }
        target_bits = e2 + 1075
        target_exp = 0 - 1074
    }
    let drop = bl - target_bits
    let round_bit = frt_bi_bit(q, drop - 1)
    let mut sticky = frt_bi_has_low_bits(q, drop - 1)
    if frt_bi_is_zero(r) == 0 {
        sticky = 1
    }
    let mut S = frt_bi_copy(q)
    frt_bi_shr_bits(S, drop)
    let mut up = 0
    if round_bit == 1 {
        if sticky == 1 {
            up = 1
        } else {
            if frt_bi_bit(S, 0) == 1 {
                up = 1
            }
        }
    }
    if up == 1 {
        frt_bi_add_small(S, 1)
        if frt_bi_bitlen(S) > target_bits {
            frt_bi_shr_bits(S, 1)
            target_exp = target_exp + 1
            if target_exp == 0 - 1073 {
                return 1 * frt_TWO_52
            }
        }
    }
    let mut out = 0
    if target_exp >= 0 - 1022 {
        if target_exp + 1075 >= 2047 {
            out = frt_INF_BITS
        } else {
            let mant = frt_bi_to_u64(S) - frt_TWO_52
            out = (target_exp + 1075) * frt_TWO_52 + mant
        }
    } else {
        out = frt_bi_to_u64(S)
    }
    out
}

fn frt_format_g(m, e, p, neg) {
    let exp10 = frt_exp10_of(m, e)
    let k = exp10 - p + 1
    let mut num = frt_bi_zero()
    let mut den = frt_bi_zero()
    if k >= 0 {
        if e >= 0 {
            num = frt_bi_set_u64(num, m)
            frt_bi_shl_bits(num, e)
            den = frt_bi_pow10(k)
        } else {
            num = frt_bi_set_u64(num, m)
            den = frt_bi_pow10(k)
            frt_bi_shl_bits(den, 0 - e)
            {}
        }
    } else {
        let nk = 0 - k
        if e >= 0 {
            num = frt_bi_set_u64(num, m)
            frt_bi_shl_bits(num, e)
            let mut i = 0
            while i < nk {
                frt_bi_mul_small(num, 10)
                i = i + 1
            }
            den = frt_bi_set_u64(den, 1)
        } else {
            num = frt_bi_set_u64(num, m)
            let mut i = 0
            while i < nk {
                frt_bi_mul_small(num, 10)
                i = i + 1
            }
            den = frt_bi_set_u64(den, 1)
            frt_bi_shl_bits(den, 0 - e)
            {}
        }
    }
    let mut q = frt_bi_zero()
    let r = frt_bi_divmod(num, den, q)
    let mut rr = frt_bi_copy(r)
    frt_bi_shl1(rr)
    let c = frt_bi_cmp(rr, den)
    let mut up = 0
    if c > 0 {
        up = 1
    } else {
        if c == 0 && frt_bi_bit(q, 0) == 1 {
            up = 1
        }
    }
    if up == 1 {
        frt_bi_add_small(q, 1)
        {}
    }
    let mut qv = frt_bi_to_u64(q)
    let mut e10 = exp10
    if qv == frt_pow10_int(p) {
        qv = frt_pow10_int(p - 1)
        e10 = exp10 + 1
    }
    let digits = frt_i64_decstr(qv)
    frt_assemble(digits, e10, p, neg)
}

fn frt_append_dot0(s) {
    if str_contains(s, ".") || str_contains(s, "e") || str_contains(s, "E") {
        return s
    }
    s + ".0"
}

fn frt_format_float(bits) {
    let mut neg = 0
    let mut bb = bits
    if bb < 0 {
        neg = 1
        bb = bits - frt_SIGN_BIT
    }
    let expfield = bb / frt_TWO_52 % 2048
    let mant = bb % frt_TWO_52
    if expfield == 2047 {
        if mant == 0 {
            if neg == 1 {
                return "-Inf"
            }
            return "+Inf"
        }
        return "NaN"
    }
    if expfield == 0 && mant == 0 {
        if neg == 1 {
            return "-0.0"
        }
        return "0.0"
    }
    let mut m = 0
    let mut e = 0
    if expfield == 0 {
        m = mant
        e = 0 - 1074
    } else {
        m = mant + frt_TWO_52
        e = expfield - 1075
    }
    let mut s = ""
    let mut p = 1
    while p <= 17 {
        s = frt_format_g(m, e, p, neg)
        let res = frt_parse_float_bits(s)
        if res[0] == 1 && res[1] == bits {
            return frt_append_dot0(s)
        }
        p = p + 1
    }
    s
}
