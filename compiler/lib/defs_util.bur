// defs_util.bur — hex/quote/行号工具。
// defs_util.bur — hex/quote/line helpers.

// hex_digit 生成 16 进制数字字符 / hex_digit renders a hex digit character
fn hex_digit(n) {
    if n < 10 {
        str(n)
    } else {
        chr(97 + n - 10)
    }
}

// go_quote Go 风格字符串转义 / go_quote escapes a string Go-style
pub fn go_quote(s) {
    let mut parts = ["\""]
    let mut seg = 0
    let mut i = 0
    while i < str_len(s) {
        let o = byte_at(s, i)
        let esc = if o == 34 {
            "\\\""
        } else if o == 92 {
            "\\\\"
        } else if o == 10 {
            "\\n"
        } else if o == 9 {
            "\\t"
        } else if o == 13 {
            "\\r"
        } else if o < 32 || o == 127 {
            "\\x" + hex_digit(o / 16) + hex_digit(o % 16)
        } else {
            ""
        }
        if esc != "" {
            push(parts, substr(s, seg, i - seg))
            push(parts, esc)
            seg = i + 1
        }
        i = i + 1
    }
    push(parts, substr(s, seg, str_len(s) - seg))
    push(parts, "\"")
    join(parts, "")
}
