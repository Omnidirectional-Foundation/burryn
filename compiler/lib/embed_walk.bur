// embed_walk.bur — 遍历 .bur / 排序。
// embed_walk.bur — walk .bur / sort.



// walk_bur_files 递归收集 .bur 文件 / walk_bur_files recursively collects .bur files
fn walk_bur_files(base, rel, mut acc) {
    let here = if rel == "" {
        base
    } else {
        base + "/" + rel
    }
    match read_dir(here) {
        Ok(entries) => {
            if rel == "" {
                push(acc, "bur.mod")
            }
            for e in entries {
                if str_has_prefix(e, ".") {} else {
                    let child_rel = if rel == "" {
                        e
                    } else {
                        rel + "/" + e
                    }
                    let full = here + "/" + e
                    let is_dir = match read_dir(full) {
                        Ok(_) => true,
                        Err(_) => false,
                    }
                    if !is_dir {
                        if is_bur_file(e) {
                            push(acc, child_rel)
                        }
                    } else {
                        match walk_bur_files(base, child_rel, acc) {
                            Ok(_) => {},
                            Err(msg) => {
                                return Err(msg)
                            },
                        }
                    }
                }
            }
            Ok("")
        },
        Err(msg) => Err("cannot read dir " + here + ": " + msg),
    }
}

// is_bur_file 判断是否为 .bur 文件 / is_bur_file tells whether a name is a .bur file
fn is_bur_file(name) {
    let n = str_len(name)
    if n < 4 || substr(name, n - 4, 4) != ".bur" {
        false
    } else if n >= 9 && substr(name, n - 9, 9) == "_test.bur" {
        false
    } else {
        true
    }
}

