// embed_escape.bur — 字面量转义。
// embed_escape.bur — literal escape.

// escape_lit 字符串转义（嵌入表用）/ escape_lit escapes a string (embed table)
fn escape_lit(s) {
    let mut out = ""
    let mut i = 0
    while i < str_len(s) {
        let c = substr(s, i, 1)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\"" {
            out = out + "\\\""
        } else if c == chr(10) {
            out = out + "\\n"
        } else if c == chr(9) {
            out = out + "\\t"
        } else if c == chr(13) {
            out = out + "\" + chr(13) + \""
        } else if c == chr(31) {
            out = out + "\" + chr(31) + \""
        } else if c == chr(123) {
            out = out + "\" + chr(123) + \""
        } else {
            out = out + c
        }
        i = i + 1
    }
    out
}
