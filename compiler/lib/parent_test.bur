// parent_test.bur — parent_dir 的 bur test 套件
// bur test suite for parent_dir
fn test_parent_dir() {
    assert(parent_dir("a") == ".", "bare name has dot parent")
    assert(parent_dir("a/b") == "a", "relative parent")
    assert(parent_dir("a/b/c") == "a/b", "nested relative parent")
    assert(parent_dir("/x") == "/", "root is the parent of top-level absolute")
    assert(parent_dir("/") == "", "root has no parent")
    assert(parent_dir(".") == "", "dot has no parent")
}
