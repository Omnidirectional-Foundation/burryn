// defs_line.bur — 行号/前缀。
// defs_line.bur — line/prefix.



// line_starts 生成行起始表 / line_starts builds a line-start table
pub fn line_starts(src) {
    let mut ix = [0]
    let mut i = 0
    while i < str_len(src) {
        if char_at(src, i) == "\n" {
            push(ix, i + 1)
        }
        i = i + 1
    }
    ix
}

// line_of 偏移转行号 / line_of maps an offset to a line number
pub fn line_of(starts, off) {
    let o = if off < 0 {
        0
    } else {
        off
    }
    let mut line = 0
    let mut i = 0
    while i < len(starts) {
        if starts[i] <= o {
            line = i + 1
        }
        i = i + 1
    }
    line
}

