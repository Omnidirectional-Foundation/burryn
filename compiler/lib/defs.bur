// defs.bur — 编译器共享定义：Token/诊断/常量值与字节码 opcode 编号表，
// 附行号表、字符串/路径/排序与转义小工具。
// Shared compiler definitions: token, diagnostic, constant-value and bytecode
// opcode tables, plus line-table, string, path, sorting and escaping helpers.

pub enum Token {
    Tok(int, str, int, int),
}

// 诊断标签（多 span 标注） / Diagnostic label (multi-span annotation)
pub enum LabelT {
    Lab(int, int, str),
}

// 修复建议
// Fix suggestion
pub enum FixT {
    Fix(int, int, str, str),
}

// 诊断（错误/警告 + 修复） / Diagnostic (error/warning + fix)
pub enum DiagT {
    Diag(bool, str, str, str, int, int),
    DiagX(bool, str, str, str, int, int, [LabelT], [FixT]),
}

// 词法输出
// Lexer output
pub enum LexOut {
    Lexed([Token], [DiagT], [Token]),
}

// 检查输出
// Checker output
pub enum CheckOut {
    Checked([DiagT], [str], [str], [str], [str]),
}

pub let toolchain_version = "0.6.0"

// 编译期常量值
// Compile-time constant value
pub enum CVal {
    CInt(int),
    CFloat(float),
    CStr(str),
    CFn(int),
    CEnumType(int),
    CSingleton(int, int),
    CCtor(int, int),
}

// line_starts 生成行起始表 / line_starts builds a line-start table
pub fn line_starts(src) {
    let mut ix = [0]
    let mut i = 0
    while i < str_len(src) {
        if char_at(src, i) == "\n" {
            push(ix, i + 1)
        }
        i = i + 1
    }
    ix
}

// line_of 偏移转行号 / line_of maps an offset to a line number
pub fn line_of(starts, off) {
    let o = if off < 0 {
        0
    } else {
        off
    }
    let mut line = 0
    let mut i = 0
    while i < len(starts) {
        if starts[i] <= o {
            line = i + 1
        }
        i = i + 1
    }
    line
}

// str_has_prefix 前缀检查 / str_has_prefix checks a prefix
pub fn str_has_prefix(s, prefix) {
    let n = str_len(s)
    let m = str_len(prefix)
    n >= m && substr(s, 0, m) == prefix
}

// str_has_suffix 后缀检查 / str_has_suffix checks a suffix
pub fn str_has_suffix(s, suffix) {
    let n = str_len(s)
    let m = str_len(suffix)
    n >= m && substr(s, n - m, m) == suffix
}

// strip_trailing_slash 去尾部斜杠 / strip_trailing_slash removes a trailing slash
pub fn strip_trailing_slash(p) {
    if str_has_suffix(p, "/") {
        substr(p, 0, str_len(p) - 1)
    } else {
        p
    }
}

// parent_dir 取父目录，无父目录时返回空串（调用点按需回落到 "."）
// parent_dir returns the parent directory, or "" when there is none (call sites fall back to "." as needed)
pub fn parent_dir(p) {
    let mut cut = -1
    let mut i = 0
    while i < str_len(p) {
        if char_at(p, i) == "/" {
            cut = i
        }
        i = i + 1
    }
    if cut < 0 {
        if p == "." {
            ""
        } else {
            "."
        }
    } else if cut == 0 {
        if p == "/" {
            ""
        } else {
            "/"
        }
    } else {
        substr(p, 0, cut)
    }
}

// repeat 生成 n 个 ch / repeat produces n copies of ch
pub fn repeat(ch, n) {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + ch
        i = i + 1
    }
    out
}

// sorted_strs 插入排序字符串列表 / sorted_strs insertion-sorts a string list
pub fn sorted_strs(xs) {
    let mut out = []
    for x in xs {
        let mut i = 0
        while i < len(out) && out[i] < x {
            i = i + 1
        }
        out = concat(concat(slice(out, 0, i), [x]), slice(out, i, len(out)))
    }
    out
}

// hex_digit 生成 16 进制数字字符 / hex_digit renders a hex digit character
fn hex_digit(n) {
    if n < 10 {
        str(n)
    } else {
        chr(97 + n - 10)
    }
}

// go_quote Go 风格字符串转义 / go_quote escapes a string Go-style
pub fn go_quote(s) {
    let mut parts = ["\""]
    let mut seg = 0
    let mut i = 0
    while i < str_len(s) {
        let o = byte_at(s, i)
        let esc = if o == 34 {
            "\\\""
        } else if o == 92 {
            "\\\\"
        } else if o == 10 {
            "\\n"
        } else if o == 9 {
            "\\t"
        } else if o == 13 {
            "\\r"
        } else if o < 32 || o == 127 {
            "\\x" + hex_digit(o / 16) + hex_digit(o % 16)
        } else {
            ""
        }
        if esc != "" {
            push(parts, substr(s, seg, i - seg))
            push(parts, esc)
            seg = i + 1
        }
        i = i + 1
    }
    push(parts, substr(s, seg, str_len(s) - seg))
    push(parts, "\"")
    join(parts, "")
}
