// std/path — POSIX 路径操作（纯 Burryn，仅字符串运算）。
// POSIX path manipulation (pure Burryn, string operations only).

// slash_join 用 / 拼接段 / slash_join joins segments with '/'
fn slash_join(parts) {
    let mut out = ""
    let mut i = 0
    while i < len(parts) {
        if i > 0 {
            out = out + "/"
        }
        out = out + parts[i]
        i = i + 1
    }
    out
}

// is_abs 判断是否绝对路径 / is_abs tells whether a path is absolute
// Is the path absolute
pub fn is_abs(p) {
    str_len(p) > 0 && byte_at(p, 0) == 47
}

// clean 规范化路径（消除 . 与 ..）/
// clean normalizes a path (resolves . and ..)
// Clean (resolve . and ..)
pub fn clean(p) {
    if str_len(p) == 0 {
        return "."
    }
    let rooted = byte_at(p, 0) == 47
    let parts = split(p, "/")
    let mut out = []
    for seg in parts {
        if seg == "" || seg == "." {} else if seg == ".." {
            let n = len(out)
            if n > 0 && out[n - 1] != ".." {
                let _ = pop(out)
            } else if !rooted {
                push(out, "..")
            }
        } else {
            push(out, seg)
        }
    }
    let mut result = slash_join(out)
    if rooted {
        result = "/" + result
    }
    if str_len(result) == 0 {
        "."
    } else {
        result
    }
}

// join 拼接并规范化 / join concatenates and normalizes
// Join and clean
pub fn join(parts) {
    let mut filtered = []
    for p in parts {
        if str_len(p) > 0 {
            push(filtered, p)
        }
    }
    if len(filtered) == 0 {
        ""
    } else {
        clean(slash_join(filtered))
    }
}

// base 取末段（文件名）/ base returns the last segment (file name)
// Last segment (file name)
pub fn base(p) {
    if str_len(p) == 0 {
        return "."
    }
    let cleaned = clean(p)
    if cleaned == "/" {
        return "/"
    }
    let parts = split(cleaned, "/")
    let n = len(parts)
    if n == 0 {
        "."
    } else {
        parts[n - 1]
    }
}

// dir 取目录部分 / dir returns the directory part
// Directory part
pub fn dir(p) {
    if str_len(p) == 0 {
        return "."
    }
    let cleaned = clean(p)
    if cleaned == "/" {
        return "/"
    }
    let mut last_slash = -1
    let mut i = 0
    while i < str_len(cleaned) {
        if byte_at(cleaned, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        "."
    } else if last_slash == 0 {
        "/"
    } else {
        substr(cleaned, 0, last_slash)
    }
}

// ext 取扩展名（含点）/ ext returns the extension (with the dot)
// Extension (with dot)
pub fn ext(p) {
    let b = base(p)
    let mut i = str_len(b) - 1
    while i > 0 {
        if byte_at(b, i) == 46 {
            return substr(b, i, str_len(b) - i)
        }
        i = i - 1
    }
    ""
}
