// crypto_test.bur — std/crypto 的 bur test 套件
// bur test suite for std/crypto

// rep 重复字符构造定长输入 / rep builds a fixed-length input by repeating a character
fn rep(ch, n) {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + ch
        i = i + 1
    }
    out
}

fn test_sha256_fips_vectors() {
    assert(len(sha256("")) == 32, "digest is 32 bytes")
    assert(sha256_hex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 of empty input")
    assert(sha256_hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 of 'abc'")
    assert(sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "sha256 of the 448-bit FIPS message")
}

fn test_sha256_padding_boundaries() {
    // 55/56/63/64 字节输入踩满三种填充分支 / 55/56/63/64-byte inputs hit all three padding branches
    assert(sha256_hex(rep("a", 55)) == "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318", "55-byte input")
    assert(sha256_hex(rep("b", 56)) == "a5fc6e203a4c2b657d0d153885932414b2ffc6a93f0f8bf8b3183315e5a7212c", "56-byte input")
    assert(sha256_hex(rep("c", 64)) == "52b6419d27bd7f547cee3b92f8c17a908b8a49601ecbec161e5030de1dfe9e0a", "64-byte input")
    assert(sha256_hex(rep("d", 63)) == "dc2d0f189f1235f03b67783d486a08996f90ef96382cbed29793efb35cd04033", "63-byte input")
}

fn test_sha256_hex_quick_brown_fox() {
    assert(sha256_hex("The quick brown fox jumps over the lazy dog") == "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592", "sha256_hex of the quick brown fox")
}

fn test_sha256_multiblock_same_digest_input() {
    // 同一摘要内容两种输入形态：多块拼接与单次输入一致 / one digest, two shapes: multi-chunk concatenation equals a single call
    let part1 = "The quick brown fox "
    let part2 = "jumps over the lazy dog"
    assert(sha256_hex(part1 + part2) == sha256_hex("The quick brown fox jumps over the lazy dog"), "concatenated input hashes identically")
}
