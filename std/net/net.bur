pub fn read_all(h) {
    let mut out = ""
    let mut going = true
    while going {
        match net_read(h, 4096) {
            Ok(chunk) => {
                if str_len(chunk) == 0 {
                    going = false
                } else {
                    out = out + chunk
                }
            },
            Err(e) => {
                return Err(e)
            },
        }
    }
    Ok(out)
}

pub fn write_line(h, s) {
    net_write(h, s + "\n")
}
