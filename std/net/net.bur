// std/net — 基于 net native 的最小 TCP 辅助（S7.7）。
// / Minimal TCP helpers over the net natives (S7.7).
pub fn read_all(h) {
    let mut out = ""
    let mut going = true
    while going {
        match net_read(h, 4096) {
            Ok(chunk) => {
                if str_len(chunk) == 0 {
                    going = false
                } else {
                    out = out + chunk
                }
            },
            Err(e) => {
                return Err(e)
            },
        }
    }
    Ok(out)
}

// 写一行（带换行）/
// Write a line (with newline)
pub fn write_line(h, s) {
    net_write(h, s + "\n")
}
