// testing_test.bur — std/testing 的自测套件
// bur test suite for std/testing
fn test_assert_eq_accepts_equal_values() {
    assert_eq([1, 2], [1, 2])
}

fn test_result_assertions_accept_matching_variants() {
    assert_ok(Ok(7))
    assert_err(Err("nope"))
}

// main 供多后端验证直接编译运行；bur test 仍走 test_* 发现机制
// main lets multi-backend verification compile this file directly
fn main() {
    test_assert_eq_accepts_equal_values()
    test_result_assertions_accept_matching_variants()
}
