// std/testing — `bur test` 的最小断言辅助（S6.6）。
// Minimal assertion helpers for bur test (S6.6).

// assert_eq 断言相等 / assert_eq asserts equality
pub fn assert_eq(got, want) {
    assert(got == want, "assert_eq failed: got " + str(got) + ", want " + str(want))
}

// assert_ok 断言 Ok / assert_ok asserts an Ok result
// Assert Ok
pub fn assert_ok(result) {
    match result {
        Ok(_) => {},
        Err(err) => assert(false, "assert_ok failed: got Err(" + str(err) + ")"),
    }
}

// assert_err 断言 Err / assert_err asserts an Err result
// Assert Err
pub fn assert_err(result) {
    match result {
        Err(_) => {},
        Ok(value) => assert(false, "assert_err failed: got Ok(" + str(value) + ")"),
    }
}
