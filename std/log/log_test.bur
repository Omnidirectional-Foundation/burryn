// log_test.bur — std/log 的 bur test 套件 / bur test suite for std/log
fn test_level_order() {
    assert(level_debug < level_info, "debug below info")
    assert(level_info < level_warn, "info below warn")
    assert(level_warn < level_error, "warn below error")
    assert(level_error < level_off, "error below off")
}

fn test_format_line_levels() {
    assert(format_line(level_debug, "a") == "[debug] a", "debug tag")
    assert(format_line(level_info, "a") == "[info] a", "info tag")
    assert(format_line(level_warn, "a") == "[warn] a", "warn tag")
    assert(format_line(level_error, "a") == "[error] a", "error tag")
    assert(format_line(99, "a") == "[log] a", "unknown level falls back")
}

fn test_set_get_roundtrip() {
    set_level(level_warn)
    assert(get_level() == level_warn, "set_level stores the level")
    set_level(level_info)
    assert(get_level() == level_info, "set_level restores the level")
}

fn test_enabled_gating() {
    set_level(level_warn)
    assert(!enabled(level_debug), "debug gated at warn")
    assert(!enabled(level_info), "info gated at warn")
    assert(enabled(level_warn), "warn passes at warn")
    assert(enabled(level_error), "error passes at warn")
    set_level(level_off)
    assert(!enabled(level_error), "off gates every level")
    set_level(level_info)
    assert(enabled(level_info), "info passes again at info")
}
