// fs.bur — 文件系统 native：读写往返、错误路径、file_exists、read_dir。
// 全相对路径，可移植：同一份 golden 跑 Linux / macOS / Windows。
// Filesystem natives: read/write round-trips, error paths, file_exists,
// read_dir. Paths stay relative so one golden covers every platform.
fn main_loop() {
    match read_file("./bur_nonexistent_file_xyz") {
        Ok(_) => println("unexpected: read succeeded"),
        Err(_) => println("read missing: Err"),
    }

    let path = "./bur_fs_test.txt"
    let content = "hello from burryn\nline two\n"
    match write_file(path, content) {
        Ok(_) => println("write: Ok"),
        Err(e) => println("write: Err " + e),
    }
    match read_file(path) {
        Ok(data) => {
            if data == content {
                println("round-trip: match")
            } else {
                println("round-trip: MISMATCH")
            }
        },
        Err(e) => println("read back: Err " + e),
    }

    match write_file("./bur_no_such_dir_xyz/file", "x") {
        Ok(_) => println("unexpected: write to missing dir succeeded"),
        Err(_) => println("write missing dir: Err"),
    }

    println("missing exists:", file_exists("./bur_missing_file_xyz"))
    println("written exists:", file_exists(path))

    match read_dir("./bur_missing_dir_xyz") {
        Ok(_) => println("unexpected: read_dir succeeded"),
        Err(_) => println("read_dir missing: Err"),
    }
    match read_dir("examples/io") {
        Ok(names) => {
            println("self listed:", contains(names, "fs.bur"))
            println("dotdot listed:", contains(names, ".."))
        },
        Err(e) => println("read_dir: Err " + e),
    }
}

main_loop()
