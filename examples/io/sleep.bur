// sleep.bur — sleep(0) 边界与 sleep(1) 续跑 /
// sleep(0) boundary and sleep(1) continuation
fn main_loop() {
    println("before sleep(0)")
    sleep(0)
    println("after sleep(0)")

    println("before sleep(1)")
    sleep(1)
    println("after sleep(1)")

    fn nap() {
        sleep(0)
        "napped"
    }
    println(nap())
}

main_loop()
