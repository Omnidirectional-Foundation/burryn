// read_stdin / stdin_nb: blocking and non-blocking stdin access.
// read_stdin(5) reads exactly up to 5 bytes, leaving the rest for stdin_nb.
// Run with: printf 'helloWORLD' | bur run stdin.bur
let head = read_stdin(5)
println("read:", head)
match stdin_nb(100) {
    Ok(rest) => println("nb:", rest),
    Err(e) => {
        if e == "__eagain" {
            println("nb: would block")
        } else {
            println("nb: " + e)
        }
    },
}
