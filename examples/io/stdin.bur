// stdin.bur — read_stdin / stdin_nb：阻塞与非阻塞 stdin
// read_stdin / stdin_nb: blocking and non-blocking stdin access
let head = read_stdin(5)
println("read:", head)

match stdin_nb(100) {
    Ok(rest) => println("nb:", rest),
    Err(e) => {
        if e == "__eagain" {
            println("nb: would block")
        } else {
            println("nb: " + e)
        }
    },
}
