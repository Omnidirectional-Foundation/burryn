// net_nb.bur — 非阻塞 accept/read/write 与 __eagain
// net_nb: non-blocking accept/read/write with __eagain
// 客户端在首次读到数据前不能抢跑：服务端先观察到一次 __eagain 并打印后，
// 客户端才写入。否则两个 fiber 的调度顺序决定「首读是否 already readable」，
// C 与 x86 宿主的调度差异会让输出多一行/少一行（CI 已实测两边都出现过）。
// The client must not race the first read: it waits until the server has seen
// one __eagain and printed, then writes. Otherwise the fiber scheduling order
// decides whether the first read is already readable, and the C/x86 hosts'
// differing schedules flip one output line (both directions seen in CI).
let mut server_saw_eagain = false
fn server(lh) {
    // accept 也要让出重试：macOS 回环的握手落地可能晚于 connect 返回，accept
    // 会拿到 __eagain，放弃就会让客户端永远阻塞在 net_read 上（§16 darwin
    // 挂起）。Linux 回环同步落队，此处零重试，输出与 golden 一致。
    // accept must yield-and-retry too: the macOS loopback handshake can land
    // after connect() returns, so accept sees __eagain, and giving up leaves
    // the client blocked in net_read forever (the section-16 darwin hang).
    // Linux loopback queues synchronously: zero retries there, golden output
    // unchanged.
    let mut conn_str = ""
    let mut accepted = false
    while !accepted {
        match net_nb(0, lh, "", 0) {
            Ok(s) => {
                conn_str = s
                accepted = true
            },
            Err(e) => {
                if e == "__eagain" {
                    yield()
                } else {
                    println("server accept: " + e)
                    return
                }
            },
        }
    }
    match parse_int(conn_str) {
        Some(conn) => {
            // 读到数据前一直让出：限定轮数会在回环投递稍慢时放弃，
            // 客户端随即永远阻塞在 net_read 上
            // keep yielding until data arrives: a bounded retry count gives
            // up when loopback delivery lags, leaving the client blocked in
            // net_read forever
            let mut said_block = false
            while true {
                match net_nb(1, conn, "", 64) {
                    Ok(data) => {
                        println("server read:", data)
                        match net_nb(2, conn, "reply:" + data, 0) {
                            Ok(n) => println("server wrote", n, "bytes"),
                            Err(e) => println("server write: " + e),
                        }
                        net_close(conn)
                        return
                    },
                    Err(e) => {
                        if e == "__eagain" {
                            if !said_block {
                                println("server read: would block")
                                said_block = true
                            }
                            server_saw_eagain = true
                        } else {
                            println("server read: " + e)
                            return
                        }
                    },
                }
                yield()
            }
        },
        None => println("server accept: bad handle"),
    }
}

fn main_loop() {
    let port = 19877
    let lh = match tcp_listen("127.0.0.1", port) {
        Ok(h) => h,
        Err(e) => {
            eprintln("listen: " + e)
            exit(1)
        },
    }

    spawn server(lh)

    match tcp_dial("127.0.0.1", port) {
        Ok(conn) => {
            let mut spins = 0
            while !server_saw_eagain && spins < 10000 {
                yield()
                spins = spins + 1
            }
            match net_write(conn, "hello") {
                Ok(_) => {},
                Err(e) => println("client write: " + e),
            }
            match net_read(conn, 1024) {
                Ok(data) => println("client read:", data),
                Err(e) => println("client read: " + e),
            }
            net_close(conn)
        },
        Err(e) => println("dial: " + e),
    }
    net_close(lh)
}

main_loop()
