// net_nb.bur — 非阻塞 accept/read/write 与 __eagain
// net_nb: non-blocking accept/read/write with __eagain
fn server(lh) {
    match net_nb(0, lh, "", 0) {
        Ok(conn_str) => {
            match parse_int(conn_str) {
                Some(conn) => {
                    let mut tries = 0
                    let mut said_block = false
                    while tries < 5 {
                        match net_nb(1, conn, "", 64) {
                            Ok(data) => {
                                println("server read:", data)
                                match net_nb(2, conn, "reply:" + data, 0) {
                                    Ok(n) => println("server wrote", n, "bytes"),
                                    Err(e) => println("server write: " + e),
                                }
                                net_close(conn)
                                return
                            },
                            Err(e) => {
                                if e == "__eagain" {
                                    if !said_block {
                                        println("server read: would block")
                                        said_block = true
                                    }
                                } else {
                                    println("server read: " + e)
                                    return
                                }
                            },
                        }
                        tries = tries + 1
                        yield()
                    }
                },
                None => println("server accept: bad handle"),
            }
        },
        Err(e) => println("server accept: " + e),
    }
}

fn main_loop() {
    let port = 19877
    let lh = match tcp_listen("127.0.0.1", port) {
        Ok(h) => h,
        Err(e) => {
            eprintln("listen: " + e)
            exit(1)
        },
    }

    spawn server(lh)

    match tcp_dial("127.0.0.1", port) {
        Ok(conn) => {
            yield()
            // x86：tcp_dial 的 Ok 臂内 match Result<unit,_>（net_write）会把后续
            // Ok(str) 的 type_shadow 留成 Result，println 误走 enum_format 喷 \0。
            // 写入结果用 let 承接，避开对该 Result 的 match。
            // x86: matching Result<unit,_> (net_write) inside tcp_dial's Ok arm leaves
            // later Ok(str) bindings typed as Result; println enum_formats and sprays \0.
            // Hold the write in a let so we do not match that Result.
            let _write_res = net_write(conn, "hello")
            match net_read(conn, 1024) {
                Ok(data) => println("client read:", data),
                Err(e) => println("client read: " + e),
            }
            net_close(conn)
        },
        Err(e) => println("dial: " + e),
    }
    net_close(lh)
}

main_loop()
