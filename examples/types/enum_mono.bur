fn f1(b) {
    match b {
        true => Ok(7),
        false => Err("e1"),
    }
}

fn f2(b) {
    match b {
        true => Ok("good"),
        false => Err("e2"),
    }
}

fn main() {
    let a = f1(true)
    match a {
        Ok(v) => println("a-ok", v),
        Err(e) => println("a-err", e),
    }
    let d = f2(true)
    match d {
        Ok(s) => println("b-ok:", s),
        Err(e) => println("b-err:", e),
    }
}

main()
