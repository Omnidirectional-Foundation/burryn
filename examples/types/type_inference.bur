// type_inference.bur — let 多态、高阶推导、嵌套泛化 / let-polymorphism, higher-order inference, nested generalization
fn id(x) {
    x
}

fn apply_twice(f, x) {
    f(f(x))
}

fn main_loop() {
    println(id(42))
    println(id("hello"))
    println(id([1, 2, 3]))

    let inc = fn(n) {
        n + 1
    }
    println(apply_twice(inc, 10))

    let shout = fn(s) {
        s + "!"
    }
    println(apply_twice(shout, "hey"))

    let outer = fn(x) {
        let inner = fn(y) {
            y
        }
        [inner(x), inner(x)]
    }
    println(outer(7))
    println(outer("ab"))

    let compose = fn(f, g) {
        fn(x) {
            f(g(x))
        }
    }
    let double = fn(n) {
        n * 2
    }
    let to_s = fn(n) {
        str(n)
    }
    let double_then_str = compose(to_s, double)
    println(double_then_str(21))

    fn map_first(f, xs) {
        if len(xs) == 0 {
            return None
        }
        Some(f(xs[0]))
    }
    match map_first(double, [5, 6]) {
        Some(v) => println("mapped:", v),
        None => println("empty"),
    }
    match map_first(str, [99]) {
        Some(v) => println("stringified:", v),
        None => println("empty"),
    }
}

main_loop()
