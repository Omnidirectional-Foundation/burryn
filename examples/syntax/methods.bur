// receiver 方法
enum Point { Point(float, float) }

fn (p: Point) dist() {
    match p {
        Point(x, y) => x * x + y * y,
    }
}
fn (p: Point) scale(k) {
    match p {
        Point(x, y) => Point::Point(x * k, y * k),
    }
}
let p = Point::Point(3.0, 4.0)
println(p.dist())
println(p.scale(2.0).dist())
