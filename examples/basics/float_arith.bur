// float_arith.bur — float 算术与比较：SSE 路径 / Float arithmetic and comparison: SSE paths
println(3.5 * 2.0)
println(7.0 / 2.0)
println(1.5 + 2.25)
println(5.0 - 1.5)
println(-3.0)
println(1.5 < 2.0)
println(2.0 >= 2.0)
println(3.0 == 3.0)
println(1.0 != 2.0)
println(0.1 + 0.2)
println(10.0 / 3.0)
println(2.0 * 3.0 + 1.0)
println(2.0 * (3.0 + 1.0))
let mut a = 1.5
a = a * 4.0
println(a)
let mut b = 2.0
b = b + 1.0
println(b)
