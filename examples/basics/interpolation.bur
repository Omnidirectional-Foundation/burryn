// interpolation.bur — 字符串插值 {expr} 与 {{ 转义 / String interpolation with {expr} and {{ escape
let name = "Burryn"

let status = if true {
    "ready"
} else {
    "waiting"
}

println("hello {name}")
println("status: {status}")
println("count: {str(3)}")
println("literal brace: {{")
println("nested: {"inner {name}"}")
