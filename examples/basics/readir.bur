// read_dir: list a directory and iterate over its entries.
match read_dir("examples/io") {
    Ok(names) => {
        println("count " + str(len(names)))
        let mut i = 0
        let mut found = 0
        while i < len(names) {
            if names[i] == "fs.bur" {
                found = found + 1
            }
            i = i + 1
        }
        if found == 1 {
            println("found fs.bur")
        }
        exit(0)
    },
    Err(msg) => {
        print("err: ")
        println(msg)
        exit(1)
    },
}

exit(2)
