let path = "/tmp/bur_fileio_test.txt"
match write_file(path, "line one\nline two\n") {
    Ok(_) => println("write ok"),
    Err(m) => println("write failed"),
}
match read_file(path) {
    Ok(s) => println("read: " + s),
    Err(m) => println("read failed"),
}
match read_file("no/such/dir/file.bur") {
    Ok(s) => println("unexpected ok"),
    Err(m) => println("read missing: err"),
}
exit(0)
