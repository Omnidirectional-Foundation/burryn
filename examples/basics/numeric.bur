// Numeric conversions: trunc, to_float, parse_float, parse_int, float_bits.
// int <-> float conversion is explicit; there is no implicit narrowing.

println(trunc(3.99))
println(trunc(-3.99))
println(to_float(7))
println(parse_float("3.5"))
println(parse_float("  2.25e2  "))
println(parse_float("abc"))
println(parse_int("42"))
println(parse_int("nope"))
println(float_bits(1.0))
println(float_bits(0.0))
