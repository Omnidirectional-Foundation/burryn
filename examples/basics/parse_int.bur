// Regression: parse_int across the strtoll boundary cases.
// The x86 backend parses signed decimal with a per-digit overflow check;
// None on empty, trailing junk, or values outside i64.
fn parsed(s) {
    match parse_int(s) {
        Some(x) => {
            if x == 0 {
                "0"
            } else if x == 42 {
                "42"
            } else if x == -42 {
                "-42"
            } else if x == 9223372036854775807 {
                "max"
            } else if x == 0 - 9223372036854775807 - 1 {
                "min"
            } else {
                "other"
            }
        },
        None => "None",
    }
}

println(parsed("42"))
println(parsed("  -42  "))
println(parsed(""))
println(parsed("   "))
println(parsed("abc"))
println(parsed("42x"))
println(parsed("9999999999999999999999"))
println(parsed("9223372036854775807"))
println(parsed("9223372036854775808"))
println(parsed("-9223372036854775808"))
println(parsed("-9223372036854775809"))
println(parsed("\t42\n"))
println(parsed("+42"))
println(parsed("007"))
