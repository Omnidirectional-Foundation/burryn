// yield: cooperative handoff. Each fiber explicitly reschedules itself to
// the back of the run queue — the two workers interleave without sleep.
// The main fiber waits on a channel so the program outlives its workers.
fn worker(name, done) {
    for i in range(0, 3) {
        println(name + str(i))
        yield()
    }
    done <- 0
}

let done = chan(2)
spawn worker("a", done)
spawn worker("b", done)
let _ = recv(done)
let _ = recv(done)
