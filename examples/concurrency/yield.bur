// yield.bur — fiber 间显式协作让出 / Explicit cooperative handoff between fibers
fn worker(name, done) {
    for i in range(0, 3) {
        println(name + str(i))
        yield()
    }
    done <- 0
}

let done = chan(2)
spawn worker("a", done)
spawn worker("b", done)
let _ = recv(done)
let _ = recv(done)
