// deadlock_trap.bur — 全部 fiber 阻塞 → 死锁（exit 4，无 golden）
// All fibers blocked → fatal deadlock (exit 4, no golden)
fn blocker(ch) {
    ch <- 1
}

fn main_deadlock() {
    let a = chan(0)
    let b = chan(0)

    spawn blocker(a)
    spawn blocker(b)

    let c = chan(0)
    let _ = <-c
}

main_deadlock()
