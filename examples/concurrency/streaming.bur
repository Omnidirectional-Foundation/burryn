fn squares(ch, upto) {
    for i in range(1, upto) {
        ch <- i * i
    }
    close(ch)
}

fn main_loop() {
    let ch = chan(4)
    spawn squares(ch, 8)

    let mut total = 0
    let mut count = 0
    for v in ch {
        total = total + v
        count = count + 1
    }
    println("received", count, "squares, sum =", total)

    let done = chan(0)
    spawn squares(done, 4)
    let mut fold = 0
    let mut open = true
    while open {
        match recv(done) {
            Some(v) => {
                fold = fold + v
            },
            None => {
                open = false
            },
        }
    }
    println("recv fold of 1..3 squares =", fold)
}

main_loop()
