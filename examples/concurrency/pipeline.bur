// pipeline.bur — 带缓冲 channel 的生产者/消费者 / Buffered-channel producer/consumer
enum Msg {
    Job(str, int),
}

fn producer(name, ch, from, to) {
    for i in range(from, to) {
        ch <- Job(name, i * i)
    }
}

fn main_loop() {
    let jobs = chan(4)
    spawn producer("alpha", jobs, 0, 5)
    spawn producer("beta", jobs, 5, 10)

    let mut got = 0
    let mut total = 0
    while got < 10 {
        match <-jobs {
            Job(who, sq) => {
                println("from", who, "-> square", sq)
                total = total + sq
            },
        }
        got = got + 1
    }
    println("sum of all squares 0..9 =", total)
    assert(total == 285, "pipeline lost a message!")
}

main_loop()
