// sieve.bur — 经典 CSP 素数筛：每个素数一个 fiber / Classic CSP prime sieve: one fiber per prime
fn generate(ch) {
    let mut i = 2
    while true {
        ch <- i
        i = i + 1
    }
}

fn filter(in_ch, out_ch, prime) {
    while true {
        let n = <-in_ch
        if n % prime != 0 {
            out_ch <- n
        }
    }
}

let mut ch = chan()
spawn generate(ch)

let mut found = []

while len(found) < 15 {
    let prime = <-ch
    push(found, prime)
    let next = chan()
    spawn filter(ch, next, prime)
    ch = next
}

println("first 15 primes:", found)
println("(computed by", len(found) + 1, "fibers talking through channels)")
